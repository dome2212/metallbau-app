# Environment Variables
# Diese Datei gehört in den Hauptordner des Projekts (gleiche Ebene wie package.json)
# und muss "env" heißen (also .env, nicht "env.txt"). Niemals in Git einchecken!

# Server
PORT=3000
NODE_ENV=development

# Datenbank
# Leer lassen = lokale SQLite-Datenbank wird automatisch angelegt (database.sqlite).
# Nur ausfüllen, wenn du eine Cloud-Postgres-DB (z. B. Render) nutzen willst,
# dann zusätzlich eine Zeile DATABASE_URL=... eintragen.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metallbau_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# SQLite (lokale Entwicklung)
SQLITE_DB=./database.sqlite

# JWT (Pflichtfeld! Ohne diesen Wert startet der Server nicht)
JWT_SECRET=06873cc210baf7d7da6ccb81ceccf46af6c0111b598e8a92b7b8944eb045ae9f5f84bd174e3869f8add1a82b07c525ed
JWT_EXPIRE=7d

# Cloudinary (für Foto-/Datei-Uploads)
# Kostenloser Account: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# E-Mail (optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_SERVICE=gmail

# Application
APP_URL=http://localhost:3000
