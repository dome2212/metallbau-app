<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 min-h-screen page-bg dark:bg-slate-900 pt-14">
  <div class="max-w-xl mx-auto px-4 md:px-6 py-6 space-y-5">

    <!-- Page Header -->
    <div>
      <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Mein Profil</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
        Eingeloggt als <strong class="text-slate-700 dark:text-slate-200"><%= currentUser.username %></strong>
        · <span class="badge bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300"><%= currentUser.role %></span>
      </p>
    </div>

    <!-- Passwort ändern -->
    <div class="card p-6">
      <h2 class="text-base font-semibold text-slate-800 dark:text-slate-100 mb-5 flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center"><svg class="w-3.5 h-3.5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.5 12.5L20 3M17 6l2 2M14 9l2 2"/></svg></span>
        Passwort ändern
      </h2>

      <% if (error) { %>
        <div class="flex items-center gap-2 mb-4 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 text-sm">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= error %>
        </div>
      <% } %>
      <% if (success) { %>
        <div class="flex items-center gap-2 mb-4 px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400 text-sm">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <%= success %>
        </div>
      <% } %>

      <form method="POST" action="/profile/change-password" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Aktuelles Passwort</label>
          <input type="password" name="current_password" required class="input">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Neues Passwort <span class="normal-case font-normal">(mind. 6 Zeichen)</span></label>
          <input type="password" name="new_password" required minlength="6" class="input">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Neues Passwort bestätigen</label>
          <input type="password" name="confirm_password" required class="input">
        </div>
        <button type="submit" class="btn btn-primary w-full justify-center">Passwort ändern</button>
      </form>
    </div>

    <!-- Profildaten -->
    <div class="card p-6">
      <h2 class="text-base font-semibold text-slate-800 dark:text-slate-100 mb-5 flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-700 flex items-center justify-center"><svg class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 016-6h4a6 6 0 016 6v1"/></svg></span>
        Profildaten
      </h2>
      <form method="POST" action="/profile/update" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Telefon</label>
          <input type="tel" name="phone" value="<%= currentUser.phone || '' %>" class="input">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Qualifikationen / Zertifikate</label>
          <textarea name="qualifications" rows="2" class="input resize-none"><%= currentUser.qualifications || '' %></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Führerscheinklassen</label>
          <input type="text" name="driving_license" value="<%= currentUser.driving_license || '' %>" placeholder="z.B. B, BE, C1" class="input">
        </div>
        <button type="submit" class="btn btn-primary w-full justify-center">Profil speichern</button>
      </form>
    </div>

    <!-- Push-Benachrichtigungen -->
    <div class="card p-6">
      <h2 class="text-base font-semibold text-slate-800 dark:text-slate-100 mb-2 flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center"><svg class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 01-3.4 0"/></svg></span>
        Push-Benachrichtigungen
      </h2>
      <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">
        Erhalte Benachrichtigungen direkt auf diesem Gerät – z.B. bei neuen Aufträgen, Pinnwand-Meldungen,
        neuen Terminen<% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') { %> und Urlaubs-/Krankmeldungsanträgen<% } %>.
      </p>
      <div id="push-status" class="flex items-center gap-2 mb-4 px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-700/40 text-sm text-slate-600 dark:text-slate-300">
        Status wird geprüft…
      </div>
      <button id="push-toggle-btn" type="button" class="btn btn-primary w-full justify-center" disabled>
        Wird geladen…
      </button>
    </div>

  </div>
</main>

<script>
  (function() {
    const statusEl = document.getElementById('push-status');
    const btn      = document.getElementById('push-toggle-btn');

    function setStatus(text, ok) {
      statusEl.textContent = text;
      statusEl.className = 'flex items-center gap-2 mb-4 px-4 py-3 rounded-xl text-sm ' +
        (ok
          ? 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400'
          : 'bg-slate-50 dark:bg-slate-700/40 text-slate-600 dark:text-slate-300');
    }

    async function refresh() {
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        setStatus('Dein Browser unterstützt keine Push-Benachrichtigungen.', false);
        btn.classList.add('hidden');
        return;
      }
      const subscribed = await isPushSubscribed();
      if (subscribed) {
        setStatus('Push-Benachrichtigungen sind aktiviert.', true);
        btn.textContent = 'Deaktivieren';
        btn.className = 'btn w-full justify-center bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200';
      } else {
        setStatus('Push-Benachrichtigungen sind noch nicht aktiviert.', false);
        btn.textContent = 'Benachrichtigungen aktivieren';
        btn.className = 'btn btn-primary w-full justify-center';
      }
      btn.disabled = false;
    }

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      try {
        if (await isPushSubscribed()) {
          await disablePushNotifications();
          showToast('Push-Benachrichtigungen deaktiviert', 'info');
        } else {
          await enablePushNotifications();
          showToast('Push-Benachrichtigungen aktiviert', 'success');
        }
      } catch (err) {
        showToast(err.message || 'Fehler bei Push-Benachrichtigungen', 'error');
      }
      await refresh();
    });

    refresh();
  })();
</script>

</body>
</html>
