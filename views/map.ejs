<%- include('partials/header') %>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin="">

<%- include('partials/sidebar') %>
<main class="flex-1 flex flex-col overflow-hidden min-h-screen pt-16">

    <!-- Header -->
    <header class="bg-white shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 shrink-0">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800">🗺️ Baustellenkarte</h1>
        <p class="text-xs text-slate-400 mt-0.5">Alle laufenden Aufträge mit hinterlegtem Standort auf einen Blick</p>
      </div>
      <!-- Legende -->
      <div class="flex flex-wrap gap-3 text-xs text-slate-500">
        <% const legendItems = [
          ['In Planung',          '#94a3b8'],
          ['Avor / Vorbereitung', '#60a5fa'],
          ['In Produktion',       '#fbbf24'],
          ['Oberfläche',          '#a78bfa'],
          ['Montagebereit',       '#34d399'],
          ['Montage läuft',       '#f97316']
        ]; %>
        <% legendItems.forEach(([label, color]) => { %>
          <span class="flex items-center gap-1">
            <span class="w-3 h-3 rounded-full inline-block border border-white/50 shadow-sm" style="background:<%= color %>"></span>
            <%= label %>
          </span>
        <% }) %>
        <span class="flex items-center gap-1 text-slate-300">
          <span class="w-3 h-3 rounded-full inline-block bg-slate-300 border border-white/50"></span>
          Kein Standort
        </span>
      </div>
    </header>

    <!-- Layout: Karte + Seitenpanel -->
    <div class="flex-1 flex flex-col md:flex-row overflow-hidden">

      <!-- ══════════ KARTE ══════════ -->
      <div id="map" class="flex-1 z-0" role="application" aria-label="Baustellenkarte"></div>

      <!-- ══════════ SEITENPANEL ══════════ -->
      <div class="w-full md:w-80 bg-white border-t md:border-t-0 md:border-l border-slate-200 flex flex-col overflow-hidden shrink-0">

        <!-- Zähler + Filter -->
        <div class="px-4 py-3 border-b border-slate-100">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-semibold text-slate-600 uppercase tracking-wider">Aufträge</span>
            <span id="count-badge" class="text-xs bg-blue-600 text-white font-bold px-2 py-0.5 rounded-full">–</span>
          </div>
          <input id="panel-filter" type="text" placeholder="Liste filtern…"
            class="w-full text-xs border border-slate-200 rounded-lg px-3 py-1.5 bg-slate-50 focus:outline-none focus:ring-1 focus:ring-blue-400"
            oninput="filterPanel(this.value)">
        </div>

        <!-- Auftragsliste -->
        <div id="project-list" class="flex-1 overflow-y-auto divide-y divide-slate-50 text-sm">
          <!-- wird per JS befüllt -->
        </div>
      </div>
    </div>

  </main>

<!-- Leaflet JS -->
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

<script>
// -- Projektdaten vom Server --------------------------------------------------
// JSON escaped gegen vorzeitiges Script-Ende
const PROJECTS = <%- JSON.stringify(projects || []).replace(/</g, '\\u003c') %>;
const FIRM_LAT = 51.3069467;
const FIRM_LNG = 6.9483845;

// Farbe je Status
const STATUS_COLOR = {
  'In Planung':          '#94a3b8',
  'Avor / Vorbereitung': '#60a5fa',
  'In Produktion':       '#fbbf24',
  'Oberfläche':          '#a78bfa',
  'Montagebereit':       '#34d399',
  'Montage läuft':       '#f97316',
  'Abgeschlossen':       '#86efac'
};

function colorFor(status) {
  return STATUS_COLOR[status] || '#94a3b8';
}

// -- Leaflet initialisieren ---------------------------------------------------
let map = null;
const markers = {};
const bounds = [[FIRM_LAT, FIRM_LNG]];
let allProjects = PROJECTS.slice();

function initMap() {
  if (typeof L === 'undefined') {
    const el = document.getElementById('map');
    if (el) el.innerHTML = '<div style="padding:1.5rem;text-align:center;color:#64748b;font-size:14px">Karten-Bibliothek nicht geladen.<br>Internet prüfen und Seite neu laden.</div>';
    return;
  }
  map = L.map('map', { zoomControl: true, preferCanvas: true });
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap',
    maxZoom: 19
  }).addTo(map);

  const firmIcon = L.divIcon({
    className: '',
    html: '<div style="width:20px;height:20px;border-radius:50%;background:#1e293b;border:3px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4)"></div>',
    iconSize: [20, 20],
    iconAnchor: [10, 10]
  });
  L.marker([FIRM_LAT, FIRM_LNG], { icon: firmIcon })
    .addTo(map)
    .bindPopup('<strong>Metallbau Gehrmann</strong><br>Firmensitz');

  PROJECTS.forEach(function(p) {
    if (p.site_lat == null || p.site_lng == null) return;
    const lat = parseFloat(p.site_lat);
    const lng = parseFloat(p.site_lng);
    if (!isFinite(lat) || !isFinite(lng)) return;
    const color = colorFor(p.status);
    const icon = L.divIcon({
      className: '',
      html: '<div style="width:24px;height:24px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:' + color + ';border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.35)"></div>',
      iconSize: [24, 24],
      iconAnchor: [12, 24],
      popupAnchor: [0, -26]
    });
    const customer = p.company_name || p.contact_person || 'Kein Kunde';
    const addr = [p.street, p.city].filter(Boolean).join(', ');
    const popup = '<div style="font-family:system-ui,sans-serif;line-height:1.5">' +
      '<p style="font-weight:700;font-size:14px;margin:0 0 4px">' + escHtml(p.title) + '</p>' +
      '<p style="font-size:11px;color:#64748b;margin:0 0 2px">' + escHtml(customer) + '</p>' +
      (addr ? '<p style="font-size:11px;color:#64748b;margin:0 0 6px">' + escHtml(addr) + '</p>' : '') +
      '<a href="/projects/' + p.id + '" style="font-size:12px;color:#2563eb;font-weight:600">Auftrag öffnen →</a></div>';
    markers[p.id] = L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup(popup);
    bounds.push([lat, lng]);
  });

  try {
    if (bounds.length > 1) map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
    else map.setView([FIRM_LAT, FIRM_LNG], 11);
  } catch (e) {
    map.setView([FIRM_LAT, FIRM_LNG], 11);
  }

  function fixSize() { try { map.invalidateSize(true); } catch (e) {} }
  setTimeout(fixSize, 150);
  setTimeout(fixSize, 500);
  window.addEventListener('resize', fixSize);
}

function escHtml(s) {
  return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function renderPanel(list) {
  const el = document.getElementById('project-list');
  const badge = document.getElementById('count-badge');
  if (!el) return;
  const withGeo = list.filter(function(p){ return p.site_lat != null && p.site_lng != null; });
  const withoutGeo = list.filter(function(p){ return p.site_lat == null || p.site_lng == null; });
  if (badge) badge.textContent = String(list.length);

  function card(p, hasGeo) {
    const color = colorFor(p.status);
    const customer = p.company_name || p.contact_person || 'Kein Kunde';
    return '<div class="px-4 py-3 hover:bg-slate-50 cursor-pointer" onclick="focusProject(' + p.id + ',' +
      (p.site_lat != null ? p.site_lat : 'null') + ',' + (p.site_lng != null ? p.site_lng : 'null') + ')">' +
      '<div class="flex items-start gap-2">' +
      '<span class="w-2.5 h-2.5 rounded-full mt-1.5 shrink-0" style="background:' + color + '"></span>' +
      '<div class="min-w-0 flex-1">' +
      '<p class="font-semibold text-slate-800 text-sm truncate">' + escHtml(p.title) + '</p>' +
      '<p class="text-xs text-slate-400 truncate">' + escHtml(customer) + '</p></div>' +
      '<span class="text-[10px] font-bold shrink-0 mt-0.5 px-1.5 py-0.5 rounded" style="background:' + color + '22;color:' + color + '">' + escHtml(p.status) + '</span></div>' +
      (!hasGeo ? '<p class="text-[10px] text-slate-300 mt-1 ml-4">Kein Standort hinterlegt</p>' : '') +
      '</div>';
  }

  let html = '';
  if (withGeo.length) {
    html += '<p class="px-4 py-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-slate-50">Mit Standort (' + withGeo.length + ')</p>';
    html += withGeo.map(function(p){ return card(p, true); }).join('');
  }
  if (withoutGeo.length) {
    html += '<p class="px-4 py-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-slate-50">Ohne Standort (' + withoutGeo.length + ')</p>';
    html += withoutGeo.map(function(p){ return card(p, false); }).join('');
  }
  if (!list.length) html = '<p class="px-4 py-6 text-sm text-slate-400 text-center">Keine Aufträge</p>';
  el.innerHTML = html;
}

function filterPanel(val) {
  const q = (val || '').trim().toLowerCase();
  const filtered = q
    ? allProjects.filter(function(p) {
        return (p.title || '').toLowerCase().indexOf(q) >= 0 ||
          (p.company_name || '').toLowerCase().indexOf(q) >= 0 ||
          (p.contact_person || '').toLowerCase().indexOf(q) >= 0 ||
          (p.status || '').toLowerCase().indexOf(q) >= 0;
      })
    : allProjects;
  renderPanel(filtered);
}

function focusProject(id, lat, lng) {
  if (map && lat && lng) {
    map.flyTo([lat, lng], 16, { duration: 0.8 });
    if (markers[id]) setTimeout(function(){ markers[id].openPopup(); }, 850);
  }
  const m = document.getElementById('map');
  if (m) m.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// Start
renderPanel(allProjects);
if (document.readyState === 'complete') initMap();
else window.addEventListener('load', initMap);
setTimeout(initMap, 300);
</script>

<style>
/* Leaflet-Popups im App-Stil */
.leaflet-popup-content-wrapper {
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(0,0,0,.18);
  padding: 0;
}
.leaflet-popup-content { margin: 12px 14px; }
.leaflet-popup-tip-container { margin-top: -1px; }
/* Karten-Container: feste Höhe mobil, flex desktop */
#map {
  width: 100%;
  min-height: 50vh !important;
  height: 50vh;
  background: #e2e8f0;
  z-index: 0;
}
@media (min-width: 768px) {
  #map {
    height: auto;
    min-height: 0 !important;
    flex: 1 1 auto;
  }
}
.dark #map { background: #334155; }
</style>

</body>
</html>
