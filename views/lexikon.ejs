    <!-- ═══════════════════════════════════════════
         TAB 4: SCHWEISSEN
         ═══════════════════════════════════════════ -->
    <div id="tab-schweiss" class="tab-section">
      <div class="grid2">
        <div class="card">
          <div class="section-title">MAG-Schweißen – Richtwerte (S235, Massivdraht G3Si1)</div>
