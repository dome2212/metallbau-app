<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">
  <header class="bg-white dark:bg-slate-800 shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 mb-6">
    <div>
      <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100">📖 Werkstatt-Lexikon</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Kernlochmaße, Blechdicken, Festigkeitsklassen, Biegeradien – immer zur Hand</p>
    </div>
    <!-- Filter-Tabs (werden per JS aus localStorage gefiltert) -->
    <div class="flex flex-wrap gap-1.5" id="tab-bar">
      <button onclick="showTab('gewinde')"     class="tab-btn active" data-tab="gewinde"     data-lex-tab>🔩 Gewinde</button>
      <button onclick="showTab('blech')"       class="tab-btn" data-tab="blech"              data-lex-tab>📐 Blech & Biegen</button>
      <button onclick="showTab('festigkeit')"  class="tab-btn" data-tab="festigkeit"         data-lex-tab>💪 Festigkeit</button>
      <button onclick="showTab('schweiss')"    class="tab-btn" data-tab="schweiss"           data-lex-tab>🔥 Schweißen</button>
      <button onclick="showTab('oberflaeche')" class="tab-btn" data-tab="oberflaeche"        data-lex-tab>🎨 Oberfläche</button>
      <button onclick="showTab('passungen')"   class="tab-btn" data-tab="passungen"          data-lex-tab>🔧 Passungen</button>
    </div>
  </header>

  <style>
    .tab-btn { padding: 0.4rem 0.85rem; border-radius: 0.5rem; font-size: 0.75rem; font-weight: 600; background:#f1f5f9; color:#475569; border:1px solid #e2e8f0; cursor:pointer; transition:all .15s; }
    .tab-btn:hover { background:#e2e8f0; }
    .tab-btn.active { background:#1e3a5f; color:#fff; border-color:#1e3a5f; }
    .dark .tab-btn { background:#334155; color:#94a3b8; border-color:#475569; }
    .dark .tab-btn.active { background:#3b82f6; border-color:#3b82f6; color:#fff; }
    .tab-section { display:none; }
    .tab-section.active { display:block; }
    .lex-table { width:100%; border-collapse:collapse; font-size:0.8rem; }
    .lex-table th { background:#1e3a5f; color:#fff; padding:7px 10px; text-align:left; font-size:0.7rem; text-transform:uppercase; letter-spacing:.5px; }
    .lex-table td { padding:6px 10px; border-bottom:1px solid #e2e8f0; }
    .lex-table tr:nth-child(even) td { background:#f8fafc; }
    .lex-table tr:hover td { background:#eff6ff; }
    .dark .lex-table th { background:#1e40af; }
    .dark .lex-table td { border-bottom-color:#334155; color:#cbd5e1; }
    .dark .lex-table tr:nth-child(even) td { background:#1e293b; }
    .dark .lex-table tr:hover td { background:#1e3a5f; }
    .tag-ok { display:inline-block; padding:1px 6px; border-radius:9px; font-size:.65rem; font-weight:700; }
    .hint { background:#fef9c3; border:1px solid #fde68a; border-radius:8px; padding:10px 14px; font-size:.75rem; color:#713f12; margin-bottom:12px; }
    .dark .hint { background:#422006; border-color:#713f12; color:#fbbf24; }
    .section-title { font-size:.8rem; font-weight:700; color:#1e3a5f; text-transform:uppercase; letter-spacing:.5px; margin-bottom:8px; padding-bottom:4px; border-bottom:2px solid #e2e8f0; }
    .dark .section-title { color:#60a5fa; border-bottom-color:#334155; }
    .card { background:#fff; border-radius:12px; box-shadow:0 1px 4px rgba(0,0,0,.07); padding:18px 20px; margin-bottom:18px; }
    .dark .card { background:#1e293b; }
    .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    @media(max-width:640px){ .grid2 { grid-template-columns:1fr; } }
  </style>

  <div class="px-4 md:px-6 max-w-6xl mx-auto w-full pb-10">

