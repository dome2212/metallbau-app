<!-- ══════════════════════════════════════════════════════════════════════
     LEXIKON-EINSTELLUNGEN – Schwebendes Zahnrad + Modal
     ══════════════════════════════════════════════════════════════════════ -->

<!-- Schwebendes Zahnrad-Icon unten links -->
<button id="lex-settings-fab"
  onclick="openLexSettings()"
  title="Lexikon-Einstellungen"
  style="position:fixed;bottom:1.25rem;left:1.25rem;z-index:800;width:2.6rem;height:2.6rem;border-radius:50%;background:#1e3a5f;color:#fff;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.25);transition:background .15s;"
  onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#1e3a5f'">
  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
  </svg>
</button>

<!-- Modal-Hintergrund -->
<div id="lex-settings-overlay"
  style="display:none;position:fixed;inset:0;z-index:900;background:rgba(0,0,0,.5);align-items:flex-end;justify-content:center;"
  onclick="closeLexSettings(event)">

  <!-- Modal-Box -->
  <div id="lex-settings-modal"
    style="background:#1e293b;color:#e2e8f0;border-radius:1rem 1rem 0 0;padding:1.5rem 1.25rem 2rem;width:100%;max-width:480px;box-shadow:0 -4px 24px rgba(0,0,0,.4);"
    onclick="event.stopPropagation()">

    <!-- Kopf -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.1rem;">
      <div>
        <p style="font-weight:700;font-size:1rem;margin:0;">⚙️ Lexikon-Einstellungen</p>
        <p style="font-size:.72rem;color:#94a3b8;margin:2px 0 0;">Wähle, welche Bereiche du sehen möchtest</p>
      </div>
      <button onclick="closeLexSettings()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.3rem;line-height:1;padding:2px 4px;" title="Schließen">✕</button>
    </div>

    <!-- Toggle-Liste -->
    <div id="lex-toggle-list" style="display:flex;flex-direction:column;gap:.55rem;margin-bottom:1.2rem;"></div>

    <!-- Aktionen -->
    <div style="display:flex;gap:.6rem;">
      <button onclick="lexSettingsSelectAll()"
        style="flex:1;padding:.55rem;border-radius:.5rem;background:#334155;color:#94a3b8;border:1px solid #475569;font-size:.75rem;font-weight:600;cursor:pointer;">
        Alle einblenden
      </button>
      <button onclick="applyLexSettings()"
        style="flex:2;padding:.55rem;border-radius:.5rem;background:#1e3a5f;color:#fff;border:none;font-size:.8rem;font-weight:700;cursor:pointer;">
        ✓ Übernehmen &amp; schließen
      </button>
    </div>
  </div>
</div>

<script>
  // ── Tab-Definitionen ──────────────────────────────────────────────────────
  const LEX_TABS = [
    { key: 'gewinde',     label: '🔩 Gewinde & Kernlochmaße' },
    { key: 'blech',       label: '📐 Blech & Biegen' },
    { key: 'festigkeit',  label: '💪 Festigkeitsklassen & Stahl' },
    { key: 'schweiss',    label: '🔥 Schweißen' },
    { key: 'oberflaeche', label: '🎨 Oberfläche & Korrosionsschutz' },
    { key: 'passungen',   label: '🔧 Passungen & Toleranzen' },
  ];

  // Persistenz: welche Tabs sind VERSTECKT
  function getLexHidden() {
    try { return JSON.parse(localStorage.getItem('lexikon_hidden') || '[]'); } catch(e) { return []; }
  }
  function saveLexHidden(arr) {
    try { localStorage.setItem('lexikon_hidden', JSON.stringify(arr)); } catch(e) {}
  }

  // ── Tab-Sichtbarkeit anwenden ─────────────────────────────────────────────
  function applyLexVisibility() {
    const hidden = getLexHidden();
    let firstVisible = null;
    LEX_TABS.forEach(t => {
      const btn = document.querySelector('[data-tab="' + t.key + '"]');
      if (!btn) return;
      const isHidden = hidden.includes(t.key);
      btn.style.display = isHidden ? 'none' : '';
      if (!isHidden && !firstVisible) firstVisible = t.key;
    });

    // Wenn aktiver Tab jetzt versteckt ist → ersten sichtbaren aktivieren
    const activeBtn = document.querySelector('.tab-btn.active');
    if (activeBtn && hidden.includes(activeBtn.dataset.tab)) {
      if (firstVisible) showTab(firstVisible);
    } else if (!activeBtn && firstVisible) {
      showTab(firstVisible);
    }
  }

  // ── Tab wechseln ──────────────────────────────────────────────────────────
  function showTab(name) {
    document.querySelectorAll('.tab-section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    const sec = document.getElementById('tab-' + name);
    const btn = document.querySelector('[data-tab="' + name + '"]');
    if (sec) sec.classList.add('active');
    if (btn) btn.classList.add('active');
    try { localStorage.setItem('lexikon_tab', name); } catch(e) {}
  }

  // ── Settings-Modal öffnen ────────────────────────────────────────────────
  function openLexSettings() {
    const hidden = getLexHidden();
    const list = document.getElementById('lex-toggle-list');
    list.innerHTML = LEX_TABS.map(t => {
      const checked = !hidden.includes(t.key);
      return `
        <label style="display:flex;align-items:center;gap:.75rem;padding:.55rem .75rem;border-radius:.5rem;background:${checked ? '#1e3a5f' : '#0f172a'};border:1px solid ${checked ? '#2563eb' : '#334155'};cursor:pointer;transition:background .12s;" id="lex-lbl-${t.key}">
          <input type="checkbox" data-lex-key="${t.key}" ${checked ? 'checked' : ''}
            onchange="lexToggleHighlight('${t.key}', this.checked)"
            style="width:1.1rem;height:1.1rem;accent-color:#2563eb;cursor:pointer;flex-shrink:0;">
          <span style="font-size:.82rem;font-weight:600;">${t.label}</span>
        </label>`;
    }).join('');
    const overlay = document.getElementById('lex-settings-overlay');
    overlay.style.display = 'flex';
  }

  function lexToggleHighlight(key, checked) {
    const lbl = document.getElementById('lex-lbl-' + key);
    if (!lbl) return;
    lbl.style.background = checked ? '#1e3a5f' : '#0f172a';
    lbl.style.borderColor = checked ? '#2563eb' : '#334155';
  }

  function lexSettingsSelectAll() {
    document.querySelectorAll('#lex-toggle-list input[data-lex-key]').forEach(cb => {
      cb.checked = true;
      lexToggleHighlight(cb.dataset.lexKey, true);
    });
  }

  function closeLexSettings(e) {
    if (e && e.target !== document.getElementById('lex-settings-overlay')) return;
    document.getElementById('lex-settings-overlay').style.display = 'none';
  }

  function applyLexSettings() {
    const hidden = [];
    document.querySelectorAll('#lex-toggle-list input[data-lex-key]').forEach(cb => {
      if (!cb.checked) hidden.push(cb.dataset.lexKey);
    });
    saveLexHidden(hidden);
    applyLexVisibility();
    document.getElementById('lex-settings-overlay').style.display = 'none';
  }

  // ── Beim Laden: letzten Tab + Sichtbarkeit wiederherstellen ──────────────
  (function() {
    applyLexVisibility();
    try {
      const t = localStorage.getItem('lexikon_tab');
      const hidden = getLexHidden();
      if (t && !hidden.includes(t)) showTab(t);
    } catch(e) {}
  })();
</script>
