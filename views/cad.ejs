<%- include('partials/header') %>
<%- include('partials/sidebar') %>
<link rel="stylesheet" href="/css/cad.css">
<main id="cad-app" data-user="<%= cadUserId %>">
  <div class="cad-heading"><div><div class="cad-eyebrow">KONSTRUKTION & PLANUNG</div><h1>CAD Studio <span>2D + 3D</span></h1><p>Von der ersten Linie zum räumlichen Entwurf.</p></div><a href="/schnittliste" class="cad-link">Zur Schnittliste ↗</a></div>
  <div class="cad-document"><div class="cad-document-name"><span class="cad-file-icon">◇</span><div><input id="cad-name" aria-label="Zeichnungsname" value="Neue Konstruktion" maxlength="80"><small id="cad-save-state">Lokal in diesem Browser · noch nicht gespeichert</small></div></div><div class="cad-actions"><button id="cad-new">＋ Neu</button><button id="cad-open">Öffnen</button><button id="cad-save" class="cad-primary">Speichern</button><select id="cad-export" aria-label="Exportieren"><option value="">Exportieren ↗</option><option value="json">CAD-Datei (.json)</option><option value="svg">2D-Zeichnung (.svg)</option><option value="dxf">2D-Zeichnung (.dxf)</option><option value="bom">Stückliste (.csv)</option><option value="production">Fertigungsdaten (.csv)</option></select><input id="cad-file" type="file" accept=".json" hidden></div></div>
  <section class="cad-workspace" aria-label="CAD Arbeitsbereich">
    <div class="cad-toolbar"><div class="cad-modes"><button data-view="2d" class="active">▱ 2D Zeichnung</button><button data-view="3d">◇ 3D Modell</button></div><div class="cad-tool-options"><button id="cad-undo" title="Rückgängig (Strg+Z)">↶</button><button id="cad-redo" title="Wiederholen (Strg+Y)">↷</button><span class="cad-divider"></span><label><input id="cad-snap" type="checkbox" checked> Rasterfang</label><select id="cad-grid" aria-label="Rasterweite"><option value="10">10 mm</option><option value="25" selected>25 mm</option><option value="50">50 mm</option><option value="100">100 mm</option></select><button id="cad-fit" title="Zeichnung einpassen">⊡ Einpassen</button></div></div>
    <div class="cad-body"><nav class="cad-tools" aria-label="Zeichenwerkzeuge"><button data-tool="select" class="active" title="Auswählen (V)"><b>↖</b><span>Auswahl</span></button><button data-tool="line" title="Linie (L)"><b>╱</b><span>Linie</span></button><button data-tool="rect" title="Rechteck (R)"><b>▭</b><span>Rechteck</span></button><button data-tool="circle" title="Kreis (C)"><b>◯</b><span>Kreis</span></button><button data-tool="dim" title="Bemaßung (D)"><b>↔</b><span>Maß</span></button><div class="cad-tool-break"></div><button data-tool="pan" title="Ansicht verschieben (H)"><b>✥</b><span>Schieben</span></button><button id="cad-delete" title="Auswahl löschen (Entf)"><b>⌫</b><span>Löschen</span></button></nav>
    <div class="cad-viewport"><canvas id="cad-canvas" tabindex="0" aria-label="Zeichenfläche: Werkzeug wählen, dann Start- und Endpunkt anklicken"></canvas><div class="cad-view-label"><span id="cad-view-name">DRAUFSICHT</span><small id="cad-view-hint">XY-Ebene · Maße in Millimeter</small></div><div class="cad-zoom"><button id="cad-minus" aria-label="Verkleinern">−</button><span id="cad-zoom-value">100 %</span><button id="cad-plus" aria-label="Vergrößern">＋</button></div><div class="cad-axis"><span style="color:#ed7979">X</span> ↗ <span style="color:#62c8ac">Y</span></div></div>
    <aside class="cad-inspector"><div class="cad-panel-title">EIGENSCHAFTEN <span>◈</span></div><div class="cad-inspector-content"><div class="cad-section-label">AUSGEWÄHLTES ELEMENT</div><h3 id="cad-selection">Keine Auswahl</h3><p id="cad-selection-help">Element anklicken oder eine neue Kontur zeichnen.</p><form id="cad-properties"><label>X <span>mm</span><input id="cad-x" type="number" step="any" required></label><label>Y <span>mm</span><input id="cad-y" type="number" step="any" required></label><label id="cad-width-label">Breite / ΔX <span>mm</span><input id="cad-width" type="number" step="any" required></label><label id="cad-height-label">Höhe / ΔY <span>mm</span><input id="cad-height" type="number" step="any" required></label><div class="cad-section-label">3D EXTRUSION</div><label>Drehung <span>°</span><input id="cad-angle" type="number" min="-180" max="180" step="any" required></label><label>Höhe Z <span>mm</span><input id="cad-z" type="number" min="-100000" max="100000" step="any" required></label><label>Tiefe <span>mm</span><input id="cad-depth" type="number" min="0" max="100000" step="any" required></label><button class="cad-primary" type="submit">Maße übernehmen</button></form><form id="cad-miter-form" class="cad-part-form"><div class="cad-section-label">GEHRUNG AM PROFIL</div><p id="cad-miter-hint">In 2D ein Profil anklicken oder in der Liste auswählen. A = Anfang, E = Ende.</p><label>Profilende<select id="cad-miter-end"><option value="start">Anfang</option><option value="end">Ende</option></select></label><label>Winkel (−89° bis 89°)<input id="cad-miter-angle" type="number" min="-89" max="89" step="any" value="45" required></label><small>Das Vorzeichen bestimmt die Schnittrichtung. 0° stellt einen geraden Schnitt her. Länge wird in der Profilmitte gemessen.</small><button class="cad-primary" type="submit">Gehrung übernehmen</button></form><form id="cad-part-form" class="cad-part-form"><div class="cad-section-label">BAUTEIL & FERTIGUNG</div><p id="cad-part-hint">Geschlossene Kontur auswählen, um Fertigungsdaten zuzuordnen.</p><label>Bezeichnung<input id="cad-part-name" maxlength="100" required></label><label>Material<input id="cad-part-material" maxlength="60" list="cad-materials" required></label><datalist id="cad-materials"><option value="S235JR"><option value="S355J2"><option value="Edelstahl 1.4301"><option value="Aluminium EN AW-6060"></datalist><label>Menge je Zeichnungselement<input id="cad-part-quantity" type="number" min="1" max="10000" step="1" required></label><label>Wandstärke (0 = Vollmaterial), mm<input id="cad-part-wall" type="number" min="0" max="10000" step="any" required></label><label>Oberfläche<input id="cad-part-finish" maxlength="80" list="cad-finishes"></label><datalist id="cad-finishes"><option value="Unbehandelt"><option value="Feuerverzinkt"><option value="Pulverbeschichtet"><option value="Geschliffen"></datalist><label>Schnitt Anfang / Ende, °<div class="cad-pair"><input aria-label="Schnittwinkel Anfang" id="cad-part-cutStart" type="number" min="0" max="89" step="any" required><input aria-label="Schnittwinkel Ende" id="cad-part-cutEnd" type="number" min="0" max="89" step="any" required></div></label><label>Bohrungen: Anzahl / Ø mm<div class="cad-pair"><input aria-label="Bohrungsanzahl" id="cad-part-drillCount" type="number" min="0" max="10000" step="1" required><input aria-label="Bohrdurchmesser" id="cad-part-drillDiameter" type="number" min="0" max="1000" step="any" required></div></label><label>Fertigungshinweise<textarea id="cad-part-notes" rows="3" maxlength="500" placeholder="z. B. Bohrpositionen, Schweißnähte, Toleranzen"></textarea></label><button type="submit" class="cad-primary">Bauteildaten übernehmen</button></form><div class="cad-section-label">ZEICHNUNGSELEMENTE <span id="cad-count">0</span></div><div id="cad-objects"></div><button id="cad-demo" class="cad-template">＋ Beispiel: Rahmen laden</button><div class="cad-note">Geschlossene Konturen werden zu Vollkörpern extrudiert. Linien und Maße bleiben 2D-Elemente.</div></div></aside></div>
    <footer class="cad-status"><span><i></i><span id="cad-instruction">Element auswählen oder Werkzeug wählen</span></span><span id="cad-coordinates">X 0 · Y 0 mm</span></footer>
  </section><div class="cad-bottom"><span>⌘ / Strg + Z Rückgängig <em>·</em> Esc Abbrechen <em>·</em> Mausrad Zoom</span><span id="cad-message" role="status" aria-live="polite">Bereit zum Konstruieren</span></div>
<section class="cad-production" aria-label="Bauteile und Fertigung"><div class="cad-production-tabs" role="tablist" aria-label="Fertigungsplanung"><button role="tab" id="cad-tab-library" aria-controls="cad-panel-library" aria-selected="true" data-panel="library" class="active">▦ Bauteilbibliothek</button><button role="tab" id="cad-tab-railing" aria-controls="cad-panel-railing" aria-selected="false" data-panel="railing">▥ Geländergenerator</button><button role="tab" id="cad-tab-bom" aria-controls="cad-panel-bom" aria-selected="false" data-panel="bom">☷ Stückliste <span id="cad-bom-badge">0</span></button><button role="tab" id="cad-tab-production" aria-controls="cad-panel-production" aria-selected="false" data-panel="production">⌁ Fertigungsdaten</button></div>
<div id="cad-panel-library" role="tabpanel" aria-labelledby="cad-tab-library" class="cad-production-panel"><div class="cad-panel-heading"><div><h2>Ein Bauteil als Ausgangspunkt.</h2><p>Querschnitt in XY · Profillänge entlang Z. Maße nach dem Einfügen anpassen.</p></div><input id="cad-library-search" type="search" aria-label="Bauteile suchen" placeholder="Bauteil suchen …"></div><div id="cad-library" class="cad-library-grid"></div><p class="cad-production-note">Vorlagen mit frei editierbaren Maßen, keine Herstellerkataloge. Ein Zeichnungselement kann mehrere gleiche Fertigungsteile repräsentieren.</p></div>
<div id="cad-panel-railing" role="tabpanel" aria-labelledby="cad-tab-railing" class="cad-production-panel" hidden>
<div class="cad-panel-heading"><div><h2>Geländer konfigurieren</h2><p>Maße und Materialien auswählen. Das Geländer wird als einzelne Bauteile in die Zeichnung eingefügt.</p></div></div>
<form id="cad-railing-form"><div class="railing-grid"><fieldset><legend>01 · Abmessungen</legend><label>Länge Abschnitt 1, mm<input name="width" type="number" min="300" max="20000" value="2000" required></label><label>Ausrichtung Abschnitt 1, °<input name="angle" type="number" min="-180" max="180" step="any" value="0" required></label><label class="railing-check"><input name="corner" type="checkbox"> Zweiten Abschnitt über Eck hinzufügen</label><label>Länge Abschnitt 2, mm<input name="width2" type="number" min="300" max="20000" value="1500" required disabled></label><label>Richtungsänderung, °<input name="turn" type="number" min="-170" max="170" step="any" value="90" required disabled></label><small>+90° nach links, −90° nach rechts. Eckverbindung und Zuschnitt gesondert festlegen.</small><label>Höhe, mm<input name="height" type="number" min="400" max="3000" value="1000" required></label><label>Max. Pfostenabstand, mm<input name="postSpacing" type="number" min="100" max="3000" value="1000" required></label><label>Unterkante Untergurt, mm<input name="clearance" type="number" min="0" max="1000" value="100" required></label><label>Position X, mm<input name="x" type="number" min="-70000" max="70000" value="0" required></label><label>Position Y, mm<input name="y" type="number" min="-70000" max="70000" value="0" required></label></fieldset>
<fieldset><legend>02 · Materialien & Profile</legend><label>Werkstoff<select name="material"><option>S235JR</option><option>S355J2</option><option>Edelstahl 1.4301</option><option>Aluminium EN AW-6060</option></select></label><label>Oberfläche<select name="finish"><option>Unbehandelt</option><option>Feuerverzinkt</option><option>Pulverbeschichtet</option><option>Geschliffen</option></select></label><label>Pfosten<select name="postProfile"><option>40x40x2</option><option>50x50x2</option><option>60x60x3</option></select></label><label>Handlauf / Untergurt<select name="railProfile"><option>40x40x2</option><option>30x30x2</option><option>50x50x2</option></select></label><small>Quadratprofil: Breite × Höhe × Wandstärke in mm.</small></fieldset>
<fieldset><legend>03 · Füllung & Befestigung</legend><label>Füllung<select name="infill"><option value="bars">Senkrechte Füllstäbe</option><option value="open">Ohne Füllung</option></select></label><label>Füllstabprofil<select name="barProfile"><option>12x12x0</option><option>16x16x0</option><option>20x20x2</option><option>30x30x2</option></select></label><label>Max. lichter Stababstand, mm<input name="barGap" type="number" min="20" max="1000" value="100" required></label><label class="railing-check"><input name="plates" type="checkbox" checked> Fußplatten 100 × 100 × 8 mm</label><small>Bohrungen, Befestigung, Lasten und zulässige Abstände projektspezifisch festlegen.</small></fieldset></div><div class="railing-actions"><button type="submit" class="cad-primary">＋ Geländer in Zeichnung einfügen</button><span id="cad-railing-result" role="status" aria-live="polite">Das Geländer wird zusätzlich zu vorhandenen Bauteilen eingefügt.</span></div></form></div>
<div id="cad-panel-bom" role="tabpanel" aria-labelledby="cad-tab-bom" class="cad-production-panel" hidden><div class="cad-panel-heading"><div><h2>Stückliste deiner Konstruktion</h2><p>Gleiche Geometrie und Fertigungsangaben werden zusammengefasst. Linien und Maße zählen nicht als Bauteile.</p></div><button id="cad-bom-export">CSV exportieren ↗</button></div><div id="cad-bom-summary" class="cad-bom-summary"></div><div class="cad-table-scroll"><table class="cad-data-table"><thead><tr><th>Pos.</th><th>Bauteil / Material</th><th>Maße mm</th><th>Wand mm</th><th>Menge</th><th>Zuschnitt mm</th><th>Oberfläche</th><th>Bearbeiten</th></tr></thead><tbody id="cad-bom-body"></tbody></table></div><p class="cad-production-note">Freie Konturen erscheinen zunächst ohne Materialzuordnung. Maße: Breite × Höhe × Tiefe, bei Rundteilen Ø × Tiefe.</p></div>
<div id="cad-panel-production" role="tabpanel" aria-labelledby="cad-tab-production" class="cad-production-panel" hidden><div class="cad-panel-heading"><div><h2>Fertigungsdaten & Werkstattblatt</h2><p>Planungsangaben je Bauteil · 0° entspricht einem rechtwinkligen Schnitt.</p></div><div class="cad-actions"><button id="cad-production-print">Drucken / PDF</button><button id="cad-production-export" class="cad-primary">Fertigungs-CSV ↗</button></div></div><div id="cad-print-title"></div><div class="cad-table-scroll"><table class="cad-data-table"><thead><tr><th>Pos. / Bauteil</th><th>Menge / Material</th><th>Maße / Wand mm</th><th>Schnitte Anfang / Ende</th><th>Bohrungen je Teil</th><th>Oberfläche / Hinweise</th></tr></thead><tbody id="cad-production-body"></tbody></table></div><p class="cad-production-note">Aktivierte Gehrungen verändern die Profilgeometrie. Andere Schnittwinkel und Bohrungen sind Fertigungsangaben. Bohrpositionen und Toleranzen in den Hinweisen ergänzen. Export als Werkstattdaten, keine CNC-Maschinensteuerung.</p></div></section>
</main>
<script src="/js/cad-parts.js" defer></script>
<script src="/js/cad-railing.js" defer></script>
<script src="/js/cad.js" defer></script>
</body></html>
