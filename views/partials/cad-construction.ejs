<aside class="cad-construction-dock" aria-label="Material und Blech konstruieren">
 <details id="cad-member-dock"><summary title="Profile, Stäbe, Träger und Rahmen">▣<span>Profile</span></summary><div class="cad-dock-form"><h2>Mit Profilen konstruieren</h2><form id="cad-member-form">
 <label>Bauteil<select name="kind"><option value="member">Stab / Profil</option><option value="frame">Rechteckrahmen · stumpf</option><option value="ibeam">I-Träger · aus Blechen</option><option value="channel">U-Träger · aus Blechen</option></select></label>
 <label data-member-fields="member frame">Profil<select name="profile"></select></label>
