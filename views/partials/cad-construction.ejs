 <div class="cad-dock-grid"><label>Länge / Außenlänge<input name="length" type="number" min="20" max="20000" value="2000" required></label><label data-member-fields="frame ibeam channel">Breite / Außenbreite<input name="width" type="number" min="20" max="20000" value="1000" required></label><label data-member-fields="ibeam channel">Trägerhöhe<input name="height" type="number" min="20" max="1500" value="200" required></label><label data-member-fields="ibeam channel">Blechdicke<input name="thickness" type="number" min="1" max="100" value="8" required></label></div>
 <label>Werkstoff<select name="material" data-construction-material></select></label><label>Oberfläche<select name="finish"><option>Unbehandelt</option><option>Feuerverzinkt</option><option>Pulverbeschichtet</option><option>Geschliffen</option></select></label>
