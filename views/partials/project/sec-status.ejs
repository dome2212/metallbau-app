      <section id="sec-status" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2" data-sec="sec-status">
          <span class="sec-label text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700">Status</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        </div>
      <div class="sec-body space-y-3">
      <div class="card-clean">
        <p class="text-sm text-slate-600 dark:text-slate-300 mb-3">Aktuell: <span class="font-bold text-slate-800 dark:text-slate-100"><%= project.status || '—' %></span></p>
        <% if (typeof statusLog !== 'undefined' && statusLog && statusLog.length) { %>
          <ul class="space-y-2">
            <% statusLog.forEach(function(s) { %>
            <li class="flex gap-2 text-sm border-l-2 border-slate-300 dark:border-slate-600 pl-3 py-1">
              <div>
                <span class="font-semibold text-slate-700 dark:text-slate-200"><%= s.old_status || '—' %> → <%= s.new_status %></span>
                <p class="text-[10px] text-slate-400"><%= s.created_at ? new Date(s.created_at).toLocaleString('de-DE') : '' %><%= s.username ? ' · ' + s.username : '' %></p>
              </div>
            </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-sm text-slate-400 text-center py-4">Noch keine Statusänderungen.</p>
        <% } %>
      </div>
      </div><!-- /sec-body -->
</section>
