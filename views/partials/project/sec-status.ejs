      <section id="sec-status" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-status" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700">7 · Statusverlauf</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="card-clean">
    <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2 mb-4">📋 Statusverlauf</h2>
    <% if (statusLog && statusLog.length > 0) { %>
      <ol class="relative border-l border-slate-200 dark:border-slate-700 ml-2 space-y-4">
        <% statusLog.forEach((entry, idx) => { %>
          <li class="ml-4">
            <div class="absolute -left-1.5 w-3 h-3 rounded-full border-2 border-white dark:border-slate-800 <%= idx === statusLog.length - 1 ? 'bg-blue-500' : 'bg-slate-300 dark:bg-slate-600' %>"></div>
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <% if (entry.old_status) { %>
                <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium"><%= entry.old_status %></span>
                <span class="text-slate-400">→</span>
              <% } %>
              <span class="px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-semibold"><%= entry.new_status %></span>
              <span class="text-xs text-slate-400 dark:text-slate-500">
                von <strong class="text-slate-600 dark:text-slate-300"><%= entry.changed_by %></strong>
                · <%= new Date(entry.created_at).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' }) %>
              </span>
            </div>
          </li>
        <% }) %>
      </ol>
    <% } else { %>
      <p class="text-sm text-slate-400 dark:text-slate-500 italic">Noch keine Statusänderungen aufgezeichnet.</p>
    <% } %>
  </div>
</div>

            </div><!-- /sec-body -->
</section>

