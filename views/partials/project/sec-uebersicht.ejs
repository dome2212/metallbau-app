      <section id="sec-uebersicht" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2" data-sec="sec-uebersicht">
          <span class="sec-label text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30">1 · Übersicht</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        </div>
      <div class="sec-body space-y-4">

      <!-- KPI -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-3">
          <p class="text-[10px] uppercase font-semibold text-slate-400 tracking-wide">Stunden</p>
          <p class="text-xl font-bold text-slate-800 dark:text-slate-100 tabular-nums"><%= typeof projectTotalHours !== 'undefined' ? projectTotalHours : '0' %> <span class="text-sm font-semibold text-slate-400">h</span></p>
        </div>
        <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-3">
          <p class="text-[10px] uppercase font-semibold text-slate-400 tracking-wide">Nächster Termin</p>
          <% if (typeof nextAppointment !== 'undefined' && nextAppointment) { %>
            <p class="text-base font-bold text-slate-800 dark:text-slate-100"><%= new Date(nextAppointment.start_date).toLocaleDateString('de-DE') %></p>
          <% } else { %>
            <p class="text-base font-semibold text-slate-400">—</p>
          <% } %>
        </div>
        <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-3">
          <p class="text-[10px] uppercase font-semibold text-slate-400 tracking-wide">Fotos</p>
          <p class="text-xl font-bold text-slate-800 dark:text-slate-100 tabular-nums"><%= (typeof photos !== 'undefined' && photos) ? photos.length : 0 %></p>
        </div>
        <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-3">
          <p class="text-[10px] uppercase font-semibold text-slate-400 tracking-wide">Offene RE</p>
          <% const oi = (typeof openInvoices !== 'undefined' && openInvoices) ? openInvoices : []; %>
          <p class="text-xl font-bold tabular-nums <%= oi.length ? 'text-amber-600' : 'text-slate-800 dark:text-slate-100' %>"><%= oi.length %></p>
        </div>
      </div>

      <% if (oi.length) { %>
      <div class="rounded-xl border border-amber-200/80 dark:border-amber-800/60 bg-amber-50/40 dark:bg-amber-900/10 px-3 py-2">
        <ul class="space-y-1">
          <% oi.slice(0,5).forEach(function(inv) { %>
          <li class="flex justify-between items-center text-sm gap-2">
            <a href="/documents/invoices/<%= inv.id %>" class="text-blue-600 dark:text-blue-400 font-medium hover:underline truncate"><%= inv.doc_number %></a>
            <span class="text-xs text-slate-500 shrink-0"><%= inv.status %></span>
          </li>
          <% }); %>
        </ul>
      </div>
      <% } %>

      <!-- Aktionen -->
      <div class="flex flex-wrap gap-2">
        <% if (project.customer_id) { %>
          <a href="/customers/<%= project.customer_id %>" class="text-xs px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 font-semibold text-slate-700 dark:text-slate-200">Kundenakte</a>
          <form action="/documents/delivery/create" method="POST" class="inline">
            <input type="hidden" name="customer_id" value="<%= project.customer_id %>">
            <input type="hidden" name="project_id" value="<%= project.id %>">
            <button type="submit" class="text-xs px-3 py-2 rounded-lg bg-orange-600 text-white font-semibold">Lieferschein</button>
          </form>
        <% } %>
        <button type="button" class="text-xs px-3 py-2 rounded-lg border border-emerald-300 text-emerald-700 dark:text-emerald-300 font-semibold nav-chip-link" data-target="sec-abnahme">Abnahme</button>
      </div>

      <!-- Projektdetails -->
      <div class="card-clean space-y-3">
        <h2 class="text-sm font-bold text-slate-800 dark:text-gray-100">Projektdetails</h2>

        <div>
          <p class="text-[10px] uppercase font-semibold text-slate-400">Kunde / Baustelle</p>
          <p class="font-semibold text-slate-800 dark:text-slate-100"><%= project.company_name || project.contact_person || '—' %></p>
          <% if (project.street || project.city) { %>
            <p class="text-sm text-slate-500 dark:text-slate-400"><%= [project.street, [project.zip, project.city].filter(Boolean).join(' ')].filter(Boolean).join(', ') %></p>
          <% } %>
          <% if (project.street && project.city) {
            const encAddr = encodeURIComponent((project.street + ', ' + (project.zip || '') + ' ' + project.city).trim());
            const googleUrl = 'https://www.google.com/maps/dir/?api=1&destination=' + encAddr;
            const appleUrl  = 'https://maps.apple.com/?daddr=' + encAddr;
            const wazeUrl   = 'https://waze.com/ul?q=' + encAddr + '&navigate=yes';
          %>
          <div class="flex flex-wrap gap-1.5 mt-2">
            <a href="<%= googleUrl %>" target="_blank" rel="noopener" class="text-[11px] px-2.5 py-1 rounded-md bg-blue-600 text-white font-semibold">Google Maps</a>
            <a href="<%= appleUrl %>" target="_blank" rel="noopener" class="text-[11px] px-2.5 py-1 rounded-md bg-slate-600 text-white font-semibold">Apple Maps</a>
            <a href="<%= wazeUrl %>" target="_blank" rel="noopener" class="text-[11px] px-2.5 py-1 rounded-md bg-sky-500 text-white font-semibold">Waze</a>
          </div>
          <% } %>
        </div>

        <% if (project.site_note) { %>
        <div class="rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 px-3 py-2 text-xs text-amber-800 dark:text-amber-200">
          <span class="font-semibold">Anfahrt:</span> <%= project.site_note %>
        </div>
        <% } %>

        <% if ((currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') && (typeof canSeeMoney === 'undefined' || canSeeMoney)) { %>
        <div class="flex items-baseline justify-between gap-2 pt-1 border-t border-slate-100 dark:border-slate-700">
          <span class="text-[10px] uppercase font-semibold text-slate-400">Auftragssumme</span>
          <span class="text-lg font-bold text-slate-800 dark:text-gray-100 tabular-nums"><%= (Number(project.total_price) || 0).toLocaleString('de-DE', { minimumFractionDigits: 2 }) %> €</span>
        </div>
        <% } %>

        <% if (project.description) { %>
        <div>
          <p class="text-[10px] uppercase font-semibold text-slate-400">Beschreibung</p>
          <p class="text-sm text-slate-600 dark:text-slate-300 whitespace-pre-wrap"><%= project.description %></p>
        </div>
        <% } %>
      </div>

      <!-- Geo-Fencing (Admin) – eingeklappt -->
      <% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') { %>
      <details class="card-clean group">
        <summary class="cursor-pointer list-none flex items-center justify-between gap-2">
          <span class="text-sm font-bold text-slate-800 dark:text-gray-100">Geo-Fencing</span>
          <% if (project.site_lat && project.site_lng) { %>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">Aktiv · <%= project.site_radius || 200 %> m</span>
          <% } else { %>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 dark:bg-slate-700">Nicht gesetzt</span>
          <% } %>
        </summary>
        <form action="/projects/<%= project.id %>/set-location" method="POST" class="mt-3 space-y-2 pt-3 border-t border-slate-100 dark:border-slate-700" id="geo-form">
          <div>
            <label class="block text-[10px] text-slate-500 uppercase mb-0.5">Adresse suchen</label>
            <div class="flex gap-1">
              <input type="text" id="geo-address-input" placeholder="Straße, PLZ Ort"
                class="flex-1 text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-2 py-2 bg-white">
              <button type="button" onclick="geocodeAddress()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-2 rounded-lg">Suchen</button>
            </div>
            <% if (project.street && project.city) { %>
              <button type="button"
                onclick="useCustomerAddress('<%= (project.street + ', ' + (project.zip || '') + ' ' + project.city).trim().replace(/'/g, "\\'") %>')"
                class="mt-1 text-[11px] text-indigo-600 hover:underline">Kundenadresse übernehmen</button>
            <% } %>
            <p id="geo-status" class="text-[10px] mt-1 hidden"></p>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[10px] text-slate-500 uppercase mb-0.5">Lat</label>
              <input type="number" step="0.0000001" name="site_lat" id="geo-lat" value="<%= project.site_lat || '' %>"
                class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-2 py-2 bg-white">
            </div>
            <div>
              <label class="block text-[10px] text-slate-500 uppercase mb-0.5">Lng</label>
              <input type="number" step="0.0000001" name="site_lng" id="geo-lng" value="<%= project.site_lng || '' %>"
                class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-2 py-2 bg-white">
            </div>
          </div>
          <div>
            <label class="block text-[10px] text-slate-500 uppercase mb-0.5">Radius (m)</label>
            <input type="number" name="site_radius" value="<%= project.site_radius || 200 %>" min="50" max="2000"
              class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-2 py-2 bg-white">
          </div>
          <div>
            <label class="block text-[10px] text-slate-500 uppercase mb-0.5">Anfahrtshinweis</label>
            <textarea name="site_note" rows="2" placeholder="z. B. Zufahrt über Hintereingang"
              class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-2 py-2 bg-white"><%= project.site_note || '' %></textarea>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="submit" class="text-xs px-3 py-2 rounded-lg bg-indigo-600 text-white font-semibold">Speichern</button>
            <button type="button" onclick="if(navigator.geolocation){navigator.geolocation.getCurrentPosition(function(p){document.getElementById('geo-lat').value=p.coords.latitude;document.getElementById('geo-lng').value=p.coords.longitude;})}" class="text-xs px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 font-semibold">Mein Standort</button>
          </div>
        </form>
      </details>
      <% } %>

      <!-- Dateien -->
      <details class="card-clean" <%= (files && files.length) ? 'open' : '' %>>
        <summary class="cursor-pointer list-none flex items-center justify-between gap-2">
          <span class="text-sm font-bold text-slate-800 dark:text-gray-100">Zeichnungen &amp; Dateien</span>
          <span class="text-[10px] text-slate-400"><%= (files && files.length) ? files.length + ' Datei(en)' : 'Keine' %></span>
        </summary>
        <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-700 space-y-3">
          <form action="/projects/<%= project.id %>/upload" method="POST" enctype="multipart/form-data" class="flex flex-col sm:flex-row gap-2 items-stretch sm:items-center">
            <input type="file" name="file" required class="flex-1 text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700">
            <button type="submit" class="text-xs px-3 py-2 rounded-lg bg-blue-600 text-white font-semibold shrink-0">Hochladen</button>
          </form>
          <% if (files && files.length > 0) { %>
            <ul class="divide-y divide-slate-100 dark:divide-slate-700">
              <% files.forEach(file => { %>
              <li class="flex items-center justify-between gap-2 py-2 text-sm">
                <a href="<%= file.file_url %>" target="_blank" class="truncate text-blue-600 hover:underline"><%= file.original_name %></a>
                <form action="/projects/files/delete" method="POST" onsubmit="return confirm('Datei löschen?');" class="shrink-0">
                  <input type="hidden" name="file_id" value="<%= file.id %>">
                  <input type="hidden" name="project_id" value="<%= project.id %>">
                  <button type="submit" class="text-xs text-red-500 hover:text-red-700">Löschen</button>
                </form>
              </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </details>

      <!-- Nachkalkulation (nur Übersicht, nur mit Geld-Recht) -->
      <% if (typeof nachkalk !== 'undefined' && nachkalk && (typeof canSeeMoney === 'undefined' || canSeeMoney)) {
           const n = nachkalk;
           const fmt = (v) => Number(v || 0).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
           const profitOk = n.profitNet >= 0;
      %>
      <div class="card-clean space-y-3">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-sm font-bold text-slate-800 dark:text-gray-100">Nachkalkulation</h2>
          <% if (n.offerNumber) { %>
            <span class="text-[10px] text-slate-400">Angebot <%= n.offerNumber %></span>
          <% } else { %>
            <span class="text-[10px] text-amber-600">Kein Angebot verknüpft</span>
          <% } %>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div class="rounded-lg bg-slate-50 dark:bg-slate-800/60 p-2.5">
            <p class="text-[10px] uppercase text-slate-400 font-semibold">Ist-Stunden</p>
            <p class="text-base font-bold tabular-nums"><%= projectTotalHours || '0.00' %> h</p>
          </div>
          <div class="rounded-lg bg-slate-50 dark:bg-slate-800/60 p-2.5">
            <p class="text-[10px] uppercase text-slate-400 font-semibold">Lohn</p>
            <p class="text-base font-bold tabular-nums"><%= fmt(n.laborCost) %> €</p>
          </div>
          <div class="rounded-lg bg-slate-50 dark:bg-slate-800/60 p-2.5">
            <p class="text-[10px] uppercase text-slate-400 font-semibold">Material</p>
            <p class="text-base font-bold tabular-nums"><%= fmt(n.materialCost) %> €</p>
          </div>
          <div class="rounded-lg bg-slate-50 dark:bg-slate-800/60 p-2.5">
            <p class="text-[10px] uppercase text-slate-400 font-semibold">Ist gesamt</p>
            <p class="text-base font-bold tabular-nums"><%= fmt(n.actualCost) %> €</p>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div class="rounded-lg border border-blue-200 dark:border-blue-800 bg-blue-50/50 dark:bg-blue-900/20 p-2.5">
            <p class="text-[10px] uppercase text-blue-500 font-semibold">Angebot</p>
            <p class="text-sm font-bold text-blue-800 dark:text-blue-300 tabular-nums"><%= fmt(n.offerNet) %> €</p>
          </div>
          <div class="rounded-lg border <%= profitOk ? 'border-emerald-200 bg-emerald-50/50 dark:border-emerald-800 dark:bg-emerald-900/20' : 'border-red-200 bg-red-50/50 dark:border-red-800 dark:bg-red-900/20' %> p-2.5">
            <p class="text-[10px] uppercase <%= profitOk ? 'text-emerald-600' : 'text-red-600' %> font-semibold">Ergebnis</p>
            <p class="text-sm font-bold tabular-nums <%= profitOk ? 'text-emerald-700 dark:text-emerald-400' : 'text-red-700' %>"><%= profitOk ? '+' : '' %><%= fmt(n.profitNet) %> €</p>
          </div>
          <div class="rounded-lg border border-slate-200 dark:border-slate-600 p-2.5">
            <p class="text-[10px] uppercase text-slate-400 font-semibold">Marge</p>
            <p class="text-sm font-bold tabular-nums"><% if (n.marginPct != null) { %><%= Number(n.marginPct).toFixed(1) %>%<% } else { %>—<% } %></p>
          </div>
        </div>
        <p class="text-[10px] text-slate-400">Stundensatz <%= fmt(n.hourlyRate) %> € · Lohn + Material vs. Angebot netto</p>
      </div>
      <% } %>

            </div><!-- /sec-body -->
</section>
