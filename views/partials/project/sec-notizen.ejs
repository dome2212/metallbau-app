      <section id="sec-notizen" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2" data-sec="sec-notizen">
          <span class="sec-label text-violet-600 dark:text-violet-400 bg-violet-50 dark:bg-violet-900/30">4 · Notizen</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        </div>
      <div class="sec-body space-y-3">

      <div class="card-clean space-y-3">
        <form action="/projects/<%= project.id %>/notes/add" method="POST" id="noteForm" class="space-y-2">
          <textarea name="note_text" id="noteTextArea" rows="3" required
            class="w-full text-sm border border-slate-200 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded-xl px-3 py-2.5 bg-white focus:outline-none focus:ring-2 focus:ring-violet-500"
            placeholder="Notiz, Absprache, Baustellen-Info…"></textarea>
          <div class="flex flex-wrap gap-2 items-center">
            <button type="submit" class="text-xs px-3 py-2 rounded-lg bg-violet-600 hover:bg-violet-700 text-white font-semibold">Speichern</button>
            <button type="button" id="btnSpeechNote" class="text-xs px-3 py-2 rounded-lg border border-violet-300 text-violet-700 dark:text-violet-300 font-semibold">🎤 Diktieren</button>
            <span id="speechNoteStatus" class="text-xs text-slate-400"></span>
          </div>
        </form>
        <script>
        (function(){
          var btn = document.getElementById('btnSpeechNote');
          var ta = document.getElementById('noteTextArea');
          var st = document.getElementById('speechNoteStatus');
          if (!btn || !ta) return;
          var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
          if (!SR) { btn.style.display = 'none'; return; }
          var rec = new SR();
          rec.lang = 'de-DE';
          rec.continuous = false;
          rec.interimResults = false;
          var listening = false;
          btn.addEventListener('click', function(){
            if (listening) { try { rec.stop(); } catch(e){} listening = false; btn.textContent = '🎤 Diktieren'; st.textContent = ''; return; }
            listening = true;
            btn.textContent = '⏹ Stop';
            st.textContent = 'Hört zu…';
            try { rec.start(); } catch(e) { st.textContent = 'Mikrofon-Fehler'; listening = false; btn.textContent = '🎤 Diktieren'; }
          });
          rec.onresult = function(ev){
            var t = '';
            for (var i = 0; i < ev.results.length; i++) t += ev.results[i][0].transcript;
            if (t) ta.value = (ta.value ? ta.value + ' ' : '') + t.trim();
          };
          rec.onerror = function(){ listening = false; btn.textContent = '🎤 Diktieren'; st.textContent = 'Fehler / Mikrofon?'; };
          rec.onend = function(){ listening = false; btn.textContent = '🎤 Diktieren'; if (st.textContent === 'Hört zu…') st.textContent = 'Fertig'; };
        })();
        </script>
      </div>

      <div class="card-clean">
        <% if (notes && notes.length > 0) { %>
          <ul class="divide-y divide-slate-100 dark:divide-slate-700">
            <% notes.forEach(note => { %>
            <li class="py-3 flex gap-3 items-start">
              <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-800 dark:text-gray-200 whitespace-pre-wrap"><%= note.note_text %></p>
                <p class="text-[10px] text-slate-400 mt-1"><%= new Date(note.created_at).toLocaleString('de-DE') %></p>
              </div>
              <form action="/projects/notes/delete" method="POST" onsubmit="return confirm('Notiz löschen?');" class="shrink-0">
                <input type="hidden" name="note_id" value="<%= note.id %>">
                <input type="hidden" name="project_id" value="<%= project.id %>">
                <button type="submit" class="text-xs text-red-500 hover:text-red-700">Löschen</button>
              </form>
            </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-sm text-slate-400 text-center py-6">Noch keine Notizen.</p>
        <% } %>
      </div>

      </div><!-- /sec-body -->
</section>
