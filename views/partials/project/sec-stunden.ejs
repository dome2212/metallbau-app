      <section id="sec-stunden" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2" data-sec="sec-stunden">
          <span class="sec-label text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/30">9 · Stunden &amp; Kalkulation</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        </div>
      <div class="sec-body">
      <div class="card-clean">
    <div class="flex items-center justify-between gap-3 border-b dark:border-slate-700 pb-3 mb-4">
      <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100">⏱️ Stunden &amp; Nachkalkulation</h2>
      <% if (typeof projectTotalHours !== 'undefined' && parseFloat(projectTotalHours) > 0) { %>
        <span class="text-sm font-bold text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 rounded-full">
          Gesamt: <%= projectTotalHours %> Std.
        </span>
      <% } %>
    </div>

    <% if (typeof projectHours !== 'undefined' && projectHours.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[380px]">
          <thead class="bg-slate-50 dark:bg-slate-700/50 text-slate-600 dark:text-slate-300 uppercase text-xs">
            <tr>
              <th class="px-4 py-2">Mitarbeiter</th>
              <th class="px-4 py-2 text-right">Stunden</th>
              <th class="px-4 py-2 text-right hidden md:table-cell">Anteil</th>
              <th class="px-4 py-2 hidden md:table-cell">Fortschritt</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            <% projectHours.forEach(row => {
                 const pct = projectTotalHours > 0 ? Math.round((parseFloat(row.hours) / parseFloat(projectTotalHours)) * 100) : 0;
            %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30">
              <td class="px-4 py-2.5 font-medium text-slate-700 dark:text-slate-200">👤 <%= row.username %></td>
              <td class="px-4 py-2.5 text-right font-bold text-slate-800 dark:text-gray-100"><%= row.hours %> Std.</td>
              <td class="px-4 py-2.5 text-right text-slate-500 dark:text-slate-400 hidden md:table-cell"><%= pct %> %</td>
              <td class="px-4 py-2.5 hidden md:table-cell">
                <div class="w-full bg-slate-100 dark:bg-slate-700 rounded-full h-2">
                  <div class="h-2 rounded-full bg-indigo-500" style="width:<%= pct %>%"></div>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot class="border-t-2 border-slate-200 dark:border-slate-600 font-semibold text-slate-700 dark:text-slate-200">
            <tr>
              <td class="px-4 py-2.5">Gesamt</td>
              <td class="px-4 py-2.5 text-right text-indigo-700 dark:text-indigo-300 font-bold"><%= projectTotalHours %> Std.</td>
              <td class="hidden md:table-cell"></td>
              <td class="hidden md:table-cell"></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-3">
        💡 Nur abgeschlossene IN/OUT-Paare werden gezählt. Laufende Schichten werden beim nächsten Ausstempeln erfasst.
      </p>
    <% } else { %>
      <div class="text-center py-8 text-slate-400 dark:text-slate-500">
        <p class="text-3xl mb-2">⏱️</p>
        <p class="text-sm font-medium">Noch keine Stunden auf dieses Projekt gebucht.</p>
        <p class="text-xs mt-1">Mitarbeiter können beim Einstempeln dieses Projekt auswählen.</p>
      </div>
    <% } %>

    <!-- ── Materialkosten-Zusammenfassung ── -->
    <% var _matKosten = (typeof entnahmen !== 'undefined' && Array.isArray(entnahmen))
      ? entnahmen.reduce(function(sum, e) { return sum + (Number(e.gesamtpreis) || 0); }, 0)
      : 0; %>
    <% if (_matKosten > 0) { %>
    <div class="mt-5 pt-4 border-t dark:border-slate-700">
      <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-3">📦 Materialkosten</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        <div class="bg-orange-50 dark:bg-orange-900/20 rounded-lg px-4 py-3 text-center">
          <p class="text-xs text-slate-500 dark:text-slate-400">Materialkosten</p>
          <p class="text-lg font-bold text-orange-700 dark:text-orange-400 mt-0.5">
            <%= _matKosten.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) %> €
          </p>
        </div>
        <div class="bg-indigo-50 dark:bg-indigo-900/20 rounded-lg px-4 py-3 text-center">
          <p class="text-xs text-slate-500 dark:text-slate-400">Positionen</p>
          <p class="text-lg font-bold text-indigo-700 dark:text-indigo-300 mt-0.5">
            <%= entnahmen.filter(e => Number(e.gesamtpreis) > 0).length %> bepreist
            <span class="text-xs font-normal text-slate-400">/ <%= entnahmen.length %> gesamt</span>
          </p>
        </div>
        <% if (typeof projectTotalHours !== 'undefined' && parseFloat(projectTotalHours) > 0) { %>
        <div class="bg-emerald-50 dark:bg-emerald-900/20 rounded-lg px-4 py-3 text-center md:col-span-1 col-span-2">
          <p class="text-xs text-slate-500 dark:text-slate-400">Gesamtkosten (Mat. + Std.)</p>
          <p class="text-lg font-bold text-emerald-700 dark:text-emerald-400 mt-0.5">
            <%=
              (_matKosten + parseFloat(projectTotalHours) * 0)
                .toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2})
            %> €
            <span class="text-xs font-normal text-slate-400 block">+ <%= projectTotalHours %> Std. (Lohn separat)</span>
          </p>
        </div>
        <% } %>
      </div>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-2">
        💡 Preis je Einheit wird automatisch aus dem Lagereintrag übernommen. Ohne hinterlegten Preis erscheint „–".
      </p>
    </div>
    <% } %>

  </div>
            </div><!-- /sec-body -->
</section>


      <!-- ========== AUFTRAGS-CHAT ========== -->


    <!-- Nachkalkulation: Angebot vs. Ist -->
    <% if (typeof nachkalk !== 'undefined' && nachkalk) {
         const n = nachkalk;
         const fmt = (v) => Number(v || 0).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
         const profitOk = n.profitNet >= 0;
    %>
    <div class="mt-6 border-t border-slate-200 dark:border-slate-700 pt-5">
      <h3 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-3 flex items-center gap-2">
        <span>📊</span> Nachkalkulation
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
        Vergleich Angebot (Netto) mit internen Kosten aus Stunden × Stundensatz + Material.
        Stundensatz: <strong><%= fmt(n.hourlyRate) %> €</strong>
        <% if (n.offerNumber) { %> · Angebot <strong><%= n.offerNumber %></strong><% } else { %> · <span class="text-amber-600">Kein Angebot verknüpft – Kosten werden trotzdem berechnet</span><% } %>
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
        <div class="rounded-xl border border-slate-200 dark:border-slate-600 p-3 bg-slate-50 dark:bg-slate-800/50">
          <p class="text-[10px] uppercase text-slate-400 font-semibold">Stunden (Ist)</p>
          <p class="text-lg font-bold text-slate-800 dark:text-gray-100"><%= projectTotalHours || '0.00' %> Std.</p>
          <% if (n.plannedHours != null) { %>
            <p class="text-[10px] text-slate-400">Geplant: <%= fmt(n.plannedHours) %> Std.</p>
          <% } %>
        </div>
        <div class="rounded-xl border border-slate-200 dark:border-slate-600 p-3 bg-slate-50 dark:bg-slate-800/50">
          <p class="text-[10px] uppercase text-slate-400 font-semibold">Lohnkosten</p>
          <p class="text-lg font-bold text-slate-800 dark:text-gray-100"><%= fmt(n.laborCost) %> €</p>
          <p class="text-[10px] text-slate-400"><%= projectTotalHours || 0 %> × <%= fmt(n.hourlyRate) %> €</p>
        </div>
        <div class="rounded-xl border border-slate-200 dark:border-slate-600 p-3 bg-slate-50 dark:bg-slate-800/50">
          <p class="text-[10px] uppercase text-slate-400 font-semibold">Material</p>
          <p class="text-lg font-bold text-slate-800 dark:text-gray-100"><%= fmt(n.materialCost) %> €</p>
          <p class="text-[10px] text-slate-400">Lager-Entnahmen</p>
        </div>
        <div class="rounded-xl border border-slate-200 dark:border-slate-600 p-3 bg-slate-50 dark:bg-slate-800/50">
          <p class="text-[10px] uppercase text-slate-400 font-semibold">Ist-Kosten gesamt</p>
          <p class="text-lg font-bold text-slate-800 dark:text-gray-100"><%= fmt(n.actualCost) %> €</p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="rounded-xl border border-blue-200 dark:border-blue-800 p-3 bg-blue-50 dark:bg-blue-900/20">
          <p class="text-[10px] uppercase text-blue-500 font-semibold">Angebot Netto</p>
          <p class="text-xl font-bold text-blue-800 dark:text-blue-300"><%= fmt(n.offerNet) %> €</p>
          <% if (n.offerGross) { %><p class="text-[10px] text-blue-400">Brutto <%= fmt(n.offerGross) %> €</p><% } %>
        </div>
        <div class="rounded-xl border <%= profitOk ? 'border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-900/20' : 'border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/20' %> p-3">
          <p class="text-[10px] uppercase <%= profitOk ? 'text-emerald-600' : 'text-red-600' %> font-semibold">Ergebnis (Netto − Ist)</p>
          <p class="text-xl font-bold <%= profitOk ? 'text-emerald-700 dark:text-emerald-400' : 'text-red-700 dark:text-red-400' %>">
            <%= profitOk ? '+' : '' %><%= fmt(n.profitNet) %> €
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 dark:border-slate-600 p-3">
          <p class="text-[10px] uppercase text-slate-400 font-semibold">Marge</p>
          <p class="text-xl font-bold text-slate-800 dark:text-gray-100">
            <% if (n.marginPct != null) { %><%= Number(n.marginPct).toFixed(1) %> %<% } else { %>–<% } %>
          </p>
        </div>
      </div>
    </div>
    <% } %>
