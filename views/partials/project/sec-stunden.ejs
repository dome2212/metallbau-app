      <section id="sec-stunden" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2" data-sec="sec-stunden">
          <span class="sec-label text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/30">9 · Stunden</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        </div>
      <div class="sec-body space-y-3">
      <div class="card-clean">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-sm font-bold text-slate-800 dark:text-gray-100">Gebuchte Stunden</h2>
          <% if (typeof projectTotalHours !== 'undefined' && parseFloat(projectTotalHours) > 0) { %>
            <span class="text-xs font-bold text-indigo-600 bg-indigo-50 dark:bg-indigo-900/30 px-2.5 py-1 rounded-full"><%= projectTotalHours %> Std.</span>
          <% } %>
        </div>
        <% if (typeof projectHours !== 'undefined' && projectHours.length > 0) { %>
          <ul class="divide-y divide-slate-100 dark:divide-slate-700">
            <% projectHours.forEach(row => {
                 const pct = projectTotalHours > 0 ? Math.round((parseFloat(row.hours) / parseFloat(projectTotalHours)) * 100) : 0;
            %>
            <li class="py-2.5 flex items-center gap-3">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate"><%= row.username %></p>
                <div class="mt-1 h-1.5 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden">
                  <div class="h-full bg-indigo-500 rounded-full" style="width:<%= pct %>%"></div>
                </div>
              </div>
              <div class="text-right shrink-0">
                <p class="text-sm font-bold tabular-nums"><%= row.hours %> h</p>
                <p class="text-[10px] text-slate-400"><%= pct %>%</p>
              </div>
            </li>
            <% }) %>
          </ul>
          <p class="text-[10px] text-slate-400 mt-3">Nur abgeschlossene IN/OUT-Paare. Laufende Schichten nach dem Ausstempeln.</p>
        <% } else { %>
          <p class="text-sm text-slate-400 text-center py-8">Noch keine Stunden gebucht.</p>
        <% } %>
      </div>
      </div><!-- /sec-body -->
</section>
