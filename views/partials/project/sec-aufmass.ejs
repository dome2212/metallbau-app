      <section id="sec-aufmass" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2" data-sec="sec-aufmass">
          <span class="sec-label text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30">2 · Aufmaß &amp; Skizzen</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        </div>
      <div class="sec-body">
      <div class="card-clean space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📐 Digitales Aufmaß (Baustelle)</h2>
        
        <!-- Eingabeformular -->
        <form action="/projects/<%= project.id %>/measurements/add" method="POST" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-3 items-end bg-slate-50 dark:bg-slate-700 p-4 rounded border dark:border-slate-600">
          <div class="md:col-span-3">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Bauteil / Element *</label>
            <input type="text" name="component_name" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. Pfosten links" required>
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Breite (mm)</label>
            <input type="text" name="width" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. 1200">
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Höhe / Länge (mm)</label>
            <input type="text" name="height" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. 900">
          </div>
          <div class="md:col-span-1">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Winkel (°)</label>
            <input type="text" name="angle" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. 45">
          </div>
          <div class="md:col-span-1">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Anzahl</label>
            <input type="number" name="quantity" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" value="1" min="1">
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Bemerkung</label>
            <input type="text" name="note" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. Dachschräge">
          </div>
          <div class="md:col-span-1">
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 rounded transition text-lg">+</button>
          </div>
        </form>

        <!-- Tabelle der bisherigen Aufmaße -->
        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 pt-2">Erfasste Maße:</h3>
        <% if (measurements && measurements.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm min-w-[600px]">
              <thead>
                <tr class="bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 border-b dark:border-slate-600">
                  <th class="p-2.5">Bauteil</th>
                  <th class="p-2.5">Breite</th>
                  <th class="p-2.5">Höhe / Länge</th>
                  <th class="p-2.5">Winkel</th>
                  <th class="p-2.5">Anzahl</th>
                  <th class="p-2.5">Notiz</th>
                  <th class="p-2.5 text-right">Aktion</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                <% measurements.forEach(m => { %>
                  <tr class="hover:bg-slate-50 dark:hover:bg-slate-700">
                    <td class="p-2.5 font-semibold text-slate-800 dark:text-gray-100"><%= m.component_name %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.width ? m.width + ' mm' : '-' %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.height ? m.height + ' mm' : '-' %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.angle ? m.angle + '°' : '-' %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.quantity %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.note || '-' %></td>
                    <td class="p-2.5 text-right">
                      <form action="/projects/measurements/delete" method="POST" onsubmit="return confirm('Eintrag wirklich löschen?');" class="inline">
                        <input type="hidden" name="measurement_id" value="<%= m.id %>">
                        <input type="hidden" name="project_id" value="<%= project.id %>">
                        <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 px-2 py-1 rounded text-xs font-medium transition">Löschen</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-400 dark:text-slate-500 italic">Noch keine Maße für dieses Projekt erfasst.</p>
        <% } %>

        <!-- ===== FREIHAND-SKIZZE / ZEICHNEN IM AUFMASS ===== -->
        <div class="mt-6 pt-4 border-t dark:border-slate-700 space-y-3">
          <h3 class="text-sm font-semibold text-slate-800 dark:text-gray-100">✏️ Skizze zeichnen &amp; Text einfügen</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Freihand zeichnen, Maße als Text platzieren und die Skizze speichern. Optional über ein Baustellenfoto zeichnen. Ideal für Baustellen-Aufmaß per Tablet/Handy.</p>

          <div class="flex flex-wrap items-center gap-2 bg-slate-50 dark:bg-slate-700 p-3 rounded border dark:border-slate-600">
            <button type="button" id="sketch-tool-pen" class="sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-blue-600 text-white" data-tool="pen" title="Stift">✏️ Stift</button>
            <button type="button" id="sketch-tool-line" class="sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200" data-tool="line" title="Linie">／ Linie</button>
            <button type="button" id="sketch-tool-rect" class="sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200" data-tool="rect" title="Rechteck">▭ Rechteck</button>
            <button type="button" id="sketch-tool-text" class="sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200" data-tool="text" title="Text">🔤 Text</button>
            <button type="button" id="sketch-tool-eraser" class="sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200" data-tool="eraser" title="Radierer">🧽 Radierer</button>
            <span class="w-px h-6 bg-slate-300 dark:bg-slate-500 mx-1"></span>
            <label class="text-xs text-slate-600 dark:text-slate-300 flex items-center gap-1">Farbe
              <input type="color" id="sketch-color" value="#1e293b" class="w-8 h-7 rounded border cursor-pointer">
            </label>
            <label class="text-xs text-slate-600 dark:text-slate-300 flex items-center gap-1">Stärke
              <input type="range" id="sketch-size" min="1" max="20" value="3" class="w-20">
              <span id="sketch-size-label" class="w-5 text-center">3</span>
            </label>
            <label class="text-xs text-slate-600 dark:text-slate-300 flex items-center gap-1">Schrift
              <select id="sketch-font-size" class="text-xs border dark:border-slate-600 dark:bg-slate-800 rounded px-1 py-1">
                <option value="14">14</option>
                <option value="18" selected>18</option>
                <option value="24">24</option>
                <option value="32">32</option>
              </select>
            </label>
            <span class="w-px h-6 bg-slate-300 dark:bg-slate-500 mx-1"></span>
            <button type="button" id="sketch-undo" class="px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200">↩ Rückgängig</button>
            <button type="button" id="sketch-clear" class="px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-red-600">🗑 Leeren</button>
            <label class="px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-blue-600 dark:text-blue-400 cursor-pointer hover:bg-blue-50 dark:hover:bg-slate-600">
              📷 Foto als Hintergrund
              <input type="file" id="sketch-bg-input" accept="image/*" class="hidden">
            </label>
          </div>

          <div class="relative border-2 border-dashed border-slate-300 dark:border-slate-600 rounded-lg overflow-hidden bg-white" id="sketch-wrap" style="touch-action: none;">
            <canvas id="sketchCanvas" width="900" height="520" class="w-full block cursor-crosshair" style="touch-action:none; max-height: 70vh;"></canvas>
            <div id="sketch-text-box" class="hidden absolute z-10 bg-white dark:bg-slate-800 border-2 border-blue-500 rounded shadow-lg p-2">
              <input type="text" id="sketch-text-input" class="text-sm px-2 py-1.5 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded w-44" placeholder="Text eingeben (z.B. 1250 mm)...">
              <div class="flex gap-1 mt-1.5">
                <button type="button" id="sketch-text-ok" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium px-2 py-1.5 rounded">Einfügen</button>
                <button type="button" id="sketch-text-cancel" class="bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-gray-200 text-xs px-2 py-1.5 rounded">Abbr.</button>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap items-end gap-3">
            <div class="flex-1 min-w-[160px]">
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Titel der Skizze</label>
              <input type="text" id="sketch-title" maxlength="120" placeholder="z.B. Geländer Detail Ostseite" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white">
            </div>
            <button type="button" id="sketch-save-btn" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded shadow transition disabled:opacity-50 disabled:cursor-not-allowed">
              💾 Skizze speichern
            </button>
            <span id="sketch-status" class="text-xs text-slate-500 dark:text-slate-400"></span>
          </div>

          <div class="mt-4">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Gespeicherte Skizzen</h4>
            <% if (typeof sketches !== 'undefined' && sketches && sketches.length > 0) { %>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                <% sketches.forEach(function(s) { %>
                  <div class="border dark:border-slate-600 rounded-lg overflow-hidden bg-slate-50 dark:bg-slate-700">
                    <img src="<%= s.image_data %>" alt="<%= s.title || 'Skizze' %>" class="w-full h-36 object-contain bg-white cursor-pointer sketch-thumb">
                    <div class="p-2 flex items-start justify-between gap-2">
                      <div class="min-w-0">
                        <p class="text-sm font-medium text-slate-800 dark:text-gray-100 truncate"><%= s.title || 'Skizze' %></p>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400"><%= s.created_by || '' %> · <%= s.created_at ? String(s.created_at).slice(0,16).replace('T',' ') : '' %></p>
                      </div>
                      <div class="flex flex-col gap-1 shrink-0">
                        <% if (s.drawing_json) { %>
                          <button type="button" class="sketch-edit-btn text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/30 px-2 py-1 rounded text-xs" data-json="<%- s.drawing_json.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') %>">Bearbeiten</button>
                        <% } %>
                        <form action="/projects/sketches/delete" method="POST" onsubmit="return confirm('Skizze wirklich löschen?');">
                          <input type="hidden" name="sketch_id" value="<%= s.id %>">
                          <input type="hidden" name="project_id" value="<%= project.id %>">
                          <button type="submit" class="w-full text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30 px-2 py-1 rounded text-xs">Löschen</button>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-xs text-slate-400 dark:text-slate-500 italic">Noch keine Skizzen gespeichert.</p>
            <% } %>
          </div>
        </div>
      </div>

            </div><!-- /sec-body -->
</section>

      <!-- ========== 3 AUFGABEN ========== -->
