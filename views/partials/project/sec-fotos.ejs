      <section id="sec-fotos" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2" data-sec="sec-fotos">
          <span class="sec-label text-pink-600 dark:text-pink-400 bg-pink-50 dark:bg-pink-900/30">5 · Fotos</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        </div>
      <div class="sec-body space-y-3">

      <div class="card-clean space-y-3">
        <form id="photoUploadForm" action="/projects/<%= project.id %>/photos/upload" method="POST" enctype="multipart/form-data" class="space-y-2">
          <div class="grid grid-cols-2 gap-2">
            <label class="text-center text-xs font-semibold bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-xl py-3 cursor-pointer">
              📷 Kamera
              <input type="file" accept="image/*" capture="environment" class="hidden" onchange="handleProjectPhotoPick(this)">
            </label>
            <label class="text-center text-xs font-semibold bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-xl py-3 cursor-pointer">
              🖼️ Galerie
              <input type="file" accept="image/*" class="hidden" onchange="handleProjectPhotoPick(this)">
            </label>
          </div>
          <input type="file" name="photo" id="photoFormInput" accept="image/*" class="hidden">
          <p id="photoFileName" class="text-xs text-slate-400"></p>
          <input type="text" name="caption" placeholder="Beschriftung (optional)"
            class="w-full text-sm border border-slate-200 dark:border-slate-600 dark:bg-slate-800 rounded-xl px-3 py-2">
          <button type="submit" class="w-full text-xs px-3 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold">Hochladen</button>
        </form>
        <script>
          function handleProjectPhotoPick(input) {
            const formInput = document.getElementById('photoFormInput');
            const nameLabel = document.getElementById('photoFileName');
            if (input.files && input.files[0]) {
              const dt = new DataTransfer();
              dt.items.add(input.files[0]);
              formInput.files = dt.files;
              nameLabel.textContent = '✓ ' + input.files[0].name;
            }
          }
          (function () {
            const form = document.getElementById('photoUploadForm');
            if (!form) return;
            form.addEventListener('submit', function (e) {
              const formInput = document.getElementById('photoFormInput');
              if (!formInput.files || formInput.files.length === 0) {
                e.preventDefault();
                alert('Bitte zuerst ein Foto wählen.');
              }
            });
          })();
        </script>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        <% if (photos && photos.length > 0) { %>
          <% photos.forEach(photo => { %>
          <div class="relative rounded-xl border border-slate-200 dark:border-slate-600 overflow-hidden bg-white dark:bg-slate-800">
            <form action="/projects/photos/delete" method="POST" onsubmit="return confirm('Foto löschen?');" class="absolute top-2 right-2 z-10">
              <input type="hidden" name="photo_id" value="<%= photo.id %>">
              <input type="hidden" name="project_id" value="<%= project.id %>">
              <button type="submit" class="w-7 h-7 rounded-full bg-black/60 text-white text-sm font-bold">×</button>
            </form>
            <a href="<%= photo.file_url %>" target="_blank">
              <img src="<%= photo.file_url %>" alt="" class="w-full h-32 object-cover">
            </a>
            <form action="/projects/photos/caption" method="POST" class="p-2 space-y-1">
              <input type="hidden" name="photo_id" value="<%= photo.id %>">
              <input type="hidden" name="project_id" value="<%= project.id %>">
              <input type="text" name="caption" value="<%= photo.caption || '' %>" placeholder="Beschriftung…"
                class="w-full text-[11px] border border-slate-200 dark:border-slate-600 dark:bg-slate-900 rounded-lg px-2 py-1">
              <button type="submit" class="w-full text-[10px] text-slate-500 py-0.5">Speichern</button>
            </form>
          </div>
          <% }) %>
        <% } else { %>
          <p class="col-span-full text-sm text-slate-400 text-center py-8">Noch keine Fotos.</p>
        <% } %>
      </div>

      </div><!-- /sec-body -->
</section>
