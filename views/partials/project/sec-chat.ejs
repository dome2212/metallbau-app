      <section id="sec-chat" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-chat" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/30">Chat</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="card-clean flex flex-col" style="height:min(70vh, 560px);">
        <div class="flex items-center justify-between mb-3 shrink-0">
          <p class="text-xs text-slate-400">Nur für Team-Mitglieder mit Zugriff auf diesen Auftrag sichtbar</p>
          <span id="project-chat-status" class="text-xs font-medium text-amber-500">Verbinde…</span>
        </div>

        <div id="project-chat-list" class="flex-1 min-h-0 overflow-y-auto pr-1 mb-3 flex flex-col">
          <div class="flex-1 flex flex-col items-center justify-center text-center text-slate-400 py-6 chat-empty-state">
            <svg class="w-9 h-9 mb-2 text-slate-300 dark:text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
            <p class="text-sm font-medium">Noch keine Nachrichten zu diesem Auftrag</p>
          </div>
        </div>

        <form id="project-chat-form" class="flex items-end gap-2 shrink-0" autocomplete="off">
          <textarea id="project-chat-input" rows="1" placeholder="Nachricht zu diesem Auftrag…"
            class="input flex-1 resize-none text-sm"
            onkeydown="if(event.key==='Enter' && !event.shiftKey){event.preventDefault();this.form.requestSubmit();}"></textarea>
          <button type="submit" class="btn font-semibold px-4 py-2.5" style="background:var(--primary);color:#fff;">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </form>
      </div>
      </div><!-- /sec-body -->
</section>


