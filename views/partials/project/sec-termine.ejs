      <section id="sec-termine" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2" data-sec="sec-termine">
          <span class="sec-label text-sky-600 dark:text-sky-400 bg-sky-50 dark:bg-sky-900/30">6 · Termine</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        </div>
      <div class="sec-body space-y-3">
      <div class="card-clean">
        <% if (appointments && appointments.length > 0) { %>
          <ul class="space-y-2">
            <% appointments.forEach(app => {
                const w = app.weather;
                let badge = 'bg-slate-100 text-slate-500';
                let label = 'Keine Vorhersage';
                if (w && w.warningLevel === 'danger') { badge = 'bg-red-100 text-red-700'; label = 'Gefahr'; }
                else if (w && w.warningLevel === 'warn') { badge = 'bg-amber-100 text-amber-700'; label = 'Warnung'; }
                else if (w) { badge = 'bg-emerald-100 text-emerald-700'; label = 'OK'; }
            %>
            <li class="rounded-xl border border-slate-200 dark:border-slate-600 p-3">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="font-semibold text-sm text-slate-800 dark:text-slate-100 truncate"><%= app.title %></p>
                  <p class="text-xs text-slate-500 mt-0.5"><%= new Date(app.start_date).toLocaleString('de-DE') %></p>
                  <% if (app.description) { %><p class="text-xs text-slate-400 mt-1"><%= app.description %></p><% } %>
                </div>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full shrink-0 <%= badge %>"><%= label %></span>
              </div>
              <% if (w && (w.temp != null || w.wind != null || w.desc)) { %>
              <p class="text-[11px] text-slate-500 mt-2">
                <% if (w.temp != null) { %><%= w.temp %>°C · <% } %>
                <% if (w.wind != null) { %>Wind <%= w.wind %> km/h · <% } %>
                <%= w.desc || '' %>
              </p>
              <% } %>
            </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-sm text-slate-400 text-center py-8">Keine Termine verknüpft.</p>
          <p class="text-xs text-center text-slate-400"><a href="/calendar" class="text-sky-600 hover:underline">Im Kalender anlegen</a></p>
        <% } %>
      </div>
      </div><!-- /sec-body -->
</section>
