      <section id="sec-material" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2" data-sec="sec-material">
          <span class="sec-label text-orange-600 dark:text-orange-400 bg-orange-50 dark:bg-orange-900/30">8 · Material</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        </div>
      <div class="sec-body space-y-3">

      <% if (lagerItems && lagerItems.length > 0) { %>
      <div class="card-clean">
        <form action="/projects/<%= project.id %>/material/add" method="POST" class="space-y-2">
          <select name="lager_item_id" required class="w-full text-sm border border-slate-200 dark:border-slate-600 dark:bg-slate-800 rounded-xl px-3 py-2.5">
            <option value="">— Material wählen —</option>
            <% lagerItems.forEach(item => { %>
              <option value="<%= item.id %>">
                <%= item.bezeichnung %><%= item.profil ? ' · ' + item.profil : '' %>
                (<%= parseFloat(item.menge).toLocaleString('de-DE') %> <%= item.einheit %>)
              </option>
            <% }) %>
          </select>
          <div class="grid grid-cols-2 gap-2">
            <input type="number" name="menge" step="0.001" min="0.001" required placeholder="Menge"
              class="text-sm border border-slate-200 dark:border-slate-600 dark:bg-slate-800 rounded-xl px-3 py-2.5">
            <input type="text" name="notiz" placeholder="Notiz (optional)"
              class="text-sm border border-slate-200 dark:border-slate-600 dark:bg-slate-800 rounded-xl px-3 py-2.5">
          </div>
          <button type="submit" class="w-full text-xs px-3 py-2.5 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-semibold">Entnehmen</button>
        </form>
      </div>
      <% } else { %>
      <div class="card-clean">
        <p class="text-sm text-slate-400 text-center py-4">Kein Lagerbestand vorhanden. <a href="/lager" class="text-orange-600 hover:underline">Zum Lager</a></p>
      </div>
      <% } %>

      <div class="card-clean">
        <h2 class="text-sm font-bold text-slate-800 dark:text-gray-100 mb-2">Entnahmen</h2>
        <% if (entnahmen && entnahmen.length > 0) { %>
          <ul class="divide-y divide-slate-100 dark:divide-slate-700">
            <% entnahmen.forEach(e => { %>
            <li class="py-2.5 flex items-start justify-between gap-2 text-sm">
              <div class="min-w-0">
                <p class="font-semibold text-slate-800 dark:text-slate-100 truncate"><%= e.bezeichnung || e.lager_bezeichnung || 'Material' %></p>
                <p class="text-xs text-slate-500"><%= parseFloat(e.menge||0).toLocaleString('de-DE') %> <%= e.einheit || '' %><% if (e.notiz) { %> · <%= e.notiz %><% } %></p>
                <p class="text-[10px] text-slate-400"><%= e.created_at ? new Date(e.created_at).toLocaleString('de-DE') : '' %></p>
              </div>
              <div class="text-right shrink-0">
                <% if (e.gesamtpreis != null && Number(e.gesamtpreis) > 0) { %>
                  <p class="text-xs font-bold tabular-nums"><%= Number(e.gesamtpreis).toLocaleString('de-DE',{minimumFractionDigits:2}) %> €</p>
                <% } %>
                <% if (typeof e.id !== 'undefined') { %>
                <form action="/projects/material/delete" method="POST" onsubmit="return confirm('Entnahme rückgängig?');" class="mt-1">
                  <input type="hidden" name="entnahme_id" value="<%= e.id %>">
                  <input type="hidden" name="project_id" value="<%= project.id %>">
                  <button type="submit" class="text-[10px] text-red-500">Löschen</button>
                </form>
                <% } %>
              </div>
            </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-sm text-slate-400 text-center py-6">Noch keine Entnahmen.</p>
        <% } %>
      </div>

      </div><!-- /sec-body -->
</section>
