      <% if (tab === 'info') { %>
      <div class="space-y-6">

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">ℹ️ System-Information</h2>
          <dl class="space-y-3">
            <% const sysInfo = [
              ['Node.js Version',    process.version],
              ['Umgebung',           process.env.NODE_ENV || 'development'],
              ['Datenbank',          process.env.DATABASE_URL ? 'PostgreSQL (Render)' : 'SQLite (lokal)'],
              ['Cloudinary',         process.env.CLOUDINARY_CLOUD_NAME ? '✅ Konfiguriert (' + process.env.CLOUDINARY_CLOUD_NAME + ')' : '❌ Nicht konfiguriert'],
              ['Backup-E-Mail',      (process.env.BACKUP_EMAIL || firma.smtp_backup_email) ? '✅ ' + (process.env.BACKUP_EMAIL || firma.smtp_backup_email) : '❌ Nicht gesetzt'],
              ['SMTP',               (process.env.SMTP_USER || firma.smtp_user) ? '✅ ' + (process.env.SMTP_USER || firma.smtp_user) : '❌ Nicht konfiguriert'],
              ['KI (OpenAI)',        process.env.OPENAI_API_KEY ? '✅ API-Key gesetzt' : '❌ Kein API-Key'],
            ]; %>
            <% for (const [label, val] of sysInfo) { %>
              <div class="flex items-start gap-4 py-2 border-b dark:border-slate-700 last:border-0">
                <dt class="w-48 shrink-0 text-xs font-medium text-slate-500 uppercase tracking-wide pt-0.5"><%= label %></dt>
                <dd class="text-sm text-slate-700 dark:text-slate-300 font-mono"><%= val %></dd>
              </div>
            <% } %>
          </dl>
        </div>

        <!-- Backup -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-3 border-b dark:border-slate-700 pb-2"><span class="inline-flex items-center gap-2"><svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/><path d="M7 7h.01M7 17h.01"/></svg><span>Datenbank-Backup</span></span></h2>
          <%
            const _backupEmail = process.env.BACKUP_EMAIL || firma.smtp_backup_email || '';
            const _smtpUser    = process.env.SMTP_USER    || firma.smtp_user         || '';
          %>
          <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center mb-4">
            <div class="flex-1 text-sm text-slate-500 dark:text-slate-400">
              <% if (!_backupEmail || !_smtpUser) { %>
                <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-300 rounded-lg px-4 py-2.5 text-xs text-amber-800 dark:text-amber-300">
                  ⚠️ <strong>BACKUP_EMAIL</strong> oder <strong>SMTP_USER / SMTP_PASS</strong> nicht gesetzt – Backup deaktiviert.
                </div>
              <% } else { %>
                <div class="bg-green-50 dark:bg-green-900/20 border border-green-300 rounded-lg px-4 py-2.5 text-xs text-green-800 dark:text-green-300">
                  ✅ Backup täglich um Mitternacht → <strong><%= _backupEmail %></strong>
                </div>
              <% } %>
            </div>
            <div class="flex flex-wrap gap-2">
              <form action="/admin/backup/run" method="POST"
                onsubmit="return confirm('Jetzt sofort ein Backup per E-Mail senden?')">
                <button type="submit"
                  class="bg-slate-700 hover:bg-slate-600 text-white text-sm font-medium px-4 py-2.5 rounded-lg transition whitespace-nowrap">
                  🗄️ Backup per E-Mail
                </button>
              </form>
              <a href="/admin/backup/download"
                class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2.5 rounded-lg transition whitespace-nowrap">
                ⬇️ Backup herunterladen
              </a>
            </div>
            <p class="text-xs text-slate-400 mt-2">Download erzeugt eine aktuelle Kopie der Datenbank und startet den Browser-Download.</p>
          </div>

          <!-- SMTP & Backup konfigurieren -->
          <form action="/admin/panel/notifications" method="POST" class="space-y-4 border-t dark:border-slate-700 pt-4">
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide">✉️ E-Mail / SMTP konfigurieren</p>
            <% if (process.env.SMTP_USER) { %>
              <div class="bg-slate-50 dark:bg-slate-700/30 rounded-lg px-4 py-2.5 text-xs text-slate-500 dark:text-slate-400">
                ℹ️ SMTP ist per Umgebungsvariable gesetzt – Änderungen hier haben keine Wirkung, solange <code>SMTP_USER</code> in der <code>.env</code> gesetzt ist.
              </div>
            <% } %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Backup-E-Mail <span class="text-slate-400">(Empfänger)</span></label>
                <input type="email" name="smtp_backup_email" value="<%= firma.smtp_backup_email || '' %>"
                  placeholder="chef@meine-firma.de"
                  class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">SMTP-Host</label>
                <input type="text" name="smtp_host" value="<%= firma.smtp_host || '' %>"
                  placeholder="smtp.gmail.com"
                  class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">SMTP-Port</label>
                <input type="number" name="smtp_port" value="<%= firma.smtp_port || '587' %>"
                  placeholder="587"
                  class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">SMTP-Benutzername <span class="text-slate-400">(Absender)</span></label>
                <input type="email" name="smtp_user" value="<%= firma.smtp_user || '' %>"
                  placeholder="absender@gmail.com"
                  class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              </div>
              <div class="sm:col-span-2">
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">SMTP-Passwort <span class="text-slate-400">(App-Passwort)</span></label>
                <input type="password" name="smtp_pass" value="<%= firma.smtp_pass || '' %>"
                  placeholder="Leer lassen um nicht zu ändern"
                  autocomplete="new-password"
                  class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
                <p class="text-xs text-slate-400 mt-1">Leer lassen, um das gespeicherte Passwort beizubehalten.</p>
              </div>
            </div>
            <div class="flex justify-end">
              <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
                💾 E-Mail-Einstellungen speichern
              </button>
            </div>
          </form>
        </div>

        <!-- Quick-Links -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2"><span class="inline-flex items-center gap-2"><svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15l6-6M8 12l-2.5 2.5a3 3 0 004.24 4.24L12 16.5M16 12l2.5-2.5a3 3 0 00-4.24-4.24L12 7.5"/></svg>Schnell-Links</span></h2>
          <div class="flex flex-wrap gap-3">
            <% const links = [
              ['/admin/users',            '👥 Mitarbeiter'],
              ['/admin/timetracking',     '📋 Arbeitszeiten'],
              ['/admin/company-settings', '🏢 Firmendaten'],
              ['/customers',              '👤 Kunden'],
              ['/articles',               '📦 Artikelstamm'],
              ['/documents/invoices',     '🧾 Rechnungen'],
              ['/documents/offers',       '📋 Angebote'],
            ]; %>
            <% for (const [href, label] of links) { %>
              <a href="<%= href %>"
                class="px-4 py-2 rounded-lg border dark:border-slate-600 bg-slate-50 dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-sm text-slate-700 dark:text-slate-200 transition">
                <%= label %>
              </a>
            <% } %>
          </div>
        </div>

      </div>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: LAGER-TABS VERWALTEN                                          -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
