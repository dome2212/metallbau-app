<% if (tab === 'audit') { %>
<div class="space-y-4">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 border dark:border-slate-700">
    <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
      <div>
        <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100">📋 Änderungsprotokoll</h2>
        <p class="text-xs text-slate-500 mt-1">Wer hat wann etwas Wichtiges geändert (Admin, Backup, Aufträge, …).</p>
      </div>
      <form method="GET" action="/admin/panel" class="flex flex-wrap gap-2 items-end">
        <input type="hidden" name="tab" value="audit">
        <div>
          <label class="block text-[10px] uppercase text-slate-400 mb-0.5">Bereich</label>
          <select name="entity" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg px-2 py-1.5 text-sm">
            <option value="">Alle</option>
            <% ['admin','backup','user','project','settings','security'].forEach(function(e) { %>
            <option value="<%= e %>" <%= (typeof auditFilter !== 'undefined' && auditFilter.entity === e) ? 'selected' : '' %>><%= e %></option>
            <% }) %>
          </select>
        </div>
        <button class="bg-slate-800 dark:bg-slate-600 text-white text-sm font-semibold px-3 py-1.5 rounded-lg">Filtern</button>
      </form>
    </div>

    <% const rows = (typeof auditLogs !== 'undefined' && auditLogs) ? auditLogs : []; %>
    <% if (!rows.length) { %>
      <p class="text-sm text-slate-500 py-8 text-center">Noch keine Einträge. Sobald Einstellungen gespeichert, Backups laufen oder Aufträge gelöscht werden, erscheinen sie hier.</p>
    <% } else { %>
    <div class="overflow-x-auto -mx-1">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-slate-500 border-b dark:border-slate-600">
            <th class="py-2 pr-3 font-medium">Zeit</th>
            <th class="py-2 pr-3 font-medium">Benutzer</th>
            <th class="py-2 pr-3 font-medium">Aktion</th>
            <th class="py-2 pr-3 font-medium">Bereich</th>
            <th class="py-2 pr-3 font-medium">Objekt</th>
            <th class="py-2 font-medium">Details</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r) {
            var det = r.details || '';
            try { if (det && det.charAt(0) === '{') det = JSON.stringify(JSON.parse(det)); } catch(_){}
            if (det.length > 120) det = det.slice(0, 117) + '…';
          %>
          <tr class="border-b dark:border-slate-700/80 align-top">
            <td class="py-2 pr-3 text-xs text-slate-500 whitespace-nowrap"><%= r.created_at %></td>
            <td class="py-2 pr-3 font-medium"><%= r.username || ('#' + (r.user_id || '—')) %></td>
            <td class="py-2 pr-3"><%= r.action %></td>
            <td class="py-2 pr-3"><span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-700"><%= r.entity %></span></td>
            <td class="py-2 pr-3 text-xs">
              <% if (r.entity_label) { %><%= r.entity_label %><% } %>
              <% if (r.entity_id) { %><span class="text-slate-400"> #<%= r.entity_id %></span><% } %>
            </td>
            <td class="py-2 text-xs text-slate-500 break-all"><%= det || '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="text-[10px] text-slate-400 mt-3">Anzeige: letzte <%= rows.length %> Einträge (max. 200).</p>
    <% } %>
  </div>
</div>
<% } %>
