      <% if (tab === 'projects') { %>
      <form action="/admin/panel/projects" method="POST" class="space-y-6">

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2"><span class="inline-flex items-center gap-2"><svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="10" height="18" rx="1"/><path d="M14 21v-6h4v6M8 7h.01M11 7h.01M8 11h.01M11 11h.01M8 15h.01M11 15h.01"/></svg><span>Auftrags-Einstellungen</span></span></h2>
          <div class="space-y-5">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Auftragsnummer-Prefix <span class="text-slate-400 font-normal">(wird bei zukünftiger Auto-Nummerierung genutzt)</span>
              </label>
              <input type="text" name="project_number_prefix" value="<%= firma.project_number_prefix || 'BAUS' %>" maxlength="10"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Standard-Projektstatus bei Neuanlage</label>
              <select name="default_project_status"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
                <% for (const s of ['In Planung','Aktiv','Angefragt','Pausiert','Abgeschlossen']) { %>
                  <option value="<%= s %>" <%= firma.default_project_status === s ? 'selected' : '' %>><%= s %></option>
                <% } %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Auto-Archivierung nach X Tagen <span class="text-slate-400 font-normal">(0 = deaktiviert)</span>
              </label>
              <input type="number" name="archive_after_days" value="<%= firma.archive_after_days || 180 %>"
                min="0" max="3650"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              <p class="text-xs text-slate-400 mt-1">Abgeschlossene Aufträge die älter als X Tage sind werden automatisch archiviert. 0 = nie archivieren.</p>
            </div>
          </div>
        </div>

        <div class="flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Auftrags-Einstellungen speichern
          </button>
        </div>
      </form>
      <% } %>

