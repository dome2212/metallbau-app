      <% if (tab === 'design') { %>
      <form action="/admin/panel/design" method="POST" id="design-form" class="space-y-4">

        <!-- Schnell-Vorlagen -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-5">
          <div class="flex items-center gap-3 mb-1">
            <span class="icon-tile w-9 h-9 shrink-0" style="background:#e0e7ff;color:#4f46e5;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>
            </span>
            <div>
              <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100">Schnell-Vorlagen</h2>
              <p class="text-xs text-slate-400 mt-0.5">Ein Klick setzt alle Farben. Danach kannst du noch feinjustieren und speichern.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-4" id="design-presets">
            <% const presets = [
              { name: 'Standard Blau',  desc: 'Klassisch & klar',     primary:'#4f46e5', sidebarBg:'#1e293b', sidebarText:'#e2e8f0', sidebarHover:'#334155', pageBg:'#f8fafc', topbarBg:'#ffffff' },
              { name: 'Industrial',     desc: 'Anthrazit + Orange',   primary:'#ea580c', sidebarBg:'#0c0a09', sidebarText:'#d6d3d1', sidebarHover:'#1c1917', pageBg:'#f5f5f4', topbarBg:'#fafaf9' },
              { name: 'Dunkel',         desc: 'Dunkles Interface',    primary:'#6366f1', sidebarBg:'#0f172a', sidebarText:'#cbd5e1', sidebarHover:'#1e293b', pageBg:'#1e293b', topbarBg:'#0f172a' },
              { name: 'Forest',         desc: 'Grün & natürlich',     primary:'#16a34a', sidebarBg:'#14532d', sidebarText:'#dcfce7', sidebarHover:'#166534', pageBg:'#f0fdf4', topbarBg:'#ffffff' },
              { name: 'Sunset',         desc: 'Warm & energetisch',   primary:'#ea580c', sidebarBg:'#431407', sidebarText:'#fed7aa', sidebarHover:'#7c2d12', pageBg:'#fff7ed', topbarBg:'#ffffff' },
              { name: 'Corporate',      desc: 'Lila Business',        primary:'#7c3aed', sidebarBg:'#2e1065', sidebarText:'#ede9fe', sidebarHover:'#4c1d95', pageBg:'#faf5ff', topbarBg:'#ffffff' },
              { name: 'Rot',            desc: 'Kräftig & präsent',    primary:'#dc2626', sidebarBg:'#450a0a', sidebarText:'#fecaca', sidebarHover:'#7f1d1d', pageBg:'#fef2f2', topbarBg:'#ffffff' },
              { name: 'Slate',          desc: 'Neutral & modern',     primary:'#475569', sidebarBg:'#0f172a', sidebarText:'#e2e8f0', sidebarHover:'#1e293b', pageBg:'#f1f5f9', topbarBg:'#ffffff' },
            ]; %>
            <% for (const p of presets) { %>
              <button type="button"
                class="design-preset-btn group text-left rounded-xl border dark:border-slate-600 overflow-hidden hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-md transition focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-primary="<%= p.primary %>"
                data-sidebar-bg="<%= p.sidebarBg %>"
                data-sidebar-text="<%= p.sidebarText %>"
                data-sidebar-hover="<%= p.sidebarHover %>"
                data-page-bg="<%= p.pageBg %>"
                data-topbar-bg="<%= p.topbarBg %>">
                <div class="flex h-10">
                  <span class="flex-1" style="background:<%= p.sidebarBg %>;"></span>
                  <span class="w-8" style="background:<%= p.primary %>;"></span>
                  <span class="flex-1" style="background:<%= p.pageBg %>;"></span>
                  <span class="w-6" style="background:<%= p.topbarBg %>; border-left:1px solid rgba(0,0,0,.06);"></span>
                </div>
                <div class="px-3 py-2.5 bg-slate-50 dark:bg-slate-700/60 group-hover:bg-slate-100 dark:group-hover:bg-slate-700 flex items-center gap-2">
                  <span class="w-3.5 h-3.5 rounded-full shrink-0 ring-2 ring-white dark:ring-slate-600" style="background:<%= p.primary %>;"></span>
                  <div class="min-w-0">
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate"><%= p.name %></p>
                    <p class="text-[11px] text-slate-400 truncate"><%= p.desc %></p>
                  </div>
                </div>
              </button>
            <% } %>
          </div>
          <p id="preset-hint" class="hidden mt-3 text-xs text-green-600 dark:text-green-400 font-medium">✓ Vorlage übernommen – ggf. anpassen und speichern.</p>
        </div>

        <!-- Live-Vorschau -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-5">
          <div class="flex items-center gap-3 mb-4">
            <span class="icon-tile w-9 h-9 shrink-0" style="background:#e0e7ff;color:#4f46e5;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            </span>
            <div>
              <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100">Live-Vorschau</h2>
              <p class="text-xs text-slate-400 mt-0.5">So wirken Sidebar und Primärfarbe ungefähr.</p>
            </div>
          </div>
          <div id="design-preview" class="rounded-xl overflow-hidden border dark:border-slate-600 shadow-sm flex" style="height:9rem;">
            <div id="prev-sidebar" class="w-28 shrink-0 flex flex-col p-2.5 gap-1.5" style="background:<%= firma.color_sidebar_bg || '#1e293b' %>;">
              <div class="h-2.5 w-16 rounded" style="background:<%= firma.color_sidebar_text || '#e2e8f0' %>;opacity:.9;"></div>
              <div class="h-2 w-20 rounded mt-1" style="background:<%= firma.color_sidebar_hover || '#334155' %>;"></div>
              <div class="h-2 w-14 rounded" style="background:<%= firma.color_sidebar_text || '#e2e8f0' %>;opacity:.35;"></div>
              <div class="h-2 w-18 rounded" style="background:<%= firma.color_sidebar_text || '#e2e8f0' %>;opacity:.35;"></div>
              <div class="mt-auto h-6 rounded flex items-center justify-center text-[10px] font-bold text-white" id="prev-primary-btn" style="background:<%= firma.color_primary || '#4f46e5' %>;">Button</div>
            </div>
            <div class="flex-1 flex flex-col min-w-0">
              <div id="prev-topbar" class="h-8 border-b dark:border-slate-600 px-3 flex items-center" style="background:<%= firma.color_topbar_bg || '#ffffff' %>;">
                <div class="h-2 w-24 rounded" style="background:<%= firma.color_primary || '#4f46e5' %>;opacity:.7;"></div>
              </div>
              <div id="prev-page" class="flex-1 p-3" style="background:<%= firma.color_page_bg || '#f8fafc' %>;">
                <div class="h-3 w-32 rounded bg-white/80 dark:bg-slate-700/50 mb-2 shadow-sm"></div>
                <div class="h-16 rounded-lg bg-white/90 dark:bg-slate-700/40 shadow-sm border border-black/5"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Farbpalette -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-5">
          <div class="flex items-center gap-3 mb-4">
            <span class="icon-tile w-9 h-9 shrink-0" style="background:#e0e7ff;color:#4f46e5;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 100 18c1 0 1.5-.5 1.5-1.3 0-.4-.2-.7-.4-1-.2-.3-.4-.6-.4-1 0-.8.6-1.4 1.4-1.4H16a4 4 0 004-4c0-5-4-9.3-8-9.3z"/><circle cx="7.5" cy="11.5" r="1"/><circle cx="10.5" cy="7.5" r="1"/><circle cx="15" cy="8" r="1"/><circle cx="17" cy="12" r="1"/></svg>
            </span>
            <div>
              <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100">Farbpalette der App</h2>
              <p class="text-xs text-slate-400 mt-0.5">Wirkt nach dem Speichern auf die gesamte App.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <input type="color" name="color_primary" id="color_primary" value="<%= firma.color_primary || '#4f46e5' %>"
                class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent shrink-0"
                oninput="designUpdateFromInput()">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Primärfarbe</p>
                <p class="text-xs text-slate-400">Buttons, Links, Akzente</p>
                <div id="prev_primary" class="mt-1 h-3 w-20 rounded" style="background:<%= firma.color_primary || '#4f46e5' %>;"></div>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <input type="color" name="color_sidebar_bg" id="color_sidebar_bg" value="<%= firma.color_sidebar_bg || '#1e293b' %>"
                class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent shrink-0"
                oninput="designUpdateFromInput()">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Sidebar Hintergrund</p>
                <p class="text-xs text-slate-400">Hintergrund der Seitenleiste</p>
                <div id="prev_sidebar_bg" class="mt-1 h-3 w-20 rounded border border-slate-300" style="background:<%= firma.color_sidebar_bg || '#1e293b' %>;"></div>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <input type="color" name="color_sidebar_text" id="color_sidebar_text" value="<%= firma.color_sidebar_text || '#e2e8f0' %>"
                class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent shrink-0"
                oninput="designUpdateFromInput()">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Sidebar Schrift</p>
                <p class="text-xs text-slate-400">Textfarbe in der Sidebar</p>
                <div id="prev_sidebar_text" class="mt-1 h-3 w-20 rounded border border-slate-300" style="background:<%= firma.color_sidebar_text || '#e2e8f0' %>;"></div>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <input type="color" name="color_sidebar_hover" id="color_sidebar_hover" value="<%= firma.color_sidebar_hover || '#334155' %>"
                class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent shrink-0"
                oninput="designUpdateFromInput()">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Sidebar Hover</p>
                <p class="text-xs text-slate-400">Farbe beim Darüberfahren</p>
                <div id="prev_sidebar_hover" class="mt-1 h-3 w-20 rounded border border-slate-300" style="background:<%= firma.color_sidebar_hover || '#334155' %>;"></div>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <input type="color" name="color_page_bg" id="color_page_bg" value="<%= firma.color_page_bg || '#f8fafc' %>"
                class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent shrink-0"
                oninput="designUpdateFromInput()">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Seiten-Hintergrund</p>
                <p class="text-xs text-slate-400">Hintergrund des Hauptinhalts</p>
                <div id="prev_page_bg" class="mt-1 h-3 w-20 rounded border border-slate-300" style="background:<%= firma.color_page_bg || '#f8fafc' %>;"></div>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <input type="color" name="color_topbar_bg" id="color_topbar_bg" value="<%= firma.color_topbar_bg || '#ffffff' %>"
                class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent shrink-0"
                oninput="designUpdateFromInput()">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Header-Hintergrund</p>
                <p class="text-xs text-slate-400">Topbar / Kartenköpfe</p>
                <div id="prev_topbar_bg" class="mt-1 h-3 w-20 rounded border border-slate-300" style="background:<%= firma.color_topbar_bg || '#ffffff' %>;"></div>
              </div>
            </div>

          </div>
        </div>

        <!-- App-Icon & Dark Mode -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-5">
          <div class="flex items-center gap-3 mb-4">
            <span class="icon-tile w-9 h-9 shrink-0" style="background:#e0e7ff;color:#4f46e5;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            </span>
            <div>
              <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100">Darstellung</h2>
              <p class="text-xs text-slate-400 mt-0.5">App-Symbol und Standard-Dark-Mode.</p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">App-Icon (Emoji)</label>
              <input type="text" name="app_icon" value="<%= firma.app_icon || '🔩' %>" maxlength="8"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500"
                placeholder="🔩">
              <p class="text-xs text-slate-400 mt-1">Wird z. B. in der Sidebar / als Favicon-Hinweis genutzt.</p>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Dark Mode Standard</label>
              <select name="dark_mode_default"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
                <option value="true"  <%= (firma.dark_mode_default !== 'false') ? 'selected' : '' %>>Dunkel (empfohlen)</option>
                <option value="false" <%= (firma.dark_mode_default === 'false') ? 'selected' : '' %>>Hell</option>
              </select>
              <p class="text-xs text-slate-400 mt-1">Gilt für neue Besucher, solange sie nichts anderes wählen.</p>
            </div>
          </div>
        </div>

        <div class="flex justify-end gap-3 sticky bottom-4 z-10">
          <button type="button" id="design-reset-btn"
            class="px-5 py-2.5 rounded-lg border dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-sm hover:bg-slate-100 dark:hover:bg-slate-700 transition shadow">
            Standard wiederherstellen
          </button>
          <button type="submit"
            class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Design speichern
          </button>
        </div>
      </form>

      <script>
      (function () {
        var DEFAULTS = {
          color_primary:       '#4f46e5',
          color_sidebar_bg:    '#1e293b',
          color_sidebar_text:  '#e2e8f0',
          color_sidebar_hover: '#334155',
          color_page_bg:       '#f8fafc',
          color_topbar_bg:     '#ffffff'
        };

        function val(id) {
          var el = document.getElementById(id);
          return el ? el.value : '';
        }
        function setVal(id, v) {
          var el = document.getElementById(id);
          if (el) el.value = v;
        }
        function setBg(id, v) {
          var el = document.getElementById(id);
          if (el) el.style.background = v;
        }

        function applyColors(c) {
          setVal('color_primary', c.primary);
          setVal('color_sidebar_bg', c.sidebarBg);
          setVal('color_sidebar_text', c.sidebarText);
          setVal('color_sidebar_hover', c.sidebarHover);
          setVal('color_page_bg', c.pageBg);
          setVal('color_topbar_bg', c.topbarBg);
          refreshPreviews();
        }

        function refreshPreviews() {
          var primary = val('color_primary');
          var sidebarBg = val('color_sidebar_bg');
          var sidebarText = val('color_sidebar_text');
          var sidebarHover = val('color_sidebar_hover');
          var pageBg = val('color_page_bg');
          var topbarBg = val('color_topbar_bg');

          setBg('prev_primary', primary);
          setBg('prev_sidebar_bg', sidebarBg);
          setBg('prev_sidebar_text', sidebarText);
          setBg('prev_sidebar_hover', sidebarHover);
          setBg('prev_page_bg', pageBg);
          setBg('prev_topbar_bg', topbarBg);

          var side = document.getElementById('prev-sidebar');
          if (side) side.style.background = sidebarBg;
          var top = document.getElementById('prev-topbar');
          if (top) top.style.background = topbarBg;
          var page = document.getElementById('prev-page');
          if (page) page.style.background = pageBg;
          var btn = document.getElementById('prev-primary-btn');
          if (btn) btn.style.background = primary;

          // kleine Balken in der Sidebar-Vorschau
          if (side) {
            var bars = side.querySelectorAll('div');
            if (bars[0]) bars[0].style.background = sidebarText;
            if (bars[1]) bars[1].style.background = sidebarHover;
            if (bars[2]) { bars[2].style.background = sidebarText; bars[2].style.opacity = '.35'; }
            if (bars[3]) { bars[3].style.background = sidebarText; bars[3].style.opacity = '.35'; }
          }
        }

        window.designUpdateFromInput = function () {
          refreshPreviews();
        };

        // Preset-Buttons
        document.querySelectorAll('.design-preset-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            applyColors({
              primary:      btn.getAttribute('data-primary'),
              sidebarBg:    btn.getAttribute('data-sidebar-bg'),
              sidebarText:  btn.getAttribute('data-sidebar-text'),
              sidebarHover: btn.getAttribute('data-sidebar-hover'),
              pageBg:       btn.getAttribute('data-page-bg'),
              topbarBg:     btn.getAttribute('data-topbar-bg')
            });
            document.querySelectorAll('.design-preset-btn').forEach(function (b) {
              b.classList.remove('ring-2', 'ring-blue-500', 'border-blue-400');
            });
            btn.classList.add('ring-2', 'ring-blue-500', 'border-blue-400');
            var hint = document.getElementById('preset-hint');
            if (hint) {
              hint.classList.remove('hidden');
              clearTimeout(hint._t);
              hint._t = setTimeout(function () { hint.classList.add('hidden'); }, 3500);
            }
          });
        });

        // Standard wiederherstellen
        var resetBtn = document.getElementById('design-reset-btn');
        if (resetBtn) {
          resetBtn.addEventListener('click', function () {
            applyColors({
              primary: DEFAULTS.color_primary,
              sidebarBg: DEFAULTS.color_sidebar_bg,
              sidebarText: DEFAULTS.color_sidebar_text,
              sidebarHover: DEFAULTS.color_sidebar_hover,
              pageBg: DEFAULTS.color_page_bg,
              topbarBg: DEFAULTS.color_topbar_bg
            });
            document.querySelectorAll('.design-preset-btn').forEach(function (b) {
              b.classList.remove('ring-2', 'ring-blue-500', 'border-blue-400');
            });
          });
        }

        // initial sync
        refreshPreviews();
      })();
      </script>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: SIDEBAR                                                        -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
