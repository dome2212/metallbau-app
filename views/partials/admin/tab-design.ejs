      <% if (tab === 'design') { %>
      <form action="/admin/panel/design" method="POST" class="space-y-6">

        <!-- Farbpalette -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="icon-tile w-9 h-9 shrink-0" style="background:#e0e7ff;color:#4f46e5;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 100 18c1 0 1.5-.5 1.5-1.3 0-.4-.2-.7-.4-1-.2-.3-.4-.6-.4-1 0-.8.6-1.4 1.4-1.4H16a4 4 0 004-4c0-5-4-9.3-8-9.3z"/><circle cx="7.5" cy="11.5" r="1"/><circle cx="10.5" cy="7.5" r="1"/><circle cx="15" cy="8" r="1"/><circle cx="17" cy="12" r="1"/></svg>
            </span>
            <div>
              <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100">Farbpalette der App</h2>
            <p class="text-xs text-slate-400 mt-0.5">Diese Farben wirken sich sofort auf die gesamte App aus (nach dem Speichern).</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

            <!-- Primärfarbe -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_primary" value="<%= firma.color_primary || '#2563eb' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_primary', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Primärfarbe</p>
                <p class="text-xs text-slate-400">Buttons, Links, Akzente</p>
                <div id="prev_primary" class="mt-1 h-4 w-20 rounded" style="background:<%= firma.color_primary || '#2563eb' %>;"></div>
              </div>
            </div>

            <!-- Sidebar Hintergrund -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_sidebar_bg" value="<%= firma.color_sidebar_bg || '#1e293b' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_sidebar_bg', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Sidebar Hintergrund</p>
                <p class="text-xs text-slate-400">Hintergrundfarbe der Seitenleiste</p>
                <div id="prev_sidebar_bg" class="mt-1 h-4 w-20 rounded border border-slate-300" style="background:<%= firma.color_sidebar_bg || '#1e293b' %>;"></div>
              </div>
            </div>

            <!-- Sidebar Schrift -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_sidebar_text" value="<%= firma.color_sidebar_text || '#e2e8f0' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_sidebar_text', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Sidebar Schrift</p>
                <p class="text-xs text-slate-400">Textfarbe in der Sidebar</p>
                <div id="prev_sidebar_text" class="mt-1 h-4 w-20 rounded border border-slate-300" style="background:<%= firma.color_sidebar_text || '#e2e8f0' %>;"></div>
              </div>
            </div>

            <!-- Sidebar Hover -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_sidebar_hover" value="<%= firma.color_sidebar_hover || '#334155' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_sidebar_hover', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Sidebar Hover</p>
                <p class="text-xs text-slate-400">Farbe beim Darüberfahren</p>
                <div id="prev_sidebar_hover" class="mt-1 h-4 w-20 rounded border border-slate-300" style="background:<%= firma.color_sidebar_hover || '#334155' %>;"></div>
              </div>
            </div>

            <!-- Seitenhintergrund -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_page_bg" value="<%= firma.color_page_bg || '#f1f5f9' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_page_bg', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Seiten-Hintergrund</p>
                <p class="text-xs text-slate-400">Hintergrund des Hauptinhalts</p>
                <div id="prev_page_bg" class="mt-1 h-4 w-20 rounded border border-slate-300" style="background:<%= firma.color_page_bg || '#f1f5f9' %>;"></div>
              </div>
            </div>

            <!-- Header-Hintergrund -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_topbar_bg" value="<%= firma.color_topbar_bg || '#ffffff' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_topbar_bg', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Header-Hintergrund</p>
                <p class="text-xs text-slate-400">Topbar / Kartenköpfe</p>
                <div id="prev_topbar_bg" class="mt-1 h-4 w-20 rounded border border-slate-300" style="background:<%= firma.color_topbar_bg || '#ffffff' %>;"></div>
              </div>
            </div>

          </div><!-- /grid -->
        </div>

        <!-- Farb-Vorlagen -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="icon-tile w-9 h-9 shrink-0" style="background:#e0e7ff;color:#4f46e5;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>
            </span>
            <div>
              <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100">Schnell-Vorlagen</h2>
            </div>
          </div>
          <div class="flex flex-wrap gap-3">
            <% const presets = [
              { name: 'Standard Blau',  primary:'#2563eb', sidebarBg:'#1e293b', sidebarText:'#e2e8f0', sidebarHover:'#334155', pageBg:'#f1f5f9', topbarBg:'#ffffff' },
              { name: 'Industrial',     primary:'#ea580c', sidebarBg:'#0c0a09', sidebarText:'#d6d3d1', sidebarHover:'#1c1917', pageBg:'#f5f5f4', topbarBg:'#fafaf9' },
              { name: 'Dunkel',         primary:'#6366f1', sidebarBg:'#0f172a', sidebarText:'#cbd5e1', sidebarHover:'#1e293b', pageBg:'#1e293b', topbarBg:'#0f172a' },
              { name: 'Grün',           primary:'#16a34a', sidebarBg:'#14532d', sidebarText:'#dcfce7', sidebarHover:'#166534', pageBg:'#f0fdf4', topbarBg:'#ffffff' },
              { name: 'Orange',         primary:'#ea580c', sidebarBg:'#431407', sidebarText:'#fed7aa', sidebarHover:'#7c2d12', pageBg:'#fff7ed', topbarBg:'#ffffff' },
              { name: 'Lila',           primary:'#7c3aed', sidebarBg:'#2e1065', sidebarText:'#ede9fe', sidebarHover:'#4c1d95', pageBg:'#faf5ff', topbarBg:'#ffffff' },
              { name: 'Rot',            primary:'#dc2626', sidebarBg:'#450a0a', sidebarText:'#fecaca', sidebarHover:'#7f1d1d', pageBg:'#fef2f2', topbarBg:'#ffffff' },
            ]; %>
            <% for (const p of presets) { %>
              <button type="button"
                onclick="applyPreset('<%= p.primary %>','<%= p.sidebarBg %>','<%= p.sidebarText %>','<%= p.sidebarHover %>','<%= p.pageBg %>','<%= p.topbarBg %>')"
                class="flex items-center gap-2 px-3 py-2 rounded-lg border dark:border-slate-600 bg-slate-50 dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-sm text-slate-700 dark:text-slate-200 transition">
                <span class="w-4 h-4 rounded-full inline-block shrink-0" style="background:<%= p.primary %>;"></span>
                <%= p.name %>
              </button>
            <% } %>
          </div>
        </div>

        <div class="flex justify-end gap-3">
          <button type="reset" class="px-5 py-2.5 rounded-lg border dark:border-slate-600 text-slate-600 dark:text-slate-300 text-sm hover:bg-slate-100 dark:hover:bg-slate-700 transition">
            Zurücksetzen
          </button>
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Design speichern
          </button>
        </div>
      </form>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: SIDEBAR                                                        -->
