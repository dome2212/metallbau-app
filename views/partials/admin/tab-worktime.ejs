      <% if (tab === 'worktime') { %>
      <form action="/admin/panel/worktime" method="POST" class="space-y-6">

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">⏱️ Soll-Stunden & Urlaub</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Arbeitsstunden pro Tag <span class="text-slate-400 font-normal">(Basis für Überstunden-Berechnung)</span>
              </label>
              <input type="number" name="work_hours_per_day" value="<%= firma.work_hours_per_day || 8 %>"
                min="1" max="24" step="0.5"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Urlaubstage pro Jahr <span class="text-slate-400 font-normal">(Standard für neue Mitarbeiter)</span>
              </label>
              <input type="number" name="vacation_days_default" value="<%= firma.vacation_days_default || 30 %>"
                min="1" max="365"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="icon-tile w-9 h-9 shrink-0" style="background:#fef3c7;color:#d97706;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h13v6a4 4 0 01-4 4H8a4 4 0 01-4-4V9z"/><path d="M17 10h1.5a2.5 2.5 0 010 5H17M8 3c0 1-1 1-1 2M12 3c0 1-1 1-1 2"/></svg>
            </span>
            <div>
              <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100">Automatischer Pausenabzug</h2>
            <p class="text-xs text-slate-400 mt-0.5">Pause wird automatisch abgezogen wenn der Arbeitstag länger ist als X Stunden. <strong>0 = deaktiviert.</strong></p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Pause abziehen (Minuten)</label>
              <input type="number" name="break_auto_minutes" value="<%= firma.break_auto_minutes || 0 %>"
                min="0" max="120" step="5" placeholder="0 = deaktiviert"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Abziehen wenn Arbeitstag > X Stunden</label>
              <input type="number" name="break_trigger_hours" value="<%= firma.break_trigger_hours || 6 %>"
                min="1" max="12" step="0.5"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="icon-tile w-9 h-9 shrink-0" style="background:#fef3c7;color:#d97706;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 3v3M16 3v3"/><path d="M8 14l2 2 4-4"/></svg>
            </span>
            <div>
              <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100">Feiertags-Region</h2>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-2">Bundesland (für Feiertagsberechnung)</label>
            <select name="holiday_region"
              class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              <% const regions = ['NRW','Bayern','Baden-Württemberg','Berlin','Brandenburg','Bremen','Hamburg','Hessen','Mecklenburg-Vorpommern','Niedersachsen','Rheinland-Pfalz','Saarland','Sachsen','Sachsen-Anhalt','Schleswig-Holstein','Thüringen','Österreich','Schweiz']; %>
              <% for (const r of regions) { %>
                <option value="<%= r %>" <%= firma.holiday_region === r ? 'selected' : '' %>><%= r %></option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Arbeitszeit-Einstellungen speichern
          </button>
        </div>
      </form>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: STEMPELUHR                                                     -->
