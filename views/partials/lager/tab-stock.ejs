  <!-- ═══════════════════════════════════════════════════════════════════════════
       TAB: BAUSTAHL / EDELSTAHL / SCHRAUBEN
  ═══════════════════════════════════════════════════════════════════════════ -->
  <% if (tab === 'baustahl' || tab === 'edelstahl' || tab === 'schrauben') { %>
  <div class="px-4 md:px-6 pb-10 w-full max-w-7xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden">
      <% if (items && items.length > 0) { %>
      <div class="overflow-x-auto desktop-table-wrap">
        <table class="table-modern w-full text-left border-collapse min-w-[800px]">
          <thead class="bg-gray-50 dark:bg-slate-700 border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
            <tr>
              <th class="px-4 py-3">Bezeichnung</th>
              <th class="px-4 py-3">Profil</th>
              <th class="px-4 py-3">Abmessung</th>
              <th class="px-4 py-3">Bestand</th>
              <th class="px-4 py-3">Mindestbest.</th>
              <th class="px-4 py-3">Preis/Einh.</th>
              <th class="px-4 py-3">Lagerort</th>
              <th class="px-4 py-3">Lieferschein</th>
              <th class="px-4 py-3">Datum</th>
              <th class="px-4 py-3 text-right">Aktion</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => {
              const isLow = Number(item.mindestbestand) > 0 && Number(item.menge) <= Number(item.mindestbestand);
              const isCritical = Number(item.mindestbestand) > 0 && Number(item.menge) === 0;
            %>
            <tr class="border-b dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700/50 text-sm
                       <%= isCritical ? 'bg-red-50/60 dark:bg-red-900/10' : isLow ? 'bg-amber-50/60 dark:bg-amber-900/10' : '' %>">
              <td class="px-4 py-3 font-semibold text-gray-800 dark:text-gray-100">
                <% if (isLow) { %><span class="text-amber-500 mr-1" title="Unter Mindestbestand"><svg class="w-4 h-4 inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4m0 4h.01M10.3 3.9L2.5 17a1.5 1.5 0 001.3 2.3h16.4a1.5 1.5 0 001.3-2.3L13.7 3.9a1.5 1.5 0 00-2.6 0z"/></svg></span><% } %>
                <%= item.bezeichnung %>
              </td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= item.profil || '-' %></td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= item.abmessung || '-' %></td>
              <td class="px-4 py-3 font-semibold
                         <%= isCritical ? 'text-red-600 dark:text-red-400' : isLow ? 'text-amber-600 dark:text-amber-400' : 'text-gray-800 dark:text-gray-200' %>">
                <%= Number(item.menge || 0).toLocaleString('de-DE') %> <span class="font-normal text-gray-400"><%= item.einheit || '' %></span>
              </td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs">
                <% if (Number(item.mindestbestand) > 0) { %>
                  <span class="<%= isLow ? 'text-amber-600 dark:text-amber-400 font-semibold' : '' %>">
                    <%= Number(item.mindestbestand).toLocaleString('de-DE') %> <%= item.einheit || '' %>
                  </span>
                <% } else { %>–<% } %>
              </td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300 text-xs font-medium">
                <% if (Number(item.einheitspreis) > 0) { %>
                  <%= Number(item.einheitspreis).toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) %> €
                <% } else { %><span class="text-gray-300 dark:text-gray-600">–</span><% } %>
              </td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs"><%= item.lagerort || '-' %></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs"><%= item.lieferschein_nr || '-' %></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs">
                <%= item.lieferdatum ? new Date(item.lieferdatum).toLocaleDateString('de-DE') : '-' %>
              </td>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <!-- Entnahme-Button: data-* statt onclick-Parameter um Sonderzeichen-Bugs zu vermeiden -->
                  <button
                    data-item-id="<%= item.id %>"
                    data-item-einheit="<%= encodeURIComponent(item.einheit || 'Stk') %>"
                    onclick="openEntnahmeModalForEl(this)"
                    class="px-2 py-1 bg-amber-50 text-amber-600 hover:bg-amber-100 dark:bg-amber-900/30 dark:text-amber-400 rounded text-xs font-semibold transition"
                    title="Entnahme buchen">↓</button>
                  <!-- Bearbeiten-Button -->
                  <button
                    data-item-id="<%= item.id %>"
                    data-item-bezeichnung="<%= encodeURIComponent(item.bezeichnung || '') %>"
                    data-item-profil="<%= encodeURIComponent(item.profil || '') %>"
                    data-item-abmessung="<%= encodeURIComponent(item.abmessung || '') %>"
                    data-item-menge="<%= Number(item.menge || 0) %>"
                    data-item-einheit="<%= encodeURIComponent(item.einheit || 'Stk') %>"
                    data-item-material="<%= encodeURIComponent(item.material_type || 'baustahl') %>"
                    data-item-lsnr="<%= encodeURIComponent(item.lieferschein_nr || '') %>"
                    data-item-lieferdatum="<%= item.lieferdatum ? new Date(item.lieferdatum).toISOString().split('T')[0] : '' %>"
                    data-item-notiz="<%= encodeURIComponent(item.notiz || '') %>"
                    data-item-mindestbestand="<%= item.mindestbestand || 0 %>"
                    data-item-lagerort="<%= encodeURIComponent(item.lagerort || '') %>"
                    data-item-einheitspreis="<%= item.einheitspreis || 0 %>"
                    onclick="openEditModalEl(this)"
                    class="px-2 py-1 bg-blue-50 text-blue-600 hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-400 rounded text-xs font-semibold transition"
                    title="Bearbeiten"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-4"/><path d="M18.5 2.5a2.1 2.1 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                  <!-- Verschieben-Button -->
                  <button
                    data-item-id="<%= item.id %>"
                    data-item-bezeichnung="<%= encodeURIComponent(item.bezeichnung || '') %>"
                    data-item-material="<%= item.material_type || 'baustahl' %>"
                    onclick="openMoveModal(this)"
                    class="px-2 py-1 bg-indigo-50 text-indigo-600 hover:bg-indigo-100 dark:bg-indigo-900/30 dark:text-indigo-400 rounded text-xs font-semibold transition"
                    title="In anderen Tab verschieben"title="Verschieben">↗</button>
                  <form action="/lager/delete" method="POST" onsubmit="return confirm('Eintrag wirklich löschen?');" class="inline">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <input type="hidden" name="tab" value="<%= tab %>">
                    <button type="submit" class="px-2 py-1 bg-red-50 text-red-600 hover:bg-red-100 dark:bg-red-900/30 dark:text-red-400 rounded text-xs font-semibold transition"title="Löschen">×</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="mobile-card-list px-1 pt-2 gap-2.5">
        <% items.forEach(item => {
          const isLow = Number(item.mindestbestand) > 0 && Number(item.menge) <= Number(item.mindestbestand);
          const isCritical = Number(item.mindestbestand) > 0 && Number(item.menge) === 0;
          const stripe = isCritical ? '#ef4444' : isLow ? '#f59e0b' : '#22c55e';
        %>
          <div class="mb-swipe-wrap mb-lager-card">
            <div class="mb-swipe-actions">
              <button type="button" class="sw-out"
                data-item-id="<%= item.id %>"
                data-item-einheit="<%= encodeURIComponent(item.einheit || 'Stk') %>"
                onclick="openEntnahmeModalForEl(this)">↓<span>Entnahme</span></button>
              <button type="button" class="sw-edit"
                data-item-id="<%= item.id %>"
                data-item-bezeichnung="<%= encodeURIComponent(item.bezeichnung || '') %>"
                data-item-profil="<%= encodeURIComponent(item.profil || '') %>"
                data-item-abmessung="<%= encodeURIComponent(item.abmessung || '') %>"
                data-item-menge="<%= Number(item.menge || 0) %>"
                data-item-einheit="<%= encodeURIComponent(item.einheit || 'Stk') %>"
                data-item-material="<%= encodeURIComponent(item.material_type || 'baustahl') %>"
                data-item-lsnr="<%= encodeURIComponent(item.lieferschein_nr || '') %>"
                data-item-lieferdatum="<%= item.lieferdatum ? new Date(item.lieferdatum).toISOString().split('T')[0] : '' %>"
                data-item-notiz="<%= encodeURIComponent(item.notiz || '') %>"
                data-item-mindestbestand="<%= item.mindestbestand || 0 %>"
                data-item-lagerort="<%= encodeURIComponent(item.lagerort || '') %>"
                data-item-einheitspreis="<%= item.einheitspreis || 0 %>"
                onclick="openEditModalEl(this)">✎<span>Edit</span></button>
            </div>
            <div class="mb-swipe-panel m-card" style="padding:0;overflow:hidden;display:flex;flex-direction:row;align-items:stretch;border-radius:1.1rem">
            <div style="width:4px;background:<%= stripe %>;flex-shrink:0"></div>
            <div style="flex:1;min-width:0;padding:.85rem 1rem">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0 flex-1">
                  <div class="m-card-title" style="margin:0;font-size:.9rem;line-height:1.3"><%= item.bezeichnung %></div>
                  <div class="m-card-meta" style="margin-top:.3rem">
                    <% if (item.profil) { %><span><%= item.profil %></span><% } %>
                    <% if (item.abmessung) { %><span><%= item.abmessung %></span><% } %>
                    <% if (item.lagerort) { %><span><%= item.lagerort %></span><% } %>
                  </div>
                </div>
                <div class="text-right shrink-0">
                  <div class="num font-bold text-base" style="color:<%= stripe %>"><%= Number(item.menge || 0).toLocaleString('de-DE', { maximumFractionDigits: 3 }) %></div>
                  <div class="text-[10px] text-slate-400 uppercase tracking-wide"><%= item.einheit || 'Stk' %></div>
                </div>
              </div>
              <div class="m-card-actions" style="display:flex;gap:.4rem;margin-top:.75rem">
                <button type="button"
                  data-item-id="<%= item.id %>"
                  data-item-einheit="<%= encodeURIComponent(item.einheit || 'Stk') %>"
                  onclick="openEntnahmeModalForEl(this);if(navigator.vibrate)navigator.vibrate(8)"
                  class="btn text-xs flex-1 justify-center gap-1"
                  style="background:#f59e0b;color:#fff;min-height:40px;border-radius:.75rem"
                  title="Entnahme">↓ Entnahme</button>
                <button type="button"
                  data-item-id="<%= item.id %>"
                  data-item-bezeichnung="<%= encodeURIComponent(item.bezeichnung || '') %>"
                  data-item-profil="<%= encodeURIComponent(item.profil || '') %>"
                  data-item-abmessung="<%= encodeURIComponent(item.abmessung || '') %>"
                  data-item-menge="<%= Number(item.menge || 0) %>"
                  data-item-einheit="<%= encodeURIComponent(item.einheit || 'Stk') %>"
                  data-item-material="<%= encodeURIComponent(item.material_type || 'baustahl') %>"
                  data-item-lsnr="<%= encodeURIComponent(item.lieferschein_nr || '') %>"
                  data-item-lieferdatum="<%= item.lieferdatum ? new Date(item.lieferdatum).toISOString().split('T')[0] : '' %>"
                  data-item-notiz="<%= encodeURIComponent(item.notiz || '') %>"
                  data-item-mindestbestand="<%= item.mindestbestand || 0 %>"
                  data-item-lagerort="<%= encodeURIComponent(item.lagerort || '') %>"
                  data-item-einheitspreis="<%= item.einheitspreis || 0 %>"
                  onclick="openEditModalEl(this)"
                  class="btn btn-primary text-xs flex-1 justify-center"
                  style="min-height:40px;border-radius:.75rem">Bearbeiten</button>
                <button type="button"
                  data-item-id="<%= item.id %>"
                  data-item-bezeichnung="<%= encodeURIComponent(item.bezeichnung || '') %>"
                  data-item-material="<%= item.material_type || 'baustahl' %>"
                  onclick="openMoveModal(this)"
                  class="btn btn-ghost text-xs justify-center"
                  style="min-height:40px;min-width:40px;border-radius:.75rem;padding:0" title="Verschieben">↗</button>
                <form action="/lager/delete" method="POST" onsubmit="return confirm('Eintrag wirklich löschen?');" class="inline">
                  <input type="hidden" name="id" value="<%= item.id %>">
                  <input type="hidden" name="tab" value="<%= tab %>">
                  <button type="submit" class="btn btn-ghost text-xs justify-center"
                    style="min-height:40px;min-width:40px;border-radius:.75rem;padding:0;color:#dc2626" title="Löschen">×</button>
                </form>
              </div>
            </div>
          </div>
          </div>
        <% }) %>
      </div>
      <% } else { %>
      <div class="empty-state py-16">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        <h3>Keine Einträge</h3>
        <p>Lieferschein scannen oder manuell einlagern.</p>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       TAB: ENTNAHMEN
  ═══════════════════════════════════════════════════════════════════════════ -->
