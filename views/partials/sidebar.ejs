<!-- ── Mobile Top-Bar ──────────────────────────────────────────────────── -->
<div class="md:hidden fixed top-0 left-0 right-0 z-30 h-14 flex items-center justify-between px-4 shadow-md"
     style="background:var(--sidebar-bg)">
  <button onclick="toggleSidebar()" class="flex items-center gap-2 text-slate-300 hover:text-white transition text-sm font-medium">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
    Menü
  </button>
  <% const _f = typeof firma !== 'undefined' ? firma : {}; %>
  <% if (_f.sidebar_modus === 'logo' && _f.sidebar_logo_url) { %>
    <img src="<%= _f.sidebar_logo_url %>" alt="<%= _f.nameKurz %>" class="max-h-8 w-auto object-contain">
  <% } else { %>
    <span class="font-bold text-sm truncate" style="color:var(--primary)"><%= _f.nameKurz || 'Metallbau' %></span>
  <% } %>
</div>

<!-- ── Backdrop ───────────────────────────────────────────────────────── -->
<div id="sidebar-backdrop" onclick="toggleSidebar()"
     class="fixed inset-0 bg-black/60 z-40 hidden md:hidden backdrop-blur-sm"></div>

<!-- ══════════════════════════════════════════════════════════════════════
     SIDEBAR
     ══════════════════════════════════════════════════════════════════════ -->
<aside id="sidebar"
  class="fixed inset-y-0 left-0 z-50 w-72 h-full max-h-screen flex flex-col
         transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out
         overflow-y-auto"
  style="background:var(--sidebar-bg)">

  <!-- Kopfbereich -->
  <div class="flex items-center justify-between px-5 py-4 border-b border-white/10 shrink-0">
    <% if (_f.sidebar_modus === 'logo' && _f.sidebar_logo_url) { %>
      <div class="flex-1 pr-2">
        <img src="<%= _f.sidebar_logo_url %>" alt="<%= _f.nameKurz %>"
             style="width:100%;max-height:<%= _f.sidebar_logo_height || 56 %>px;object-fit:contain;object-position:left;">
      </div>
    <% } else { %>
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="text-xl leading-none"><%= _f.app_icon || '🔩' %></span>
        <span class="font-bold text-base text-white truncate"><%= _f.nameKurz || 'Metallbau' %></span>
      </div>
    <% } %>
    <button onclick="toggleSidebar()" class="md:hidden text-slate-400 hover:text-white transition p-1 rounded-lg hover:bg-white/10">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Suchfeld -->
  <div class="px-4 pt-4 pb-2 shrink-0">
    <button onclick="openSearch()"
      class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-slate-400 text-sm transition group"
      style="background:rgba(255,255,255,.07)">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <span class="flex-1 text-left text-xs">Suchen…</span>
      <kbd class="hidden md:inline text-[10px] font-mono bg-white/10 text-slate-400 px-1.5 py-0.5 rounded">/</kbd>
    </button>
  </div>

  <!-- Navigation -->
  <%
    const _hidden = (typeof sidebarHidden !== 'undefined' && Array.isArray(sidebarHidden)) ? sidebarHidden : [];
    const _show = key => !_hidden.includes('hide_' + key);
    const _perm = (typeof hasPerm === 'function') ? hasPerm : () => true;
  %>

  <nav class="flex-1 px-3 py-2 space-y-0.5" id="sidebar-nav">

    <!-- Hauptnavigation -->
    <% if (_show('dashboard')) { %>
    <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
      <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">🏠</span>
      Dashboard
    </a>
    <% } %>

    <% if (_show('projects') && _perm('projects', true, true)) { %>
    <a href="/projects" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
      <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">🏗️</span>
      Aufträge & Baustellen
    </a>
    <% } %>

    <% if (_show('calendar') && _perm('calendar', true, true)) { %>
    <a href="/calendar" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
      <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">📅</span>
      Kalender
    </a>
    <% } %>

    <% if (_show('timetracking') && _perm('timetracking', true, true)) { %>
    <a href="/timetracking" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
      <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">⏱️</span>
      Zeiterfassung
    </a>
    <% } %>

    <% if (_show('lager') && _perm('lager', true, true)) { %>
    <a href="/lager" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
      <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">🏭</span>
      Lagerliste
    </a>
    <% } %>

    <% if (_show('vacations') && _perm('vacations', true, true)) { %>
    <a href="/vacations" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
      <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">🌴</span>
      Urlaub & Abwesenheit
    </a>
    <% } %>

    <!-- Chef / Admin Bereich -->
    <% if (typeof currentUser !== 'undefined' && (currentUser.role === 'CHEF' || currentUser.role === 'ADMIN')) { %>
      <div class="pt-5 pb-1.5 px-3">
        <p class="text-[10px] font-semibold uppercase tracking-widest" style="color:rgba(255,255,255,.3)">
          <%= currentUser.role === 'CHEF' ? 'Chef-Bereich' : 'Admin-Bereich' %>
        </p>
      </div>

      <% if (_show('admin_users')) { %>
      <a href="/admin/users" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
        <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">👥</span>
        Mitarbeiter-Logins
      </a>
      <% } %>

      <% if (_show('admin_timetracking')) { %>
      <a href="/admin/timetracking" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
        <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">📋</span>
        Arbeitszeiten-Übersicht
      </a>
      <% } %>

      <% if (_show('customers') && _perm('customers', true, false)) { %>
      <a href="/customers" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
        <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">👤</span>
        Kunden
      </a>
      <% } %>

      <% if (_show('documents') && _perm('documents', true, false)) { %>
      <a href="/documents/offers" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
        <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">📋</span>
        Angebote
      </a>
      <a href="/documents/invoices" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
        <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">🧾</span>
        Rechnungen
      </a>
      <% } %>

      <% if (_show('articles') && _perm('articles', true, false)) { %>
      <a href="/articles" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
        <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">📦</span>
        Artikelstamm
      </a>
      <% } %>

      <% if (_show('company_settings')) { %>
      <a href="/admin/company-settings" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition">
        <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/10 text-base">🏢</span>
        Firmendaten
      </a>
      <% } %>

      <a href="/admin/panel" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition"
         style="color:#fbbf24">
        <span class="w-8 h-8 flex items-center justify-center rounded-lg text-base" style="background:rgba(251,191,36,.15)">⚙️</span>
        Admin-Panel
      </a>
    <% } %>
  </nav>

  <!-- Footer -->
  <div class="shrink-0 px-4 py-4 border-t border-white/10 space-y-2">
    <!-- User-Info -->
    <div class="flex items-center gap-3 px-2 py-2 rounded-xl" style="background:rgba(255,255,255,.06)">
      <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold shrink-0"
           style="background:var(--primary);color:#fff">
        <%= typeof currentUser !== 'undefined' ? currentUser.username.charAt(0).toUpperCase() : '?' %>
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-xs font-semibold text-white truncate"><%= typeof currentUser !== 'undefined' ? currentUser.username : 'Gast' %></p>
        <p class="text-[10px] text-slate-500 truncate"><%= typeof currentUser !== 'undefined' ? currentUser.role : '' %></p>
      </div>
      <button onclick="toggleDarkMode()" title="Dark Mode umschalten"
        class="p-1.5 rounded-lg text-slate-500 hover:text-white hover:bg-white/10 transition shrink-0">
        <!-- Mond (im Light Mode sichtbar) -->
        <svg class="dm-icon-moon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
        </svg>
        <!-- Sonne (im Dark Mode sichtbar) -->
        <svg class="dm-icon-sun w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
      </button>
      <button onclick="openSidebarSettings()" title="Sidebar anpassen"
        class="p-1.5 rounded-lg text-slate-500 hover:text-white hover:bg-white/10 transition shrink-0">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </button>
    </div>

    <div class="flex gap-2">
      <a href="/profile"
        class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white transition"
        style="background:rgba(255,255,255,.06)">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
        Passwort
      </a>
      <a href="/logout"
        class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-red-400 transition"
        style="background:rgba(255,255,255,.06)">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        Abmelden
      </a>
    </div>

    <p class="text-[10px] text-slate-600 text-center select-none pt-1">
      <%= _f.sidebar_footer_text || '@Domenic Rosic' %>
    </p>
  </div>
</aside>

<!-- Mobile Spacer -->
<div class="md:hidden h-14"></div>

<!-- ══════════════════════════════════════════════════════════════════════
     GLOBALE SUCHE
     ══════════════════════════════════════════════════════════════════════ -->
<div id="search-overlay" class="hidden fixed inset-0 z-[999] bg-black/70 backdrop-blur-sm flex items-start justify-center pt-[10vh] px-4" onclick="closeSearch(event)">
  <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden border border-slate-100 dark:border-slate-700" onclick="event.stopPropagation()">

    <div class="flex items-center gap-3 px-5 py-4 border-b border-slate-100 dark:border-slate-700">
      <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input id="search-input" type="text" placeholder="Auftrag, Kunde, Termin oder Notiz suchen…"
        class="flex-1 text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 outline-none bg-transparent"
        oninput="onSearchInput(this.value)"
        onkeydown="onSearchKey(event)">
      <kbd class="text-[10px] font-mono bg-slate-100 dark:bg-slate-700 text-slate-400 px-1.5 py-0.5 rounded cursor-pointer" onclick="closeSearch()">Esc</kbd>
    </div>

    <div id="search-results" class="max-h-[420px] overflow-y-auto divide-y divide-slate-50 dark:divide-slate-700">
      <p class="text-xs text-slate-400 text-center py-10">Mindestens 2 Zeichen eingeben…</p>
    </div>

    <div class="px-5 py-2.5 bg-slate-50 dark:bg-slate-700/50 border-t border-slate-100 dark:border-slate-700 flex items-center gap-4 text-[10px] text-slate-400">
      <span><kbd class="font-mono bg-white dark:bg-slate-600 border border-slate-200 dark:border-slate-500 rounded px-1">↑↓</kbd> Navigieren</span>
      <span><kbd class="font-mono bg-white dark:bg-slate-600 border border-slate-200 dark:border-slate-500 rounded px-1">↵</kbd> Öffnen</span>
      <span><kbd class="font-mono bg-white dark:bg-slate-600 border border-slate-200 dark:border-slate-500 rounded px-1">Esc</kbd> Schließen</span>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     SIDEBAR-EINSTELLUNGEN – Modal
     ══════════════════════════════════════════════════════════════════════ -->
<div id="sidebar-settings-overlay"
  style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);align-items:flex-end;justify-content:center;"
  onclick="closeSidebarSettings(event)">

  <div id="sidebar-settings-modal"
    style="background:#1e293b;color:#e2e8f0;border-radius:1.25rem 1.25rem 0 0;padding:1.5rem 1.25rem 2rem;width:100%;max-width:480px;box-shadow:0 -8px 40px rgba(0,0,0,.4);"
    onclick="event.stopPropagation()">

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;">
      <div>
        <p style="font-weight:700;font-size:1rem;margin:0;">Sidebar anpassen</p>
        <p style="font-size:.72rem;color:#64748b;margin:3px 0 0;">Wähle sichtbare Menüpunkte</p>
      </div>
      <button onclick="closeSidebarSettings()" style="background:rgba(255,255,255,.08);border:none;color:#94a3b8;cursor:pointer;font-size:1.1rem;line-height:1;padding:6px 8px;border-radius:.5rem;">✕</button>
    </div>

    <div id="sidebar-toggle-list" style="display:flex;flex-direction:column;gap:.4rem;margin-bottom:1.25rem;max-height:55vh;overflow-y:auto;"></div>

    <div style="display:flex;gap:.6rem;">
      <button onclick="sidebarSelectAll()"
        style="flex:1;padding:.6rem;border-radius:.6rem;background:rgba(255,255,255,.08);color:#94a3b8;border:1px solid rgba(255,255,255,.1);font-size:.75rem;font-weight:600;cursor:pointer;">
        Alle einblenden
      </button>
      <button onclick="applySidebarSettings()"
        style="flex:2;padding:.6rem;border-radius:.6rem;background:var(--primary, #2563eb);color:#fff;border:none;font-size:.8rem;font-weight:700;cursor:pointer;">
        ✓ Übernehmen
      </button>
    </div>
  </div>
</div>

<script>
  const SIDEBAR_ITEMS = [
    { key: 'dashboard',          label: '🏠 Dashboard' },
    { key: 'projects',           label: '🏗️ Aufträge & Baustellen' },
    { key: 'calendar',           label: '📅 Kalender' },
    { key: 'timetracking',       label: '⏱️ Zeiterfassung' },
    { key: 'lager',              label: '🏭 Lagerliste' },
    { key: 'vacations',          label: '🌴 Urlaub & Abwesenheit' },
    { key: 'admin_users',        label: '👥 Mitarbeiter-Logins (Admin)' },
    { key: 'admin_timetracking', label: '📋 Arbeitszeiten-Übersicht (Admin)' },
    { key: 'staffplan',          label: '📅 Personalplanung (Admin)' },
    { key: 'customers',          label: '👤 Kunden (Admin)' },
    { key: 'documents',          label: '📋 Angebote & Rechnungen (Admin)' },
    { key: 'articles',           label: '📦 Artikelstamm (Admin)' },
    { key: 'company_settings',   label: '🏢 Firmendaten (Admin)' },
  ];

  function getSidebarHidden() {
    try {
      const match = document.cookie.split(';').map(c => c.trim()).find(c => c.startsWith('sidebar_hidden='));
      if (match) {
        const val = decodeURIComponent(match.split('=').slice(1).join('='));
        return JSON.parse(val).map(k => k.replace(/^hide_/, ''));
      }
    } catch(e) {}
    return [];
  }

  function saveSidebarHidden(hiddenKeys) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/sidebar-settings';
    form.style.display = 'none';
    const redir = document.createElement('input');
    redir.name  = '_redirect';
    redir.value = window.location.pathname + window.location.search;
    form.appendChild(redir);
    hiddenKeys.forEach(key => {
      const inp = document.createElement('input');
      inp.name  = 'hide_' + key;
      inp.value = '1';
      form.appendChild(inp);
    });
    document.body.appendChild(form);
    form.submit();
  }

  function openSidebarSettings() {
    const hidden = getSidebarHidden();
    const list   = document.getElementById('sidebar-toggle-list');
    list.innerHTML = SIDEBAR_ITEMS.map(item => {
      const checked = !hidden.includes(item.key);
      return `
        <label style="display:flex;align-items:center;gap:.75rem;padding:.55rem .75rem;border-radius:.6rem;
          background:${checked?'rgba(37,99,235,.2)':'rgba(255,255,255,.04)'};
          border:1px solid ${checked?'rgba(37,99,235,.5)':'rgba(255,255,255,.08)'};cursor:pointer;" id="slbl-${item.key}">
          <input type="checkbox" data-sb-key="${item.key}" ${checked?'checked':''}
            onchange="sbToggleHighlight('${item.key}',this.checked)"
            style="width:1rem;height:1rem;accent-color:#2563eb;cursor:pointer;flex-shrink:0;">
          <span style="font-size:.8rem;font-weight:500;">${item.label}</span>
        </label>`;
    }).join('');
    document.getElementById('sidebar-settings-overlay').style.display = 'flex';
  }

  function sbToggleHighlight(key, checked) {
    const lbl = document.getElementById('slbl-' + key);
    if (!lbl) return;
    lbl.style.background  = checked ? 'rgba(37,99,235,.2)' : 'rgba(255,255,255,.04)';
    lbl.style.borderColor = checked ? 'rgba(37,99,235,.5)' : 'rgba(255,255,255,.08)';
  }

  function sidebarSelectAll() {
    document.querySelectorAll('#sidebar-toggle-list input[data-sb-key]').forEach(cb => {
      cb.checked = true;
      sbToggleHighlight(cb.dataset.sbKey, true);
    });
  }

  function closeSidebarSettings(e) {
    if (e && e.target !== document.getElementById('sidebar-settings-overlay')) return;
    document.getElementById('sidebar-settings-overlay').style.display = 'none';
  }

  function applySidebarSettings() {
    const hidden = [];
    document.querySelectorAll('#sidebar-toggle-list input[data-sb-key]').forEach(cb => {
      if (!cb.checked) hidden.push(cb.dataset.sbKey);
    });
    saveSidebarHidden(hidden);
  }

  function toggleSidebar() {
    const sidebar  = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    sidebar.classList.toggle('-translate-x-full');
    backdrop.classList.toggle('hidden');
  }

  // ── Suche ──────────────────────────────────────────────────────────────────
  function openSearch() {
    document.getElementById('search-overlay').classList.remove('hidden');
    setTimeout(() => document.getElementById('search-input').focus(), 50);
  }
  function closeSearch(e) {
    if (e && e.target !== document.getElementById('search-overlay')) return;
    document.getElementById('search-overlay').classList.add('hidden');
    document.getElementById('search-input').value = '';
    document.getElementById('search-results').innerHTML =
      '<p class="text-xs text-slate-400 text-center py-10">Mindestens 2 Zeichen eingeben…</p>';
    activeIdx = -1;
  }

  document.addEventListener('keydown', function(e) {
    const tag = document.activeElement.tagName;
    if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') {
      e.preventDefault(); openSearch();
    }
    if (e.key === 'Escape') {
      document.getElementById('search-overlay').classList.add('hidden');
      document.getElementById('search-input').value = '';
      activeIdx = -1;
    }
  });

  let searchTimer = null, activeIdx = -1, lastResults = [];

  function onSearchInput(val) {
    clearTimeout(searchTimer);
    activeIdx = -1;
    if (val.trim().length < 2) {
      document.getElementById('search-results').innerHTML =
        '<p class="text-xs text-slate-400 text-center py-10">Mindestens 2 Zeichen eingeben…</p>';
      return;
    }
    document.getElementById('search-results').innerHTML =
      '<p class="text-xs text-slate-400 text-center py-8">Suche…</p>';
    searchTimer = setTimeout(() => doSearch(val.trim()), 260);
  }

  async function doSearch(q) {
    try {
      const res  = await fetch('/api/search?q=' + encodeURIComponent(q));
      const data = await res.json();
      lastResults = data.results || [];
      renderResults(lastResults, q);
    } catch (_) {
      document.getElementById('search-results').innerHTML =
        '<p class="text-xs text-red-400 text-center py-6">Fehler beim Laden.</p>';
    }
  }

  function renderResults(results, q) {
    const box = document.getElementById('search-results');
    if (!results.length) {
      box.innerHTML = '<p class="text-xs text-slate-400 text-center py-10">Keine Ergebnisse.</p>';
      return;
    }
    function highlight(text, term) {
      if (!term) return esc(text);
      const re = new RegExp('(' + term.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + ')', 'gi');
      return esc(text).replace(re, '<mark class="bg-yellow-100 text-yellow-900 rounded px-0.5">$1</mark>');
    }
    function esc(t) {
      return String(t ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
    const typeLabel = { project:'Auftrag', customer:'Kunde', appointment:'Termin', note:'Notiz', user:'Mitarbeiter', article:'Artikel' };
    const typeBg    = { project:'bg-blue-50 text-blue-700', customer:'bg-purple-50 text-purple-700',
                        appointment:'bg-amber-50 text-amber-700', note:'bg-slate-100 text-slate-600',
                        user:'bg-emerald-50 text-emerald-700', article:'bg-orange-50 text-orange-700' };
    box.innerHTML = results.map((r, i) => `
      <a href="${r.url}" id="sr-${i}"
        class="flex items-start gap-3 px-5 py-3.5 hover:bg-slate-50 dark:hover:bg-slate-700 transition cursor-pointer search-result-item"
        data-idx="${i}">
        <span class="text-xl leading-none mt-0.5 shrink-0">${r.icon}</span>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate">${highlight(r.label, q)}</p>
          ${r.sub ? `<p class="text-xs text-slate-400 truncate mt-0.5">${esc(r.sub)}</p>` : ''}
        </div>
        <span class="text-[10px] font-semibold shrink-0 mt-1 px-1.5 py-0.5 rounded-full ${typeBg[r.type] || 'bg-slate-100 text-slate-500'}">
          ${typeLabel[r.type] || r.type}
        </span>
      </a>`).join('');
  }

  function onSearchKey(e) {
    const items = document.querySelectorAll('.search-result-item');
    if (!items.length) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx+1, items.length-1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx-1, 0); }
    else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); items[activeIdx].click(); return; }
    else return;
    items.forEach((el, i) => {
      el.classList.toggle('bg-slate-100', i === activeIdx);
      el.classList.toggle('dark:bg-slate-700', i === activeIdx);
    });
    items[activeIdx]?.scrollIntoView({ block:'nearest' });
  }
</script>
