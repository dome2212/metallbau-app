<!-- Mobile Menü-Leiste ganz oben (nur auf Handys sichtbar) -->
<div class="md:hidden bg-slate-900 text-white p-3 flex justify-between items-center shadow-md w-full fixed top-0 left-0 z-30">
  <button onclick="toggleSidebar()" class="text-sm px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded text-white font-medium flex items-center gap-1">
    ☰ Menü
  </button>
  <% const _f = typeof firma !== 'undefined' ? firma : {}; %>
  <% if (_f.sidebar_modus === 'logo' && _f.sidebar_logo_url) { %>
    <img src="<%= _f.sidebar_logo_url %>" alt="<%= _f.nameKurz %>" class="max-h-10 w-auto object-contain">
  <% } else { %>
    <span class="font-bold text-blue-400 text-sm truncate"><%= _f.nameKurz || 'Metallbau' %></span>
  <% } %>
</div>

<!-- Verdunklungs-Hintergrund für Mobil (öffnet sich, wenn Sidebar da ist) -->
<div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

<!-- Die eigentliche Sidebar -->
<aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 h-full max-h-screen bg-slate-800 text-white p-4 flex flex-col justify-between transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl overflow-y-auto">
  <div>
    <!-- Kopfbereich mit Schließen-Button für Mobil -->
    <div class="flex justify-between items-center mb-6 border-b border-gray-700 pb-3">
      <% if (_f.sidebar_modus === 'logo' && _f.sidebar_logo_url) { %>
        <div class="flex-1 pr-2">
          <img src="<%= _f.sidebar_logo_url %>" alt="<%= _f.nameKurz %>"
               style="width:100%; max-height:<%= _f.sidebar_logo_height || 80 %>px; object-fit:contain; object-position:left;">
        </div>
      <% } else { %>
        <h2 class="text-lg font-bold tracking-wide text-blue-400 truncate">
          🔩 <%= _f.nameKurz || 'Metallbau' %>
        </h2>
      <% } %>
      <button onclick="toggleSidebar()" class="md:hidden text-gray-400 hover:text-white text-xl p-1 font-bold shrink-0">
        ✕
      </button>
    </div>

    <!-- Suchfeld -->
    <div class="mb-4">
      <button onclick="openSearch()"
        class="w-full flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 text-sm transition group">
        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <span class="flex-1 text-left text-slate-400 text-xs">Suchen…</span>
        <kbd class="hidden md:inline text-[10px] font-mono bg-slate-600 group-hover:bg-slate-500 text-slate-300 px-1.5 py-0.5 rounded">/</kbd>
      </button>
    </div>

    <%
      // Sidebar-Einstellungen aus Cookie lesen
      let _hidden = [];
      try {
        const _raw = (typeof req !== 'undefined' && req.cookies && req.cookies.sidebar_hidden) ||
                     (typeof locals !== 'undefined' && locals.sidebarHidden) || '[]';
        _hidden = JSON.parse(_raw);
      } catch(e) {}
      const _show = key => !_hidden.includes('hide_' + key);
    %>
    <nav class="space-y-1.5" id="sidebar-nav">
      <% if (_show('dashboard')) { %>
      <a href="/" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">🏠 Dashboard</a>
      <% } %>

      <!-- Für Alle sichtbar -->
      <% if (_show('projects')) { %>
      <a href="/projects" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">🏗️ Aufträge & Baustellen</a>
      <% } %>
      <% if (_show('calendar')) { %>
      <a href="/calendar" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">📅 Kalender</a>
      <% } %>
      <% if (_show('timetracking')) { %>
      <a href="/timetracking" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">⏱️ Zeiterfassung</a>
      <% } %>
      <% if (_show('vacations')) { %>
      <a href="/vacations" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">🌴 Urlaub & Abwesenheit</a>
      <% } %>
      <% if (_show('lexikon')) { %>
      <a href="/lexikon" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">📖 Werkstatt-Lexikon</a>
      <% } %>
      <% if (_show('steel_calculator')) { %>
      <a href="/steel-calculator" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">⚖️ Stahlrechner</a>
      <% } %>
      <% if (_show('treppe')) { %>
      <a href="/treppe" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">📐 Treppen-Aufmaß</a>
      <% } %>

      <!-- NUR FÜR CHEFS (ADMIN) -->
      <% if (typeof currentUser !== 'undefined' && currentUser.role === 'ADMIN') { %>
        <div class="pt-4 pb-1 text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Chef-Bereich</div>
        <% if (_show('admin_users')) { %>
        <a href="/admin/users" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">👥 Mitarbeiter-Logins</a>
        <% } %>
        <% if (_show('admin_timetracking')) { %>
        <a href="/admin/timetracking" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">📋 Arbeitszeiten-Übersicht</a>
        <% } %>
        <% if (_show('customers')) { %>
        <a href="/customers" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">👤 Kunden</a>
        <% } %>
        <% if (_show('documents')) { %>
        <a href="/documents/offers" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">📋 Angebote</a>
        <a href="/documents/invoices" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">🧾 Rechnungen</a>
        <% } %>
        <% if (_show('articles')) { %>
        <a href="/articles" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">📦 Artikelstamm</a>
        <% } %>
        <% if (_show('company_settings')) { %>
        <a href="/admin/company-settings" class="block px-3 py-2.5 rounded hover:bg-slate-700 text-gray-300 text-sm">🏢 Firmendaten</a>
        <% } %>
      <% } %>
    </nav>
  </div>
  
  <div class="border-t border-gray-700 pt-3 space-y-2 mt-4" id="sidebar-bottom">
    <!-- Sidebar-Einstellungen Zahnrad -->
    <button onclick="openSidebarSettings()"
      class="w-full flex items-center justify-center gap-2 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 text-xs font-medium transition">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      Sidebar anpassen
    </button>
    <div class="text-xs text-gray-400 mb-1">
      Eingeloggt als: <strong class="text-white"><%= typeof currentUser !== 'undefined' ? currentUser.username : 'Gast' %></strong> 
      (<%= typeof currentUser !== 'undefined' ? currentUser.role : '' %>)
    </div>

    <!-- Dark-Mode Toggle -->
    <button id="darkToggleBtn" onclick="toggleDarkMode()"
      class="w-full flex items-center justify-center gap-2 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 text-xs font-medium transition">
      <span id="darkToggleIcon">🌙</span>
      <span id="darkToggleLabel">Dark Mode</span>
    </button>

    <a href="/profile" class="block w-full text-center bg-slate-600 hover:bg-slate-500 text-white text-xs py-2 rounded transition font-medium">
      🔑 Passwort ändern
    </a>

    <a href="/logout" class="block w-full text-center bg-red-600 hover:bg-red-700 text-white text-xs py-2 rounded transition font-medium">
      Abmelden
    </a>
    <div class="text-[10px] text-slate-500 text-center pt-1 select-none">
      @Domenic Rosic
    </div>
  </div>
</aside>

<!-- Abstandhalter oben für Mobil -->
<div class="md:hidden h-14"></div>

<!-- ══════════════════════════════════════════════════════════════ -->
<!-- GLOBALE SUCHE – Overlay                                        -->
<!-- ══════════════════════════════════════════════════════════════ -->
<div id="search-overlay" class="hidden fixed inset-0 z-[999] bg-black/60 flex items-start justify-center pt-16 px-4" onclick="closeSearch(event)">
  <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden" onclick="event.stopPropagation()">

    <!-- Eingabe -->
    <div class="flex items-center gap-3 px-4 py-3 border-b border-slate-100 dark:border-slate-700">
      <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input id="search-input" type="text" placeholder="Auftrag, Kunde, Termin oder Notiz suchen…"
        class="flex-1 text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 outline-none bg-transparent"
        oninput="onSearchInput(this.value)"
        onkeydown="onSearchKey(event)">
      <kbd class="text-[10px] font-mono bg-slate-100 dark:bg-slate-700 text-slate-400 dark:text-slate-300 px-1.5 py-0.5 rounded cursor-pointer" onclick="closeSearch()">Esc</kbd>
    </div>

    <!-- Ergebnisse -->
    <div id="search-results" class="max-h-[420px] overflow-y-auto divide-y divide-slate-50 dark:divide-slate-700">
      <p class="text-xs text-slate-400 text-center py-8">Mindestens 2 Zeichen eingeben…</p>
    </div>

    <!-- Footer -->
    <div class="px-4 py-2 bg-slate-50 dark:bg-slate-700/50 border-t border-slate-100 dark:border-slate-700 flex items-center gap-4 text-[10px] text-slate-400">
      <span><kbd class="font-mono bg-white dark:bg-slate-600 border border-slate-200 dark:border-slate-500 rounded px-1">↑↓</kbd> Navigieren</span>
      <span><kbd class="font-mono bg-white dark:bg-slate-600 border border-slate-200 dark:border-slate-500 rounded px-1">↵</kbd> Öffnen</span>
      <span><kbd class="font-mono bg-white dark:bg-slate-600 border border-slate-200 dark:border-slate-500 rounded px-1">Esc</kbd> Schließen</span>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     SIDEBAR-EINSTELLUNGEN – Modal (welche Nav-Einträge sichtbar)
     ══════════════════════════════════════════════════════════════════════ -->
<div id="sidebar-settings-overlay"
  style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.6);align-items:flex-end;justify-content:center;"
  onclick="closeSidebarSettings(event)">

  <div id="sidebar-settings-modal"
    style="background:#1e293b;color:#e2e8f0;border-radius:1rem 1rem 0 0;padding:1.5rem 1.25rem 2rem;width:100%;max-width:480px;box-shadow:0 -4px 24px rgba(0,0,0,.4);"
    onclick="event.stopPropagation()">

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.1rem;">
      <div>
        <p style="font-weight:700;font-size:1rem;margin:0;">⚙️ Sidebar anpassen</p>
        <p style="font-size:.72rem;color:#94a3b8;margin:2px 0 0;">Wähle, welche Menüpunkte sichtbar sein sollen</p>
      </div>
      <button onclick="closeSidebarSettings()" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.3rem;line-height:1;padding:2px 4px;">✕</button>
    </div>

    <div id="sidebar-toggle-list" style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.2rem;max-height:60vh;overflow-y:auto;"></div>

    <div style="display:flex;gap:.6rem;">
      <button onclick="sidebarSelectAll()"
        style="flex:1;padding:.55rem;border-radius:.5rem;background:#334155;color:#94a3b8;border:1px solid #475569;font-size:.75rem;font-weight:600;cursor:pointer;">
        Alle einblenden
      </button>
      <button onclick="applySidebarSettings()"
        style="flex:2;padding:.55rem;border-radius:.5rem;background:#1e3a5f;color:#fff;border:none;font-size:.8rem;font-weight:700;cursor:pointer;">
        ✓ Übernehmen &amp; schließen
      </button>
    </div>
  </div>
</div>

<script>
  // Sidebar-Einträge (key muss mit _show('key') im EJS übereinstimmen)
  const SIDEBAR_ITEMS = [
    { key: 'dashboard',         label: '🏠 Dashboard' },
    { key: 'projects',          label: '🏗️ Aufträge & Baustellen' },
    { key: 'calendar',          label: '📅 Kalender' },
    { key: 'timetracking',      label: '⏱️ Zeiterfassung' },
    { key: 'vacations',         label: '🌴 Urlaub & Abwesenheit' },
    { key: 'lexikon',           label: '📖 Werkstatt-Lexikon' },
    { key: 'steel_calculator',  label: '⚖️ Stahlrechner' },
    { key: 'treppe',            label: '📐 Treppen-Aufmaß' },
    { key: 'admin_users',       label: '👥 Mitarbeiter-Logins (Admin)' },
    { key: 'admin_timetracking',label: '📋 Arbeitszeiten-Übersicht (Admin)' },
    { key: 'customers',         label: '👤 Kunden (Admin)' },
    { key: 'documents',         label: '📋 Angebote & Rechnungen (Admin)' },
    { key: 'articles',          label: '📦 Artikelstamm (Admin)' },
    { key: 'company_settings',  label: '🏢 Firmendaten (Admin)' },
  ];

  function getSidebarHidden() {
    try { return JSON.parse(localStorage.getItem('sidebar_hidden_keys') || '[]'); } catch(e) { return []; }
  }
  function saveSidebarHidden(arr) {
    try { localStorage.setItem('sidebar_hidden_keys', JSON.stringify(arr)); } catch(e) {}
    // Auch als Cookie setzen, damit EJS es beim nächsten Laden lesen kann
    const expires = new Date(Date.now() + 365*24*60*60*1000).toUTCString();
    document.cookie = 'sidebar_hidden=' + encodeURIComponent(JSON.stringify(
      arr.map(k => 'hide_' + k)
    )) + ';path=/;expires=' + expires;
  }

  function openSidebarSettings() {
    const hidden = getSidebarHidden();
    const list = document.getElementById('sidebar-toggle-list');
    list.innerHTML = SIDEBAR_ITEMS.map(item => {
      const checked = !hidden.includes(item.key);
      return `
        <label style="display:flex;align-items:center;gap:.75rem;padding:.5rem .75rem;border-radius:.5rem;
          background:${checked?'#1e3a5f':'#0f172a'};border:1px solid ${checked?'#2563eb':'#334155'};cursor:pointer;" id="slbl-${item.key}">
          <input type="checkbox" data-sb-key="${item.key}" ${checked?'checked':''}
            onchange="sbToggleHighlight('${item.key}',this.checked)"
            style="width:1.1rem;height:1.1rem;accent-color:#2563eb;cursor:pointer;flex-shrink:0;">
          <span style="font-size:.8rem;font-weight:600;">${item.label}</span>
        </label>`;
    }).join('');
    document.getElementById('sidebar-settings-overlay').style.display = 'flex';
  }

  function sbToggleHighlight(key, checked) {
    const lbl = document.getElementById('slbl-' + key);
    if (!lbl) return;
    lbl.style.background   = checked ? '#1e3a5f' : '#0f172a';
    lbl.style.borderColor  = checked ? '#2563eb' : '#334155';
  }

  function sidebarSelectAll() {
    document.querySelectorAll('#sidebar-toggle-list input[data-sb-key]').forEach(cb => {
      cb.checked = true;
      sbToggleHighlight(cb.dataset.sbKey, true);
    });
  }

  function closeSidebarSettings(e) {
    if (e && e.target !== document.getElementById('sidebar-settings-overlay')) return;
    document.getElementById('sidebar-settings-overlay').style.display = 'none';
  }

  function applySidebarSettings() {
    const hidden = [];
    document.querySelectorAll('#sidebar-toggle-list input[data-sb-key]').forEach(cb => {
      if (!cb.checked) hidden.push(cb.dataset.sbKey);
    });
    saveSidebarHidden(hidden);
    document.getElementById('sidebar-settings-overlay').style.display = 'none';
    // Seite neu laden, damit EJS den neuen Cookie ausliest
    window.location.reload();
  }

  function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    sidebar.classList.toggle('-translate-x-full');
    backdrop.classList.toggle('hidden');
  }

  // ── Dark Mode ────────────────────────────────────────────────────────────
  function toggleDarkMode() {
    const isDark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('darkMode', isDark); } catch(e) {}
    updateDarkToggleUI(isDark);
  }

  function updateDarkToggleUI(isDark) {
    const icon  = document.getElementById('darkToggleIcon');
    const label = document.getElementById('darkToggleLabel');
    if (!icon || !label) return;
    icon.textContent  = isDark ? '☀️' : '🌙';
    label.textContent = isDark ? 'Hell-Modus' : 'Dark Mode';
  }

  // Beim Laden UI-Zustand sofort setzen
  (function() {
    try {
      updateDarkToggleUI(localStorage.getItem('darkMode') === 'true');
    } catch(e) {}
  })();

  // ── Suche öffnen/schließen ────────────────────────────────────────────────
  function openSearch() {
    document.getElementById('search-overlay').classList.remove('hidden');
    setTimeout(() => document.getElementById('search-input').focus(), 50);
  }
  function closeSearch(e) {
    if (e && e.target !== document.getElementById('search-overlay')) return;
    document.getElementById('search-overlay').classList.add('hidden');
    document.getElementById('search-input').value = '';
    document.getElementById('search-results').innerHTML =
      '<p class="text-xs text-slate-400 text-center py-8">Mindestens 2 Zeichen eingeben…</p>';
    activeIdx = -1;
  }

  // Tastenkürzel /
  document.addEventListener('keydown', function (e) {
    const tag = document.activeElement.tagName;
    if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') {
      document.getElementById('search-overlay').classList.add('hidden');
      document.getElementById('search-input').value = '';
      activeIdx = -1;
    }
  });

  // ── Debounced fetch ───────────────────────────────────────────────────────
  let searchTimer = null;
  let activeIdx   = -1;
  let lastResults = [];

  function onSearchInput(val) {
    clearTimeout(searchTimer);
    activeIdx = -1;
    if (val.trim().length < 2) {
      document.getElementById('search-results').innerHTML =
        '<p class="text-xs text-slate-400 text-center py-8">Mindestens 2 Zeichen eingeben…</p>';
      return;
    }
    document.getElementById('search-results').innerHTML =
      '<p class="text-xs text-slate-400 text-center py-6">Suche…</p>';
    searchTimer = setTimeout(() => doSearch(val.trim()), 260);
  }

  async function doSearch(q) {
    try {
      const res  = await fetch('/api/search?q=' + encodeURIComponent(q));
      const data = await res.json();
      lastResults = data.results || [];
      renderResults(lastResults, q);
    } catch (_) {
      document.getElementById('search-results').innerHTML =
        '<p class="text-xs text-red-400 text-center py-6">Fehler beim Laden der Ergebnisse.</p>';
    }
  }

  function renderResults(results, q) {
    const box = document.getElementById('search-results');
    if (!results.length) {
      box.innerHTML = '<p class="text-xs text-slate-400 text-center py-8">Keine Ergebnisse gefunden.</p>';
      return;
    }

    // Treffer im Text hervorheben
    function highlight(text, term) {
      if (!term) return esc(text);
      const re = new RegExp('(' + term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
      return esc(text).replace(re, '<mark class="bg-yellow-100 text-yellow-900 rounded px-0.5 not-italic">$1</mark>');
    }
    function esc(t) {
      return String(t ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    const typeLabel = { project:'Auftrag', customer:'Kunde', appointment:'Termin', note:'Notiz' };
    const typeBg    = { project:'bg-blue-50 text-blue-700', customer:'bg-purple-50 text-purple-700',
                        appointment:'bg-amber-50 text-amber-700', note:'bg-slate-100 text-slate-600' };

    box.innerHTML = results.map((r, i) => `
      <a href="${r.url}" id="sr-${i}"
        class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-700 transition cursor-pointer search-result-item"
        data-idx="${i}">
        <span class="text-xl leading-none mt-0.5 shrink-0">${r.icon}</span>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate">${highlight(r.label, q)}</p>
          ${r.sub ? `<p class="text-xs text-slate-400 truncate mt-0.5">${esc(r.sub)}</p>` : ''}
        </div>
        <span class="text-[10px] font-semibold shrink-0 mt-1 px-1.5 py-0.5 rounded ${typeBg[r.type] || 'bg-slate-100 text-slate-500'}">
          ${typeLabel[r.type] || r.type}
        </span>
      </a>`).join('');
  }

  // ── Tastaturnavigation ────────────────────────────────────────────────────
  function onSearchKey(e) {
    const items = document.querySelectorAll('.search-result-item');
    if (!items.length) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIdx = Math.min(activeIdx + 1, items.length - 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIdx = Math.max(activeIdx - 1, 0);
    } else if (e.key === 'Enter' && activeIdx >= 0) {
      e.preventDefault();
      items[activeIdx].click();
      return;
    } else {
      return;
    }

    items.forEach((el, i) => {
      el.classList.toggle('bg-slate-100', i === activeIdx);
      el.classList.toggle('dark:bg-slate-700', i === activeIdx);
      el.classList.toggle('hover:bg-slate-50', i !== activeIdx);
    });
    items[activeIdx]?.scrollIntoView({ block: 'nearest' });
  }
</script>
