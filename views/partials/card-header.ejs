<!--
  Wiederverwendbarer Card-Header: Icon-Kachel + Titel + Untertitel.
  Ersetzt den bisher in jeder View wiederholten Block aus
  .icon-tile + <h2> + <p>, damit Farbe/Größe/Abstände an einer
  Stelle gepflegt werden statt in jeder View einzeln.

  Aufruf-Beispiel:
    <%- include('partials/card-header', {
      icon: 'M3 11l18-5v12L3 14v-3z',
      iconBg: '#fef3c7', iconColor: '#d97706',
      title: 'Schwarzes Brett',
      subtitle: 'Nachrichten an alle Mitarbeiter'
    }) %>

  Für Icons mit mehreren <path>-Elementen: "iconPaths" (Array) statt "icon".
  "subtitleClass" optional, falls die Unterzeile eine Sonderfarbe braucht
  (z.B. rot bei überfälligen Aufgaben) – Default ist neutral (text-slate-400).
  "mb" optional, Default "mb-5" (Abstand nach unten); manche Views nutzen "mb-4".
-->
<div class="flex items-center gap-3 <%= typeof mb !== 'undefined' ? mb : 'mb-5' %>">
  <div class="icon-tile" style="background:<%= typeof iconBg !== 'undefined' ? iconBg : '#e0e7ff' %>;color:<%= typeof iconColor !== 'undefined' ? iconColor : '#4f46e5' %>;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <% if (typeof iconPaths !== 'undefined' && Array.isArray(iconPaths)) { %>
        <% iconPaths.forEach(function(p) { %><path d="<%= p %>"/><% }) %>
      <% } else if (typeof icon !== 'undefined' && icon) { %>
        <path d="<%= icon %>"/>
      <% } %>
    </svg>
  </div>
  <div>
    <h2 class="text-base font-semibold text-slate-800 dark:text-slate-100"><%= title %></h2>
    <% if (typeof subtitle !== 'undefined' && subtitle) { %>
      <p class="text-xs <%= typeof subtitleClass !== 'undefined' ? subtitleClass : 'text-slate-400' %> font-medium"><%- subtitle %></p>
    <% } %>
  </div>
</div>
