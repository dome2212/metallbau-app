    window.addEventListener('pageshow', done);
    document.addEventListener('DOMContentLoaded', done);
  })();

  // ── Count-up Animation für KPI-Zahlen ─────────────────────────────────
  function animateCountUp(el, target, duration = 900) {
    if (!el || isNaN(target)) return;
    const start = 0;
    const startTime = performance.now();
    const isInt = Number.isInteger(target);
    function tick(now) {
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3); // ease-out cubic
      const val = start + (target - start) * eased;
      el.textContent = isInt ? Math.round(val) : val.toFixed(1);
      if (progress < 1) requestAnimationFrame(tick);
      else el.textContent = isInt ? target : target.toFixed(1);
    }
    requestAnimationFrame(tick);
  }
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-count]').forEach(el => {
      const raw = el.getAttribute('data-count');
      const num = parseFloat(String(raw).replace(/[^\d.-]/g, ''));
      if (!isNaN(num)) {
        el.classList.add('count-up');
        el.textContent = '0';
        // leicht verzögert für sichtbaren Effekt
        setTimeout(() => animateCountUp(el, num), 120);
