      filtered = COMMANDS.filter(c =>
        c.label.toLowerCase().includes(q) || (c.keywords || '').includes(q)
      );
      activeIdx = 0;
      render();
    });

    input.addEventListener('keydown', e => {
      if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, filtered.length - 1); render(); }
      if (e.key === 'ArrowUp')   { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); render(); }
      if (e.key === 'Enter' && filtered[activeIdx]) {
        e.preventDefault();
        window.location.href = filtered[activeIdx].href;
      }
      if (e.key === 'Escape') { e.preventDefault(); close(); }
    });

    overlay.addEventListener('click', e => { if (e.target === overlay) close(); });

    document.addEventListener('keydown', e => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (overlay.classList.contains('open')) close();
        else open();
      }
      // Slash öffnet nur wenn kein Input fokussiert ist
      if (e.key === '/' && !['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)) {
        // bestehende globale Suche lassen wir unberührt – Command Palette über Ctrl+K
      }
    });
  })();
</script>
