<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Metallbau Gehrmann Management</title>
  <!-- Tailwind CSS via CDN für modernes Design -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- PWA Manifest & Theme-Color für den Handy-Browser -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2563eb">
</head>
<body class="bg-gray-100 text-gray-950 flex flex-col md:flex-row min-h-screen">

<!-- ================================================================
     WEB-PUSH: Service-Worker registrieren + Benachrichtigungen abonnieren
     Läuft still im Hintergrund – Banner erscheint nur beim ersten Besuch.
     ================================================================ -->
<div id="push-banner" class="hidden fixed bottom-0 left-0 right-0 z-50 bg-slate-800 text-white px-4 py-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-2xl">
  <div class="flex items-start gap-3">
    <span class="text-2xl leading-none">🔔</span>
    <div>
      <p class="text-sm font-semibold">Benachrichtigungen aktivieren</p>
      <p class="text-xs text-slate-300">Werde sofort informiert, wenn der Chef einen neuen Auftrag oder Termin einträgt.</p>
    </div>
  </div>
  <div class="flex gap-2 w-full sm:w-auto flex-shrink-0">
    <button id="push-allow-btn"  class="flex-1 sm:flex-none bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-4 py-2 rounded-lg transition">Aktivieren</button>
    <button id="push-deny-btn"   class="flex-1 sm:flex-none bg-slate-600 hover:bg-slate-500 text-white text-xs font-semibold px-4 py-2 rounded-lg transition">Nein danke</button>
  </div>
</div>

<script>
(function () {
  'use strict';

  // ── 1. Service Worker registrieren ───────────────────────────────────────
  if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;

  // urlB64 → Uint8Array für VAPID-Key
  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = atob(base64);
    return Uint8Array.from([...rawData].map(c => c.charCodeAt(0)));
  }

  let swReg = null;

  async function init() {
    try {
      swReg = await navigator.serviceWorker.register('/sw.js', { scope: '/' });
    } catch (e) {
      console.warn('SW-Registrierung fehlgeschlagen:', e);
      return;
    }

    // ── 2. Bereits abonniert? ─────────────────────────────────────────────
    const existing = await swReg.pushManager.getSubscription();
    if (existing) {
      // Subscription beim Server erneuern (falls Server-DB neu)
      await syncSubscription(existing);
      return;
    }

    // ── 3. Bereits abgelehnt? Dann nicht nochmals fragen ─────────────────
    if (Notification.permission === 'denied') return;
    if (localStorage.getItem('push_dismissed')) return;

    // ── 4. Banner anzeigen ────────────────────────────────────────────────
    document.getElementById('push-banner').classList.remove('hidden');

    document.getElementById('push-allow-btn').addEventListener('click', async () => {
      document.getElementById('push-banner').classList.add('hidden');
      await subscribe();
    });

    document.getElementById('push-deny-btn').addEventListener('click', () => {
      document.getElementById('push-banner').classList.add('hidden');
      localStorage.setItem('push_dismissed', '1');
    });
  }

  async function subscribe() {
    try {
      // VAPID Public Key vom Server holen
      const keyRes = await fetch('/push/vapid-public-key');
      const { key } = await keyRes.json();
      if (!key) { console.warn('Kein VAPID-Key – Push deaktiviert.'); return; }

      const permission = await Notification.requestPermission();
      if (permission !== 'granted') return;

      const sub = await swReg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(key)
      });
      await syncSubscription(sub);
    } catch (e) {
      console.error('Push-Abonnement fehlgeschlagen:', e);
    }
  }

  async function syncSubscription(sub) {
    try {
      await fetch('/push/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(sub.toJSON())
      });
    } catch (e) { /* ignore – non-critical */ }
  }

  // Starten wenn DOM bereit
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
