    document.body.setAttribute('data-page', page);

    const bar = document.querySelector('#nprogress .bar');
    const wrap = document.getElementById('nprogress');
    if (!bar || !wrap) return;

    let timer;
    function start() {
      wrap.classList.add('active');
      bar.style.width = '30%';
      clearTimeout(timer);
      timer = setTimeout(() => { bar.style.width = '70%'; }, 200);
    }
    function done() {
      bar.style.width = '100%';
      setTimeout(() => {
        wrap.classList.remove('active');
        bar.style.width = '0%';
      }, 280);
    }

    document.addEventListener('click', function (e) {
      const a = e.target.closest('a[href]');
      if (!a) return;
      const href = a.getAttribute('href') || '';
      if (href.startsWith('#') || href.startsWith('javascript:') || a.target === '_blank') return;
      if (a.hasAttribute('download')) return;
      // same-origin relative navigations
      start();
