<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= typeof firma !== 'undefined' ? firma.nameKurz : 'Metallbau' %> – Management</title>

  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Anti-flicker dark mode -->
  <script>
    (function() {
      try {
        const dmDefault = '<%= typeof firma !== "undefined" && firma.dark_mode_default === "true" ? "true" : "false" %>';
        const stored = localStorage.getItem('darkMode');
        const active = stored !== null ? stored === 'true' : dmDefault === 'true';
        if (active) document.documentElement.classList.add('dark');
      } catch(e) {}
    })();
  </script>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'class' }
  </script>

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="<%= typeof firma !== 'undefined' && firma.color_primary ? firma.color_primary : '#2563eb' %>">

  <% const _d = typeof firma !== 'undefined' ? firma : {}; %>
  <style>
    /* ── Basis ──────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; }

    body, input, button, select, textarea {
      font-family: 'Inter', system-ui, -apple-system, sans-serif,
                   "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji";
    }

    /* ── Design-Tokens ──────────────────────────────────────────────── */
    :root {
      --primary:          <%= _d.color_primary      || '#4f46e5' %>;
      --primary-dark:     color-mix(in srgb, <%= _d.color_primary || '#4f46e5' %> 80%, #000);
      --primary-soft:     color-mix(in srgb, <%= _d.color_primary || '#4f46e5' %> 10%, #fff);
      --sidebar-bg:       <%= _d.color_sidebar_bg   || '#0f172a' %>;
      --sidebar-text:     <%= _d.color_sidebar_text || '#cbd5e1' %>;
      --sidebar-hover:    <%= _d.color_sidebar_hover|| '#1e293b' %>;
      --topbar-bg:        <%= _d.color_topbar_bg    || '#ffffff' %>;
      --page-bg:          <%= _d.color_page_bg      || '#f8fafc' %>;
      --radius:           0.875rem;
      --radius-lg:        1.25rem;
      --radius-xl:        1.5rem;
      --shadow-card:      0 1px 2px 0 rgb(15 23 42/.04), 0 1px 6px -2px rgb(15 23 42/.06);
      --shadow-card-hover:0 8px 24px -4px rgb(15 23 42/.10), 0 2px 8px -2px rgb(15 23 42/.06);
      --border-soft:      #eef1f6;
    }
    .dark {
      --border-soft: #334155;
    }

    /* ── Pill-Badges (Status) ───────────────────────────────────────── */
    .badge {
      display: inline-flex; align-items: center; gap: .3rem;
      font-size: .6875rem; font-weight: 700; letter-spacing: .01em;
      padding: .28rem .65rem; border-radius: 999px; line-height: 1;
      white-space: nowrap;
    }
    .badge-success { background: #ecfdf5; color: #059669; }
    .badge-warning { background: #fffbeb; color: #d97706; }
    .badge-danger  { background: #fef2f2; color: #dc2626; }
    .badge-info    { background: #eff6ff; color: #2563eb; }
    .badge-neutral { background: #f1f5f9; color: #64748b; }
    .dark .badge-success { background: rgb(5 150 105/.15); color: #34d399; }
    .dark .badge-warning { background: rgb(217 119 6/.15);  color: #fbbf24; }
    .dark .badge-danger  { background: rgb(220 38 38/.15);  color: #f87171; }
    .dark .badge-info    { background: rgb(37 99 235/.15);  color: #60a5fa; }
    .dark .badge-neutral { background: rgb(100 116 139/.2); color: #cbd5e1; }

    /* ── Icon-Kachel (ersetzt Emoji-Icons in modernisierten Bereichen) ── */
    .icon-tile {
      display: inline-flex; align-items: center; justify-content: center;
      width: 2.5rem; height: 2.5rem; border-radius: var(--radius);
      flex-shrink: 0;
    }
    .icon-tile svg { width: 1.25rem; height: 1.25rem; }

    /* ── Sidebar ────────────────────────────────────────────────────── */
    #sidebar {
      background-color: var(--sidebar-bg) !important;
    }
    #sidebar a {
      color: var(--sidebar-text) !important;
      transition: background .15s, color .15s, padding-left .15s;
    }
    #sidebar a:hover {
      background-color: var(--sidebar-hover) !important;
      color: #fff !important;
    }
    #sidebar a.active {
      background-color: var(--primary) !important;
      color: #fff !important;
    }
    .md\:hidden.bg-slate-900 { background-color: var(--sidebar-bg) !important; }

    /* ── Cards ──────────────────────────────────────────────────────── */
    .card {
      background: #fff;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      border: 1px solid var(--border-soft);
      transition: box-shadow .25s cubic-bezier(.4,0,.2,1), transform .25s cubic-bezier(.4,0,.2,1), border-color .2s;
    }
    .dark .card {
      background: #1e293b;
      border-color: #334155;
    }
    .card:hover {
      box-shadow: var(--shadow-card-hover);
    }
    /* Lift-Effekt für interaktive Karten (KPI, Listen) */
    .card-lift:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 28px -6px rgb(15 23 42 / .12), 0 4px 12px -4px rgb(15 23 42 / .08);
    }
    .dark .card-lift:hover {
      box-shadow: 0 12px 28px -6px rgb(0 0 0 / .35);
    }
    /* Glassmorphism-Variante */
    .card-glass {
      background: rgba(255,255,255,.72);
      backdrop-filter: blur(16px) saturate(1.4);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      border: 1px solid rgba(255,255,255,.35);
    }
    .dark .card-glass {
      background: rgba(30,41,59,.75);
      border-color: rgba(255,255,255,.08);
    }

    /* ── Buttons ────────────────────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-weight: 600;
      font-size: .8125rem;
      line-height: 1;
      padding: .55rem 1rem;
      border-radius: .7rem;
      cursor: pointer;
      transition: filter .15s, transform .1s, box-shadow .15s;
      border: none;
    }
    .btn:active { transform: scale(.97); }
    /* Größere Tippflächen auf Mobile (v.a. kleine Icon-Buttons in Tabellen/Listen,
       wichtig auf der Baustelle / mit Handschuhen) */
    @media (max-width: 767px) {
      .btn { min-height: 44px; }
      table .btn, td .btn, .card-clean table button.btn {
        min-height: 40px;
        min-width: 40px;
        padding: .5rem .75rem;
      }
    }
    .btn-primary {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 2px 8px color-mix(in srgb, var(--primary) 40%, transparent);
    }
    .btn-primary:hover { filter: brightness(1.1); }
    .btn-ghost {
      background: transparent;
      color: #64748b;
      border: 1.5px solid #e2e8f0;
    }
    .btn-ghost:hover { background: #f8fafc; color: #1e293b; }
    .dark .btn-ghost { border-color: #334155; color: #94a3b8; }
    .dark .btn-ghost:hover { background: #1e293b; color: #e2e8f0; }

    /* ── Inputs ─────────────────────────────────────────────────────── */
    .input {
      width: 100%;
      padding: .55rem .85rem;
      border: 1.5px solid #e2e8f0;
      border-radius: .7rem;
      font-size: .875rem;
      background: #fff;
      color: #1e293b;
      outline: none;
      transition: border-color .15s, box-shadow .15s;
    }
    .input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 20%, transparent);
    }
    .dark .input {
      background: #0f172a;
      border-color: #334155;
      color: #e2e8f0;
    }
    .dark .input:focus {
      border-color: var(--primary);
    }

    /* ── Badge ──────────────────────────────────────────────────────── */
    .badge {
      display: inline-flex;
      align-items: center;
      font-size: .6875rem;
      font-weight: 600;
      padding: .2rem .55rem;
      border-radius: 99px;
      white-space: nowrap;
    }

    /* ── Page layout ────────────────────────────────────────────────── */
    .page-bg { background-color: var(--page-bg); }
    .dark .page-bg { background-color: #0f172a; }

    /* ── Scrollbar ──────────────────────────────────────────────────── */
    ::-webkit-scrollbar       { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
    .dark ::-webkit-scrollbar-thumb { background: #334155; }

    /* ── Smooth transitions ─────────────────────────────────────────── */
    html { scroll-behavior: smooth; }
    * { -webkit-tap-highlight-color: transparent; }
    /* Sanfter Dark-Mode-Übergang */
    html.dark, html.dark body, html.dark .card, html.dark .page-bg,
    html.dark main, html.dark #sidebar, html.dark #bottom-nav {
      transition: background-color .3s ease, color .25s ease, border-color .25s ease;
    }

    /* ── Focus-visible (Tastatur & Barrierefreiheit) ───────────────── */
    :focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
      border-radius: 6px;
    }
    button:focus:not(:focus-visible),
    a:focus:not(:focus-visible) { outline: none; }

    /* ── Skeleton Loading ───────────────────────────────────────────── */
    .skeleton {
      background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 50%, #e2e8f0 75%);
      background-size: 200% 100%;
      animation: skeleton-shimmer 1.4s ease-in-out infinite;
      border-radius: .5rem;
      color: transparent !important;
      pointer-events: none;
      user-select: none;
    }
    .dark .skeleton {
      background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
      background-size: 200% 100%;
    }
    @keyframes skeleton-shimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    .skeleton-text { height: 1em; margin: .25em 0; }
    .skeleton-title { height: 1.6em; width: 60%; }
    .skeleton-num { height: 2.2em; width: 40%; }

    /* ── Empty State ────────────────────────────────────────────────── */
    .empty-state {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 2.5rem 1.5rem; color: #94a3b8;
    }
    .empty-state svg { width: 3rem; height: 3rem; opacity: .45; margin-bottom: 1rem; }
    .empty-state h3 { font-size: 1rem; font-weight: 600; color: #64748b; margin-bottom: .35rem; }
    .dark .empty-state h3 { color: #94a3b8; }
    .empty-state p { font-size: .8125rem; max-width: 280px; }

    /* ── Command Palette ────────────────────────────────────────────── */
    #cmdk-overlay {
      position: fixed; inset: 0; z-index: 9998;
      background: rgba(15,23,42,.55); backdrop-filter: blur(6px);
      display: none; align-items: flex-start; justify-content: center;
      padding-top: 12vh;
    }
    #cmdk-overlay.open { display: flex; }
    #cmdk-box {
      width: min(560px, 92vw);
      background: #fff; border-radius: 1rem;
      box-shadow: 0 25px 50px -12px rgb(0 0 0 / .25);
      overflow: hidden; border: 1px solid #e2e8f0;
      animation: cmdkIn .18s cubic-bezier(.34,1.4,.64,1) both;
    }
    .dark #cmdk-box { background: #1e293b; border-color: #334155; }
    @keyframes cmdkIn {
      from { opacity: 0; transform: scale(.96) translateY(-8px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }
    #cmdk-input {
      width: 100%; border: none; outline: none;
      padding: 1rem 1.15rem; font-size: 1rem;
      background: transparent; color: inherit;
      border-bottom: 1px solid #e2e8f0;
    }
    .dark #cmdk-input { border-color: #334155; }
    #cmdk-list { max-height: 320px; overflow-y: auto; padding: .5rem; }
    .cmdk-item {
      display: flex; align-items: center; gap: .75rem;
      padding: .65rem .85rem; border-radius: .65rem;
      cursor: pointer; font-size: .875rem; font-weight: 500;
      color: #334155; transition: background .12s;
    }
    .dark .cmdk-item { color: #e2e8f0; }
    .cmdk-item:hover, .cmdk-item.active { background: var(--primary-soft); color: var(--primary); }
    .dark .cmdk-item:hover, .dark .cmdk-item.active {
      background: color-mix(in srgb, var(--primary) 18%, transparent);
    }
    .cmdk-item svg { width: 1.15rem; height: 1.15rem; flex-shrink: 0; opacity: .7; }
    .cmdk-hint {
      padding: .5rem 1rem .75rem; font-size: .7rem; color: #94a3b8;
      border-top: 1px solid #e2e8f0; display: flex; gap: 1rem;
    }
    .dark .cmdk-hint { border-color: #334155; }
    .cmdk-hint kbd {
      background: #f1f5f9; border-radius: 4px; padding: 1px 5px;
      font-size: .65rem; font-family: inherit; border: 1px solid #e2e8f0;
    }
    .dark .cmdk-hint kbd { background: #0f172a; border-color: #334155; }

    /* ── Active nav highlight ───────────────────────────────────────── */
    #sidebar a[href] {
      position: relative;
    }
    /* ── Page Transition ────────────────────────────────────────── */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    main { animation: fadeIn .22s ease both; }

    /* ── KPI Zahl Count-up ──────────────────────────────────────────── */
    .count-up { font-variant-numeric: tabular-nums; }

    /* ── Moderne Tabellen ─────────────────────────────────────────────── */
    .table-modern {
      width: 100%; border-collapse: separate; border-spacing: 0;
    }
    .table-modern thead th {
      font-size: .7rem; font-weight: 700; letter-spacing: .04em;
      text-transform: uppercase; color: #94a3b8;
      padding: .75rem 1rem; text-align: left;
      border-bottom: 1px solid var(--border-soft);
      background: #f8fafc; position: sticky; top: 0; z-index: 1;
    }
    .dark .table-modern thead th { background: #0f172a; color: #64748b; }
    .table-modern tbody td {
      padding: .85rem 1rem; font-size: .875rem;
      border-bottom: 1px solid var(--border-soft);
      vertical-align: middle;
    }
    .table-modern tbody tr { transition: background .12s; }
    .table-modern tbody tr:hover { background: #f8fafc; }
    .dark .table-modern tbody tr:hover { background: rgba(255,255,255,.03); }
    .table-modern tbody tr:last-child td { border-bottom: none; }

    /* ── Text-Selection ───────────────────────────────────────────────── */
    ::selection { background: color-mix(in srgb, var(--primary) 28%, transparent); color: inherit; }

    /* ── Live-Pulse (z.B. gestempelt) ─────────────────────────────────── */
    .pulse-dot {
      width: .55rem; height: .55rem; border-radius: 999px;
      background: #22c55e; display: inline-block;
      box-shadow: 0 0 0 0 rgba(34,197,94,.5);
      animation: pulse-ring 1.8s ease-out infinite;
    }
    @keyframes pulse-ring {
      0%   { box-shadow: 0 0 0 0 rgba(34,197,94,.45); }
      70%  { box-shadow: 0 0 0 8px rgba(34,197,94,0); }
      100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
    }

    /* ── Mobile FAB (Schnellaktion) ───────────────────────────────────── */
    #fab-main {
      position: fixed; right: 1rem; bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
      z-index: 46; width: 3.25rem; height: 3.25rem;
      border-radius: 999px; border: none; cursor: pointer;
      background: var(--primary); color: #fff;
      box-shadow: 0 6px 20px color-mix(in srgb, var(--primary) 45%, transparent);
      display: none; align-items: center; justify-content: center;
      transition: transform .15s, box-shadow .15s, filter .15s;
    }
    #fab-main:active { transform: scale(.94); }
    #fab-main:hover { filter: brightness(1.08); }
    @media (max-width: 767px) {
      #fab-main { display: flex; }
    }
    #fab-main svg { width: 1.4rem; height: 1.4rem; }

    /* ── Section Header ───────────────────────────────────────────────── */
    .section-title {
      font-size: .7rem; font-weight: 700; letter-spacing: .06em;
      text-transform: uppercase; color: #94a3b8; margin-bottom: .75rem;
    }

    /* ── Divider ──────────────────────────────────────────────────────── */
    .divider {
      height: 1px; background: var(--border-soft); margin: 1.25rem 0; border: none;
    }

    /* ── Chip / Filter-Pills ───────────────────────────────────────────── */
    .chip {
      display: inline-flex; align-items: center; gap: .35rem;
      padding: .35rem .75rem; border-radius: 999px;
      font-size: .75rem; font-weight: 600;
      background: #f1f5f9; color: #475569;
      border: 1px solid transparent; cursor: pointer;
      transition: background .12s, color .12s, border-color .12s;
    }
    .chip:hover { background: #e2e8f0; }
    .chip.active {
      background: color-mix(in srgb, var(--primary) 12%, transparent);
      color: var(--primary); border-color: color-mix(in srgb, var(--primary) 30%, transparent);
    }
    .dark .chip { background: #1e293b; color: #94a3b8; }
    .dark .chip:hover { background: #334155; }
    .dark .chip.active {
      background: color-mix(in srgb, var(--primary) 18%, transparent);
      color: var(--primary);
    }

    /* ── Status-Dot (klein) ───────────────────────────────────────────── */
    .status-dot {
      width: .5rem; height: .5rem; border-radius: 999px; display: inline-block;
    }
    .status-dot.green  { background: #22c55e; }
    .status-dot.amber  { background: #f59e0b; }
    .status-dot.red    { background: #ef4444; }
    .status-dot.blue   { background: #3b82f6; }
    .status-dot.gray   { background: #94a3b8; }

    /* ── Modal Animation ──────────────────────────────────────────────── */
    .modal-panel {
      animation: modalIn .22s cubic-bezier(.34,1.3,.64,1) both;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(.96) translateY(10px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* ── Page load progress bar ───────────────────────────────────────── */
    #nprogress {
      position: fixed; top: 0; left: 0; right: 0; height: 2.5px; z-index: 99999;
      pointer-events: none; opacity: 0; transition: opacity .2s;
    }
    #nprogress.active { opacity: 1; }
    #nprogress .bar {
      height: 100%; width: 0%;
      background: var(--primary);
      box-shadow: 0 0 8px color-mix(in srgb, var(--primary) 60%, transparent);
      transition: width .35s ease;
    }

    /* ── FAB auf Stempel-Seite ausblenden ─────────────────────────────── */
    body[data-page="timetracking"] #fab-main { display: none !important; }
    body[data-page="chat"] #fab-main { display: none !important; }

    /* ── Tab Navigation ───────────────────────────────────────────────── */
    .tab-nav {
      display: flex; gap: .15rem; border-bottom: 1px solid var(--border-soft);
      overflow-x: auto; -webkit-overflow-scrolling: touch;
    }
    .tab-nav a, .tab-nav button {
      padding: .55rem 1rem; font-size: .8125rem; font-weight: 600;
      border-bottom: 2px solid transparent; margin-bottom: -1px;
      color: #64748b; white-space: nowrap; transition: color .15s, border-color .15s;
      background: none; cursor: pointer; text-decoration: none;
    }
    .tab-nav a:hover, .tab-nav button:hover { color: #1e293b; }
    .dark .tab-nav a:hover, .dark .tab-nav button:hover { color: #e2e8f0; }
    .tab-nav a.active, .tab-nav button.active {
      color: var(--primary); border-bottom-color: var(--primary);
    }

    /* ── Offline banner softer ────────────────────────────────────────── */
    #offline-banner {
      backdrop-filter: blur(8px);
      letter-spacing: .01em;
    }

    /* ── Danger / success button helpers ──────────────────────────────── */
    .btn-danger {
      background: #dc2626; color: #fff;
      box-shadow: 0 2px 8px rgba(220,38,38,.35);
    }
    .btn-danger:hover { filter: brightness(1.08); }
    .btn-success {
      background: #16a34a; color: #fff;
      box-shadow: 0 2px 8px rgba(22,163,74,.35);
    }
    .btn-success:hover { filter: brightness(1.08); }


    /* ── Avatar initials ──────────────────────────────────────────────── */
    .avatar-initials {
      width: 2rem; height: 2rem; border-radius: 999px;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: .75rem; font-weight: 700; flex-shrink: 0;
      background: color-mix(in srgb, var(--primary) 14%, transparent);
      color: var(--primary);
    }

    /* ── Sticky page header optional ──────────────────────────────────── */
    .page-header-sticky {
      position: sticky; top: 3.5rem; z-index: 20;
      background: color-mix(in srgb, var(--page-bg) 92%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding-top: .5rem; padding-bottom: .5rem;
      margin-left: -1rem; margin-right: -1rem;
      padding-left: 1rem; padding-right: 1rem;
    }
    @media (min-width: 768px) {
      .page-header-sticky {
        margin-left: -1.5rem; margin-right: -1.5rem;
        padding-left: 1.5rem; padding-right: 1.5rem;
      }
    }



    /* ── Toast ──────────────────────────────────────────────────── */
    #toast-container {
      position: fixed;
      bottom: 5rem;
      right: 1.25rem;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: .5rem;
      pointer-events: none;
    }
    @media (min-width: 768px) {
      #toast-container { bottom: 1.5rem; }
    }
    .toast {
      display: flex;
      align-items: center;
      gap: .6rem;
      padding: .65rem 1rem;
      border-radius: .75rem;
      font-size: .8125rem;
      font-weight: 500;
      color: #fff;
      box-shadow: 0 4px 20px rgba(0,0,0,.18);
      pointer-events: auto;
      animation: toastIn .25s cubic-bezier(.34,1.56,.64,1) both;
      max-width: 320px;
    }
    .toast.out { animation: toastOut .2s ease forwards; }
    @keyframes toastIn {
      from { opacity:0; transform:translateY(12px) scale(.95); }
