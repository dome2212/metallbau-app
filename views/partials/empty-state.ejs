<!--
  Wiederverwendbarer Leerzustand ("keine Daten").
  Nutzt die App-eigene .empty-state-Klasse (siehe partials/header.ejs <style>),
  statt dass jede View eigene ad-hoc Absätze mit italic/text-center baut.

  Aufruf-Beispiel:
    <%- include('partials/empty-state', {
      icon: 'M3 11l18-5v12L3 14v-3z',   // SVG-Pfad(e), 1:1 aus stroke-Icon
      title: 'Noch keine Nachrichten',
      text: 'Poste die erste Nachricht ans Team.'
    }) %>

  Für Icons mit mehreren <path>-Elementen kann statt "icon" auch
  "iconPaths" (Array von Pfad-Strings) übergeben werden.
-->
<div class="empty-state">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <% if (typeof iconPaths !== 'undefined' && Array.isArray(iconPaths)) { %>
      <% iconPaths.forEach(function(p) { %><path d="<%= p %>"/><% }) %>
    <% } else if (typeof icon !== 'undefined' && icon) { %>
      <path d="<%= icon %>"/>
    <% } else { %>
      <!-- Default: leerer Ordner -->
      <path d="M3 7h5l2 2h11v9a2 2 0 01-2 2H3V7z"/>
    <% } %>
  </svg>
  <% if (typeof title !== 'undefined' && title) { %>
    <h3><%= title %></h3>
  <% } %>
  <% if (typeof text !== 'undefined' && text) { %>
    <p><%= text %></p>
  <% } %>
</div>
