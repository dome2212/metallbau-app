<%
  const tipKey = typeof helpKey !== 'undefined' ? helpKey : '';
  const tipText = (typeof firma !== 'undefined' && firma && tipKey && firma['help_' + tipKey]) ? String(firma['help_' + tipKey]).trim() : '';
%>
<% if (tipText) { %>
<div id="help-tip-<%= tipKey %>" class="help-tip mb-3 rounded-xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950/40 px-3 py-2.5 text-sm text-indigo-900 dark:text-indigo-100 flex gap-3 items-start" data-help-key="<%= tipKey %>" hidden>
  <span class="shrink-0 mt-0.5">💡</span>
  <div class="flex-1 min-w-0"><%= tipText %></div>
  <button type="button" class="shrink-0 text-xs font-semibold text-indigo-600 dark:text-indigo-300 hover:underline" onclick="(function(btn){var el=btn.closest('.help-tip');if(!el)return;try{localStorage.setItem('help_skip_'+el.dataset.helpKey,'1');}catch(e){}el.hidden=true;})(this)">Überspringen</button>
</div>
<script>
(function(){
  var el = document.getElementById('help-tip-<%= tipKey %>');
  if (!el) return;
  try { if (localStorage.getItem('help_skip_<%= tipKey %>') === '1') return; } catch(e) {}
  el.hidden = false;
})();
</script>
<% } %>
