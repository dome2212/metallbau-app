<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 md:ml-72 min-h-screen page-bg dark:bg-slate-900 pt-14 md:pt-0">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6 space-y-6">

    <!-- ── Page Header ──────────────────────────────────────────────────── -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Dashboard</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
          <%= new Date().toLocaleDateString('de-DE', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %>
        </p>
      </div>
      <button onclick="openWidgetConfig()" class="btn btn-ghost">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
        </svg>
        Widgets
      </button>
    </div>

    <!-- ── KPI Cards ─────────────────────────────────────────────────────── -->
    <div id="widget-grid" class="grid grid-cols-2 lg:grid-cols-3 gap-4">

      <!-- Offene Angebote -->
      <div id="w-openOffers" class="widget card p-5 border-0 overflow-hidden relative">
        <div class="absolute top-0 right-0 w-20 h-20 rounded-full -mr-6 -mt-6 opacity-10 bg-amber-400"></div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Offene Angebote</p>
        <p class="text-3xl font-bold text-slate-800 dark:text-slate-100"><%= stats.openOffersCount %></p>
        <% if (canSeeMoney) { %>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 font-medium"><%= stats.openOffersSum %> €</p>
        <% } %>
        <a href="/documents/offers" class="inline-flex items-center gap-1 text-xs font-semibold mt-3 text-amber-600 hover:text-amber-500 transition">
          Zur Übersicht
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-400 to-amber-300 opacity-60 rounded-b-xl"></div>
      </div>

      <!-- Unbezahlte Rechnungen -->
      <div id="w-openInvoices" class="widget card p-5 border-0 overflow-hidden relative">
        <div class="absolute top-0 right-0 w-20 h-20 rounded-full -mr-6 -mt-6 opacity-10 bg-red-400"></div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Unbezahlte Rechnungen</p>
        <p class="text-3xl font-bold text-slate-800 dark:text-slate-100"><%= stats.openInvoicesCount %></p>
        <% if (canSeeMoney) { %>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 font-medium"><%= stats.openInvoicesSum %> €</p>
        <% } %>
        <a href="/documents/invoices" class="inline-flex items-center gap-1 text-xs font-semibold mt-3 text-red-500 hover:text-red-400 transition">
          Zur Übersicht
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-400 to-red-300 opacity-60 rounded-b-xl"></div>
      </div>

      <!-- Kunden Gesamt -->
      <div id="w-customers" class="widget card p-5 border-0 overflow-hidden relative">
        <div class="absolute top-0 right-0 w-20 h-20 rounded-full -mr-6 -mt-6 opacity-10 bg-emerald-400"></div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Kunden Gesamt</p>
        <p class="text-3xl font-bold text-slate-800 dark:text-slate-100"><%= stats.totalCustomers %></p>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">registrierte Kunden</p>
        <a href="/customers" class="inline-flex items-center gap-1 text-xs font-semibold mt-3 text-emerald-600 hover:text-emerald-500 transition">
          Zur Übersicht
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-400 to-emerald-300 opacity-60 rounded-b-xl"></div>
      </div>

      <!-- Aktive Aufträge -->
      <div id="w-activeProjects" class="widget card p-5 border-0 overflow-hidden relative">
        <div class="absolute top-0 right-0 w-20 h-20 rounded-full -mr-6 -mt-6 opacity-10 bg-blue-400"></div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Aktive Aufträge</p>
        <p class="text-3xl font-bold text-slate-800 dark:text-slate-100"><%= stats.activeProjectsCount %></p>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">nicht abgeschlossen</p>
        <a href="/projects" class="inline-flex items-center gap-1 text-xs font-semibold mt-3 text-blue-600 hover:text-blue-500 transition">
          Zur Übersicht
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-500 to-blue-400 opacity-60 rounded-b-xl"></div>
      </div>

      <!-- Fällige Rechnungen -->
      <div id="w-overdueInvoices" class="widget card p-5 border-0 overflow-hidden relative">
        <div class="absolute top-0 right-0 w-20 h-20 rounded-full -mr-6 -mt-6 opacity-10 bg-orange-400"></div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Fällige Rechnungen</p>
        <p class="text-3xl font-bold <%= stats.overdueInvoicesCount > 0 ? 'text-orange-500' : 'text-slate-800 dark:text-slate-100' %>">
          <%= stats.overdueInvoicesCount %>
        </p>
        <% if (canSeeMoney) { %>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 font-medium"><%= stats.overdueInvoicesSum %> € überfällig</p>
        <% } %>
        <a href="/documents/invoices" class="inline-flex items-center gap-1 text-xs font-semibold mt-3 text-orange-500 hover:text-orange-400 transition">
          Zur Übersicht
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-orange-400 to-orange-300 opacity-60 rounded-b-xl"></div>
      </div>

      <!-- Offene Aufgaben -->
      <div id="w-openTasks" class="widget card p-5 border-0 overflow-hidden relative">
        <div class="absolute top-0 right-0 w-20 h-20 rounded-full -mr-6 -mt-6 opacity-10 bg-violet-400"></div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Offene Aufgaben</p>
        <p class="text-3xl font-bold <%= stats.openTasksCount > 0 ? 'text-violet-600' : 'text-slate-800 dark:text-slate-100' %>">
          <%= stats.openTasksCount %>
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">projektübergreifend</p>
        <a href="/projects" class="inline-flex items-center gap-1 text-xs font-semibold mt-3 text-violet-600 hover:text-violet-500 transition">
          Zu Aufträgen
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-violet-500 to-violet-400 opacity-60 rounded-b-xl"></div>
      </div>

    </div>

    <!-- ── Schwarzes Brett ───────────────────────────────────────────────── -->
    <div class="card p-5 md:p-6">
      <div class="flex items-center justify-between mb-5">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-amber-100 dark:bg-amber-900/40 flex items-center justify-center text-lg">📢</div>
          <div>
            <h2 class="text-base font-semibold text-slate-800 dark:text-slate-100">Schwarzes Brett</h2>
            <p class="text-xs text-slate-400">Nachrichten an alle Mitarbeiter</p>
          </div>
        </div>
      </div>

      <form action="/ticker/add" method="POST" class="flex gap-2 mb-5">
        <input type="text" name="message" required maxlength="250"
          placeholder="Nachricht posten… (z.B. Frühschluss heute um 15 Uhr)"
          class="input flex-1">
        <button type="submit" class="btn btn-primary whitespace-nowrap">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
          Senden
        </button>
      </form>

      <% if (tickers && tickers.length > 0) { %>
        <ul class="space-y-2">
          <% tickers.forEach(t => { %>
            <li class="flex items-start justify-between gap-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200/60 dark:border-amber-700/40 rounded-xl px-4 py-3">
              <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-800 dark:text-slate-200 font-medium"><%= t.message %></p>
                <p class="text-[10px] text-slate-400 mt-1">
                  von <strong><%= t.author %></strong> ·
                  <%= new Date(t.created_at).toLocaleString('de-DE', { dateStyle:'short', timeStyle:'short' }) %>
                </p>
              </div>
              <form action="/ticker/delete" method="POST" class="shrink-0">
                <input type="hidden" name="id" value="<%= t.id %>">
                <button type="submit" class="w-7 h-7 flex items-center justify-center rounded-lg text-slate-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition text-lg font-bold leading-none" title="Löschen">×</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-sm text-slate-400 dark:text-slate-500 italic text-center py-4">Noch keine Nachrichten gepostet.</p>
      <% } %>
    </div>

    <!-- ── Letzte Vorgänge ───────────────────────────────────────────────── -->
    <div class="card p-5 md:p-6">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-lg">📄</div>
        <div>
          <h2 class="text-base font-semibold text-slate-800 dark:text-slate-100">Letzte Vorgänge</h2>
          <p class="text-xs text-slate-400">Aktuelle Angebote & Rechnungen</p>
        </div>
      </div>

      <div class="overflow-x-auto -mx-2">
        <table class="w-full text-left text-sm min-w-[580px]">
          <thead>
            <tr class="border-b border-slate-100 dark:border-slate-700">
              <th class="pb-3 px-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">Dokument-Nr.</th>
              <th class="pb-3 px-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">Typ</th>
              <th class="pb-3 px-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">Kunde</th>
              <% if (canSeeMoney) { %><th class="pb-3 px-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">Betrag</th><% } %>
              <th class="pb-3 px-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">Status</th>
              <th class="pb-3 px-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">Aktion</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50 dark:divide-slate-700/50">
            <% recentDocs.forEach(doc => { %>
              <%
                const statusCls = doc.status === 'BEZAHLT'
                  ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400'
                  : doc.status === 'ENTWURF'
                  ? 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300'
                  : 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400';
              %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition">
                <td class="py-3 px-2 font-mono font-semibold text-slate-700 dark:text-slate-300 text-xs"><%= doc.doc_number %></td>
                <td class="py-3 px-2">
                  <span class="badge <%= doc.doc_type === 'OFFER' ? 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400' : 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300' %>">
                    <%= doc.doc_type === 'OFFER' ? 'Angebot' : 'Rechnung' %>
                  </span>
                </td>
                <td class="py-3 px-2 text-slate-600 dark:text-slate-300 text-sm"><%= doc.customer_name %></td>
                <% if (canSeeMoney) { %>
                  <td class="py-3 px-2 text-slate-700 dark:text-slate-300 font-medium text-sm">
                    <%= (doc.total_amount != null ? Number(doc.total_amount) : 0).toLocaleString('de-DE', {style:'currency',currency:'EUR'}) %>
                  </td>
                <% } %>
                <td class="py-3 px-2">
                  <span class="badge <%= statusCls %>"><%= doc.status %></span>
                </td>
                <td class="py-3 px-2">
                  <% if (doc.doc_type === 'OFFER' && doc.status !== 'ANGENOMMEN') { %>
                    <form action="/documents/offers/convert-to-invoice" method="POST" class="inline">
                      <input type="hidden" name="offer_id" value="<%= doc.id %>">
                      <button class="btn btn-primary text-xs py-1.5 px-3">In Rechnung wandeln</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</main>

<!-- ── Widget Config Overlay ──────────────────────────────────────────────── -->
<div id="widget-config-overlay" class="hidden fixed inset-0 z-[900] bg-black/60 backdrop-blur-sm flex items-center justify-center px-4">
  <div class="card w-full max-w-sm p-6 border-0">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-base font-bold text-slate-800 dark:text-slate-100">Widgets konfigurieren</h3>
      <button onclick="closeWidgetConfig()" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition">✕</button>
    </div>
    <p class="text-xs text-slate-400 mb-5">Wähle welche Kacheln sichtbar sein sollen.</p>
    <ul class="space-y-2.5" id="widget-toggle-list">
      <li><label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" class="widget-toggle w-4 h-4 accent-amber-500" data-widget="w-openOffers" checked>
        <span class="text-sm text-slate-700 dark:text-slate-300">Offene Angebote</span>
      </label></li>
      <li><label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" class="widget-toggle w-4 h-4 accent-red-500" data-widget="w-openInvoices" checked>
        <span class="text-sm text-slate-700 dark:text-slate-300">Unbezahlte Rechnungen</span>
      </label></li>
      <li><label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" class="widget-toggle w-4 h-4 accent-emerald-500" data-widget="w-customers" checked>
        <span class="text-sm text-slate-700 dark:text-slate-300">Kunden Gesamt</span>
      </label></li>
      <li><label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" class="widget-toggle w-4 h-4 accent-blue-500" data-widget="w-activeProjects" checked>
        <span class="text-sm text-slate-700 dark:text-slate-300">Aktive Aufträge</span>
      </label></li>
      <li><label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" class="widget-toggle w-4 h-4 accent-orange-500" data-widget="w-overdueInvoices" checked>
        <span class="text-sm text-slate-700 dark:text-slate-300">Fällige Rechnungen</span>
      </label></li>
      <li><label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" class="widget-toggle w-4 h-4 accent-violet-500" data-widget="w-openTasks" checked>
        <span class="text-sm text-slate-700 dark:text-slate-300">Offene Aufgaben / Mängel</span>
      </label></li>
    </ul>
    <div class="flex gap-2 mt-6">
      <button onclick="saveWidgetConfig()" class="btn btn-primary flex-1 justify-center">Speichern</button>
      <button onclick="resetWidgetConfig()" class="btn btn-ghost">Zurücksetzen</button>
    </div>
  </div>
</div>

<script>
  const WIDGET_SETTINGS = <%- JSON.stringify(widgetSettings) %>;
  const ALL_WIDGETS = ['w-openOffers','w-openInvoices','w-customers','w-activeProjects','w-overdueInvoices','w-openTasks'];

  function applyWidgetVisibility(settings) {
    ALL_WIDGETS.forEach(id => {
      const el = document.getElementById(id);
      const visible = settings && id in settings ? settings[id] : true;
      if (el) el.classList.toggle('hidden', !visible);
    });
  }
  function syncCheckboxes(settings) {
    document.querySelectorAll('.widget-toggle').forEach(cb => {
      const id = cb.dataset.widget;
      cb.checked = settings && id in settings ? settings[id] : true;
    });
  }
  function openWidgetConfig() {
    syncCheckboxes(WIDGET_SETTINGS);
    document.getElementById('widget-config-overlay').classList.remove('hidden');
  }
  function closeWidgetConfig() {
    document.getElementById('widget-config-overlay').classList.add('hidden');
  }
  async function saveWidgetConfig() {
    const config = {};
    document.querySelectorAll('.widget-toggle').forEach(cb => { config[cb.dataset.widget] = cb.checked; });
    try {
      await fetch('/api/user-settings', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({settings:config}) });
    } catch(_) {}
    applyWidgetVisibility(config);
    closeWidgetConfig();
  }
  async function resetWidgetConfig() {
    const config = {};
    ALL_WIDGETS.forEach(id => config[id] = true);
    try {
      await fetch('/api/user-settings', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({settings:config}) });
    } catch(_) {}
    applyWidgetVisibility(config);
    syncCheckboxes(config);
  }
  document.getElementById('widget-config-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeWidgetConfig();
  });
  applyWidgetVisibility(WIDGET_SETTINGS);
</script>

</body>
</html>
