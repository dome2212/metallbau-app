<%- include('partials/header') %>
<%- include('partials/sidebar') %>

  <!-- Hauptinhalt mit automatischem linken Abstand auf PCs (md:ml-72) und oberem Abstand für das Handy-Menü -->
  <main class="flex-1 p-4 md:p-6 md:ml-72 bg-gray-100 min-h-screen pt-16 md:pt-6">
    <h1 class="text-xl md:text-2xl font-bold text-gray-800 mb-6">Dashboard – Metallbau Gehrmann</h1>

    <!-- KPI Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-8">
      <div class="bg-white p-5 rounded-lg shadow border-l-4 border-yellow-500">
        <p class="text-sm text-gray-500 font-medium">Offene Angebote</p>
        <p class="text-2xl font-bold text-gray-800"><%= stats.openOffersCount %> (<%= stats.openOffersSum %> €)</p>
      </div>
      <div class="bg-white p-5 rounded-lg shadow border-l-4 border-red-500">
        <p class="text-sm text-gray-500 font-medium">Unbezahlte Rechnungen</p>
        <p class="text-2xl font-bold text-gray-800"><%= stats.openInvoicesCount %> (<%= stats.openInvoicesSum %> €)</p>
      </div>
      <div class="bg-white p-5 rounded-lg shadow border-l-4 border-green-500">
        <p class="text-sm text-gray-500 font-medium">Kunden Gesamt</p>
        <p class="text-2xl font-bold text-gray-800"><%= stats.totalCustomers %></p>
      </div>
    </div>

    <!-- ===================================================== -->
    <!-- FIRMEN-TICKER / SCHWARZES BRETT (Admin-Bereich)       -->
    <!-- ===================================================== -->
    <div class="bg-white rounded-lg shadow p-4 md:p-6 mb-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
          📢 Schwarzes Brett
          <span class="text-xs font-normal bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">Admin</span>
        </h2>
      </div>

      <!-- Neue Nachricht posten -->
      <form action="/ticker/add" method="POST" class="flex gap-2 mb-5">
        <input type="text" name="message" required maxlength="250"
          placeholder="Nachricht an alle Mitarbeiter posten… (z.B. Frühschluss heute um 15 Uhr)"
          class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400">
        <button type="submit"
          class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition whitespace-nowrap">
          📤 Senden
        </button>
      </form>

      <!-- Bestehende Nachrichten -->
      <% if (tickers && tickers.length > 0) { %>
        <ul class="space-y-2">
          <% tickers.forEach(t => { %>
            <li class="flex items-start justify-between gap-3 bg-amber-50 border border-amber-200 rounded-lg px-4 py-3">
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-800"><%= t.message %></p>
                <p class="text-[10px] text-gray-400 mt-1">
                  von <strong><%= t.author %></strong> ·
                  <%= new Date(t.created_at).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' }) %>
                </p>
              </div>
              <form action="/ticker/delete" method="POST" class="shrink-0">
                <input type="hidden" name="id" value="<%= t.id %>">
                <button type="submit" class="text-gray-400 hover:text-red-500 transition text-lg font-bold leading-none" title="Löschen">&times;</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-sm text-gray-400 italic">Noch keine Nachrichten gepostet.</p>
      <% } %>
    </div>

    <!-- Tabellen-Sektion mit Scroll-Container für Handys -->
    <div class="bg-white rounded-lg shadow p-4 md:p-6">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Letzte Vorgänge</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[600px]">
          <thead>
            <tr class="border-b text-sm text-gray-600">
              <th class="py-2">Dokument-Nr.</th>
              <th>Typ</th>
              <th>Kunde</th>
              <th>Betrag (Brutto)</th>
              <th>Status</th>
              <th>Aktion</th>
            </tr>
          </thead>
          <tbody class="text-sm divide-y">
            <% recentDocs.forEach(doc => { %>
              <tr>
                <td class="py-3 font-mono font-medium"><%= doc.doc_number %></td>
                <td><%= doc.doc_type === 'OFFER' ? 'Angebot' : 'Rechnung' %></td>
                <td><%= doc.customer_name %></td>
                <td><%= (doc.total_amount != null ? Number(doc.total_amount) : 0).toLocaleString('de-DE', {style:'currency', currency:'EUR'}) %></td>
                <td>
                  <span class="px-2 py-1 text-xs rounded-full 
                    <%= doc.status === 'BEZAHLT' ? 'bg-green-100 text-green-800' : 
                       (doc.status === 'ENTWURF' ? 'bg-gray-100 text-gray-800' : 'bg-yellow-100 text-yellow-800') %>">
                    <%= doc.status %>
                  </span>
                </td>
                <td>
                  <% if (doc.doc_type === 'OFFER' && doc.status !== 'ANGENOMMEN') { %>
                    <form action="/documents/offers/convert-to-invoice" method="POST" class="inline">
                        <input type="hidden" name="offer_id" value="<%= doc.id %>">
                        <button class="bg-blue-600 hover:bg-blue-700 text-white text-xs px-2 py-1 rounded">
                          In Rechnung wandeln
                        </button>
                      </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
