<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 min-h-screen page-bg dark:bg-slate-900 pt-14">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-4 space-y-5 pb-24">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100">Wochenplan</h1>
        <p class="text-xs text-slate-500 mt-0.5"><%= weekLabel %><% if (canEdit) { %> · Zelle tippen · mehrere Baustellen + Uhrzeiten möglich<% } %></p>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <a href="/montageplan?week=<%= prevWeek %>" class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-600 text-sm hover:bg-slate-50 dark:hover:bg-slate-800">‹</a>
        <a href="/montageplan" class="px-3 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold">Heute</a>
        <a href="/montageplan?week=<%= nextWeek %>" class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-600 text-sm hover:bg-slate-50 dark:hover:bg-slate-800">›</a>
        <form method="get" action="/montageplan" class="flex items-center">
          <input type="date" name="week" value="<%= selectedDate %>" aria-label="Datum"
            onchange="if(this.value) this.form.submit()"
            class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 text-sm">
        </form>
        <a href="/calendar" class="px-3 py-2 rounded-lg text-sm text-slate-500 hover:underline">Kalender</a>
      </div>
    </div>

    <div class="flex flex-wrap gap-1.5 text-[11px] items-center">
      <span class="font-semibold text-slate-400">Legende:</span>
      <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200">Baustelle</span>
      <span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-200">Termin</span>
      <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200">Urlaub</span>
      <span class="px-2 py-0.5 rounded-full bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-200">Krank</span>
      <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300">Frei</span>
    </div>

    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
        <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">Mitarbeiter · Woche</h2>
        <span class="text-[11px] text-slate-400"><%= (matrix || []).length %> Personen</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs min-w-[780px]">
          <thead>
            <tr class="bg-slate-50 dark:bg-slate-800/80 border-b border-slate-100 dark:border-slate-700">
              <th class="px-3 py-2.5 text-left font-semibold text-slate-500 w-32 sticky left-0 bg-slate-50 dark:bg-slate-800 z-10">Mitarbeiter</th>
              <% (days || []).forEach(function(day) {
                  const w = day.weather;
                  let wCls = 'text-slate-400';
                  if (w && w.warningLevel === 'danger') wCls = 'text-red-600 dark:text-red-400';
                  else if (w && w.warningLevel === 'warn') wCls = 'text-amber-600 dark:text-amber-400';
                %>
                <th class="px-1.5 py-2.5 text-center font-semibold min-w-[6.5rem] <%= day.isToday ? 'text-blue-600 bg-blue-50 dark:bg-blue-900/20' : 'text-slate-500' %>">
                  <%= (day.shortLabel || day.label || '').split(',')[0] || (day.label || '').split(' ')[0] %><br>
                  <span class="font-normal text-[10px]"><%= day.date.slice(8,10) %>.<%= day.date.slice(5,7) %>.</span>
                  <% if (w) { %>
                    <div class="mt-0.5 text-[10px] font-normal <%= wCls %>" title="<%= w.weatherText %> · Böen <%= w.windgusts %> km/h · <%= w.precipitation %> mm">
                      <%= w.icon || '🌤️' %> <% if (w.warningLevel === 'danger') { %>⚠️<% } else if (w.warningLevel === 'warn') { %>⚡<% } %>
                      <span class="opacity-80"><%= w.windgusts %>km/h</span>
                    </div>
                  <% } %>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
            <% (matrix || []).forEach(function(row) { %>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
                <td class="px-3 py-2 sticky left-0 bg-white dark:bg-slate-800 z-10">
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center text-[11px] font-bold shrink-0">
                      <%= (row.user.username || '?').charAt(0).toUpperCase() %>
                    </div>
                    <div class="min-w-0">
                      <p class="font-semibold text-slate-800 dark:text-slate-100 truncate max-w-[7rem]"><%= row.user.username %></p>
                      <p class="text-[10px] text-slate-400"><%= row.user.role === 'CHEF' ? 'Chef' : row.user.role === 'ADMIN' ? 'Admin' : 'MA' %></p>
                    </div>
                  </div>
                </td>
                <% (row.cells || []).forEach(function(cell, ci) {
                     const day = days[ci];
                     let boxCls = 'bg-slate-50 dark:bg-slate-800/50 border-slate-100 dark:border-slate-700';
                     if (cell.status === 'baustelle' || cell.status === 'notiz') boxCls = 'bg-emerald-50 dark:bg-emerald-900/25 border-emerald-100 dark:border-emerald-800';
                     if (cell.status === 'termin') boxCls = 'bg-blue-50 dark:bg-blue-900/25 border-blue-100 dark:border-blue-800';
                     if (cell.status === 'krank') boxCls = 'bg-red-50 dark:bg-red-900/25 border-red-100 dark:border-red-800';
                     if (cell.status === 'urlaub') boxCls = 'bg-amber-50 dark:bg-amber-900/25 border-amber-100 dark:border-amber-800';
                     if (day && day.isToday) boxCls += ' ring-1 ring-blue-300 dark:ring-blue-700';
                     const labels = (cell.labels && cell.labels.length) ? cell.labels : (cell.label && cell.label !== '—' && cell.label !== 'Frei / Werkstatt' ? [cell.label] : []);
                     const projectsJson = JSON.stringify(cell.projects || []).replace(/"/g, '&quot;');
                %>
                  <td class="p-1 align-top">
                    <% if (canEdit && cell.status !== 'urlaub' && cell.status !== 'krank') { %>
                      <button type="button"
                        class="w-full min-h-[3.25rem] rounded-lg border px-1.5 py-1 text-left transition hover:shadow-sm <%= boxCls %>"
                        data-uid="<%= row.user.id %>"
                        data-date="<%= day.date %>"
                        data-uname="<%= encodeURIComponent(row.user.username || '') %>"
                        data-projects="<%= projectsJson %>"
                        data-note="<%= encodeURIComponent(cell.note || '') %>"
                        onclick="openCellEl(this)">
                        <% if (labels.length) { %>
                          <div class="space-y-0.5">
                            <% labels.forEach(function(lb) { %>
                              <span class="block truncate text-[10px] font-semibold text-emerald-800 dark:text-emerald-200 leading-tight"><%= lb %></span>
                            <% }); %>
                            <% if (cell.note) { %><span class="block truncate text-[9px] text-slate-500 italic"><%= cell.note %></span><% } %>
                          </div>
                        <% } else { %>
                          <span class="text-[10px] text-slate-400">—</span>
                        <% } %>
                      </button>
                    <% } else { %>
                      <div class="w-full min-h-[3.25rem] rounded-lg border px-1.5 py-1 <%= boxCls %>">
                        <% if (labels.length) { %>
                          <div class="space-y-0.5">
                            <% labels.forEach(function(lb) { %>
                              <span class="block truncate text-[10px] font-semibold leading-tight
                                <%= cell.status === 'krank' ? 'text-red-800 dark:text-red-200' : cell.status === 'urlaub' ? 'text-amber-800 dark:text-amber-200' : cell.status === 'termin' ? 'text-blue-800 dark:text-blue-200' : 'text-emerald-800 dark:text-emerald-200' %>"><%= lb %></span>
                            <% }); %>
                          </div>
                        <% } else { %>
                          <span class="text-[10px] text-slate-400">—</span>
                        <% } %>
                      </div>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="space-y-3">
      <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">Baustellen pro Tag</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
        <% (days || []).forEach(function(day) { %>
          <div class="rounded-xl border <%= day.isToday ? 'border-blue-300 dark:border-blue-600 ring-1 ring-blue-100 dark:ring-blue-900' : 'border-slate-200 dark:border-slate-700' %> bg-white dark:bg-slate-800 shadow-sm overflow-hidden">
            <div class="px-3 py-2 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between gap-2 <%= day.isToday ? 'bg-blue-50 dark:bg-blue-900/30' : 'bg-slate-50 dark:bg-slate-800/80' %>">
              <span class="text-xs font-bold <%= day.isToday ? 'text-blue-700 dark:text-blue-300' : 'text-slate-700 dark:text-slate-200' %>"><%= day.label %></span>
              <div class="flex items-center gap-1 shrink-0">
                <% if (day.isToday) { %><span class="text-[10px] font-semibold text-blue-600 bg-blue-100 dark:bg-blue-800 dark:text-blue-200 px-1.5 py-0.5 rounded">Heute</span><% } %>
                <% if (day.weather) {
                     const w = day.weather;
                     let badge = 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300';
                     if (w.warningLevel === 'danger') badge = 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-200';
                     else if (w.warningLevel === 'warn') badge = 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-200';
                %>
                  <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded <%= badge %>"
                    title="<%= w.weatherText %> · Wind <%= w.windspeed %> · Böen <%= w.windgusts %> km/h · Regen <%= w.precipitation %> mm">
                    <%= w.icon || '🌤️' %> <%= w.weatherText %><% if (w.windgusts) { %> · <%= w.windgusts %> km/h<% } %>
                  </span>
                <% } %>
              </div>
            </div>
            <div class="p-3 space-y-2 min-h-[4rem]">
              <% if (day.weather && (day.weather.warningLevel === 'warn' || day.weather.warningLevel === 'danger')) { %>
                <div class="rounded-lg px-2.5 py-2 text-xs <%= day.weather.warningLevel === 'danger' ? 'bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200' : 'bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 text-amber-900 dark:text-amber-200' %>">
                  <strong><%= day.weather.warningLevel === 'danger' ? '⚠️ Montage kritisch' : '⚡ Wetterhinweis' %></strong>
                  – <%= day.weather.weatherText %>,
                  Böen <%= day.weather.windgusts %> km/h<% if (day.weather.precipitation) { %>, Regen <%= day.weather.precipitation %> mm<% } %>
                </div>
              <% } %>
              <% if ((day.sites || []).length === 0 && (day.apps || []).length === 0) { %>
                <p class="text-xs text-slate-400 italic">Keine Baustelle / Termin</p>
              <% } %>

              <% (day.sites || []).forEach(function(site) { %>
                <div class="rounded-lg bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-100 dark:border-emerald-800 px-2.5 py-2">
                  <p class="text-xs font-bold text-emerald-900 dark:text-emerald-100 leading-snug">
                    <%= site.title %><% if (site.time) { %> <span class="font-semibold text-emerald-700 dark:text-emerald-300"><%= site.time %></span><% } %>
                  </p>
                  <p class="text-[11px] text-emerald-700 dark:text-emerald-300 mt-0.5">
                    <%= (site.people || []).join(', ') || '—' %>
                  </p>
                </div>
              <% }); %>

              <% (day.apps || []).forEach(function(app) { %>
                <div class="rounded-lg bg-blue-50 dark:bg-blue-900/30 border border-blue-100 dark:border-blue-800 px-2.5 py-2">
                  <p class="text-xs font-bold text-blue-900 dark:text-blue-100 leading-snug"><%= app.title || app.project_name || 'Termin' %></p>
                  <% if ((app.assignees || []).length) { %>
                    <p class="text-[11px] text-blue-700 dark:text-blue-300 mt-0.5"><%= app.assignees.map(function(a){ return a.username; }).join(', ') %></p>
                  <% } %>
                </div>
              <% }); %>

              <%
                const abwesend = (day.personal || []).filter(function(p){ return p.status === 'urlaub' || p.status === 'krank'; });
              %>
              <% if (abwesend.length) { %>
                <div class="pt-1 border-t border-slate-100 dark:border-slate-700">
                  <p class="text-[10px] uppercase font-semibold text-slate-400 mb-1">Abwesend</p>
                  <div class="flex flex-wrap gap-1">
                    <% abwesend.forEach(function(p) { %>
                      <span class="text-[10px] px-1.5 py-0.5 rounded <%= p.status === 'krank' ? 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-200' : 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-200' %>">
                        <%= p.user.username %> · <%= p.label %>
                      </span>
                    <% }); %>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

  </div>
</main>

<% if (canEdit) { %>
<div id="cell-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/40 p-0 sm:p-4">
  <div class="bg-white dark:bg-slate-800 w-full sm:max-w-md rounded-t-2xl sm:rounded-2xl shadow-xl p-5 space-y-4 max-h-[90vh] overflow-y-auto">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h3 id="modal-title" class="text-base font-bold text-slate-800 dark:text-slate-100">Mitarbeiter</h3>
        <p id="modal-sub" class="text-xs text-slate-500 mt-0.5"></p>
      </div>
      <button type="button" onclick="closeCell()" class="text-slate-400 text-xl leading-none px-2">×</button>
    </div>

    <div>
      <label class="text-[10px] uppercase font-semibold text-slate-400">Baustellen / Aufträge <span class="font-normal normal-case">(mehrere + Uhrzeit)</span></label>
      <div id="modal-projects" class="mt-1.5 max-h-64 overflow-y-auto rounded-xl border border-slate-200 dark:border-slate-600 divide-y divide-slate-100 dark:divide-slate-700">
        <% (projects || []).forEach(function(p) { %>
          <div class="px-3 py-2.5 hover:bg-slate-50 dark:hover:bg-slate-700/40" data-proj-row="<%= p.id %>">
            <label class="flex items-center gap-2.5 cursor-pointer">
              <input type="checkbox" class="modal-proj-cb rounded border-slate-300 text-blue-600 focus:ring-blue-500" value="<%= p.id %>" onchange="toggleTimeRow(this)">
              <span class="text-sm text-slate-800 dark:text-slate-100 flex-1"><%= p.title || ('#' + p.id) %></span>
            </label>
            <div class="modal-time-row hidden mt-2 ml-7 flex items-center gap-2">
              <input type="time" class="modal-start text-xs rounded-lg border border-slate-200 dark:border-slate-600 dark:bg-slate-900 px-2 py-1.5 w-[5.5rem]" title="Von">
              <span class="text-slate-400 text-xs">–</span>
              <input type="time" class="modal-end text-xs rounded-lg border border-slate-200 dark:border-slate-600 dark:bg-slate-900 px-2 py-1.5 w-[5.5rem]" title="Bis">
            </div>
          </div>
        <% }); %>
        <% if (!(projects || []).length) { %>
          <p class="px-3 py-3 text-xs text-slate-400">Keine offenen Aufträge vorhanden.</p>
        <% } %>
      </div>
    </div>

    <div>
      <label class="text-[10px] uppercase font-semibold text-slate-400">Notiz (optional)</label>
      <input id="modal-note" type="text" class="mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-600 dark:bg-slate-900 text-sm px-3 py-2.5" placeholder="z.B. Anfahrt, Material…">
    </div>

    <div class="flex gap-2 pt-1">
      <button type="button" onclick="clearCell()" class="flex-1 px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-600 text-sm font-semibold text-slate-600 dark:text-slate-300">Leeren</button>
      <button type="button" id="modal-save-btn" onclick="saveCell()" class="flex-1 px-3 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-bold">Speichern</button>
    </div>
  </div>
</div>

<script>
let _uid = null, _date = null;

function toggleTimeRow(cb) {
  const row = cb.closest('[data-proj-row]');
  const timeRow = row && row.querySelector('.modal-time-row');
  if (!timeRow) return;
  if (cb.checked) timeRow.classList.remove('hidden');
  else {
    timeRow.classList.add('hidden');
    const s = timeRow.querySelector('.modal-start');
    const e = timeRow.querySelector('.modal-end');
    if (s) s.value = '';
    if (e) e.value = '';
  }
}

function openCellEl(el) {
  _uid = el.dataset.uid;
  _date = el.dataset.date;
  const uname = decodeURIComponent(el.dataset.uname || '');
  const note = decodeURIComponent(el.dataset.note || '');
  let selected = [];
  try { selected = JSON.parse((el.dataset.projects || '[]').replace(/&quot;/g, '"')); } catch (_) { selected = []; }
  if (!Array.isArray(selected)) selected = [];

  const dateObj = new Date(_date + 'T12:00:00');
  document.getElementById('modal-title').textContent = uname;
  document.getElementById('modal-sub').textContent = dateObj.toLocaleDateString('de-DE', { weekday: 'long', day: 'numeric', month: 'long' });
  document.getElementById('modal-note').value = note;

  const byId = {};
  selected.forEach(function(p) {
    if (p && p.id != null) byId[String(p.id)] = p;
  });

  document.querySelectorAll('[data-proj-row]').forEach(function(row) {
    const pid = String(row.getAttribute('data-proj-row'));
    const cb = row.querySelector('.modal-proj-cb');
    const timeRow = row.querySelector('.modal-time-row');
    const start = row.querySelector('.modal-start');
    const end = row.querySelector('.modal-end');
    const hit = byId[pid];
    if (cb) cb.checked = !!hit;
    if (timeRow) {
      if (hit) {
        timeRow.classList.remove('hidden');
        if (start) start.value = hit.start_time ? String(hit.start_time).slice(0, 5) : '';
        if (end) end.value = hit.end_time ? String(hit.end_time).slice(0, 5) : '';
      } else {
        timeRow.classList.add('hidden');
        if (start) start.value = '';
        if (end) end.value = '';
      }
    }
  });

  document.getElementById('cell-modal').classList.remove('hidden');
}

function closeCell() {
  document.getElementById('cell-modal').classList.add('hidden');
}

function collectAssignments() {
  const out = [];
  document.querySelectorAll('[data-proj-row]').forEach(function(row) {
    const cb = row.querySelector('.modal-proj-cb');
    if (!cb || !cb.checked) return;
    const start = row.querySelector('.modal-start');
    const end = row.querySelector('.modal-end');
    out.push({
      project_id: cb.value,
      start_time: start ? start.value : '',
      end_time: end ? end.value : ''
    });
  });
  return out;
}

async function saveCell(opts) {
  opts = opts || {};
  const btn = document.getElementById('modal-save-btn');
  const clearBtn = document.querySelector('#cell-modal button[onclick="clearCell()"]');
  const assignments = opts.clear ? [] : collectAssignments();
  const note = opts.clear ? '' : document.getElementById('modal-note').value.trim();
  if (btn) { btn.disabled = true; btn.textContent = '…'; }
  if (clearBtn) clearBtn.disabled = true;
  try {
    const body = opts.clear
      ? { user_id: _uid, date: _date, clear: true }
      : { user_id: _uid, date: _date, assignments: assignments, note: note };
    const res = await fetch('/admin/staffplan/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    let data = {};
    try { data = await res.json(); } catch (_) {
      data = { ok: false, error: res.status === 403 ? 'Keine Berechtigung (nur Chef/Admin)' : ('HTTP ' + res.status) };
    }
    if (data.ok) {
      if (typeof showToast === 'function') {
        showToast(data.cleared ? 'Gelöscht' : 'Gespeichert', 'success', 1500);
      }
      closeCell();
      setTimeout(function(){ location.reload(); }, 250);
    } else {
      const msg = data.error || 'Fehler beim Speichern';
      if (typeof showToast === 'function') showToast(msg, 'error');
      else alert(msg);
    }
  } catch (e) {
    if (typeof showToast === 'function') showToast('Netzwerkfehler: ' + e.message, 'error');
    else alert('Netzwerkfehler: ' + e.message);
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Speichern'; }
    if (clearBtn) clearBtn.disabled = false;
  }
}

async function clearCell() {
  if (!confirm('Alle Baustellen für diesen Tag wirklich löschen?')) return;
  document.querySelectorAll('.modal-proj-cb').forEach(function(cb) {
    cb.checked = false;
    if (typeof toggleTimeRow === 'function') toggleTimeRow(cb);
  });
  const noteEl = document.getElementById('modal-note');
  if (noteEl) noteEl.value = '';
  await saveCell({ clear: true });
}

document.getElementById('cell-modal')?.addEventListener('click', function(e) {
  if (e.target === this) closeCell();
});
</script>
<% } %>

</body>
</html>
