<%- include('partials/header') %>

<div class="flex h-screen bg-gray-100 dark:bg-gray-900 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-gray-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">
    <!-- Header-Bereich -->
    <div class="px-4 md:px-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">Angebotsverwaltung</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Erstelle und verwalte Angebote für deine Kunden</p>
      </div>
      <div class="flex gap-2 w-full md:w-auto flex-wrap">
        <button onclick="openKiAssistant()" class="flex-1 md:flex-none bg-violet-600 hover:bg-violet-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center gap-2 text-sm justify-center">
          🤖 KI-Assistent
        </button>
        <button type="button" onclick="openKiPositionsModal()"
          class="flex-1 md:flex-none bg-violet-600 hover:bg-violet-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition flex items-center gap-2 justify-center">
          🤖 KI-Positionen vorschlagen
        </button>
        <button onclick="toggleModal('offerModal')" class="flex-1 md:flex-none bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center gap-2 text-sm justify-center">
          + Neues Angebot
        </button>
      </div>
    </div>

    <!-- Angebots-Tabelle -->
    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto pb-6">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[700px]">
            <thead class="bg-gray-50 dark:bg-slate-700 border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
              <tr>
                <th class="p-4">Angebots-Nr.</th>
                <th class="p-4">Datum</th>
                <th class="p-4">Kunde</th>
                <% if (canSeeMoney) { %><th class="p-4">Betrag (Brutto)</th><% } %>
                <th class="p-4">Status</th>
                <th class="p-4 text-right">Aktionen</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof offers !== 'undefined' && offers.length > 0) { %>
                <% offers.forEach(offer => { %>
                  <tr class="border-b dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700 text-sm">
                    <td class="py-3 px-4 font-semibold text-gray-800 dark:text-gray-100">📋 <%= offer.doc_number %></td>
                    <td class="py-3 px-4 text-gray-600 dark:text-gray-400"><%= new Date(offer.created_at).toLocaleDateString('de-DE') %></td>
                    <td class="py-3 px-4 text-gray-800 dark:text-gray-200 font-medium"><%= offer.company_name || offer.contact_person || 'Privat' %></td>
                    <% if (canSeeMoney) { %>
                      <td class="py-3 px-4 text-gray-800 dark:text-gray-200 font-semibold"><%= parseFloat(offer.total_amount || 0).toFixed(2) %> €</td>
                    <% } %>
                    
                    <!-- STATUS ANZEIGE -->
                    <td class="py-3 px-4">
                      <% if (offer.status === 'ANGENOMMEN') { %>
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Angenommen</span>
                      <% } else if (offer.status === 'ABGELEHNT') { %>
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Abgelehnt</span>
                      <% } else { %>
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Offen / Gesendet</span>
                      <% } %>
                    </td>

                    <!-- AKTIONEN -->
                    <td class="py-3 px-4 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <a href="/documents/offers/<%= offer.id %>/pdf"
                          class="px-2.5 py-1 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded text-xs font-medium border border-slate-200 flex items-center gap-1">
                          ⬇️ PDF
                        </a>
                        <% if (offer.status !== 'ANGENOMMEN') { %>
                          <form action="/documents/offers/convert-to-invoice" method="POST" class="inline">
                            <input type="hidden" name="offer_id" value="<%= offer.id %>">
                            <button type="submit" class="px-2.5 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded text-xs font-medium border border-emerald-200 flex items-center gap-1">
                              🔄 In Rechnung
                            </button>
                          </form>
                          <form action="/documents/offers/convert-to-project" method="POST" class="inline"
                            onsubmit="return confirm('Aus diesem Angebot ein neues Projekt anlegen?');">
                            <input type="hidden" name="offer_id" value="<%= offer.id %>">
                            <button type="submit"
                              class="px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded text-xs font-medium border border-indigo-200 flex items-center gap-1">
                              🏗️ In Projekt
                            </button>
                          </form>
                        <% } %>
                        <form action="/documents/offers/delete" method="POST" onsubmit="return confirm('Angebot wirklich löschen?');" class="inline">
                          <input type="hidden" name="offer_id" value="<%= offer.id %>">
                          <button type="submit" class="px-2.5 py-1 bg-gray-100 hover:bg-red-100 text-red-600 rounded text-xs font-medium" title="Löschen">🗑️</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="<%= canSeeMoney ? 6 : 5 %>" class="text-center text-gray-400 dark:text-slate-500 py-8">Keine Angebote vorhanden.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- ================================================ -->
<!-- KI-ASSISTENT MODAL                               -->
<!-- ================================================ -->
<div id="kiAssistantModal" class="hidden fixed inset-0 bg-black bg-opacity-60 flex items-end md:items-center justify-center md:p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-t-2xl md:rounded-xl shadow-xl w-full max-w-5xl flex flex-col overflow-hidden"
       style="height: 92dvh; max-height: 92dvh;">

    <!-- ── Gemeinsamer Header ─────────────────────────────────── -->
    <div class="flex justify-between items-center px-4 py-3 border-b dark:border-slate-700 flex-shrink-0">
      <div>
        <h3 class="text-base font-bold text-slate-800 dark:text-gray-100">🤖 KI-Angebots-Assistent</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">Beschreibe was gebaut werden soll – die KI schlägt Positionen vor</p>
      </div>
      <button onclick="closeKiAssistant()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold leading-none px-1">&times;</button>
    </div>

    <!-- ── Tabs (nur auf Mobil sichtbar) ─────────────────────── -->
    <div class="flex md:hidden border-b dark:border-slate-700 flex-shrink-0">
      <button id="kiTabChat" onclick="kiSwitchTab('chat')"
        class="flex-1 py-2.5 text-sm font-semibold text-violet-600 border-b-2 border-violet-600">
        💬 Chat
      </button>
      <button id="kiTabOffer" onclick="kiSwitchTab('offer')"
        class="flex-1 py-2.5 text-sm font-semibold text-slate-400 border-b-2 border-transparent">
        📋 Angebot <span id="kiTabBadge" class="hidden ml-1 bg-violet-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">0</span>
      </button>
    </div>

    <!-- ── Haupt-Inhalt (Desktop: nebeneinander, Mobil: Tabs) ── -->
    <div class="flex flex-1 min-h-0 overflow-hidden">

      <!-- CHAT-SPALTE -->
      <div id="kiPanelChat" class="flex flex-col flex-1 min-w-0 md:border-r dark:border-slate-700">
        <!-- Chat-Verlauf -->
        <div id="kiChatMessages" class="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-50 dark:bg-slate-900/40">
          <div class="flex gap-3">
            <div class="w-8 h-8 rounded-full bg-violet-600 flex items-center justify-center text-white text-sm flex-shrink-0">🤖</div>
            <div class="bg-white dark:bg-slate-700 rounded-xl px-4 py-3 text-sm text-slate-700 dark:text-gray-200 shadow-sm max-w-sm">
              Hallo! Ich helfe dir beim Erstellen von Angeboten.<br><br>
              Beschreibe einfach, was gebaut oder geliefert werden soll – z.B.:<br>
              <span class="text-violet-600 font-medium italic">„Stahlgeländer 3 Meter, verzinkt, mit Montage"</span><br><br>
              Ich schlage dann passende Positionen vor, die du direkt ins Angebot übernehmen kannst.
            </div>
          </div>
        </div>
        <!-- Eingabefeld -->
        <div class="p-3 border-t dark:border-slate-700 flex-shrink-0 bg-white dark:bg-slate-800">

          <!-- Bildvorschau (wird ausgeblendet wenn kein Bild gewählt) -->
          <div id="kiImagePreviewBox" class="hidden mb-2 flex items-center gap-2 bg-slate-50 dark:bg-slate-700 border dark:border-slate-600 rounded-lg px-3 py-2">
            <img id="kiImagePreview" src="" alt="Vorschau" class="h-14 w-14 object-cover rounded border dark:border-slate-600">
            <div class="flex-1 min-w-0">
              <p id="kiImageName" class="text-xs text-slate-600 dark:text-slate-300 truncate"></p>
              <p class="text-[10px] text-slate-400">Bild wird mit der nächsten Nachricht analysiert</p>
            </div>
            <button type="button" onclick="removeKiImage()" class="text-red-400 hover:text-red-600 font-bold text-lg leading-none px-1" title="Bild entfernen">✕</button>
          </div>

          <div class="flex gap-2">
            <!-- Bild-Upload-Button -->
            <label for="kiImageInput" title="Bild hochladen – KI analysiert automatisch"
              class="flex-shrink-0 cursor-pointer bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 border dark:border-slate-600 text-slate-600 dark:text-slate-300 rounded-lg px-3 py-2 text-lg flex items-center justify-center transition"
              style="min-width:2.6rem">
              📷
            </label>
            <input type="file" id="kiImageInput" accept="image/*" class="hidden" onchange="previewKiImage(this)">

            <textarea id="kiChatInput" rows="2"
              placeholder="z.B. „Stahltreppe 12 Stufen, Geländer beidseitig, pulverbeschichtet RAL 7016""
              class="flex-1 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-3 py-2 resize-none focus:outline-none focus:ring-2 focus:ring-violet-500"></textarea>
            <button id="kiSendBtn" onclick="sendKiMessage()"
              class="bg-violet-600 hover:bg-violet-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition flex-shrink-0">
              Senden ➤
            </button>
          </div>
          <p class="text-[10px] text-slate-400 mt-1 hidden md:block">📷 Bild wählen oder Text eingeben · Strg+Enter = Senden</p>
        </div>
      </div>

      <!-- ANGEBOTS-SPALTE -->
      <div id="kiPanelOffer" class="hidden md:flex flex-col w-full md:w-96 flex-shrink-0">
        <!-- Angebots-Formular (scrollbar) -->
        <div class="flex-1 overflow-y-auto p-4 space-y-4">
          <!-- Kunden-Auswahl -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Kunde *</label>
            <select id="kiCustomerSelect" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-white">
              <option value="">-- Kunde wählen --</option>
              <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.company_name ? c.company_name + ' – ' + c.contact_person : c.contact_person %></option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <!-- Positions-Liste -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Positionen</label>
              <button type="button" onclick="addKiRow()" class="text-xs bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 px-2 py-1 rounded border dark:border-slate-600">
                + Manuell
              </button>
            </div>
            <div id="kiItemsContainer" class="space-y-2">
              <p id="kiEmptyHint" class="text-xs text-slate-400 dark:text-slate-500 italic text-center py-4">
                Noch keine Positionen. Beschreibe im Chat was benötigt wird.
              </p>
            </div>
          </div>

          <!-- Summe -->
          <div class="bg-slate-50 dark:bg-slate-700/50 rounded-lg px-4 py-3 border dark:border-slate-600">
            <div class="flex justify-between items-center text-sm">
              <span class="text-slate-600 dark:text-slate-300">Netto-Summe:</span>
              <span id="kiTotalNet" class="font-semibold text-slate-800 dark:text-gray-100">0,00 €</span>
            </div>
            <div class="flex justify-between items-center text-sm mt-1">
              <span class="text-slate-600 dark:text-slate-300">MwSt. 19%:</span>
              <span id="kiTotalVat" class="text-slate-600 dark:text-slate-400">0,00 €</span>
            </div>
            <div class="flex justify-between items-center font-bold text-base mt-2 pt-2 border-t dark:border-slate-600">
              <span class="text-slate-800 dark:text-gray-100">Gesamt (Brutto):</span>
              <span id="kiTotalGross" class="text-emerald-700 dark:text-emerald-400">0,00 €</span>
            </div>
          </div>
        </div>

        <!-- Speichern-Button -->
        <div class="px-4 py-4 border-t dark:border-slate-700 flex-shrink-0 bg-white dark:bg-slate-800">
          <button onclick="submitKiOffer()"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg text-sm transition">
            💾 Angebot speichern
          </button>
          <button onclick="closeKiAssistant()" class="w-full mt-2 text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 py-1">
            Abbrechen
          </button>
        </div>
      </div>

    </div><!-- end Haupt-Inhalt -->
  </div>
</div>

<!-- ================================================ -->
<!-- STANDARD ANGEBOT MODAL (manuell)                 -->
<!-- ================================================ -->
<div id="offerModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-2xl w-full p-4 md:p-6 max-h-[90vh] flex flex-col">
    <div class="flex justify-between items-center mb-4 border-b dark:border-slate-700 pb-2 flex-shrink-0">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">Neues Angebot anlegen</h3>
      <button onclick="toggleModal('offerModal')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold">&times;</button>
    </div>
    
    <form action="/documents/create-offer" method="POST" class="space-y-4 overflow-y-auto pr-1">
      <div>
        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Kunde auswählen *</label>
        <select name="customer_id" required class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-white">
          <option value="">-- Kunde wählen --</option>
          <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
            <% customers.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.company_name ? c.company_name + ' (' + c.contact_person + ')' : c.contact_person %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- ARTIKEL- & MATERIALSTAMM SCHNELL-EINFÜGEN -->
      <div class="border-t pt-3">
        <label class="block text-xs font-bold text-blue-700 mb-1">📦 Aus Artikelstamm hinzufügen</label>
        <select id="articleSelectOffer" onchange="addArticleToOfferList(this)" class="w-full border border-blue-200 dark:border-blue-700 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-blue-50/50">
          <option value="">-- Artikel/Leistung wählen, um sie als Position anzuhängen --</option>
          <% if (typeof articles !== 'undefined' && articles.length > 0) { %>
            <% articles.forEach(art => { %>
              <option 
                value="<%= art.id %>" 
                data-title="<%= art.title %>" 
                data-unit="<%= art.unit %>" 
                data-price="<%= art.unit_price %>"
                data-desc="<%= art.description || '' %>">
                <%= art.title %> (<%= parseFloat(art.unit_price || 0).toFixed(2) %> € / <%= art.unit %>)
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- DYNAMISCHE POSITIONSLISTE -->
      <div class="border-t pt-3">
        <div class="flex justify-between items-center mb-2">
          <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">Angebotspositionen *</label>
          <button type="button" onclick="addCustomOfferRow()" class="text-xs bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-300 px-2.5 py-1 rounded font-medium border dark:border-slate-600">
            + Eigene Position hinzufügen
          </button>
        </div>
        <div id="offerItemsContainer" class="space-y-3">
          <!-- Dynamische Zeilen werden per JS angehängt -->
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-4 border-t flex-shrink-0">
        <button type="button" onclick="toggleModal('offerModal')" class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Angebot Erstellen</button>
      </div>
    </form>
  </div>
</div>

<script>
// ================================================
// STANDARD ANGEBOT MODAL
// ================================================
function toggleModal(id) {
  const modal = document.getElementById(id);
  modal.classList.toggle('hidden');
  if (!modal.classList.contains('hidden')) {
    const container = document.getElementById('offerItemsContainer');
    if (container && container.children.length === 0) addCustomOfferRow();
  }
}

function addCustomOfferRow(title = '', quantity = 1, unit = 'Stk', price = '') {
  const container = document.getElementById('offerItemsContainer');
  const rowId = 'off_row_' + Date.now() + Math.random().toString(36).substr(2, 4);
  const unitOptions = ['Stk','m','Std','kg','m²','Psch'].map(u =>
    `<option value="${u}" ${u === unit ? 'selected' : ''}>${u}</option>`
  ).join('');
  container.insertAdjacentHTML('beforeend', `
    <div id="${rowId}" class="p-3 bg-gray-50 dark:bg-slate-700 border dark:border-slate-600 rounded-lg space-y-2 relative">
      <div class="flex justify-between items-center">
        <input type="text" name="title" value="${title.replace(/"/g,'&quot;')}" required placeholder="Beschreibung der Leistung" class="w-full border rounded p-2 text-sm bg-white dark:bg-slate-800 dark:border-slate-600 dark:text-gray-100">
        <button type="button" onclick="document.getElementById('${rowId}').remove()" class="ml-2 text-red-500 hover:text-red-700 font-bold px-2 py-1 text-sm">✕</button>
      </div>
      <div class="grid grid-cols-3 gap-2">
        <div>
          <label class="block text-[10px] text-gray-500 uppercase">Menge</label>
          <input type="number" step="0.01" name="quantity" value="${quantity}" required class="w-full border rounded p-1.5 text-sm bg-white dark:bg-slate-800 dark:border-slate-600 dark:text-gray-100">
        </div>
        <div>
          <label class="block text-[10px] text-gray-500 uppercase">Einheit</label>
          <select name="unit" class="w-full border rounded p-1.5 text-sm bg-white dark:bg-slate-800 dark:border-slate-600 dark:text-gray-100">${unitOptions}</select>
        </div>
        <div>
          <label class="block text-[10px] text-gray-500 uppercase">Einzelpreis (€)</label>
          <input type="number" step="0.01" name="price" value="${price}" required placeholder="0.00" class="w-full border rounded p-1.5 text-sm bg-white dark:bg-slate-800 dark:border-slate-600 dark:text-gray-100">
        </div>
      </div>
    </div>
  `);
}

function addArticleToOfferList(selectElement) {
  const opt = selectElement.options[selectElement.selectedIndex];
  if (!opt.value) return;
  const title = opt.getAttribute('data-title');
  const unit  = opt.getAttribute('data-unit');
  const price = opt.getAttribute('data-price');
  const desc  = opt.getAttribute('data-desc');
  addCustomOfferRow(title + (desc ? ' – ' + desc : ''), 1, unit, price);
  selectElement.value = '';
}

function removeOfferRow(rowId) {
  const row = document.getElementById(rowId);
  if (row) row.remove();
}

// ================================================
// KI-ANGEBOTS-ASSISTENT
// ================================================
let kiChatContext = '';

// ── Mobil-Tab-Wechsel ────────────────────────────────────────────────────────
function kiSwitchTab(tab) {
  const panelChat  = document.getElementById('kiPanelChat');
  const panelOffer = document.getElementById('kiPanelOffer');
  const tabChat    = document.getElementById('kiTabChat');
  const tabOffer   = document.getElementById('kiTabOffer');

  if (tab === 'chat') {
    panelChat.classList.remove('hidden');
    panelChat.classList.add('flex');
    panelOffer.classList.remove('flex');
    panelOffer.classList.add('hidden');
    tabChat.classList.add('text-violet-600', 'border-violet-600');
    tabChat.classList.remove('text-slate-400', 'border-transparent');
    tabOffer.classList.remove('text-violet-600', 'border-violet-600');
    tabOffer.classList.add('text-slate-400', 'border-transparent');
  } else {
    panelOffer.classList.remove('hidden');
    panelOffer.classList.add('flex');
    panelChat.classList.remove('flex');
    panelChat.classList.add('hidden');
    tabOffer.classList.add('text-violet-600', 'border-violet-600');
    tabOffer.classList.remove('text-slate-400', 'border-transparent');
    tabChat.classList.remove('text-violet-600', 'border-violet-600');
    tabChat.classList.add('text-slate-400', 'border-transparent');
  }
}

function kiUpdateBadge() {
  const count = document.querySelectorAll('#kiItemsContainer > div').length;
  const badge = document.getElementById('kiTabBadge');
  if (!badge) return;
  badge.textContent = count;
  badge.classList.toggle('hidden', count === 0);
}

function openKiAssistant() {
  document.getElementById('kiAssistantModal').classList.remove('hidden');
  // Mobil: immer mit Chat-Tab starten
  if (window.innerWidth < 768) kiSwitchTab('chat');
}

function closeKiAssistant() {
  document.getElementById('kiAssistantModal').classList.add('hidden');
}

// Strg+Enter sendet
document.addEventListener('DOMContentLoaded', () => {
  const inp = document.getElementById('kiChatInput');
  if (inp) {
    inp.addEventListener('keydown', e => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        sendKiMessage();
      }
    });
  }
});

// ── Bild-Hilfsfunktionen ──────────────────────────────────────────────────────
function previewKiImage(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    document.getElementById('kiImagePreview').src = e.target.result;
    document.getElementById('kiImageName').textContent = file.name;
    document.getElementById('kiImagePreviewBox').classList.remove('hidden');
  };
  reader.readAsDataURL(file);
}

function removeKiImage() {
  document.getElementById('kiImageInput').value = '';
  document.getElementById('kiImagePreview').src = '';
  document.getElementById('kiImageName').textContent = '';
  document.getElementById('kiImagePreviewBox').classList.add('hidden');
}

async function sendKiMessage() {
  const input     = document.getElementById('kiChatInput');
  const sendBtn   = document.getElementById('kiSendBtn');
  const message   = input.value.trim();
  const imageFile = document.getElementById('kiImageInput').files[0];

  // Mindestens Text ODER Bild muss vorhanden sein
  if (!message && !imageFile) return;

  // Benutzer-Bubble
  const displayText = message || '📷 Bild zur Analyse hochgeladen';
  appendChatBubble('user', displayText, false, imageFile);
  input.value = '';
  sendBtn.disabled = true;
  sendBtn.textContent = '…';

  // Lade-Bubble
  const loadId = appendChatBubble('bot', '⏳ Analysiere …', true);

  try {
    let data;

    if (imageFile) {
      // ── Bild-Pfad: multipart/form-data an /api/ai/offer-assistant-image ──
      const formData = new FormData();
      formData.append('image', imageFile);
      if (message) formData.append('message', message);

      const res = await fetch('/api/ai/offer-assistant-image', {
        method: 'POST',
        credentials: 'same-origin',
        body: formData
      });
      data = await res.json();
      if (!res.ok || data.error) {
        removeBubble(loadId);
        appendChatBubble('bot', '❌ Fehler: ' + (data.error || 'Unbekannter Fehler'));
        return;
      }
      removeKiImage(); // Bild nach dem Senden zurücksetzen
    } else {
      // ── Text-Pfad: JSON an /api/ai/offer-assistant ──
      const res = await fetch('/api/ai/offer-assistant', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ message, context: kiChatContext })
      });
      data = await res.json();
      if (!res.ok || data.error) {
        removeBubble(loadId);
        appendChatBubble('bot', '❌ Fehler: ' + (data.error || 'Unbekannter Fehler'));
        return;
      }
    }

    removeBubble(loadId);

    const reply = data.reply;
    kiChatContext += `\nBenutzer: ${displayText}\nAssistent: ${reply}\n`;

    // JSON-Positionen herausparsen
    const positions = parsePositionsFromReply(reply);
    const textOnly  = reply.replace(/POSITIONEN_JSON[:\s]*\[[\s\S]*?\]/g, '').replace(/```[\s\S]*?```/g, '').trim();

    appendChatBubble('bot', textOnly || reply);

    if (positions.length > 0) {
      positions.forEach(p => addKiRow(p.title, p.quantity, p.unit, p.price));
      appendChatBubble('bot', `✅ ${positions.length} Position(en) wurden rechts in die Liste übernommen. Du kannst sie noch anpassen.`);
    }
  } catch (err) {
    removeBubble(loadId);
    appendChatBubble('bot', '❌ Netzwerkfehler: ' + err.message);
  } finally {
    sendBtn.disabled = false;
    sendBtn.innerHTML = 'Senden ➤';
  }
}

function parsePositionsFromReply(text) {
  try {
    // Variante 1: POSITIONEN_JSON: [...] oder POSITIONEN_JSON [...] (mit/ohne Doppelpunkt)
    const m1 = text.match(/POSITIONEN_JSON[^[]*(\[[\s\S]*?\])/);
    if (m1) {
      const arr = JSON.parse(m1[1]);
      if (Array.isArray(arr) && arr.length > 0) return arr;
    }
    // Variante 2: JSON-Array in Codeblock ```json [...] ``` oder ``` [...] ```
    const m2 = text.match(/```(?:json)?\s*(\[[\s\S]*?\])\s*```/);
    if (m2) {
      const arr = JSON.parse(m2[1]);
      if (Array.isArray(arr) && arr.length > 0) return arr;
    }
    // Variante 3: Erstes JSON-Array irgendwo im Text (Fallback)
    const m3 = text.match(/(\[\s*\{[\s\S]*?\}\s*\])/);
    if (m3) {
      const arr = JSON.parse(m3[1]);
      if (Array.isArray(arr) && arr.length > 0) return arr;
    }
    return [];
  } catch (e) {
    return [];
  }
}

function appendChatBubble(role, text, isTemp = false, imageFile = null) {
  const container = document.getElementById('kiChatMessages');
  const id = 'bubble_' + Date.now() + Math.random().toString(36).substr(2, 4);
  const isBot = role === 'bot';

  let imgHtml = '';
  if (imageFile) {
    const objUrl = URL.createObjectURL(imageFile);
    imgHtml = `<img src="${objUrl}" alt="hochgeladenes Bild" class="mt-2 rounded-lg max-h-40 max-w-full object-cover border dark:border-slate-600">`;
  }

  const bubble = `
    <div id="${id}" class="flex gap-3 ${isBot ? '' : 'flex-row-reverse'}">
      <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm flex-shrink-0 ${isBot ? 'bg-violet-600' : 'bg-blue-500'}">
        ${isBot ? '🤖' : '👤'}
      </div>
      <div class="rounded-xl px-4 py-3 text-sm shadow-sm max-w-xs whitespace-pre-wrap ${isBot
        ? 'bg-white dark:bg-slate-700 text-slate-700 dark:text-gray-200'
        : 'bg-blue-600 text-white ml-auto'
      }">${text.replace(/</g,'&lt;').replace(/>/g,'&gt;')}${imgHtml}</div>
    </div>
  `;
  container.insertAdjacentHTML('beforeend', bubble);
  container.scrollTop = container.scrollHeight;
  return id;
}

function removeBubble(id) {
  const el = document.getElementById(id);
  if (el) el.remove();
}

// ── KI-Positions-Liste (rechte Spalte) ──
function addKiRow(title = '', quantity = 1, unit = 'Stk', price = 0) {
  const container = document.getElementById('kiItemsContainer');
  // Hinweis ausblenden
  const hint = document.getElementById('kiEmptyHint');
  if (hint) hint.remove();

  const rowId = 'ki_row_' + Date.now() + Math.random().toString(36).substr(2, 4);
  const unitOptions = ['Stk','m','Std','kg','m²','Psch'].map(u =>
    `<option value="${u}" ${u === unit ? 'selected' : ''}>${u}</option>`
  ).join('');

  container.insertAdjacentHTML('beforeend', `
    <div id="${rowId}" class="bg-white dark:bg-slate-700 border dark:border-slate-600 rounded-lg p-3 space-y-2">
      <div class="flex gap-2">
        <input type="text" value="${String(title).replace(/"/g,'&quot;')}" placeholder="Beschreibung"
          class="ki-title flex-1 text-xs border dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-2 py-1.5 bg-white"
          oninput="updateKiTotal()">
        <button type="button" onclick="document.getElementById('${rowId}').remove(); updateKiTotal();"
          class="text-red-400 hover:text-red-600 font-bold text-sm px-1">✕</button>
      </div>
      <div class="grid grid-cols-3 gap-2">
        <div>
          <label class="block text-[9px] text-slate-400 uppercase mb-0.5">Menge</label>
          <input type="number" step="0.01" value="${quantity}" min="0"
            class="ki-qty w-full text-xs border dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-2 py-1.5 bg-white"
            oninput="updateKiTotal()">
        </div>
        <div>
          <label class="block text-[9px] text-slate-400 uppercase mb-0.5">Einheit</label>
          <select class="ki-unit w-full text-xs border dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-2 py-1.5 bg-white">
            ${unitOptions}
          </select>
        </div>
        <div>
          <label class="block text-[9px] text-slate-400 uppercase mb-0.5">Preis (€)</label>
          <input type="number" step="0.01" value="${price}" min="0"
            class="ki-price w-full text-xs border dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-2 py-1.5 bg-white"
            oninput="updateKiTotal()">
        </div>
      </div>
    </div>
  `);
  updateKiTotal();
  kiUpdateBadge();
  // Auf Mobil: nach KI-Vorschlag automatisch zum Angebot-Tab wechseln
  if (window.innerWidth < 768 && title) {
    setTimeout(() => kiSwitchTab('offer'), 400);
  }
}

function updateKiTotal() {
  const rows = document.querySelectorAll('#kiItemsContainer > div');
  let net = 0;
  rows.forEach(row => {
    const qty   = parseFloat(row.querySelector('.ki-qty')?.value  || 0);
    const price = parseFloat(row.querySelector('.ki-price')?.value || 0);
    net += qty * price;
  });
  const vat   = net * 0.19;
  const gross = net + vat;
  const fmt = v => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  document.getElementById('kiTotalNet').textContent   = fmt(net);
  document.getElementById('kiTotalVat').textContent   = fmt(vat);
  document.getElementById('kiTotalGross').textContent = fmt(gross);
}

async function submitKiOffer() {
  const customerId = document.getElementById('kiCustomerSelect').value;
  if (!customerId) { alert('Bitte zuerst einen Kunden auswählen.'); return; }

  const rows = document.querySelectorAll('#kiItemsContainer > div');
  if (rows.length === 0) { alert('Bitte mindestens eine Position hinzufügen.'); return; }

  // Formular dynamisch aufbauen und absenden
  const form = document.createElement('form');
  form.method = 'POST';
  form.action = '/documents/create-offer';

  const addField = (name, val) => {
    const inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = name; inp.value = val;
    form.appendChild(inp);
  };

  addField('customer_id', customerId);

  rows.forEach(row => {
    addField('title',    row.querySelector('.ki-title')?.value || '');
    addField('quantity', row.querySelector('.ki-qty')?.value   || 1);
    addField('unit',     row.querySelector('.ki-unit')?.value  || 'Stk');
    addField('price',    row.querySelector('.ki-price')?.value || 0);
  });

  document.body.appendChild(form);
  form.submit();
}
</script>

<!-- KI-POSITIONEN MODAL -->
<div id="kiPositionsModal" class="hidden fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl max-w-2xl w-full p-5 flex flex-col gap-4 max-h-[90vh]">
    <div class="flex justify-between items-center border-b dark:border-slate-700 pb-3">
      <h3 class="text-lg font-bold text-slate-800 dark:text-gray-100">🤖 KI-Positionen für Angebot</h3>
      <button onclick="document.getElementById('kiPositionsModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400">Beschreibe kurz den Auftrag – die KI schlägt typische Angebotspositionen für Metallbau vor.</p>
    <textarea id="kiPosDesc" rows="3" placeholder="z.B. Treppengeländer aus Stahl, 12 Stufen, Edelstahlhandlauf, verzinkt und pulverbeschichtet RAL 7016…"
      class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-3 bg-white focus:outline-none focus:ring-2 focus:ring-violet-500 resize-none"></textarea>
    <div id="kiPosLoading" class="hidden flex items-center gap-2 text-sm text-violet-600 font-medium">
      <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/></svg>
      KI generiert Positionen…
    </div>
    <div id="kiPosError" class="hidden bg-red-50 border border-red-200 text-red-700 text-xs rounded px-3 py-2"></div>
    <div id="kiPosResults" class="hidden space-y-2 overflow-y-auto max-h-64"></div>
    <div class="flex gap-2 pt-2 border-t dark:border-slate-700">
      <button onclick="generateKiPositions()"
        class="flex-1 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium py-2 transition">
        🤖 Vorschläge laden
      </button>
      <button id="kiPosAcceptBtn" onclick="acceptKiPositions()" class="hidden flex-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-medium py-2 transition">
        ✅ Übernehmen
      </button>
      <button onclick="document.getElementById('kiPositionsModal').classList.add('hidden')"
        class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition">
        Schließen
      </button>
    </div>
  </div>
</div>
<script>
function openKiPositionsModal() {
  document.getElementById('kiPositionsModal').classList.remove('hidden');
}
async function generateKiPositions() {
  const desc = document.getElementById('kiPosDesc').value.trim();
  if (!desc) return;
  document.getElementById('kiPosLoading').classList.remove('hidden');
  document.getElementById('kiPosError').classList.add('hidden');
  document.getElementById('kiPosResults').classList.add('hidden');
  document.getElementById('kiPosAcceptBtn').classList.add('hidden');
  try {
    const res = await fetch('/api/ai/offer-assistant', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ description: desc })
    });
    const data = await res.json();
    document.getElementById('kiPosLoading').classList.add('hidden');
    if (data.error) throw new Error(data.error);
    const text = data.result || data.text || '';
    const lines = text.split('\n').filter(l => l.trim());
    const container = document.getElementById('kiPosResults');
    container.innerHTML = lines.map((line, i) => `
      <label class="flex items-start gap-2 p-2 rounded border border-slate-200 dark:border-slate-600 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700">
        <input type="checkbox" class="ki-pos-cb mt-0.5 accent-violet-600 w-4 h-4 shrink-0" data-line="${line.replace(/"/g, '&quot;')}" checked>
        <span class="text-sm text-slate-700 dark:text-slate-300">${line}</span>
      </label>`).join('');
    container.classList.remove('hidden');
    document.getElementById('kiPosAcceptBtn').classList.remove('hidden');
  } catch(e) {
    document.getElementById('kiPosLoading').classList.add('hidden');
    const errEl = document.getElementById('kiPosError');
    errEl.textContent = 'Fehler: ' + e.message;
    errEl.classList.remove('hidden');
  }
}
function acceptKiPositions() {
  const selected = [...document.querySelectorAll('.ki-pos-cb:checked')].map(cb => cb.dataset.line);
  // Fill the offer form rows if they exist
  const titleInputs = document.querySelectorAll('input[name="title[]"], input[name="title"]');
  selected.forEach((line, i) => {
    if (titleInputs[i]) titleInputs[i].value = line;
  });
  document.getElementById('kiPositionsModal').classList.add('hidden');
  if (selected.length > 0) {
    alert(selected.length + ' Positionen wurden übernommen.');
  }
}
</script>

