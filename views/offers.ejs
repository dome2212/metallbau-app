<%- include('partials/header') %>

<div class="flex h-screen bg-gray-100 dark:bg-gray-900 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-gray-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">
    <!-- Header-Bereich -->
    <div class="px-4 md:px-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">Angebotsverwaltung</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Erstelle und verwalte Angebote für deine Kunden</p>
      </div>
      <button onclick="toggleModal('offerModal')" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center gap-2 text-sm w-full md:w-auto justify-center">
        <span>+ Neues Angebot erstellen</span>
      </button>
    </div>

    <!-- Angebots-Tabelle -->
    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto pb-6">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[700px]">
            <thead class="bg-gray-50 dark:bg-slate-700 border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
              <tr>
                <th class="p-4">Angebots-Nr.</th>
                <th class="p-4">Datum</th>
                <th class="p-4">Kunde</th>
                <th class="p-4">Betrag (Brutto)</th>
                <th class="p-4">Status</th>
                <th class="p-4 text-right">Aktionen</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof offers !== 'undefined' && offers.length > 0) { %>
                <% offers.forEach(offer => { %>
                  <tr class="border-b dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700 text-sm">
                    <td class="py-3 px-4 font-semibold text-gray-800 dark:text-gray-100">📋 <%= offer.doc_number %></td>
                    <td class="py-3 px-4 text-gray-600 dark:text-gray-400"><%= new Date(offer.created_at).toLocaleDateString('de-DE') %></td>
                    <td class="py-3 px-4 text-gray-800 dark:text-gray-200 font-medium"><%= offer.company_name || offer.contact_person || 'Privat' %></td>
                    <td class="py-3 px-4 text-gray-800 dark:text-gray-200 font-semibold"><%= parseFloat(offer.total_amount || 0).toFixed(2) %> €</td>
                    
                    <!-- STATUS ANZEIGE -->
                    <td class="py-3 px-4">
                      <% if (offer.status === 'ANGENOMMEN') { %>
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Angenommen</span>
                      <% } else if (offer.status === 'ABGELEHNT') { %>
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Abgelehnt</span>
                      <% } else { %>
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Offen / Gesendet</span>
                      <% } %>
                    </td>

                    <!-- AKTIONEN -->
                    <td class="py-3 px-4 text-right">
                      <div class="flex items-center justify-end gap-2">
                        
                        <!-- Button: In Rechnung umwandeln -->
                        <% if (offer.status !== 'ANGENOMMEN') { %>
                          <form action="/documents/offers/convert-to-invoice" method="POST" class="inline">
                            <input type="hidden" name="offer_id" value="<%= offer.id %>">
                            <button type="submit" title="In Rechnung umwandeln" class="px-2.5 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded text-xs font-medium border border-emerald-200 flex items-center gap-1">
                              🔄 In Rechnung
                            </button>
                          </form>
                        <% } %>

                        <!-- Button: Löschen -->
                        <form action="/documents/offers/delete" method="POST" onsubmit="return confirm('Angebot wirklich löschen?');" class="inline">
                          <input type="hidden" name="offer_id" value="<%= offer.id %>">
                          <button type="submit" class="px-2.5 py-1 bg-gray-100 hover:bg-red-100 text-red-600 rounded text-xs font-medium" title="Löschen">🗑️</button>
                        </form>

                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center text-gray-400 dark:text-slate-500 py-8">Keine Angebote vorhanden.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Modal: Neues Angebot anlegen (Mehrere Positionen) -->
<div id="offerModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-2xl w-full p-4 md:p-6 max-h-[90vh] flex flex-col">
    <div class="flex justify-between items-center mb-4 border-b dark:border-slate-700 pb-2 flex-shrink-0">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">Neues Angebot anlegen</h3>
      <button onclick="toggleModal('offerModal')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold">&times;</button>
    </div>
    
    <form action="/documents/create-offer" method="POST" class="space-y-4 overflow-y-auto pr-1">
      <div>
        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Kunde auswählen *</label>
        <select name="customer_id" required class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-white">
          <option value="">-- Kunde wählen --</option>
          <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
            <% customers.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.company_name ? c.company_name + ' (' + c.contact_person + ')' : c.contact_person %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- ARTIKEL- & MATERIALSTAMM SCHNELL-EINFÜGEN -->
      <div class="border-t pt-3">
        <label class="block text-xs font-bold text-blue-700 mb-1">📦 Aus Artikelstamm hinzufügen</label>
        <select id="articleSelectOffer" onchange="addArticleToOfferList(this)" class="w-full border border-blue-200 dark:border-blue-700 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-blue-50/50">
          <option value="">-- Artikel/Leistung wählen, um sie als Position anzuhängen --</option>
          <% if (typeof articles !== 'undefined' && articles.length > 0) { %>
            <% articles.forEach(art => { %>
              <option 
                value="<%= art.id %>" 
                data-title="<%= art.title %>" 
                data-unit="<%= art.unit %>" 
                data-price="<%= art.unit_price %>"
                data-desc="<%= art.description || '' %>">
                <%= art.title %> (<%= parseFloat(art.unit_price || 0).toFixed(2) %> € / <%= art.unit %>)
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- DYNAMISCHE POSITIONSLISTE -->
      <div class="border-t pt-3">
        <div class="flex justify-between items-center mb-2">
          <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">Angebotspositionen *</label>
          <button type="button" onclick="addCustomOfferRow()" class="text-xs bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-300 px-2.5 py-1 rounded font-medium border dark:border-slate-600">
            + Eigene Position hinzufügen
          </button>
        </div>

        <div id="offerItemsContainer" class="space-y-3">
          <!-- Dynamische Zeilen werden per JS angehängt -->
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-4 border-t flex-shrink-0">
        <button type="button" onclick="toggleModal('offerModal')" class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Angebot Erstellen</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleModal(id) {
    const modal = document.getElementById(id);
    modal.classList.toggle('hidden');
    
    // Leere Zeile hinzufügen, wenn Modal geöffnet wird und die Liste leer ist
    if (!modal.classList.contains('hidden')) {
      const container = document.getElementById('offerItemsContainer');
      if (container.children.length === 0) {
        addCustomOfferRow();
      }
    }
  }

  // Neue Angebotszeile hinzufügen
  function addCustomOfferRow(title = '', quantity = 1, unit = 'Stk', price = '') {
    const container = document.getElementById('offerItemsContainer');
    const rowId = 'off_row_' + Date.now() + Math.random().toString(36).substr(2, 4);

    const rowHtml = `
      <div id="${rowId}" class="p-3 bg-gray-50 border rounded-lg space-y-2 relative">
        <div class="flex justify-between items-center">
          <input type="text" name="title" value="${title}" required placeholder="Beschreibung (z.B. Stahlträger HEB 160 / Geländer montieren)" class="w-full border rounded p-2 text-sm bg-white">
          <button type="button" onclick="removeOfferRow('${rowId}')" class="ml-2 text-red-500 hover:text-red-700 font-bold px-2 py-1 text-sm" title="Position entfernen">✕</button>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div>
            <label class="block text-[10px] text-gray-500 uppercase">Menge</label>
            <input type="number" step="0.01" name="quantity" value="${quantity}" required class="w-full border rounded p-1.5 text-sm bg-white">
          </div>
          <div>
            <label class="block text-[10px] text-gray-500 uppercase">Einheit</label>
            <select name="unit" class="w-full border rounded p-1.5 text-sm bg-white">
              <option value="Stk" ${unit === 'Stk' ? 'selected' : ''}>Stk</option>
              <option value="m" ${unit === 'm' ? 'selected' : ''}>m (Meter)</option>
              <option value="Std" ${unit === 'Std' ? 'selected' : ''}>Std (Stunden)</option>
              <option value="kg" ${unit === 'kg' ? 'selected' : ''}>kg</option>
              <option value="m²" ${unit === 'm²' ? 'selected' : ''}>m²</option>
              <option value="Psch" ${unit === 'Psch' ? 'selected' : ''}>Pauschale</option>
            </select>
          </div>
          <div>
            <label class="block text-[10px] text-gray-500 uppercase">Einzelpreis (€)</label>
            <input type="number" step="0.01" name="price" value="${price}" required placeholder="0.00" class="w-full border rounded p-1.5 text-sm bg-white">
          </div>
        </div>
      </div>
    `;

    container.insertAdjacentHTML('beforeend', rowHtml);
  }

  // Artikel aus dem Stammdaten-Dropdown anhängen
  function addArticleToOfferList(selectElement) {
    const selectedOption = selectElement.options[selectElement.selectedIndex];
    if (!selectedOption.value) return;

    const title = selectedOption.getAttribute('data-title');
    const unit = selectedOption.getAttribute('data-unit');
    const price = selectedOption.getAttribute('data-price');
    const desc = selectedOption.getAttribute('data-desc');

    const fullTitle = title + (desc ? ' - ' + desc : '');

    addCustomOfferRow(fullTitle, 1, unit, price);

    // Auswahl zurücksetzen
    selectElement.value = '';
  }

  // Zeile löschen
  function removeOfferRow(rowId) {
    const row = document.getElementById(rowId);
    if (row) {
      row.remove();
    }
  }
</script>

</body>
</html>
