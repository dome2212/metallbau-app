<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<link rel="stylesheet" href="/css/billing.css">
<% const label=type==='angebot'?'Angebot':'Rechnung'; const klein=String(firma.kleinunternehmer).toLowerCase()==='true'; const bootstrap={type,doc,project,items,customers,articles,snippets,taxRate,preCustomer,draftOwner,revision,klein,company:{name:firma.name||firma.nameKurz||'Metallbau',street:firma.strasse||firma.street||'',city:[firma.plz,firma.ort].filter(Boolean).join(' ')},dueDays:parseInt(firma.zahlungsfrist,10)||14}; %>
<main class="flex-1 page-bg min-h-screen pt-16 bill-main"><div class="bill-shell">
 <a class="bill-back" href="<%= doc?detailUrl(doc):'/documents/buero' %>">← <%= doc?'Zurück zum Beleg':'Alle Belege' %></a>
 <header class="bill-heading"><div><span class="bill-eyebrow">BELEGEDITOR</span><h1><%= doc?doc.doc_number:label+' erstellen' %></h1><p>Kunde, Leistungen und Konditionen an einem Ort.</p></div><span class="bill-chip"><%= doc?'Bearbeiten':'Neue Belegnummer beim Speichern' %></span></header>
 <div id="bill-draft" class="bill-alert bill-restore" hidden><span>Ein lokaler Entwurf ist vorhanden.</span><button class="bill-btn bill-small" id="bill-restore" type="button">Wiederherstellen</button><button class="bill-btn bill-small" id="bill-discard" type="button">Verwerfen</button></div>
 <% if(type==='angebot'&&klein){ %><div class="bill-alert bill-warn">Die Firmeneinstellung Kleinunternehmer ist aktiv. Angebote verwenden weiterhin den gespeicherten Steuersatz, das PDF die Firmenbefreiung. Bitte vor Versand Beträge und PDF prüfen.</div><% } %>
 <% if(project){ %><div class="bill-alert">Rechnung zu Auftrag <strong><%= project.title %></strong>. Erfasste Arbeitsstunden sind vorbereitet; bitte Preise ergänzen. Der Auftrag wird beim Speichern als abgeschlossen markiert.</div><% } %>
 <form id="bill-editor" novalidate><div class="bill-editor"><div class="bill-stack">
  <section class="bill-card"><div class="bill-section-head"><h2><span class="bill-section-no">01</span>Empfänger</h2><a class="bill-back" href="/customers" target="_blank" rel="noopener">Kunden verwalten ↗</a></div>
   <label class="bill-field">Kunde auswählen<select id="bill-customer" required <%= project&&project.customer_id?'disabled':'' %>><option value="">Bitte auswählen …</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.company_name||c.contact_person %><%= c.company_name&&c.contact_person?' · '+c.contact_person:'' %></option><% }); %></select></label><p id="bill-address" class="bill-saved-customer"></p>
   <details class="bill-disclosure"><summary>Neuen Kunden anlegen</summary><div class="bill-grid"><label class="bill-field">Firma / Name<input id="bill-new-name" maxlength="200"></label><label class="bill-field">Ansprechpartner<input id="bill-new-person" maxlength="200"></label><label class="bill-field bill-wide">Straße und Hausnummer<input id="bill-new-street" maxlength="200"></label><label class="bill-field">PLZ<input id="bill-new-zip" maxlength="20"></label><label class="bill-field">Ort<input id="bill-new-city" maxlength="200"></label><label class="bill-field bill-wide">E-Mail<input id="bill-new-email" type="email" maxlength="254"></label></div><button class="bill-btn bill-small" id="bill-new-customer" type="button" style="margin-top:14px">Kunden speichern &amp; auswählen</button><p id="bill-customer-error" role="alert" class="bill-warning-text"></p></details>
  </section>
  <section class="bill-card"><div class="bill-section-head"><h2><span class="bill-section-no">02</span>Positionen</h2><span class="bill-muted" id="bill-item-count"></span></div>
   <div class="bill-grid" style="margin-bottom:16px"><label class="bill-field">Artikel übernehmen<select id="bill-article"><option value="">Artikel auswählen …</option><% articles.forEach(a=>{ %><option value="<%= a.id %>"><%= a.title %> · <%= money(a.unit_price) %> / <%= a.unit %></option><% }); %></select></label><label class="bill-field">Textbaustein<select id="bill-snippet"><option value="">Text auswählen …</option><% snippets.forEach((s,i)=>{ %><option value="<%= i %>"><%= s.label||s.text||s %></option><% }); %></select></label></div>
   <div id="bill-items"></div><button type="button" id="bill-add" class="bill-btn">+ Position hinzufügen</button><p class="bill-hint">Positionen mit ↑ / ↓ verschieben oder mit „Kopie“ duplizieren. Preise sind Nettopreise.</p>
   <details class="bill-disclosure"><summary>Leistungen mit KI vorbereiten</summary><label class="bill-field">Auftrag beschreiben<textarea id="bill-ai-text" rows="3" placeholder="z. B. 3 m Geländer fertigen, verzinken und montieren"></textarea></label><button class="bill-btn" type="button" id="bill-ai" style="margin-top:12px">Positionen vorschlagen</button><p class="bill-hint" id="bill-ai-status" role="status">Vorschläge vor dem Speichern fachlich prüfen.</p></details>
  </section>
  <section class="bill-card"><div class="bill-section-head"><h2><span class="bill-section-no">03</span>Konditionen</h2></div><div class="bill-grid">
   <label class="bill-field">Umsatzsteuer (%)<input id="bill-tax" inputmode="decimal" value="<%= taxRate %>" <%= (type==='rechnung'&&klein)||(type==='angebot'&&doc)?'readonly':'' %> required></label>
   <% if(type==='rechnung'){ %><label class="bill-field">Zahlungsziel<input type="date" id="bill-due"></label><label class="bill-field">Rechnungsart<select id="bill-subtype"><option value="">Standardrechnung</option><option value="PARTIAL">Teilrechnung</option><option value="FINAL">Schlussrechnung</option></select></label><% } %>
   <label class="bill-field">Belegrabatt (%)<input id="bill-discount" inputmode="decimal" value="0"></label><label class="bill-field">Alternativ: fester Rabatt (€)<input id="bill-discount-amount" inputmode="decimal" value="0"></label><label class="bill-field bill-wide">Interne Notiz<textarea id="bill-note" rows="2" maxlength="4000" placeholder="Hinweise zur Bearbeitung; erscheint nicht als Leistungstext"></textarea></label>
  </div><p class="bill-hint">Ein prozentualer Belegrabatt hat Vorrang vor dem festen Rabatt.<%= type==='rechnung'&&klein?' Umsatzsteuer ist durch die Firmeneinstellung deaktiviert.':'' %></p></section>
  <div id="bill-error" class="bill-alert bill-error" role="alert" hidden></div>
  <div class="bill-savebar"><small id="bill-draft-status" aria-live="polite">Noch nicht gespeichert</small><div class="bill-actions"><a class="bill-btn" href="<%= doc?detailUrl(doc):'/documents/buero' %>">Abbrechen</a><button class="bill-btn bill-primary" type="submit" id="bill-save"><%= doc?'Änderungen speichern':label+' speichern' %></button></div></div>
 </div><aside class="bill-preview" aria-label="Belegvorschau"><div class="bill-preview-title"><strong>LIVE-VORSCHAU</strong><span>EUR · Netto</span></div><div class="bill-paper" id="bill-preview"></div><p class="bill-preview-note">Inhaltliche Vorschau. Das endgültige Layout mit Logo, Firmendaten und Seitenumbrüchen siehst du nach dem Speichern im PDF.</p></aside></div></form>
</div></main>
<script id="bill-bootstrap" type="application/json"><%- JSON.stringify(bootstrap).replace(/</g,'\\u003c') %></script>
<script src="/js/billing-math.js" defer></script><script src="/js/billing-editor.js" defer></script>
</body></html>
