<%- include('../partials/header') %><%- include('../partials/sidebar') %><link rel="stylesheet" href="/css/billing.css"><link rel="stylesheet" href="/css/workflow.css">
<main class="flex-1 page-bg min-h-screen pt-16 bill-main"><div class="bill-shell"><header class="bill-heading"><div><span class="bill-eyebrow">BÜRO · ZAHLUNGSEINGÄNGE</span><h1>Offene Rechnungen</h1><p>Restbeträge prüfen, Zahlungseingänge buchen und Erinnerungen vorbereiten.</p></div></header><%- include('nav',{active:'receivables'}) %>
<section class="bill-stats"><div class="bill-card"><span>Offener Betrag</span><strong><%= money(invoices.reduce((s,d)=>s+d.open,0)) %></strong><small><%= invoices.length %> ausgestellte Rechnungen</small></div><div class="bill-card"><span>Überfällig</span><strong><%= money(invoices.filter(d=>d.overdue).reduce((s,d)=>s+d.open,0)) %></strong><small><%= invoices.filter(d=>d.overdue).length %> Rechnungen</small></div><div class="bill-card"><span>Noch innerhalb Zahlungsziel</span><strong><%= invoices.filter(d=>!d.overdue&&d.due).length %></strong></div><div class="bill-card"><span>Zahlungsziel fehlt</span><strong><%= invoices.filter(d=>!d.due).length %></strong><small>Fälligkeit im Beleg prüfen</small></div></section>
<section class="bill-card"><div class="bill-filters"><label class="bill-search">Suche<input id="receivables-search" type="search" placeholder="Rechnungsnummer oder Kunde …"></label><label>Fälligkeit<select id="receivables-status"><option value="">Alle offenen Rechnungen</option><option value="overdue">Nur überfällige</option><option value="due">Innerhalb Zahlungsziel</option></select></label></div><p class="bill-hint">Erinnerungen werden als Text vorbereitet. Prüfe vor dem Versand Bankeingänge und eventuelle Rückfragen. Es wird keine Nachricht automatisch verschickt.</p>
<% invoices.forEach(d=>{ %><article class="bill-disclosure" data-receivable data-search="<%= [d.doc_number,d.company_name,d.contact_person].join(' ').toLowerCase() %>" data-overdue="<%= d.overdue?'overdue':'due' %>"><div class="bill-section-head"><div><a class="bill-doc-link" href="/documents/invoices/<%= d.id %>"><%= d.doc_number %> · <%= d.company_name||d.contact_person||'Kunde' %></a><p class="bill-hint">Zahlungsziel: <%= d.due?day(d.due):'nicht hinterlegt' %> · <%= money(d.paid_amount||0) %> bezahlt<% if(d.overdue){ %> · <span class="flow-due"><%= d.overdue %> Tage überfällig</span><% } %></p></div><strong><%= money(d.open) %> offen</strong></div><div class="bill-actions"><a class="bill-btn bill-small bill-primary" href="/documents/invoices/<%= d.id %>#zahlungen">Zahlung buchen</a><a class="bill-btn bill-small" href="/documents/invoices/<%= d.id %>#mahnung">Mahnung prüfen</a></div><details style="margin-top:12px"><summary>Erinnerungstext vorbereiten</summary><label class="bill-field">Text für <%= d.email||'Postversand' %><textarea id="reminder-<%= d.id %>" rows="8"><%= d.reminder %></textarea></label><button type="button" class="bill-btn bill-small" data-copy-reminder="reminder-<%= d.id %>">Text kopieren</button></details></article><% }); %><p id="receivables-empty" class="bill-muted" <%= invoices.length?'hidden':'' %>>Keine offenen Rechnungen für diese Auswahl.</p><p id="receivables-message" role="status"></p></section>
</div></main><script src="/js/receivables.js" defer></script></body></html>
