<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<link rel="stylesheet" href="/css/billing.css">
<% const offer=doc.doc_type==='OFFER',credit=doc.doc_type==='CREDIT',label=offer?'Angebot':credit?'Gutschrift':'Rechnung',base=endpoint(doc),total=Number(doc.total_amount)||0,discount=Number(doc.discount_amount)||0,net=Math.max(0,(Number(doc.subtotal)||0)-discount),klein=String(firma.kleinunternehmer).toLowerCase()==='true'; %>
<main class="flex-1 page-bg min-h-screen pt-16 bill-main"><div class="bill-shell">
 <a class="bill-back" href="<%= offer?'/documents/offers':'/documents/invoices' %>">← <%= offer?'Alle Angebote':'Alle Rechnungen' %></a>
 <header class="bill-heading"><div><span class="bill-eyebrow"><%= label.toUpperCase() %></span><h1><%= doc.doc_number %></h1><p><%= doc.company_name||doc.contact_person||'Kunde nicht mehr vorhanden' %> · Erstellt am <%= day(doc.created_at) %></p></div><div class="bill-actions"><span class="bill-badge"><%= doc.status %></span><% if(canSeeMoney&&editable(doc)){ %><a class="bill-btn" href="/documents/belege/<%= doc.id %>/bearbeiten">Bearbeiten</a><% } %><% if(canSeeMoney){ %><a class="bill-btn bill-primary" href="<%= base %>/pdf" target="_blank" rel="noopener">PDF ansehen ↗</a><% } %></div></header>
 <%- include('nav',{active:offer?'OFFER':'INVOICE'}) %>
 <% if(saved){ %><div class="bill-alert bill-success-note" role="status">Beleg gespeichert.</div><% } %><% if(sent){ %><div class="bill-alert bill-success-note" role="status">E-Mail wurde versandt.</div><% } %><% if(mailError){ %><div class="bill-alert bill-error" role="alert"><%= mailError %></div><% } %>
 <% if(offer&&klein&&Number(doc.tax_rate)!==0){ %><div class="bill-alert bill-warn">Die Firmeneinstellung Kleinunternehmer ist aktiv. Die gespeicherten Angebotsbeträge enthalten Umsatzsteuer, das PDF berücksichtigt die Firmenbefreiung. Bitte vor Versand prüfen.</div><% } %>
 <div class="bill-detail"><div class="bill-stack"><article class="bill-paper">
  <div class="bill-paper-head"><%= firma.name||firma.nameKurz||'Metallbau' %></div><div class="bill-paper-meta"><p><strong><%= doc.company_name||doc.contact_person||'—' %></strong><br><%= doc.contact_person&&doc.company_name?doc.contact_person:'' %><br><%= doc.street||'' %><br><%= [doc.zip,doc.city].filter(Boolean).join(' ') %></p><p>Belegnummer: <%= doc.doc_number %><br>Datum: <%= day(doc.created_at) %><% if(!offer&&!credit){ %><br>Zahlungsziel: <%= day(doc.due_date) %><% } %></p></div>
  <h2><%= label %><%= doc.invoice_subtype==='PARTIAL'||doc.invoice_subtype==='TEIL'?' · Teilrechnung':doc.invoice_subtype==='FINAL'||doc.invoice_subtype==='SCHLUSS'?' · Schlussrechnung':'' %></h2>
  <table><thead><tr><th>Pos. / Leistung</th><th>Menge</th><% if(canSeeMoney){ %><th>Einzelpreis</th><th>Summe</th><% } %></tr></thead><tbody><% items.forEach((it,i)=>{ %><tr><td><%= i+1 %>. <%= it.description %><% if(canSeeMoney&&Number(it.discount_percent)>0){ %><br><small><%= Number(it.discount_percent).toLocaleString('de-DE') %> % Positionsrabatt</small><% } %></td><td><%= Number(it.quantity).toLocaleString('de-DE') %> <%= it.unit %></td><% if(canSeeMoney){ %><td class="bill-number"><%= money(it.price) %></td><td class="bill-number"><%= money(Number(it.quantity)*Number(it.price)*(1-Number(it.discount_percent||0)/100)) %></td><% } %></tr><% }); %></tbody></table>
  <% if(canSeeMoney){ %><div class="bill-totals"><div><span>Positionen netto</span><span><%= money(doc.subtotal) %></span></div><% if(discount){ %><div><span>Belegrabatt</span><span>− <%= money(discount) %></span></div><% } %><div><span>Netto nach Rabatt</span><span><%= money(net) %></span></div><div><span>Umsatzsteuer <%= Number(doc.tax_rate||0).toLocaleString('de-DE') %> %</span><span><%= money(doc.tax_amount) %></span></div><div><strong>Gesamt</strong><strong><%= money(total) %></strong></div></div><% } %>
 </article><p class="bill-preview-note">Beleginhalt zur Übersicht. Maßgeblich für das Drucklayout ist die PDF-Datei.</p>
 <% if(doc.status_note){ %><section class="bill-card"><h2>Interne Notiz</h2><p class="bill-hint"><%= doc.status_note %></p></section><% } %>
 <% if(!offer&&!credit){ %><section class="bill-card" id="zahlungen"><div class="bill-section-head"><h2>Zahlungen &amp; Verlauf</h2><% if(canSeeMoney){ %><span class="bill-chip">Offen: <%= money(open) %></span><% } %></div>
 <% if(payments.length){ %><div class="bill-table-scroll"><table class="bill-table"><thead><tr><th>Datum</th><th>Zahlungsart / Notiz</th><% if(canSeeMoney){ %><th>Betrag</th><th>Aktion</th><% } %></tr></thead><tbody><% payments.forEach(p=>{ %><tr><td><%= day(p.payment_date) %></td><td><%= p.method||'—' %><small><%= p.note||'' %></small></td><% if(canSeeMoney){ %><td><%= money(p.amount) %></td><td><form method="POST" action="<%= base %>/payments/<%= p.id %>/delete" data-confirm="Diese Zahlung entfernen?"><button class="bill-btn bill-small bill-danger">Entfernen</button></form></td><% } %></tr><% }); %></tbody></table></div><% }else{ %><p class="bill-muted">Noch keine Zahlung gebucht.</p><% } %>
 <% if(history.length){ %><details class="bill-disclosure"><summary>Mahnverlauf (<%= history.length %>)</summary><% history.forEach(h=>{ %><p class="bill-hint"><%= day(h.created_at) %> · Mahnstufe <%= h.dunning_level||h.level||'—' %></p><% }); %></details><% } %>
 </section><% } %>
 <% if(offer){ %><section class="bill-card"><div class="bill-section-head"><h2>Nachträge</h2><span class="bill-chip"><%= additions.length %></span></div>
 <% if(!additions.length){ %><p class="bill-muted">Noch keine Nachträge vorhanden.</p><% } %><% additions.forEach(n=>{ %><details class="bill-disclosure"><summary><%= n.titel %> · <%= n.status %><% if(canSeeMoney){ %> · <%= money(n.betrag_netto) %> netto<% } %></summary><p class="bill-hint"><%= n.beschreibung||'' %></p><% (n.items||[]).forEach(it=>{ %><p class="bill-hint"><%= it.menge %> <%= it.einheit %> · <%= it.beschreibung %><% if(canSeeMoney){ %> · <%= money(it.preis) %><% } %></p><% }); %>
 <% if(canSeeMoney){ %><div class="bill-actions"><a class="bill-btn bill-small" href="/documents/nachtrag/approve/<%= n.freigabe_token %>" target="_blank" rel="noopener">Freigabelink öffnen</a><form action="/documents/nachtraege/<%= n.id %>/status" method="POST"><input type="hidden" name="document_id" value="<%= doc.id %>"><select name="status" aria-label="Nachtragsstatus"><% ['Entwurf','Gesendet','Freigegeben','Abgelehnt'].forEach(st=>{ %><option <%= st===n.status?'selected':'' %>><%= st %></option><% }); %></select><button class="bill-btn bill-small">Status speichern</button></form><form action="/documents/nachtraege/<%= n.id %>/delete" method="POST" data-confirm="Nachtrag wirklich löschen?"><input type="hidden" name="document_id" value="<%= doc.id %>"><button class="bill-btn bill-small bill-danger">Löschen</button></form></div><% } %></details><% }); %>
 <% if(canSeeMoney){ %><details class="bill-disclosure"><summary>Nachtrag erstellen</summary><form method="POST" action="<%= base %>/nachtraege/create" class="bill-action-form"><label class="bill-field">Titel<input name="titel" required maxlength="200"></label><label class="bill-field">Begründung<textarea name="beschreibung" rows="2"></textarea></label><div id="bill-addition-items"><div class="bill-grid"><label class="bill-field bill-wide">Leistung<input name="item_beschreibung" required></label><label class="bill-field">Menge<input type="number" name="item_menge" min="0.001" step="any" value="1" required></label><label class="bill-field">Einheit<input name="item_einheit" value="Stk" required></label><label class="bill-field">Einzelpreis €<input type="number" name="item_preis" min="0" step="0.01" required></label></div></div><button type="button" class="bill-btn" id="bill-addition-add">+ Nachtragsposition</button><button class="bill-btn bill-primary">Nachtrag speichern</button></form></details><% } %></section><% } %>
 </div><aside class="bill-stack"><section class="bill-card"><h2>Nächste Schritte</h2><p class="bill-hint"><%= offer?'Angebot prüfen und an den Kunden senden.':credit?'Gutschrift prüfen und als PDF bereitstellen.':'PDF prüfen, Rechnung versenden und Zahlungseingänge buchen.' %></p>
 <% if(canSeeMoney){ %><div class="bill-stack" style="gap:10px;margin-top:16px"><a class="bill-btn bill-detail-action" href="<%= base %>/pdf-download" download>PDF herunterladen</a>
 <% if(offer){ %><form action="/documents/offers/convert-to-invoice" method="POST" data-confirm="Angebot in eine Rechnung übernehmen? Eine vorhandene Rechnung wird wieder geöffnet."><input type="hidden" name="offer_id" value="<%= doc.id %>"><button class="bill-btn bill-primary bill-detail-action">In Rechnung übernehmen →</button></form><form action="/documents/offers/convert-to-project" method="POST" data-confirm="Auftrag aus diesem Angebot erstellen?"><input type="hidden" name="offer_id" value="<%= doc.id %>"><button class="bill-btn bill-detail-action">Als Auftrag anlegen</button></form><% } %>
 </div><details class="bill-disclosure"><summary>Per E-Mail versenden</summary><form action="<%= base %>/send-email" method="POST" class="bill-action-form"><label class="bill-field">Empfänger<input type="email" name="to" value="<%= doc.email||'' %>" required></label><label class="bill-field">Betreff<input name="subject" value="<%= label+' '+doc.doc_number %>" required></label><label class="bill-field">Nachricht<textarea name="message" rows="4">Anbei erhalten Sie <%= label %> <%= doc.doc_number %> als PDF.</textarea></label><button class="bill-btn bill-primary">E-Mail mit PDF senden</button></form></details>
 <% if(!offer&&!credit&&['ENTWURF','Entwurf'].includes(doc.status)){ %><form action="/documents/belege/<%= doc.id %>/ausstellen" method="POST" data-confirm="Rechnung ausstellen und gegen nachträgliche Bearbeitung schützen?" style="margin-top:14px"><button class="bill-btn bill-detail-action">Als ausgestellt markieren</button></form><% } %>
 <% if(!offer&&!credit&&doc.status!=='Storniert'){ %><details class="bill-disclosure"><summary>Zahlung buchen</summary><form method="POST" action="<%= base %>/payments" class="bill-action-form"><label class="bill-field">Betrag €<input type="number" name="amount" min="0.01" step="0.01" value="<%= open.toFixed(2) %>" required></label><label class="bill-field">Zahlungsdatum<input name="payment_date" type="date" value="<%= new Date().toISOString().slice(0,10) %>" required></label><label class="bill-field">Zahlungsart<select name="method"><option>Überweisung</option><option>Bar</option><option>Lastschrift</option><option>Sonstige</option></select></label><label class="bill-field">Notiz<input name="note"></label><button class="bill-btn bill-primary">Zahlung speichern</button></form></details>
 <details class="bill-disclosure"><summary>Zahlungserinnerung / Mahnung</summary><form method="POST" action="<%= base %>/create-dunning" class="bill-action-form"><label class="bill-field">Mahnstufe<select name="dunning_level"><option value="1">1 · Zahlungserinnerung</option><option value="2">2 · Mahnung</option><option value="3">3 · Letzte Mahnung</option></select></label><label class="bill-field">Mahngebühr €<input type="number" name="dunning_fee_override" min="0" step="0.01" value="0"></label><input type="hidden" name="apply_fee" value="1"><input type="hidden" name="download_pdf" value="1"><button class="bill-btn">Mahnung als PDF erstellen</button></form></details>
 <% } %>
 <% if(!offer){ %><details class="bill-disclosure"><summary>Exporte &amp; weitere Aktionen</summary><div class="bill-stack" style="gap:10px"><a class="bill-btn" href="<%= base %>/xrechnung?check=1" target="_blank" rel="noopener">XRechnung prüfen</a><a class="bill-btn" href="<%= base %>/xrechnung" download>XRechnung XML laden</a>
 <% if(!credit){ %><form action="<%= base %>/credit-note" method="POST" data-confirm="Gutschrift zu dieser Rechnung erstellen?"><button class="bill-btn bill-detail-action">Gutschrift erstellen</button></form><form action="<%= base %>/create-partial" method="POST" class="bill-action-form"><label class="bill-field">Anteil der Teilrechnung (%)<input type="number" name="percent" min="1" max="99" value="30" required></label><button class="bill-btn">Teilrechnung erstellen</button></form><form action="<%= base %>/create-final" method="POST" data-confirm="Schlussrechnung erstellen?"><button class="bill-btn bill-detail-action">Schlussrechnung erstellen</button></form><% } %></div></details><% } %>
 <% if((offer&&doc.status!=='ANGENOMMEN')||(!offer&&!credit&&doc.status!=='Storniert')){ %><details class="bill-disclosure"><summary>Korrektur &amp; Verwaltung</summary><div class="bill-stack">
 <% if(!offer){ %><form action="<%= base %>/storno" method="POST" class="bill-action-form" data-confirm="Rechnung wirklich stornieren?"><label class="bill-field">Grund<input name="reason" value="Storniert" required></label><button class="bill-btn bill-danger">Rechnung stornieren</button></form><% } %>
 <% if(offer||['ENTWURF','Entwurf'].includes(doc.status)){ %><form action="/documents/<%= offer?'offers':'invoices' %>/delete" method="POST" data-confirm="Diesen Beleg endgültig löschen?"><input type="hidden" name="<%= offer?'offer_id':'invoice_id' %>" value="<%= doc.id %>"><button class="bill-btn bill-danger bill-detail-action"><%= offer?'Angebot':'Entwurf' %> löschen</button></form><% } %>
 </div></details><% } %>
 <% }else{ %><p class="bill-hint">Für Beträge und Belegaktionen ist eine zusätzliche Berechtigung erforderlich.</p><% } %>
 </section><section class="bill-card"><h2>Kunde &amp; Belegstatus</h2><p class="bill-hint"><%= doc.email||'Keine E-Mail hinterlegt' %><br><%= doc.sent_at?'Versandt: '+day(doc.sent_at):'Noch kein E-Mail-Versand erfasst' %><% if(doc.related_document_id){ %><br>Verknüpfter Beleg: #<%= doc.related_document_id %><% } %></p><a class="bill-btn bill-small" href="/customers/<%= doc.customer_id %>" style="margin-top:12px">Kundenakte öffnen ↗</a><% if(canSeeMoney&&!offer&&!credit){ %><div class="bill-divider"></div><div class="bill-totals"><div><span>Bezahlt</span><span><%= money(paid) %></span></div><div><span>Offen</span><strong><%= money(open) %></strong></div></div><% } %></section></aside></div>
</div></main>
<script src="/js/billing-detail.js" defer></script>
</body></html>
