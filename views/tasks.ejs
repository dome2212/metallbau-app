<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 min-h-screen page-bg dark:bg-slate-900 pt-14">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6 space-y-6">

    <!-- Page Header -->
    <div>
      <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">🔧 Aufgaben</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
        <% if (currentUser.role === 'CHEF' || currentUser.role === 'ADMIN') { %>
          Aufgaben für Werkstatt, Fahrzeuge & mehr an Mitarbeiter verteilen
        <% } else { %>
          Deine zugewiesenen Aufgaben für Werkstatt, Auto & mehr
        <% } %>
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <% if (currentUser.role === 'CHEF' || currentUser.role === 'ADMIN') { %>
      <!-- Neue Aufgabe anlegen -->
      <div class="lg:col-span-4 card p-5">
        <h2 class="text-base font-semibold text-slate-800 dark:text-slate-100 mb-4 flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-sm">＋</span>
          Neue Aufgabe
        </h2>
        <form action="/tasks/add" method="POST" class="space-y-3.5">
          <div>
            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Titel</label>
            <input type="text" name="title" required placeholder="z. B. Werkstatt aufräumen" class="input text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Beschreibung</label>
            <textarea name="description" rows="3" placeholder="Details zur Aufgabe…" class="input text-sm"></textarea>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Bereich</label>
              <select name="category" class="input text-sm">
                <option value="Werkstatt">🏭 Werkstatt</option>
                <option value="Auto">🚐 Auto / Fuhrpark</option>
                <option value="Baustelle">🏗️ Baustelle</option>
                <option value="Sonstiges">📌 Sonstiges</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Priorität</label>
              <select name="priority" class="input text-sm">
                <option value="Normal">Normal</option>
                <option value="Hoch">🔴 Hoch</option>
                <option value="Niedrig">🔵 Niedrig</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Mitarbeiter</label>
            <select name="assigned_to" class="input text-sm">
              <option value="">👥 Alle Mitarbeiter</option>
              <% users.forEach(u => { %>
                <option value="<%= u.id %>"><%= u.username %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Fällig am</label>
            <input type="date" name="due_date" class="input text-sm">
          </div>
          <button type="submit" class="btn w-full font-semibold text-white py-2.5" style="background:var(--primary)">
            Aufgabe zuweisen
          </button>
        </form>
      </div>
      <% } %>

      <!-- Aufgabenliste -->
      <div class="<%= (currentUser.role === 'CHEF' || currentUser.role === 'ADMIN') ? 'lg:col-span-8' : 'lg:col-span-12' %> space-y-3">

        <% const openTasks = tasks.filter(t => t.status !== 'Erledigt'); %>
        <% const doneTasks = tasks.filter(t => t.status === 'Erledigt'); %>

        <div class="card p-0 overflow-hidden">
          <div class="px-4 md:px-5 py-3.5 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-slate-800 dark:text-slate-100">Offene Aufgaben</h2>
            <span class="badge bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300"><%= openTasks.length %></span>
          </div>

          <% if (openTasks.length === 0) { %>
            <p class="text-sm text-slate-400 dark:text-slate-500 italic px-4 md:px-5 py-6 text-center">Keine offenen Aufgaben 🎉</p>
          <% } else { %>
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
              <% openTasks.forEach(t => { %>
                <%
                  const catIcon = { 'Werkstatt': '🏭', 'Auto': '🚐', 'Baustelle': '🏗️', 'Sonstiges': '📌' }[t.category] || '📌';
                  const isOverdue = t.due_date && t.due_date !== '' && new Date(t.due_date) < new Date(new Date().toDateString());
                  const prioColor = t.priority === 'Hoch' ? 'text-red-600 dark:text-red-400' : t.priority === 'Niedrig' ? 'text-blue-500 dark:text-blue-400' : 'text-slate-400';
                %>
                <div class="px-4 md:px-5 py-3.5 flex items-start justify-between gap-3 flex-wrap sm:flex-nowrap">
                  <div class="flex items-start gap-3 min-w-0">
                    <span class="text-lg shrink-0 mt-0.5"><%= catIcon %></span>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-slate-800 dark:text-slate-100"><%= t.title %></p>
                      <% if (t.description) { %>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5"><%= t.description %></p>
                      <% } %>
                      <div class="flex items-center gap-2 flex-wrap mt-1.5">
                        <span class="badge bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400"><%= t.category %></span>
                        <span class="text-xs text-slate-500 dark:text-slate-400">
                          👤 <%= t.assigned_to_name || 'Alle Mitarbeiter' %>
                        </span>
                        <% if (t.due_date) { %>
                          <span class="text-xs <%= isOverdue ? 'text-red-600 font-semibold' : 'text-slate-400' %>">
                            📅 <%= t.due_date %><%= isOverdue ? ' (überfällig)' : '' %>
                          </span>
                        <% } %>
                        <% if (t.priority && t.priority !== 'Normal') { %>
                          <span class="text-xs font-semibold <%= prioColor %>"><%= t.priority %></span>
                        <% } %>
                      </div>
                      <% if (currentUser.role === 'CHEF' || currentUser.role === 'ADMIN') { %>
                        <p class="text-[10px] text-slate-400 mt-1">von <%= t.assigned_by_name || '–' %> · <%= new Date(t.created_at).toLocaleDateString('de-DE') %></p>
                      <% } %>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <button type="button"
                            onclick="openTaskChat(<%= t.id %>, '<%= (t.title || '').replace(/'/g, "\\'") %>')"
                            class="btn btn-ghost text-xs px-2.5 py-2 text-blue-600 dark:text-blue-400"
                            title="Chat zur Aufgabe">
                      💬
                    </button>
                    <form action="/tasks/status" method="POST">
                      <input type="hidden" name="id" value="<%= t.id %>">
                      <input type="hidden" name="status" value="Erledigt">
                      <button type="submit" class="btn text-xs font-semibold px-3 py-2 text-white" style="background:#16a34a">
                        ✓ Erledigt
                      </button>
                    </form>
                    <% if (currentUser.role === 'CHEF' || currentUser.role === 'ADMIN') { %>
                      <form action="/tasks/delete" method="POST" onsubmit="return confirm('Aufgabe wirklich löschen?')">
                        <input type="hidden" name="id" value="<%= t.id %>">
                        <button type="submit" class="btn btn-ghost text-xs px-2.5 py-2 text-red-500">🗑️</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="card p-0 overflow-hidden">
          <div class="px-4 md:px-5 py-3.5 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-slate-800 dark:text-slate-100">Erledigte Aufgaben</h2>
            <span class="badge bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300"><%= doneTasks.length %></span>
          </div>
          <% if (doneTasks.length === 0) { %>
            <p class="text-sm text-slate-400 dark:text-slate-500 italic px-4 md:px-5 py-6 text-center">Noch keine erledigten Aufgaben.</p>
          <% } else { %>
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
              <% doneTasks.slice(0, 20).forEach(t => { %>
                <%
                  const catIcon = { 'Werkstatt': '🏭', 'Auto': '🚐', 'Baustelle': '🏗️', 'Sonstiges': '📌' }[t.category] || '📌';
                %>
                <div class="px-4 md:px-5 py-3 flex items-center justify-between gap-3 opacity-70">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="text-base shrink-0"><%= catIcon %></span>
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-slate-600 dark:text-slate-300 line-through truncate"><%= t.title %></p>
                      <p class="text-[10px] text-slate-400">👤 <%= t.assigned_to_name || 'Alle Mitarbeiter' %><% if (t.completed_at) { %> · erledigt am <%= new Date(t.completed_at).toLocaleDateString('de-DE') %><% } %></p>
                    </div>
                  </div>
                  <% if (currentUser.role === 'CHEF' || currentUser.role === 'ADMIN') { %>
                    <form action="/tasks/delete" method="POST" onsubmit="return confirm('Aufgabe wirklich löschen?')">
                      <input type="hidden" name="id" value="<%= t.id %>">
                      <button type="submit" class="btn btn-ghost text-xs px-2.5 py-1.5 text-red-500 shrink-0">🗑️</button>
                    </form>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</main>

<!-- ========== TASK-CHAT MODAL ========== -->
<div id="taskChatModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/50 backdrop-blur-sm" style="display:none;">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-2xl w-full max-w-lg max-h-[85vh] flex flex-col overflow-hidden border border-slate-200 dark:border-slate-700">
    <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between shrink-0">
      <div>
        <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">💬 Aufgaben-Chat</h3>
        <p id="taskChatTitle" class="text-xs text-slate-500 dark:text-slate-400 truncate max-w-[280px]"></p>
      </div>
      <button type="button" onclick="closeTaskChat()" class="btn btn-ghost text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg leading-none px-2">×</button>
    </div>
    <div id="taskChatMessages" class="flex-1 overflow-y-auto p-4 space-y-3 min-h-[200px] max-h-[50vh]">
      <p class="text-xs text-slate-400 text-center italic">Nachrichten werden geladen…</p>
    </div>
    <div class="px-4 py-3 border-t border-slate-100 dark:border-slate-700 shrink-0">
      <form id="taskChatForm" class="flex gap-2" onsubmit="sendTaskChat(event)">
        <input type="text" id="taskChatInput" placeholder="Nachricht schreiben…" autocomplete="off"
               class="input text-sm flex-1" maxlength="1000">
        <button type="submit" class="btn text-white text-sm font-medium px-4" style="background:var(--primary)">Senden</button>
      </form>
    </div>
  </div>
</div>

<script>
  let currentTaskChatId = null;
  const currentUserId = <%= currentUser.id %>;
  const isBoss = <%= (currentUser.role === 'CHEF' || currentUser.role === 'ADMIN') ? 'true' : 'false' %>;

  function openTaskChat(taskId, title) {
    currentTaskChatId = taskId;
    document.getElementById('taskChatTitle').textContent = title || ('Aufgabe #' + taskId);
    const modal = document.getElementById('taskChatModal');
    modal.style.display = 'flex';
    modal.classList.remove('hidden');
    document.getElementById('taskChatMessages').innerHTML = '<p class="text-xs text-slate-400 text-center italic">Nachrichten werden geladen…</p>';
    document.getElementById('taskChatInput').value = '';
    loadTaskMessages(taskId);
    setTimeout(() => document.getElementById('taskChatInput').focus(), 100);
  }

  function closeTaskChat() {
    const modal = document.getElementById('taskChatModal');
    modal.style.display = 'none';
    modal.classList.add('hidden');
    currentTaskChatId = null;
  }

  // Klick außerhalb schließt Modal
  document.getElementById('taskChatModal').addEventListener('click', function(e) {
    if (e.target === this) closeTaskChat();
  });

  async function loadTaskMessages(taskId) {
    try {
      const res = await fetch('/tasks/' + taskId + '/messages', {
        credentials: 'same-origin',
        headers: { 'Accept': 'application/json' }
      });
      if (!res.ok) throw new Error('Laden fehlgeschlagen');
      const data = await res.json();
      renderTaskMessages(data.messages || []);
    } catch (err) {
      document.getElementById('taskChatMessages').innerHTML =
        '<p class="text-xs text-red-500 text-center">Fehler beim Laden der Nachrichten.</p>';
    }
  }

  function renderTaskMessages(messages) {
    const box = document.getElementById('taskChatMessages');
    if (!messages.length) {
      box.innerHTML = '<p class="text-xs text-slate-400 text-center italic">Noch keine Nachrichten. Schreib die erste!</p>';
      return;
    }
    box.innerHTML = messages.map(m => {
      const isMe = Number(m.user_id) === Number(currentUserId);
      const canDelete = isMe || isBoss;
      const time = m.created_at ? new Date(m.created_at).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' }) : '';
      const name = m.username || 'Unbekannt';
      return `
        <div class="flex ${isMe ? 'justify-end' : 'justify-start'}">
          <div class="max-w-[85%] rounded-xl px-3 py-2 text-sm ${isMe
            ? 'bg-blue-600 text-white rounded-br-sm'
            : 'bg-slate-100 dark:bg-slate-700 text-slate-800 dark:text-slate-100 rounded-bl-sm'}">
            <p class="text-[10px] font-semibold opacity-90 mb-0.5">${escapeHtml(name)}${isMe ? ' (du)' : ''}</p>
            <p class="whitespace-pre-wrap break-words">${escapeHtml(m.message)}</p>
            <div class="flex items-center justify-between gap-2 mt-1">
              <span class="text-[10px] opacity-70">${time}</span>
              ${canDelete ? `<button type="button" onclick="deleteTaskChatMsg(${m.id})" class="text-[10px] opacity-60 hover:opacity-100 underline" title="Nachricht löschen">löschen</button>` : ''}
            </div>
          </div>
        </div>`;
    }).join('');
    box.scrollTop = box.scrollHeight;
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  async function sendTaskChat(e) {
    e.preventDefault();
    if (!currentTaskChatId) return;
    const input = document.getElementById('taskChatInput');
    const text = (input.value || '').trim();
    if (!text) return;
    input.disabled = true;
    try {
      const res = await fetch('/tasks/' + currentTaskChatId + '/messages', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ message: text })
      });
      if (!res.ok) throw new Error('Senden fehlgeschlagen');
      const data = await res.json();
      renderTaskMessages(data.messages || []);
      input.value = '';
    } catch (err) {
      alert('Nachricht konnte nicht gesendet werden.');
    } finally {
      input.disabled = false;
      input.focus();
    }
  }

  async function deleteTaskChatMsg(msgId) {
    if (!currentTaskChatId) return;
    if (!confirm('Nachricht wirklich löschen?')) return;
    try {
      const res = await fetch('/tasks/' + currentTaskChatId + '/messages/delete', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ message_id: msgId })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Löschen fehlgeschlagen');
      renderTaskMessages(data.messages || []);
    } catch (err) {
      alert('Löschen fehlgeschlagen: ' + (err.message || ''));
    }
  }
</script>

</body>
</html>
