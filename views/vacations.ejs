<%- include('partials/header') %>

<div class="flex h-screen bg-gray-100 overflow-hidden">
  <%- include('partials/sidebar') %>

  <!-- Hauptinhalt mit korrektem Abstand für die Sidebar -->
  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 min-h-screen pt-16 md:pt-6">
    
    <!-- Header mit Palme -->
    <header class="bg-white shadow px-4 md:px-6 py-4 flex justify-between items-center mb-6">
      <h1 class="text-xl md:text-2xl font-bold text-slate-800">🌴 Urlaubs- & Abwesenheitsplanung</h1>
    </header>

    <!-- Inhalt-Container -->
    <div class="p-4 md:p-6 max-w-7xl mx-auto w-full space-y-6">

      <!-- ===================================================== -->
      <!-- URLAUBSKONTO-ÜBERSICHT (immer sichtbar)               -->
      <!-- ===================================================== -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base md:text-lg font-bold text-gray-800">🏖️ Urlaubskonten <%= currentYear %></h2>
          <% if (currentUser.role !== 'ADMIN') { %>
            <span class="text-xs text-gray-500">Nur eigenes Konto sichtbar</span>
          <% } %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          <%
            const visibleUsers = currentUser.role === 'ADMIN'
              ? users
              : users.filter(u => u.id === currentUser.id);
          %>
          <% visibleUsers.forEach(u => { %>
            <%
              const bal = vacationBalances[u.id] || { allowance: 30, used: 0, remaining: 30 };
              const pct = bal.allowance > 0 ? Math.min(100, Math.round((bal.used / bal.allowance) * 100)) : 0;
              const barColor = pct >= 90 ? 'bg-red-500' : pct >= 65 ? 'bg-amber-400' : 'bg-emerald-500';
            %>
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm font-semibold text-slate-800 truncate"><%= u.username %></span>
                <span class="text-xs text-slate-400"><%= u.role %></span>
              </div>
              <!-- Fortschrittsbalken -->
              <div class="w-full bg-slate-200 rounded-full h-2">
                <div class="<%= barColor %> h-2 rounded-full transition-all" style="width:<%= pct %>%"></div>
              </div>
              <div class="flex justify-between text-xs text-slate-600">
                <span><strong class="text-slate-800"><%= bal.remaining %></strong> Tage übrig</span>
                <span><%= bal.used %>/<%= bal.allowance %> verbraucht</span>
              </div>
              <!-- Admin kann Jahresanspruch direkt hier anpassen -->
              <% if (currentUser.role === 'ADMIN') { %>
                <form action="/admin/users/set-vacation-allowance" method="POST" class="flex items-center gap-1 pt-1">
                  <input type="hidden" name="user_id" value="<%= u.id %>">
                  <input type="number" name="vacation_allowance" value="<%= bal.allowance %>"
                    min="0" max="365"
                    class="w-16 text-xs border border-slate-300 rounded px-1.5 py-1 bg-white">
                  <span class="text-xs text-slate-500">Tage/Jahr</span>
                  <button type="submit" class="text-xs bg-slate-700 hover:bg-slate-800 text-white px-2 py-1 rounded transition">✓</button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Layout auf 12 Spalten angepasst für saubere Aufteilung -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Linke Spalte: Neuer Antrag / Eintrag (4 von 12 Spalten) -->
        <div class="lg:col-span-4 bg-white rounded-xl shadow-sm border border-gray-200 p-5">
          <h2 class="text-base md:text-lg font-bold text-gray-800 mb-4">Abwesenheit eintragen</h2>
          
          <form action="/vacations/add" method="POST" enctype="multipart/form-data" class="space-y-4">
            <% if (currentUser.role === 'ADMIN') { %>
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Mitarbeiter</label>
                <select name="user_id" class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-2 text-gray-700 focus:outline-none focus:border-blue-500">
                  <% users.forEach(u => { %>
                    <option value="<%= u.id %>"><%= u.username %> (<%= u.role %>)</option>
                  <% }) %>
                </select>
              </div>
            <% } %>

            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Art der Abwesenheit</label>
              <select name="type" id="absenceType" class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-2 text-gray-700 focus:outline-none focus:border-blue-500">
                <option value="Urlaub">🏖️ Urlaub</option>
                <option value="Krank">🤒 Krankmeldung</option>
                <option value="Schulung">📚 Schulung / Weiterbildung</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Von Datum</label>
              <input type="date" name="start_date" required class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-2 text-gray-700 focus:outline-none focus:border-blue-500">
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Bis Datum</label>
              <input type="date" name="end_date" required class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-2 text-gray-700 focus:outline-none focus:border-blue-500">
            </div>

            <!-- Datei-Upload für Krankmeldung / Dokumente -->
            <div id="fileUploadContainer">
              <label class="block text-xs font-semibold text-gray-700 mb-1">Krankmeldung / Dokument hochladen (Foto/PDF)</label>
              <input type="file" name="document" accept="image/*,.pdf" class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-1 text-gray-700 focus:outline-none focus:border-blue-500">
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Grund / Bemerkung (optional)</label>
              <input type="text" name="reason" placeholder="z.B. Attest liegt vor" class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-2 text-gray-700 focus:outline-none focus:border-blue-500">
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium py-2.5 rounded transition">
              Antrag abschicken
            </button>
          </form>
        </div>

        <!-- Rechte Spalte: Liste aller Abwesenheiten (8 von 12 Spalten) -->
        <div class="lg:col-span-8 bg-white rounded-xl shadow-sm border border-gray-200 p-5 overflow-hidden">
          <h2 class="text-base md:text-lg font-bold text-gray-800 mb-4">Übersicht aller Abwesenheiten</h2>
          
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs whitespace-nowrap">
              <thead>
                <tr class="bg-gray-100 text-gray-700 border-b border-gray-200">
                  <th class="p-3">Mitarbeiter</th>
                  <th class="p-3">Typ</th>
                  <th class="p-3">Zeitraum</th>
                  <th class="p-3">Nachweis</th>
                  <th class="p-3">Status</th>
                  <% if (currentUser.role === 'ADMIN') { %>
                    <th class="p-3 text-right">Aktion</th>
                  <% } %>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% if (vacations && vacations.length > 0) { %>
                  <% vacations.forEach(v => { %>
                    <tr class="hover:bg-gray-50">
                      <td class="p-3 font-medium text-gray-800"><%= v.username || currentUser.username %></td>
                      <td class="p-3">
                        <span class="px-2 py-0.5 rounded font-semibold 
                          <%= v.type === 'Urlaub' ? 'bg-blue-100 text-blue-700' : (v.type === 'Krank' ? 'bg-red-100 text-red-700' : 'bg-purple-100 text-purple-700') %>">
                          <%= v.type || 'Urlaub' %>
                        </span>
                      </td>
                      <td class="p-3 text-gray-600"><%= v.start_date %> bis <%= v.end_date %></td>
                      <td class="p-3">
                        <% if (v.file_url) { %>
                          <a href="<%= v.file_url %>" target="_blank" class="text-blue-600 hover:underline font-medium">📄 Ansehen</a>
                        <% } else { %>
                          <span class="text-gray-400 italic">Keine Datei</span>
                        <% } %>
                      </td>
                      <td class="p-3">
                        <span class="px-2 py-0.5 rounded font-semibold 
                          <%= v.status === 'Genehmigt' ? 'bg-emerald-100 text-emerald-700' : (v.status === 'Beantragt' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700') %>">
                          <%= v.status %>
                        </span>
                      </td>
                      <% if (currentUser.role === 'ADMIN') { %>
                        <td class="p-3 text-right space-x-1">
                          <% if (v.status === 'Beantragt') { %>
                            <form action="/vacations/status" method="POST" class="inline">
                              <input type="hidden" name="id" value="<%= v.id %>">
                              <input type="hidden" name="status" value="Genehmigt">
                              <button type="submit" class="bg-emerald-600 text-white px-2 py-1 rounded hover:bg-emerald-700">Genehmigen</button>
                            </form>
                            <form action="/vacations/status" method="POST" class="inline">
                              <input type="hidden" name="id" value="<%= v.id %>">
                              <input type="hidden" name="status" value="Abgelehnt">
                              <button type="submit" class="bg-red-600 text-white px-2 py-1 rounded hover:bg-red-700">Ablehnen</button>
                            </form>
                          <% } %>
                          <form action="/vacations/delete" method="POST" class="inline" onsubmit="return confirm('Eintrag wirklich löschen?');">
                            <input type="hidden" name="id" value="<%= v.id %>">
                            <button type="submit" class="bg-gray-200 text-gray-700 px-2 py-1 rounded hover:bg-gray-300">Löschen</button>
                          </form>
                        </td>
                      <% } %>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="p-6 text-center text-gray-400 italic">Keine Abwesenheiten eingetragen.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>

  </main>

</div>

</body>
</html>
