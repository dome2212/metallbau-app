<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Urlaubs- & Abwesenheitsplanung - Metallbau-Gehrmann</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2563eb">
</head>
<body class="bg-gray-100 text-gray-950 flex flex-col md:flex-row min-h-screen">

  <!-- Sidebar einbinden -->
  <%- include('partials/sidebar') %>

  <!-- Hauptinhalt -->
  <main class="flex-1 p-4 md:p-8 max-w-full overflow-x-hidden">
    
    <!-- Kopfbereich -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3 border-b border-gray-200 pb-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Urlaubs- & Abwesenheitsplanung</h1>
        <p class="text-sm text-gray-500">Urlaub, Krankmeldungen und Schulungen verwalten</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Linke Spalte: Neuer Antrag / Eintrag -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 h-fit">
        <h2 class="text-lg font-bold text-gray-800 mb-4">Abwesenheit eintragen</h2>
        
        <form action="/vacations/add" method="POST" class="space-y-4">
          <% if (currentUser.role === 'ADMIN') { %>
            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Mitarbeiter</label>
              <select name="user_id" class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-2 text-gray-700 focus:outline-none focus:border-blue-500">
                <% users.forEach(u => { %>
                  <option value="<%= u.id %>"><%= u.username %> (<%= u.role %>)</option>
                <% }) %>
              </select>
            </div>
          <% } %>

          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">Art der Abwesenheit</label>
            <select name="type" class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-2 text-gray-700 focus:outline-none focus:border-blue-500">
              <option value="Urlaub">🏖️ Urlaub</option>
              <option value="Krank">🤒 Krankmeldung</option>
              <option value="Schulung">📚 Schulung / Weiterbildung</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">Von Datum</label>
            <input type="date" name="start_date" required class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-2 text-gray-700 focus:outline-none focus:border-blue-500">
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">Bis Datum</label>
            <input type="date" name="end_date" required class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-2 text-gray-700 focus:outline-none focus:border-blue-500">
          </div>

          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium py-2.5 rounded transition">
            Antrag abschicken
          </button>
        </form>
      </div>

      <!-- Rechte Spalte: Liste aller Abwesenheiten -->
      <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <h2 class="text-lg font-bold text-gray-800 mb-4">Übersicht aller Abwesenheiten</h2>
        
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-gray-100 text-gray-700 border-b border-gray-200">
                <th class="p-3">Mitarbeiter</th>
                <th class="p-3">Typ</th>
                <th class="p-3">Zeitraum</th>
                <th class="p-3">Status</th>
                <% if (currentUser.role === 'ADMIN') { %>
                  <th class="p-3 text-right">Aktion</th>
                <% } %>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (vacations && vacations.length > 0) { %>
                <% vacations.forEach(v => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="p-3 font-medium text-gray-800"><%= v.username %></td>
                    <td class="p-3">
                      <span class="px-2 py-0.5 rounded font-semibold 
                        <%= v.type === 'Urlaub' ? 'bg-blue-100 text-blue-700' : (v.type === 'Krank' ? 'bg-red-100 text-red-700' : 'bg-purple-100 text-purple-700') %>">
                        <%= v.type %>
                      </span>
                    </td>
                    <td class="p-3 text-gray-600"><%= v.start_date %> bis <%= v.end_date %></td>
                    <td class="p-3">
                      <span class="px-2 py-0.5 rounded font-semibold 
                        <%= v.status === 'Genehmigt' ? 'bg-emerald-100 text-emerald-700' : (v.status === 'Beantragt' ? 'bg-amber-100 text-amber-700' : 'bg-gray-100 text-gray-700') %>">
                        <%= v.status %>
                      </span>
                    </td>
                    <% if (currentUser.role === 'ADMIN') { %>
                      <td class="p-3 text-right">
                        <% if (v.status === 'Beantragt') { %>
                          <form action="/vacations/status" method="POST" class="inline">
                            <input type="hidden" name="id" value="<%= v.id %>">
                            <input type="hidden" name="status" value="Genehmigt">
                            <button type="submit" class="bg-emerald-600 text-white px-2 py-1 rounded hover:bg-emerald-700 mr-1">Genehmigen</button>
                          </form>
                          <form action="/vacations/status" method="POST" class="inline">
                            <input type="hidden" name="id" value="<%= v.id %>">
                            <input type="hidden" name="status" value="Abgelehnt">
                            <button type="submit" class="bg-red-600 text-white px-2 py-1 rounded hover:bg-red-700">Ablehnen</button>
                          </form>
                        <% } else { %>
                          <span class="text-gray-400 italic">-</span>
                        <% } %>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="p-6 text-center text-gray-400 italic">Keine Abwesenheiten eingetragen.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </main>

</body>
</html>
