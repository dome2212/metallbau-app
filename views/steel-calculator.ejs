// Welche Gruppen benÃ¶tigen benutzerdefinierte Dimensionen?
const CUSTOM_GROUPS = new Set(['rohr_rund','rohr_recht','flach','blech','rundstahl','vierkantstahl']);

// Aktuell berechnetes kgm (fÃ¼r ListenÃ¼bertrag)
let currentKgm = null;
let currentLabel = '';

// Positionsliste
let positions = [];
let posCounter = 0;

// â”€â”€â”€ Dropdown fÃ¼r Gruppe befÃ¼llen â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function onGroupChange() {
  const group = document.getElementById('profile-group').value;
  const sizeEl = document.getElementById('profile-size');
  sizeEl.innerHTML = '';
  (PROFILES[group] || []).forEach((p, i) => {
    const opt = document.createElement('option');
    opt.value = i;
    opt.textContent = p.label;
    sizeEl.appendChild(opt);
  });
  onSizeChange();
}

function onSizeChange() {
  const group = document.getElementById('profile-group').value;
  const idx   = parseInt(document.getElementById('profile-size').value, 10);
  const prof  = (PROFILES[group] || [])[idx];
  if (!prof) return;

  const dimDiv = document.getElementById('custom-dims');
  const isBlech = group === 'blech';
  const isRohrRund = group === 'rohr_rund';
  const isRohrRecht = group === 'rohr_recht';
  const isFlach = group === 'flach';
  const isRund = group === 'rundstahl';
  const isVierkant = group === 'vierkantstahl';

  // Zeige Custom-Dims wenn nÃ¶tig
  const needCustom = CUSTOM_GROUPS.has(group) && (prof.kgm === null);
  dimDiv.classList.toggle('hidden', !needCustom);

  if (needCustom) {
    // Beschriftungen + Sichtbarkeit der Felder anpassen
    document.getElementById('dim-b-wrap').classList.toggle('hidden', isRohrRund || isRund || isVierkant);
    document.getElementById('dim-h-wrap').classList.toggle('hidden', isRohrRund || isFlach || isRund || isVierkant);
    document.getElementById('dim-t-wrap').classList.toggle('hidden', isRund || isVierkant || isBlech);
    document.getElementById('dim-d-wrap').classList.toggle('hidden', !(isRohrRund || isRund || isVierkant));

    if (isBlech) {
      document.getElementById('dim-b-label').textContent = 'Breite b (mm)';
      document.getElementById('dim-h-label').textContent = 'LÃ¤nge l (mm)';
      // FÃ¼r Blech: t ist festes MaÃŸ aus Dropdown, wir zeigen t-Feld trotzdem
      document.getElementById('dim-t-wrap').classList.remove('hidden');
      document.getElementById('dim-t-label').textContent = 'Dicke t (mm)';
      document.getElementById('dim-h-wrap').classList.remove('hidden');
    }
    if (isRohrRund) {
      document.getElementById('dim-d-label').textContent = 'AuÃŸen-Ã˜ d (mm)';
      document.getElementById('dim-t-wrap').classList.remove('hidden');
      document.getElementById('dim-t-label').textContent = 'WandstÃ¤rke t (mm)';
    }
    if (isRohrRecht) {
      document.getElementById('dim-b-label').textContent = 'Breite b (mm)';
      document.getElementById('dim-h-label').textContent = 'HÃ¶he h (mm)';
      document.getElementById('dim-t-label').textContent = 'WandstÃ¤rke t (mm)';
    }
    if (isFlach) {
      document.getElementById('dim-b-label').textContent = 'Breite b (mm)';
      document.getElementById('dim-t-label').textContent = 'Dicke t (mm)';
    }
    if (isRund) {
      document.getElementById('dim-d-label').textContent = 'Durchmesser d (mm)';
    }
    if (isVierkant) {
      document.getElementById('dim-d-label').textContent = 'KantenlÃ¤nge a (mm)';
    }
  } else if (isBlech && prof.t) {
    // Blech mit fester Dicke: BemaÃŸungs-Felder fÃ¼r b und l anzeigen
    dimDiv.classList.remove('hidden');
    document.getElementById('dim-b-wrap').classList.remove('hidden');
    document.getElementById('dim-b-label').textContent = 'Breite b (mm)';
    document.getElementById('dim-h-wrap').classList.remove('hidden');
    document.getElementById('dim-h-label').textContent = 'LÃ¤nge l (mm)';
    document.getElementById('dim-t-wrap').classList.add('hidden');
    document.getElementById('dim-d-wrap').classList.add('hidden');
  }

  currentKgm = null;
  currentLabel = prof.label;
  recalc();
}

function syncCustomDims() { recalc(); }

function syncLength(from) {
  const mm = document.getElementById('length-mm');
  const m  = document.getElementById('length-m');
  if (from === 'mm' && mm.value) m.value = (parseFloat(mm.value) / 1000).toFixed(3);
  else if (from === 'm' && m.value) mm.value = Math.round(parseFloat(m.value) * 1000);
  recalc();
}

// â”€â”€â”€ Kernberechnung â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcKgm() {
  const group = document.getElementById('profile-group').value;
  const idx   = parseInt(document.getElementById('profile-size').value, 10);
  const prof  = (PROFILES[group] || [])[idx];
  if (!prof) return null;

  const rho = parseFloat(document.getElementById('material').value); // kg/dmÂ³
  const rhoMm3 = rho / 1e6; // kg/mmÂ³

  // Normiertes kgm â€“ fÃ¼r TrÃ¤ger/Winkel/UPN/UPE sind Werte fÃ¼r Stahl 7,85
  // Bei anderem Material skalieren wir proportional
  const scaleFactor = rho / 7.85;

  if (prof.kgm !== null) {
    return prof.kgm * scaleFactor;
  }

  // Benutzerdefiniert berechnen
  const b = parseFloat(document.getElementById('dim-b').value) || 0;
  const h = parseFloat(document.getElementById('dim-h').value) || 0;
  const t = parseFloat(document.getElementById('dim-t').value) || 0;
  const d = parseFloat(document.getElementById('dim-d').value) || 0;

  let A = 0; // QuerschnittsflÃ¤che in mmÂ²

  if (group === 'rohr_rund') {
    if (d <= 0 || t <= 0 || t >= d/2) return null;
    const ri = d/2 - t;
    A = Math.PI * ((d/2)**2 - ri**2);
  } else if (group === 'rohr_recht') {
    if (b <= 0 || h <= 0 || t <= 0) return null;
    A = b*h - (b - 2*t)*(h - 2*t);
  } else if (group === 'flach') {
    if (b <= 0 || t <= 0) return null;
    A = b * t;
  } else if (group === 'blech') {
    // FÃ¼r Blech: kgm hat keinen Sinn â€“ wir berechnen Gesamtgewicht direkt
    // Verwende t aus Dropdown oder Eingabefeld, b und h = BreiteÃ—LÃ¤nge der Platte
    const thick = prof.t || t;
    if (b <= 0 || h <= 0 || thick <= 0) return null;
    // Gewicht in kg pro 1000 mm "LÃ¤nge" (Platte: A = b Ã— thick, LÃ¤nge = h)
    // Wir geben hier A = b * thick zurÃ¼ck, LÃ¤nge = h mm â†’ Gesamtkg = A*h*rhoMm3
    // Um in kgm (kg pro 1000 mm) umzurechnen: kgm = A * rhoMm3 * 1000
    // Aber hier liefern wir nur kg/m zurÃ¼ck; die eigentliche LÃ¤nge steckt in h
    // â†’ Sonderfall: kgm = Gesamtkg direkt (LÃ¤nge = h), LÃ¤ngenfeld wird ignoriert
    return { directKg: b * h * thick * rhoMm3 };
  } else if (group === 'rundstahl') {
    if (d <= 0) return null;
    A = Math.PI * (d/2)**2;
  } else if (group === 'vierkantstahl') {
    if (d <= 0) return null;
    A = d * d;
  }

  if (A <= 0) return null;
  return A * rhoMm3 * 1000; // kg pro 1000 mm = kg/m
}

// Wenn Blech mit fester t aus Dropdown: Sonderberechnung Ã¼ber bÃ—l
function getDirectKgForBlechPreset() {
  const group = document.getElementById('profile-group').value;
  if (group !== 'blech') return null;
  const idx  = parseInt(document.getElementById('profile-size').value, 10);
  const prof = (PROFILES['blech'] || [])[idx];
  if (!prof || !prof.t) return null;

  const rho   = parseFloat(document.getElementById('material').value);
  const rhoMm3= rho / 1e6;
  const b = parseFloat(document.getElementById('dim-b').value) || 0;
  const h = parseFloat(document.getElementById('dim-h').value) || 0;
  if (b <= 0 || h <= 0) return null;
  return b * h * prof.t * rhoMm3;
}

function recalc() {
  const preview = document.getElementById('result-preview');
  const lenMm   = parseFloat(document.getElementById('length-mm').value) || 0;
  const qty      = parseInt(document.getElementById('qty').value, 10) || 1;
  const group    = document.getElementById('profile-group').value;

  // Blech-Preset: Gewicht ohne LÃ¤ngenfeld
  const directBlech = getDirectKgForBlechPreset();
  if (directBlech !== null) {
    const total = directBlech * qty;
    currentKgm = null;
    preview.innerHTML = `<span class="not-italic text-slate-800 font-semibold">
      ${fmt(directBlech)} kg/Stk &nbsp;Â·&nbsp; <strong>${fmt(total)} kg</strong> fÃ¼r ${qty} Stk
    </span>`;
    return;
  }

  const result = calcKgm();
  if (!result) {
    currentKgm = null;
    preview.innerHTML = 'MaÃŸe eingeben um Gewicht zu berechnenâ€¦';
    return;
  }

  // Blech benutzerdefiniert gibt {directKg}
  if (typeof result === 'object' && result.directKg !== undefined) {
    const total = result.directKg * qty;
    currentKgm = null;
    preview.innerHTML = `<span class="not-italic text-slate-800 font-semibold">
      ${fmt(result.directKg)} kg/Stk &nbsp;Â·&nbsp; <strong>${fmt(total)} kg</strong> fÃ¼r ${qty} Stk
    </span>`;
    return;
  }

  currentKgm = result;
  if (lenMm <= 0) {
    preview.innerHTML = `<span class="not-italic text-slate-800">
      <strong>${fmt(result)} kg/m</strong> &nbsp;Â·&nbsp; LÃ¤nge eingeben fÃ¼r Gesamtgewicht
    </span>`;
    return;
  }

  const kgPiece = result * lenMm / 1000;
  const kgTotal = kgPiece * qty;
  preview.innerHTML = `<span class="not-italic text-slate-800 font-semibold">
    ${fmt(result)} kg/m &nbsp;Â·&nbsp; ${fmt(kgPiece)} kg/Stk &nbsp;Â·&nbsp;
    <strong class="text-blue-700">${fmt(kgTotal)} kg</strong> gesamt (${qty} Stk Ã— ${(lenMm/1000).toFixed(3)} m)
  </span>`;
}

// â”€â”€â”€ Liste â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function addToList() {
  const group = document.getElementById('profile-group').value;
  const idx   = parseInt(document.getElementById('profile-size').value, 10);
  const prof  = (PROFILES[group] || [])[idx];
  const matEl = document.getElementById('material');
  const matName = matEl.options[matEl.selectedIndex].text.split(' ')[0];
  const lenMm = parseFloat(document.getElementById('length-mm').value) || 0;
  const qty   = parseInt(document.getElementById('qty').value, 10) || 1;

  // Blech-Preset
  const directBlech = getDirectKgForBlechPreset();
  if (directBlech !== null) {
    push({ label: prof.label, matName, lenMm: 0, qty, kgm: null, kgPiece: directBlech, kgTotal: directBlech * qty, isBlechPreset: true });
    return;
  }

  const result = calcKgm();
  if (!result) { alert('Bitte alle erforderlichen MaÃŸe ausfÃ¼llen.'); return; }

  if (typeof result === 'object' && result.directKg !== undefined) {
    push({ label: buildLabel(), matName, lenMm: 0, qty, kgm: null, kgPiece: result.directKg, kgTotal: result.directKg * qty, isBlechPreset: true });
    return;
  }

  if (lenMm <= 0) { alert('Bitte eine LÃ¤nge eingeben.'); return; }
  const kgPiece = result * lenMm / 1000;
  push({ label: buildLabel(), matName, lenMm, qty, kgm: result, kgPiece, kgTotal: kgPiece * qty });
}

function buildLabel() {
  const group = document.getElementById('profile-group').value;
  const idx   = parseInt(document.getElementById('profile-size').value, 10);
  const prof  = (PROFILES[group] || [])[idx];
  if (prof.kgm !== null) return prof.label;
  // Custom: baue Label aus Eingaben
  const b = document.getElementById('dim-b').value;
  const h = document.getElementById('dim-h').value;
  const t = document.getElementById('dim-t').value;
  const d = document.getElementById('dim-d').value;
  if (group === 'rohr_rund') return `Rohr Ã˜${d}Ã—${t}`;
  if (group === 'rohr_recht') return `Rohr ${b}Ã—${h}Ã—${t}`;
  if (group === 'flach')  return `Flach ${b}Ã—${t}`;
  if (group === 'blech')  return `Blech ${b}Ã—${h}Ã—${t}`;
  if (group === 'rundstahl') return `Rund Ã˜${d}`;
  if (group === 'vierkantstahl') return `Vierkant ${d}Ã—${d}`;
  return prof.label;
}

function push(item) {
  posCounter++;
  item.pos = posCounter;
  positions.push(item);
  renderList();
}

function deletePos(pos) {
  positions = positions.filter(p => p.pos !== pos);
  renderList();
}

function renderList() {
  const tbody = document.getElementById('list-body');
  const empty = document.getElementById('empty-row');
  const footer= document.getElementById('total-footer');
  const badge = document.getElementById('total-badge');

  if (positions.length === 0) {
    tbody.innerHTML = '';
    tbody.appendChild(empty);
    empty.classList.remove('hidden');
    footer.classList.add('hidden');
    badge.textContent = 'Gesamt: 0,00 kg';
    return;
  }

  empty.classList.add('hidden');
  footer.classList.remove('hidden');

  let totalKg = 0;
  tbody.innerHTML = '';
  positions.forEach(p => {
    totalKg += p.kgTotal;
    const tr = document.createElement('tr');
    tr.className = 'hover:bg-slate-50';
    tr.innerHTML = `
      <td class="p-3 text-slate-400 text-xs font-mono">${p.pos}</td>
      <td class="p-3 font-semibold text-slate-800">${p.label}</td>
      <td class="p-3 text-slate-500 text-xs">${p.matName}</td>
      <td class="p-3 text-slate-600 text-xs">${p.lenMm > 0 ? (p.lenMm/1000).toFixed(3)+' m' : 'â€“'}</td>
      <td class="p-3 text-slate-600">${p.qty}</td>
      <td class="p-3 text-right text-slate-500 text-xs">${p.kgm !== null ? fmt(p.kgm) : 'â€“'}</td>
      <td class="p-3 text-right font-bold text-slate-800">${fmt(p.kgTotal)}</td>
      <td class="p-3 text-right">
        <button onclick="deletePos(${p.pos})"
          class="text-red-400 hover:text-red-600 text-xs px-2 py-1 rounded hover:bg-red-50 transition">ðŸ—‘ï¸</button>
      </td>`;
    tbody.appendChild(tr);
  });

  document.getElementById('total-kg').textContent = fmt(totalKg) + ' kg';
  document.getElementById('total-t').textContent  = '= ' + (totalKg/1000).toFixed(3) + ' t';
  badge.textContent = 'Gesamt: ' + fmt(totalKg) + ' kg';
}

function clearAll() {
  if (positions.length === 0) return;
  if (!confirm('Alle Positionen lÃ¶schen?')) return;
  positions = [];
  posCounter = 0;
  renderList();
}

function printList() {
  window.print();
}

// Zahlenformatierung DE
function fmt(n) {
  return n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

