<%- include('partials/header') %>
<%- include('partials/sidebar') %>
<link rel="stylesheet" href="/css/document-studio.css">
<main class="flex-1 flex flex-col overflow-y-auto page-bg min-h-screen pt-20">
 <div class="doc-shell">
  <header class="doc-header"><div><div class="doc-eyebrow">Verkauf &amp; Finanzen</div><h1>Angebote &amp; Rechnungen</h1><p>Von der ersten Kalkulation bis zur bezahlten Rechnung.</p></div><div class="doc-header-actions"><a class="doc-action" href="/documents/neu/angebot">＋ Angebot erstellen</a><a class="doc-action primary" href="/documents/neu/rechnung">＋ Rechnung erstellen</a></div></header>
  <nav class="doc-nav" aria-label="Dokumente"><a class="active" aria-current="page" href="/documents/buero">Übersicht</a><a href="/documents/offers">Angebote</a><a href="/documents/invoices">Rechnungen</a><a href="/documents/open-items">Offene Posten</a></nav>
  <div class="doc-overview">
   <a class="doc-metric" href="/documents/open-items"><small>Offene Rechnungen</small><strong><%= openCount %></strong><span><% if (canSeeMoney) { %><%= openSum.toLocaleString('de-DE', {style:'currency',currency:'EUR'}) %> ausstehend<% } else { %>Offene Posten ansehen<% } %> →</span></a>
   <a class="doc-metric <%= overdueCount ? 'alert' : '' %>" href="/documents/open-items"><small>Überfällig</small><strong><%= overdueCount %></strong><span>Fälligkeiten prüfen →</span></a>
   <a class="doc-metric" href="/documents/invoices"><small>Rechnungsentwürfe</small><strong><%= draftCount %></strong><span>Rechnungen ansehen →</span></a>
   <a class="doc-metric" href="/documents/offers"><small>Offene Angebote</small><strong><%= waitingOffers %></strong><span>Angebote ansehen →</span></a>
  </div>
  <section class="doc-section" aria-labelledby="recent-heading"><div class="doc-section-head"><div><h2 id="recent-heading">Zuletzt erstellt</h2><p>Ihre letzten Angebote und Rechnungen</p></div><a href="/documents/invoices">Alle Rechnungen →</a></div>
   <% if (recent.length) { %><div class="doc-search-wrap"><input class="doc-search" id="doc-recent-search" type="search" placeholder="Nummer, Kunde oder Status suchen" aria-label="Letzte Belege durchsuchen"></div><% } %>
   <div id="doc-recent-list"><% if (!recent.length) { %><p class="doc-empty">Noch keine Belege vorhanden. Erstellen Sie ein Angebot oder eine Rechnung.</p><% } %>
   <% recent.forEach(function(d) { const invoice=d.doc_type==='INVOICE', who=d.company_name||d.contact_person||'Kein Kunde', href=invoice?'/documents/invoices/'+d.id:'/documents/offers/'+d.id+'/detail'; %>
    <a class="doc-record" href="<%= href %>"><span class="icon" aria-hidden="true"><%= invoice ? 'R' : 'A' %></span><span><span class="title"><%= d.doc_number || 'Ohne Nummer' %> · <%= who %></span><span class="meta"><%= d.created_at ? String(d.created_at).slice(0,10).split('-').reverse().join('.') : '' %> · <%= d.status || 'Offen' %></span></span><span class="tag"><%= invoice?'Rechnung':'Angebot' %></span><% if (canSeeMoney) { %><span class="amount"><%= (Number(d.total_amount)||0).toLocaleString('de-DE',{style:'currency',currency:'EUR'}) %></span><% } %></a>
   <% }); %></div><p class="doc-empty" id="doc-recent-empty" hidden>Keine passenden Belege gefunden.</p>
  </section>
  <details class="doc-section"><summary>Weitere Werkzeuge &amp; Exporte</summary><div class="doc-tools"><a href="/documents/offers">Vorlagen &amp; Stahlpreise</a><a href="/documents/recurring">Wiederkehrende Rechnungen</a><a href="/documents/bank-import">Bank-Import</a><a href="/documents/invoices/datev-export">DATEV-Export</a><a href="/customers">Kunden</a><a href="/articles">Artikelstamm</a></div></details>
 </div>
</main>
<script>const search=document.getElementById('doc-recent-search');if(search)search.addEventListener('input',()=>{let count=0;document.querySelectorAll('#doc-recent-list .doc-record').forEach(row=>{row.hidden=!row.textContent.toLocaleLowerCase('de').includes(search.value.trim().toLocaleLowerCase('de'));if(!row.hidden)count++;});document.getElementById('doc-recent-empty').hidden=count>0;});</script>
</body></html>
