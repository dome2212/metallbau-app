<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="max-w-5xl mx-auto px-4 pb-24 pt-4">
  <div class="mb-4">
    <a href="/einkauf/orders" class="text-sm text-blue-600 font-semibold">← Bestellungen</a>
    <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100 mt-1">Bestellung #<%= po.id %></h1>
    <p class="text-xs text-slate-500"><%= po.supplier_name || '—' %> · Status: <strong><%= po.status %></strong></p>
  </div>

  <% if (success) { %>
  <div class="mb-4 rounded-lg bg-green-50 text-green-700 text-sm px-4 py-2">Gespeichert.</div>
  <% } %>

  <div class="flex flex-wrap gap-2 mb-4">
    <form method="POST" action="/einkauf/orders/<%= po.id %>/delete" onsubmit="return confirm('Bestellung #<%= po.id %> wirklich unwiderruflich löschen?');">
      <button type="submit" class="px-4 py-2 rounded-lg border border-red-300 text-red-600 text-sm font-semibold hover:bg-red-50">Bestellung löschen</button>
    </form>
  </div>

  <!-- Lieferschein scannen -->
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 mb-4" id="lieferschein-scan">
    <h2 class="text-sm font-semibold mb-1">Lieferschein scannen</h2>
    <p class="text-xs text-slate-500 mb-3">Galerie oder Kamera – die KI liest die Positionen und füllt die Bestellung.</p>
    <div class="flex flex-wrap gap-2 items-center">
      <input type="file" id="ls-file" accept="image/*" class="hidden">
      <input type="file" id="ls-file-camera" accept="image/*" capture="environment" class="hidden">
      <button type="button" id="ls-gallery-btn" class="px-4 py-2.5 rounded-lg border dark:border-slate-600 text-sm font-semibold bg-slate-50 dark:bg-slate-700">
        🖼️ Galerie
      </button>
      <button type="button" id="ls-camera-btn" class="px-4 py-2.5 rounded-lg border dark:border-slate-600 text-sm font-semibold bg-slate-50 dark:bg-slate-700">
        📷 Kamera
      </button>
      <button type="button" id="ls-scan-btn" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2.5 rounded-lg text-sm">
        Einscannen
      </button>
    </div>
    <p id="ls-filename" class="text-xs text-slate-400 mt-2">Keine Datei gewählt</p>
    <p id="ls-status" class="text-xs text-slate-500 mt-2 hidden"></p>
    <div id="ls-preview" class="mt-3 hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="ls-table">
          <thead><tr class="text-left text-xs text-slate-500 border-b dark:border-slate-600"><th>Beschreibung</th><th>Menge</th><th>Einh.</th><th>EK €</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
      <label class="flex items-center gap-2 text-xs mt-3">
        <input type="checkbox" id="ls-replace" checked> Bestehende Positionen ersetzen
      </label>
      <button type="button" id="ls-apply-btn" class="mt-2 bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded-lg text-sm">
        In Bestellung übernehmen
      </button>
    </div>
  </div>

  <form method="POST" action="/einkauf/orders/<%= po.id %>/update" class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 mb-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
    <select name="supplier_id" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
      <option value="">— Lieferant —</option>
      <% (suppliers || []).forEach(function(s) { %>
      <option value="<%= s.id %>" <%= String(po.supplier_id)===String(s.id)?'selected':'' %>><%= s.name %></option>
      <% }) %>
    </select>
    <select name="project_id" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
      <option value="">— Auftrag —</option>
      <% (projects || []).forEach(function(p) { %>
      <option value="<%= p.id %>" <%= String(po.project_id)===String(p.id)?'selected':'' %>><%= p.title %></option>
      <% }) %>
    </select>
    <input name="order_number" value="<%= po.order_number || '' %>" placeholder="Bestellnr." class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
    <input name="expected_at" type="date" value="<%= po.expected_at || '' %>" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
    <select name="status" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
      <% ['ENTWURF','BESTELLT','TEILWEISE','GELIEFERT','STORNIERT'].forEach(function(st) { %>
      <option value="<%= st %>" <%= po.status===st?'selected':'' %>><%= st %></option>
      <% }) %>
    </select>
    <textarea name="notes" rows="2" class="sm:col-span-2 border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm"><%= po.notes || '' %></textarea>
    <div class="sm:col-span-2 flex justify-end">
      <button class="bg-blue-600 text-white font-semibold px-5 py-2 rounded-lg text-sm">Kopf speichern</button>
    </div>
  </form>

  <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 mb-4">
    <h2 class="text-sm font-semibold mb-3">Positionen <span class="text-slate-400 font-normal">(Summe <%= Number(total||0).toLocaleString('de-DE',{minimumFractionDigits:2}) %> €)</span></h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="text-left text-xs text-slate-500 border-b dark:border-slate-600">
          <th class="py-2">Beschreibung</th><th>Menge</th><th>EK €</th><th>Geliefert</th><th></th>
        </tr></thead>
        <tbody>
        <% (items || []).forEach(function(i) { %>
          <tr class="border-b dark:border-slate-700">
            <td class="py-2 pr-2"><%= i.description %><% if (i.lager_name) { %><br><span class="text-xs text-slate-400">Lager: <%= i.lager_name %></span><% } %></td>
            <td><%= i.quantity %> <%= i.unit %></td>
            <td><%= Number(i.unit_price||0).toFixed(2) %></td>
            <td><%= i.received_qty || 0 %></td>
            <td>
              <form method="POST" action="/einkauf/orders/<%= po.id %>/items/<%= i.id %>/delete" onsubmit="return confirm('Position löschen?')">
                <button class="text-red-600 text-xs">✕</button>
              </form>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>

    <form method="POST" action="/einkauf/orders/<%= po.id %>/items" class="mt-4 grid grid-cols-2 sm:grid-cols-5 gap-2">
      <input name="description" required placeholder="Beschreibung *" class="col-span-2 border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2 text-sm">
      <input name="quantity" value="1" placeholder="Menge" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2 text-sm">
      <input name="unit" value="Stk" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2 text-sm">
      <input name="unit_price" placeholder="EK €" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2 text-sm">
      <select name="lager_item_id" class="col-span-2 sm:col-span-4 border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2 text-sm">
        <option value="">— optional Lagerartikel (Wareneingang bucht Bestand) —</option>
        <% (lager || []).forEach(function(l) { %>
        <option value="<%= l.id %>"><%= l.bezeichnung %><%= l.profil ? ' / '+l.profil : '' %></option>
        <% }) %>
      </select>
      <button class="bg-slate-800 dark:bg-slate-600 text-white rounded-lg text-sm font-semibold">+ Position</button>
    </form>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4">
    <h2 class="text-sm font-semibold mb-3">Wareneingang buchen</h2>
    <p class="text-xs text-slate-500 mb-3">Mengen, die jetzt ankommen. Bei verknüpftem Lagerartikel wird der Bestand erhöht und der EK-Preis aktualisiert.</p>
    <form method="POST" action="/einkauf/orders/<%= po.id %>/receive" class="space-y-2">
      <% (items || []).forEach(function(i) { %>
      <div class="flex items-center gap-3 text-sm">
        <span class="flex-1 truncate"><%= i.description %></span>
        <span class="text-slate-400 text-xs">offen <%= Math.max(0, Number(i.quantity)-Number(i.received_qty||0)) %></span>
        <input name="recv_<%= i.id %>" type="number" step="0.001" min="0" placeholder="0" class="w-24 border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2 text-sm">
      </div>
      <% }) %>
      <div class="flex justify-end pt-2">
        <button class="bg-green-600 hover:bg-green-700 text-white font-semibold px-5 py-2.5 rounded-lg text-sm">Wareneingang speichern</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  var poId = <%= po.id %>;
  var fileInput = document.getElementById('ls-file');
  var cameraInput = document.getElementById('ls-file-camera');
  var activeInput = null;
  var scanBtn = document.getElementById('ls-scan-btn');
  var galleryBtn = document.getElementById('ls-gallery-btn');
  var cameraBtn = document.getElementById('ls-camera-btn');
  var applyBtn = document.getElementById('ls-apply-btn');
  var statusEl = document.getElementById('ls-status');
  var nameEl = document.getElementById('ls-filename');
  var preview = document.getElementById('ls-preview');
  var tbody = document.querySelector('#ls-table tbody');
  var scanned = [];
  var meta = {};

  function setStatus(msg, show) {
    if (!statusEl) return;
    statusEl.textContent = msg || '';
    statusEl.classList.toggle('hidden', !show);
  }

  function onFilePicked(inp) {
    activeInput = inp;
    var f = inp && inp.files && inp.files[0];
    if (nameEl) nameEl.textContent = f ? (f.name + ' (' + Math.round(f.size / 1024) + ' KB)') : 'Keine Datei gewählt';
  }

  if (fileInput) fileInput.addEventListener('change', function () { onFilePicked(fileInput); });
  if (cameraInput) cameraInput.addEventListener('change', function () { onFilePicked(cameraInput); });
  if (galleryBtn) galleryBtn.addEventListener('click', function () {
    if (fileInput) { fileInput.value = ''; fileInput.click(); }
  });
  if (cameraBtn) cameraBtn.addEventListener('click', function () {
    if (cameraInput) { cameraInput.value = ''; cameraInput.click(); }
  });

  function renderItems(items) {
    scanned = items || [];
    if (!tbody) return;
    tbody.innerHTML = '';
    scanned.forEach(function (it, idx) {
      var tr = document.createElement('tr');
      tr.className = 'border-b dark:border-slate-700';
      function esc(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;'); }
      tr.innerHTML =
        '<td class="py-1.5 pr-2"><input data-i="' + idx + '" data-f="description" class="w-full border dark:border-slate-600 dark:bg-slate-700 rounded p-1 text-sm" value="' + esc(it.description) + '"></td>' +
        '<td><input data-i="' + idx + '" data-f="quantity" type="number" step="any" class="w-20 border dark:border-slate-600 dark:bg-slate-700 rounded p-1 text-sm" value="' + (it.quantity || 1) + '"></td>' +
        '<td><input data-i="' + idx + '" data-f="unit" class="w-16 border dark:border-slate-600 dark:bg-slate-700 rounded p-1 text-sm" value="' + esc(it.unit || 'Stk') + '"></td>' +
        '<td><input data-i="' + idx + '" data-f="unit_price" type="number" step="0.01" class="w-24 border dark:border-slate-600 dark:bg-slate-700 rounded p-1 text-sm" value="' + (it.unit_price != null ? it.unit_price : 0) + '"></td>';
      tbody.appendChild(tr);
    });
    if (preview) preview.classList.toggle('hidden', !scanned.length);
  }

  function collectItems() {
    var out = scanned.map(function (it) { return Object.assign({}, it); });
    if (tbody) tbody.querySelectorAll('input[data-i]').forEach(function (inp) {
      var i = Number(inp.getAttribute('data-i'));
      var f = inp.getAttribute('data-f');
      if (!out[i]) return;
      out[i][f] = (f === 'quantity' || f === 'unit_price') ? Number(inp.value) : inp.value;
    });
    return out.filter(function (it) { return String(it.description || '').trim(); });
  }

  if (scanBtn) scanBtn.addEventListener('click', async function () {
    var src = activeInput;
    if (!src || !src.files || !src.files[0]) {
      setStatus('Bitte zuerst Galerie oder Kamera tippen und ein Bild wählen.', true);
      return;
    }
    setStatus('KI liest den Lieferschein …', true);
    scanBtn.disabled = true;
    try {
      var fd = new FormData();
      fd.append('image', src.files[0]);
      var res = await fetch('/einkauf/orders/' + poId + '/scan-lieferschein', {
        method: 'POST',
        body: fd,
        credentials: 'same-origin'
      });
      var data = await res.json();
      if (!res.ok) throw new Error(data.error || ('Fehler ' + res.status));
      meta = data.meta || {};
      renderItems(data.items || []);
      if (!(data.items || []).length) {
        setStatus('Keine Positionen erkannt. Anderes Foto versuchen.', true);
      } else {
        var m = [];
        if (meta.lieferschein_nr) m.push('LS ' + meta.lieferschein_nr);
        if (meta.lieferdatum) m.push(meta.lieferdatum);
        if (meta.supplier_name) m.push(meta.supplier_name);
        setStatus(data.items.length + ' Position(en) erkannt' + (m.length ? ' · ' + m.join(' · ') : '') + '. Prüfen und übernehmen.', true);
      }
    } catch (err) {
      setStatus(err.message || 'Scan fehlgeschlagen', true);
    } finally {
      scanBtn.disabled = false;
    }
  });

  if (applyBtn) applyBtn.addEventListener('click', async function () {
    var items = collectItems();
    if (!items.length) return setStatus('Keine Positionen zum Übernehmen.', true);
    applyBtn.disabled = true;
    setStatus('Übernehme Positionen …', true);
    try {
      var res = await fetch('/einkauf/orders/' + poId + '/apply-scan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          items: items,
          replace: document.getElementById('ls-replace').checked,
          order_number: meta.lieferschein_nr || '',
          notes: meta.lieferschein_nr ? ('Lieferschein ' + meta.lieferschein_nr + (meta.lieferdatum ? ' vom ' + meta.lieferdatum : '')) : ''
        })
      });
      var data = await res.json().catch(function () { return {}; });
      if (!res.ok) throw new Error(data.error || ('Fehler ' + res.status));
      window.location.href = '/einkauf/orders/' + poId + '?saved=1';
    } catch (err) {
      setStatus(err.message || 'Übernehmen fehlgeschlagen', true);
      applyBtn.disabled = false;
    }
  });
})();
</script>

