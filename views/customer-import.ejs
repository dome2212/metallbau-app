<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 min-h-screen page-bg dark:bg-slate-900 pt-14">
  <div class="max-w-4xl mx-auto px-4 md:px-6 py-4 space-y-4">

    <div class="flex items-center justify-between gap-2 flex-wrap">
      <div>
        <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100">Kunden importieren</h1>
        <p class="text-xs text-slate-500 mt-0.5">Excel (.xlsx) oder CSV aus einem anderen Programm</p>
      </div>
      <a href="/customers" class="text-xs font-semibold text-blue-600 hover:underline">← Zur Kundenliste</a>
    </div>

    <% if (error) { %>
    <div class="rounded-xl border border-red-200 bg-red-50 dark:bg-red-900/20 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-300">
      <%= error %>
    </div>
    <% } %>

    <% if (result) { %>
    <div class="rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50/50 dark:bg-emerald-900/20 p-5 space-y-2">
      <h2 class="text-sm font-bold text-emerald-800 dark:text-emerald-200">Import abgeschlossen</h2>
      <ul class="text-sm text-slate-700 dark:text-slate-200 space-y-1">
        <li><strong><%= result.inserted %></strong> neu angelegt</li>
        <li><strong><%= result.updated %></strong> aktualisiert</li>
        <li><strong><%= result.skipped %></strong> übersprungen (Duplikate)</li>
        <li class="text-xs text-slate-400"><%= result.total %> Zeilen verarbeitet</li>
      </ul>
      <div class="flex gap-2 pt-2">
        <a href="/customers" class="text-xs px-3 py-2 rounded-lg bg-emerald-600 text-white font-semibold">Zur Kundenliste</a>
        <a href="/customers/import" class="text-xs px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-600 font-semibold">Weiteren Import</a>
      </div>
    </div>
    <% } else if (preview && preview.length) { %>
    <div class="rounded-2xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4 space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">Vorschau · <%= preview.length %> Kunden</h2>
          <% if (typeof filename !== 'undefined') { %><p class="text-[11px] text-slate-400"><%= filename %></p><% } %>
        </div>
        <p class="text-[11px] text-slate-500">
          <%= preview.filter(r => r._matchId).length %> mögliche Duplikate erkannt
        </p>
      </div>

      <div class="overflow-x-auto max-h-80 border border-slate-100 dark:border-slate-700 rounded-xl">
        <table class="w-full text-left text-xs min-w-[640px]">
          <thead class="bg-slate-50 dark:bg-slate-700/50 sticky top-0">
            <tr>
              <th class="px-3 py-2">Firma</th>
              <th class="px-3 py-2">Kontakt</th>
              <th class="px-3 py-2">Ort</th>
              <th class="px-3 py-2">Kd-Nr</th>
              <th class="px-3 py-2">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            <% preview.slice(0, 100).forEach(function(r) { %>
            <tr>
              <td class="px-3 py-2 font-medium text-slate-800 dark:text-slate-100"><%= r.company_name || '—' %></td>
              <td class="px-3 py-2 text-slate-500"><%= r.contact_person || r.email || '—' %></td>
              <td class="px-3 py-2 text-slate-500"><%= [r.zip, r.city].filter(Boolean).join(' ') || '—' %></td>
              <td class="px-3 py-2 text-slate-500"><%= r.customer_number || '—' %></td>
              <td class="px-3 py-2">
                <% if (r._matchId) { %>
                  <span class="text-amber-600 font-semibold">Duplikat (<%= r._matchReason %>)</span>
                <% } else { %>
                  <span class="text-emerald-600 font-semibold">Neu</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (preview.length > 100) { %>
        <p class="text-[11px] text-slate-400">Es werden die ersten 100 Zeilen angezeigt. Alle <%= preview.length %> werden importiert.</p>
      <% } %>

      <form action="/customers/import/confirm" method="POST" class="space-y-3 pt-1">
        <input type="hidden" name="payload" value="<%= payload %>">
        <div class="space-y-2 text-sm">
          <label class="flex items-start gap-2 cursor-pointer">
            <input type="radio" name="mode" value="skip" checked class="mt-1">
            <span><strong>Duplikate überspringen</strong> – nur neue Kunden anlegen</span>
          </label>
          <label class="flex items-start gap-2 cursor-pointer">
            <input type="radio" name="mode" value="update" class="mt-1">
            <span><strong>Duplikate aktualisieren</strong> – bestehende Datensätze mit neuen Werten überschreiben (leere Felder bleiben)</span>
          </label>
        </div>
        <button type="submit" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold">
          Import starten (<%= preview.length %>)
        </button>
      </form>
    </div>
    <% } else { %>

    <div class="rounded-2xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4 space-y-4">
      <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">Datei hochladen</h2>
      <form action="/customers/import" method="POST" enctype="multipart/form-data" class="space-y-3">
        <input type="file" name="file" accept=".csv,.txt,.xlsx,.xls" required
          class="block w-full text-sm text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700">
        <button type="submit" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold">
          Datei prüfen
        </button>
      </form>
      <p class="text-xs text-slate-500">
        <a href="/customers/import/template" class="text-blue-600 font-semibold hover:underline">Vorlage herunterladen (CSV)</a>
        – öffnen in Excel, ausfüllen, speichern als CSV oder XLSX.
      </p>
    </div>

    <div class="rounded-2xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4 space-y-2">
      <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">So funktioniert’s</h2>
      <ol class="text-sm text-slate-600 dark:text-slate-300 list-decimal pl-5 space-y-1">
        <li>Im alten Programm Kunden als <strong>Excel</strong> oder <strong>CSV</strong> exportieren.</li>
        <li>Spalten idealerweise: Firma, Ansprechpartner, E-Mail, Telefon, Straße, PLZ, Ort, Kundennummer.</li>
        <li>Datei hier hochladen → Vorschau prüfen → Import bestätigen.</li>
      </ol>
      <p class="text-xs text-slate-400 pt-1">
        Erkannte Spaltennamen (deutsch/englisch): Firma, Name, Ansprechpartner, E-Mail, Telefon, Straße, PLZ, Ort, Kundennummer, USt-IdNr, Leitweg-ID, Notizen.
        Trennzeichen bei CSV: Semikolon oder Komma.
      </p>
      <p class="text-xs text-amber-700 dark:text-amber-300">
        Empfohlen: Datei als <strong>CSV</strong> speichern (Excel → Speichern unter → CSV UTF-8). Das funktioniert auf Render ohne Extra-Paket.
      </p>
    </div>
    <% } %>

  </div>
</main>
</body>
</html>
