<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Zeichnung freigeben</title><style>body{font:16px system-ui;max-width:900px;margin:2rem auto;padding:0 1rem;color:#1a3442}iframe{width:100%;height:60vh;border:1px solid #aabcc5}label{display:block;margin:1rem 0}input[type=text]{display:block;padding:.6rem;width:min(100%,400px)}canvas{display:block;max-width:100%;border:1px solid #aabcc5;touch-action:none}button{padding:.7rem 1rem;cursor:pointer}#status{min-height:1.5em}</style></head><body><h1>Zeichnung zur Kundenfreigabe</h1><p>Revision <%= revision %> · gültig bis <%= expires %></p><p>Prüfsumme SHA-256: <code><%= hash %></code></p><iframe title="Kundenzeichnung mit 3D-Ansicht" src="/cad-approval/<%= token %>/drawing.pdf"></iframe><p><a href="/cad-approval/<%= token %>/drawing.pdf" target="_blank" rel="noopener noreferrer">PDF öffnen</a></p><% if(typeof offerNumber!=='undefined'&&offerNumber){ %><h2>Angebot <%= offerNumber %> · gespeicherter Freigabestand</h2><p>Prüfsumme SHA-256: <code><%= offerHash %></code></p><iframe title="Angebot zum Zeichnungsstand" src="/cad-approval/<%= token %>/offer.pdf"></iframe><p><a href="/cad-approval/<%= token %>/offer.pdf" target="_blank" rel="noopener noreferrer">Gespeichertes Angebot öffnen</a></p><% } %><% if(approved){ %><p>Freigegeben am <%= approved %> durch <%= signer %>.</p><% }else{ %><form id="approval-form"><label>Name<input name="name" type="text" maxlength="100" required></label><label>Unterschrift (optional)<canvas id="signature" width="600" height="160" aria-label="Unterschrift mit Finger oder Maus zeichnen"></canvas></label><button id="clear" type="button">Unterschrift löschen</button><label><input type="checkbox" name="consent" required> Ich habe die oben dargestellte Zeichnung<%= typeof offerNumber!=='undefined'&&offerNumber?' und den beigefügten Angebotsstand':'' %> geprüft und gebe diesen gespeicherten Stand frei.</label><button type="submit">Zeichnung freigeben</button></form><p id="status" role="status"></p><script src="/js/cad-approval.js" defer></script><% } %></body></html>
