<%- include('partials/header') %>

<div class="flex h-screen bg-slate-100 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 min-h-screen pt-16 md:pt-6">
    <header class="bg-white shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 mb-6">
      <h1 class="text-xl md:text-2xl font-bold text-slate-800">📊 Monatsauswertung Stempeluhr</h1>
      <span class="text-sm font-semibold text-slate-600 bg-slate-100 px-3 py-1 rounded-lg">
        Gesamt: <strong id="total-display">wird berechnet...</strong>
      </span>
    </header>

    <div class="px-4 md:px-6 max-w-7xl mx-auto w-full space-y-6 pb-6">

      <!-- Filter-Leiste -->
      <div class="bg-white p-4 rounded-xl shadow">
        <form method="GET" action="/timetracking/admin/monthly" class="flex flex-wrap gap-4 items-end">
          <% if (currentUser.role === 'ADMIN') { %>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">Mitarbeiter</label>
              <select name="user_id" class="text-sm border border-slate-300 rounded-lg px-3 py-2 bg-white">
                <% users.forEach(u => { %>
                  <option value="<%= u.id %>" <%= Number(selectedUserId) === Number(u.id) ? 'selected' : '' %>><%= u.username %></option>
                <% }) %>
              </select>
            </div>
          <% } %>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Monat wählen</label>
            <input type="month" name="month" value="<%= selectedMonth %>" class="text-sm border border-slate-300 rounded-lg px-3 py-2 bg-white">
          </div>
          <div class="flex gap-2">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">Filtern</button>
            <a href="/timetracking/admin/export-csv?month=<%= selectedMonth %>&user_id=<%= selectedUserId %>"
               class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition flex items-center gap-1">
              📥 CSV Export
            </a>
          </div>
        </form>
      </div>

      <!-- Tabelle der Zeiteinträge -->
      <div class="bg-white rounded-xl shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm min-w-[500px]">
            <thead class="bg-slate-50 text-slate-600 text-xs uppercase border-b">
              <tr>
                <th class="p-4">Datum</th>
                <th class="p-4">Uhrzeit</th>
                <th class="p-4">Typ</th>
                <th class="p-4">Notiz</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200" id="entries-body">
              <% if (entries && entries.length > 0) { %>
                <% entries.forEach(entry => { %>
                  <% const ts = new Date(entry.timestamp); %>
                  <tr class="hover:bg-slate-50">
                    <td class="p-4 font-medium text-slate-800"><%= ts.toLocaleDateString('de-DE') %></td>
                    <td class="p-4 text-slate-600"><%= ts.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) %> Uhr</td>
                    <td class="p-4">
                      <% if (entry.type === 'IN') { %>
                        <span class="bg-green-100 text-green-700 text-xs font-semibold px-2.5 py-1 rounded-md">Eingestempelt (IN)</span>
                      <% } else { %>
                        <span class="bg-red-100 text-red-700 text-xs font-semibold px-2.5 py-1 rounded-md">Ausgestempelt (OUT)</span>
                      <% } %>
                    </td>
                    <td class="p-4 text-slate-500"><%= entry.note || '-' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="p-6 text-center text-slate-400 italic text-sm">Keine Einträge für diesen Monat gefunden.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>

<script>
// Gesamtstunden clientseitig berechnen (IN/OUT Paare)
(function() {
  const entries = <%- JSON.stringify(entries || []) %>;
  let totalMs = 0;
  const now = Date.now();

  for (let i = 0; i < entries.length; i++) {
    if (entries[i].type !== 'IN') continue;
    const start = new Date(entries[i].timestamp).getTime();
    const next = entries[i + 1];
    const end = (next && next.type === 'OUT') ? new Date(next.timestamp).getTime() : now;
    if (end > start) totalMs += (end - start);
  }

  const h = Math.floor(totalMs / 3600000);
  const m = Math.floor((totalMs % 3600000) / 60000);
  document.getElementById('total-display').textContent = h + ' Std. ' + m + ' Min.';
})();
</script>

</body>
</html>
