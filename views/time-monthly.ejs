<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Monatsauswertung Zeiterfassung</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 flex h-screen overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto">
    <header class="bg-white shadow px-6 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-slate-800">📊 Monatsauswertung Stempeluhr</h1>
      <span class="text-sm font-semibold text-slate-600">Gesamt: <%= totalHoursFormatted %></span>
    </header>

    <div class="p-6 max-w-7xl mx-auto w-full space-y-6">
      
      <!-- Filter-Leiste (Monat & Mitarbeiter) -->
      <form method="GET" action="/time-tracking/monthly" class="bg-white p-4 rounded-lg shadow flex flex-wrap gap-4 items-end">
        <% if (currentUser.role === 'ADMIN') { %>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Mitarbeiter</label>
            <select name="user_id" class="text-sm border border-slate-300 rounded px-3 py-2 bg-white">
              <% users.forEach(u => { %>
                <option value="<%= u.id %>" <%= Number(selectedUserId) === Number(u.id) ? 'selected' : '' %>><%= u.username %></option>
              <% }) %>
            </select>
          </div>
        <% } %>

        <div>
          <label class="block text-xs font-medium text-slate-700 mb-1">Monat wählen</label>
          <input type="month" name="month" value="<%= selectedMonth %>" class="text-sm border border-slate-300 rounded px-3 py-2 bg-white">
        </div>

        <div class="flex gap-2">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-4 py-2 rounded transition">Filtern</button>
          <a href="/time-tracking/export-csv?month=<%= selectedMonth %>&user_id=<%= selectedUserId %>" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium px-4 py-2 rounded transition flex items-center">📥 CSV Export</a>
        </div>
      </form>

      <!-- Tabelle der Zeiteinträge -->
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 text-slate-600 border-b">
              <th class="p-3">Datum</th>
              <th class="p-3">Start</th>
              <th class="p-3">Ende</th>
              <th class="p-3">Pause</th>
              <th class="p-3">Notiz</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <% if (entries && entries.length > 0) { %>
              <% entries.forEach(entry => { %>
                <tr class="hover:bg-slate-50">
                  <td class="p-3 font-medium text-slate-800"><%= new Date(entry.start_time).toLocaleDateString('de-DE') %></td>
                  <td class="p-3 text-slate-600"><%= new Date(entry.start_time).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) %></td>
                  <td class="p-3 text-slate-600"><%= entry.end_time ? new Date(entry.end_time).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) : 'Aktiv' %></td>
                  <td class="p-3 text-slate-600"><%= entry.break_minutes || 0 %> Min.</td>
                  <td class="p-3 text-slate-600"><%= entry.note || '-' %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="p-4 text-center text-xs text-slate-400 italic">Keine Einträge für diesen Monat gefunden.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>
  </main>
</body>
</html>
