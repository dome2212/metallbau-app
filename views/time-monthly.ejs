<%- include('partials/header') %>

<%- include('partials/sidebar') %>
<main class="flex-1 flex flex-col overflow-y-auto md:ml-72 page-bg min-h-screen pt-16 md:pt-6">
    <header class="bg-white dark:bg-slate-800 shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 mb-6">
      <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100">ðŸ“Š Monatsauswertung Stempeluhr</h1>
      <span class="text-sm font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 px-3 py-1 rounded-lg">
        Gesamt: <strong id="total-display">wird berechnet...</strong>
      </span>
    </header>

    <div class="px-4 md:px-6 max-w-7xl mx-auto w-full space-y-6 pb-6">

      <!-- Filter-Leiste -->
      <div class="bg-white dark:bg-slate-800 p-4 rounded-xl shadow">
        <form method="GET" action="/timetracking/admin/monthly" class="flex flex-wrap gap-4 items-end">
          <% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') { %>
            <div>
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Mitarbeiter</label>
              <select name="user_id" class="text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-3 py-2 bg-white">
                <% users.forEach(u => { %>
                  <option value="<%= u.id %>" <%= Number(selectedUserId) === Number(u.id) ? 'selected' : '' %>><%= u.username %></option>
                <% }) %>
              </select>
            </div>
          <% } %>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Monat wÃ¤hlen</label>
            <input type="month" name="month" value="<%= selectedMonth %>" class="text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-3 py-2 bg-white">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Soll-Std./Tag</label>
            <input type="number" name="daily_hours" value="<%= dailyHours %>" min="1" max="12" step="0.5"
              class="text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-3 py-2 bg-white w-24" title="TÃ¤gliche Sollarbeitszeit in Stunden">
          </div>
          <div class="flex gap-2">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">Filtern</button>
            <a href="/timetracking/admin/export-csv?month=<%= selectedMonth %>&user_id=<%= selectedUserId %>"
               class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition flex items-center gap-1">
              ðŸ“¥ CSV Export
            </a>
          </div>
        </form>
      </div>

      <!-- ===================================================== -->
      <!-- ÃœBERSTUNDEN-KARTE                                     -->
      <!-- ===================================================== -->
      <%
        const ot = parseFloat(overtimeHours);
        const isOver = ot >= 0;
        const otAbs = Math.abs(ot);
        const otH = Math.floor(otAbs);
        const otM = Math.round((otAbs - otH) * 60);
        const otLabel = (isOver ? '+' : '-') + otH + ' Std. ' + otM + ' Min.';
      %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

        <!-- Gearbeitete Stunden -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 border-l-4 border-blue-500">
          <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Gearbeitete Stunden</p>
          <p class="text-2xl font-bold text-slate-800 dark:text-gray-100 mt-1"><%= workedHours %> Std.</p>
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">im Monat <%= selectedMonth %></p>
        </div>

        <!-- Soll-Stunden -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 border-l-4 border-slate-400">
          <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Soll-Stunden (<%= dailyHours %> h/Tag)</p>
          <p class="text-2xl font-bold text-slate-800 dark:text-gray-100 mt-1"><%= targetHours %> Std.</p>
          <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Werktage (Moâ€“Fr) im Monat</p>
        </div>

        <!-- Ãœber-/Minusstunden -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 border-l-4 <%= isOver ? 'border-green-500' : 'border-red-500' %>">
          <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            <%= isOver ? 'Ãœberstunden' : 'Minusstunden' %>
          </p>
          <p class="text-2xl font-bold mt-1 <%= isOver ? 'text-green-600' : 'text-red-600' %>">
            <%= otLabel %>
          </p>
          <p class="text-xs text-slate-400 mt-0.5">Ist âˆ’ Soll</p>
        </div>

      </div>

      <!-- Tabelle der ZeiteintrÃ¤ge -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm min-w-[500px]">
            <thead class="bg-slate-50 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs uppercase border-b dark:border-slate-600">
              <tr>
                <th class="p-4">Datum</th>
                <th class="p-4">Uhrzeit</th>
                <th class="p-4">Typ</th>
                <th class="p-4">Notiz</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-700" id="entries-body">
              <% if (entries && entries.length > 0) { %>
                <% entries.forEach(entry => { %>
                  <% const ts = new Date(entry.timestamp); %>
                  <tr class="hover:bg-slate-50 dark:hover:bg-slate-700">
                    <td class="p-4 font-medium text-slate-800 dark:text-gray-100"><%= ts.toLocaleDateString('de-DE') %></td>
                    <td class="p-4 text-slate-600 dark:text-slate-300"><%= ts.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) %> Uhr</td>
                    <td class="p-4">
                      <% if (entry.type === 'IN') { %>
                        <span class="bg-green-100 text-green-700 text-xs font-semibold px-2.5 py-1 rounded-md">Eingestempelt (IN)</span>
                      <% } else { %>
                        <span class="bg-red-100 text-red-700 text-xs font-semibold px-2.5 py-1 rounded-md">Ausgestempelt (OUT)</span>
                      <% } %>
                    </td>
                    <td class="p-4 text-slate-500 dark:text-slate-400"><%= entry.note || '-' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="p-6 text-center text-slate-400 dark:text-slate-500 italic text-sm">Keine EintrÃ¤ge fÃ¼r diesen Monat gefunden.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>

<script>
// Gesamtstunden clientseitig berechnen (IN/OUT Paare) â€“ fÃ¼r den Header-Badge
(function() {
  const entries = <%- JSON.stringify(entries || []) %>;
  let totalMs = 0;

  for (let i = 0; i < entries.length; i++) {
    if (entries[i].type !== 'IN') continue;
    const start = new Date(entries[i].timestamp).getTime();
    const next = entries[i + 1];
    if (next && next.type === 'OUT') {
      const end = new Date(next.timestamp).getTime();
      if (end > start) totalMs += (end - start);
    }
  }

  const h = Math.floor(totalMs / 3600000);
  const m = Math.floor((totalMs % 3600000) / 60000);
  document.getElementById('total-display').textContent = h + ' Std. ' + m + ' Min.';
})();
</script>

</body>
</html>
