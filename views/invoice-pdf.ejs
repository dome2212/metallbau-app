<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Rechnung <%= invoice.invoice_number %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background-color: #fff; }
      .print-shadow-none { box-shadow: none !important; border: none !important; }
    }
  </style>
</head>
<body class="bg-gray-100 min-h-screen p-8">

  <!-- Action Bar oben (wird beim Drucken/PDF-Speichern ausgeblendet) -->
  <div class="max-w-4xl mx-auto mb-6 flex justify-between items-center no-print">
    <a href="/documents/invoices" class="text-sm font-medium text-gray-600 hover:text-gray-900">← Zurück zur Übersicht</a>
    <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg font-medium shadow flex items-center gap-2">
      🖨️ Als PDF drucken / speichern
    </button>
  </div>

  <!-- Din-A4 Rechnungsblatt -->
  <div class="max-w-4xl mx-auto bg-white p-12 rounded-xl shadow-md print-shadow-none text-gray-800">
    
    <!-- Briefkopf Metallbau -->
    <div class="flex justify-between items-start border-b pb-8 mb-8">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 uppercase tracking-wide">METALLBAU MEISTERBETRIEB</h1>
        <p class="text-xs text-gray-500 mt-1">Stahlbau • Edelstahlverarbeitung • Geländer & Tore</p>
      </div>
      <div class="text-right text-xs text-gray-500 space-y-1">
        <p class="font-bold text-gray-800">Metallbau GmbH</p>
        <p>Industriestraße 12</p>
        <p>12345 Musterstadt</p>
        <p>Tel: 01234 / 56789</p>
        <p>E-Mail: info@metallbau-meister.de</p>
      </div>
    </div>

    <!-- Empfänger & Rechnungs-Metadaten -->
    <div class="grid grid-cols-2 gap-8 mb-10">
      <div>
        <p class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold mb-1">Empfänger</p>
        <p class="font-bold text-lg text-gray-900"><%= invoice.company_name || invoice.contact_person %></p>
        <% if (invoice.company_name && invoice.contact_person) { %>
          <p class="text-sm text-gray-600">z. Hd. <%= invoice.contact_person %></p>
        <% } %>
        <p class="text-sm text-gray-600"><%= invoice.street || '' %></p>
        <p class="text-sm text-gray-600"><%= (invoice.zip || '') + ' ' + (invoice.city || '') %></p>
      </div>

      <div class="bg-gray-50 p-4 rounded-lg text-sm space-y-1">
        <!-- Mahnungs-Header falls Mahnstufe aktiv -->
        <% if (invoice.dunning_level > 0) { %>
          <div class="bg-red-100 text-red-800 font-bold p-2 rounded mb-2 text-center uppercase text-xs">
            <%= invoice.dunning_level === 1 ? '1. Zahlungserinnerung' : invoice.dunning_level === 2 ? '2. Mahnung' : '3. Letzte Mahnung!' %>
          </div>
        <% } %>
        <div class="flex justify-between">
          <span class="text-gray-500">Dokument:</span>
          <span class="font-bold"><%= invoice.dunning_level > 0 ? 'Mahnung zu ' + invoice.invoice_number : 'Rechnung' %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Rechnungs-Nr:</span>
          <span class="font-mono font-bold"><%= invoice.invoice_number %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Datum:</span>
          <span><%= new Date(invoice.created_at).toLocaleDateString('de-DE') %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Fällig am:</span>
          <span class="<%= new Date(invoice.due_date) < new Date() && invoice.status !== 'Bezahlt' ? 'text-red-600 font-bold' : '' %>">
            <%= invoice.due_date ? new Date(invoice.due_date).toLocaleDateString('de-DE') : 'sofort' %>
          </span>
        </div>
      </div>
    </div>

    <!-- Betreff / Titel -->
    <h2 class="text-xl font-bold text-gray-900 mb-6">
      <%= invoice.dunning_level > 0 ? 'Mahnung bezüglich Rechnung ' + invoice.invoice_number : 'Rechnung Nr. ' + invoice.invoice_number %>
    </h2>

    <!-- Positionstabelle -->
    <table class="w-full text-left mb-8 border-collapse">
      <thead>
        <tr class="border-b-2 border-gray-300 text-xs font-bold text-gray-600 uppercase">
          <th class="py-3">Pos.</th>
          <th class="py-3">Bezeichnung</th>
          <th class="py-3 text-right">Menge</th>
          <th class="py-3 text-right">Einzelpreis</th>
          <th class="py-3 text-right">Gesamt (Netto)</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 text-sm">
        <% if (items && items.length > 0) { %>
          <% items.forEach((item, index) => { %>
            <tr>
              <td class="py-3 text-gray-400"><%= index + 1 %></td>
              <td class="py-3 font-medium text-gray-800"><%= item.description %></td>
              <td class="py-3 text-right"><%= item.quantity %> <%= item.unit %></td>
              <td class="py-3 text-right"><%= item.price.toLocaleString('de-DE', {minimumFractionDigits: 2}) %> €</td>
              <td class="py-3 text-right font-semibold"><%= (item.quantity * item.price).toLocaleString('de-DE', {minimumFractionDigits: 2}) %> €</td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>

    <!-- Summenberechnung -->
    <% 
      let subtotal = invoice.total_amount || 0;
      let tax = subtotal * 0.19;
      let grandTotal = subtotal + tax;
    %>
    <div class="flex justify-end mb-12">
      <div class="w-64 space-y-2 text-sm">
        <div class="flex justify-between text-gray-600">
          <span>Zwischensumme (Netto):</span>
          <span><%= subtotal.toLocaleString('de-DE', {style:'currency', currency:'EUR'}) %></span>
        </div>
        <div class="flex justify-between text-gray-600">
          <span>19% MwSt.:</span>
          <span><%= tax.toLocaleString('de-DE', {style:'currency', currency:'EUR'}) %></span>
        </div>
        <div class="flex justify-between text-base font-bold text-gray-900 border-t pt-2">
          <span>Gesamtbetrag (Brutto):</span>
          <span><%= grandTotal.toLocaleString('de-DE', {style:'currency', currency:'EUR'}) %></span>
        </div>
      </div>
    </div>

    <!-- Zahlungsaufforderung / Fussnote -->
    <div class="border-t pt-6 text-xs text-gray-500 space-y-2">
      <% if (invoice.dunning_level > 0) { %>
        <p class="font-bold text-red-700">Bitte überweisen Sie den ausstehenden Gesamtbetrag umgehend auf das unten stehende Konto, um weitere Mahngebühren zu vermeiden.</p>
      <% } else { %>
        <p>Zahlbar innerhalb von 14 Tagen ohne Abzug. Bitte geben Sie bei der Überweisung die Rechnungsnummer <strong><%= invoice.invoice_number %></strong> als Verwendungszweck an.</p>
      <% } %>
      
      <div class="grid grid-cols-3 gap-4 border-t pt-4 text-[10px]">
        <div>
          <p class="font-bold">Bankverbindung:</p>
          <p>Musterbank DE</p>
          <p>IBAN: DE12 3456 7890 1234 5678 90</p>
        </div>
        <div>
          <p class="font-bold">Geschäftsleitung:</p>
          <p>Max Mustermann</p>
          <p>HRB: 987654 Amtsgericht</p>
        </div>
        <div>
          <p class="font-bold">Steuernummer:</p>
          <p>123/456/78901</p>
          <p>USt-IdNr.: DE999999999</p>
        </div>
      </div>
    </div>

  </div>

</body>
</html>