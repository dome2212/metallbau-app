<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title><%= invoice.doc_type === 'OFFER' ? 'Angebot' : 'Rechnung' %> <%= invoice.invoice_number %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print {
      .no-print { display: none !important; }
      body  { background: #fff !important; padding: 0 !important; }
      .page { box-shadow: none !important; border-radius: 0 !important; margin: 0 !important; }
      @page { margin: 12mm 14mm; }
    }
    body { font-family: 'Segoe UI', system-ui, -apple-system, Arial, sans-serif; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen py-10 px-4">

<%
  const isOffer    = invoice.doc_type === 'OFFER';
  const isDunning  = (invoice.dunning_level || 0) > 0;
  const docLabel   = isOffer ? 'Angebot' : (isDunning ? 'Mahnung' : 'Rechnung');
  const docNr      = invoice.invoice_number || invoice.doc_number || '';
  const f          = firma || {};
  const accent     = f.pdf_color || '#1e3a5f';
  const subtotal   = items.reduce((s, i) => s + (parseFloat(i.quantity) || 0) * (parseFloat(i.price) || 0), 0);
  const taxRate    = parseFloat(invoice.tax_rate || f.default_tax_rate || 19);
  const tax        = subtotal * (taxRate / 100);
  const total      = subtotal + tax;
  const fmt        = n => Number(n || 0).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fmtQty     = n => Number(n || 0).toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 3 });
  const fmtDate    = d => { try { return new Date(d).toLocaleDateString('de-DE'); } catch(_){ return ''; } };
  const isOverdue  = invoice.due_date && new Date(invoice.due_date) < new Date() && invoice.status !== 'Bezahlt';
%>

  <!-- ══ AKTIONSLEISTE (kein Druck) ════════════════════════════════════════ -->
  <div class="max-w-4xl mx-auto mb-6 flex justify-between items-center no-print">
    <a href="<%= isOffer ? '/documents/offers' : '/documents/invoices' %>"
       class="text-sm font-medium text-gray-500 hover:text-gray-900 transition">← Zurück zur Übersicht</a>
    <div class="flex items-center gap-3">
      <button onclick="window.print()"
              class="bg-gray-700 hover:bg-gray-800 text-white px-5 py-2.5 rounded-lg font-medium shadow flex items-center gap-2 text-sm transition">
        🖨 Drucken
      </button>
      <a href="<%= isOffer ? '/documents/offers/' + invoice.id + '/pdf-download' : '/documents/invoices/' + invoice.id + '/pdf-download' %>"
         download
         class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg font-medium shadow flex items-center gap-2 text-sm transition">
        ⬇️ PDF herunterladen
      </a>
    </div>
  </div>

  <!-- ══ DIN-A4 SEITE ══════════════════════════════════════════════════════ -->
  <div class="page max-w-4xl mx-auto bg-white rounded-xl shadow-lg text-gray-800" style="padding: 44px 52px;">

    <!-- ── BRIEFKOPF ──────────────────────────────────────────────────────── -->
    <div class="flex justify-between items-start pb-5 mb-1" style="border-bottom: 2px solid <%= accent %>;">

      <!-- Links: Logo oder Firmenname -->
      <div class="flex-1 pr-8">
        <% if (f.logo_url) { %>
          <img src="<%= f.logo_url %>" alt="<%= f.name %>"
               style="max-height:64px; max-width:240px; object-fit:contain; display:block;">
          <% if (f.slogan) { %>
            <p class="text-[11px] text-gray-400 mt-1.5"><%= f.slogan %></p>
          <% } %>
        <% } else { %>
          <h1 class="text-xl font-extrabold uppercase tracking-wide leading-tight" style="color:<%= accent %>">
            <%= f.name || 'Ihre Firma' %>
          </h1>
          <% if (f.slogan) { %>
            <p class="text-[11px] text-gray-400 mt-1"><%= f.slogan %></p>
          <% } %>
        <% } %>
      </div>

      <!-- Rechts: Kontaktdaten -->
      <div class="text-right text-[11px] text-gray-500 leading-relaxed shrink-0">
        <p class="font-bold text-gray-800 text-sm mb-0.5"><%= f.name || '' %></p>
        <% if (f.strasse) { %><p><%= f.strasse %></p><% } %>
        <% if (f.plzOrt)  { %><p><%= f.plzOrt %></p><% } %>
        <% if (f.tel)     { %><p class="mt-0.5">Tel  <%= f.tel %></p><% } %>
        <% if (f.email)   { %><p><%= f.email %></p><% } %>
        <% if (f.web)     { %><p><%= f.web %></p><% } %>
      </div>
    </div>
    <div class="mb-6" style="border-bottom: 1px solid <%= accent %>33;"></div>

    <!-- ── EMPFÄNGER + DOKUMENTEN-INFO ────────────────────────────────────── -->
    <div class="grid grid-cols-2 gap-10 mb-8">

      <!-- Empfängeranschrift (DIN-Fenster) -->
      <div>
        <p class="text-[9px] text-gray-400 tracking-wide mb-2">
          <%= [f.name, f.strasse, f.plzOrt].filter(Boolean).join(' · ') %>
        </p>
        <p class="font-bold text-base text-gray-900 leading-snug">
          <%= invoice.company_name || invoice.contact_person || '–' %>
        </p>
        <% if (invoice.company_name && invoice.contact_person) { %>
          <p class="text-sm text-gray-600 mt-0.5">z. Hd. <%= invoice.contact_person %></p>
        <% } %>
        <% if (invoice.street) { %>
          <p class="text-sm text-gray-600 mt-0.5"><%= invoice.street %></p>
        <% } %>
        <% if (invoice.zip || invoice.city) { %>
          <p class="text-sm text-gray-600"><%= [invoice.zip, invoice.city].filter(Boolean).join(' ') %></p>
        <% } %>
      </div>

      <!-- Dokument-Metadaten (Karten-Look) -->
      <div class="rounded-lg p-4 text-sm space-y-1.5 self-start border-l-4 shadow-sm"
           style="background:<%= accent %>12; border-color:<%= accent %>;">
        <% if (isDunning) { %>
          <div class="bg-red-100 text-red-800 font-bold px-2.5 py-1.5 rounded text-center text-xs uppercase mb-2 tracking-wide">
            <%= invoice.dunning_level === 1 ? '1. Zahlungserinnerung'
              : invoice.dunning_level === 2 ? '2. Mahnung'
              : '3. Letzte Mahnung' %>
          </div>
        <% } %>
        <div class="flex justify-between gap-3">
          <span class="text-gray-500 text-[13px]"><%= isOffer ? 'Angebots-Nr.' : 'Rechnungs-Nr.' %></span>
          <span class="font-mono font-bold text-gray-900"><%= docNr %></span>
        </div>
        <div class="flex justify-between gap-3">
          <span class="text-gray-500 text-[13px]">Datum</span>
          <span class="text-gray-800"><%= fmtDate(invoice.created_at) %></span>
        </div>
        <% if (isOffer && f.angebotsgueltig) { %>
          <div class="flex justify-between gap-3">
            <span class="text-gray-500 text-[13px]">Gültig bis</span>
            <span class="text-gray-800">
              <%
                const gueltigBis = new Date(invoice.created_at);
                gueltigBis.setDate(gueltigBis.getDate() + parseInt(f.angebotsgueltig || 30));
              %>
              <%= fmtDate(gueltigBis) %>
            </span>
          </div>
        <% } %>
        <% if (!isOffer && invoice.due_date) { %>
          <div class="flex justify-between gap-3">
            <span class="text-gray-500 text-[13px]">Fällig am</span>
            <span class="font-semibold <%= isOverdue ? 'text-red-600' : 'text-gray-800' %>">
              <%= fmtDate(invoice.due_date) %><%= isOverdue ? ' ⚠' : '' %>
            </span>
          </div>
        <% } %>
        <% if (invoice.customer_number || invoice.customer_no) { %>
          <div class="flex justify-between gap-3">
            <span class="text-gray-500 text-[13px]">Kunden-Nr.</span>
            <span class="text-gray-800"><%= invoice.customer_number || invoice.customer_no %></span>
          </div>
        <% } %>
        <% if (invoice.project_number || invoice.project_ref) { %>
          <div class="flex justify-between gap-3">
            <span class="text-gray-500 text-[13px]">Projekt</span>
            <span class="text-gray-800"><%= invoice.project_number || invoice.project_ref %></span>
          </div>
        <% } %>
      </div>
    </div>

    <!-- ── BETREFF ─────────────────────────────────────────────────────────── -->
    <h2 class="text-lg font-bold mb-2" style="color:<%= isDunning ? '#b91c1c' : accent %>">
      <% if (isDunning) { %>
        Mahnung zu Rechnung <%= docNr %>
      <% } else { %>
        <%= docLabel %> Nr. <%= docNr %>
      <% } %>
    </h2>
    <p class="text-sm text-gray-600 mb-6 leading-relaxed" style="white-space:pre-line;">
      <% if (isDunning) { %>
Sehr geehrte Damen und Herren,
trotz unserer Rechnung haben wir bisher keinen Zahlungseingang feststellen können.
Wir bitten Sie, den ausstehenden Betrag umgehend zu begleichen.
      <% } else if (isOffer) { %>
<%= (f.pdf_intro_offer || 'Sehr geehrte Damen und Herren,\nvielen Dank für Ihre Anfrage. Wir unterbreiten Ihnen folgendes Angebot:') %>
      <% } else { %>
<%= (f.pdf_intro_invoice || 'Sehr geehrte Damen und Herren,\nwir erlauben uns, folgende Leistungen in Rechnung zu stellen:') %>
      <% } %>
    </p>

    <!-- ── POSITIONSTABELLE ────────────────────────────────────────────────── -->
    <table class="w-full text-left mb-6 border-collapse text-sm">
      <thead>
        <tr class="text-white text-[11px] uppercase tracking-wide" style="background:<%= accent %>">
          <th class="py-2.5 px-2.5 w-10 rounded-tl-md">Pos.</th>
          <th class="py-2.5 px-2.5">Bezeichnung</th>
          <th class="py-2.5 px-2.5 text-right w-16">Menge</th>
          <th class="py-2.5 px-2.5 w-14">Einh.</th>
          <th class="py-2.5 px-2.5 text-right w-24">Einzelpreis</th>
          <th class="py-2.5 px-2.5 text-right rounded-tr-md w-24">Gesamt</th>
        </tr>
      </thead>
      <tbody>
        <% if (items && items.length > 0) { %>
          <% items.forEach((item, index) => { %>
            <tr class="<%= index % 2 === 0 ? 'bg-gray-50' : 'bg-white' %> border-b border-gray-100">
              <td class="py-2.5 px-2.5 text-gray-400 text-center text-xs"><%= index + 1 %></td>
              <td class="py-2.5 px-2.5 font-medium text-gray-800"><%= item.description %></td>
              <td class="py-2.5 px-2.5 text-right text-gray-600"><%= fmtQty(item.quantity) %></td>
              <td class="py-2.5 px-2.5 text-gray-400 text-xs"><%= item.unit || '' %></td>
              <td class="py-2.5 px-2.5 text-right text-gray-600"><%= fmt(item.price) %> €</td>
              <td class="py-2.5 px-2.5 text-right font-semibold text-gray-900">
                <%= fmt((parseFloat(item.quantity) || 0) * (parseFloat(item.price) || 0)) %> €
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="py-8 text-center text-gray-400 italic">Keine Positionen vorhanden.</td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <!-- ── SUMMENBLOCK ─────────────────────────────────────────────────────── -->
    <div class="flex justify-end mb-8">
      <div class="w-64 space-y-1 text-sm">
        <div class="flex justify-between text-gray-500 py-0.5">
          <span>Zwischensumme (Netto)</span>
          <span class="text-gray-700"><%= fmt(subtotal) %> €</span>
        </div>
        <div class="flex justify-between text-gray-500 py-0.5">
          <span><%= taxRate %> % MwSt.</span>
          <span class="text-gray-700"><%= fmt(tax) %> €</span>
        </div>
        <div class="flex justify-between items-center text-white font-bold rounded-md px-3 py-2.5 mt-2"
             style="background:<%= accent %>">
          <span class="text-[13px]">Gesamtbetrag (Brutto)</span>
          <span class="text-base"><%= fmt(total) %> €</span>
        </div>
      </div>
    </div>

    <!-- ── ZAHLUNGSHINWEIS + BANKDATEN ─────────────────────────────────────── -->
    <div class="border-t border-gray-200 pt-5 text-xs text-gray-600 space-y-4">

      <% if (isDunning) { %>
        <p class="text-red-700 font-semibold text-sm leading-relaxed">
          Bitte überweisen Sie den ausstehenden Betrag von <strong><%= fmt(total) %> €</strong>
          umgehend auf das unten stehende Konto, um weitere Mahnkosten zu vermeiden.
          Verwendungszweck: <strong><%= docNr %></strong>
        </p>
      <% } else if (isOffer) { %>
        <p class="leading-relaxed">
          Dieses Angebot ist gültig für <strong><%= f.angebotsgueltig || 30 %> Tage</strong> ab Ausstellungsdatum.
          Bei Auftragserteilung bitten wir um schriftliche Bestätigung.
        </p>
      <% } else { %>
        <p class="leading-relaxed">
          Zahlbar innerhalb von <strong><%= f.zahlungsfrist || 14 %> Tagen</strong> ohne Abzug
          per <strong><%= f.default_payment_method || 'Überweisung' %></strong>.
          Bitte geben Sie als Verwendungszweck die Rechnungsnummer
          <strong><%= docNr %></strong> an.
        </p>
      <% } %>

      <!-- Bankdaten / Kontakt / Steuer -->
      <div class="bg-gray-50 rounded-lg p-4 grid grid-cols-3 gap-5 text-[11px] border border-gray-100">
        <div>
          <p class="font-bold text-xs mb-1.5" style="color:<%= accent %>">Bankverbindung</p>
          <% if (f.bank) { %><p class="text-gray-600"><%= f.bank %></p><% } %>
          <% if (f.iban) { %><p class="text-gray-600">IBAN  <%= f.iban %></p><% } %>
          <% if (f.bic)  { %><p class="text-gray-600">BIC   <%= f.bic %></p><% } %>
        </div>
        <div>
          <p class="font-bold text-xs mb-1.5" style="color:<%= accent %>">Kontakt</p>
          <% if (f.tel)   { %><p class="text-gray-600">Tel  <%= f.tel %></p><% } %>
          <% if (f.email) { %><p class="text-gray-600"><%= f.email %></p><% } %>
          <% if (f.web)   { %><p class="text-gray-600"><%= f.web %></p><% } %>
        </div>
        <div>
          <p class="font-bold text-xs mb-1.5" style="color:<%= accent %>">Steuer / Firma</p>
          <% if (f.steuernr) { %><p class="text-gray-600"><%= f.steuernr %></p><% } %>
          <% if (f.name)     { %><p class="text-gray-500 mt-0.5"><%= f.name %></p><% } %>
        </div>
      </div>

      <% if (f.pdf_footer_text) { %>
        <div class="border-t border-gray-100 pt-3 text-[10px] text-gray-400 text-center" style="white-space:pre-line;"><%= f.pdf_footer_text %></div>
      <% } %>

      <% if (f.pdf_agb_text) { %>
        <div class="border-t border-gray-100 pt-4 text-[10px] text-gray-400" style="white-space:pre-line;">
          <p class="font-semibold text-gray-500 mb-1">Allgemeine Geschäftsbedingungen</p>
          <%= f.pdf_agb_text %>
        </div>
      <% } %>

    </div>
  </div><!-- Ende .page -->

</body>
</html>
