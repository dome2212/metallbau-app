            <label class="lbl">Länge (Abmessung)</label>
            <input type="text" name="abmessung" id="editLaengeFeld" placeholder="z.B. 30 mm" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Kopfform / Typ (Notiz)</label>
            <input type="text" name="notiz" id="editNotizSchrauben" placeholder="z.B. Sechskant DIN 933, Inbus" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Güte</label>
            <select id="editGuete" class="fi w-full" onchange="document.getElementById('editGueteHidden').value=this.value">
              <option value="">– optional –</option>
              <option>8.8</option><option>10.9</option><option>12.9</option>
              <option>A2 (V2A / 1.4301)</option><option>A4 (V4A / 1.4404)</option>
              <option>verzinkt</option><option>blank</option>
            </select>
            <input type="hidden" name="notiz2" id="editGueteHidden">
          </div>
        </div>

        <!-- Notiz (Stahl) -->
        <div id="editNotizStahlBox" class="col-span-2">
          <label class="lbl">Notiz</label>
          <input type="text" name="notiz" id="editNotiz" class="fi w-full">
        </div>

        <div>
          <label class="lbl">Menge *</label>
          <input type="text" name="menge" id="editMenge" required class="fi w-full">
        </div>
        <div>
          <label class="lbl">Einheit</label>
          <select name="einheit" id="editEinheit" class="fi w-full">
            <option>Stk</option><option>m</option><option>kg</option><option>m²</option><option>Beutel</option><option>Psch</option>
          </select>
        </div>
        <div>
          <label class="lbl">Preis / Einheit (€)</label>
          <div class="flex gap-1.5">
            <input type="text" name="einheitspreis" id="editEinheitspreis" placeholder="0.00" class="fi flex-1">
            <button type="button"
              onclick="fetchLagerKiPreis('edit')"
              id="editKiPreisBtn"
              title="KI-Preisschätzung"
              class="px-2.5 py-1.5 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-xs font-semibold transition flex items-center gap-1 whitespace-nowrap">
              ✨ KI
            </button>
          </div>
          <p id="editKiPreisHinweis" class="hidden text-xs text-purple-600 dark:text-purple-400 mt-1"></p>
        </div>
        <div>
          <label class="lbl">Mindestbestand</label>
          <input type="text" name="mindestbestand" id="editMindestbestand" placeholder="0" class="fi w-full">
        </div>
        <div>
          <label class="lbl">Lagerort</label>
          <input type="text" name="lagerort" id="editLagerort" placeholder="z.B. Regal A3" class="fi w-full">
        </div>
        <div>
          <label class="lbl">Lieferschein-Nr.</label>
          <input type="text" name="lieferschein_nr" id="editLsnr" class="fi w-full">
        </div>
        <div>
          <label class="lbl">Lieferdatum</label>
          <input type="date" name="lieferdatum" id="editLieferdatum" class="fi w-full">
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeModal('editModal')" class="flex-1 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition">Abbrechen</button>
        <button type="submit" class="flex-1 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition">Speichern</button>
      </div>
    </form>
  </div>
</div>

