<!-- ═══════════════════════════════════════════
     MODAL: ENTNAHME BUCHEN
═══════════════════════════════════════════ -->
<div id="entnahmeModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center px-4"
     onclick="closeModal('entnahmeModal', event)">
  <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl w-full max-w-md p-6" onclick="event.stopPropagation()">
    <div class="flex justify-between items-center mb-5">
      <h2 class="text-lg font-bold text-gray-800 dark:text-gray-100">📤 Entnahme buchen</h2>
      <button onclick="closeModal('entnahmeModal')" class="text-gray-400 hover:text-gray-600 text-xl leading-none">✕</button>
    </div>
    <form action="/lager/entnahme" method="POST" class="space-y-3">
      <div>
        <label class="lbl">Material *</label>
        <select name="lager_item_id" id="entnahmeMaterialSelect" required class="fi w-full">
          <option value="">– Material auswählen –</option>
          <% allItems.forEach(i => { %>
          <option value="<%= i.id %>"
            data-einheit="<%= encodeURIComponent(i.einheit || 'Stk') %>"
            data-bestand="<%= Number(i.menge).toLocaleString('de-DE') %>">
            <%= i.bezeichnung %><% if (i.profil) { %> · <%= i.profil %><% } %>
            (<%= Number(i.menge).toLocaleString('de-DE') %> <%= i.einheit %>)
            – <%= i.material_type === 'edelstahl' ? '✨' : i.material_type === 'schrauben' ? '🔧' : '🔩' %>
          </option>
          <% }) %>
        </select>
        <p id="entnahmeBestandHint" class="text-xs text-gray-400 mt-1 hidden">Aktueller Bestand: <strong id="entnahmeBestandVal"></strong></p>
      </div>
      <div>
        <label class="lbl">Auftrag (optional)</label>
        <select name="project_id" class="fi w-full">
          <option value="">– Keinem Auftrag zugeordnet –</option>
          <% projects.forEach(p => { %>
          <option value="<%= p.id %>"><%= p.title %></option>
          <% }) %>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="lbl">Menge *</label>
          <input type="text" name="menge" required placeholder="0" class="fi w-full">
        </div>
        <div>
          <label class="lbl">Notiz</label>
          <input type="text" name="notiz" placeholder="Optional" class="fi w-full">
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeModal('entnahmeModal')" class="flex-1 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition">Abbrechen</button>
        <button type="submit" class="flex-1 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold transition">Buchen</button>
      </div>
    </form>
  </div>
</div>

