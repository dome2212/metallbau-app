          Abbrechen
        </button>
        <button type="submit"
          class="flex-1 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition">
          Speichern
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ═══════════════════════════════════════════
     MODAL: LIEFERSCHEIN SCANNEN
═══════════════════════════════════════════ -->
<div id="scanModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center px-4"
     onclick="closeScanModal(event)">
  <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl w-full max-w-2xl p-6 max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
    <div class="flex justify-between items-center mb-5">
      <h2 class="text-lg font-bold text-gray-800 dark:text-gray-100">📷 Lieferschein scannen (KI)</h2>
      <button onclick="closeScanModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl leading-none">✕</button>
    </div>

    <!-- Upload-Bereich -->
    <div id="scanUploadArea"
         class="border-2 border-dashed border-gray-300 dark:border-slate-600 rounded-xl p-8 text-center cursor-pointer hover:border-purple-400 transition mb-4"
         onclick="document.getElementById('scanFileInput').click()"
         ondragover="event.preventDefault()" ondrop="handleScanDrop(event)">
      <p class="text-4xl mb-2">📄</p>
      <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Lieferschein-Foto hier ablegen oder antippen</p>
      <p class="text-xs text-gray-400 mt-1">JPG, PNG, WebP – max. 10 MB</p>
      <input type="file" id="scanFileInput" accept="image/*" capture="environment" class="hidden" onchange="handleScanFile(this.files[0])">
    </div>
    <div id="scanPreviewWrap" class="hidden mb-4">
      <img id="scanPreview" src="" alt="Vorschau" class="max-h-48 rounded-lg mx-auto object-contain border border-gray-200 dark:border-slate-600">
    </div>

    <div id="scanStatus" class="hidden text-center py-4">
      <div class="inline-flex items-center gap-2 text-purple-600 dark:text-purple-400 font-medium text-sm">
        <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
        </svg>
        KI analysiert Lieferschein…
      </div>
    </div>

    <!-- Erkannte Positionen -->
    <div id="scanResults" class="hidden">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300">📋 Erkannte Positionen</h3>
        <span id="scanCountBadge" class="text-xs bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400 px-2 py-0.5 rounded-full font-semibold"></span>
      </div>
      <div id="scanItemsList" class="space-y-2 mb-4 max-h-64 overflow-y-auto pr-1"></div>

      <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-lg p-3 mb-4 text-xs text-amber-700 dark:text-amber-400">
        ⚠️ Bitte überprüfe die KI-Ergebnisse vor dem Speichern. Der Material-Typ (Baustahl/Edelstahl) wird automatisch erkannt, kann aber manuell geändert werden.
      </div>

      <form action="/lager/scan-save" method="POST" id="scanSaveForm">
        <input type="hidden" name="tab" value="<%= tab %>">
        <input type="hidden" name="items" id="scanItemsJson">
        <div class="flex gap-3">
          <button type="button" onclick="closeScanModal()"
            class="flex-1 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition">
            Abbrechen
          </button>
          <button type="submit" onclick="prepareScanSave()"
            class="flex-1 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold transition">
            ✓ Alle speichern
          </button>
        </div>
      </form>
    </div>

    <div id="scanError" class="hidden bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 rounded-lg p-3 text-sm text-red-600 dark:text-red-400"></div>
  </div>
</div>

<style>
  .form-input {
    @apply rounded-lg border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-100 text-sm px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition;
  }
</style>

<script>
  // ── Modals ──────────────────────────────────────────────────────────────────
  function closeModal(id, event) {
    if (event && event.target !== document.getElementById(id)) return;
    document.getElementById(id).classList.add('hidden');
  }
  function openAddModal() { document.getElementById('addModal').classList.remove('hidden'); }

  function openEditModal(btn) {
    // Daten sicher aus data-item-Attribut lesen (EJS-escaped via <%= %>)
    const item = JSON.parse(btn.dataset.item);
    document.getElementById('editId').value           = item.id;
    document.getElementById('editMaterialType').value = item.material_type || 'baustahl';
    document.getElementById('editBezeichnung').value  = item.bezeichnung || '';
    document.getElementById('editProfil').value       = item.profil || '';
    document.getElementById('editAbmessung').value    = item.abmessung || '';
    document.getElementById('editMenge').value        = item.menge || '';
    document.getElementById('editEinheit').value      = item.einheit || 'Stk';
    document.getElementById('editLsnr').value         = item.lieferschein_nr || '';
    document.getElementById('editNotiz').value        = item.notiz || '';
    // Datum formatieren für <input type="date">
    if (item.lieferdatum) {
      try {
        const d = new Date(item.lieferdatum);
        document.getElementById('editLieferdatum').value = d.toISOString().split('T')[0];
      } catch(_) { document.getElementById('editLieferdatum').value = ''; }
    } else {
      document.getElementById('editLieferdatum').value = '';
    }
    document.getElementById('editModal').classList.remove('hidden');
  }

  // ── Scan-Modal ──────────────────────────────────────────────────────────────
  let scannedItems = [];

  function openScanModal() {
    scannedItems = [];
    document.getElementById('scanModal').classList.remove('hidden');
    document.getElementById('scanPreviewWrap').classList.add('hidden');
    document.getElementById('scanStatus').classList.add('hidden');
    document.getElementById('scanResults').classList.add('hidden');
    document.getElementById('scanError').classList.add('hidden');
    document.getElementById('scanUploadArea').classList.remove('hidden');
    document.getElementById('scanFileInput').value = '';
  }

  function closeScanModal(event) {
    if (event && event.target !== document.getElementById('scanModal')) return;
    document.getElementById('scanModal').classList.add('hidden');
  }

  function handleScanDrop(e) {
    e.preventDefault();
    const file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) handleScanFile(file);
  }

  function handleScanFile(file) {
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      document.getElementById('scanPreview').src = e.target.result;
      document.getElementById('scanPreviewWrap').classList.remove('hidden');
    };
    reader.readAsDataURL(file);
    runScan(file);
  }

  async function runScan(file) {
    document.getElementById('scanUploadArea').classList.add('hidden');
    document.getElementById('scanStatus').classList.remove('hidden');
    document.getElementById('scanResults').classList.add('hidden');
    document.getElementById('scanError').classList.add('hidden');

    const formData = new FormData();
    formData.append('image', file);

    try {
      const res  = await fetch('/lager/scan', { method: 'POST', body: formData });
      const data = await res.json();
      document.getElementById('scanStatus').classList.add('hidden');

      if (!res.ok || data.error) {
        showScanError(data.error || 'Unbekannter Fehler');
        return;
      }
      scannedItems = data.items || [];
      renderScanResults();
    } catch (err) {
      document.getElementById('scanStatus').classList.add('hidden');
      showScanError('Netzwerkfehler: ' + err.message);
    }
  }

  function renderScanResults() {
    const list = document.getElementById('scanItemsList');
    document.getElementById('scanCountBadge').textContent = scannedItems.length + ' Position(en)';

    if (!scannedItems.length) {
      list.innerHTML = '<p class="text-sm text-gray-400 text-center py-4">Keine Positionen erkannt. Bitte manuell hinzufügen.</p>';
    } else {
      list.innerHTML = scannedItems.map((item, i) => `
        <div class="bg-gray-50 dark:bg-slate-700/50 rounded-lg p-3 border border-gray-200 dark:border-slate-600">
          <div class="grid grid-cols-2 gap-2 text-xs">
            <div class="col-span-2 flex items-center gap-2 mb-1">
              <select onchange="scannedItems[${i}].material_type=this.value"
                class="text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-1">
                <option value="baustahl" ${item.material_type === 'baustahl' ? 'selected' : ''}>🔩 Baustahl</option>
                <option value="edelstahl" ${item.material_type === 'edelstahl' ? 'selected' : ''}>✨ Edelstahl</option>
              </select>
              <input type="text" value="${esc(item.bezeichnung)}" onchange="scannedItems[${i}].bezeichnung=this.value"
                class="flex-1 text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-100 px-2 py-1 font-semibold"
                placeholder="Bezeichnung">
            </div>
            <div>
              <span class="text-gray-400">Profil:</span>
              <input type="text" value="${esc(item.profil||'')}" onchange="scannedItems[${i}].profil=this.value"
                class="w-full text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 mt-0.5">
            </div>
            <div>
              <span class="text-gray-400">Abmessung:</span>
              <input type="text" value="${esc(item.abmessung||'')}" onchange="scannedItems[${i}].abmessung=this.value"
                class="w-full text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 mt-0.5">
            </div>
            <div>
              <span class="text-gray-400">Menge:</span>
              <input type="number" value="${item.menge||0}" onchange="scannedItems[${i}].menge=parseFloat(this.value)||0"
                class="w-full text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 mt-0.5">
            </div>
            <div>
              <span class="text-gray-400">Einheit:</span>
              <select onchange="scannedItems[${i}].einheit=this.value"
                class="w-full text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 mt-0.5">
                ${['Stk','m','kg','m²','Psch'].map(u => `<option ${(item.einheit||'Stk')===u?'selected':''}>${u}</option>`).join('')}
              </select>
            </div>
            <div class="col-span-2 flex gap-2">
              <div class="flex-1">
                <span class="text-gray-400">LS-Nr.:</span>
                <input type="text" value="${esc(item.lieferschein_nr||'')}" onchange="scannedItems[${i}].lieferschein_nr=this.value"
                  class="w-full text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 mt-0.5">
              </div>
              <div class="flex-1">
                <span class="text-gray-400">Datum:</span>
                <input type="text" value="${esc(item.lieferdatum||'')}" onchange="scannedItems[${i}].lieferdatum=this.value"
                  placeholder="YYYY-MM-DD"
                  class="w-full text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 mt-0.5">
              </div>
            </div>
          </div>
        </div>`).join('');
    }
    document.getElementById('scanResults').classList.remove('hidden');
  }

  function prepareScanSave() {
    document.getElementById('scanItemsJson').value = JSON.stringify(scannedItems);
  }

  function showScanError(msg) {
    const el = document.getElementById('scanError');
    el.textContent = '❌ ' + msg;
    el.classList.remove('hidden');
    document.getElementById('scanUploadArea').classList.remove('hidden');
  }

  function esc(str) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
</script>
