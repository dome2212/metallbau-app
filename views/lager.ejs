<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex flex-col overflow-y-auto md:ml-72 page-bg min-h-screen pt-16 md:pt-6">
  <div class="px-4 md:px-6 mb-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
    <div>
      <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">🏭 Lagerliste</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400">Eingangsmaterial aus Lieferscheinen – Baustahl &amp; Edelstahl</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
      <button onclick="openScanModal()"
        class="bg-purple-600 hover:bg-purple-700 text-white font-medium px-4 py-2 rounded-lg shadow text-sm flex items-center justify-center gap-2">
        📷 Lieferschein scannen
      </button>
      <button onclick="openAddModal()"
        class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow text-sm flex items-center justify-center gap-2">
        + Manuell hinzufügen
      </button>
    </div>
  </div>

  <!-- Tabs -->
  <div class="px-4 md:px-6 mb-4">
    <div class="flex gap-2 border-b border-gray-200 dark:border-slate-700">
      <a href="/lager?tab=baustahl"
        class="px-4 py-2 text-sm font-semibold border-b-2 transition
               <%= tab === 'baustahl' ? 'border-blue-600 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200' %>">
        🔩 Baustahl
      </a>
      <a href="/lager?tab=edelstahl"
        class="px-4 py-2 text-sm font-semibold border-b-2 transition
               <%= tab === 'edelstahl' ? 'border-blue-600 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200' %>">
        ✨ Edelstahl
      </a>
    </div>
  </div>

  <!-- Tabelle -->
  <div class="px-4 md:px-6 pb-10 w-full max-w-7xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden">
      <% if (items && items.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[700px]">
          <thead class="bg-gray-50 dark:bg-slate-700 border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
            <tr>
              <th class="px-4 py-3">Bezeichnung</th>
              <th class="px-4 py-3">Profil</th>
              <th class="px-4 py-3">Abmessung</th>
              <th class="px-4 py-3">Menge</th>
              <th class="px-4 py-3">Einheit</th>
              <th class="px-4 py-3">Lieferschein-Nr.</th>
              <th class="px-4 py-3">Lieferdatum</th>
              <th class="px-4 py-3">Notiz</th>
              <th class="px-4 py-3 text-right">Aktion</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
            <tr class="border-b dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700/50 text-sm">
              <td class="px-4 py-3 font-semibold text-gray-800 dark:text-gray-100"><%= item.bezeichnung %></td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= item.profil || '-' %></td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= item.abmessung || '-' %></td>
              <td class="px-4 py-3 text-gray-800 dark:text-gray-200 font-medium">
                <%= Number(item.menge || 0).toLocaleString('de-DE') %>
              </td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400"><%= item.einheit || '-' %></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs"><%= item.lieferschein_nr || '-' %></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs">
                <%= item.lieferdatum ? new Date(item.lieferdatum).toLocaleDateString('de-DE') : '-' %>
              </td>
              <td class="px-4 py-3 text-gray-400 text-xs max-w-[160px] truncate"><%= item.notiz || '' %></td>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center justify-end gap-2">
                  <button onclick="openEditModal(this)"
                    data-item="<%= JSON.stringify(item).replace(/\"/g, '&quot;') %>"
                    class="px-2.5 py-1 bg-blue-50 text-blue-600 hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-400 rounded text-xs font-semibold transition">
                    ✏️
                  </button>
                  <form action="/lager/delete" method="POST" onsubmit="return confirm('Eintrag wirklich löschen?');" class="inline">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <input type="hidden" name="tab" value="<%= tab %>">
                    <button type="submit"
                      class="px-2.5 py-1 bg-red-50 text-red-600 hover:bg-red-100 dark:bg-red-900/30 dark:text-red-400 rounded text-xs font-semibold transition">
                      🗑️
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center py-16">
        <p class="text-4xl mb-3">📭</p>
        <p class="text-gray-500 dark:text-gray-400 font-medium">Keine Einträge vorhanden</p>
        <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">
          Lieferschein fotografieren oder Eintrag manuell hinzufügen
        </p>
      </div>
      <% } %>
    </div>
  </div>
</main>

<!-- ═══════════════════════════════════════════
     MODAL: MANUELL HINZUFÜGEN
═══════════════════════════════════════════ -->
<div id="addModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center px-4"
     onclick="closeModal('addModal', event)">
  <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl w-full max-w-lg p-6" onclick="event.stopPropagation()">
    <div class="flex justify-between items-center mb-5">
      <h2 class="text-lg font-bold text-gray-800 dark:text-gray-100">+ Lager-Eintrag hinzufügen</h2>
      <button onclick="closeModal('addModal')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl leading-none">✕</button>
    </div>
    <form action="/lager/add" method="POST" class="space-y-3">
      <div class="grid grid-cols-2 gap-3">
        <div class="col-span-2">
          <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Material-Typ *</label>
          <select name="material_type" id="addMaterialType" class="form-input w-full">
            <option value="baustahl" <%= tab === 'baustahl' ? 'selected' : '' %>>🔩 Baustahl</option>
            <option value="edelstahl" <%= tab === 'edelstahl' ? 'selected' : '' %>>✨ Edelstahl</option>
          </select>
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Bezeichnung *</label>
          <input type="text" name="bezeichnung" required placeholder="z.B. Flachstahl, Rohr, Winkel…" class="form-input w-full">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Profil</label>
          <input type="text" name="profil" placeholder="z.B. 40x5, 60x60x4" class="form-input w-full">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Abmessung/Länge</label>
          <input type="text" name="abmessung" placeholder="z.B. 6000mm" class="form-input w-full">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Menge *</label>
          <input type="text" name="menge" required placeholder="0" class="form-input w-full">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Einheit</label>
          <select name="einheit" class="form-input w-full">
            <option>Stk</option>
            <option>m</option>
            <option>kg</option>
            <option>m²</option>
            <option>Psch</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Lieferschein-Nr.</label>
          <input type="text" name="lieferschein_nr" placeholder="LS-12345" class="form-input w-full">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Lieferdatum</label>
          <input type="date" name="lieferdatum" class="form-input w-full">
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1">Notiz</label>
          <input type="text" name="notiz" placeholder="Optionale Bemerkung" class="form-input w-full">
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeModal('addModal')"
          class="flex-1 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition">
          Abbrechen
        </button>
        <button type="submit"
          class="flex-1 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition">
          Speichern
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ═══════════════════════════════════════════
     MODAL: BEARBEITEN
═══════════════════════════════════════════ -->
