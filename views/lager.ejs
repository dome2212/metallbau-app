<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex flex-col overflow-y-auto md:ml-72 page-bg min-h-screen pt-16 md:pt-6">

  <!-- ── Header ─────────────────────────────────────────────────────────────── -->
  <%
    // Custom-Tab-Keys für Bedingungs-Checks
    const customTabKeys = (customTabs || []).map(t => t.key);
    const isStockTab = tab === 'baustahl' || tab === 'edelstahl' || tab === 'schrauben' || customTabKeys.includes(tab);
  %>
  <div class="px-4 md:px-6 mb-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
    <div>
      <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">🏭 Lagerverwaltung</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400">Baustahl · Edelstahl · Schrauben · Entnahmen · Reststücke</p>
    </div>
    <div class="flex flex-wrap gap-2 w-full md:w-auto">
      <% if (isStockTab) { %>
        <% if (tab !== 'schrauben') { %>
        <button onclick="openScanModal()"
          class="bg-purple-600 hover:bg-purple-700 text-white font-medium px-3 py-2 rounded-lg shadow text-sm flex items-center gap-1.5">
          📷 Lieferschein
        </button>
        <% } %>
        <button onclick="openAddModal()"
          class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-3 py-2 rounded-lg shadow text-sm flex items-center gap-1.5">
          + Einlagern
        </button>
        <button onclick="openEntnahmeModal()"
          class="bg-amber-600 hover:bg-amber-700 text-white font-medium px-3 py-2 rounded-lg shadow text-sm flex items-center gap-1.5">
          ↓ Entnahme buchen
        </button>
      <% } else if (tab === 'entnahmen') { %>
        <button onclick="openEntnahmeModal()"
          class="bg-amber-600 hover:bg-amber-700 text-white font-medium px-3 py-2 rounded-lg shadow text-sm flex items-center gap-1.5">
          ↓ Entnahme buchen
        </button>
      <% } %>
      <% if (tab === 'reste') { %>
        <button onclick="openRestModal()"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-3 py-2 rounded-lg shadow text-sm flex items-center gap-1.5">
          + Reststück einlagern
        </button>
      <% } %>
    </div>
  </div>

  <!-- ── Verschoben-Banner ────────────────────────────────────────────────── -->
  <% if (typeof moved !== 'undefined' && moved) { %>
  <div class="px-4 md:px-6 mb-3">
    <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-300 dark:border-blue-700 rounded-xl px-4 py-3 flex items-center gap-3">
      <span class="text-blue-500 text-xl">↗️</span>
      <p class="text-sm font-semibold text-blue-800 dark:text-blue-300">Eintrag erfolgreich verschoben.</p>
    </div>
  </div>
  <% } %>

  <!-- ── Scan-Erfolgs-Banner ──────────────────────────────────────────────── -->
  <% if (scanBs > 0 || scanEs > 0) { %>
  <div class="px-4 md:px-6 mb-3">
    <div class="bg-green-50 dark:bg-green-900/20 border border-green-300 dark:border-green-700 rounded-xl px-4 py-3 flex items-start gap-3">
      <span class="text-green-500 text-xl mt-0.5">✅</span>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-green-800 dark:text-green-300">Lieferschein erfolgreich eingelagert</p>
        <div class="flex flex-wrap gap-3 mt-1">
          <% if (scanBs > 0) { %>
          <a href="/lager?tab=baustahl" class="text-xs text-blue-600 dark:text-blue-400 font-medium hover:underline">
            🔩 <strong><%= scanBs %></strong> Position<%= scanBs === 1 ? '' : 'en' %> → Baustahl
          </a>
          <% } %>
          <% if (scanEs > 0) { %>
          <a href="/lager?tab=edelstahl" class="text-xs text-violet-600 dark:text-violet-400 font-medium hover:underline">
            ✨ <strong><%= scanEs %></strong> Position<%= scanEs === 1 ? '' : 'en' %> → Edelstahl
          </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ── Low-Stock-Banner ──────────────────────────────────────────────────── -->
  <%
    const lowStockItems = items.filter(i => Number(i.mindestbestand) > 0 && Number(i.menge) <= Number(i.mindestbestand));
  %>
  <% if ((tab === 'baustahl' || tab === 'edelstahl' || tab === 'schrauben') && lowStockItems.length > 0) { %>
  <div class="px-4 md:px-6 mb-3">
    <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-300 dark:border-amber-700 rounded-xl px-4 py-3 flex items-start gap-3">
      <span class="text-amber-500 text-xl mt-0.5">⚠️</span>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-amber-800 dark:text-amber-300">
          <%= lowStockItems.length %> Artikel <%= lowStockItems.length === 1 ? 'ist' : 'sind' %> unter Mindestbestand
        </p>
        <p class="text-xs text-amber-700 dark:text-amber-400 mt-0.5 truncate">
          <%= lowStockItems.map(i => i.bezeichnung + (i.profil ? ' ' + i.profil : '')).join(' · ') %>
        </p>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ── Tabs ──────────────────────────────────────────────────────────────── -->
  <div class="px-4 md:px-6 mb-4">
    <div class="flex gap-0.5 border-b border-gray-200 dark:border-slate-700 overflow-x-auto">
      <a href="/lager?tab=baustahl"
        class="px-4 py-2 text-sm font-semibold border-b-2 transition -mb-px whitespace-nowrap
               <%= tab === 'baustahl' ? 'border-blue-600 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400' %>">
        🔩 Baustahl
      </a>
      <a href="/lager?tab=edelstahl"
        class="px-4 py-2 text-sm font-semibold border-b-2 transition -mb-px whitespace-nowrap
               <%= tab === 'edelstahl' ? 'border-blue-600 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400' %>">
        ✨ Edelstahl
      </a>
      <a href="/lager?tab=schrauben"
        class="px-4 py-2 text-sm font-semibold border-b-2 transition -mb-px whitespace-nowrap
               <%= tab === 'schrauben' ? 'border-orange-600 text-orange-600 dark:text-orange-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400' %>">
        🔧 Schrauben
      </a>
      <% /* ── Custom-Tabs ────────────────────────────────────── */ %>
      <% const colorMap = { blue:'border-blue-600 text-blue-600 dark:text-blue-400', violet:'border-violet-600 text-violet-600 dark:text-violet-400', emerald:'border-emerald-600 text-emerald-600 dark:text-emerald-400', amber:'border-amber-600 text-amber-600 dark:text-amber-400', rose:'border-rose-600 text-rose-600 dark:text-rose-400', slate:'border-slate-600 text-slate-600 dark:text-slate-400', orange:'border-orange-600 text-orange-600 dark:text-orange-400', cyan:'border-cyan-600 text-cyan-600 dark:text-cyan-400' }; %>
      <% for (const ct of (customTabs || [])) { %>
      <a href="/lager?tab=<%= ct.key %>"
        class="px-4 py-2 text-sm font-semibold border-b-2 transition -mb-px whitespace-nowrap
               <%= tab === ct.key ? (colorMap[ct.color] || colorMap.blue) : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400' %>">
        <%= ct.icon %> <%= ct.label %>
      </a>
      <% } %>
      <a href="/lager?tab=entnahmen"
        class="px-4 py-2 text-sm font-semibold border-b-2 transition -mb-px whitespace-nowrap
               <%= tab === 'entnahmen' ? 'border-amber-600 text-amber-600 dark:text-amber-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400' %>">
        📤 Entnahmen
      </a>
      <a href="/lager?tab=reste"
        class="px-4 py-2 text-sm font-semibold border-b-2 transition -mb-px whitespace-nowrap
               <%= tab === 'reste' ? 'border-emerald-600 text-emerald-600 dark:text-emerald-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400' %>">
        ✂️ Reststücke
      </a>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       TAB: BAUSTAHL / EDELSTAHL / SCHRAUBEN
  ═══════════════════════════════════════════════════════════════════════════ -->
  <% if (tab === 'baustahl' || tab === 'edelstahl' || tab === 'schrauben') { %>
  <div class="px-4 md:px-6 pb-10 w-full max-w-7xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden">
      <% if (items && items.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[800px]">
          <thead class="bg-gray-50 dark:bg-slate-700 border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
            <tr>
              <th class="px-4 py-3">Bezeichnung</th>
              <th class="px-4 py-3">Profil</th>
              <th class="px-4 py-3">Abmessung</th>
              <th class="px-4 py-3">Bestand</th>
              <th class="px-4 py-3">Mindestbest.</th>
              <th class="px-4 py-3">Lagerort</th>
              <th class="px-4 py-3">Lieferschein</th>
              <th class="px-4 py-3">Datum</th>
              <th class="px-4 py-3 text-right">Aktion</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => {
              const isLow = Number(item.mindestbestand) > 0 && Number(item.menge) <= Number(item.mindestbestand);
              const isCritical = Number(item.mindestbestand) > 0 && Number(item.menge) === 0;
            %>
            <tr class="border-b dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700/50 text-sm
                       <%= isCritical ? 'bg-red-50/60 dark:bg-red-900/10' : isLow ? 'bg-amber-50/60 dark:bg-amber-900/10' : '' %>">
              <td class="px-4 py-3 font-semibold text-gray-800 dark:text-gray-100">
                <% if (isLow) { %><span class="text-amber-500 mr-1" title="Unter Mindestbestand">⚠️</span><% } %>
                <%= item.bezeichnung %>
              </td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= item.profil || '-' %></td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= item.abmessung || '-' %></td>
              <td class="px-4 py-3 font-semibold
                         <%= isCritical ? 'text-red-600 dark:text-red-400' : isLow ? 'text-amber-600 dark:text-amber-400' : 'text-gray-800 dark:text-gray-200' %>">
                <%= Number(item.menge || 0).toLocaleString('de-DE') %> <span class="font-normal text-gray-400"><%= item.einheit || '' %></span>
              </td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs">
                <% if (Number(item.mindestbestand) > 0) { %>
                  <span class="<%= isLow ? 'text-amber-600 dark:text-amber-400 font-semibold' : '' %>">
                    <%= Number(item.mindestbestand).toLocaleString('de-DE') %> <%= item.einheit || '' %>
                  </span>
                <% } else { %>–<% } %>
              </td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs"><%= item.lagerort || '-' %></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs"><%= item.lieferschein_nr || '-' %></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs">
                <%= item.lieferdatum ? new Date(item.lieferdatum).toLocaleDateString('de-DE') : '-' %>
              </td>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <!-- Entnahme-Button: data-* statt onclick-Parameter um Sonderzeichen-Bugs zu vermeiden -->
                  <button
                    data-item-id="<%= item.id %>"
                    data-item-einheit="<%= encodeURIComponent(item.einheit || 'Stk') %>"
                    onclick="openEntnahmeModalForEl(this)"
                    class="px-2 py-1 bg-amber-50 text-amber-600 hover:bg-amber-100 dark:bg-amber-900/30 dark:text-amber-400 rounded text-xs font-semibold transition"
                    title="Entnahme buchen">↓</button>
                  <!-- Bearbeiten-Button -->
                  <button
                    data-item-id="<%= item.id %>"
                    data-item-bezeichnung="<%= encodeURIComponent(item.bezeichnung || '') %>"
                    data-item-profil="<%= encodeURIComponent(item.profil || '') %>"
                    data-item-abmessung="<%= encodeURIComponent(item.abmessung || '') %>"
                    data-item-menge="<%= item.menge || 0 %>"
                    data-item-einheit="<%= encodeURIComponent(item.einheit || 'Stk') %>"
                    data-item-material="<%= encodeURIComponent(item.material_type || 'baustahl') %>"
                    data-item-lsnr="<%= encodeURIComponent(item.lieferschein_nr || '') %>"
                    data-item-lieferdatum="<%= item.lieferdatum ? new Date(item.lieferdatum).toISOString().split('T')[0] : '' %>"
                    data-item-notiz="<%= encodeURIComponent(item.notiz || '') %>"
                    data-item-mindestbestand="<%= item.mindestbestand || 0 %>"
                    data-item-lagerort="<%= encodeURIComponent(item.lagerort || '') %>"
                    onclick="openEditModalEl(this)"
                    class="px-2 py-1 bg-blue-50 text-blue-600 hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-400 rounded text-xs font-semibold transition"
                    title="Bearbeiten">✏️</button>
                  <!-- Verschieben-Button -->
                  <button
                    data-item-id="<%= item.id %>"
                    data-item-bezeichnung="<%= encodeURIComponent(item.bezeichnung || '') %>"
                    data-item-material="<%= item.material_type || 'baustahl' %>"
                    onclick="openMoveModal(this)"
                    class="px-2 py-1 bg-indigo-50 text-indigo-600 hover:bg-indigo-100 dark:bg-indigo-900/30 dark:text-indigo-400 rounded text-xs font-semibold transition"
                    title="In anderen Tab verschieben">↗</button>
                  <form action="/lager/delete" method="POST" onsubmit="return confirm('Eintrag wirklich löschen?');" class="inline">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <input type="hidden" name="tab" value="<%= tab %>">
                    <button type="submit" class="px-2 py-1 bg-red-50 text-red-600 hover:bg-red-100 dark:bg-red-900/30 dark:text-red-400 rounded text-xs font-semibold transition">🗑️</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center py-16">
        <p class="text-4xl mb-3">📭</p>
        <p class="text-gray-500 dark:text-gray-400 font-medium">Keine Einträge vorhanden</p>
        <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">Lieferschein fotografieren oder Eintrag manuell hinzufügen</p>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       TAB: ENTNAHMEN
  ═══════════════════════════════════════════════════════════════════════════ -->
  <% if (tab === 'entnahmen') { %>
  <div class="px-4 md:px-6 pb-10 w-full max-w-7xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden">
      <% if (entnahmen && entnahmen.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[700px]">
          <thead class="bg-gray-50 dark:bg-slate-700 border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
            <tr>
              <th class="px-4 py-3">Material</th>
              <th class="px-4 py-3">Menge</th>
              <th class="px-4 py-3">Auftrag</th>
              <th class="px-4 py-3">Mitarbeiter</th>
              <th class="px-4 py-3">Notiz</th>
              <th class="px-4 py-3">Datum</th>
              <th class="px-4 py-3 text-right">Aktion</th>
            </tr>
          </thead>
          <tbody>
            <% entnahmen.forEach(e => { %>
            <tr class="border-b dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700/50 text-sm">
              <td class="px-4 py-3 font-semibold text-gray-800 dark:text-gray-100">
                <%= e.mat_bezeichnung || '–' %><% if (e.mat_profil) { %> <span class="text-gray-400 font-normal"><%= e.mat_profil %></span><% } %>
              </td>
              <td class="px-4 py-3 text-amber-600 dark:text-amber-400 font-semibold">
                − <%= Number(e.menge).toLocaleString('de-DE') %> <%= e.einheit %>
              </td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300 text-xs">
                <% if (e.project_title) { %>
                  <a href="/projects/<%= e.project_id %>" class="text-blue-600 hover:underline"><%= e.project_title %></a>
                <% } else { %>–<% } %>
              </td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs"><%= e.username || '–' %></td>
              <td class="px-4 py-3 text-gray-400 text-xs max-w-[160px] truncate"><%= e.notiz || '' %></td>
              <td class="px-4 py-3 text-gray-400 text-xs"><%= new Date(e.created_at).toLocaleString('de-DE', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) %></td>
              <td class="px-4 py-3 text-right">
                <form action="/lager/entnahme/delete" method="POST"
                  onsubmit="return confirm('Entnahme stornieren? Der Bestand wird wiederhergestellt.');" class="inline">
                  <input type="hidden" name="id" value="<%= e.id %>">
                  <button type="submit" class="px-2 py-1 bg-red-50 text-red-500 hover:bg-red-100 dark:bg-red-900/30 dark:text-red-400 rounded text-xs font-semibold transition">
                    Stornieren
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center py-16">
        <p class="text-4xl mb-3">📤</p>
        <p class="text-gray-500 dark:text-gray-400 font-medium">Noch keine Entnahmen gebucht</p>
        <p class="text-sm text-gray-400 mt-1">Materialverbrauch per "Entnahme buchen" einem Auftrag zuordnen</p>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       TAB: RESTSTÜCKE
  ═══════════════════════════════════════════════════════════════════════════ -->
  <% if (tab === 'reste') { %>
  <div class="px-4 md:px-6 pb-10 w-full max-w-7xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden">
      <% if (reste && reste.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[700px]">
          <thead class="bg-gray-50 dark:bg-slate-700 border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
            <tr>
              <th class="px-4 py-3">Typ</th>
              <th class="px-4 py-3">Bezeichnung</th>
              <th class="px-4 py-3">Profil</th>
              <th class="px-4 py-3">Länge / Maß</th>
              <th class="px-4 py-3">Menge</th>
              <th class="px-4 py-3">Lagerort</th>
              <th class="px-4 py-3">Notiz</th>
              <th class="px-4 py-3">Eingelagert</th>
              <th class="px-4 py-3 text-right">Aktion</th>
            </tr>
          </thead>
          <tbody>
            <% reste.forEach(r => { %>
            <tr class="border-b dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700/50 text-sm">
              <td class="px-4 py-3">
                <span class="text-xs px-2 py-0.5 rounded-full font-semibold
                  <%= r.material_type === 'edelstahl' ? 'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300' : 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300' %>">
                  <%= r.material_type === 'edelstahl' ? '✨ Edelstahl' : '🔩 Baustahl' %>
                </span>
              </td>
              <td class="px-4 py-3 font-semibold text-gray-800 dark:text-gray-100"><%= r.bezeichnung %></td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= r.profil || '-' %></td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= r.laenge || '-' %></td>
              <td class="px-4 py-3 font-semibold text-emerald-600 dark:text-emerald-400">
                <%= Number(r.menge).toLocaleString('de-DE') %> <%= r.einheit %>
              </td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs"><%= r.lagerort || '-' %></td>
              <td class="px-4 py-3 text-gray-400 text-xs max-w-[140px] truncate"><%= r.notiz || '' %></td>
              <td class="px-4 py-3 text-gray-400 text-xs"><%= new Date(r.created_at).toLocaleDateString('de-DE') %></td>
              <td class="px-4 py-3 text-right">
                <form action="/lager/rest/delete" method="POST" onsubmit="return confirm('Reststück wirklich löschen?');" class="inline">
                  <input type="hidden" name="id" value="<%= r.id %>">
                  <button type="submit" class="px-2 py-1 bg-red-50 text-red-600 hover:bg-red-100 dark:bg-red-900/30 dark:text-red-400 rounded text-xs font-semibold transition">🗑️</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center py-16">
        <p class="text-4xl mb-3">✂️</p>
        <p class="text-gray-500 dark:text-gray-400 font-medium">Keine Reststücke eingelagert</p>
        <p class="text-sm text-gray-400 mt-1">Verschnitt und Reststücke hier erfassen, um Neukäufe zu vermeiden</p>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

</main>

<!-- ═══════════════════════════════════════════
     MODAL: MATERIAL EINLAGERN
═══════════════════════════════════════════ -->
<div id="addModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center px-4"
     onclick="closeModal('addModal', event)">
  <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl w-full max-w-lg p-6 max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
    <div class="flex justify-between items-center mb-5">
      <h2 id="addModalTitle" class="text-lg font-bold text-gray-800 dark:text-gray-100">+ Material einlagern</h2>
      <button onclick="closeModal('addModal')" class="text-gray-400 hover:text-gray-600 text-xl leading-none">✕</button>
    </div>
    <form action="/lager/add" method="POST" class="space-y-3">
      <div class="grid grid-cols-2 gap-3">

        <!-- Typ-Auswahl -->
        <div class="col-span-2">
          <label class="lbl">Material-Typ *</label>
          <select name="material_type" id="addMaterialType" onchange="updateAddModalFields()" class="fi w-full">
            <option value="baustahl"  <%= tab === 'baustahl'  ? 'selected' : '' %>>🔩 Baustahl</option>
            <option value="edelstahl" <%= tab === 'edelstahl' ? 'selected' : '' %>>✨ Edelstahl</option>
            <option value="schrauben" <%= tab === 'schrauben' ? 'selected' : '' %>>🔧 Schrauben & Kleinteile</option>
            <% for (const ct of (customTabs || [])) { %>
            <option value="<%= ct.key %>" <%= tab === ct.key ? 'selected' : '' %>><%= ct.icon %> <%= ct.label %></option>
            <% } %>
          </select>
        </div>

        <!-- ── STAHL-FELDER (Baustahl / Edelstahl) ──────────── -->
        <div id="addStahlFelder" class="col-span-2 grid grid-cols-2 gap-3">
          <div class="col-span-2">
            <label class="lbl">Bezeichnung *</label>
            <input type="text" name="bezeichnung" id="addBezeichnungStahl" placeholder="z.B. Flachstahl, Rohr, Winkel…" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Profil</label>
            <input type="text" name="profil" id="addProfil" placeholder="z.B. 40×5" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Abmessung / Länge</label>
            <input type="text" name="abmessung" id="addAbmessung" placeholder="z.B. 6000 mm" class="fi w-full">
          </div>
        </div>

        <!-- ── SCHRAUBEN-FELDER ──────────────────────────────── -->
        <div id="addSchraubenFelder" class="col-span-2 grid grid-cols-2 gap-3 hidden">
          <div class="col-span-2">
            <label class="lbl">Bezeichnung *</label>
            <input type="text" name="bezeichnung" id="addBezeichnungSchrauben" placeholder="z.B. Sechskantschraube, Inbus, Gewindestange…" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Gewinde (Profil)</label>
            <select name="profil" id="addGewindeSel" class="fi w-full" onchange="addGewindeCustomCheck(this)">
              <option value="">– wählen –</option>
              <option>M3</option><option>M4</option><option>M5</option><option>M6</option>
              <option>M8</option><option>M10</option><option>M12</option><option>M14</option>
              <option>M16</option><option>M18</option><option>M20</option><option>M24</option>
              <option value="__custom__">Eigenes…</option>
            </select>
            <input type="text" id="addGewindeCustom" name="profil_custom" placeholder="z.B. M7, 1/4&quot;" class="fi w-full mt-1 hidden">
          </div>
          <div>
            <label class="lbl">Länge (Abmessung)</label>
            <select name="abmessung" id="addLaengeSel" class="fi w-full" onchange="addLaengeCustomCheck(this)">
              <option value="">– wählen –</option>
              <option>6 mm</option><option>8 mm</option><option>10 mm</option><option>12 mm</option>
              <option>16 mm</option><option>20 mm</option><option>25 mm</option><option>30 mm</option>
              <option>35 mm</option><option>40 mm</option><option>50 mm</option><option>60 mm</option>
              <option>70 mm</option><option>80 mm</option><option>100 mm</option><option>120 mm</option>
              <option>150 mm</option><option>200 mm</option>
              <option value="__custom__">Eigene…</option>
            </select>
            <input type="text" id="addLaengeCustom" name="abmessung_custom" placeholder="z.B. 45 mm, 1m" class="fi w-full mt-1 hidden">
          </div>
          <div>
            <label class="lbl">Kopfform / Typ</label>
            <select name="notiz" id="addKopfform" class="fi w-full">
              <option value="">– optional –</option>
              <option>Sechskant (DIN 933)</option>
              <option>Sechskant mit Schaft (DIN 931)</option>
              <option>Zylinderkopf Inbus (DIN 912)</option>
              <option>Senkkopf Inbus (DIN 7991)</option>
              <option>Flachkopf Inbus (ISO 7380)</option>
              <option>Kreuzschlitz PH (DIN 965)</option>
              <option>Linsenkopf Torx</option>
              <option>Gewindestange (DIN 975)</option>
              <option>Scheibe (DIN 125)</option>
              <option>Scheibe groß (DIN 9021)</option>
              <option>Sicherungsmutter (DIN 985)</option>
              <option>Sechskantmutter (DIN 934)</option>
              <option>Stockschraube</option>
              <option>Ankerschraube</option>
            </select>
          </div>
          <div>
            <label class="lbl">Güte / Material</label>
            <select name="notiz2" id="addGuete" class="fi w-full">
              <option value="">– optional –</option>
              <option>4.6</option><option>4.8</option><option>5.6</option>
              <option>8.8</option><option>10.9</option><option>12.9</option>
              <option>A2 (V2A / 1.4301)</option>
              <option>A4 (V4A / 1.4404)</option>
              <option>verzinkt</option><option>blank</option><option>Edelstahl</option>
            </select>
          </div>
        </div>

        <!-- ── GEMEINSAME FELDER (immer sichtbar) ────────────── -->
        <div>
          <label class="lbl">Menge *</label>
          <input type="text" name="menge" required placeholder="0" class="fi w-full">
        </div>
        <div>
          <label class="lbl">Einheit</label>
          <select name="einheit" id="addEinheit" class="fi w-full">
            <option>Stk</option><option>m</option><option>kg</option><option>Beutel</option><option>Psch</option>
          </select>
        </div>
        <div>
          <label class="lbl">Mindestbestand</label>
          <input type="text" name="mindestbestand" placeholder="0 = kein Limit" class="fi w-full">
        </div>
        <div>
          <label class="lbl">Lagerort</label>
          <input type="text" name="lagerort" placeholder="z.B. Regal A3, Kiste B2" class="fi w-full">
        </div>
        <div id="addLieferscheinFelder" class="col-span-2 grid grid-cols-2 gap-3">
          <div>
            <label class="lbl">Lieferschein-Nr.</label>
            <input type="text" name="lieferschein_nr" placeholder="LS-12345" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Lieferdatum</label>
            <input type="date" name="lieferdatum" class="fi w-full">
          </div>
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeModal('addModal')" class="flex-1 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition">Abbrechen</button>
        <button type="submit" id="addSubmitBtn" onclick="prepareAddSubmit()" class="flex-1 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition">Speichern</button>
      </div>
    </form>
  </div>
</div>

