<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex flex-col overflow-y-auto page-bg min-h-screen pt-16">

  <!-- ── Header ─────────────────────────────────────────────────────────────── -->
  <%
    // Custom-Tab-Keys für Bedingungs-Checks
    const customTabKeys = (customTabs || []).map(t => t.key);
    const isStockTab = tab === 'baustahl' || tab === 'edelstahl' || tab === 'schrauben' || customTabKeys.includes(tab);
  %>
  <div class="px-4 md:px-6 mb-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
    <div>
      <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100 flex items-center gap-2">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 4l9 5.5V19a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1V9.5z"/></svg>
        Lagerverwaltung
      </h1>
      <p class="text-sm text-gray-500 dark:text-gray-400">Baustahl · Edelstahl · Schrauben · Entnahmen · Reststücke</p>
    </div>
    <div class="flex flex-wrap gap-2 w-full md:w-auto">
      <% if (isStockTab) { %>
        <a href="/lager/inventur?tab=<%= tab %>"
          class="btn btn-ghost text-sm" style="background:#334155;color:#fff;border-color:#334155">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
          Inventur
        </a>
      <% } %>
      <% if (isStockTab) { %>
        <% if (tab !== 'schrauben') { %>
        <button onclick="openScanModal()"
          class="btn text-sm" style="background:#7c3aed;color:#fff">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="15" rx="2"/><circle cx="12" cy="12.5" r="3.5"/><path d="M8 5l1.5-2h5L16 5"/></svg>
          Lieferschein
        </button>
        <% } %>
        <button onclick="openAddModal()"
          class="btn btn-primary text-sm">
          + Einlagern
        </button>
        <button onclick="openEntnahmeModal()"
          class="btn text-sm" style="background:#d97706;color:#fff">
          ↓ Entnahme buchen
        </button>
      <% } else if (tab === 'entnahmen') { %>
        <button onclick="openEntnahmeModal()"
          class="btn text-sm" style="background:#d97706;color:#fff">
          ↓ Entnahme buchen
        </button>
      <% } %>
      <% if (tab === 'reste') { %>
        <button onclick="openRestModal()"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-3 py-2 rounded-lg shadow text-sm flex items-center gap-1.5">
          + Reststück einlagern
        </button>
      <% } %>
    </div>
  </div>

  <!-- ── Verschoben-Banner ────────────────────────────────────────────────── -->
  <% if (typeof moved !== 'undefined' && moved) { %>
  <div class="px-4 md:px-6 mb-3">
    <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-300 dark:border-blue-700 rounded-xl px-4 py-3 flex items-center gap-3">
      <span class="text-blue-500 text-xl">↗️</span>
      <p class="text-sm font-semibold text-blue-800 dark:text-blue-300">Eintrag erfolgreich verschoben.</p>
    </div>
  </div>
  <% } %>

  <!-- ── Scan-Erfolgs-Banner ──────────────────────────────────────────────── -->
  <% if (scanBs > 0 || scanEs > 0) { %>
  <div class="px-4 md:px-6 mb-3">
    <div class="bg-green-50 dark:bg-green-900/20 border border-green-300 dark:border-green-700 rounded-xl px-4 py-3 flex items-start gap-3">
      <span class="text-green-500 mt-0.5"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></span>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-green-800 dark:text-green-300">Lieferschein erfolgreich eingelagert</p>
        <div class="flex flex-wrap gap-3 mt-1">
          <% if (scanBs > 0) { %>
          <a href="/lager?tab=baustahl" class="text-xs text-blue-600 dark:text-blue-400 font-medium hover:underline">
            🔩 <strong><%= scanBs %></strong> Position<%= scanBs === 1 ? '' : 'en' %> → Baustahl
          </a>
          <% } %>
          <% if (scanEs > 0) { %>
          <a href="/lager?tab=edelstahl" class="text-xs text-violet-600 dark:text-violet-400 font-medium hover:underline">
            ✨ <strong><%= scanEs %></strong> Position<%= scanEs === 1 ? '' : 'en' %> → Edelstahl
          </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ── Low-Stock-Banner ──────────────────────────────────────────────────── -->
  <%
    const lowStockItems = items.filter(i => Number(i.mindestbestand) > 0 && Number(i.menge) <= Number(i.mindestbestand));
  %>
  <% if ((tab === 'baustahl' || tab === 'edelstahl' || tab === 'schrauben') && lowStockItems.length > 0) { %>
  <div class="px-4 md:px-6 mb-3">
    <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-300 dark:border-amber-700 rounded-xl px-4 py-3 flex items-start gap-3">
      <span class="text-amber-500 mt-0.5"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4m0 4h.01M10.3 3.9L2.5 17a1.5 1.5 0 001.3 2.3h16.4a1.5 1.5 0 001.3-2.3L13.7 3.9a1.5 1.5 0 00-2.6 0z"/></svg></span>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-amber-800 dark:text-amber-300">
          <%= lowStockItems.length %> Artikel <%= lowStockItems.length === 1 ? 'ist' : 'sind' %> unter Mindestbestand
        </p>
        <p class="text-xs text-amber-700 dark:text-amber-400 mt-0.5 truncate">
          <%= lowStockItems.map(i => i.bezeichnung + (i.profil ? ' ' + i.profil : '')).join(' · ') %>
        </p>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ── Tabs ──────────────────────────────────────────────────────────────── -->
  <div class="px-4 md:px-6 mb-4">
    <div class="flex gap-2 overflow-x-auto pb-2 -mx-1 px-1 snap-x snap-mandatory" style="-webkit-overflow-scrolling:touch;scrollbar-width:none">
      <a href="/lager?tab=baustahl"
        class="chip snap-start shrink-0 <%= tab === 'baustahl' ? 'active' : '' %>">
        <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="1"/><path d="M4 9h16M9 4v16"/></svg>Baustahl
      </a>
      <a href="/lager?tab=edelstahl"
        class="px-4 py-2 text-sm font-semibold border-b-2 transition -mb-px whitespace-nowrap
               <%= tab === 'edelstahl' ? 'border-blue-600 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400' %>">
        <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.2 6.8H21l-5.6 4.1 2.2 6.8L12 16.6l-5.6 4.1 2.2-6.8L3 9.8h6.8z"/></svg>Edelstahl
      </a>
      <a href="/lager?tab=schrauben"
        class="px-4 py-2 text-sm font-semibold border-b-2 transition -mb-px whitespace-nowrap
               <%= tab === 'schrauben' ? 'border-orange-600 text-orange-600 dark:text-orange-400' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400' %>">
        <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>Schrauben
      </a>
      <% /* ── Custom-Tabs ────────────────────────────────────── */ %>
      <% const colorMap = { blue:'border-blue-600 text-blue-600 dark:text-blue-400', violet:'border-violet-600 text-violet-600 dark:text-violet-400', emerald:'border-emerald-600 text-emerald-600 dark:text-emerald-400', amber:'border-amber-600 text-amber-600 dark:text-amber-400', rose:'border-rose-600 text-rose-600 dark:text-rose-400', slate:'border-slate-600 text-slate-600 dark:text-slate-400', orange:'border-orange-600 text-orange-600 dark:text-orange-400', cyan:'border-cyan-600 text-cyan-600 dark:text-cyan-400' }; %>
      <% for (const ct of (customTabs || [])) { %>
      <a href="/lager?tab=<%= ct.key %>"
        class="chip snap-start shrink-0 <%= tab === ct.key ? 'active' : '' %>">
        <%= ct.icon %> <%= ct.label %>
      </a>
      <% } %>
      <a href="/lager?tab=entnahmen"
        class="chip snap-start shrink-0 <%= tab === 'entnahmen' ? 'active' : '' %>">
        <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>Entnahmen
      </a>
      <a href="/lager?tab=reste"
        class="chip snap-start shrink-0 <%= tab === 'reste' ? 'active' : '' %>">
        <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4L8.5 12 20 20M8.5 12H4"/></svg>Reststücke
      </a>
    </div>
  </div>

  <%- include('partials/lager/tab-stock') %>
  <%- include('partials/lager/tab-entnahmen') %>
  <%- include('partials/lager/tab-reste') %>
</main>

<!-- ═══════════════════════════════════════════
     MODAL: MATERIAL EINLAGERN
═══════════════════════════════════════════ -->
<div id="addModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-end sm:items-center justify-center px-0 sm:px-4"
     onclick="closeModal('addModal', event)">
  <div class="bg-white dark:bg-slate-800 rounded-t-2xl sm:rounded-2xl shadow-2xl w-full max-w-lg p-5 sm:p-6 max-h-[92vh] overflow-y-auto modal-panel" onclick="event.stopPropagation()">
    <div class="sm:hidden w-10 h-1 rounded-full bg-slate-300 dark:bg-slate-600 mx-auto mb-4"></div>
    <div class="flex justify-between items-center mb-5">
      <h2 id="addModalTitle" class="text-lg font-bold text-gray-800 dark:text-gray-100">+ Material einlagern</h2>
      <button onclick="closeModal('addModal')" class="text-gray-400 hover:text-gray-600 text-xl leading-none">✕</button>
    </div>
    <form action="/lager/add" method="POST" class="space-y-3" data-offline="true" data-offline-label="Material einlagern">
      <div class="grid grid-cols-2 gap-3">

        <!-- Typ-Auswahl -->
        <div class="col-span-2">
          <label class="lbl">Material-Typ *</label>
          <select name="material_type" id="addMaterialType" onchange="updateAddModalFields()" class="fi w-full">
            <option value="baustahl"  <%= tab === 'baustahl'  ? 'selected' : '' %>>🔩 Baustahl</option>
            <option value="edelstahl" <%= tab === 'edelstahl' ? 'selected' : '' %>>✨ Edelstahl</option>
            <option value="schrauben" <%= tab === 'schrauben' ? 'selected' : '' %>>🔧 Schrauben & Kleinteile</option>
            <% for (const ct of (customTabs || [])) { %>
            <option value="<%= ct.key %>" <%= tab === ct.key ? 'selected' : '' %>><%= ct.icon %> <%= ct.label %></option>
            <% } %>
          </select>
        </div>

        <!-- ── STAHL-FELDER (Baustahl / Edelstahl) ──────────── -->
        <div id="addStahlFelder" class="col-span-2 grid grid-cols-2 gap-3">
          <div class="col-span-2">
            <label class="lbl">Bezeichnung *</label>
            <input type="text" name="bezeichnung" id="addBezeichnungStahl" placeholder="z.B. Flachstahl, Rohr, Winkel…" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Profil</label>
            <input type="text" name="profil" id="addProfil" placeholder="z.B. 40×5" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Abmessung / Länge</label>
            <input type="text" name="abmessung" id="addAbmessung" placeholder="z.B. 6000 mm" class="fi w-full">
          </div>
        </div>

        <!-- ── SCHRAUBEN-FELDER ──────────────────────────────── -->
        <div id="addSchraubenFelder" class="col-span-2 grid grid-cols-2 gap-3 hidden">
          <div class="col-span-2">
            <label class="lbl">Bezeichnung *</label>
            <input type="text" name="bezeichnung" id="addBezeichnungSchrauben" placeholder="z.B. Sechskantschraube, Inbus, Gewindestange…" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Gewinde (Profil)</label>
            <select name="profil" id="addGewindeSel" class="fi w-full" onchange="addGewindeCustomCheck(this)">
              <option value="">– wählen –</option>
              <option>M3</option><option>M4</option><option>M5</option><option>M6</option>
              <option>M8</option><option>M10</option><option>M12</option><option>M14</option>
              <option>M16</option><option>M18</option><option>M20</option><option>M24</option>
              <option value="__custom__">Eigenes…</option>
            </select>
            <input type="text" id="addGewindeCustom" name="profil_custom" placeholder="z.B. M7, 1/4&quot;" class="fi w-full mt-1 hidden">
          </div>
          <div>
            <label class="lbl">Länge (Abmessung)</label>
            <select name="abmessung" id="addLaengeSel" class="fi w-full" onchange="addLaengeCustomCheck(this)">
              <option value="">– wählen –</option>
              <option>6 mm</option><option>8 mm</option><option>10 mm</option><option>12 mm</option>
              <option>16 mm</option><option>20 mm</option><option>25 mm</option><option>30 mm</option>
              <option>35 mm</option><option>40 mm</option><option>50 mm</option><option>60 mm</option>
              <option>70 mm</option><option>80 mm</option><option>100 mm</option><option>120 mm</option>
              <option>150 mm</option><option>200 mm</option>
              <option value="__custom__">Eigene…</option>
            </select>
            <input type="text" id="addLaengeCustom" name="abmessung_custom" placeholder="z.B. 45 mm, 1m" class="fi w-full mt-1 hidden">
          </div>
          <div>
            <label class="lbl">Kopfform / Typ</label>
            <select name="notiz" id="addKopfform" class="fi w-full">
              <option value="">– optional –</option>
              <option>Sechskant (DIN 933)</option>
              <option>Sechskant mit Schaft (DIN 931)</option>
              <option>Zylinderkopf Inbus (DIN 912)</option>
              <option>Senkkopf Inbus (DIN 7991)</option>
              <option>Flachkopf Inbus (ISO 7380)</option>
              <option>Kreuzschlitz PH (DIN 965)</option>
              <option>Linsenkopf Torx</option>
              <option>Gewindestange (DIN 975)</option>
              <option>Scheibe (DIN 125)</option>
              <option>Scheibe groß (DIN 9021)</option>
              <option>Sicherungsmutter (DIN 985)</option>
              <option>Sechskantmutter (DIN 934)</option>
              <option>Stockschraube</option>
              <option>Ankerschraube</option>
            </select>
          </div>
          <div>
            <label class="lbl">Güte / Material</label>
            <select name="notiz2" id="addGuete" class="fi w-full">
              <option value="">– optional –</option>
              <option>4.6</option><option>4.8</option><option>5.6</option>
              <option>8.8</option><option>10.9</option><option>12.9</option>
              <option>A2 (V2A / 1.4301)</option>
              <option>A4 (V4A / 1.4404)</option>
              <option>verzinkt</option><option>blank</option><option>Edelstahl</option>
            </select>
          </div>
        </div>

        <!-- ── GEMEINSAME FELDER (immer sichtbar) ────────────── -->
        <div>
          <label class="lbl">Menge *</label>
          <input type="text" name="menge" required placeholder="0" class="fi w-full">
        </div>
        <div>
          <label class="lbl">Einheit</label>
          <select name="einheit" id="addEinheit" class="fi w-full">
            <option>Stk</option><option>m</option><option>kg</option><option>Beutel</option><option>Psch</option>
          </select>
        </div>
        <div>
          <label class="lbl">Preis / Einheit (€)</label>
          <div class="flex gap-1.5">
            <input type="text" name="einheitspreis" id="addEinheitspreis" placeholder="0.00" class="fi flex-1">
            <button type="button"
              onclick="fetchLagerKiPreis('add')"
              id="addKiPreisBtn"
              title="KI-Preisschätzung"
              class="px-2.5 py-1.5 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-xs font-semibold transition flex items-center gap-1 whitespace-nowrap">
              ✨ KI
            </button>
          </div>
          <p id="addKiPreisHinweis" class="hidden text-xs text-purple-600 dark:text-purple-400 mt-1"></p>
        </div>
        <div>
          <label class="lbl">Mindestbestand</label>
          <input type="text" name="mindestbestand" placeholder="0 = kein Limit" class="fi w-full">
        </div>
        <div>
          <label class="lbl">Lagerort</label>
          <input type="text" name="lagerort" placeholder="z.B. Regal A3, Kiste B2" class="fi w-full">
        </div>
        <div id="addLieferscheinFelder" class="col-span-2 grid grid-cols-2 gap-3">
          <div>
            <label class="lbl">Lieferschein-Nr.</label>
            <input type="text" name="lieferschein_nr" placeholder="LS-12345" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Lieferdatum</label>
            <input type="date" name="lieferdatum" class="fi w-full">
          </div>
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeModal('addModal')" class="flex-1 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition">Abbrechen</button>
        <button type="submit" id="addSubmitBtn" onclick="prepareAddSubmit()" class="flex-1 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition">Speichern</button>
      </div>
    </form>
  </div>
</div>

<!-- ═══════════════════════════════════════════
     MODAL: BEARBEITEN
═══════════════════════════════════════════ -->
<div id="editModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-end sm:items-center justify-center px-0 sm:px-4"
     onclick="closeModal('editModal', event)">
  <div class="bg-white dark:bg-slate-800 rounded-t-2xl sm:rounded-2xl shadow-2xl w-full max-w-lg p-5 sm:p-6 max-h-[92vh] overflow-y-auto modal-panel" onclick="event.stopPropagation()">
    <div class="sm:hidden w-10 h-1 rounded-full bg-slate-300 dark:bg-slate-600 mx-auto mb-4"></div>
    <div class="flex justify-between items-center mb-5">
      <h2 class="text-lg font-bold text-gray-800 dark:text-gray-100 flex items-center gap-2">
        <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-4"/><path d="M18.5 2.5a2.1 2.1 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Eintrag bearbeiten
      </h2>
      <button onclick="closeModal('editModal')" class="text-gray-400 hover:text-gray-600 text-xl leading-none">✕</button>
    </div>
    <form action="/lager/edit" method="POST" class="space-y-3" data-offline="true" data-offline-label="Material bearbeiten">
      <input type="hidden" name="id" id="editId">
      <div class="grid grid-cols-2 gap-3">

        <div class="col-span-2">
          <label class="lbl">Material-Typ *</label>
          <select name="material_type" id="editMaterialType" onchange="updateEditModalFields()" class="fi w-full">
            <option value="baustahl">🔩 Baustahl</option>
            <option value="edelstahl">✨ Edelstahl</option>
            <option value="schrauben">🔧 Schrauben & Kleinteile</option>
            <% for (const ct of (customTabs || [])) { %>
            <option value="<%= ct.key %>"><%= ct.icon %> <%= ct.label %></option>
            <% } %>
          </select>
        </div>

        <div class="col-span-2">
          <label class="lbl">Bezeichnung *</label>
          <input type="text" name="bezeichnung" id="editBezeichnung" required class="fi w-full">
        </div>

        <!-- Stahl-Felder -->
        <div id="editStahlFelder" class="col-span-2 grid grid-cols-2 gap-3">
          <div>
            <label class="lbl">Profil</label>
            <input type="text" name="profil" id="editProfil" placeholder="z.B. 40×5" class="fi w-full">
          </div>
          <div>
            <label class="lbl">Abmessung / Länge</label>
            <input type="text" name="abmessung" id="editAbmessung" placeholder="z.B. 6000 mm" class="fi w-full">
          </div>
