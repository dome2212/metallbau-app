<style>
  /* ── Formular-Inputs & Selects (Dark-Mode-sicher, kein @apply da CDN) ─── */
  .fi {
    display: block;
    width: 100%;
    border-radius: 0.5rem;
    border: 1.5px solid #e5e7eb;
    background: #ffffff;
    color: #1f2937;
    font-size: 0.875rem;
    padding: 0.5rem 0.75rem;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    -webkit-appearance: none;
    appearance: none;
  }
  .fi:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59,130,246,0.2);
  }
  /* Dark-Mode */
  .dark .fi {
    background: #334155 !important;
    color: #f1f5f9 !important;
    border-color: #475569;
    color-scheme: dark;
  }
  .dark .fi:focus {
    border-color: #60a5fa;
    box-shadow: 0 0 0 3px rgba(96,165,250,0.2);
  }
  .dark .fi option {
    background: #1e293b !important;
    color: #f1f5f9 !important;
  }
  /* Label */
  .lbl {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: #4b5563;
    margin-bottom: 0.25rem;
  }
  .dark .lbl { color: #94a3b8; }
  .form-input { /* Alias */ }
</style>

<script>
  // ── Modals ──────────────────────────────────────────────────────────────────
  function closeModal(id, event) {
    if (event && event.target !== document.getElementById(id)) return;
    document.getElementById(id).classList.add('hidden');
  }
  function openAddModal() {
    document.getElementById('addModal').classList.remove('hidden');
    updateAddModalFields(); // Felder sofort nach aktuellem Typ ausrichten
  }
  function openRestModal()     { document.getElementById('restModal').classList.remove('hidden'); }

  // ── Dynamische Felder: Einlagern-Modal ──────────────────────────────────────
  function updateAddModalFields() {
    const typ  = document.getElementById('addMaterialType').value;
    const isS  = typ === 'schrauben';
    document.getElementById('addStahlFelder').classList.toggle('hidden', isS);
    document.getElementById('addSchraubenFelder').classList.toggle('hidden', !isS);
    document.getElementById('addLieferscheinFelder').classList.toggle('hidden', isS);
    // Titel & Einheit anpassen
    document.getElementById('addModalTitle').textContent = isS ? '🔧 Schraube / Kleinteil einlagern' : '+ Material einlagern';
    const einheit = document.getElementById('addEinheit');
    if (einheit) einheit.value = isS ? 'Stk' : 'Stk';
    // required-Attribut auf das sichtbare Bezeichnungsfeld setzen
    document.getElementById('addBezeichnungStahl').required    = !isS;
    document.getElementById('addBezeichnungSchrauben').required = isS;
  }
  // Gewinde: "Eigenes…" zeigt Freitext
  function addGewindeCustomCheck(sel) {
    const custom = document.getElementById('addGewindeCustom');
    if (sel.value === '__custom__') {
      custom.classList.remove('hidden');
      custom.name = 'profil'; sel.name = '_profil_sel_ignore';
      custom.focus();
    } else {
      custom.classList.add('hidden');
      custom.name = 'profil_custom'; sel.name = 'profil';
    }
  }
  // Länge: "Eigene…" zeigt Freitext
  function addLaengeCustomCheck(sel) {
    const custom = document.getElementById('addLaengeCustom');
    if (sel.value === '__custom__') {
      custom.classList.remove('hidden');
      custom.name = 'abmessung'; sel.name = '_abm_sel_ignore';
      custom.focus();
    } else {
      custom.classList.add('hidden');
      custom.name = 'abmessung_custom'; sel.name = 'abmessung';
    }
  }
  // Beim Submit: Güte in Notiz einfließen lassen
  function prepareAddSubmit() {
    const typ = document.getElementById('addMaterialType').value;
    if (typ !== 'schrauben') return;
    const kopf  = document.getElementById('addKopfform').value;
    const guete = document.getElementById('addGuete').value;
    // Notiz = "Kopfform | Güte" (wird über name="notiz" gesendet)
    // addKopfform hat bereits name="notiz" – Güte wird als notiz2 separat gesendet
    // Bezeichnung: wenn leer den Gewinde+Länge-Wert vorbelegen
    const bez = document.getElementById('addBezeichnungSchrauben');
    if (!bez.value.trim()) {
      const gw = document.getElementById('addGewindeSel').value !== '__custom__'
                  ? document.getElementById('addGewindeSel').value
                  : document.getElementById('addGewindeCustom').value;
      const la = document.getElementById('addLaengeSel').value !== '__custom__'
                  ? document.getElementById('addLaengeSel').value
                  : document.getElementById('addLaengeCustom').value;
      if (gw || la) bez.value = [gw, la].filter(Boolean).join(' × ');
    }
  }
  document.addEventListener('DOMContentLoaded', updateAddModalFields);

  // ── Dynamische Felder: Bearbeiten-Modal ─────────────────────────────────────
  function updateEditModalFields() {
    const typ = document.getElementById('editMaterialType').value;
    const isS = typ === 'schrauben';
    document.getElementById('editStahlFelder').classList.toggle('hidden', isS);
    document.getElementById('editSchraubenFelder').classList.toggle('hidden', !isS);
    document.getElementById('editNotizStahlBox').classList.toggle('hidden', isS);
    // Versteckte Felder deaktivieren, damit der Browser sie nicht mitsendet
    document.getElementById('editProfil').disabled    = isS;
    document.getElementById('editAbmessung').disabled = isS;
    document.getElementById('editGewindeFeld').disabled  = !isS;
    document.getElementById('editLaengeFeld').disabled   = !isS;
    document.getElementById('editNotiz').disabled        = isS;
    // Profil/Abmessung-Werte zwischen den Feldern synchronisieren
    if (isS) {
      document.getElementById('editGewindeFeld').value = document.getElementById('editProfil').value || '';
      document.getElementById('editLaengeFeld').value  = document.getElementById('editAbmessung').value || '';
    } else {
      document.getElementById('editProfil').value    = document.getElementById('editGewindeFeld').value || '';
      document.getElementById('editAbmessung').value = document.getElementById('editLaengeFeld').value  || '';
    }
  }

  // ── Verschieben-Modal ────────────────────────────────────────────────────────
  const _typeLabel = { baustahl: '🔩 Baustahl', edelstahl: '✨ Edelstahl', schrauben: '🔧 Schrauben' };
  const _typeColor = {
    baustahl:  { active: 'border-blue-500 bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300', idle: 'border-gray-200 dark:border-slate-600 text-gray-600 dark:text-gray-300 hover:border-blue-300 dark:hover:border-blue-600' },
    edelstahl: { active: 'border-violet-500 bg-violet-50 text-violet-700 dark:bg-violet-900/30 dark:text-violet-300', idle: 'border-gray-200 dark:border-slate-600 text-gray-600 dark:text-gray-300 hover:border-violet-300 dark:hover:border-violet-600' },
    schrauben: { active: 'border-orange-500 bg-orange-50 text-orange-700 dark:bg-orange-900/30 dark:text-orange-300', idle: 'border-gray-200 dark:border-slate-600 text-gray-600 dark:text-gray-300 hover:border-orange-300 dark:hover:border-orange-600' },
  };

  function openMoveModal(btn) {
    const id          = btn.dataset.itemId;
    const bezeichnung = decodeURIComponent(btn.dataset.itemBezeichnung || '');
    const currentType = btn.dataset.itemMaterial || 'baustahl';

    document.getElementById('moveItemId').value        = id;
    document.getElementById('moveItemLabel').textContent = bezeichnung;
    document.getElementById('moveCurrentType').textContent = _typeLabel[currentType] || currentType;

    // Alle Tabs (inkl. Custom-Tabs) einfärben
    const _allTabKeys = ['baustahl', 'edelstahl', 'schrauben', <%- (customTabs||[]).map(t=>JSON.stringify(String(t.key||''))).join(',') %>];
    _allTabKeys.forEach(t => {
      const btn = document.getElementById('moveBtn' + t.charAt(0).toUpperCase() + t.slice(1))
               || document.getElementById('moveBtn_' + t);
      if (!btn) return;
      const isCurrentType = t === currentType;
      btn.className = btn.className
        .replace(/border-\S+/g, '').replace(/bg-\S+/g, '').replace(/text-\S+/g, '')
        .replace(/\s+/g, ' ').trim();
      if (isCurrentType) {
        btn.className += ' py-3 rounded-xl border-2 text-sm font-semibold flex flex-col items-center gap-1 opacity-40 cursor-not-allowed';
        btn.disabled = true;
        btn.title = 'Bereits in dieser Kategorie';
      } else {
        btn.className += ' py-3 rounded-xl border-2 text-sm font-semibold flex flex-col items-center gap-1 transition cursor-pointer ' + (_typeColor[t]?.idle || 'border-gray-200 dark:border-slate-600 text-gray-600 dark:text-gray-300 hover:border-gray-400');
        btn.disabled = false;
        btn.title = 'Verschieben nach ' + (_typeLabel[t] || t);
      }
    });

    document.getElementById('moveModal').classList.remove('hidden');
  }
  function closeMoveModal() {
    document.getElementById('moveModal').classList.add('hidden');
  }

  function openEntnahmeModal() {
    document.getElementById('entnahmeModal').classList.remove('hidden');
  }
  // Wrapper für data-* Attribut-Pattern (Entnahme)
  function openEntnahmeModalForEl(btn) {
    openEntnahmeModal();
    const sel = document.getElementById('entnahmeMaterialSelect');
    if (sel) { sel.value = btn.dataset.itemId; }
    updateEntnahmeHint();
  }
  // Alte Signatur für Kompatibilität behalten
  function openEntnahmeModalFor(itemId) {
    openEntnahmeModal();
    const sel = document.getElementById('entnahmeMaterialSelect');
    if (sel) sel.value = itemId;
    updateEntnahmeHint();
  }

  // Bestand-Hint im Entnahme-Modal aktuell halten
  document.addEventListener('DOMContentLoaded', () => {
    const sel = document.getElementById('entnahmeMaterialSelect');
    if (sel) sel.addEventListener('change', updateEntnahmeHint);
  });
  function updateEntnahmeHint() {
    const sel = document.getElementById('entnahmeMaterialSelect');
    const hint = document.getElementById('entnahmeBestandHint');
    const val  = document.getElementById('entnahmeBestandVal');
    if (!sel || !hint || !val) return;
    const opt = sel.options[sel.selectedIndex];
    if (opt && opt.dataset.bestand && opt.value) {
      const einheit = opt.dataset.einheit ? decodeURIComponent(opt.dataset.einheit) : '';
      val.textContent = opt.dataset.bestand + (einheit ? ' ' + einheit : '');
      hint.classList.remove('hidden');
    } else {
      hint.classList.add('hidden');
    }
  }

  // ── Edit-Modal ──────────────────────────────────────────────────────────────
  // Neue Variante: liest alle Felder sicher aus data-* Attributen
  function openEditModalEl(btn) {
    const d   = btn.dataset;
    const typ    = decodeURIComponent(d.itemMaterial   || 'baustahl');
    const profil = decodeURIComponent(d.itemProfil     || '');
    const abm    = decodeURIComponent(d.itemAbmessung  || '');
    const notiz  = decodeURIComponent(d.itemNotiz      || '');

    document.getElementById('editId').value             = d.itemId;
    document.getElementById('editMaterialType').value   = typ;
    document.getElementById('editBezeichnung').value    = decodeURIComponent(d.itemBezeichnung || '');
    document.getElementById('editMenge').value          = d.itemMenge || '';
    document.getElementById('editEinheit').value        = decodeURIComponent(d.itemEinheit || 'Stk');
    document.getElementById('editLsnr').value           = decodeURIComponent(d.itemLsnr || '');
    document.getElementById('editMindestbestand').value  = d.itemMindestbestand || '';
    document.getElementById('editLagerort').value        = decodeURIComponent(d.itemLagerort || '');
    document.getElementById('editLieferdatum').value     = d.itemLieferdatum || '';
    document.getElementById('editEinheitspreis').value   = d.itemEinheitspreis || '';
    // Stahl-Felder
    document.getElementById('editProfil').value    = profil;
    document.getElementById('editAbmessung').value = abm;
    document.getElementById('editNotiz').value     = notiz;
    // Schrauben-Felder
    document.getElementById('editGewindeFeld').value    = profil;
    document.getElementById('editLaengeFeld').value     = abm;
    document.getElementById('editNotizSchrauben').value = notiz;
    // Felder ein-/ausblenden je Typ
    updateEditModalFields();
    document.getElementById('editModal').classList.remove('hidden');
  }
  // Alte Variante für Rückwärtskompatibilität (nicht mehr genutzt, bleibt aber erhalten)
  function openEditModal(btn) {
    try {
      const item = JSON.parse(btn.dataset.item);
      document.getElementById('editId').value            = item.id;
      document.getElementById('editMaterialType').value  = item.material_type || 'baustahl';
      document.getElementById('editBezeichnung').value   = item.bezeichnung || '';
      document.getElementById('editProfil').value        = item.profil || '';
      document.getElementById('editAbmessung').value     = item.abmessung || '';
      document.getElementById('editMenge').value         = item.menge || '';
      document.getElementById('editEinheit').value       = item.einheit || 'Stk';
      document.getElementById('editLsnr').value          = item.lieferschein_nr || '';
      document.getElementById('editNotiz').value         = item.notiz || '';
      document.getElementById('editMindestbestand').value = item.mindestbestand || '';
      document.getElementById('editLagerort').value      = item.lagerort || '';
      document.getElementById('editLieferdatum').value   = item.lieferdatum ? item.lieferdatum.slice(0,10) : '';
      document.getElementById('editModal').classList.remove('hidden');
    } catch(e) { console.error('openEditModal Fehler:', e); }
  }

  // ── Scan-Modal ──────────────────────────────────────────────────────────────
  let scannedItems = [];
  let lastScanRaw = '';
  function openScanModal() {
    scannedItems = [];
    document.getElementById('scanModal').classList.remove('hidden');
    document.getElementById('scanPreviewWrap').classList.add('hidden');
    document.getElementById('scanStatus').classList.add('hidden');
    document.getElementById('scanResults').classList.add('hidden');
    document.getElementById('scanError').classList.add('hidden');
    document.getElementById('scanUploadArea').classList.remove('hidden');
    document.getElementById('scanFileInput').value = '';
  }
  function closeScanModal(event) {
    if (event && event.target !== document.getElementById('scanModal')) return;
    document.getElementById('scanModal').classList.add('hidden');
  }
  function handleScanDrop(e) {
    e.preventDefault();
    const file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) handleScanFile(file);
  }
  function handleScanFile(file) {
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => { document.getElementById('scanPreview').src = e.target.result; document.getElementById('scanPreviewWrap').classList.remove('hidden'); };
    reader.readAsDataURL(file);
    runScan(file);
  }
  async function runScan(file) {
    document.getElementById('scanUploadArea').classList.add('hidden');
    document.getElementById('scanStatus').classList.remove('hidden');
    document.getElementById('scanResults').classList.add('hidden');
    document.getElementById('scanError').classList.add('hidden');
    const formData = new FormData();
    formData.append('image', file);
    try {
      const res  = await fetch('/lager/scan', { method: 'POST', body: formData });
      const data = await res.json();
      document.getElementById('scanStatus').classList.add('hidden');
      if (!res.ok || data.error) { showScanError(data.error || 'Unbekannter Fehler'); return; }
      scannedItems = data.items || [];
      renderScanResults();
    } catch (err) {
      document.getElementById('scanStatus').classList.add('hidden');
      showScanError('Netzwerkfehler: ' + err.message);
    }
  }
  function renderScanResults() {
    const list = document.getElementById('scanItemsList');
    document.getElementById('scanCountBadge').textContent = scannedItems.length + ' Position(en)';

    // Zusammenfassung: alle material_types zählen
    const SCAN_TABS = [
      { key: 'baustahl',  label: '🔩 Baustahl',  cls: 'text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-900/30' },
      { key: 'edelstahl', label: '✨ Edelstahl',  cls: 'text-violet-700 dark:text-violet-300 bg-violet-50 dark:bg-violet-900/30' },
      { key: 'schrauben', label: '🔧 Schrauben',  cls: 'text-orange-700 dark:text-orange-300 bg-orange-50 dark:bg-orange-900/30' },
      <%- (customTabs||[]).map(t => `{ key: ${JSON.stringify(String(t.key||''))}, label: ${JSON.stringify(String(t.name||''))}, cls: 'text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-slate-700' }`).join(',') %>
    ];
    const summaryBar = document.getElementById('scanSummaryBar');
    if (scannedItems.length > 0) {
      summaryBar.innerHTML = SCAN_TABS
        .map(t => ({ ...t, n: scannedItems.filter(i => i.material_type === t.key).length }))
        .filter(t => t.n > 0)
        .map(t => `<span class="inline-flex items-center gap-1 text-xs font-semibold ${t.cls} px-2.5 py-1 rounded-full">${t.label} ${t.n}</span>`)
        .join('');
      summaryBar.classList.remove('hidden');
    } else {
      summaryBar.classList.add('hidden');
    }

    if (!scannedItems.length) {
      list.innerHTML = '<p class="text-sm text-gray-400 text-center py-4">Keine Positionen erkannt.</p>';
    } else {
      list.innerHTML = scannedItems.map((item, i) => `
        <div class="bg-gray-50 dark:bg-slate-700/50 rounded-lg p-3 border border-gray-200 dark:border-slate-600">
          <div class="grid grid-cols-2 gap-2 text-xs">
            <div class="col-span-2 flex items-center gap-2 mb-1">
              <select onchange="scannedItems[${i}].material_type=this.value;renderScanResults()" class="text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-1">
                <option value="baustahl" ${item.material_type==='baustahl'||(!['edelstahl','schrauben',<%- (customTabs||[]).map(t=>JSON.stringify(String(t.key||''))).join(',') %>].includes(item.material_type))?'selected':''}>🔩 Baustahl</option>
                <option value="edelstahl" ${item.material_type==='edelstahl'?'selected':''}>✨ Edelstahl</option>
                <option value="schrauben" ${item.material_type==='schrauben'?'selected':''}>🔧 Schrauben</option>
                <%- (customTabs||[]).map(t => { const k=String(t.key||'').replace(/"/g,'&quot;'); const n=String(t.name||'').replace(/</g,'&lt;').replace(/"/g,'&quot;'); return `<option value="${k}" \${item.material_type==='${k.replace(/'/g,"\\'")}'?'selected':''}>${n}</option>`; }).join('') %>
              </select>
              <input type="text" value="${esc(item.bezeichnung)}" onchange="scannedItems[${i}].bezeichnung=this.value"
                class="flex-1 text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-100 px-2 py-1 font-semibold">
            </div>
            <div><span class="text-gray-400">Profil:</span><input type="text" value="${esc(item.profil||'')}" onchange="scannedItems[${i}].profil=this.value" class="w-full text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 mt-0.5"></div>
            <div><span class="text-gray-400">Abmaß:</span><input type="text" value="${esc(item.abmessung||'')}" onchange="scannedItems[${i}].abmessung=this.value" class="w-full text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 mt-0.5"></div>
            <div><span class="text-gray-400">Menge:</span><input type="number" value="${item.menge||0}" onchange="scannedItems[${i}].menge=parseFloat(this.value)||0" class="w-full text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 mt-0.5"></div>
            <div><span class="text-gray-400">Einheit:</span><select onchange="scannedItems[${i}].einheit=this.value" class="w-full text-xs rounded border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 mt-0.5">${['Stk','m','kg','m²','Psch'].map(u=>`<option ${(item.einheit||'Stk')===u?'selected':''}>${u}</option>`).join('')}</select></div>
          </div>
        </div>`).join('');
    }
    document.getElementById('scanResults').classList.remove('hidden');
  }
  function prepareScanSave() { document.getElementById('scanItemsJson').value = JSON.stringify(scannedItems); }
  function showScanError(msg) {
    const el = document.getElementById('scanError');
    el.textContent = '❌ ' + msg;
    el.classList.remove('hidden');
    document.getElementById('scanUploadArea').classList.remove('hidden');
  }
  function esc(str) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  // ── KI-Preisschätzung für Lagerartikel ──────────────────────────────────────
  async function fetchLagerKiPreis(mode) {
    // Felder je nach Modal ermitteln
    const isAdd = mode === 'add';
    const preisInput  = document.getElementById(isAdd ? 'addEinheitspreis'  : 'editEinheitspreis');
    const hinweisEl   = document.getElementById(isAdd ? 'addKiPreisHinweis' : 'editKiPreisHinweis');
    const btn         = document.getElementById(isAdd ? 'addKiPreisBtn'     : 'editKiPreisBtn');

    // Bezeichnung + Profil aus den sichtbaren Feldern holen
    let bezeichnung = '', profil = '', einheit = 'Stk';
    if (isAdd) {
      // Stahl-Feld oder Schrauben-Feld sichtbar?
      const stahlVis = document.getElementById('addStahlFelder') &&
                       !document.getElementById('addStahlFelder').classList.contains('hidden');
      if (stahlVis) {
        bezeichnung = document.getElementById('addBezeichnung')?.value?.trim() || '';
        profil      = document.getElementById('addProfil')?.value?.trim()      || '';
      } else {
        bezeichnung = document.getElementById('addBezeichnungSchrauben')?.value?.trim() || '';
        const gw = document.getElementById('addGewindeSel')?.value;
        profil = (gw && gw !== '__custom__') ? gw : (document.getElementById('addGewindeCustom')?.value?.trim() || '');
      }
      einheit = document.getElementById('addEinheit')?.value || 'Stk';
    } else {
      bezeichnung = document.getElementById('editBezeichnung')?.value?.trim() || '';
      profil      = document.getElementById('editProfil')?.value?.trim()      ||
                    document.getElementById('editGewindeFeld')?.value?.trim() || '';
      einheit = document.getElementById('editEinheit')?.value || 'Stk';
    }

    if (!bezeichnung) {
      hinweisEl.textContent = '⚠️ Bitte zuerst eine Bezeichnung eingeben.';
      hinweisEl.classList.remove('hidden');
      return;
    }

    // Button deaktivieren + Ladetext
    btn.disabled = true;
    btn.textContent = '…';
    hinweisEl.textContent = '';
    hinweisEl.classList.add('hidden');

    try {
      const resp = await fetch('/api/ai/lager-price', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ bezeichnung, profil, einheit })
      });
      const data = await resp.json();

      if (!resp.ok || data.error) {
        hinweisEl.textContent = '❌ ' + (data.error || 'KI-Fehler');
        hinweisEl.classList.remove('hidden');
        return;
      }

      // Preis ins Feld eintragen
      const ep = Number(data.einheitspreis);
      if (!isNaN(ep) && ep > 0) {
        preisInput.value = ep.toFixed(2).replace('.', ',');
        preisInput.classList.add('ring-2', 'ring-purple-400');
        setTimeout(() => preisInput.classList.remove('ring-2', 'ring-purple-400'), 2000);
      }

      // Begründung anzeigen
      if (data.begruendung) {
        hinweisEl.textContent = '✨ ' + data.begruendung;
        hinweisEl.classList.remove('hidden');
      }
    } catch (e) {
      hinweisEl.textContent = '❌ Netzwerkfehler: ' + e.message;
      hinweisEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '✨ KI';
    }
  }
</script>

<script>
(function lagerToastInit(){
  const params = new URLSearchParams(location.search);
  const ok = params.get('ok') || params.get('success') || params.get('msg');
  const err = params.get('error') || params.get('err');
  if (typeof showToast === 'function') {
    if (ok) showToast(decodeURIComponent(ok === '1' ? 'Gespeichert' : ok), 'success');
    if (err) showToast(decodeURIComponent(err), 'error');
  }
  // Intercept successful form navigations feel: toast on submit of offline forms
  document.querySelectorAll('form[action^="/lager"]').forEach(f => {
    f.addEventListener('submit', () => {
      if (typeof showToast === 'function' && !f.dataset.noToast) {
        const label = f.dataset.offlineLabel || 'Gespeichert';
        // only show if not delete confirm cancel - submit already firing
        if (f.action.includes('delete')) return;
        setTimeout(() => showToast(label, 'success'), 50);
      }
      if (navigator.vibrate) navigator.vibrate(10);
    });
  });
})();
</script>
