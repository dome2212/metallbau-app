<%- include('partials/header') %>

<%- include('partials/sidebar') %>
<main class="flex-1 flex flex-col overflow-y-auto page-bg min-h-screen pt-16">
    <!-- Header -->
    <div class="px-4 md:px-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <div class="text-xs md:text-sm text-blue-600 mb-1">
          <a href="/customers" class="hover:underline">← Zurück zur Kundenübersicht</a>
        </div>
        <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">Projekte & Vorgänge: <%= customer.company_name || customer.contact_person %></h1>
        <p class="text-xs md:text-sm text-gray-500 dark:text-gray-400 mt-1">
          <%= customer.street || '' %>, <%= customer.zip || '' %> <%= customer.city || '' %> 
          <%= customer.phone ? '| 📞 ' + customer.phone : '' %> 
          <%= customer.email ? '| ✉️ ' + customer.email : '' %>
        </p>
      </div>
    </div>

    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto pb-6 space-y-6">
      
      <!-- Dateien & Uploads -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-6 space-y-4">
        <h2 class="text-base md:text-lg font-bold text-gray-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2 flex items-center gap-2">
          <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg>
          Kundendateien & Dokumente
        </h2>
        
        <!-- Upload-Formular -->
        <form action="/customers/<%= customer.id %>/upload" method="POST" enctype="multipart/form-data" class="space-y-3 bg-gray-50 dark:bg-slate-700 p-4 rounded-lg border dark:border-slate-600">
          <label class="block text-xs font-medium text-gray-700 dark:text-gray-300">Datei hochladen (PDF, Bild, Zeichnung, etc.)</label>
          <input type="file" name="file" required class="w-full text-xs text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-4 py-2 rounded-lg transition w-full sm:w-auto">Datei hochladen</button>
        </form>

        <!-- Suche -->
        <% if (typeof files !== 'undefined' && files.length > 0) { %>
        <div class="relative">
          <input type="search" id="customerFileSearch" placeholder="Datei suchen (Name…)" autocomplete="off"
                 class="w-full text-sm rounded-lg border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-100 px-3 py-2 pl-9 focus:outline-none focus:ring-2 focus:ring-blue-500">
          <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        </div>
        <% } %>

        <!-- Liste der hochgeladenen Dateien -->
        <div id="customerFileList" class="space-y-2">
          <% if (typeof files !== 'undefined' && files.length > 0) { %>
            <% files.forEach(file => { %>
              <div class="customer-file-item flex justify-between items-center bg-gray-50 dark:bg-slate-700 p-3 rounded-lg border dark:border-slate-600 text-sm gap-2"
                   data-name="<%= (file.original_name || '').toLowerCase() %>">
                <span class="truncate text-gray-700 dark:text-gray-300 text-xs md:text-sm flex items-center gap-1.5 min-w-0">
                  <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5a1 1 0 001 1h5"/><path d="M6 21h12a1 1 0 001-1V7l-5-5H7a1 1 0 00-1 1v3"/></svg>
                  <span class="truncate"><%= file.original_name %></span>
                </span>
                <div class="flex items-center gap-2 shrink-0">
                  <a href="<%= file.file_url %>" target="_blank" class="text-blue-600 hover:underline text-xs font-medium whitespace-nowrap">Ansehen</a>
                  <form action="/customers/files/delete" method="POST" onsubmit="return confirm('Datei wirklich löschen?');" class="inline">
                    <input type="hidden" name="file_id" value="<%= file.id %>">
                    <input type="hidden" name="customer_id" value="<%= customer.id %>">
                    <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-medium">Löschen</button>
                  </form>
                </div>
              </div>
            <% }) %>
            <p id="customerFileEmpty" class="hidden text-xs text-gray-400 dark:text-slate-500 italic">Keine Datei passt zur Suche.</p>
          <% } else { %>
            <p class="text-xs text-gray-400 dark:text-slate-500 italic">Noch keine Dateien für diesen Kunden hochgeladen.</p>
          <% } %>
        </div>
      </div>
      <script>
        (function() {
          const input = document.getElementById('customerFileSearch');
          if (!input) return;
          const items = document.querySelectorAll('.customer-file-item');
          const empty = document.getElementById('customerFileEmpty');
          input.addEventListener('input', function() {
            const q = (this.value || '').toLowerCase().trim();
            let visible = 0;
            items.forEach(function(el) {
              const match = !q || (el.getAttribute('data-name') || '').indexOf(q) !== -1;
              el.style.display = match ? '' : 'none';
              if (match) visible++;
            });
            if (empty) empty.classList.toggle('hidden', visible > 0 || !q);
          });
        })();
      </script>

      <!-- Rechnungen -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-6">
        <h2 class="text-base md:text-lg font-bold text-gray-800 dark:text-gray-100 mb-3 border-b dark:border-slate-700 pb-2 flex items-center gap-2">
          <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l3 3v17l-2-1-2 1-2-1-2 1-2-1-2 1V2z"/><path d="M9 7h6M9 11h6M9 15h4"/></svg>
          Rechnungen
        </h2>
        <% if (typeof invoices !== 'undefined' && invoices.length > 0) { %>
          <div class="overflow-x-auto border dark:border-slate-700 rounded-lg">
            <table class="w-full text-left text-sm border-collapse min-w-[500px]">
              <thead class="bg-gray-50 dark:bg-slate-700 text-gray-500 dark:text-slate-300 uppercase text-xs border-b dark:border-slate-600">
                <tr>
                  <th class="p-3">Rechnungs-Nr.</th>
                  <th class="p-3">Betrag</th>
                  <th class="p-3">Status</th>
                  <th class="p-3 text-right">Aktion</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
                <% invoices.forEach(inv => { %>
                  <tr class="hover:bg-gray-50 dark:hover:bg-slate-700">
                    <td class="p-3 font-semibold text-gray-800 dark:text-gray-100"><%= inv.invoice_number %></td>
                    <td class="p-3 text-gray-600 dark:text-gray-300"><%= parseFloat(inv.total_amount || 0).toFixed(2) %> €</td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded text-xs font-semibold bg-blue-100 text-blue-800"><%= inv.status %></span></td>
                    <td class="p-3 text-right"><a href="/documents/invoices/<%= inv.id %>" class="text-blue-600 hover:underline text-xs font-semibold">Details 👁️</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-xs md:text-sm text-gray-400 dark:text-slate-500">Keine Rechnungen für diesen Kunden hinterlegt.</p>
        <% } %>
      </div>

      <!-- Angebote -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-6">
        <h2 class="text-base md:text-lg font-bold text-gray-800 dark:text-gray-100 mb-3 border-b dark:border-slate-700 pb-2 flex items-center gap-2">
          <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h10a1 1 0 011 1v16l-3-2-3 2-3-2-3 2V4a1 1 0 011-1z"/><path d="M9 8h6M9 11h6"/></svg>
          Angebote
        </h2>
        <% if (typeof offers !== 'undefined' && offers.length > 0) { %>
          <div class="overflow-x-auto border dark:border-slate-700 rounded-lg">
            <table class="w-full text-left text-sm border-collapse min-w-[400px]">
              <thead class="bg-gray-50 dark:bg-slate-700 text-gray-500 dark:text-slate-300 uppercase text-xs border-b dark:border-slate-600">
                <tr>
                  <th class="p-3">Angebots-Nr.</th>
                  <th class="p-3">Betrag</th>
                  <th class="p-3">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
                <% offers.forEach(off => { %>
                  <tr class="hover:bg-gray-50 dark:hover:bg-slate-700">
                    <td class="p-3 font-semibold text-gray-800 dark:text-gray-100"><%= off.doc_number %></td>
                    <td class="p-3 text-gray-600 dark:text-gray-300"><%= parseFloat(off.total_amount || 0).toFixed(2) %> €</td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded text-xs font-semibold bg-gray-100 dark:bg-slate-700 text-gray-800 dark:text-gray-200"><%= off.status %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-xs md:text-sm text-gray-400 dark:text-slate-500">Keine Angebote für diesen Kunden hinterlegt.</p>
        <% } %>
      </div>

      <!-- Termine -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-6">
        <h2 class="text-base md:text-lg font-bold text-gray-800 dark:text-gray-100 mb-3 border-b dark:border-slate-700 pb-2 flex items-center gap-2">
          <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 3v3M16 3v3"/></svg>
          Termine & Baustellen
        </h2>
        <% if (typeof appointments !== 'undefined' && appointments.length > 0) { %>
          <ul class="divide-y divide-gray-200 dark:divide-slate-700 text-sm">
            <% appointments.forEach(app => { %>
              <li class="py-3">
                <div class="font-semibold text-gray-800 dark:text-gray-100 text-sm"><%= app.title %></div>
                <div class="text-xs text-gray-500 dark:text-gray-400">📅 <%= app.start_date %></div>
                <% if (app.description) { %>
                  <p class="text-xs text-gray-600 dark:text-gray-300 mt-1 bg-gray-50 dark:bg-slate-700 p-2 rounded border dark:border-slate-600"><%= app.description %></p>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-xs md:text-sm text-gray-400 dark:text-slate-500">Keine Termine vorhanden.</p>
        <% } %>
      </div>

    </div>
  </main>

</body>
</html>
