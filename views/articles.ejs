<%- include('partials/header') %>

<div class="flex h-screen bg-gray-100 dark:bg-gray-900 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-gray-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">
    <div class="px-4 md:px-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">📦 Artikel- & Materialstamm</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Standardartikel und Leistungen für Angebote & Rechnungen</p>
      </div>
      <button onclick="toggleModal('addArticleModal')" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow text-sm w-full md:w-auto flex items-center justify-center gap-1">
        + Neuen Artikel anlegen
      </button>
    </div>

    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto pb-6">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[600px]">
            <thead class="bg-gray-50 dark:bg-slate-700 border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
              <tr>
                <th class="p-4">Bezeichnung / Titel</th>
                <th class="p-4">Einheit</th>
                <th class="p-4">Stückpreis</th>
                <th class="p-4">Beschreibung</th>
                <th class="p-4 text-right">Aktion</th>
              </tr>
            </thead>
            <tbody>
              <% if (articles && articles.length > 0) { %>
                <% articles.forEach(article => { %>
                  <tr class="border-b dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700 text-sm">
                    <td class="py-3 px-4 font-semibold text-gray-800 dark:text-gray-100"><%= article.title %></td>
                    <td class="py-3 px-4 text-gray-600 dark:text-gray-400"><%= article.unit %></td>
                    <td class="py-3 px-4 text-gray-800 dark:text-gray-200 font-medium"><%= Number(article.unit_price || 0).toLocaleString('de-DE', { minimumFractionDigits: 2 }) %> €</td>
                    <td class="py-3 px-4 text-gray-500 dark:text-gray-400 text-xs"><%= article.description || '-' %></td>
                    <td class="py-3 px-4 text-right">
                      <form action="/articles/delete" method="POST" onsubmit="return confirm('Artikel wirklich löschen?');" class="inline">
                        <input type="hidden" name="id" value="<%= article.id %>">
                        <button type="submit" class="px-2.5 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded text-xs font-semibold transition">🗑️ Löschen</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="p-6 text-center text-gray-400 dark:text-slate-500 text-sm italic">Keine Artikel vorhanden. Lege den ersten Artikel an.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Modal: Neuen Artikel anlegen -->
<div id="addArticleModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-md w-full p-4 md:p-6">
    <div class="flex justify-between items-center mb-4 border-b dark:border-slate-700 pb-2">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">Neuen Artikel anlegen</h3>
      <button onclick="toggleModal('addArticleModal')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl font-bold">&times;</button>
    </div>
    <form action="/articles/add" method="POST" class="space-y-3">
      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Bezeichnung / Titel *</label>
        <input type="text" name="title" required placeholder="z.B. Stahlrohr 40x40 mm" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Einheit *</label>
          <select name="unit" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white">
            <option value="Stk">Stk (Stück)</option>
            <option value="m">m (Meter)</option>
            <option value="m²">m²</option>
            <option value="kg">kg</option>
            <option value="Std">Std (Stunden)</option>
            <option value="Psch">Pauschale</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Stückpreis (€) *</label>
          <input type="text" name="unit_price" required placeholder="0.00" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Beschreibung (optional)</label>
        <input type="text" name="description" placeholder="z.B. Für Geländer und Rahmenkonstruktionen" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white">
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t dark:border-slate-700">
        <button type="button" onclick="toggleModal('addArticleModal')" class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Artikel speichern</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleModal(id) {
    document.getElementById(id).classList.toggle('hidden');
  }
</script>

</body>
</html>
