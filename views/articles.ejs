<%- include('partials/header') %>

<div class="flex h-screen bg-gray-100">
  <%- include('partials/sidebar') %>

  <main class="flex-1 p-6 overflow-y-auto">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Artikel- & Materialstamm</h1>
        <p class="text-sm text-gray-500">Verwalte Standardartikel, Materialpreise und Stundensätze</p>
      </div>
      <button onclick="toggleModal('articleModal')" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center gap-2">
        <span>+ Neuen Artikel anlegen</span>
      </button>
    </div>

    <!-- Artikel-Tabelle -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-500 uppercase">
          <tr>
            <th class="p-4">Bezeichnung</th>
            <th class="p-4">Beschreibung</th>
            <th class="p-4">Einheit</th>
            <th class="p-4">Preis (Netto)</th>
            <th class="p-4 text-right">Aktionen</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          <% if (typeof articles !== 'undefined' && articles.length > 0) { %>
            <% articles.forEach(art => { %>
              <tr class="hover:bg-gray-50">
                <td class="p-4 font-semibold text-gray-800"><%= art.title %></td>
                <td class="p-4 text-gray-600"><%= art.description || '-' %></td>
                <td class="p-4 font-medium text-gray-700"><%= art.unit %></td>
                <td class="p-4 font-bold text-gray-800">
                  <%= art.unit_price ? art.unit_price.toLocaleString('de-DE', {style:'currency', currency:'EUR'}) : '0,00 €' %>
                </td>
                <td class="p-4 text-right">
                  <form action="/articles/delete" method="POST" onsubmit="return confirm('Artikel wirklich löschen?');" class="inline">
                    <input type="hidden" name="id" value="<%= art.id %>">
                    <button type="submit" class="text-red-600 hover:text-red-800 text-xs font-semibold">Löschen</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="p-8 text-center text-gray-400">Keine Artikel im Stamm hinterlegt. Legen Sie jetzt Material oder Stundensätze an!</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</div>

<!-- Modal: Artikel anlegen -->
<div id="articleModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-xl shadow-lg max-w-md w-full p-6">
    <div class="flex justify-between items-center mb-4 border-b pb-2">
      <h3 class="text-lg font-bold text-gray-800">Neuen Artikel anlegen</h3>
      <button onclick="toggleModal('articleModal')" class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
    </div>

    <form action="/articles/add" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Artikelbezeichnung *</label>
        <input type="text" name="title" required placeholder="z.B. Edelstahlrohr 42,4x2,0mm V2A" class="w-full border rounded-lg p-2 text-sm">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Einheit</label>
          <select name="unit" class="w-full border rounded-lg p-2 text-sm bg-white">
            <option value="m">m (Meter)</option>
            <option value="Stk">Stk (Stück)</option>
            <option value="Std">Std (Stunden)</option>
            <option value="kg">kg (Kilogramm)</option>
            <option value="m²">m² (Quadratmeter)</option>
            <option value="Psch">Pauschale</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Einzelpreis (€) *</label>
          <input type="number" step="0.01" name="unit_price" required placeholder="45.00" class="w-full border rounded-lg p-2 text-sm">
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Beschreibung / Hinweis</label>
        <textarea name="description" rows="2" placeholder="Zustatzinfos z.B. geschliffen K240" class="w-full border rounded-lg p-2 text-sm"></textarea>
      </div>

      <div class="flex justify-end gap-2 pt-4 border-t">
        <button type="button" onclick="toggleModal('articleModal')" class="px-4 py-2 border rounded-lg text-sm text-gray-600 hover:bg-gray-50">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Speichern</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleModal(id) {
    document.getElementById(id).classList.toggle('hidden');
  }
</script>
</body>
</html>