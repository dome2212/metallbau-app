<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Artikel- & Materialstamm</title>
    <!-- Bootstrap CSS für ein schönes Design -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Artikel- & Materialstamm</h2>
            <a href="/" class="btn btn-secondary">Zurück zum Dashboard</a>
        </div>

        <!-- Formular zum Hinzufügen eines neuen Artikels -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Neuen Artikel anlegen</h5>
                <form action="/articles/add" method="POST" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Bezeichnung / Titel</label>
                        <input type="text" name="title" class="form-control" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Einheit (z.B. Stk, Std, m)</label>
                        <input type="text" name="unit" class="form-control" value="Stk" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Stückpreis (€)</label>
                        <input type="text" name="unit_price" class="form-control" placeholder="0.00" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Beschreibung (optional)</label>
                        <input type="text" name="description" class="form-control">
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Artikel speichern</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabelle zur Anzeige und zum Löschen der Artikel -->
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">Vorhandene Artikel</h5>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Artikel / Material</th>
                                <th>Einheit</th>
                                <th>Stückpreis</th>
                                <th>Beschreibung</th>
                                <th class="text-end">Aktion</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (articles && articles.length > 0) { %>
                                <% articles.forEach(article => { %>
                                    <tr>
                                        <td><strong><%= article.title %></strong></td>
                                        <td><%= article.unit %></td>
                                        <td><%= Number(article.unit_price).toLocaleString('de-DE', { minimumFractionDigits: 2 }) %> €</td>
                                        <td><%= article.description || '-' %></td>
                                        <td class="text-end">
                                            <!-- Löschen-Formular für den jeweiligen Artikel -->
                                            <form action="/articles/delete" method="POST" onsubmit="return confirm('Mist du diesen Artikel wirklich löschen?');" style="display:inline;">
                                                <input type="hidden" name="id" value="<%= article.id %>">
                                                <button type="submit" class="btn btn-sm btn-danger">Löschen</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Keine Artikel im Stamm vorhanden.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
