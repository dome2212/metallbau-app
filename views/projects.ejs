<%- include('partials/header') %>
<%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">
    <header class="bg-white dark:bg-slate-800 shadow px-4 md:px-6 py-4 flex justify-between items-center">
      <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100">🏗️ Aufträge & Baustellen</h1>
    </header>

    <div class="p-4 md:p-6 max-w-7xl mx-auto w-full space-y-6">
      
      <!-- Nur der Chef darf neue Aufträge anlegen -->
      <% if (typeof currentUser !== 'undefined' && currentUser.role === 'ADMIN') { %>
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 md:p-6">
          <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 mb-4">Neuen Auftrag anlegen</h2>
          <form action="/projects/add" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Kunde</label>
              <select name="customer_id" required class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded p-2 text-sm">
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.company_name || c.contact_person %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Bezeichnung / Baustelle</label>
              <input type="text" name="title" required placeholder="z.B. Stahlgeländer Balkon" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded p-2 text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Auftragssumme (€)</label>
              <% if (canSeeMoney) { %>
                <input type="text" name="total_price" placeholder="0.00" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded p-2 text-sm">
              <% } else { %>
                <input type="hidden" name="total_price" value="0">
                <div class="w-full border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-700 text-slate-400 rounded p-2 text-sm italic">Nur für Chef sichtbar</div>
              <% } %>
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Beschreibung / Details</label>
              <div class="flex gap-2">
                <input type="text" name="description" id="proj-desc-input" placeholder="Optionale Details zum Bauvorhaben..." class="flex-1 border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded p-2 text-sm">
                <button type="button" onclick="openKiDescModal()" title="KI-Assistent" class="shrink-0 bg-violet-600 hover:bg-violet-700 text-white px-3 py-2 rounded text-xs font-semibold transition whitespace-nowrap">✨ KI</button>
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Status</label>
              <select name="status" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded p-2 text-sm">
                <option value="In Planung">In Planung</option>
                <option value="Avor / Vorbereitung">Avor / Vorbereitung</option>
                <option value="In Produktion">In Produktion</option>
                <option value="Oberfläche">Oberfläche</option>
                <option value="Montagebereit">Montagebereit</option>
                <option value="Montage läuft">Montage läuft</option>
                <option value="Abgeschlossen">Abgeschlossen</option>
              </select>
            </div>
            <div class="md:col-span-3">
              <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded text-sm transition w-full md:w-auto">Auftrag speichern</button>
            </div>
          </form>
        </div>
      <% } %>

      <!-- ═══════════════════════════════════════════ -->
      <!-- FILTER & SUCHE                              -->
      <!-- ═══════════════════════════════════════════ -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-3 md:p-4 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
        <!-- Suchfeld -->
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input id="proj-search" type="text" placeholder="Titel oder Kunde suchen…"
            class="w-full pl-9 pr-3 py-2 border border-slate-200 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white">
        </div>
        <!-- Status-Filter -->
        <select id="proj-status-filter"
          class="border border-slate-200 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-400 sm:w-52">
          <option value="">Alle Status</option>
          <option value="In Planung">In Planung</option>
          <option value="Avor / Vorbereitung">Avor / Vorbereitung</option>
          <option value="In Produktion">In Produktion</option>
          <option value="Oberfläche">Oberfläche</option>
          <option value="Montagebereit">Montagebereit</option>
          <option value="Montage läuft">Montage läuft</option>
          <option value="Abgeschlossen">Abgeschlossen</option>
        </select>
        <!-- Zähler -->
        <span id="proj-count" class="text-xs text-slate-400 whitespace-nowrap self-center">
          <%= projects.length %> Aufträge
        </span>
      </div>

      <!-- ═══════════════════════════════════════════ -->
      <!-- AUFTRAGSLISTE                               -->
      <!-- ═══════════════════════════════════════════ -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow overflow-hidden p-4 md:p-6">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-600 dark:text-slate-300 min-w-[750px]">
            <thead class="bg-slate-50 dark:bg-slate-700 text-slate-700 dark:text-slate-300 uppercase text-xs">
              <tr>
                <th class="p-3">Baustelle / Titel</th>
                <th class="p-3">Kunde</th>
                <th class="p-3">Status</th>
                <th class="p-3">Summe</th>
                <th class="p-3 text-right">Aktion</th>
              </tr>
            </thead>
            <tbody id="proj-tbody" class="divide-y divide-slate-200 dark:divide-slate-700">
              <% projects.forEach(p => { %>
                <%
                  const statusColors = {
                    'In Planung':          'bg-slate-100 text-slate-700',
                    'Avor / Vorbereitung': 'bg-blue-100 text-blue-800',
                    'In Produktion':       'bg-amber-100 text-amber-800',
                    'Oberfläche':          'bg-purple-100 text-purple-800',
                    'Montagebereit':       'bg-emerald-100 text-emerald-800',
                    'Montage läuft':       'bg-orange-100 text-orange-800',
                    'Abgeschlossen':       'bg-green-100 text-green-800'
                  };
                  const sc = statusColors[p.status] || 'bg-gray-100 text-gray-700';
                %>
                <tr class="proj-row hover:bg-slate-50 dark:hover:bg-slate-700"
                    data-title="<%= (p.title || '').toLowerCase() %>"
                    data-customer="<%= ((p.company_name || p.contact_person) || '').toLowerCase() %>"
                    data-status="<%= p.status %>">

                  <td class="p-3 font-semibold text-slate-800 dark:text-gray-100">
                    <a href="/projects/<%= p.id %>" class="text-blue-600 hover:underline"><%= p.title %></a>
                  </td>

                  <td class="p-3"><%= p.company_name || p.contact_person %></td>

                  <!-- Status-Zelle -->
                  <td class="p-3">
                    <% if (currentUser.role === 'ADMIN') { %>
                      <!-- Schnellstatus: Dropdown → sofortiger fetch, kein Reload -->
                      <select
                        data-project-id="<%= p.id %>"
                        onchange="quickStatus(this)"
                        class="status-select border rounded-lg px-2 py-1 text-xs font-semibold cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-400 <%= sc %>">
                        <option value="In Planung"          <%= p.status === 'In Planung'          ? 'selected' : '' %>>In Planung</option>
                        <option value="Avor / Vorbereitung" <%= p.status === 'Avor / Vorbereitung' ? 'selected' : '' %>>Avor / Vorbereitung</option>
                        <option value="In Produktion"       <%= p.status === 'In Produktion'       ? 'selected' : '' %>>In Produktion</option>
                        <option value="Oberfläche"          <%= p.status === 'Oberfläche'          ? 'selected' : '' %>>Oberfläche</option>
                        <option value="Montagebereit"       <%= p.status === 'Montagebereit'       ? 'selected' : '' %>>Montagebereit</option>
                        <option value="Montage läuft"       <%= p.status === 'Montage läuft'       ? 'selected' : '' %>>Montage läuft</option>
                        <option value="Abgeschlossen"       <%= p.status === 'Abgeschlossen'       ? 'selected' : '' %>>Abgeschlossen</option>
                      </select>
                    <% } else { %>
                      <span class="px-2 py-1 rounded text-xs font-medium <%= sc %>"><%= p.status %></span>
                    <% } %>
                  </td>

                  <!-- Preis nur für Admin -->
                  <td class="p-3 font-medium">
                    <% if (currentUser.role === 'ADMIN') { %>
                      <%= (Number(p.total_price) || 0).toLocaleString('de-DE', {minimumFractionDigits: 2}) %> €
                    <% } else { %>
                      <span class="text-slate-400 italic">Intern</span>
                    <% } %>
                  </td>

                  <td class="p-3 text-right space-x-2">
                    <a href="/projects/<%= p.id %>" class="text-blue-600 hover:underline text-xs font-medium">Öffnen</a>
                    <% if (currentUser.role === 'ADMIN') { %>
                      <form action="/projects/delete" method="POST" class="inline"
                        onsubmit="return confirm('Auftrag wirklich löschen?');">
                        <input type="hidden" name="id" value="<%= p.id %>">
                        <button type="submit" class="text-red-600 hover:underline text-xs">Löschen</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <!-- Keine-Ergebnisse-Hinweis -->
          <p id="proj-empty" class="hidden text-sm text-slate-400 dark:text-slate-500 text-center py-8">Keine Aufträge gefunden.</p>
        </div>
      </div>

    </div>
  </main>

<!-- ================================================ -->
<!-- KI-BESCHREIBUNGSASSISTENT MODAL                   -->
<!-- ================================================ -->
<div id="kiDescModal" class="hidden fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl max-w-md w-full p-5 md:p-6 flex flex-col gap-4">
    <div class="flex justify-between items-center border-b dark:border-slate-700 pb-3">
      <h3 class="text-lg font-bold text-slate-800 dark:text-gray-100">✨ KI-Beschreibung generieren</h3>
      <button onclick="document.getElementById('kiDescModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold leading-none">&times;</button>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400">Gib Stichworte ein – die KI schreibt eine saubere Auftragsbeschreibung daraus.</p>
    <input type="text" id="kiDescKeywords" placeholder="z.B. Stahlgeländer, 3 Felder, verzinkt, RAL 7016" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-violet-500">
    <div id="kiDescError" class="hidden text-xs text-red-600 dark:text-red-400"></div>
    <div id="kiDescResult" class="hidden bg-violet-50 dark:bg-violet-900/20 border border-violet-200 dark:border-violet-800 rounded-lg p-3 text-sm text-slate-700 dark:text-slate-200 italic"></div>
    <div class="flex justify-end gap-2 pt-2 border-t dark:border-slate-700">
      <button type="button" onclick="document.getElementById('kiDescModal').classList.add('hidden')" class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Abbrechen</button>
      <button type="button" id="kiDescBtn" onclick="generateKiDesc()" class="px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition">✨ Generieren</button>
      <button type="button" id="kiDescAcceptBtn" onclick="acceptKiDesc()" class="hidden px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition">Übernehmen</button>
    </div>
  </div>
</div>

<script>
let _kiDescText = '';

function openKiDescModal() {
  document.getElementById('kiDescModal').classList.remove('hidden');
  document.getElementById('kiDescError').classList.add('hidden');
  document.getElementById('kiDescResult').classList.add('hidden');
  document.getElementById('kiDescAcceptBtn').classList.add('hidden');
  document.getElementById('kiDescKeywords').value = '';
  _kiDescText = '';
}

async function generateKiDesc() {
  const keywords = document.getElementById('kiDescKeywords').value.trim();
  if (!keywords) return;
  const btn      = document.getElementById('kiDescBtn');
  const errorEl  = document.getElementById('kiDescError');
  const resultEl = document.getElementById('kiDescResult');
  const acceptBtn= document.getElementById('kiDescAcceptBtn');

  btn.disabled = true; btn.textContent = '⏳';
  errorEl.classList.add('hidden');
  resultEl.classList.add('hidden');
  acceptBtn.classList.add('hidden');

  try {
    const res  = await fetch('/api/ai/project-description', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ keywords })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'Fehler');
    _kiDescText = data.description;
    resultEl.textContent = data.description;
    resultEl.classList.remove('hidden');
    acceptBtn.classList.remove('hidden');
  } catch (err) {
    errorEl.textContent = '❌ ' + err.message;
    errorEl.classList.remove('hidden');
  } finally {
    btn.disabled = false; btn.textContent = '✨ Generieren';
  }
}

function acceptKiDesc() {
  const input = document.getElementById('proj-desc-input');
  if (input && _kiDescText) input.value = _kiDescText;
  document.getElementById('kiDescModal').classList.add('hidden');
}
</script>

<script>
  // ── Status-Farben (müssen mit den EJS-Werten übereinstimmen) ────────────
  const STATUS_COLORS = {
    'In Planung':          'bg-slate-100 text-slate-700',
    'Avor / Vorbereitung': 'bg-blue-100 text-blue-800',
    'In Produktion':       'bg-amber-100 text-amber-800',
    'Oberfläche':          'bg-purple-100 text-purple-800',
    'Montagebereit':       'bg-emerald-100 text-emerald-800',
    'Montage läuft':       'bg-orange-100 text-orange-800',
    'Abgeschlossen':       'bg-green-100 text-green-800',
  };
  const ALL_STATUS_CLASSES = Object.values(STATUS_COLORS).join(' ').split(' ');

  // ── Schnellstatus per fetch ──────────────────────────────────────────────
  async function quickStatus(select) {
    const id     = select.dataset.projectId;
    const status = select.value;
    const row    = select.closest('tr');

    // Optimistisch: Farbe sofort wechseln
    ALL_STATUS_CLASSES.forEach(c => select.classList.remove(c));
    (STATUS_COLORS[status] || 'bg-gray-100 text-gray-700').split(' ').forEach(c => select.classList.add(c));

    // data-status für Filter aktuell halten
    row.dataset.status = status;

    select.disabled = true;
    try {
      const res = await fetch('/projects/update-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id, status })
      });
      if (!res.ok) throw new Error('Fehler');
    } catch (_) {
      // Bei Fehler: kurz rot aufblitzen
      select.classList.add('ring-2', 'ring-red-400');
      setTimeout(() => select.classList.remove('ring-2', 'ring-red-400'), 2000);
    } finally {
      select.disabled = false;
    }
  }

  // ── Filter & Suche ───────────────────────────────────────────────────────
  const searchInput  = document.getElementById('proj-search');
  const statusFilter = document.getElementById('proj-status-filter');
  const countLabel   = document.getElementById('proj-count');
  const emptyHint    = document.getElementById('proj-empty');

  function applyFilter() {
    const q      = searchInput.value.trim().toLowerCase();
    const status = statusFilter.value;
    const rows   = document.querySelectorAll('.proj-row');
    let visible  = 0;

    rows.forEach(row => {
      const matchText   = !q      || row.dataset.title.includes(q) || row.dataset.customer.includes(q);
      const matchStatus = !status || row.dataset.status === status;
      const show        = matchText && matchStatus;
      row.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    countLabel.textContent = visible + ' Aufträge';
    emptyHint.classList.toggle('hidden', visible > 0);
  }

  searchInput.addEventListener('input', applyFilter);
  statusFilter.addEventListener('change', applyFilter);
</script>

</body>
</html>

