<%- include('partials/header') %>
<%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 min-h-screen pt-16 md:pt-6">
    <header class="bg-white shadow px-4 md:px-6 py-4 flex justify-between items-center">
      <h1 class="text-xl md:text-2xl font-bold text-slate-800">🏗️ Aufträge & Baustellen</h1>
    </header>

    <div class="p-4 md:p-6 max-w-7xl mx-auto w-full space-y-6">
      
      <!-- Nur der Chef darf neue Aufträge anlegen -->
      <% if (typeof currentUser !== 'undefined' && currentUser.role === 'ADMIN') { %>
        <div class="bg-white rounded-lg shadow p-4 md:p-6">
          <h2 class="text-lg font-semibold text-slate-800 mb-4">Neuen Auftrag anlegen</h2>
          <form action="/projects/add" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Kunde</label>
              <select name="customer_id" required class="w-full border rounded p-2 text-sm">
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.company_name || c.contact_person %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Bezeichnung / Baustelle</label>
              <input type="text" name="title" required placeholder="z.B. Stahlgeländer Balkon" class="w-full border rounded p-2 text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Auftragssumme (€)</label>
              <input type="text" name="total_price" placeholder="0.00" class="w-full border rounded p-2 text-sm">
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-1">Beschreibung / Details</label>
              <input type="text" name="description" placeholder="Optionale Details zum Bauvorhaben..." class="w-full border rounded p-2 text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
              <select name="status" class="w-full border rounded p-2 text-sm">
                <option value="In Planung">In Planung</option>
                <option value="Avor / Vorbereitung">Avor / Vorbereitung</option>
                <option value="In Produktion">In Produktion</option>
                <option value="Oberfläche">Oberfläche</option>
                <option value="Montagebereit">Montagebereit</option>
                <option value="Montage läuft">Montage läuft</option>
                <option value="Abgeschlossen">Abgeschlossen</option>
              </select>
            </div>
            <div class="md:col-span-3">
              <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded text-sm transition w-full md:w-auto">Auftrag speichern</button>
            </div>
          </form>
        </div>
      <% } %>

      <!-- Liste der Aufträge mit Scroll-Container für Handys -->
      <div class="bg-white rounded-lg shadow overflow-hidden p-4 md:p-6">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">Aktuelle Aufträge</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-600 min-w-[750px]">
            <thead class="bg-slate-50 text-slate-700 uppercase text-xs">
              <tr>
                <th class="p-3">Baustelle / Titel</th>
                <th class="p-3">Kunde</th>
                <th class="p-3">Status ändern</th>
                <th class="p-3">Summe</th>
                <th class="p-3 text-right">Aktion</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% projects.forEach(p => { %>
                <tr class="hover:bg-slate-50">
                  <td class="p-3 font-semibold text-slate-800">
                    <a href="/projects/<%= p.id %>" class="text-blue-600 hover:underline"><%= p.title %></a>
                  </td>
                  <td class="p-3"><%= p.company_name || p.contact_person %></td>
                  
                  <!-- Status direkt in der Tabelle bearbeiten (für Admin) oder anzeigen -->
                  <td class="p-3">
                    <% if (currentUser.role === 'ADMIN') { %>
                      <form action="/projects/update-status" method="POST" class="flex items-center space-x-2">
                        <input type="hidden" name="id" value="<%= p.id %>">
                        <select name="status" class="border rounded p-1 text-xs bg-white">
                          <option value="In Planung" <%= p.status === 'In Planung' ? 'selected' : '' %>>In Planung</option>
                          <option value="Avor / Vorbereitung" <%= p.status === 'Avor / Vorbereitung' ? 'selected' : '' %>>Avor / Vorbereitung</option>
                          <option value="In Produktion" <%= p.status === 'In Produktion' ? 'selected' : '' %>>In Produktion</option>
                          <option value="Oberfläche" <%= p.status === 'Oberfläche' ? 'selected' : '' %>>Oberfläche</option>
                          <option value="Montagebereit" <%= p.status === 'Montagebereit' ? 'selected' : '' %>>Montagebereit</option>
                          <option value="Montage läuft" <%= p.status === 'Montage läuft' ? 'selected' : '' %>>Montage läuft</option>
                          <option value="Abgeschlossen" <%= p.status === 'Abgeschlossen' ? 'selected' : '' %>>Abgeschlossen</option>
                        </select>
                        <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white px-2 py-1 rounded text-xs">Ändern</button>
                      </form>
                    <% } else { %>
                      <span class="px-2 py-1 rounded text-xs font-medium 
                        <%= p.status === 'Abgeschlossen' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %>">
                        <%= p.status %>
                      </span>
                    <% } %>
                  </td>

                  <!-- Preis nur für Admin sichtbar, Mitarbeiter sieht "Intern" -->
                  <td class="p-3 font-medium">
                    <% if (currentUser.role === 'ADMIN') { %>
                      <%= p.total_price.toLocaleString('de-DE', {minimumFractionDigits: 2}) %> €
                    <% } else { %>
                      <span class="text-slate-400 italic">Intern</span>
                    <% } %>
                  </td>
                  <td class="p-3 text-right space-x-2">
                    <a href="/projects/<%= p.id %>" class="text-blue-600 hover:underline text-xs font-medium">Öffnen</a>
                    <% if (currentUser.role === 'ADMIN') { %>
                      <form action="/projects/delete" method="POST" class="inline" onsubmit="return confirm('Auftrag wirklich löschen?');">
                        <input type="hidden" name="id" value="<%= p.id %>">
                        <button type="submit" class="text-red-600 hover:underline text-xs">Löschen</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</body>
</html>

