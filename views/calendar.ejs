<%- include('partials/header') %>

<!-- FullCalendar Library & CSS -->
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>

<%- include('partials/sidebar') %>

<main class="flex-1 flex flex-col overflow-y-auto md:ml-72 page-bg min-h-screen pt-16 md:pt-6">
    <!-- Header mit beiden Buttons -->
    <div class="px-4 md:px-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">Terminkalender</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Aufmaß-, Montage- und Kundentermine verwalten</p>
        <!-- Wetter-Legende -->
        <div class="flex flex-wrap gap-3 mt-2 text-xs">
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block bg-blue-200 border border-blue-500"></span> Kein Wetterrisiko</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block bg-yellow-200 border border-yellow-500"></span> Wetterwarnung (Böen ≥ 40 km/h oder Regen)</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block bg-red-200 border border-red-600"></span> Gefahr (Sturm ≥ 55 km/h, Starkregen oder Gewitter)</span>
          <span class="flex items-center gap-1.5 text-gray-400">— Kein Vorhersagezeitraum (&gt;16 Tage)</span>
        </div>
      </div>
      <% if (currentUser && (currentUser.role === 'CHEF' || currentUser.role === 'ADMIN')) { %>
      <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
        <!-- Button: Termin Löschen -->
        <button onclick="toggleModal('deleteModal')" class="bg-red-600 hover:bg-red-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center justify-center gap-2 text-sm">
          <span>🗑️ Termin löschen</span>
        </button>
        <!-- Button: Neuen Termin eintragen -->
        <button onclick="toggleModal('appointmentModal')" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center justify-center gap-2 text-sm">
          <span>+ Neuen Termin eintragen</span>
        </button>
      </div>
      <% } %>
    </div>

    <!-- Kalender-Container -->
    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto pb-6">
      <div class="bg-white dark:bg-slate-800 p-4 md:p-6 rounded-xl shadow">
        <div id="calendar"></div>
      </div>
    </div>

    <!-- ===================================================== -->
    <!-- URLAUBSKALENDER – MONATSÜBERSICHT                      -->
    <!-- ===================================================== -->
    <% if (currentUser && (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF')) { %>
    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto pb-6">
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 p-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
          <h2 class="text-base md:text-lg font-bold text-gray-800 dark:text-gray-100">📅 Urlaubskalender – Monatsübersicht</h2>
          <!-- Monatsnavigation -->
          <div class="flex items-center gap-2">
            <a href="/calendar?cal_month=<%= calPrevMonth %>"
               class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 text-sm font-medium transition">
              ‹ Zurück
            </a>
            <span class="text-sm font-semibold text-slate-700 dark:text-slate-200 min-w-[120px] text-center">
              <%= calMonthLabel %>
            </span>
            <a href="/calendar?cal_month=<%= calNextMonth %>"
               class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 text-sm font-medium transition">
              Weiter ›
            </a>
          </div>
        </div>

        <!-- Legende -->
        <div class="flex flex-wrap gap-3 mb-4 text-xs">
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-emerald-400 inline-block"></span> Genehmigt</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-amber-300 inline-block"></span> Beantragt</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-blue-300 inline-block"></span> Krank</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-slate-200 dark:bg-slate-600 inline-block"></span> Wochenende / Feiertag</span>
        </div>

        <!-- Kalender-Grid -->
        <div class="overflow-x-auto">
          <table class="w-full text-xs border-collapse min-w-[600px]">
            <thead>
              <tr>
                <th class="text-left text-slate-500 dark:text-slate-400 font-semibold py-2 pr-3 w-28 whitespace-nowrap">Mitarbeiter</th>
                <% calDays.forEach(day => { %>
                  <th class="text-center py-2 px-0.5 font-medium <%= day.isWeekend || day.isHoliday ? 'text-slate-300 dark:text-slate-600' : 'text-slate-600 dark:text-slate-300' %>"
                      style="min-width:28px;">
                    <div class="<%= day.isToday ? 'bg-blue-600 text-white rounded-full w-5 h-5 flex items-center justify-center mx-auto' : '' %>">
                      <%= day.d %>
                    </div>
                    <div class="text-[9px] text-slate-400 dark:text-slate-500 mt-0.5"><%= day.weekday %></div>
                  </th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% calUsers.forEach((u, ui) => { %>
                <tr class="<%= ui % 2 === 0 ? 'bg-slate-50 dark:bg-slate-700/30' : '' %>">
                  <td class="py-1.5 pr-3 font-medium text-slate-700 dark:text-slate-200 truncate max-w-[110px]" title="<%= u.username %>">
                    <%= u.username %>
                  </td>
                  <% calDays.forEach(day => {
                    const cellKey = u.id + '_' + day.dateStr;
                    const cell    = calCells[cellKey];
                    let bg = '';
                    let title = '';
                    if (day.isWeekend || day.isHoliday) {
                      bg = 'bg-slate-100 dark:bg-slate-700';
                    } else if (cell) {
                      if (cell.status === 'Genehmigt' && cell.type === 'Urlaub')   bg = 'bg-emerald-400';
                      else if (cell.status === 'Genehmigt' && cell.type === 'Krank') bg = 'bg-blue-300';
                      else if (cell.status === 'Beantragt')  bg = 'bg-amber-300';
                      else if (cell.status === 'Abgelehnt')  bg = 'bg-red-200';
                      title = cell.type + ' – ' + cell.status;
                    }
                  %>
                    <td class="py-1.5 px-0.5 text-center">
                      <div class="<%= bg %> rounded-sm h-5 w-full mx-auto" title="<%= title %>"></div>
                    </td>
                  <% }); %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Wer fehlt heute? -->
        <% if (todayAbsent.length > 0) { %>
          <div class="mt-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-lg px-4 py-2.5 text-xs text-amber-800 dark:text-amber-300">
            <strong>⚠️ Heute abwesend:</strong>
            <%= todayAbsent.map(u => u.username + ' (' + u.type + ')').join(' · ') %>
          </div>
        <% } else { %>
          <div class="mt-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-lg px-4 py-2.5 text-xs text-green-800 dark:text-green-300">
            ✅ Heute ist kein Mitarbeiter abwesend.
          </div>
        <% } %>
      </div>
    </div>
    <% } %>
</main>

<!-- Modal 1: Termin anlegen -->
<div id="appointmentModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-md w-full p-4 md:p-6 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 border-b dark:border-slate-700 pb-2">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">Neuen Termin eintragen</h3>
      <button onclick="toggleModal('appointmentModal')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl font-bold">&times;</button>
    </div>

    <form action="/api/appointments/add" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Titel / Art des Termins *</label>
        <input type="text" name="title" required placeholder="z. B. Aufmaß Geländer / Montage" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Kunde zuordnen</label>
        <select name="customer_id" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
          <option value="">-- Keinem Kunden zuordnen --</option>
          <% customers.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.company_name ? c.company_name + (c.contact_person ? ' (' + c.contact_person + ')' : '') : c.contact_person %></option>
          <% }); %>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <div>
          <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Startzeit *</label>
          <input type="datetime-local" name="start_date" required class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-white">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Endzeit (optional)</label>
          <input type="datetime-local" name="end_date" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-white">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Notizen / Beschreibung</label>
        <textarea name="description" rows="2" placeholder="z. B. Werkzeug für V2A Geländer mitbringen" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-white"></textarea>
      </div>

      <!-- Mitarbeiter-Zuweisung (nur für Admin sichtbar) -->
      <% if (locals.currentUser && currentUser.role === 'ADMIN' && users && users.length > 0) { %>
      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">
          Mitarbeiter zuweisen
          <span class="font-normal text-gray-400 normal-case ml-1">(leer = für alle sichtbar)</span>
        </label>
        <div class="border dark:border-slate-600 rounded-lg p-2 space-y-1.5 max-h-36 overflow-y-auto bg-gray-50 dark:bg-slate-700">
          <% users.forEach(u => { %>
            <label class="flex items-center gap-2 cursor-pointer hover:bg-white dark:hover:bg-slate-600 px-2 py-1 rounded text-sm">
              <input type="checkbox" name="user_ids" value="<%= u.id %>"
                class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              <span class="text-gray-800 dark:text-gray-200"><%= u.username %></span>
            </label>
          <% }); %>
        </div>
        <p class="text-xs text-gray-400 mt-1">Kein Haken = Termin für alle sichtbar</p>
      </div>
      <% } %>

      <div class="flex justify-end gap-2 pt-3 border-t dark:border-slate-700">
        <button type="button" onclick="toggleModal('appointmentModal')" class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Termin Speichern</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal 2: Termine verwalten / löschen -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-lg w-full p-4 md:p-6 max-h-[90vh] flex flex-col">
    <div class="flex justify-between items-center mb-4 border-b dark:border-slate-700 pb-2 flex-shrink-0">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">Termine löschen</h3>
      <button onclick="toggleModal('deleteModal')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl font-bold">&times;</button>
    </div>

    <!-- Dynamischer Container für die Termine -->
    <div id="appointmentsList" class="max-h-80 overflow-y-auto divide-y divide-gray-100 dark:divide-slate-700 flex-1">
      <p class="text-center text-gray-400 py-6 text-sm">Lade Termine...</p>
    </div>

    <div class="flex justify-end pt-4 border-t mt-4 flex-shrink-0">
      <button type="button" onclick="toggleModal('deleteModal')" class="px-4 py-2 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-200 text-sm font-medium rounded-lg">Schließen</button>
    </div>
  </div>
</div>

<!-- Termin-Detail-Modal -->
<div id="detailModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-sm w-full p-5">
    <div class="flex justify-between items-center mb-3 border-b dark:border-slate-700 pb-2">
      <h3 id="detailTitle" class="text-base font-bold text-gray-800 dark:text-gray-100 truncate pr-4"></h3>
      <button onclick="document.getElementById('detailModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-xl font-bold flex-shrink-0">&times;</button>
    </div>
    <div id="detailBody" class="text-sm space-y-2 text-gray-700 dark:text-gray-300"></div>
    <div class="mt-4 flex justify-end">
      <button onclick="document.getElementById('detailModal').classList.add('hidden')" class="px-4 py-2 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-200 text-sm rounded-lg">Schließen</button>
    </div>
  </div>
</div>

<script>
  function toggleModal(id) {
    const modal = document.getElementById(id);
    modal.classList.toggle('hidden');
    if (id === 'deleteModal' && !modal.classList.contains('hidden')) {
      loadDeleteList();
    }
  }

  // Termine live abrufen und im Lösch-Fenster anzeigen
  function loadDeleteList() {
    const container = document.getElementById('appointmentsList');
    container.innerHTML = '<p class="text-center text-gray-400 py-6 text-sm">Lade Termine...</p>';

    fetch('/api/appointments')
      .then(res => res.json())
      .then(events => {
        if (!events || events.length === 0) {
          container.innerHTML = '<p class="text-center text-gray-400 py-6 text-sm">Keine Termine vorhanden.</p>';
          return;
        }
        let html = '';
        events.forEach(event => {
          const startDate = new Date(event.start).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' });
          const wBadge    = weatherBadge(event.extendedProps && event.extendedProps.weather);
          const assigned  = event.extendedProps && event.extendedProps.assignedUsers;
          const assignBadge = assigned && assigned.length > 0
            ? `<span class="text-xs text-blue-600 dark:text-blue-400 ml-1">👷 ${assigned.join(', ')}</span>`
            : `<span class="text-xs text-gray-400 ml-1">Alle</span>`;

          html += `
            <div class="py-3 flex justify-between items-center gap-2">
              <div class="overflow-hidden pr-2 flex-1 min-w-0">
                <div class="font-semibold text-gray-800 dark:text-gray-200 text-sm truncate">${escHtml(event.title)}</div>
                <div class="text-xs text-gray-400 truncate">${escHtml(event.extendedProps.customerName || '')}</div>
                <div class="flex flex-wrap items-center gap-1 mt-0.5">
                  <span class="text-xs text-gray-500 dark:text-gray-400">📅 ${startDate}</span>
                  ${wBadge}
                  ${assignBadge}
                </div>
              </div>
              <form action="/api/appointments/delete/${event.id}" method="POST" onsubmit="return confirm('Termin wirklich löschen?');" class="flex-shrink-0">
                <button type="submit" class="bg-red-100 hover:bg-red-200 text-red-700 text-xs px-3 py-1.5 rounded font-medium transition">
                  Löschen
                </button>
              </form>
            </div>
          `;
        });
        container.innerHTML = html;
      })
      .catch(() => {
        container.innerHTML = '<p class="text-center text-red-500 py-6 text-sm">Fehler beim Laden der Termine.</p>';
      });
  }

  function escHtml(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');
    var calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      locale: 'de',
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,listWeek'
      },
      buttonText: { today: 'Heute', month: 'Monat', week: 'Woche', list: 'Liste' },
      eventSources: [
        { url: '/api/appointments' },
        { url: '/api/holidays', color: '#fde68a', textColor: '#92400e' }
      ],

      // Titel im Kalender: Wetter-Icon + Titel
      eventDidMount: function(info) {
        if (info.event.display === 'background') {
          info.el.title = info.event.title; // Tooltip beim Hover: Name des Feiertags
          return;
        }
        const w = info.event.extendedProps.weather;
        const icon = !w ? '' : w.warningLevel === 'danger' ? '🔴 ' : w.warningLevel === 'warn' ? '🟡 ' : '🟢 ';
        const assigned = info.event.extendedProps.assignedUsers || [];
        const customer = info.event.extendedProps.customerName || '';

        // Titel-Zeile neu setzen: Icon + Termin-Titel
        const titleEl = info.el.querySelector('.fc-event-title');
        if (titleEl) {
          titleEl.textContent = icon + info.event.title;
        }

        // Untertitel-Zeile (kleiner, gedämpft): Kunde + Mitarbeiter
        const sub = [customer, assigned.length > 0 ? '👷 ' + assigned.join(', ') : ''].filter(Boolean).join(' · ');
        if (sub) {
          const subEl = document.createElement('div');
          subEl.style.cssText = 'font-size:0.68rem;opacity:0.75;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
          subEl.textContent = sub;
          const frame = info.el.querySelector('.fc-event-main') || info.el;
          frame.appendChild(subEl);
        }
      },

      // Klick: Detail-Modal statt alert()
      eventClick: function(info) {
        const ep       = info.event.extendedProps;
        const w        = ep.weather;
        const assigned = ep.assignedUsers || [];
        const start    = new Date(info.event.start).toLocaleString('de-DE', { dateStyle: 'full', timeStyle: 'short' });

        let weatherHtml = '';
        if (w) {
          const icon  = w.warningLevel === 'danger' ? '🔴 GEFAHR' : w.warningLevel === 'warn' ? '🟡 WARNUNG' : '🟢 OK';
          const warn  = w.warningLevel === 'danger' ? '<p class="text-red-600 font-semibold text-xs mt-1">⚠️ Kranarbeiten / Montage prüfen!</p>'
                      : w.warningLevel === 'warn'   ? '<p class="text-yellow-600 font-semibold text-xs mt-1">⚠️ Wetterbeobachtung empfohlen.</p>' : '';
          weatherHtml = `
            <div class="bg-gray-50 dark:bg-slate-700 rounded p-2 text-xs space-y-0.5 mt-1">
              <div class="font-semibold">${icon} – ${escHtml(w.weatherText)}</div>
              <div>Wind: ${w.windspeed} km/h · Böen: ${w.windgusts} km/h · Niederschlag: ${w.precipitation} mm</div>
              ${warn}
            </div>`;
        } else {
          weatherHtml = '<p class="text-xs text-gray-400 mt-1">(Wettervorhersage nicht verfügbar – Termin &gt; 16 Tage)</p>';
        }

        const assignHtml = assigned.length > 0
          ? `<p>👷 <span class="font-medium">${escHtml(assigned.join(', '))}</span></p>`
          : `<p class="text-gray-400">Alle Mitarbeiter</p>`;

        document.getElementById('detailTitle').textContent = info.event.title;
        document.getElementById('detailBody').innerHTML = `
          <p>📅 ${escHtml(start)}</p>
          <p>🏢 ${escHtml(ep.customerName || '–')}</p>
          <p>📝 ${escHtml(ep.description || 'Keine Notizen')}</p>
          ${assignHtml}
          ${weatherHtml}
        `;
        document.getElementById('detailModal').classList.remove('hidden');
      }
    });
    calendar.render();
  });

  function weatherBadge(w) {
    if (!w) return '<span class="text-xs text-gray-400 ml-1">–</span>';
    if (w.warningLevel === 'danger')
      return `<span class="text-xs font-semibold text-red-700 bg-red-100 rounded px-1.5 py-0.5">🔴 Sturm/Gewitter</span>`;
    if (w.warningLevel === 'warn')
      return `<span class="text-xs font-semibold text-yellow-700 bg-yellow-100 rounded px-1.5 py-0.5">🟡 Wetterwarnung</span>`;
    return `<span class="text-xs font-semibold text-green-700 bg-green-100 rounded px-1.5 py-0.5">🟢 OK</span>`;
  }
</script>

<!-- CSS-Anpassung für FullCalendar-Buttons auf mobilen Geräten -->
<style>
  /* FullCalendar Dark Mode */
  .dark .fc { color: #e5e7eb; }
  .dark .fc-theme-standard td, .dark .fc-theme-standard th { border-color: #374151; }
  .dark .fc-theme-standard .fc-scrollgrid { border-color: #374151; }
  .dark .fc .fc-col-header-cell-cushion { color: #9ca3af; }
  .dark .fc .fc-daygrid-day-number { color: #9ca3af; }
  .dark .fc .fc-button { background-color: #374151; border-color: #4b5563; color: #e5e7eb; }
  .dark .fc .fc-button:hover { background-color: #4b5563; }
  .dark .fc .fc-button-primary:not(:disabled).fc-button-active { background-color: #2563eb; border-color: #1d4ed8; }
  .dark .fc .fc-daygrid-day.fc-day-today { background-color: rgba(37,99,235,0.15); }
  .dark .fc .fc-toolbar-title { color: #e5e7eb; }
  .dark .fc-daygrid-day-frame { background: transparent; }
  @media (max-width: 768px) {
    .fc .fc-toolbar {
      flex-direction: column;
      gap: 0.75rem;
    }
    .fc .fc-toolbar-chunk {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      width: 100%;
    }
    /* Buttons in der rechten Toolbar-Sektion (Monat, Woche, Liste) untereinander/umbruchsicher anordnen */
    .fc .fc-toolbar-chunk:nth-child(3) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.25rem;
      width: 100%;
    }
    .fc .fc-toolbar-chunk:nth-child(3) button {
      width: 100%;
