<%- include('partials/header') %>

<!-- FullCalendar Library & CSS -->
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>

<div class="flex h-screen bg-gray-100 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-gray-100 min-h-screen pt-16 md:pt-6">
    <!-- Header mit beiden Buttons -->
    <div class="px-4 md:px-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-gray-800">Terminkalender</h1>
        <p class="text-sm text-gray-500">Aufmaß-, Montage- und Kundentermine verwalten</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
        <!-- Button: Termin Löschen -->
        <button onclick="toggleModal('deleteModal')" class="bg-red-600 hover:bg-red-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center justify-center gap-2 text-sm">
          <span>🗑️ Termin löschen</span>
        </button>
        <!-- Button: Neuen Termin eintragen -->
        <button onclick="toggleModal('appointmentModal')" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center justify-center gap-2 text-sm">
          <span>+ Neuen Termin eintragen</span>
        </button>
      </div>
    </div>

    <!-- Kalender-Container -->
    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto pb-6">
      <div class="bg-white p-4 md:p-6 rounded-xl shadow">
        <div id="calendar"></div>
      </div>
    </div>
  </main>
</div>

<!-- Modal 1: Termin anlegen -->
<div id="appointmentModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-xl shadow-lg max-w-md w-full p-4 md:p-6 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 border-b pb-2">
      <h3 class="text-lg font-bold text-gray-800">Neuen Termin eintragen</h3>
      <button onclick="toggleModal('appointmentModal')" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
    </div>

    <form action="/api/appointments/add" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Titel / Art des Termins *</label>
        <input type="text" name="title" required placeholder="z. B. Aufmaß Geländer / Montage" class="w-full border rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Kunde zuordnen</label>
        <select name="customer_id" class="w-full border rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
          <option value="">-- Keinem Kunden zuordnen --</option>
          <% if (typeof customers !== 'undefined') { %>
            <% customers.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.company_name ? c.company_name + ' (' + c.contact_person + ')' : c.contact_person %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Startzeit *</label>
          <input type="datetime-local" name="start_date" required class="w-full border rounded-lg p-2 text-sm bg-white">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Endzeit (optional)</label>
          <input type="datetime-local" name="end_date" class="w-full border rounded-lg p-2 text-sm bg-white">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Notizen / Beschreibung</label>
        <textarea name="description" rows="2" placeholder="z. B. Werkzeug für V2A Geländer mitbringen" class="w-full border rounded-lg p-2 text-sm bg-white"></textarea>
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" onclick="toggleModal('appointmentModal')" class="px-4 py-2 border rounded-lg text-sm text-gray-600 hover:bg-gray-50">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Termin Speichern</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal 2: Termine verwalten / löschen -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-xl shadow-lg max-w-lg w-full p-4 md:p-6 max-h-[90vh] flex flex-col">
    <div class="flex justify-between items-center mb-4 border-b pb-2 flex-shrink-0">
      <h3 class="text-lg font-bold text-gray-800">Termine löschen</h3>
      <button onclick="toggleModal('deleteModal')" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
    </div>

    <!-- Dynamischer Container für die Termine -->
    <div id="appointmentsList" class="max-h-80 overflow-y-auto divide-y divide-gray-100 flex-1">
      <p class="text-center text-gray-400 py-6 text-sm">Lade Termine...</p>
    </div>

    <div class="flex justify-end pt-4 border-t mt-4 flex-shrink-0">
      <button type="button" onclick="toggleModal('deleteModal')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg">Schließen</button>
    </div>
  </div>
</div>

<script>
  function toggleModal(id) {
    const modal = document.getElementById(id);
    modal.classList.toggle('hidden');
    
    // Wenn das Lösch-Modal geöffnet wird, Termine frisch vom Server abfragen
    if (id === 'deleteModal' && !modal.classList.contains('hidden')) {
      loadDeleteList();
    }
  }

  // Termine live abrufen und im Lösch-Fenster anzeigen
  function loadDeleteList() {
    const container = document.getElementById('appointmentsList');
    container.innerHTML = '<p class="text-center text-gray-400 py-6 text-sm">Lade Termine...</p>';

    fetch('/api/appointments')
      .then(res => res.json())
      .then(events => {
        if (!events || events.length === 0) {
          container.innerHTML = '<p class="text-center text-gray-400 py-6 text-sm">Keine Termine vorhanden.</p>';
          return;
        }

        let html = '';
        events.forEach(event => {
          const startDate = new Date(event.start).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' });
          
          html += `
            <div class="py-3 flex justify-between items-center gap-2">
              <div class="overflow-hidden pr-2">
                <div class="font-semibold text-gray-800 text-sm truncate">${event.title}</div>
                <div class="text-xs text-gray-500">📅 ${startDate}</div>
              </div>
              <form action="/api/appointments/delete/${event.id}" method="POST" onsubmit="return confirm('Termin wirklich löschen?');" class="flex-shrink-0">
                <button type="submit" class="bg-red-100 hover:bg-red-200 text-red-700 text-xs px-3 py-1.5 rounded font-medium transition">
                  Löschen
                </button>
              </form>
            </div>
          `;
        });
        container.innerHTML = html;
      })
      .catch(err => {
        container.innerHTML = '<p class="text-center text-red-500 py-6 text-sm">Fehler beim Laden der Termine.</p>';
      });
  }

  document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');
    var calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      locale: 'de',
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,listWeek'
      },
      buttonText: {
        today: 'Heute',
        month: 'Monat',
        week: 'Woche',
        list: 'Liste'
      },
      events: '/api/appointments',
      eventClick: function(info) {
        alert('Termin: ' + info.event.title + '\nDetails: ' + (info.event.extendedProps.description || 'Keine Notizen'));
      }
    });
    calendar.render();
  });
</script>

<!-- CSS-Anpassung für FullCalendar-Buttons auf mobilen Geräten -->
<style>
  @media (max-width: 768px) {
    .fc .fc-toolbar {
      flex-direction: column;
      gap: 0.75rem;
    }
    .fc .fc-toolbar-chunk {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      width: 100%;
    }
    /* Buttons in der rechten Toolbar-Sektion (Monat, Woche, Liste) untereinander/umbruchsicher anordnen */
    .fc .fc-toolbar-chunk:nth-child(3) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.25rem;
      width: 100%;
    }
    .fc .fc-toolbar-chunk:nth-child(3) button {
      width: 100%;
      text-align: center;
      padding: 0.4rem 0.2rem;
      font-size: 0.75rem;
    }
  }
</style>

</body>
</html>
