<%- include('partials/header') %>

<!-- FullCalendar Library & CSS -->
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>

<div class="flex h-screen bg-gray-100 dark:bg-gray-900 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-gray-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">
    <!-- Header mit beiden Buttons -->
    <div class="px-4 md:px-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">Terminkalender</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Aufmaß-, Montage- und Kundentermine verwalten</p>
        <!-- Wetter-Legende -->
        <div class="flex flex-wrap gap-3 mt-2 text-xs">
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block bg-blue-200 border border-blue-500"></span> Kein Wetterrisiko</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block bg-yellow-200 border border-yellow-500"></span> Wetterwarnung (Böen ≥ 40 km/h oder Regen)</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block bg-red-200 border border-red-600"></span> Gefahr (Sturm ≥ 55 km/h, Starkregen oder Gewitter)</span>
          <span class="flex items-center gap-1.5 text-gray-400">— Kein Vorhersagezeitraum (&gt;16 Tage)</span>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
        <!-- Button: Termin Löschen -->
        <button onclick="toggleModal('deleteModal')" class="bg-red-600 hover:bg-red-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center justify-center gap-2 text-sm">
          <span>🗑️ Termin löschen</span>
        </button>
        <!-- Button: Neuen Termin eintragen -->
        <button onclick="toggleModal('appointmentModal')" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center justify-center gap-2 text-sm">
          <span>+ Neuen Termin eintragen</span>
        </button>
      </div>
    </div>

    <!-- Kalender-Container -->
    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto pb-6">
      <div class="bg-white dark:bg-slate-800 p-4 md:p-6 rounded-xl shadow">
        <div id="calendar"></div>
      </div>
    </div>
  </main>
</div>

<!-- Modal 1: Termin anlegen -->
<div id="appointmentModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-md w-full p-4 md:p-6 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 border-b dark:border-slate-700 pb-2">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">Neuen Termin eintragen</h3>
      <button onclick="toggleModal('appointmentModal')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl font-bold">&times;</button>
    </div>

    <form action="/api/appointments/add" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Titel / Art des Termins *</label>
        <input type="text" name="title" required placeholder="z. B. Aufmaß Geländer / Montage" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Kunde zuordnen</label>
        <select name="customer_id" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
          <option value="">-- Keinem Kunden zuordnen --</option>
          <% if (typeof customers !== 'undefined') { %>
            <% customers.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.company_name ? c.company_name + ' (' + c.contact_person + ')' : c.contact_person %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <div>
          <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Startzeit *</label>
          <input type="datetime-local" name="start_date" required class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-white">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Endzeit (optional)</label>
          <input type="datetime-local" name="end_date" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-white">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Notizen / Beschreibung</label>
        <textarea name="description" rows="2" placeholder="z. B. Werkzeug für V2A Geländer mitbringen" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-white"></textarea>
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" onclick="toggleModal('appointmentModal')" class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Termin Speichern</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal 2: Termine verwalten / löschen -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-lg w-full p-4 md:p-6 max-h-[90vh] flex flex-col">
    <div class="flex justify-between items-center mb-4 border-b dark:border-slate-700 pb-2 flex-shrink-0">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">Termine löschen</h3>
      <button onclick="toggleModal('deleteModal')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl font-bold">&times;</button>
    </div>

    <!-- Dynamischer Container für die Termine -->
    <div id="appointmentsList" class="max-h-80 overflow-y-auto divide-y divide-gray-100 dark:divide-slate-700 flex-1">
      <p class="text-center text-gray-400 py-6 text-sm">Lade Termine...</p>
    </div>

    <div class="flex justify-end pt-4 border-t mt-4 flex-shrink-0">
      <button type="button" onclick="toggleModal('deleteModal')" class="px-4 py-2 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-200 text-sm font-medium rounded-lg">Schließen</button>
    </div>
  </div>
</div>

<script>
  function toggleModal(id) {
    const modal = document.getElementById(id);
    modal.classList.toggle('hidden');
    
    // Wenn das Lösch-Modal geöffnet wird, Termine frisch vom Server abfragen
    if (id === 'deleteModal' && !modal.classList.contains('hidden')) {
      loadDeleteList();
    }
  }

  // Termine live abrufen und im Lösch-Fenster anzeigen
  function loadDeleteList() {
    const container = document.getElementById('appointmentsList');
    container.innerHTML = '<p class="text-center text-gray-400 py-6 text-sm">Lade Termine...</p>';

    fetch('/api/appointments')
      .then(res => res.json())
      .then(events => {
        if (!events || events.length === 0) {
          container.innerHTML = '<p class="text-center text-gray-400 py-6 text-sm">Keine Termine vorhanden.</p>';
          return;
        }

        let html = '';
        events.forEach(event => {
          const startDate = new Date(event.start).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' });
          const wBadge = weatherBadge(event.extendedProps && event.extendedProps.weather);

          html += `
            <div class="py-3 flex justify-between items-center gap-2">
              <div class="overflow-hidden pr-2 flex-1">
                <div class="font-semibold text-gray-800 dark:text-gray-200 text-sm truncate">${event.title}</div>
                <div class="flex items-center gap-2 mt-0.5">
                  <span class="text-xs text-gray-500 dark:text-gray-400">📅 ${startDate}</span>
                  ${wBadge}
                </div>
              </div>
              <form action="/api/appointments/delete/${event.id}" method="POST" onsubmit="return confirm('Termin wirklich löschen?');" class="flex-shrink-0">
                <button type="submit" class="bg-red-100 hover:bg-red-200 text-red-700 text-xs px-3 py-1.5 rounded font-medium transition">
                  Löschen
                </button>
              </form>
            </div>
          `;
        });
        container.innerHTML = html;
      })
      .catch(err => {
        container.innerHTML = '<p class="text-center text-red-500 py-6 text-sm">Fehler beim Laden der Termine.</p>';
      });
  }

  document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');
    var calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      locale: 'de',
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,listWeek'
      },
      buttonText: {
        today: 'Heute',
        month: 'Monat',
        week: 'Woche',
        list: 'Liste'
      },
      events: '/api/appointments',
      eventDidMount: function(info) {
        // Wetter-Icon dem Ereignistitel voranstellen
        const w = info.event.extendedProps.weather;
        if (!w) return;
        const icon = w.warningLevel === 'danger' ? '🔴' : w.warningLevel === 'warn' ? '🟡' : '🟢';
        const titleEl = info.el.querySelector('.fc-event-title');
        if (titleEl) titleEl.textContent = icon + ' ' + titleEl.textContent;
      },
      eventClick: function(info) {
        const w = info.event.extendedProps.weather;
        let weatherInfo = '';
        if (w) {
          const icon = w.warningLevel === 'danger' ? '🔴 GEFAHR' : w.warningLevel === 'warn' ? '🟡 WARNUNG' : '🟢 OK';
          weatherInfo = '\n\n──── Wetter-Frühwarnung ────' +
            '\nStatus: ' + icon +
            '\nWetter: ' + w.weatherText +
            '\nWindgeschw.: ' + w.windspeed + ' km/h' +
            '\nWindböen: ' + w.windgusts + ' km/h' +
            '\nNiederschlag: ' + w.precipitation + ' mm';
          if (w.warningLevel === 'danger') weatherInfo += '\n⚠️ Kranarbeiten/Montage prüfen!';
          else if (w.warningLevel === 'warn') weatherInfo += '\n⚠️ Wetterbeobachtung empfohlen.';
        } else {
          weatherInfo = '\n\n(Wettervorhersage nicht verfügbar – Termin > 16 Tage)';
        }
        alert('Termin: ' + info.event.title +
          '\nDatum: ' + new Date(info.event.start).toLocaleString('de-DE', { dateStyle: 'full', timeStyle: 'short' }) +
          '\nNotizen: ' + (info.event.extendedProps.description || 'Keine') +
          weatherInfo);
      }
    });
    calendar.render();
  });

  // Delete-Modal: Wetter-Badge in der Terminliste anzeigen
  function weatherBadge(w) {
    if (!w) return '<span class="text-xs text-gray-400 ml-1">–</span>';
    if (w.warningLevel === 'danger')
      return `<span class="text-xs font-semibold text-red-700 bg-red-100 rounded px-1.5 py-0.5 ml-1">🔴 Sturm/Gewitter</span>`;
    if (w.warningLevel === 'warn')
      return `<span class="text-xs font-semibold text-yellow-700 bg-yellow-100 rounded px-1.5 py-0.5 ml-1">🟡 Wetterwarnung</span>`;
    return `<span class="text-xs font-semibold text-green-700 bg-green-100 rounded px-1.5 py-0.5 ml-1">🟢 OK</span>`;
  }
</script>

<!-- CSS-Anpassung für FullCalendar-Buttons auf mobilen Geräten -->
<style>
  /* FullCalendar Dark Mode */
  .dark .fc { color: #e5e7eb; }
  .dark .fc-theme-standard td, .dark .fc-theme-standard th { border-color: #374151; }
  .dark .fc-theme-standard .fc-scrollgrid { border-color: #374151; }
  .dark .fc .fc-col-header-cell-cushion { color: #9ca3af; }
  .dark .fc .fc-daygrid-day-number { color: #9ca3af; }
  .dark .fc .fc-button { background-color: #374151; border-color: #4b5563; color: #e5e7eb; }
  .dark .fc .fc-button:hover { background-color: #4b5563; }
  .dark .fc .fc-button-primary:not(:disabled).fc-button-active { background-color: #2563eb; border-color: #1d4ed8; }
  .dark .fc .fc-daygrid-day.fc-day-today { background-color: rgba(37,99,235,0.15); }
  .dark .fc .fc-toolbar-title { color: #e5e7eb; }
  .dark .fc-daygrid-day-frame { background: transparent; }
  @media (max-width: 768px) {
    .fc .fc-toolbar {
      flex-direction: column;
      gap: 0.75rem;
    }
    .fc .fc-toolbar-chunk {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      width: 100%;
    }
    /* Buttons in der rechten Toolbar-Sektion (Monat, Woche, Liste) untereinander/umbruchsicher anordnen */
    .fc .fc-toolbar-chunk:nth-child(3) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.25rem;
      width: 100%;
    }
    .fc .fc-toolbar-chunk:nth-child(3) button {
      width: 100%;
      text-align: center;
      padding: 0.4rem 0.2rem;
      font-size: 0.75rem;
    }
  }
</style>

</body>
</html>
