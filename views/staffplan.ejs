<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 md:ml-72 min-h-screen page-bg dark:bg-slate-900 pt-14 md:pt-0">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6 space-y-5">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">📅 Personalplanung</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Wer arbeitet wann auf welcher Baustelle?</p>
      </div>
      <!-- Wochennavigation -->
      <div class="flex items-center gap-2">
        <a href="/admin/staffplan?week=<%= prevMondayStr %>"
          class="btn btn-ghost px-3 py-2 text-sm">‹ Vorwoche</a>
        <span class="text-sm font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 min-w-[200px] text-center">
          <%= weekLabel %>
        </span>
        <a href="/admin/staffplan?week=<%= nextMondayStr %>"
          class="btn btn-ghost px-3 py-2 text-sm">Nächste ›</a>
        <a href="/admin/staffplan"
          class="btn btn-ghost px-3 py-2 text-sm text-blue-600 dark:text-blue-400">Heute</a>
      </div>
    </div>

    <!-- Legende -->
    <div class="flex flex-wrap gap-2 items-center text-xs text-slate-500 dark:text-slate-400">
      <span class="font-semibold">Legende:</span>
      <span class="px-2 py-0.5 rounded-md bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 font-medium">Baustelle zugewiesen</span>
      <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-700 text-slate-500 font-medium">Werkstatt / Frei</span>
      <span class="px-2 py-0.5 rounded-md bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 font-medium">Nur Notiz</span>
      <span class="ml-auto text-[10px] italic">Klick auf Zelle zum Bearbeiten</span>
    </div>

    <!-- Wochenplan-Tabelle -->
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[700px]">
          <thead>
            <tr class="border-b border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60">
              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider w-36">Mitarbeiter</th>
              <%
                const dayNames = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
                const today = new Date().toISOString().slice(0, 10);
              %>
              <% days.forEach((d, i) => {
                const isToday = d === today;
                const dateObj = new Date(d + 'T12:00:00');
                const dayLabel = dateObj.toLocaleDateString('de-DE', { weekday:'short', day:'numeric', month:'numeric' });
              %>
              <th class="px-3 py-3 text-center text-xs font-semibold uppercase tracking-wider <%= isToday ? 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20' : 'text-slate-500 dark:text-slate-400' %>">
                <%= dayLabel %><% if (isToday) { %> <span class="inline-block w-1.5 h-1.5 rounded-full bg-blue-500 ml-0.5 align-middle"></span><% } %>
              </th>
              <% }) %>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
            <% users.forEach(u => { %>
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
              <!-- Mitarbeiter-Spalte -->
              <td class="px-4 py-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white shrink-0"
                       style="background:var(--primary)">
                    <%= u.username.charAt(0).toUpperCase() %>
                  </div>
                  <div class="min-w-0">
                    <p class="font-semibold text-slate-800 dark:text-slate-100 text-xs truncate"><%= u.username %></p>
                    <p class="text-[10px] text-slate-400"><%= u.role === 'CHEF' ? '👑 Chef' : u.role === 'ADMIN' ? '🛠️ Admin' : '👷 MA' %></p>
                  </div>
                </div>
              </td>

              <!-- Tages-Zellen -->
              <% days.forEach((d, di) => {
                const a = assignMap[u.id] && assignMap[u.id][d];
                const projTitle = a && a.project_id
                  ? (projects.find(p => p.id == a.project_id) || {}).title || '?'
                  : null;
                const isToday = d === today;
                let cellBg = isToday ? 'bg-blue-50/40 dark:bg-blue-900/10' : '';
                if (a && a.project_id) cellBg = 'bg-emerald-50 dark:bg-emerald-900/20';
                else if (a && a.note) cellBg = 'bg-amber-50 dark:bg-amber-900/20';
              %>
              <td class="px-2 py-1.5 <%= cellBg %> cursor-pointer select-none"
                  onclick="openCell('<%= u.id %>','<%= u.username %>','<%= d %>','<%= a ? (a.project_id || '') : '' %>','<%= a ? ((a.note||'').replace(/'/g,\"\\\\'\")) : '' %>')"
                  title="Klicken zum Bearbeiten">
                <% if (a && a.project_id && projTitle) { %>
                  <div class="flex items-center gap-1 px-2 py-1 bg-emerald-100 dark:bg-emerald-800/50 rounded-md">
                    <span class="text-emerald-700 dark:text-emerald-300 font-semibold text-[11px] leading-tight truncate max-w-[100px]" title="<%= projTitle %>">🏗️ <%= projTitle %></span>
                  </div>
                <% } else if (a && a.note) { %>
                  <div class="px-2 py-1 bg-amber-100 dark:bg-amber-800/40 rounded-md">
                    <span class="text-amber-700 dark:text-amber-300 text-[11px] leading-tight truncate block max-w-[100px]" title="<%= a.note %>">📝 <%= a.note %></span>
                  </div>
                <% } else { %>
                  <div class="px-2 py-1 rounded-md text-slate-300 dark:text-slate-600 text-[11px] text-center hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    +
                  </div>
                <% } %>
              </td>
              <% }) %>
            </tr>
            <% }) %>

            <% if (!users.length) { %>
            <tr><td colspan="7" class="py-10 text-center text-slate-400 text-sm">Keine Mitarbeiter gefunden.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Projekt-Legende -->
    <% if (projects.length > 0) { %>
    <div class="card p-4">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3">Aktive Baustellen</p>
      <div class="flex flex-wrap gap-2">
        <% projects.forEach(p => { %>
          <a href="/projects/<%= p.id %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-lg text-xs font-medium transition">
            🏗️ <%= p.title %>
          </a>
        <% }) %>
      </div>
    </div>
    <% } %>

  </div>
</main>

<!-- ══ Zell-Modal ══════════════════════════════════════════════════════════ -->
<div id="cell-modal" class="hidden fixed inset-0 z-[900] bg-black/60 backdrop-blur-sm flex items-center justify-center px-4"
     onclick="if(event.target===this)closeCell()">
  <div class="card w-full max-w-sm p-6 border-0" onclick="event.stopPropagation()">

    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="text-base font-bold text-slate-800 dark:text-slate-100" id="modal-title">Einteilung</h3>
        <p class="text-xs text-slate-400 mt-0.5" id="modal-sub"></p>
      </div>
      <button onclick="closeCell()" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition text-lg">✕</button>
    </div>

    <div class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Baustelle / Projekt</label>
        <select id="modal-project" class="input">
          <option value="">🏭 Werkstatt / Frei</option>
          <% projects.forEach(p => { %>
            <option value="<%= p.id %>">🏗️ <%= p.title %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Notiz (optional)</label>
        <input type="text" id="modal-note" placeholder="z.B. Montage ab 7 Uhr, Urlaub, Krank…" class="input" maxlength="80">
      </div>
    </div>

    <div class="flex gap-2 mt-5">
      <button onclick="saveCell()" id="modal-save-btn"
        class="btn btn-primary flex-1 justify-center">
        💾 Speichern
      </button>
      <button onclick="clearCell()" class="btn btn-ghost text-xs px-3 text-red-500 border-red-200 hover:bg-red-50 dark:border-red-800 dark:hover:bg-red-900/20">
        🗑️ Löschen
      </button>
    </div>
  </div>
</div>

<script>
const DAY_LABELS = ['Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'];
const DAYS       = <%- JSON.stringify(days) %>;

let _uid = null, _uname = null, _date = null;

function openCell(uid, uname, date, projId, note) {
  _uid   = uid;
  _uname = uname;
  _date  = date;

  const dayIdx  = DAYS.indexOf(date);
  const dateObj = new Date(date + 'T12:00:00');
  const dateStr = dateObj.toLocaleDateString('de-DE', { weekday:'long', day:'numeric', month:'long' });

  document.getElementById('modal-title').textContent = uname;
  document.getElementById('modal-sub').textContent   = dateStr;
  document.getElementById('modal-project').value     = projId || '';
  document.getElementById('modal-note').value        = note   || '';

  document.getElementById('cell-modal').classList.remove('hidden');
  setTimeout(() => document.getElementById('modal-note').focus(), 80);
}

function closeCell() {
  document.getElementById('cell-modal').classList.add('hidden');
}

async function saveCell() {
  const btn     = document.getElementById('modal-save-btn');
  const projId  = document.getElementById('modal-project').value;
  const note    = document.getElementById('modal-note').value.trim();

  btn.disabled    = true;
  btn.textContent = '⏳ Speichern…';

  try {
    const res = await fetch('/admin/staffplan/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ user_id: _uid, date: _date, project_id: projId, note })
    });
    const data = await res.json();
    if (data.ok) {
      showToast('Gespeichert ✓', 'success', 1800);
      closeCell();
      setTimeout(() => location.reload(), 300);
    } else {
      showToast('Fehler beim Speichern', 'error');
    }
  } catch (_) {
    showToast('Netzwerkfehler', 'error');
  } finally {
    btn.disabled    = false;
    btn.textContent = '💾 Speichern';
  }
}

async function clearCell() {
  if (!confirm('Eintrag für diesen Tag löschen?')) return;
  document.getElementById('modal-project').value = '';
  document.getElementById('modal-note').value    = '';
  await saveCell();
}

// Enter-Taste im Note-Feld speichert
document.getElementById('modal-note')?.addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); saveCell(); }
});
</script>

</body>
</html>
