<%- include('partials/header') %>

<style>
  /* Schnittliste Dark Mode – Tabs + Inputs */
  .tab-aktiv { background:#2563eb; color:#fff; }
  .tab-inaktiv { background:transparent; color:#64748b; }
  html.dark .tab-inaktiv, .dark .tab-inaktiv { color:#94a3b8; }
  html.dark .tab-inaktiv:hover, .dark .tab-inaktiv:hover { background:#334155; color:#e2e8f0; }
  html.dark #panel-datei input, html.dark #panel-datei select,
  html.dark #panel-bild input, html.dark #panel-bild select,
  .dark #panel-datei input, .dark #panel-datei select,
  .dark #panel-bild input, .dark #panel-bild select,
  html.dark #extra-tools input, .dark #extra-tools input,
  html.dark #auftrag-select, .dark #auftrag-select {
    background-color:#1e293b !important;
    border-color:#475569 !important;
    color:#e2e8f0 !important;
  }
  html.dark #pos-tabelle input,
  .dark #pos-tabelle input,
  html.dark .pos-input,
  .dark .pos-input {
    background-color:#1e293b !important;
    border: 1px solid #475569 !important;
    color:#e2e8f0 !important;
    border-radius: 0.25rem;
    padding: 0.2rem 0.35rem;
  }
  .pos-input {
    border: 1px solid #cbd5e1;
    border-radius: 0.25rem;
    padding: 0.2rem 0.35rem;
    background: #fff;
  }
  html.dark #drop-zone, .dark #drop-zone {
    border-color:#475569;
    background-color:#1e293b;
  }
  html.dark #drop-zone:hover, .dark #drop-zone:hover {
    border-color:#3b82f6;
    background-color:#1e3a5f;
  }
</style>

<div class="flex h-screen bg-slate-100 dark:bg-slate-900 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto bg-slate-100 dark:bg-slate-900 min-h-screen pt-16 page-bg">

    <!-- ── Seitenkopf ─────────────────────────────────────── -->
    <header class="bg-white dark:bg-slate-800 shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 mb-6 border-b border-transparent dark:border-slate-700">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-slate-100">✂️ Automatische Schnittliste</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 dark:text-slate-500 mt-0.5">CSV / XLSX hochladen <span class="text-slate-300">·</span> oder Foto / Scan per KI auslesen</p>
      </div>
    </header>

    <div class="px-4 md:px-6 max-w-5xl mx-auto w-full space-y-6 pb-10">

      <!-- ── Tab-Leiste ────────────────────────────────────── -->
      <div class="flex gap-1 bg-white dark:bg-slate-800 rounded-xl shadow p-1.5 max-w-sm border border-transparent dark:border-slate-700">
        <button id="tab-datei" onclick="wechsleTab('datei')"
          class="flex-1 text-sm font-semibold py-2 px-4 rounded-lg transition tab-aktiv">
          📂 Datei (CSV/XLSX)
        </button>
        <button id="tab-bild" onclick="wechsleTab('bild')"
          class="flex-1 text-sm font-semibold py-2 px-4 rounded-lg transition tab-inaktiv">
          📷 Foto / KI-Scan
        </button>
      </div>

      <!-- ── Gespeicherte Schnittlisten ───────────────────── -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-5 border border-transparent dark:border-slate-700">
        <div class="flex items-center justify-between gap-2 mb-3">
          <h2 class="text-sm font-semibold text-slate-800 dark:text-slate-100">💾 Gespeicherte Schnittlisten</h2>
          <button type="button" onclick="ladeGespeicherte()" class="text-xs text-blue-600 hover:underline">↻ Aktualisieren</button>
        </div>
        <div id="gespeichert-liste" class="text-sm text-slate-500">Lade…</div>
      </div>

      <!-- ════════════════════════════════════════════════════
           TAB 1 — DATEI-UPLOAD
           ════════════════════════════════════════════════════ -->
      <div id="panel-datei" class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-6 space-y-5 border border-transparent dark:border-slate-700">

        <div class="bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 rounded-lg px-4 py-3 text-sm text-blue-800 dark:text-blue-200 space-y-1">
          <p class="font-semibold">Erwartetes Format (CSV oder XLSX):</p>
          <p>Pflichtfelder: <code class="bg-blue-100 dark:bg-blue-900/50 px-1 rounded">Menge</code>, <code class="bg-blue-100 dark:bg-blue-900/50 px-1 rounded">Profil</code>, <code class="bg-blue-100 dark:bg-blue-900/50 px-1 rounded">Länge</code> (in mm)</p>
          <p class="text-xs text-blue-600">Optional: Pos, Bemerkung · CSV: Semikolon oder Komma · erste Zeile = Kopfzeile</p>
          <button type="button" onclick="zeigeBeispiel()" class="text-xs text-blue-700 dark:text-blue-300 underline mt-1">Beispiel-CSV anzeigen</button>
        </div>

        <div id="beispiel-csv" class="hidden bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg p-3">
          <p class="text-xs font-semibold text-slate-600 dark:text-slate-300 dark:text-slate-300 dark:text-slate-300 mb-2">Beispiel-CSV:</p>
          <pre class="text-xs text-slate-700 dark:text-slate-200 dark:text-slate-300 leading-relaxed">Pos;Menge;Profil;Länge;Bemerkung
1;3;IPE 200;2450;Unterzug
2;5;IPE 200;1800;Querträger
3;2;HEB 160;3200;Hauptträger
4;4;ROR 60x60x3;950;Stütze
5;6;ROR 60x60x3;600;Rahmenriegel</pre>
          <button type="button" onclick="downloadBeispielCsv()" class="mt-2 text-xs text-blue-600 hover:underline">⬇ Herunterladen</button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 dark:text-slate-300 uppercase tracking-wider mb-1">Name der Schnittliste</label>
            <input type="text" id="sl-name-datei" placeholder="z.B. Geländer Hof Nord"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-lg p-2.5 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500"
              oninput="syncMetaFromPre()">
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 dark:text-slate-300 uppercase tracking-wider mb-1">Baustelle / Auftrag</label>
            <select id="auftrag-pre-datei"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2.5 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500"
              onchange="onAuftragPre(this)">
              <option value="">– Baustelle / Auftrag wählen –</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 dark:text-slate-300 uppercase tracking-wider mb-1">CSV- oder XLSX-Datei</label>
            <input type="file" id="datei-input" accept=".csv,.txt,.xlsx"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-lg p-2 text-sm bg-white dark:bg-slate-900 dark:text-slate-100"
              onchange="onDateiGewaehlt(this)">
            <p id="datei-name" class="mt-1 text-xs text-slate-400 dark:text-slate-500"></p>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 dark:text-slate-300 uppercase tracking-wider mb-1">Stangenlänge (mm)</label>
            <input type="number" id="stangenlaenge" value="6000" min="100" max="20000" step="100"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-lg p-2.5 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 dark:text-slate-300 uppercase tracking-wider mb-1">Sägeblatt (mm)</label>
            <input type="number" id="saege" value="3" min="0" max="20" step="0.5"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-lg p-2.5 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500">
          </div>
        </div>

        <div class="flex flex-wrap gap-3 pt-1 border-t border-slate-100 dark:border-slate-700">
          <button onclick="berechnen()"
            class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition">
            ✂️ Schnittliste berechnen
          </button>
          <button id="btn-pdf" onclick="pdfHerunterladen()" disabled
            class="bg-slate-700 hover:bg-slate-800 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition">
            🖨️ PDF herunterladen
          </button>
        </div>
      </div>

      <!-- ════════════════════════════════════════════════════
           TAB 2 — BILD / KI-SCAN
           ════════════════════════════════════════════════════ -->
      <div id="panel-bild" class="hidden bg-white rounded-xl shadow p-4 md:p-6 space-y-5">

        <div class="bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 rounded-lg px-4 py-3 text-sm text-amber-800 dark:text-amber-200 space-y-1">
          <p class="font-semibold">🤖 KI-Erkennung aus technischer Zeichnung</p>
          <p>Lade ein Foto oder einen Scan einer <strong>technischen Zeichnung</strong> hoch (Werkstattzeichnung, Stahlbauplan, Positionsplan). Die KI liest automatisch alle Bauteilpositionen, Profile, Längen und Mengen heraus.</p>
          <p class="text-xs text-amber-700 mt-1">Die KI wertet aus: Stücklisten-Tabellen · Bemaßungslinien · Profilbezeichnungen · Positionsnummern · Mengenangaben · Maßstäbe · ungefähres Gewicht (kg)</p>
          <p class="text-xs text-amber-600 mt-0.5">Unterstützt: JPG, PNG, WebP · max. 15 MB · bis zu 4 Bilder gleichzeitig (z.B. Gesamtansicht + Detail + Stückliste)</p>
        </div>

        <!-- Drag & Drop Zone + Kamera / Galerie -->
        <div id="drop-zone"
          class="border-2 border-dashed border-slate-300 dark:border-slate-600 rounded-xl p-6 text-center transition hover:border-blue-400 hover:bg-blue-50 dark:hover:bg-slate-700/50 dark:bg-slate-900/40"
          ondragover="onDragOver(event)" ondragleave="onDragLeave(event)" ondrop="onDrop(event)">
          <div id="drop-inhalt">
            <p class="text-3xl mb-2">📷</p>
            <p class="text-sm font-semibold text-slate-600 dark:text-slate-300">Foto aufnehmen oder aus Galerie wählen</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">JPG · PNG · WebP · bis zu 4 Bilder · auch per Drag &amp; Drop</p>
            <div class="flex flex-wrap justify-center gap-2 mt-4">
              <button type="button" onclick="document.getElementById('bild-kamera').click()"
                class="inline-flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow">
                📸 Kamera
              </button>
              <button type="button" onclick="document.getElementById('bild-input').click()"
                class="inline-flex items-center gap-1.5 bg-slate-700 hover:bg-slate-800 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow">
                🖼️ Galerie
              </button>
            </div>
          </div>
          <div id="bild-vorschau-liste" class="hidden flex flex-wrap justify-center gap-3 mt-1"></div>
          <div id="bild-mehr" class="hidden mt-3 flex flex-wrap justify-center gap-2">
            <button type="button" onclick="document.getElementById('bild-kamera').click()"
              class="text-xs text-amber-700 font-semibold hover:underline">＋ Foto aufnehmen</button>
            <span class="text-slate-300">·</span>
            <button type="button" onclick="document.getElementById('bild-input').click()"
              class="text-xs text-blue-600 font-semibold hover:underline">＋ aus Galerie</button>
          </div>
        </div>
        <input type="file" id="bild-input" accept="image/*" multiple class="hidden" onchange="onBildGewaehlt(this)">
        <input type="file" id="bild-kamera" accept="image/*" capture="environment" class="hidden" onchange="onBildGewaehlt(this)">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 dark:text-slate-300 uppercase tracking-wider mb-1">Name der Schnittliste</label>
            <input type="text" id="sl-name-bild" placeholder="z.B. Geländer Hof Nord"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-lg p-2.5 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500"
              oninput="syncMetaFromPre()">
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 dark:text-slate-300 uppercase tracking-wider mb-1">Baustelle / Auftrag</label>
            <select id="auftrag-pre-bild"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2.5 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500"
              onchange="onAuftragPre(this)">
              <option value="">– Baustelle / Auftrag wählen –</option>
            </select>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Vor der KI-Analyse wählen – erscheint in PDF und beim Speichern.</p>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 dark:text-slate-300 uppercase tracking-wider mb-1">Stangenlänge (mm)</label>
            <input type="number" id="stangenlaenge-bild" value="6000" min="100" max="20000" step="100"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-lg p-2.5 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 dark:text-slate-300 uppercase tracking-wider mb-1">Sägeblatt (mm)</label>
            <input type="number" id="saege-bild" value="3" min="0" max="20" step="0.5"
              class="w-full border border-slate-300 dark:border-slate-600 rounded-lg p-2.5 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500">
          </div>
        </div>

        <div class="flex flex-wrap gap-3 pt-1 border-t border-slate-100 dark:border-slate-700">
          <button id="btn-bild-analyse" onclick="bildAnalysieren()" disabled
            class="bg-amber-500 hover:bg-amber-600 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition flex items-center gap-2">
            🤖 KI-Analyse starten
          </button>
          <button id="btn-pdf-bild" onclick="pdfHerunterladen()" disabled
            class="bg-slate-700 hover:bg-slate-800 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition">
            🖨️ PDF herunterladen
          </button>
        </div>
      </div>

      <!-- ── Gemeinsame Fehler / Lade-Anzeige ─────────────── -->
      <div id="fehler-box" class="hidden bg-red-50 dark:bg-red-900/30 border border-red-300 dark:border-red-800 rounded-lg px-4 py-3 text-sm text-red-700 dark:text-red-300"></div>
      <div id="loading" class="hidden bg-white dark:bg-slate-800 rounded-xl shadow px-5 py-4 flex items-center gap-3 text-sm text-slate-600 dark:text-slate-300 dark:text-slate-300 border border-transparent dark:border-slate-700">
        <svg class="animate-spin w-5 h-5 text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
        </svg>
        <span id="loading-text">Wird verarbeitet…</span>
      </div>

      <!-- ── Ergebnis-Bereich (gemeinsam für beide Tabs) ───── -->
      <div id="ergebnis" class="hidden space-y-5">
        <div id="ki-hinweis" class="hidden bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 rounded-lg px-4 py-3 text-sm text-green-800 dark:text-green-200">
          ✅ KI hat <span id="ki-anzahl">0</span> Positionen erkannt. Bitte kurz prüfen, dann PDF herunterladen.
        </div>

        <!-- Auftrag zuweisen (für PDF + Speichern) -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-5 border border-transparent dark:border-slate-700">
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 dark:text-slate-300 dark:text-slate-300 uppercase tracking-wider mb-1.5">Auftrag</label>
          <select id="auftrag-select"
            class="w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2.5 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500"
            onchange="onAuftragGewaehlt(this)">
            <option value="">– keinen Auftrag wählen –</option>
          </select>
          <p id="auftrag-hinweis" class="text-xs text-slate-400 dark:text-slate-500 mt-1.5">Auftragsname erscheint in der PDF und in der gespeicherten Liste.</p>
        </div>

        <div id="zusammenfassung" class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-5 border border-transparent dark:border-slate-700"></div>

        <!-- Editierbare Positionstabelle -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden border border-transparent dark:border-slate-700">
          <div class="px-4 md:px-5 py-3 border-b border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-sm font-semibold text-slate-800 dark:text-slate-100">📋 Erkannte Positionen <span class="text-xs text-slate-400 dark:text-slate-500 font-normal ml-1">(Werte können direkt bearbeitet werden)</span></h2>
            <div class="flex items-center gap-3">
              <button type="button" onclick="schnittlisteSpeichern()"
                class="text-xs bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg font-semibold transition">
                💾 Speichern
              </button>
              <button onclick="posHinzufuegen()" class="text-xs text-blue-600 hover:underline">+ Zeile</button>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left min-w-[840px]">
              <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 dark:text-slate-400 dark:text-slate-500 text-xs uppercase border-b dark:border-slate-700">
                <tr>
                  <th class="px-3 py-2">Pos</th>
                  <th class="px-3 py-2">Menge</th>
                  <th class="px-3 py-2">Profil</th>
                  <th class="px-3 py-2">Länge (mm)</th>
                  <th class="px-3 py-2" title="Ungefähres Gewicht 1 Stück (KI-Schätzung)">≈ kg</th>
                  <th class="px-3 py-2">Winkel</th>
                  <th class="px-3 py-2">Schnitt</th>
                  <th class="px-3 py-2">Bemerkung</th>
                  <th class="px-3 py-2 text-right">
                    <button onclick="neuBerechnen()" class="text-xs bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 transition">↻ Neu berechnen</button>
                  </th>
                </tr>
              </thead>
              <tbody id="pos-tabelle" class="divide-y divide-slate-100 dark:divide-slate-700 dark:divide-slate-700 text-slate-700 dark:text-slate-200 dark:text-slate-200"></tbody>
            </table>
          </div>
        </div>

        <div id="profil-karten" class="space-y-4"></div>

        <!-- Extra-Tools: Bestellliste, Reststücke, Angebot -->
        <div id="extra-tools" class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-5 space-y-4 border border-transparent dark:border-slate-700">
          <h2 class="text-sm font-semibold text-slate-800 dark:text-slate-100">🛠️ Werkzeuge</h2>
          <div class="flex flex-wrap gap-2">
            <button type="button" onclick="bestelllistePdf()"
              class="text-sm bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-lg font-semibold">
              📦 Bestellliste PDF
            </button>
            <button type="button" onclick="angebotPdf()"
              class="text-sm bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg font-semibold">
              💶 Angebot PDF
            </button>
            <button type="button" onclick="mitRestenNeuOptimieren()"
              class="text-sm bg-slate-700 hover:bg-slate-800 text-white px-4 py-2 rounded-lg font-semibold">
              ♻️ Mit Reststücken optimieren
            </button>
            <button type="button" onclick="reststueckeSpeichern()"
              class="text-sm bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg font-semibold">
              💾 Reste ins Lager
            </button>
          </div>
          <div id="reste-info" class="text-xs text-slate-500 dark:text-slate-400 dark:text-slate-500"></div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-slate-100 dark:border-slate-700 pt-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 dark:text-slate-300 dark:text-slate-300 mb-1">Stahlpreis € / 100 kg</label>
              <input type="number" id="angebot-stahlpreis" step="0.01" min="0" placeholder="z.B. 95"
                class="w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-900 dark:text-slate-100">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 dark:text-slate-300 dark:text-slate-300 mb-1">Arbeitsstunden</label>
              <input type="number" id="angebot-stunden" step="0.5" min="0" value="0"
                class="w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-900 dark:text-slate-100">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 dark:text-slate-300 dark:text-slate-300 mb-1">Stundensatz €</label>
              <input type="number" id="angebot-stundensatz" step="1" min="0" value="65"
                class="w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-900 dark:text-slate-100">
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Verstecktes PDF-Formular -->
