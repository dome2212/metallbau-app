<%- include('partials/header') %>

<div class="flex h-screen bg-slate-100 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto bg-slate-100 min-h-screen pt-16">

    <!-- ── Seitenkopf ─────────────────────────────────────── -->
    <header class="bg-white shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 mb-6">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800">✂️ Automatische Schnittliste</h1>
        <p class="text-sm text-slate-500 mt-0.5">CSV / XLSX hochladen <span class="text-slate-300">·</span> oder Foto / Scan per KI auslesen</p>
      </div>
    </header>

    <div class="px-4 md:px-6 max-w-5xl mx-auto w-full space-y-6 pb-10">

      <!-- ── Tab-Leiste ────────────────────────────────────── -->
      <div class="flex gap-1 bg-white rounded-xl shadow p-1.5 max-w-sm">
        <button id="tab-datei" onclick="wechsleTab('datei')"
          class="flex-1 text-sm font-semibold py-2 px-4 rounded-lg transition tab-aktiv">
          📂 Datei (CSV/XLSX)
        </button>
        <button id="tab-bild" onclick="wechsleTab('bild')"
          class="flex-1 text-sm font-semibold py-2 px-4 rounded-lg transition tab-inaktiv">
          📷 Foto / KI-Scan
        </button>
      </div>

      <!-- ── Gespeicherte Schnittlisten ───────────────────── -->
      <div class="bg-white rounded-xl shadow p-4 md:p-5">
        <div class="flex items-center justify-between gap-2 mb-3">
          <h2 class="text-sm font-semibold text-slate-800">💾 Gespeicherte Schnittlisten</h2>
          <button type="button" onclick="ladeGespeicherte()" class="text-xs text-blue-600 hover:underline">↻ Aktualisieren</button>
        </div>
        <div id="gespeichert-liste" class="text-sm text-slate-500">Lade…</div>
      </div>

      <!-- ════════════════════════════════════════════════════
           TAB 1 — DATEI-UPLOAD
           ════════════════════════════════════════════════════ -->
      <div id="panel-datei" class="bg-white rounded-xl shadow p-4 md:p-6 space-y-5">

        <div class="bg-blue-50 border border-blue-200 rounded-lg px-4 py-3 text-sm text-blue-800 space-y-1">
          <p class="font-semibold">Erwartetes Format (CSV oder XLSX):</p>
          <p>Pflichtfelder: <code class="bg-blue-100 px-1 rounded">Menge</code>, <code class="bg-blue-100 px-1 rounded">Profil</code>, <code class="bg-blue-100 px-1 rounded">Länge</code> (in mm)</p>
          <p class="text-xs text-blue-600">Optional: Pos, Bemerkung · CSV: Semikolon oder Komma · erste Zeile = Kopfzeile</p>
          <button type="button" onclick="zeigeBeispiel()" class="text-xs text-blue-700 underline mt-1">Beispiel-CSV anzeigen</button>
        </div>

        <div id="beispiel-csv" class="hidden bg-slate-50 border border-slate-200 rounded-lg p-3">
          <p class="text-xs font-semibold text-slate-600 mb-2">Beispiel-CSV:</p>
          <pre class="text-xs text-slate-700 leading-relaxed">Pos;Menge;Profil;Länge;Bemerkung
1;3;IPE 200;2450;Unterzug
2;5;IPE 200;1800;Querträger
3;2;HEB 160;3200;Hauptträger
4;4;ROR 60x60x3;950;Stütze
5;6;ROR 60x60x3;600;Rahmenriegel</pre>
          <button type="button" onclick="downloadBeispielCsv()" class="mt-2 text-xs text-blue-600 hover:underline">⬇ Herunterladen</button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">CSV- oder XLSX-Datei</label>
            <input type="file" id="datei-input" accept=".csv,.txt,.xlsx"
              class="w-full border border-slate-300 rounded-lg p-2 text-sm bg-white"
              onchange="onDateiGewaehlt(this)">
            <p id="datei-name" class="mt-1 text-xs text-slate-400"></p>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Stangenlänge (mm)</label>
            <input type="number" id="stangenlaenge" value="6000" min="100" max="20000" step="100"
              class="w-full border border-slate-300 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Sägeblatt (mm)</label>
            <input type="number" id="saege" value="3" min="0" max="20" step="0.5"
              class="w-full border border-slate-300 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
          </div>
        </div>

        <div class="flex flex-wrap gap-3 pt-1 border-t border-slate-100">
          <button onclick="berechnen()"
            class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition">
            ✂️ Schnittliste berechnen
          </button>
          <button id="btn-pdf" onclick="pdfHerunterladen()" disabled
            class="bg-slate-700 hover:bg-slate-800 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition">
            🖨️ PDF herunterladen
          </button>
        </div>
      </div>

      <!-- ════════════════════════════════════════════════════
           TAB 2 — BILD / KI-SCAN
           ════════════════════════════════════════════════════ -->
      <div id="panel-bild" class="hidden bg-white rounded-xl shadow p-4 md:p-6 space-y-5">

        <div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 text-sm text-amber-800 space-y-1">
          <p class="font-semibold">🤖 KI-Erkennung aus technischer Zeichnung</p>
          <p>Lade ein Foto oder einen Scan einer <strong>technischen Zeichnung</strong> hoch (Werkstattzeichnung, Stahlbauplan, Positionsplan). Die KI liest automatisch alle Bauteilpositionen, Profile, Längen und Mengen heraus.</p>
          <p class="text-xs text-amber-700 mt-1">Die KI wertet aus: Stücklisten-Tabellen · Bemaßungslinien · Profilbezeichnungen · Positionsnummern · Mengenangaben · Maßstäbe · ungefähres Gewicht (kg)</p>
          <p class="text-xs text-amber-600 mt-0.5">Unterstützt: JPG, PNG, WebP · max. 15 MB · bis zu 4 Bilder gleichzeitig (z.B. Gesamtansicht + Detail + Stückliste)</p>
        </div>

        <!-- Drag & Drop Zone + Kamera / Galerie -->
        <div id="drop-zone"
          class="border-2 border-dashed border-slate-300 rounded-xl p-6 text-center transition hover:border-blue-400 hover:bg-blue-50"
          ondragover="onDragOver(event)" ondragleave="onDragLeave(event)" ondrop="onDrop(event)">
          <div id="drop-inhalt">
            <p class="text-3xl mb-2">📷</p>
            <p class="text-sm font-semibold text-slate-600">Foto aufnehmen oder aus Galerie wählen</p>
            <p class="text-xs text-slate-400 mt-1">JPG · PNG · WebP · bis zu 4 Bilder · auch per Drag &amp; Drop</p>
            <div class="flex flex-wrap justify-center gap-2 mt-4">
              <button type="button" onclick="document.getElementById('bild-kamera').click()"
                class="inline-flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow">
                📸 Kamera
              </button>
              <button type="button" onclick="document.getElementById('bild-input').click()"
                class="inline-flex items-center gap-1.5 bg-slate-700 hover:bg-slate-800 text-white text-sm font-semibold px-4 py-2 rounded-lg shadow">
                🖼️ Galerie
              </button>
            </div>
          </div>
          <div id="bild-vorschau-liste" class="hidden flex flex-wrap justify-center gap-3 mt-1"></div>
          <div id="bild-mehr" class="hidden mt-3 flex flex-wrap justify-center gap-2">
            <button type="button" onclick="document.getElementById('bild-kamera').click()"
              class="text-xs text-amber-700 font-semibold hover:underline">＋ Foto aufnehmen</button>
            <span class="text-slate-300">·</span>
            <button type="button" onclick="document.getElementById('bild-input').click()"
              class="text-xs text-blue-600 font-semibold hover:underline">＋ aus Galerie</button>
          </div>
        </div>
        <input type="file" id="bild-input" accept="image/*" multiple class="hidden" onchange="onBildGewaehlt(this)">
        <input type="file" id="bild-kamera" accept="image/*" capture="environment" class="hidden" onchange="onBildGewaehlt(this)">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Stangenlänge (mm)</label>
            <input type="number" id="stangenlaenge-bild" value="6000" min="100" max="20000" step="100"
              class="w-full border border-slate-300 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Sägeblatt (mm)</label>
            <input type="number" id="saege-bild" value="3" min="0" max="20" step="0.5"
              class="w-full border border-slate-300 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
          </div>
        </div>

        <div class="flex flex-wrap gap-3 pt-1 border-t border-slate-100">
          <button id="btn-bild-analyse" onclick="bildAnalysieren()" disabled
            class="bg-amber-500 hover:bg-amber-600 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition flex items-center gap-2">
            🤖 KI-Analyse starten
          </button>
          <button id="btn-pdf-bild" onclick="pdfHerunterladen()" disabled
            class="bg-slate-700 hover:bg-slate-800 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition">
            🖨️ PDF herunterladen
          </button>
        </div>
      </div>

      <!-- ── Gemeinsame Fehler / Lade-Anzeige ─────────────── -->
      <div id="fehler-box" class="hidden bg-red-50 border border-red-300 rounded-lg px-4 py-3 text-sm text-red-700"></div>
      <div id="loading" class="hidden bg-white rounded-xl shadow px-5 py-4 flex items-center gap-3 text-sm text-slate-600">
        <svg class="animate-spin w-5 h-5 text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
        </svg>
        <span id="loading-text">Wird verarbeitet…</span>
      </div>

      <!-- ── Ergebnis-Bereich (gemeinsam für beide Tabs) ───── -->
      <div id="ergebnis" class="hidden space-y-5">
        <div id="ki-hinweis" class="hidden bg-green-50 border border-green-200 rounded-lg px-4 py-3 text-sm text-green-800">
          ✅ KI hat <span id="ki-anzahl">0</span> Positionen erkannt. Bitte kurz prüfen, dann PDF herunterladen.
        </div>

        <div id="zusammenfassung" class="bg-white rounded-xl shadow p-4 md:p-5"></div>

        <!-- Editierbare Positionstabelle -->
        <div class="bg-white rounded-xl shadow overflow-hidden">
          <div class="px-4 md:px-5 py-3 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-sm font-semibold text-slate-800">📋 Erkannte Positionen <span class="text-xs text-slate-400 font-normal ml-1">(Werte können direkt bearbeitet werden)</span></h2>
            <div class="flex items-center gap-3">
              <button type="button" onclick="schnittlisteSpeichern()"
                class="text-xs bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg font-semibold transition">
                💾 Speichern
              </button>
              <button onclick="posHinzufuegen()" class="text-xs text-blue-600 hover:underline">+ Zeile</button>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left min-w-[840px]">
              <thead class="bg-slate-50 text-slate-500 text-xs uppercase border-b">
                <tr>
                  <th class="px-3 py-2">Pos</th>
                  <th class="px-3 py-2">Menge</th>
                  <th class="px-3 py-2">Profil</th>
                  <th class="px-3 py-2">Länge (mm)</th>
                  <th class="px-3 py-2" title="Ungefähres Gewicht 1 Stück (KI-Schätzung)">≈ kg</th>
                  <th class="px-3 py-2">Winkel</th>
                  <th class="px-3 py-2">Schnitt</th>
                  <th class="px-3 py-2">Bemerkung</th>
                  <th class="px-3 py-2 text-right">
                    <button onclick="neuBerechnen()" class="text-xs bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 transition">↻ Neu berechnen</button>
                  </th>
                </tr>
              </thead>
              <tbody id="pos-tabelle" class="divide-y divide-slate-100 text-slate-700"></tbody>
            </table>
          </div>
        </div>

        <div id="profil-karten" class="space-y-4"></div>
      </div>

    </div>
  </main>
</div>

<!-- Verstecktes PDF-Formular -->
<form id="pdf-form" method="POST" action="/schnittliste/pdf" enctype="multipart/form-data" class="hidden">
  <input type="hidden" name="stangenlaenge" id="pdf-stangenlaenge">
  <input type="hidden" name="saege" id="pdf-saege">
  <input type="hidden" name="firma_name" value="<%= currentUser ? currentUser.username : '' %>">
</form>

<style>
  .tab-aktiv   { background:#1e40af; color:#fff; }
  .tab-inaktiv { background:transparent; color:#475569; }
  .tab-inaktiv:hover { background:#f1f5f9; }
  .pos-input { border:none; outline:none; background:transparent; width:100%; padding:2px 4px; border-radius:4px; }
  .pos-input:focus { background:#eff6ff; }
</style>

<script>
'use strict';

// ── Zustand ──────────────────────────────────────────────────
let aktDatei        = null;  // CSV/XLSX
let aktBilder       = [];    // Bilddateien (max. 4)
const MAX_BILDER    = 4;
let aktPositionen   = [];
let aktGruppen      = [];
let aktStange       = 6000;
let aktQuelle       = 'datei'; // 'datei' | 'bild'
let aktGespeichertId = null;   // ID wenn aus DB geladen / zuletzt gespeichert
let aktGespeichertName = '';
let aktProjectId = null;       // zugeordneter Auftrag
let aktProjekteCache = null;

function leseSaege() {
  const el = document.getElementById(aktQuelle === 'bild' ? 'saege-bild' : 'saege');
  const v = parseFloat(String(el && el.value).replace(',', '.'));
  return Number.isFinite(v) && v >= 0 ? v : 3;
}

// ── Tab-Wechsel ──────────────────────────────────────────────
function wechsleTab(tab) {
  aktQuelle = tab;
  document.getElementById('panel-datei').classList.toggle('hidden', tab !== 'datei');
  document.getElementById('panel-bild').classList.toggle('hidden',  tab !== 'bild');
  document.getElementById('tab-datei').className =
    'flex-1 text-sm font-semibold py-2 px-4 rounded-lg transition ' + (tab === 'datei' ? 'tab-aktiv' : 'tab-inaktiv');
  document.getElementById('tab-bild').className =
    'flex-1 text-sm font-semibold py-2 px-4 rounded-lg transition ' + (tab === 'bild' ? 'tab-aktiv' : 'tab-inaktiv');
  verstecke('ergebnis'); verstecke('fehler-box');
}

// ── Datei-Tab ────────────────────────────────────────────────
function onDateiGewaehlt(inp) {
  aktDatei = inp.files[0] || null;
  document.getElementById('datei-name').textContent = aktDatei ? aktDatei.name : '';
  verstecke('ergebnis'); verstecke('fehler-box');
  document.getElementById('btn-pdf').disabled = true;
}

async function berechnen() {
  verstecke('fehler-box'); verstecke('ergebnis');
  document.getElementById('btn-pdf').disabled = true;
  if (!aktDatei) { zeigeFehler('Bitte zuerst eine Datei auswählen.'); return; }
  const sl = parseInt(document.getElementById('stangenlaenge').value, 10);
  if (!sl || sl < 100) { zeigeFehler('Ungültige Stangenlänge.'); return; }

  zeigeLoading('Datei wird analysiert…');
  const fd = new FormData();
  fd.append('datei', aktDatei);
  fd.append('stangenlaenge', sl);
  fd.append('saege', leseSaege());
  try {
    const res  = await fetch('/schnittliste/upload', { method: 'POST', body: fd });
    const data = await res.json();
    versteckeLoading();
    if (!data.ok) { zeigeFehler(data.fehler || 'Unbekannter Fehler.'); return; }
    aktPositionen = data.positionen;
    aktGruppen    = data.gruppen;
    aktStange     = data.stangenlaenge;
    verstecke('ki-hinweis');
    rendereErgebnis();
    document.getElementById('btn-pdf').disabled = false;
  } catch (e) { versteckeLoading(); zeigeFehler('Netzwerkfehler: ' + e.message); }
}

// ── Bild-Tab ─────────────────────────────────────────────────
function onBildGewaehlt(inp) {
  bilderHinzufuegen(Array.from(inp.files || []));
  inp.value = '';
}

function onDragOver(e)  { e.preventDefault(); document.getElementById('drop-zone').classList.add('border-blue-400','bg-blue-50'); }
function onDragLeave(e) { document.getElementById('drop-zone').classList.remove('border-blue-400','bg-blue-50'); }
function onDrop(e) {
  e.preventDefault();
  onDragLeave(e);
  bilderHinzufuegen(Array.from(e.dataTransfer.files || []));
}

function bilderHinzufuegen(files) {
  const bilder = files.filter(f => f.type.startsWith('image/'));
  if (bilder.length < files.length) zeigeFehler('Nur Bilddateien (JPG, PNG, WebP) erlaubt.'); else verstecke('fehler-box');
  for (const f of bilder) {
    if (aktBilder.length >= MAX_BILDER) { zeigeFehler(`Maximal ${MAX_BILDER} Bilder gleichzeitig.`); break; }
    aktBilder.push(f);
  }
  rendereVorschau();
  document.getElementById('btn-pdf-bild').disabled = true;
  verstecke('ergebnis');
}

function bildEntfernen(i, ev) {
  ev.stopPropagation();
  aktBilder.splice(i, 1);
  rendereVorschau();
}

function rendereVorschau() {
  const liste = document.getElementById('bild-vorschau-liste');
  document.getElementById('btn-bild-analyse').disabled = aktBilder.length === 0;
  document.getElementById('drop-inhalt').classList.toggle('hidden', aktBilder.length > 0);
  liste.classList.toggle('hidden', aktBilder.length === 0);
  document.getElementById('bild-mehr').classList.toggle('hidden', aktBilder.length === 0 || aktBilder.length >= MAX_BILDER);
  liste.innerHTML = '';
  aktBilder.forEach((file, i) => {
    const box = document.createElement('div');
    box.className = 'relative';
    const img = document.createElement('img');
    img.className = 'max-h-40 max-w-[45vw] rounded-lg shadow border border-slate-200';
    img.src = URL.createObjectURL(file);
    img.onload = () => URL.revokeObjectURL(img.src);
    const x = document.createElement('button');
    x.type = 'button';
    x.textContent = '✕';
    x.title = 'Bild entfernen';
    x.className = 'absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 text-xs shadow';
    x.onclick = ev => bildEntfernen(i, ev);
    const nr = document.createElement('span');
    nr.textContent = String(i + 1);
    nr.className = 'absolute bottom-1 left-1 bg-slate-800/80 text-white text-xs rounded px-1.5';
    box.append(img, x, nr);
    liste.appendChild(box);
  });
}

// Bild verkleinern (max. 2200 px lange Seite, JPEG) – hält die Anfrage klein und schnell
function bildVerkleinern(file) {
  return new Promise(resolve => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      const max = 2200, f = Math.min(1, max / Math.max(img.width, img.height));
      if (f >= 1 && file.size < 3 * 1024 * 1024) return resolve(file);
      const c = document.createElement('canvas');
      c.width = Math.round(img.width * f); c.height = Math.round(img.height * f);
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
      ctx.drawImage(img, 0, 0, c.width, c.height);
      c.toBlob(b => resolve(b ? new File([b], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' }) : file), 'image/jpeg', 0.88);
    };
    img.onerror = () => { URL.revokeObjectURL(url); resolve(file); };
    img.src = url;
  });
}

async function bildAnalysieren() {
  verstecke('fehler-box'); verstecke('ergebnis');
  document.getElementById('btn-pdf-bild').disabled = true;
  if (aktBilder.length === 0) { zeigeFehler('Kein Bild ausgewählt.'); return; }
  const sl = parseInt(document.getElementById('stangenlaenge-bild').value, 10) || 6000;

  zeigeLoading(aktBilder.length > 1 ? `KI analysiert ${aktBilder.length} Bilder — das kann einige Sekunden dauern…` : 'KI analysiert das Bild — das kann einige Sekunden dauern…');
  const fd = new FormData();
  for (const f of aktBilder) fd.append('bild', await bildVerkleinern(f));
  fd.append('stangenlaenge', sl);
  fd.append('saege', leseSaege());
  try {
    const res  = await fetch('/schnittliste/bild', { method: 'POST', body: fd });
    const data = await res.json();
    versteckeLoading();
    if (!data.ok) { zeigeFehler(data.fehler || 'KI konnte keine Positionen erkennen.'); return; }
    aktPositionen = data.positionen;
    aktGruppen    = data.gruppen;
    aktStange     = data.stangenlaenge;
    // KI-Hinweis zeigen
    const hinweis = document.getElementById('ki-hinweis');
    document.getElementById('ki-anzahl').textContent = aktPositionen.length;
    hinweis.classList.remove('hidden');
    rendereErgebnis();
    document.getElementById('btn-pdf-bild').disabled = false;
  } catch (e) { versteckeLoading(); zeigeFehler('Netzwerkfehler: ' + e.message); }
}

// ── Editierbare Tabelle ──────────────────────────────────────
function posHinzufuegen() {
  aktPositionen.push({ pos: String(aktPositionen.length + 1), menge: 1, profil: '', laenge: 0, kg: 0, bemerk: '', winkel: '' });
  rendereTabelle();
}

function posLoeschen(idx) {
  aktPositionen.splice(idx, 1);
  rendereTabelle();
}

function leseTabelle() {
  // Aktuelle Werte aus den Input-Feldern lesen
  // Reihenfolge: pos, menge, profil, laenge, kg, winkel, bemerk
  const rows = document.querySelectorAll('#pos-tabelle tr[data-idx]');
  aktPositionen = [];
  rows.forEach(row => {
    const inps = row.querySelectorAll('.pos-input');
    aktPositionen.push({
      pos:    inps[0].value.trim() || String(aktPositionen.length + 1),
      menge:  Math.max(1, parseInt(inps[1].value, 10) || 1),
      profil: inps[2].value.trim(),
      laenge: Math.round(parseFloat(inps[3].value) || 0),
      kg:     Math.max(0, Math.round((parseFloat(inps[4].value) || 0) * 10) / 10),
      winkel: inps[5].value.trim(),
      bemerk: inps[6].value.trim()
    });
  });
}

function neuBerechnen() {
  leseTabelle();
  const sl = parseInt(
    (aktQuelle === 'bild'
      ? document.getElementById('stangenlaenge-bild')
      : document.getElementById('stangenlaenge')
    ).value, 10) || aktStange;
  // Neu optimieren: AJAX-freie Variante – sende Positionen als JSON
  fetch('/schnittliste/upload', {
    method: 'POST',
    body: (() => {
      // CSV aus aktPositionen bauen und als Datei hochladen
      const csv = 'Pos;Menge;Profil;Länge;Bemerkung;Winkel;kg\n' +
        aktPositionen.map(p => `${p.pos};${p.menge};${p.profil};${p.laenge};${p.bemerk};${p.winkel || ''};${p.kg || 0}`).join('\n');
      const fd = new FormData();
      fd.append('datei', new File([csv], 'edit.csv', { type: 'text/csv' }));
      fd.append('stangenlaenge', sl);
      fd.append('saege', leseSaege());
      return fd;
    })()
  }).then(r => r.json()).then(data => {
    if (!data.ok) { zeigeFehler(data.fehler || 'Fehler.'); return; }
    aktPositionen = data.positionen;
    aktGruppen    = data.gruppen;
    aktStange     = data.stangenlaenge;
    rendereErgebnis();
  }).catch(e => zeigeFehler('Fehler: ' + e.message));
}

// ── PDF ──────────────────────────────────────────────────────
function pdfHerunterladen() {
  leseTabelle();
  const sl = parseInt(
    (aktQuelle === 'bild'
      ? document.getElementById('stangenlaenge-bild')
      : document.getElementById('stangenlaenge')
    ).value, 10) || aktStange;

  // CSV aus aktuellen Positionen aufbauen und als Datei übergeben (inkl. kg)
  const csv = 'Pos;Menge;Profil;Länge;Bemerkung;Winkel;kg\n' +
    aktPositionen.map(p => `${p.pos};${p.menge};${p.profil};${p.laenge};${p.bemerk};${p.winkel || ''};${p.kg || 0}`).join('\n');
  const csvFile = new File([csv], 'schnittliste.csv', { type: 'text/csv' });

  document.getElementById('pdf-stangenlaenge').value = sl;
  document.getElementById('pdf-saege').value = leseSaege();
  const form = document.getElementById('pdf-form');
  const old = form.querySelector('input[name="datei"]');
  if (old) old.remove();
  const fi = document.createElement('input');
  fi.type = 'file'; fi.name = 'datei'; fi.style.display = 'none';
  form.appendChild(fi);
  const dt = new DataTransfer();
  dt.items.add(csvFile);
  fi.files = dt.files;
  form.submit();
}

// ── Render ───────────────────────────────────────────────────
function rendereErgebnis() {
  // Zusammenfassung
  const gesamtStangen    = aktGruppen.reduce((s, g) => s + g.stangenzahl, 0);
  const avgAusnutzung    = aktGruppen.length
    ? Math.round(aktGruppen.reduce((s,g)=>s+g.ausnutzung,0) / aktGruppen.length) : 0;
  const gesamtVerschnitt = aktGruppen.reduce((s,g)=>s+g.verschnittGes,0);
  const gesamtKg = aktPositionen.reduce((s, p) => s + (Number(p.kg) || 0) * (Number(p.menge) || 1), 0);
  const kgText = gesamtKg > 0 ? (Math.round(gesamtKg * 10) / 10).toLocaleString('de-DE') : '–';

  document.getElementById('zusammenfassung').innerHTML = `
    <h2 class="text-sm font-semibold text-slate-700 mb-3">📊 Zusammenfassung</h2>
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
      ${kachel('Positionen',      aktPositionen.length,       '')}
      ${kachel('Stangen gesamt',  gesamtStangen,              'Stk')}
      ${kachel('Ø Ausnutzung',    avgAusnutzung,              '%')}
      ${kachel('Gesamtverschnitt',mm(gesamtVerschnitt),       'mm')}
      ${kachel('≈ Gesamtgewicht', kgText,                     'kg')}
    </div>`;

  rendereTabelle();

  // Profil-Karten
  const container = document.getElementById('profil-karten');
  const FARBEN = ['#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6'];
  container.innerHTML = aktGruppen.map(g => {
    const stDetails = g.stangen.map((st, si) => {
      const label   = st.uebermas ? 'Übermaß' : `Stange ${si+1}`;
      const balken  = st.teile.map((t, ti) => {
        const pct   = st.uebermas ? 100 : Math.max(1, Math.round((t.laenge / aktStange) * 100));
        return `<div title="Pos ${esc(t.pos)}: ${mm(t.laenge)} mm"
          style="width:${pct}%;background:${FARBEN[ti%FARBEN.length]};height:100%;display:inline-block;vertical-align:top;"></div>`;
      }).join('');
      const restPct = st.uebermas ? 0 : Math.round((st.rest / aktStange) * 100);
      const restB   = restPct > 0
        ? `<div style="width:${restPct}%;background:#e5e7eb;height:100%;display:inline-block;vertical-align:top;" title="Verschnitt: ${mm(st.rest)} mm"></div>` : '';
      const teileListe = st.teile.map(t =>
        `<span class="inline-block bg-slate-100 text-slate-600 text-xs px-1.5 py-0.5 rounded mr-1 mb-1">Pos ${esc(t.pos)}: ${mm(t.laenge)} mm${t.winkel ? ' · ' + esc(t.winkel) : ''}</span>`
      ).join('');
      return `
        <div class="border border-slate-200 rounded-lg p-3 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-600">${label}</span>
            ${st.uebermas ? '<span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded font-medium">⚠ Übermaß</span>'
                          : `<span class="text-xs text-slate-400">Rest: ${mm(st.rest)} mm</span>`}
          </div>
          <div style="height:14px;width:100%;background:#f1f5f9;border-radius:4px;overflow:hidden;">${balken}${restB}</div>
          <div class="pt-1">${teileListe}</div>
        </div>`;
    }).join('');

    return `
      <div class="bg-white rounded-xl shadow overflow-hidden">
        <div class="px-4 md:px-5 py-3 bg-blue-50 border-b border-blue-100 flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-sm font-bold text-blue-800">${esc(g.profil)}</h3>
          <div class="flex flex-wrap gap-3 text-xs text-blue-700">
            <span>📦 ${g.stangenzahl} Stange(n)</span>
            <span>📏 ${mm(g.gesamtLaenge)} mm</span>
            <span class="font-semibold ${g.ausnutzung>=80?'text-green-700':g.ausnutzung>=60?'text-amber-700':'text-red-700'}">
              Ausnutzung: ${g.ausnutzung} %
            </span>
            <span>Verschnitt: ${mm(g.verschnittGes)} mm</span>
          </div>
        </div>
        <div class="p-4 space-y-3">${stDetails}</div>
      </div>`;
  }).join('');

  document.getElementById('ergebnis').classList.remove('hidden');
}

// Schnittskizze (Draufsicht): Abweichung vom geraden 90°-Schnitt; links = Anfang, rechts = Ende
function schnittSvg(winkel) {
  const txt = String(winkel || '');
  const z = (txt.match(/\d+(?:[.,]\d+)?/g) || []).map(n => parseFloat(n.replace(',', '.')));
  if (!z.length) return '<span class="text-slate-300">–</span>';
  const dev = a => (a > 0 && a < 90 ? a : 0);
  const d1 = dev(z[0]), d2 = z.length > 1 ? dev(z[1]) : d1;
  const parallel = /parallel|par\b/i.test(txt);
  const w = 56, h = 16;
  const off = d => Math.min(w * 0.28, h * Math.tan(d * Math.PI / 180));
  const o1 = off(d1), o2 = off(d2);
  const pts = parallel
    ? [[o1, 0], [w, 0], [w - o2, h], [0, h]]
    : [[o1, 0], [w - o2, 0], [w, h], [0, h]];
  return `<svg width="${w + 4}" height="${h + 4}" viewBox="-2 -2 ${w + 4} ${h + 4}" title="Schnittrichtung">` +
    `<polygon points="${pts.map(p => p.map(n => n.toFixed(1)).join(',')).join(' ')}" fill="#e5e7eb" stroke="#374151" stroke-width="1.2"/></svg>`;
}

function rendereTabelle() {
  const tbody = document.getElementById('pos-tabelle');
  tbody.innerHTML = aktPositionen.map((p, i) => {
    const lFehlt = !p.laenge || p.laenge === 0;
    const kgVal = (p.kg != null && p.kg > 0) ? p.kg : '';
    return `
    <tr data-idx="${i}" class="${lFehlt ? 'bg-amber-50' : 'hover:bg-slate-50'}">
      <td class="px-3 py-1.5"><input class="pos-input text-xs font-mono text-slate-400" value="${esc(p.pos)}"></td>
      <td class="px-3 py-1.5"><input class="pos-input w-16 text-center" type="number" min="1" value="${p.menge}"></td>
      <td class="px-3 py-1.5"><input class="pos-input font-semibold text-slate-800" value="${esc(p.profil)}"></td>
      <td class="px-3 py-1.5">
        <input class="pos-input w-24 text-right ${lFehlt ? 'text-amber-600 font-semibold' : ''}"
          type="number" min="0" value="${p.laenge || ''}" placeholder="${lFehlt ? '✏ eintragen' : ''}">
      </td>
      <td class="px-3 py-1.5">
        <input class="pos-input w-16 text-right text-emerald-700" type="number" min="0" step="0.1"
          value="${kgVal}" placeholder="–" title="Ungefähres Gewicht 1 Stück (kg)">
      </td>
      <td class="px-3 py-1.5"><input class="pos-input w-28 text-xs font-semibold text-indigo-600" value="${esc(p.winkel || '')}" placeholder="z.B. 35°"
        oninput="this.closest('tr').querySelector('.skizze').innerHTML = schnittSvg(this.value)"></td>
      <td class="px-3 py-1.5"><span class="skizze">${schnittSvg(p.winkel)}</span></td>
      <td class="px-3 py-1.5"><input class="pos-input text-slate-500 text-xs" value="${esc(p.bemerk)}"></td>
      <td class="px-3 py-1.5 text-right">
        <button onclick="posLoeschen(${i})" class="text-red-400 hover:text-red-600 text-xs px-2 py-1 rounded hover:bg-red-50">🗑️</button>
      </td>
    </tr>`;
  }).join('');
}

// ── Hilfsfunktionen ──────────────────────────────────────────
function kachel(label, wert, einheit) {
  return `<div class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-3 text-center">
    <p class="text-xs text-slate-500">${label}</p>
    <p class="text-xl font-bold text-slate-800 mt-1">${wert}<span class="text-sm font-normal text-slate-500 ml-1">${einheit}</span></p>
  </div>`;
}
function mm(n)  { return Number(n).toLocaleString('de-DE'); }
function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function zeigeFehler(msg) {
  const box = document.getElementById('fehler-box');
  box.textContent = '⚠ ' + msg;
  box.classList.remove('hidden');
}
function zeigeLoading(txt) {
  document.getElementById('loading-text').textContent = txt || 'Wird verarbeitet…';
  document.getElementById('loading').classList.remove('hidden');
}
function versteckeLoading() { document.getElementById('loading').classList.add('hidden'); }
function verstecke(id)      { document.getElementById(id).classList.add('hidden'); }

function zeigeBeispiel() { document.getElementById('beispiel-csv').classList.toggle('hidden'); }

function downloadBeispielCsv() {
  const inhalt = `Pos;Menge;Profil;Länge;Bemerkung\n1;3;IPE 200;2450;Unterzug\n2;5;IPE 200;1800;Querträger\n3;2;HEB 160;3200;Hauptträger\n4;4;ROR 60x60x3;950;Stütze\n5;6;ROR 60x60x3;600;Rahmenriegel`;
  const blob = new Blob([inhalt], { type: 'text/csv;charset=utf-8;' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href = url; a.download = 'schnittliste-beispiel.csv'; a.click();
  URL.revokeObjectURL(url);
}

// ── Speichern / Laden ────────────────────────────────────────
function fmtDatum(d) {
  if (!d) return '';
  try {
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return String(d).slice(0, 16);
    return dt.toLocaleString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  } catch (_) { return ''; }
}

async function ladeProjekte(force) {
  if (!force && aktProjekteCache && aktProjekteCache.length > 0) return aktProjekteCache;
  try {
    const res = await fetch('/schnittliste/api/projects');
    const data = await res.json();
    if (!data.ok) {
      console.warn('Projekte API:', data.fehler);
      aktProjekteCache = [];
      return [];
    }
    aktProjekteCache = data.projects || [];
    return aktProjekteCache;
  } catch (e) {
    console.warn('Projekte laden:', e.message);
    aktProjekteCache = null; // nicht cachen – nächster Versuch erneut
    return [];
  }
}

async function ladeGespeicherte() {
  const box = document.getElementById('gespeichert-liste');
  box.innerHTML = '<span class="text-slate-400">Lade…</span>';
  try {
    const res = await fetch('/schnittliste/api/list');
    const data = await res.json();
    if (!data.ok) { box.innerHTML = '<span class="text-red-500">' + esc(data.fehler || 'Fehler') + '</span>'; return; }
    if (!data.listen || data.listen.length === 0) {
      box.innerHTML = '<span class="text-slate-400">Noch keine Schnittlisten gespeichert.</span>';
      return;
    }
    box.innerHTML = `
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="text-xs text-slate-500 uppercase border-b">
            <tr>
              <th class="py-2 pr-3">Name</th>
              <th class="py-2 pr-3 hidden sm:table-cell">Auftrag</th>
              <th class="py-2 pr-3">Pos.</th>
              <th class="py-2 pr-3 hidden md:table-cell">Datum</th>
              <th class="py-2 text-right">Aktion</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            ${data.listen.map(l => `
              <tr class="hover:bg-slate-50">
                <td class="py-2 pr-3 font-medium text-slate-800">${esc(l.name)}
                  <span class="text-xs text-slate-400 ml-1">${l.quelle === 'bild' ? '📷' : '📂'}</span>
                </td>
                <td class="py-2 pr-3 text-slate-600 text-xs hidden sm:table-cell">${l.project_title ? esc(l.project_title) : '<span class="text-slate-300">–</span>'}</td>
                <td class="py-2 pr-3 text-slate-600">${l.anzahl}</td>
                <td class="py-2 pr-3 text-slate-500 text-xs hidden md:table-cell">${fmtDatum(l.updated_at || l.created_at)}</td>
                <td class="py-2 text-right whitespace-nowrap">
                  <button type="button" onclick="schnittlisteLaden(${l.id})"
                    class="text-xs text-blue-600 hover:underline mr-2">Laden</button>
                  <button type="button" onclick="schnittlisteLoeschen(${l.id}, '${esc(l.name).replace(/'/g, "\\'")}')"
                    class="text-xs text-red-500 hover:underline">Löschen</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>`;
  } catch (e) {
    box.innerHTML = '<span class="text-red-500">Netzwerkfehler: ' + esc(e.message) + '</span>';
  }
}

async function schnittlisteSpeichern() {
  leseTabelle();
  if (!aktPositionen.length) { alert('Keine Positionen zum Speichern.'); return; }

  const projekte = await ladeProjekte(true);
  const vorschlag = aktGespeichertName || ('Schnittliste ' + new Date().toLocaleDateString('de-DE'));
  const projektOpts = projekte.length
    ? projekte.map(p => `<option value="${p.id}" ${Number(aktProjectId) === Number(p.id) ? 'selected' : ''}>${esc(p.title || ('Auftrag #' + p.id))}${p.status ? ' (' + esc(p.status) + ')' : ''}</option>`).join('')
    : '';

  // Einfacher Dialog: Name + Auftrag
  const overlay = document.createElement('div');
  overlay.id = 'sl-save-modal';
  overlay.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4';
  overlay.innerHTML = `
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md p-5 space-y-4">
      <h3 class="text-base font-bold text-slate-800">Schnittliste speichern</h3>
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Name</label>
        <input id="sl-save-name" type="text" value="${esc(vorschlag)}"
          class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Auftrag zuweisen (optional)</label>
        <select id="sl-save-project" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-blue-500">
          <option value="">– kein Auftrag –</option>
          ${projektOpts}
        </select>
        ${projekte.length === 0 ? '<p class="text-xs text-amber-600 mt-1">Keine offenen Aufträge gefunden. Prüfe unter Aufträge, ob welche angelegt sind.</p>' : ''}
      </div>
      <div class="flex justify-end gap-2 pt-1">
        <button type="button" id="sl-save-cancel" class="text-sm px-4 py-2 rounded-lg text-slate-600 hover:bg-slate-100">Abbrechen</button>
        <button type="button" id="sl-save-ok" class="text-sm px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold">Speichern</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  document.getElementById('sl-save-name').focus();
  document.getElementById('sl-save-name').select();

  const close = () => { overlay.remove(); };
  document.getElementById('sl-save-cancel').onclick = close;
  overlay.addEventListener('click', e => { if (e.target === overlay) close(); });

  document.getElementById('sl-save-ok').onclick = async () => {
    const name = document.getElementById('sl-save-name').value.trim();
    const projectId = parseInt(document.getElementById('sl-save-project').value, 10) || null;
    if (!name) { alert('Bitte einen Namen eingeben.'); return; }

    const payload = {
      name,
      positionen: aktPositionen,
      stangenlaenge: parseInt(
        (aktQuelle === 'bild'
          ? document.getElementById('stangenlaenge-bild')
          : document.getElementById('stangenlaenge')
        ).value, 10) || aktStange,
      saege: leseSaege(),
      quelle: aktQuelle,
      project_id: projectId
    };
    if (aktGespeichertId && aktGespeichertName === name) {
      payload.id = aktGespeichertId;
    } else if (aktGespeichertId) {
      const ueberschreiben = confirm(
        'Aktuelle Liste ist mit „' + aktGespeichertName + '“ verknüpft.\n\nOK = unter neuem Namen speichern\nAbbrechen = bestehende überschreiben'
      );
      if (!ueberschreiben) payload.id = aktGespeichertId;
    }

    try {
      const res = await fetch('/schnittliste/api/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!data.ok) { alert(data.fehler || 'Speichern fehlgeschlagen.'); return; }
      aktGespeichertId = data.id;
      aktGespeichertName = data.name;
      aktProjectId = data.project_id || projectId;
      close();
      const auftragTxt = projectId
        ? (projekte.find(p => Number(p.id) === Number(projectId)) || {}).title || 'Auftrag'
        : null;
      alert('Gespeichert: „' + data.name + '“ (' + data.anzahl + ' Positionen)' +
        (auftragTxt ? '\nAuftrag: ' + auftragTxt : ''));
      ladeGespeicherte();
    } catch (e) {
      alert('Netzwerkfehler: ' + e.message);
    }
  };
}

async function schnittlisteLaden(id) {
  try {
    zeigeLoading('Schnittliste wird geladen…');
    const res = await fetch('/schnittliste/api/' + id);
    const data = await res.json();
    versteckeLoading();
    if (!data.ok) { zeigeFehler(data.fehler || 'Laden fehlgeschlagen.'); return; }
    aktPositionen = data.positionen || [];
    aktGruppen = data.gruppen || [];
    aktStange = data.stangenlaenge || 6000;
    aktQuelle = data.quelle === 'bild' ? 'bild' : 'datei';
    aktGespeichertId = data.id;
    aktGespeichertName = data.name || '';
    aktProjectId = data.project_id || null;
    const el1 = document.getElementById('stangenlaenge');
    const el2 = document.getElementById('stangenlaenge-bild');
    if (el1) el1.value = aktStange;
    if (el2) el2.value = aktStange;
    if (typeof data.saege === 'number') {
      const s1 = document.getElementById('saege');
      const s2 = document.getElementById('saege-bild');
      if (s1) s1.value = data.saege;
      if (s2) s2.value = data.saege;
    }
    wechsleTab(aktQuelle);
    rendereErgebnis();
    document.getElementById('btn-pdf').disabled = false;
    document.getElementById('btn-pdf-bild').disabled = false;
    const hinweis = document.getElementById('ki-hinweis');
    if (hinweis) {
      document.getElementById('ki-anzahl').textContent = aktPositionen.length;
      hinweis.classList.remove('hidden');
    }
  } catch (e) {
    versteckeLoading();
    zeigeFehler('Netzwerkfehler: ' + e.message);
  }
}

async function schnittlisteLoeschen(id, name) {
  if (!confirm('Schnittliste „' + (name || id) + '“ wirklich löschen?')) return;
  try {
    const res = await fetch('/schnittliste/api/' + id, { method: 'DELETE' });
    const data = await res.json();
    if (!data.ok) { alert(data.fehler || 'Löschen fehlgeschlagen.'); return; }
    if (aktGespeichertId === id) {
      aktGespeichertId = null;
      aktGespeichertName = '';
      aktProjectId = null;
    }
    ladeGespeicherte();
  } catch (e) {
    alert('Netzwerkfehler: ' + e.message);
  }
}

document.addEventListener('DOMContentLoaded', () => { ladeGespeicherte(); });
</script>

</body>
