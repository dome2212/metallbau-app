<%- include('partials/header') %>

<div class="flex h-screen bg-slate-100 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 min-h-screen pt-16 md:pt-6">

    <!-- ── Seitenkopf ─────────────────────────────────────── -->
    <header class="bg-white shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-2 mb-6">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800">✂️ Automatische Schnittliste</h1>
        <p class="text-sm text-slate-500 mt-0.5">CSV- oder XLSX-Datei hochladen → optimierte Aufteilung auf Stangenlängen + PDF</p>
      </div>
    </header>

    <div class="px-4 md:px-6 max-w-5xl mx-auto w-full space-y-6 pb-10">

      <!-- ── Upload-Formular ───────────────────────────────── -->
      <div class="bg-white rounded-xl shadow p-4 md:p-6 space-y-5">
        <h2 class="text-base font-semibold text-slate-800">📂 Datei hochladen</h2>

        <!-- Hinweis zum Dateiformat -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg px-4 py-3 text-sm text-blue-800 space-y-1">
          <p class="font-semibold">Erwartetes Format (CSV oder XLSX):</p>
          <p>Pflichtfelder: <code class="bg-blue-100 px-1 rounded">Menge</code> (oder „Anz"), <code class="bg-blue-100 px-1 rounded">Profil</code> (oder „Material"), <code class="bg-blue-100 px-1 rounded">Länge</code> (Wert in mm)</p>
          <p>Optional: <code class="bg-blue-100 px-1 rounded">Pos</code>, <code class="bg-blue-100 px-1 rounded">Bemerkung</code></p>
          <p class="text-xs text-blue-600 mt-1">Spaltenreihenfolge egal · CSV: Semikolon oder Komma · XLSX: erste Zeile = Kopfzeile</p>
          <button type="button" onclick="zeigeBeispiel()" class="text-xs text-blue-700 underline mt-1">Beispiel-CSV anzeigen</button>
        </div>

        <!-- Beispiel-CSV (versteckt) -->
        <div id="beispiel-csv" class="hidden bg-slate-50 border border-slate-200 rounded-lg p-3">
          <p class="text-xs font-semibold text-slate-600 mb-2">Beispiel-CSV (Inhalt kopieren → als .csv speichern):</p>
          <pre class="text-xs text-slate-700 leading-relaxed whitespace-pre-wrap">Pos;Menge;Profil;Länge;Bemerkung
1;3;IPE 200;2450;Unterzug
2;5;IPE 200;1800;Querträger
3;2;HEB 160;3200;Hauptträger
4;4;ROR 60x60x3;950;Stütze
5;6;ROR 60x60x3;600;Rahmenriegel
6;1;HEB 160;4100;Sondermaß</pre>
          <button type="button" onclick="downloadBeispielCsv()" class="mt-2 text-xs text-blue-600 hover:underline">⬇ Beispiel-CSV herunterladen</button>
        </div>

        <!-- Eingabefelder -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">CSV- oder XLSX-Datei</label>
            <input type="file" id="datei-input" accept=".csv,.txt,.xlsx"
              class="w-full border border-slate-300 rounded-lg p-2 text-sm bg-white focus:ring-2 focus:ring-blue-500"
              onchange="onDateiGewaehlt(this)">
            <p id="datei-name" class="mt-1 text-xs text-slate-400"></p>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Stangenlänge (mm)</label>
            <input type="number" id="stangenlaenge" value="6000" min="100" max="20000" step="100"
              class="w-full border border-slate-300 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
            <p class="mt-1 text-xs text-slate-400">Standard: 6000 mm (6 m)</p>
          </div>
        </div>

        <!-- Aktions-Buttons -->
        <div class="flex flex-wrap gap-3 pt-1 border-t border-slate-100">
          <button onclick="berechnen()"
            class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 7H6a2 2 0 00-2 2v9a2 2 0 002 2h9a2 2 0 002-2v-3M9 7V5a2 2 0 012-2h2M9 7h6m0 0V5a2 2 0 012 2v2m0 0h2a2 2 0 012 2v3"/></svg>
            Schnittliste berechnen
          </button>
          <button id="btn-pdf" onclick="pdfHerunterladen()" disabled
            class="bg-slate-700 hover:bg-slate-800 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition flex items-center gap-2">
            🖨️ PDF herunterladen
          </button>
        </div>

        <!-- Fehleranzeige -->
        <div id="fehler-box" class="hidden bg-red-50 border border-red-300 rounded-lg px-4 py-3 text-sm text-red-700"></div>

        <!-- Lade-Indikator -->
        <div id="loading" class="hidden text-sm text-slate-500 flex items-center gap-2">
          <svg class="animate-spin w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
          </svg>
          Datei wird analysiert…
        </div>
      </div>

      <!-- ── Ergebnis-Bereich ──────────────────────────────── -->
      <div id="ergebnis" class="hidden space-y-5">

        <!-- Zusammenfassung -->
        <div id="zusammenfassung" class="bg-white rounded-xl shadow p-4 md:p-5"></div>

        <!-- Positionstabelle -->
        <div class="bg-white rounded-xl shadow overflow-hidden">
          <div class="px-4 md:px-5 py-3 border-b border-slate-200">
            <h2 class="text-sm font-semibold text-slate-800">📋 Erkannte Positionen</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left min-w-[500px]">
              <thead class="bg-slate-50 text-slate-500 text-xs uppercase border-b">
                <tr>
                  <th class="px-4 py-2">Pos</th>
                  <th class="px-4 py-2">Menge</th>
                  <th class="px-4 py-2">Profil</th>
                  <th class="px-4 py-2">Länge</th>
                  <th class="px-4 py-2">Bemerkung</th>
                </tr>
              </thead>
              <tbody id="pos-tabelle" class="divide-y divide-slate-100 text-slate-700"></tbody>
            </table>
          </div>
        </div>

        <!-- Optimierungsergebnis pro Profil -->
        <div id="profil-karten" class="space-y-4"></div>

      </div><!-- /#ergebnis -->

    </div>
  </main>
</div>

<!-- ── verstecktes PDF-Formular ─────────────────────────────── -->
<form id="pdf-form" method="POST" action="/schnittliste/pdf" enctype="multipart/form-data" class="hidden">
  <input type="hidden" name="stangenlaenge" id="pdf-stangenlaenge">
  <input type="hidden" name="firma_name" value="<%= currentUser ? currentUser.username : '' %>">
  <!-- Die Datei wird per JS eingefügt -->
</form>

<script>
'use strict';

let letztePositionen = null;
let letzteGruppen    = null;
let aktDatei         = null;

function onDateiGewaehlt(inp) {
  aktDatei = inp.files[0] || null;
  document.getElementById('datei-name').textContent = aktDatei ? aktDatei.name : '';
  // Ergebnis zurücksetzen
  document.getElementById('ergebnis').classList.add('hidden');
  document.getElementById('btn-pdf').disabled = true;
  verstecke('fehler-box');
}

function zeigeBeispiel() {
  const box = document.getElementById('beispiel-csv');
  box.classList.toggle('hidden');
}

function downloadBeispielCsv() {
  const inhalt = `Pos;Menge;Profil;Länge;Bemerkung\n1;3;IPE 200;2450;Unterzug\n2;5;IPE 200;1800;Querträger\n3;2;HEB 160;3200;Hauptträger\n4;4;ROR 60x60x3;950;Stütze\n5;6;ROR 60x60x3;600;Rahmenriegel\n6;1;HEB 160;4100;Sondermaß`;
  const blob = new Blob([inhalt], { type: 'text/csv;charset=utf-8;' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href = url; a.download = 'schnittliste-beispiel.csv'; a.click();
  URL.revokeObjectURL(url);
}

async function berechnen() {
  verstecke('fehler-box');
  verstecke('ergebnis');
  document.getElementById('btn-pdf').disabled = true;

  if (!aktDatei) { zeigeFehler('Bitte zuerst eine Datei auswählen.'); return; }
  const stangenlaenge = parseInt(document.getElementById('stangenlaenge').value, 10);
  if (!stangenlaenge || stangenlaenge < 100) { zeigeFehler('Ungültige Stangenlänge.'); return; }

  document.getElementById('loading').classList.remove('hidden');

  const fd = new FormData();
  fd.append('datei', aktDatei);
  fd.append('stangenlaenge', stangenlaenge);

  try {
    const res  = await fetch('/schnittliste/upload', { method: 'POST', body: fd });
    const data = await res.json();
    document.getElementById('loading').classList.add('hidden');
    if (!data.ok) { zeigeFehler(data.fehler || 'Unbekannter Fehler.'); return; }
    letztePositionen = data.positionen;
    letzteGruppen    = data.gruppen;
    rendereErgebnis(data.positionen, data.gruppen, data.stangenlaenge);
    document.getElementById('btn-pdf').disabled = false;
  } catch (e) {
    document.getElementById('loading').classList.add('hidden');
    zeigeFehler('Netzwerkfehler: ' + e.message);
  }
}

// ── PDF via verstecktem Formular mit aktueller Datei ─────────
function pdfHerunterladen() {
  if (!aktDatei) return;
  const sl = document.getElementById('stangenlaenge').value;
  document.getElementById('pdf-stangenlaenge').value = sl;

  const form = document.getElementById('pdf-form');
  // Altes Datei-Input entfernen (falls vorhanden)
  const old = form.querySelector('input[name="datei"]');
  if (old) old.remove();

  // DataTransfer-Trick: neues File-Input mit der gespeicherten Datei befüllen
  const fi = document.createElement('input');
  fi.type = 'file'; fi.name = 'datei'; fi.style.display = 'none';
  form.appendChild(fi);

  const dt = new DataTransfer();
  dt.items.add(aktDatei);
  fi.files = dt.files;

  form.submit();
}

// ── Ergebnis rendern ─────────────────────────────────────────
function rendereErgebnis(positionen, gruppen, stangenlaenge) {
  // Zusammenfassung
  const gesamtStangen = gruppen.reduce((s, g) => s + g.stangenzahl, 0);
  const avgAusnutzung = gruppen.length
    ? Math.round(gruppen.reduce((s,g)=>s+g.ausnutzung,0) / gruppen.length) : 0;
  const gesamtVerschnitt = gruppen.reduce((s,g)=>s+g.verschnittGes,0);

  document.getElementById('zusammenfassung').innerHTML = `
    <h2 class="text-sm font-semibold text-slate-700 mb-3">📊 Zusammenfassung</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      ${kachel('Positionen', positionen.length, '')}
      ${kachel('Stangen gesamt', gesamtStangen, 'Stk')}
      ${kachel('Ø Ausnutzung', avgAusnutzung, '%')}
      ${kachel('Gesamtverschnitt', mm(gesamtVerschnitt), 'mm')}
    </div>`;

  // Positionstabelle
  const tbody = document.getElementById('pos-tabelle');
  tbody.innerHTML = positionen.map(p => `
    <tr class="hover:bg-slate-50">
      <td class="px-4 py-2 text-xs text-slate-400 font-mono">${esc(p.pos)}</td>
      <td class="px-4 py-2">${p.menge}</td>
      <td class="px-4 py-2 font-semibold text-slate-800">${esc(p.profil)}</td>
      <td class="px-4 py-2">${mm(p.laenge)} mm</td>
      <td class="px-4 py-2 text-slate-500 text-xs">${esc(p.bemerk) || '–'}</td>
    </tr>`).join('');

  // Profil-Karten
  const container = document.getElementById('profil-karten');
  const FARBEN = ['#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6'];
  container.innerHTML = gruppen.map(g => {
    const stDetails = g.stangen.map((st, si) => {
      const label = st.uebermas ? 'Übermaß' : `Stange ${si+1}`;
      // Balkenvisualisierung
      const balken = st.teile.map((t, ti) => {
        const pct = st.uebermas ? 100 : Math.max(1, Math.round((t.laenge / stangenlaenge) * 100));
        const farbe = FARBEN[ti % FARBEN.length];
        return `<div title="Pos ${esc(t.pos)}: ${mm(t.laenge)} mm"
          style="width:${pct}%;background:${farbe};height:100%;display:inline-block;vertical-align:top;"></div>`;
      }).join('');
      const restPct = st.uebermas ? 0 : Math.round((st.rest / stangenlaenge) * 100);
      const restBalken = restPct > 0
        ? `<div style="width:${restPct}%;background:#e5e7eb;height:100%;display:inline-block;vertical-align:top;" title="Verschnitt: ${mm(st.rest)} mm"></div>` : '';
      const teileListe = st.teile.map(t => `<span class="inline-block bg-slate-100 text-slate-600 text-xs px-1.5 py-0.5 rounded mr-1 mb-1">Pos ${esc(t.pos)}: ${mm(t.laenge)} mm</span>`).join('');
      return `
        <div class="border border-slate-200 rounded-lg p-3 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-600">${label}</span>
            ${st.uebermas ? '<span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded font-medium">⚠ Übermaß</span>' :
              `<span class="text-xs text-slate-400">Rest: ${mm(st.rest)} mm</span>`}
          </div>
          <div style="height:14px;width:100%;background:#f1f5f9;border-radius:4px;overflow:hidden;">
            ${balken}${restBalken}
          </div>
          <div class="pt-1">${teileListe}</div>
        </div>`;
    }).join('');

    return `
      <div class="bg-white rounded-xl shadow overflow-hidden">
        <div class="px-4 md:px-5 py-3 bg-blue-50 border-b border-blue-100 flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-sm font-bold text-blue-800">${esc(g.profil)}</h3>
          <div class="flex flex-wrap gap-3 text-xs text-blue-700">
            <span>📦 ${g.stangenzahl} Stange(n)</span>
            <span>📏 Gesamtlänge: ${mm(g.gesamtLaenge)} mm</span>
            <span class="font-semibold ${g.ausnutzung >= 80 ? 'text-green-700' : g.ausnutzung >= 60 ? 'text-amber-700' : 'text-red-700'}">
              Ausnutzung: ${g.ausnutzung} %
            </span>
            <span>Verschnitt: ${mm(g.verschnittGes)} mm</span>
          </div>
        </div>
        <div class="p-4 space-y-3">${stDetails}</div>
      </div>`;
  }).join('');

  document.getElementById('ergebnis').classList.remove('hidden');
}

// ── Hilfsfunktionen ──────────────────────────────────────────
function kachel(label, wert, einheit) {
  return `<div class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-3 text-center">
    <p class="text-xs text-slate-500">${label}</p>
    <p class="text-xl font-bold text-slate-800 mt-1">${wert}<span class="text-sm font-normal text-slate-500 ml-1">${einheit}</span></p>
  </div>`;
}
function mm(n)  { return Number(n).toLocaleString('de-DE'); }
function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function zeigeFehler(msg) {
  const box = document.getElementById('fehler-box');
  box.textContent = '⚠ ' + msg;
  box.classList.remove('hidden');
}
function verstecke(id) { document.getElementById(id).classList.add('hidden'); }
</script>

</body>
</html>
