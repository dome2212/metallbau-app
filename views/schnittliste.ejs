  <input type="hidden" name="stangenlaenge" id="bestell-stangenlaenge">
  <input type="hidden" name="saege" id="bestell-saege">
  <input type="hidden" name="firma_name" value="<%= currentUser ? currentUser.username : '' %>">
  <input type="hidden" name="project_name" id="bestell-project-name" value="">
</form>
<form id="pdf-angebot-form" method="POST" action="/schnittliste/pdf/angebot" enctype="multipart/form-data" class="hidden">
  <input type="hidden" name="firma_name" value="<%= currentUser ? currentUser.username : '' %>">
  <input type="hidden" name="project_name" id="angebot-project-name" value="">
  <input type="hidden" name="stahl_preis" id="angebot-stahl-hidden">
  <input type="hidden" name="stunden" id="angebot-stunden-hidden">
  <input type="hidden" name="stundensatz" id="angebot-stundensatz-hidden">
</form>

<style>
  .tab-aktiv   { background:#1e40af; color:#fff; }
  .tab-inaktiv { background:transparent; color:#475569; }
  .tab-inaktiv:hover { background:#f1f5f9; }
  .pos-input { border:none; outline:none; background:transparent; width:100%; padding:2px 4px; border-radius:4px; }
  .pos-input:focus { background:#eff6ff; }
</style>

<script>
'use strict';

// ── Zustand ──────────────────────────────────────────────────
let aktDatei        = null;  // CSV/XLSX
let aktBilder       = [];    // Bilddateien (max. 4)
const MAX_BILDER    = 4;
let aktPositionen   = [];
let aktGruppen      = [];
let aktStange       = 6000;
let aktQuelle       = 'datei'; // 'datei' | 'bild'
let aktGespeichertId = null;   // ID wenn aus DB geladen / zuletzt gespeichert
let aktGespeichertName = '';
let aktProjectId = null;       // zugeordneter Auftrag
let aktProjectTitle = '';      // Auftragsname für PDF / Anzeige
let aktProjekteCache = null;

function leseSaege() {
  const el = document.getElementById(aktQuelle === 'bild' ? 'saege-bild' : 'saege');
  const v = parseFloat(String(el && el.value).replace(',', '.'));
  return Number.isFinite(v) && v >= 0 ? v : 3;
}

// ── Tab-Wechsel ──────────────────────────────────────────────
function wechsleTab(tab) {
  aktQuelle = tab;
  document.getElementById('panel-datei').classList.toggle('hidden', tab !== 'datei');
  document.getElementById('panel-bild').classList.toggle('hidden',  tab !== 'bild');
  document.getElementById('tab-datei').className =
    'flex-1 text-sm font-semibold py-2 px-4 rounded-lg transition ' + (tab === 'datei' ? 'tab-aktiv' : 'tab-inaktiv');
  document.getElementById('tab-bild').className =
    'flex-1 text-sm font-semibold py-2 px-4 rounded-lg transition ' + (tab === 'bild' ? 'tab-aktiv' : 'tab-inaktiv');
  verstecke('ergebnis'); verstecke('fehler-box');
}

// ── Datei-Tab ────────────────────────────────────────────────
function onDateiGewaehlt(inp) {
  aktDatei = inp.files[0] || null;
  document.getElementById('datei-name').textContent = aktDatei ? aktDatei.name : '';
  verstecke('ergebnis'); verstecke('fehler-box');
  document.getElementById('btn-pdf').disabled = true;
}

async function berechnen() {
  verstecke('fehler-box'); verstecke('ergebnis');
  document.getElementById('btn-pdf').disabled = true;
  if (!aktDatei) { zeigeFehler('Bitte zuerst eine Datei auswählen.'); return; }
  leseMetaVoranalyse();
  const sl = parseInt(document.getElementById('stangenlaenge').value, 10);
  if (!sl || sl < 100) { zeigeFehler('Ungültige Stangenlänge.'); return; }

  zeigeLoading('Datei wird analysiert…');
  const fd = new FormData();
  fd.append('datei', aktDatei);
  fd.append('stangenlaenge', sl);
  fd.append('saege', leseSaege());
  try {
    const res  = await fetch('/schnittliste/upload', { method: 'POST', body: fd });
    const data = await res.json();
    versteckeLoading();
    if (!data.ok) { zeigeFehler(data.fehler || 'Unbekannter Fehler.'); return; }
    aktPositionen = data.positionen;
    aktGruppen    = data.gruppen;
    aktStange     = data.stangenlaenge;
    verstecke('ki-hinweis');
    rendereErgebnis();
    document.getElementById('btn-pdf').disabled = false;
  } catch (e) { versteckeLoading(); zeigeFehler('Netzwerkfehler: ' + e.message); }
}

// ── Bild-Tab ─────────────────────────────────────────────────
function onBildGewaehlt(inp) {
  bilderHinzufuegen(Array.from(inp.files || []));
  inp.value = '';
}

function onDragOver(e)  { e.preventDefault(); document.getElementById('drop-zone').classList.add('border-blue-400','bg-blue-50'); }
function onDragLeave(e) { document.getElementById('drop-zone').classList.remove('border-blue-400','bg-blue-50'); }
function onDrop(e) {
  e.preventDefault();
  onDragLeave(e);
  bilderHinzufuegen(Array.from(e.dataTransfer.files || []));
}

function bilderHinzufuegen(files) {
  const bilder = files.filter(f => f.type.startsWith('image/'));
  if (bilder.length < files.length) zeigeFehler('Nur Bilddateien (JPG, PNG, WebP) erlaubt.'); else verstecke('fehler-box');
  for (const f of bilder) {
    if (aktBilder.length >= MAX_BILDER) { zeigeFehler(`Maximal ${MAX_BILDER} Bilder gleichzeitig.`); break; }
    aktBilder.push(f);
  }
  rendereVorschau();
  document.getElementById('btn-pdf-bild').disabled = true;
  verstecke('ergebnis');
}

function bildEntfernen(i, ev) {
  ev.stopPropagation();
  aktBilder.splice(i, 1);
  rendereVorschau();
}

function rendereVorschau() {
  const liste = document.getElementById('bild-vorschau-liste');
  document.getElementById('btn-bild-analyse').disabled = aktBilder.length === 0;
  document.getElementById('drop-inhalt').classList.toggle('hidden', aktBilder.length > 0);
  liste.classList.toggle('hidden', aktBilder.length === 0);
  document.getElementById('bild-mehr').classList.toggle('hidden', aktBilder.length === 0 || aktBilder.length >= MAX_BILDER);
  liste.innerHTML = '';
  aktBilder.forEach((file, i) => {
    const box = document.createElement('div');
    box.className = 'relative';
    const img = document.createElement('img');
    img.className = 'max-h-40 max-w-[45vw] rounded-lg shadow border border-slate-200';
    img.src = URL.createObjectURL(file);
    img.onload = () => URL.revokeObjectURL(img.src);
    const x = document.createElement('button');
    x.type = 'button';
    x.textContent = '✕';
    x.title = 'Bild entfernen';
    x.className = 'absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 text-xs shadow';
    x.onclick = ev => bildEntfernen(i, ev);
    const nr = document.createElement('span');
    nr.textContent = String(i + 1);
    nr.className = 'absolute bottom-1 left-1 bg-slate-800/80 text-white text-xs rounded px-1.5';
    box.append(img, x, nr);
    liste.appendChild(box);
  });
}

// Bild verkleinern (max. 2200 px lange Seite, JPEG) – hält die Anfrage klein und schnell
function bildVerkleinern(file) {
  return new Promise(resolve => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      const max = 2200, f = Math.min(1, max / Math.max(img.width, img.height));
      if (f >= 1 && file.size < 3 * 1024 * 1024) return resolve(file);
      const c = document.createElement('canvas');
      c.width = Math.round(img.width * f); c.height = Math.round(img.height * f);
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
      ctx.drawImage(img, 0, 0, c.width, c.height);
      c.toBlob(b => resolve(b ? new File([b], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' }) : file), 'image/jpeg', 0.88);
    };
    img.onerror = () => { URL.revokeObjectURL(url); resolve(file); };
    img.src = url;
  });
}

async function bildAnalysieren() {
  verstecke('fehler-box'); verstecke('ergebnis');
  document.getElementById('btn-pdf-bild').disabled = true;
  if (aktBilder.length === 0) { zeigeFehler('Kein Bild ausgewählt.'); return; }
  leseMetaVoranalyse();
  const sl = parseInt(document.getElementById('stangenlaenge-bild').value, 10) || 6000;

  zeigeLoading(aktBilder.length > 1 ? `KI analysiert ${aktBilder.length} Bilder — das kann einige Sekunden dauern…` : 'KI analysiert das Bild — das kann einige Sekunden dauern…');
  const fd = new FormData();
  for (const f of aktBilder) fd.append('bild', await bildVerkleinern(f));
  fd.append('stangenlaenge', sl);
  fd.append('saege', leseSaege());
  try {
    const res  = await fetch('/schnittliste/bild', { method: 'POST', body: fd });
    const data = await res.json();
    versteckeLoading();
    if (!data.ok) { zeigeFehler(data.fehler || 'KI konnte keine Positionen erkennen.'); return; }
    aktPositionen = data.positionen;
    aktGruppen    = data.gruppen;
    aktStange     = data.stangenlaenge;
    const hinweis = document.getElementById('ki-hinweis');
    document.getElementById('ki-anzahl').textContent = aktPositionen.length;
    hinweis.classList.remove('hidden');
    rendereErgebnis();
    document.getElementById('btn-pdf-bild').disabled = false;
  } catch (e) { versteckeLoading(); zeigeFehler('Netzwerkfehler: ' + e.message); }
}

// ── Editierbare Tabelle ──────────────────────────────────────
function posHinzufuegen() {
  aktPositionen.push({ pos: String(aktPositionen.length + 1), menge: 1, profil: '', laenge: 0, kg: 0, bemerk: '', winkel: '' });
  rendereTabelle();
}

function posLoeschen(idx) {
  aktPositionen.splice(idx, 1);
  rendereTabelle();
}

function leseTabelle() {
  // Aktuelle Werte aus den Input-Feldern lesen
  // Reihenfolge: pos, menge, profil, laenge, kg, winkel, bemerk
  const rows = document.querySelectorAll('#pos-tabelle tr[data-idx]');
  aktPositionen = [];
  rows.forEach(row => {
    const inps = row.querySelectorAll('.pos-input');
    aktPositionen.push({
      pos:    inps[0].value.trim() || String(aktPositionen.length + 1),
      menge:  Math.max(1, parseInt(inps[1].value, 10) || 1),
      profil: inps[2].value.trim(),
      laenge: Math.round(parseFloat(inps[3].value) || 0),
      kg:     Math.max(0, Math.round((parseFloat(inps[4].value) || 0) * 10) / 10),
      winkel: inps[5].value.trim(),
      bemerk: inps[6].value.trim()
    });
  });
}

function neuBerechnen() {
  leseTabelle();
  const sl = parseInt(
    (aktQuelle === 'bild'
      ? document.getElementById('stangenlaenge-bild')
      : document.getElementById('stangenlaenge')
    ).value, 10) || aktStange;
  fetch('/schnittliste/api/optimieren', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      positionen: aktPositionen,
      stangenlaenge: sl,
      saege: leseSaege()
    })
  }).then(r => r.json()).then(data => {
    if (!data.ok) { zeigeFehler(data.fehler || 'Fehler.'); return; }
    aktPositionen = data.positionen;
    aktGruppen    = data.gruppen;
    aktStange     = data.stangenlaenge;
    aktVerwendeteReste = data.verwendeteReste || [];
    aktNeueReste = [];
    (aktGruppen || []).forEach(g => (g.neueReste || []).forEach(r => aktNeueReste.push(r)));
    rendereErgebnis();
  }).catch(e => zeigeFehler('Fehler: ' + e.message));
}

// ── PDF ──────────────────────────────────────────────────────
function baueCsvFile() {
  const csv = 'Pos;Menge;Profil;Länge;Bemerkung;Winkel;kg\n' +
    aktPositionen.map(p => `${p.pos};${p.menge};${p.profil};${p.laenge};${p.bemerk};${p.winkel || ''};${p.kg || 0}`).join('\n');
  return new File([csv], 'schnittliste.csv', { type: 'text/csv' });
}

function submitPdfForm(formId, extra) {
  leseTabelle();
  leseMetaVoranalyse();
  const form = document.getElementById(formId);
  if (!form) return;
  const old = form.querySelector('input[name="datei"]');
  if (old) old.remove();
  const fi = document.createElement('input');
  fi.type = 'file'; fi.name = 'datei'; fi.style.display = 'none';
  form.appendChild(fi);
  const dt = new DataTransfer();
  dt.items.add(baueCsvFile());
  fi.files = dt.files;
  if (extra) extra(form);
  form.submit();
}

function pdfHerunterladen() {
  const sl = parseInt(
    (aktQuelle === 'bild'
      ? document.getElementById('stangenlaenge-bild')
      : document.getElementById('stangenlaenge')
    ).value, 10) || aktStange;
  const auftragSel = document.getElementById('auftrag-select');
  if (auftragSel && auftragSel.value) onAuftragGewaehlt(auftragSel);
  submitPdfForm('pdf-form', function () {
    document.getElementById('pdf-stangenlaenge').value = sl;
    document.getElementById('pdf-saege').value = leseSaege();
    const pn = document.getElementById('pdf-project-name');
    if (pn) pn.value = aktProjectTitle || '';
  });
}

function bestelllistePdf() {
  if (!aktPositionen.length) { alert('Keine Positionen.'); return; }
  const sl = aktStange || 6000;
  submitPdfForm('pdf-bestell-form', function () {
    document.getElementById('bestell-stangenlaenge').value = sl;
    document.getElementById('bestell-saege').value = leseSaege();
    const pn = document.getElementById('bestell-project-name');
    if (pn) pn.value = aktProjectTitle || '';
  });
}

function angebotPdf() {
  if (!aktPositionen.length) { alert('Keine Positionen.'); return; }
  submitPdfForm('pdf-angebot-form', function () {
    const pn = document.getElementById('angebot-project-name');
    if (pn) pn.value = aktProjectTitle || '';
    document.getElementById('angebot-stahl-hidden').value =
      document.getElementById('angebot-stahlpreis').value || '';
    document.getElementById('angebot-stunden-hidden').value =
      document.getElementById('angebot-stunden').value || '0';
    document.getElementById('angebot-stundensatz-hidden').value =
      document.getElementById('angebot-stundensatz').value || '65';
  });
}

let aktVerwendeteReste = [];
let aktNeueReste = [];

async function mitRestenNeuOptimieren() {
  leseTabelle();
  if (!aktPositionen.length) return;
  zeigeLoading('Optimiere mit Reststücken aus dem Lager…');
  try {
    const res = await fetch('/schnittliste/api/optimieren', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        positionen: aktPositionen,
        stangenlaenge: aktStange || 6000,
        saege: leseSaege()
      })
    });
    const data = await res.json();
    versteckeLoading();
    if (!data.ok) { zeigeFehler(data.fehler || 'Optimierung fehlgeschlagen'); return; }
    aktGruppen = data.gruppen || [];
    aktVerwendeteReste = data.verwendeteReste || [];
    aktNeueReste = [];
    (aktGruppen || []).forEach(g => {
      (g.neueReste || []).forEach(r => aktNeueReste.push(r));
    });
    rendereErgebnis();
    if (typeof showToast === 'function') showToast('Mit Reststücken optimiert', 'success', 2000);
  } catch (e) {
    versteckeLoading();
    zeigeFehler('Netzwerkfehler: ' + e.message);
  }
}

async function reststueckeSpeichern() {
  // Sammle neue Reste aus Gruppen
  const items = [];
  (aktGruppen || []).forEach(g => {
    (g.neueReste || []).forEach(r => {
      if (r.laenge >= 300) items.push({ profil: r.profil || g.profil, laenge: r.laenge, vonRest: r.vonRest });
    });
  });
  if (!items.length && !aktNeueReste.length) {
    // Fallback: Verschnitt pro Stange >= 300
    (aktGruppen || []).forEach(g => {
      (g.stangen || []).forEach(st => {
        if (!st.uebermas && st.rest >= 300) {
          items.push({ profil: g.profil, laenge: Math.round(st.rest) });
        }
      });
    });
  }
  const finalItems = items.length ? items : aktNeueReste;
  if (!finalItems.length) {
    alert('Keine sinnvollen Reststücke (≥ 300 mm) gefunden.');
    return;
  }
  if (!confirm(finalItems.length + ' Reststück(e) ins Lager speichern?\n' +
      finalItems.slice(0, 8).map(r => '• ' + r.profil + ' ' + r.laenge + ' mm').join('\n') +
      (finalItems.length > 8 ? '\n…' : ''))) return;
  try {
    const used = (aktVerwendeteReste || []).map(r => r.id).filter(Boolean);
    const res = await fetch('/schnittliste/api/reststuecke/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: finalItems, used_ids: used })
    });
    const data = await res.json();
    if (!data.ok) { alert(data.fehler || 'Speichern fehlgeschlagen'); return; }
    alert('Gespeichert: ' + data.gespeichert + ' Reststück(e)' +
      (data.verbraucht ? ', ' + data.verbraucht + ' verbraucht gelöscht' : '') +
      '\n→ sichtbar unter Lager → Reststücke');
    aktVerwendeteReste = [];
  } catch (e) {
    alert('Netzwerkfehler: ' + e.message);
  }
}

// ── Render ───────────────────────────────────────────────────
function rendereErgebnis() {
  // Zusammenfassung
  const gesamtStangen    = aktGruppen.reduce((s, g) => s + g.stangenzahl, 0);
  const avgAusnutzung    = aktGruppen.length
    ? Math.round(aktGruppen.reduce((s,g)=>s+g.ausnutzung,0) / aktGruppen.length) : 0;
  const gesamtVerschnitt = aktGruppen.reduce((s,g)=>s+g.verschnittGes,0);
  const gesamtKg = aktPositionen.reduce((s, p) => s + (Number(p.kg) || 0) * (Number(p.menge) || 1), 0);
  const kgText = gesamtKg > 0 ? (Math.round(gesamtKg * 10) / 10).toLocaleString('de-DE') : '–';

  const restGenutzt = (aktVerwendeteReste || []).length;
  document.getElementById('zusammenfassung').innerHTML = `
    <h2 class="text-sm font-semibold text-slate-700 dark:text-slate-200 mb-3">📊 Zusammenfassung</h2>
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
      ${kachel('Positionen',      aktPositionen.length,       '')}
      ${kachel('Stangen neu',     gesamtStangen,              'Stk')}
      ${kachel('Ø Ausnutzung',    avgAusnutzung,              '%')}
      ${kachel('Gesamtverschnitt',mm(gesamtVerschnitt),       'mm')}
      ${kachel('≈ Gesamtgewicht', kgText,                     'kg')}
    </div>
    ${restGenutzt ? `<p class="text-xs text-emerald-700 mt-2">♻️ ${restGenutzt} Reststück(e) aus dem Lager einbezogen</p>` : ''}`;

  const ri = document.getElementById('reste-info');
  if (ri) {
    const neue = [];
    (aktGruppen || []).forEach(g => (g.neueReste || []).forEach(r => neue.push(r)));
    const parts = [];
    if (restGenutzt) parts.push(restGenutzt + ' Lager-Rest(e) verwendet');
    if (neue.length) parts.push(neue.length + ' neue Reststücke ≥300 mm (→ „Reste ins Lager“)');
    ri.textContent = parts.length ? parts.join(' · ') : 'Tipp: „Mit Reststücken optimieren“ nutzt Lager-Reste und spart Stangen.';
  }

  rendereTabelle();

  // Profil-Karten + empfohlene Schnittreihenfolge
  const container = document.getElementById('profil-karten');
  const FARBEN = ['#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6'];

  const alleSchritte = [];
  (aktGruppen || []).forEach(g => {
    (g.schnittfolge || []).forEach(s => alleSchritte.push(Object.assign({ profil: g.profil }, s)));
  });
  const folgeHtml = alleSchritte.length ? `
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden border border-transparent dark:border-slate-700">
      <div class="px-4 md:px-5 py-3 bg-amber-50 dark:bg-amber-900/30 border-b border-amber-100 dark:border-amber-800">
        <h3 class="text-sm font-bold text-amber-900 dark:text-amber-200">✂️ Empfohlene Schnittreihenfolge</h3>
        <p class="text-xs text-amber-800/80 dark:text-amber-300/80 mt-0.5">Große Teile zuerst – so entsteht weniger Verschnitt. In dieser Reihenfolge schneiden.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-xs text-slate-500 dark:text-slate-400 dark:text-slate-500 dark:text-slate-400 dark:text-slate-500 uppercase border-b dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50">
            <tr>
              <th class="px-3 py-2 text-left">Nr</th>
              <th class="px-3 py-2 text-left">Pos</th>
              <th class="px-3 py-2 text-left">Profil</th>
              <th class="px-3 py-2 text-left">Länge</th>
              <th class="px-3 py-2 text-left">Stange</th>
              <th class="px-3 py-2 text-left hidden sm:table-cell">Winkel</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            ${alleSchritte.map(s => `
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40">
                <td class="px-3 py-2 font-bold text-blue-700">#${s.nr}</td>
                <td class="px-3 py-2 font-medium">${esc(String(s.pos))}</td>
                <td class="px-3 py-2 text-slate-700 dark:text-slate-200">${esc(s.profil || '')}</td>
                <td class="px-3 py-2">${mm(s.laenge)} mm</td>
                <td class="px-3 py-2 text-slate-600 dark:text-slate-300">${s.uebermas ? 'Übermaß' : ('Stange ' + s.stangeNr)}</td>
                <td class="px-3 py-2 text-slate-500 hidden sm:table-cell">${esc(s.winkel || '–')}</td>
              </tr>`).join('')}
          </tbody>
        </table>
      </div>
    </div>` : '';

  const kartenHtml = aktGruppen.map(g => {
    const stDetails = g.stangen.map((st, si) => {
      const label   = st.uebermas ? 'Übermaß' : (st.istRest ? `♻️ Reststück ${si+1}` : `Stange ${si+1}`);
      const balken  = st.teile.map((t, ti) => {
        const pct   = st.uebermas ? 100 : Math.max(1, Math.round((t.laenge / aktStange) * 100));
        const nr = t.schnittNr || (st.folge && st.folge[ti] && st.folge[ti].nr) || (ti + 1);
        return `<div title="#${nr} Pos ${esc(t.pos)}: ${mm(t.laenge)} mm"
          style="width:${pct}%;background:${FARBEN[ti%FARBEN.length]};height:100%;display:inline-block;vertical-align:top;"></div>`;
      }).join('');
      const restPct = st.uebermas ? 0 : Math.round((st.rest / aktStange) * 100);
      const restB   = restPct > 0
        ? `<div style="width:${restPct}%;background:#e5e7eb;height:100%;display:inline-block;vertical-align:top;" title="Verschnitt: ${mm(st.rest)} mm"></div>` : '';
      const teileListe = st.teile.map((t, ti) => {
        const nr = t.schnittNr || (st.folge && st.folge[ti] && st.folge[ti].nr) || (ti + 1);
        return `<span class="inline-flex items-center gap-1 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 dark:text-slate-200 text-xs px-1.5 py-0.5 rounded mr-1 mb-1">
          <span class="font-bold text-blue-600">#${nr}</span>
          Pos ${esc(t.pos)}: ${mm(t.laenge)} mm${t.winkel ? ' · ' + esc(t.winkel) : ''}
        </span>`;
      }).join('');
      return `
        <div class="border border-slate-200 dark:border-slate-600 rounded-lg p-3 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-600 dark:text-slate-300 dark:text-slate-300">${label} · Schnittreihenfolge</span>
            ${st.uebermas ? '<span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded font-medium">⚠ Übermaß</span>'
                          : `<span class="text-xs text-slate-400 dark:text-slate-500">Rest: ${mm(st.rest)} mm</span>`}
          </div>
          <div style="height:14px;width:100%;background:#f1f5f9;border-radius:4px;overflow:hidden;">${balken}${restB}</div>
          <div class="pt-1 flex flex-wrap items-center gap-0.5">${teileListe}</div>
        </div>`;
    }).join('');

    return `
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden border border-transparent dark:border-slate-700">
        <div class="px-4 md:px-5 py-3 bg-blue-50 dark:bg-blue-900/30 border-b border-blue-100 dark:border-blue-800 flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-sm font-bold text-blue-800 dark:text-blue-200">${esc(g.profil)}</h3>
          <div class="flex flex-wrap gap-3 text-xs text-blue-700 dark:text-blue-300">
            <span>📦 ${g.stangenzahl} Stange(n)</span>
            <span>📏 ${mm(g.gesamtLaenge)} mm</span>
            <span class="font-semibold ${g.ausnutzung>=80?'text-green-700':g.ausnutzung>=60?'text-amber-700':'text-red-700'}">
              Ausnutzung: ${g.ausnutzung} %
            </span>
            <span>Verschnitt: ${mm(g.verschnittGes)} mm</span>
          </div>
        </div>
        <div class="p-4 space-y-3">${stDetails}</div>
      </div>`;
  }).join('');

  container.innerHTML = folgeHtml + kartenHtml;

  document.getElementById('ergebnis').classList.remove('hidden');
  fuelleAuftragSelect();
}

// Schnittskizze (Draufsicht): Abweichung vom geraden 90°-Schnitt; links = Anfang, rechts = Ende
function schnittSvg(winkel) {
  const txt = String(winkel || '');
  const z = (txt.match(/\d+(?:[.,]\d+)?/g) || []).map(n => parseFloat(n.replace(',', '.')));
  if (!z.length) return '<span class="text-slate-300">–</span>';
  const dev = a => (a > 0 && a < 90 ? a : 0);
  const d1 = dev(z[0]), d2 = z.length > 1 ? dev(z[1]) : d1;
  const parallel = /parallel|par\b/i.test(txt);
  const w = 56, h = 16;
  const off = d => Math.min(w * 0.28, h * Math.tan(d * Math.PI / 180));
  const o1 = off(d1), o2 = off(d2);
  const pts = parallel
    ? [[o1, 0], [w, 0], [w - o2, h], [0, h]]
    : [[o1, 0], [w - o2, 0], [w, h], [0, h]];
  return `<svg width="${w + 4}" height="${h + 4}" viewBox="-2 -2 ${w + 4} ${h + 4}" title="Schnittrichtung">` +
    `<polygon points="${pts.map(p => p.map(n => n.toFixed(1)).join(',')).join(' ')}" fill="#e5e7eb" stroke="#374151" stroke-width="1.2"/></svg>`;
}

function rendereTabelle() {
  const tbody = document.getElementById('pos-tabelle');
  tbody.innerHTML = aktPositionen.map((p, i) => {
    const lFehlt = !p.laenge || p.laenge === 0;
    const kgVal = (p.kg != null && p.kg > 0) ? p.kg : '';
    return `
    <tr data-idx="${i}" class="${lFehlt ? 'bg-amber-50 dark:bg-amber-900/20' : 'hover:bg-slate-50 dark:hover:bg-slate-700/40'}">
      <td class="px-3 py-1.5"><input class="pos-input text-xs font-mono text-slate-400 dark:text-slate-500" value="${esc(p.pos)}"></td>
      <td class="px-3 py-1.5"><input class="pos-input w-16 text-center" type="number" min="1" value="${p.menge}"></td>
      <td class="px-3 py-1.5"><input class="pos-input font-semibold text-slate-800 dark:text-slate-100" value="${esc(p.profil)}"></td>
      <td class="px-3 py-1.5">
        <input class="pos-input w-24 text-right ${lFehlt ? 'text-amber-600 dark:text-amber-400 font-semibold' : 'dark:text-slate-100'}"
          type="number" min="0" value="${p.laenge || ''}" placeholder="${lFehlt ? '✏ eintragen' : ''}">
      </td>
      <td class="px-3 py-1.5">
        <input class="pos-input w-16 text-right text-emerald-700 dark:text-emerald-400" type="number" min="0" step="0.1"
          value="${kgVal}" placeholder="–" title="Ungefähres Gewicht 1 Stück (kg)">
      </td>
      <td class="px-3 py-1.5"><input class="pos-input w-28 text-xs font-semibold text-indigo-600 dark:text-indigo-400" value="${esc(p.winkel || '')}" placeholder="z.B. 35°"
        oninput="this.closest('tr').querySelector('.skizze').innerHTML = schnittSvg(this.value)"></td>
      <td class="px-3 py-1.5"><span class="skizze">${schnittSvg(p.winkel)}</span></td>
      <td class="px-3 py-1.5"><input class="pos-input text-slate-500 dark:text-slate-400 text-xs" value="${esc(p.bemerk)}"></td>
      <td class="px-3 py-1.5 text-right">
        <button onclick="posLoeschen(${i})" class="text-red-400 hover:text-red-600 text-xs px-2 py-1 rounded hover:bg-red-50 dark:hover:bg-red-900/30">🗑️</button>
      </td>
    </tr>`;
  }).join('');
}

// ── Hilfsfunktionen ──────────────────────────────────────────
function kachel(label, wert, einheit) {
  return `<div class="bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-600 rounded-lg px-3 py-3 text-center">
    <p class="text-xs text-slate-500 dark:text-slate-400">${label}</p>
    <p class="text-xl font-bold text-slate-800 dark:text-slate-100 mt-1">${wert}<span class="text-sm font-normal text-slate-500 dark:text-slate-400 ml-1">${einheit}</span></p>
  </div>`;
}
function mm(n)  { return Number(n).toLocaleString('de-DE'); }
function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function zeigeFehler(msg) {
  const box = document.getElementById('fehler-box');
  box.textContent = '⚠ ' + msg;
  box.classList.remove('hidden');
}
function zeigeLoading(txt) {
  document.getElementById('loading-text').textContent = txt || 'Wird verarbeitet…';
  document.getElementById('loading').classList.remove('hidden');
}
function versteckeLoading() { document.getElementById('loading').classList.add('hidden'); }
function verstecke(id)      { document.getElementById(id).classList.add('hidden'); }

function zeigeBeispiel() { document.getElementById('beispiel-csv').classList.toggle('hidden'); }

function downloadBeispielCsv() {
  const inhalt = `Pos;Menge;Profil;Länge;Bemerkung\n1;3;IPE 200;2450;Unterzug\n2;5;IPE 200;1800;Querträger\n3;2;HEB 160;3200;Hauptträger\n4;4;ROR 60x60x3;950;Stütze\n5;6;ROR 60x60x3;600;Rahmenriegel`;
  const blob = new Blob([inhalt], { type: 'text/csv;charset=utf-8;' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href = url; a.download = 'schnittliste-beispiel.csv'; a.click();
  URL.revokeObjectURL(url);
}

// ── Speichern / Laden ────────────────────────────────────────
function fmtDatum(d) {
  if (!d) return '';
  try {
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return String(d).slice(0, 16);
    return dt.toLocaleString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  } catch (_) { return ''; }
}

async function ladeProjekte(force) {
  if (!force && aktProjekteCache && aktProjekteCache.length > 0) return aktProjekteCache;
  try {
    const res = await fetch('/schnittliste/api/projects');
    const data = await res.json();
    if (!data.ok && !Array.isArray(data.projects)) {
      console.warn('Projekte API:', data.fehler);
      aktProjekteCache = [];
      return [];
    }
    aktProjekteCache = data.projects || [];
    return aktProjekteCache;
  } catch (e) {
    console.warn('Projekte laden:', e.message);
    aktProjekteCache = null;
    return [];
  }
}

function auftragOptionsHtml(projekte, cur) {
  return '<option value="">– Baustelle / Auftrag wählen –</option>' +
    projekte.map(p => {
      const lab = p.label || p.title || ('#' + p.id);
      return `<option value="${p.id}" ${String(p.id) === String(cur || '') ? 'selected' : ''}>${esc(lab)}</option>`;
    }).join('');
}

async function fuelleAuftragSelect() {
  const projekte = await ladeProjekte(true);
  const cur = aktProjectId ? String(aktProjectId) : '';
  const opts = auftragOptionsHtml(projekte, cur);

  ['auftrag-select', 'auftrag-pre-bild', 'auftrag-pre-datei'].forEach(id => {
    const sel = document.getElementById(id);
    if (sel) sel.innerHTML = opts;
  });

  const hinweis = document.getElementById('auftrag-hinweis');
  if (hinweis) {
    hinweis.textContent = projekte.length
      ? (projekte.length + ' Auftrag/Aufträge geladen. Name erscheint in PDF und gespeicherter Liste.')
      : 'Keine Aufträge gefunden. Lege unter „Aufträge“ einen an.';
    hinweis.className = projekte.length
      ? 'text-xs text-slate-400 dark:text-slate-500 mt-1.5'
      : 'text-xs text-amber-600 mt-1.5';
  }

  // Namen-Felder synchronisieren
  ['sl-name-bild', 'sl-name-datei'].forEach(id => {
    const el = document.getElementById(id);
    if (el && aktGespeichertName && !el.value) el.value = aktGespeichertName;
  });
}

function applyAuftrag(pid) {
  aktProjectId = pid ? parseInt(pid, 10) || null : null;
  if (!aktProjectId) {
    aktProjectTitle = '';
  } else {
    const p = (aktProjekteCache || []).find(x => Number(x.id) === Number(aktProjectId));
    aktProjectTitle = (p && p.title) ? p.title : '';
  }
  // Alle Dropdowns synchron halten
  ['auftrag-select', 'auftrag-pre-bild', 'auftrag-pre-datei'].forEach(id => {
    const sel = document.getElementById(id);
    if (sel && String(sel.value) !== String(aktProjectId || '')) {
      sel.value = aktProjectId ? String(aktProjectId) : '';
    }
  });
  // Name vorschlagen, wenn leer
  if (aktProjectTitle) {
    ['sl-name-bild', 'sl-name-datei'].forEach(id => {
      const el = document.getElementById(id);
      if (el && (!el.value.trim() || el.value.trim() === aktGespeichertName)) {
        // nur vorschlagen wenn Feld leer
      }
      if (el && !el.value.trim()) {
        el.value = aktProjectTitle;
        aktGespeichertName = aktProjectTitle;
      }
    });
  }
}

function onAuftragGewaehlt(sel) {
  applyAuftrag(sel.value);
}

function onAuftragPre(sel) {
  applyAuftrag(sel.value);
  syncMetaFromPre();
}

function syncMetaFromPre() {
  const nameEl = document.getElementById(aktQuelle === 'bild' ? 'sl-name-bild' : 'sl-name-datei')
    || document.getElementById('sl-name-bild')
    || document.getElementById('sl-name-datei');
  if (nameEl && nameEl.value.trim()) {
    aktGespeichertName = nameEl.value.trim();
  }
  // Namen zwischen Tabs spiegeln
  const n = aktGespeichertName || '';
  ['sl-name-bild', 'sl-name-datei'].forEach(id => {
    const el = document.getElementById(id);
    if (el && el !== nameEl && n && !el.value.trim()) el.value = n;
  });
}

function leseMetaVoranalyse() {
  syncMetaFromPre();
  const preSel = document.getElementById(aktQuelle === 'bild' ? 'auftrag-pre-bild' : 'auftrag-pre-datei');
  if (preSel && preSel.value) applyAuftrag(preSel.value);
}

async function ladeGespeicherte() {
  const box = document.getElementById('gespeichert-liste');
  box.innerHTML = '<span class="text-slate-400 dark:text-slate-500">Lade…</span>';
  try {
    const res = await fetch('/schnittliste/api/list');
    const data = await res.json();
    if (!data.ok) { box.innerHTML = '<span class="text-red-500">' + esc(data.fehler || 'Fehler') + '</span>'; return; }
    if (!data.listen || data.listen.length === 0) {
      box.innerHTML = '<span class="text-slate-400 dark:text-slate-500">Noch keine Schnittlisten gespeichert.</span>';
      return;
    }
    box.innerHTML = `
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="text-xs text-slate-500 dark:text-slate-400 dark:text-slate-500 uppercase border-b">
            <tr>
              <th class="py-2 pr-3">Name</th>
              <th class="py-2 pr-3 hidden sm:table-cell">Auftrag</th>
              <th class="py-2 pr-3">Pos.</th>
              <th class="py-2 pr-3 hidden md:table-cell">Datum</th>
              <th class="py-2 text-right">Aktion</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            ${data.listen.map(l => {
              const anzeigeName = l.project_title
                ? (l.name && l.name !== l.project_title
                    ? esc(l.project_title) + ' <span class="text-slate-400 dark:text-slate-500 font-normal">· ' + esc(l.name) + '</span>'
                    : esc(l.project_title))
                : esc(l.name);
              return `
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40">
                <td class="py-2 pr-3 font-medium text-slate-800 dark:text-slate-100">${anzeigeName}
                  <span class="text-xs text-slate-400 dark:text-slate-500 ml-1">${l.quelle === 'bild' ? '📷' : '📂'}</span>
                </td>
                <td class="py-2 pr-3 text-slate-600 dark:text-slate-300 text-xs hidden sm:table-cell">${l.project_title ? esc(l.project_title) : '<span class="text-slate-300">–</span>'}</td>
                <td class="py-2 pr-3 text-slate-600 dark:text-slate-300">${l.anzahl}</td>
                <td class="py-2 pr-3 text-slate-500 text-xs hidden md:table-cell">${fmtDatum(l.updated_at || l.created_at)}</td>
                <td class="py-2 text-right whitespace-nowrap">
                  <button type="button" onclick="schnittlisteLaden(${l.id})"
                    class="text-xs text-blue-600 hover:underline mr-2">Laden</button>
                  <button type="button" onclick="schnittlisteLoeschen(${l.id}, '${esc(l.name).replace(/'/g, "\\'")}')"
                    class="text-xs text-red-500 hover:underline">Löschen</button>
                </td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>
      </div>`;
  } catch (e) {
    box.innerHTML = '<span class="text-red-500">Netzwerkfehler: ' + esc(e.message) + '</span>';
  }
}

async function schnittlisteSpeichern() {
  leseTabelle();
  if (!aktPositionen.length) { alert('Keine Positionen zum Speichern.'); return; }

  // Name + Auftrag aus Vor-Analyse-Feldern / Ergebnis übernehmen
  leseMetaVoranalyse();
  const auftragSel = document.getElementById('auftrag-select');
  if (auftragSel && auftragSel.value) onAuftragGewaehlt(auftragSel);

  const projekte = await ladeProjekte(true);
  // Vorschlag: Auftragsname hat Vorrang, sonst gespeicherter Name, sonst Datum
  const vorschlag = aktProjectTitle
    || aktGespeichertName
    || ('Schnittliste ' + new Date().toLocaleDateString('de-DE'));
  const projektOpts = projekte.length
    ? projekte.map(p => {
        const lab = p.label || p.title || ('#' + p.id);
        return `<option value="${p.id}" ${Number(aktProjectId) === Number(p.id) ? 'selected' : ''}>${esc(lab)}</option>`;
      }).join('')
    : '';

  // Einfacher Dialog: Name + Auftrag
  const overlay = document.createElement('div');
  overlay.id = 'sl-save-modal';
  overlay.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4';
  overlay.innerHTML = `
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl w-full max-w-md p-5 space-y-4 border border-transparent dark:border-slate-700">
      <h3 class="text-base font-bold text-slate-800 dark:text-slate-100">Schnittliste speichern</h3>
      <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Name</label>
        <input id="sl-save-name" type="text" value="${esc(vorschlag)}"
          class="w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Auftrag zuweisen (optional)</label>
        <select id="sl-save-project" class="w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-blue-500">
          <option value="">– kein Auftrag –</option>
          ${projektOpts}
        </select>
        ${projekte.length === 0 ? '<p class="text-xs text-amber-600 dark:text-amber-400 mt-1">Keine offenen Aufträge gefunden. Prüfe unter Aufträge, ob welche angelegt sind.</p>' : ''}
      </div>
      <div class="flex justify-end gap-2 pt-1">
        <button type="button" id="sl-save-cancel" class="text-sm px-4 py-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">Abbrechen</button>
        <button type="button" id="sl-save-ok" class="text-sm px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold">Speichern</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  document.getElementById('sl-save-name').focus();
  document.getElementById('sl-save-name').select();

  // Auftrag wählen → Name vorschlagen (Auftragsname)
  document.getElementById('sl-save-project').addEventListener('change', function () {
    const pid = parseInt(this.value, 10) || null;
    const p = projekte.find(x => Number(x.id) === Number(pid));
    const nameEl = document.getElementById('sl-save-name');
    if (p && p.title) {
      // Nur überschreiben wenn leer oder noch der alte Vorschlag
      const cur = nameEl.value.trim();
      if (!cur || cur.startsWith('Schnittliste ') || cur === aktGespeichertName || cur === aktProjectTitle) {
        nameEl.value = p.title;
      }
    }
  });

  const close = () => { overlay.remove(); };
  document.getElementById('sl-save-cancel').onclick = close;
  overlay.addEventListener('click', e => { if (e.target === overlay) close(); });

  document.getElementById('sl-save-ok').onclick = async () => {
    let name = document.getElementById('sl-save-name').value.trim();
    const projectId = parseInt(document.getElementById('sl-save-project').value, 10) || null;
    const selProj = projectId ? projekte.find(p => Number(p.id) === Number(projectId)) : null;
    // Wenn Name leer aber Auftrag gewählt → Auftragsname verwenden
    if (!name && selProj && selProj.title) name = selProj.title;
    if (!name) { alert('Bitte einen Namen eingeben.'); return; }

    const payload = {
      name,
      positionen: aktPositionen,
      stangenlaenge: parseInt(
        (aktQuelle === 'bild'
          ? document.getElementById('stangenlaenge-bild')
          : document.getElementById('stangenlaenge')
        ).value, 10) || aktStange,
      saege: leseSaege(),
      quelle: aktQuelle,
      project_id: projectId
    };
    if (aktGespeichertId && aktGespeichertName === name) {
      payload.id = aktGespeichertId;
    } else if (aktGespeichertId) {
      const ueberschreiben = confirm(
        'Aktuelle Liste ist mit „' + aktGespeichertName + '“ verknüpft.\n\nOK = unter neuem Namen speichern\nAbbrechen = bestehende überschreiben'
      );
      if (!ueberschreiben) payload.id = aktGespeichertId;
    }

    try {
      const res = await fetch('/schnittliste/api/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!data.ok) { alert(data.fehler || 'Speichern fehlgeschlagen.'); return; }
      aktGespeichertId = data.id;
      aktGespeichertName = data.name;
      aktProjectId = data.project_id || projectId;
      aktProjectTitle = (selProj && selProj.title) || '';
      close();
      const auftragTxt = aktProjectTitle || null;
      alert('Gespeichert: „' + data.name + '“ (' + data.anzahl + ' Positionen)' +
        (auftragTxt ? '\nAuftrag: ' + auftragTxt : ''));
      ladeGespeicherte();
    } catch (e) {
      alert('Netzwerkfehler: ' + e.message);
    }
  };
}

async function schnittlisteLaden(id) {
  try {
    zeigeLoading('Schnittliste wird geladen…');
    const res = await fetch('/schnittliste/api/' + id);
    const data = await res.json();
    versteckeLoading();
    if (!data.ok) { zeigeFehler(data.fehler || 'Laden fehlgeschlagen.'); return; }
    aktPositionen = data.positionen || [];
    aktGruppen = data.gruppen || [];
    aktStange = data.stangenlaenge || 6000;
    aktQuelle = data.quelle === 'bild' ? 'bild' : 'datei';
    aktGespeichertId = data.id;
    aktGespeichertName = data.name || '';
    aktProjectId = data.project_id || null;
    aktProjectTitle = data.project_title || '';
    ['sl-name-bild', 'sl-name-datei'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = aktGespeichertName || '';
    });
    fuelleAuftragSelect();
    const el1 = document.getElementById('stangenlaenge');
    const el2 = document.getElementById('stangenlaenge-bild');
    if (el1) el1.value = aktStange;
    if (el2) el2.value = aktStange;
    if (typeof data.saege === 'number') {
      const s1 = document.getElementById('saege');
      const s2 = document.getElementById('saege-bild');
      if (s1) s1.value = data.saege;
      if (s2) s2.value = data.saege;
    }
    wechsleTab(aktQuelle);
    rendereErgebnis();
    document.getElementById('btn-pdf').disabled = false;
    document.getElementById('btn-pdf-bild').disabled = false;
    const hinweis = document.getElementById('ki-hinweis');
    if (hinweis) {
      document.getElementById('ki-anzahl').textContent = aktPositionen.length;
      hinweis.classList.remove('hidden');
    }
  } catch (e) {
    versteckeLoading();
    zeigeFehler('Netzwerkfehler: ' + e.message);
  }
}

async function schnittlisteLoeschen(id, name) {
  if (!confirm('Schnittliste „' + (name || id) + '“ wirklich löschen?')) return;
  try {
    const res = await fetch('/schnittliste/api/' + id, { method: 'DELETE' });
    const data = await res.json();
    if (!data.ok) { alert(data.fehler || 'Löschen fehlgeschlagen.'); return; }
    if (aktGespeichertId === id) {
      aktGespeichertId = null;
      aktGespeichertName = '';
      aktProjectId = null;
      aktProjectTitle = '';
    }
    ladeGespeicherte();
  } catch (e) {
    alert('Netzwerkfehler: ' + e.message);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  ladeGespeicherte();
  fuelleAuftragSelect();
});
</script>

