<%- include('partials/header') %>

<%- include('partials/sidebar') %>
<main class="flex-1 flex flex-col overflow-y-auto page-bg min-h-screen pt-16">
    <div class="p-4 md:p-6 max-w-4xl mx-auto w-full space-y-6">
      
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-6 space-y-6">
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b dark:border-slate-700 pb-4">
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">Rechnung:</h2>
              <!-- Rechnungsnummer inline bearbeiten -->
              <form action="/documents/invoices/update-number" method="POST" class="flex items-center gap-1" id="inv-num-form">
                <input type="hidden" name="invoice_id" value="<%= invoice.id %>">
                <input type="text" name="invoice_number" value="<%= invoice.invoice_number %>"
                  id="inv-num-input"
                  class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100 bg-transparent border-b-2 border-transparent hover:border-blue-400 focus:border-blue-500 focus:outline-none w-44 transition-colors"
                  title="Rechnungsnummer anklicken zum Bearbeiten">
                <button type="submit"
                  class="hidden text-xs bg-blue-600 hover:bg-blue-700 text-white px-2 py-1 rounded transition"
                  id="inv-num-save">✓ Speichern</button>
                <button type="button" onclick="cancelEditNum()"
                  class="hidden text-xs bg-slate-200 hover:bg-slate-300 dark:bg-slate-600 dark:hover:bg-slate-500 text-slate-700 dark:text-slate-200 px-2 py-1 rounded transition"
                  id="inv-num-cancel">✕</button>
              </form>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Erstellt am: <%= new Date(invoice.created_at).toLocaleDateString('de-DE') %></p>
          </div>