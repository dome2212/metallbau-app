<%- include('partials/header') %>

<%- include('partials/sidebar') %>
<main class="flex-1 flex flex-col overflow-y-auto page-bg min-h-screen pt-16">
    <div class="p-4 md:p-6 max-w-4xl mx-auto w-full space-y-6">

      <% if (typeof mahnungOk !== 'undefined' && mahnungOk) { %>
      <div class="bg-green-50 dark:bg-green-900/20 border border-green-300 dark:border-green-700 rounded-xl px-4 py-3 text-sm text-green-800 dark:text-green-300 font-semibold">
        Mahnung wurde gespeichert. Du kannst das PDF herunterladen oder die Vorschau öffnen.
      </div>
      <% } %>
      <% if (typeof savedOk !== 'undefined' && savedOk) { %>
      <div class="bg-green-50 dark:bg-green-900/20 border border-green-300 dark:border-green-700 rounded-xl px-4 py-3 text-sm text-green-800 dark:text-green-300 font-semibold">
        Rechnung wurde gespeichert.
      </div>
      <% } %>
      
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-6 space-y-6">
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b dark:border-slate-700 pb-4">
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">Rechnung:</h2>
              <!-- Rechnungsnummer inline bearbeiten -->
              <form action="/documents/invoices/update-number" method="POST" class="flex items-center gap-1" id="inv-num-form">
                <input type="hidden" name="invoice_id" value="<%= invoice.id %>">
                <input type="text" name="invoice_number" value="<%= invoice.invoice_number %>"
                  id="inv-num-input"
                  class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100 bg-transparent border-b-2 border-transparent hover:border-blue-400 focus:border-blue-500 focus:outline-none w-44 transition-colors"
                  title="Rechnungsnummer anklicken zum Bearbeiten">
                <button type="submit"
                  class="hidden text-xs bg-blue-600 hover:bg-blue-700 text-white px-2 py-1 rounded transition"
                  id="inv-num-save">✓ Speichern</button>
                <button type="button" onclick="cancelEditNum()"
                  class="hidden text-xs bg-slate-200 hover:bg-slate-300 dark:bg-slate-600 dark:hover:bg-slate-500 text-slate-700 dark:text-slate-200 px-2 py-1 rounded transition"
                  id="inv-num-cancel">✕</button>
              </form>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Erstellt am: <%= new Date(invoice.created_at).toLocaleDateString('de-DE') %></p>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="badge badge-info"><%= invoice.status %></span>
            <% if ((invoice.dunning_level || 0) > 0) { %>
              <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300">
                Mahnstufe <%= invoice.dunning_level %>
              </span>
            <% } %>
            <% if (invoice.status !== 'Bezahlt') { %>
            <button type="button" onclick="document.getElementById('dunningModal').classList.remove('hidden')"
              class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-semibold flex items-center gap-1">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4m0 4h.01M10.3 3.9L2.5 17a1.5 1.5 0 001.3 2.3h16.4a1.5 1.5 0 001.3-2.3L13.7 3.9a1.5 1.5 0 00-2.6 0z"/></svg>
              Mahnung schreiben
            </button>
            <% } %>
            <button onclick="openPaymentReminderModal()"
              class="px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white rounded-lg text-xs font-semibold">
              <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>KI-Text
            </button>
            <a href="/documents/invoices/<%= invoice.id %>/pdf"
              class="px-3 py-1.5 bg-gray-50 dark:bg-slate-700 hover:bg-gray-100 dark:hover:bg-slate-600 border dark:border-slate-600 rounded-lg text-xs text-gray-600 dark:text-gray-300">
              <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5a1 1 0 001 1h5"/><path d="M6 21h12a1 1 0 001-1V7l-5-5H7a1 1 0 00-1 1v3"/></svg>PDF Vorschau
            </a>

            <button type="button" class="btn btn-ghost text-xs" onclick="(async function(){
              const url = location.origin + '/documents/invoices/<%= invoice.id %>/pdf-download';
              if (navigator.share) {
                try { await navigator.share({ title: 'Rechnung <%= invoice.invoice_number %>', url: url }); }
                catch(e) {}
              } else {
                try { await navigator.clipboard.writeText(url); if (typeof showToast==='function') showToast('Link kopiert', 'success'); }
                catch(e) { prompt('Link kopieren:', url); }
              }
            })()">Teilen</button>
            <a href="/documents/invoices/<%= invoice.id %>/pdf-download" download
              class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold">
              <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l4-4m-4 4l-4-4M4 19h16"/></svg>PDF herunterladen
            </a>
            <a href="/documents/invoices" class="px-3 py-1.5 border dark:border-slate-600 rounded-lg text-xs text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Zurück</a>
          </div>
        </div>

        <!-- Kunden-Details -->
        <div class="bg-gray-50 dark:bg-slate-700 rounded-lg p-4 border dark:border-slate-600 space-y-1 text-sm">
          <div class="text-xs font-bold text-gray-500 dark:text-slate-400 uppercase mb-1">Empfänger / Kunde</div>
          <p class="font-semibold text-gray-800 dark:text-gray-100"><%= invoice.company_name || invoice.contact_person %></p>
          <p class="text-gray-600 dark:text-gray-300"><%= invoice.street %></p>
          <p class="text-gray-600 dark:text-gray-300"><%= invoice.zip %> <%= invoice.city %></p>
          <p class="text-xs text-gray-400 dark:text-slate-500 pt-1"><%= invoice.email || '' %> <%= invoice.phone ? '| ' + invoice.phone : '' %></p>
        </div>

        <!-- Bearbeiten: Positionen, Fälligkeit, Status -->
        <form action="/documents/invoices/<%= invoice.id %>/update" method="POST" id="invoiceEditForm" class="space-y-4">
          <div class="flex flex-wrap items-end gap-4">
            <div>
              <label class="block text-[10px] font-semibold text-gray-500 uppercase mb-1">Fällig am</label>
              <input type="date" name="due_date" value="<%= invoice.due_date ? String(invoice.due_date).slice(0,10) : '' %>"
                class="border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-3 py-2 text-sm">
            </div>
            <div>
              <label class="block text-[10px] font-semibold text-gray-500 uppercase mb-1">MwSt. %</label>
              <input type="number" name="tax_rate" step="0.1" min="0" value="<%= invoice.tax_rate != null ? invoice.tax_rate : 19 %>"
                class="border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-3 py-2 text-sm w-24"
                oninput="recalcEditTotals()">
            </div>
            <div>
              <label class="block text-[10px] font-semibold text-gray-500 uppercase mb-1">Status</label>
              <select name="status" class="border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-3 py-2 text-sm">
                <% ['ENTWURF','Offen','Gesendet','Gemahnt','Überfällig','Bezahlt'].forEach(function(s) { %>
                  <option value="<%= s %>" <%= invoice.status === s ? 'selected' : '' %>><%= s %></option>
                <% }); %>
              </select>
            </div>
            <div class="flex-1 min-w-[140px]">
              <label class="block text-[10px] font-semibold text-gray-500 uppercase mb-1">Status-Hinweis</label>
              <input type="text" name="status_note" value="<%= invoice.status_note || '' %>" placeholder="optional"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg px-3 py-2 text-sm">
            </div>
          </div>

          <div>
            <div class="flex justify-between items-center mb-2">
              <h4 class="text-sm font-bold text-gray-800 dark:text-gray-100">Positionen</h4>
              <button type="button" onclick="addEditRow()" class="text-xs font-semibold text-blue-600 hover:text-blue-800 dark:text-blue-400 flex items-center gap-1">
                + Position
              </button>
            </div>
            <div class="border dark:border-slate-600 rounded-xl overflow-hidden">
              <div class="hidden sm:grid grid-cols-[1fr_72px_64px_88px_88px_36px] gap-1 bg-slate-100 dark:bg-slate-700/80 px-2 py-2 text-[10px] font-bold uppercase text-gray-500 dark:text-gray-400">
                <div>Bezeichnung</div>
                <div class="text-right">Menge</div>
                <div>Einh.</div>
                <div class="text-right">EP €</div>
                <div class="text-right">Gesamt</div>
                <div></div>
              </div>
              <div id="editItemsContainer" class="divide-y divide-gray-100 dark:divide-slate-700">
                <% (items || []).forEach(function(item) { %>
                <div data-edit-row class="grid grid-cols-1 sm:grid-cols-[1fr_72px_64px_88px_88px_36px] gap-1.5 items-center px-2 py-2">
                  <input type="text" name="title" value="<%= (item.description||'').replace(/"/g,'&quot;') %>" required
                    class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-2 py-1.5 text-sm dark:bg-slate-800 dark:text-gray-100" placeholder="Beschreibung">
                  <input type="number" step="0.01" name="quantity" value="<%= item.quantity %>" required
                    class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-2 py-1.5 text-sm text-right dark:bg-slate-800" oninput="recalcEditTotals()">
                  <select name="unit" class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-1 py-1.5 text-sm dark:bg-slate-800">
                    <% ['Stk','m','Std','kg','m²','Psch'].forEach(function(u) { %>
                      <option value="<%= u %>" <%= item.unit === u ? 'selected' : '' %>><%= u %></option>
                    <% }); %>
                  </select>
                  <input type="number" step="0.01" name="price" value="<%= item.price %>" required
                    class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-2 py-1.5 text-sm text-right dark:bg-slate-800" oninput="recalcEditTotals()">
                  <div data-line class="text-right text-sm font-semibold text-gray-800 dark:text-gray-200 hidden sm:block">
                    <%= (Number(item.quantity||0)*Number(item.price||0)).toFixed(2) %> €
                  </div>
                  <button type="button" onclick="this.closest('[data-edit-row]').remove();recalcEditTotals()"
                    class="w-8 h-8 flex items-center justify-center text-gray-400 hover:text-red-600 rounded-lg">✕</button>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

          <% if (canSeeMoney) { %>
          <div class="flex justify-end">
            <div class="w-full sm:w-64 bg-slate-50 dark:bg-slate-700/40 rounded-xl border border-gray-200 dark:border-slate-600 px-4 py-3 space-y-1 text-sm">
              <div class="flex justify-between text-gray-500"><span>Netto</span><span id="editNet"><%= Number(invoice.subtotal||0).toFixed(2) %> €</span></div>
              <div class="flex justify-between text-gray-500"><span>MwSt.</span><span id="editVat"><%= Number(invoice.tax_amount||0).toFixed(2) %> €</span></div>
              <div class="flex justify-between font-bold text-gray-900 dark:text-gray-100 pt-1 border-t border-gray-200 dark:border-slate-600">
                <span>Brutto</span><span id="editGross" class="text-emerald-600"><%= Number(invoice.total_amount||0).toFixed(2) %> €</span>
              </div>
            </div>
          </div>
          <% } %>

          <div class="flex justify-end gap-2 pt-2">
            <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold shadow-sm">
              Änderungen speichern
            </button>
          </div>
        </form>

        <% if (invoice.status_note) { %>
          <div class="bg-blue-50 border border-blue-200 text-blue-800 p-3 rounded-lg text-xs space-y-1">
            <strong>Hinweis/Statusgrund:</strong> <%= invoice.status_note %>
          </div>
        <% } %>

      </div>

    </div>
  </main>

<!-- ================================================ -->
<!-- MAHNUNG ERSTELLEN                                  -->
<!-- ================================================ -->
<div id="dunningModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl max-w-md w-full overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-200 dark:border-slate-700 flex justify-between items-center">
      <div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">Mahnung schreiben</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Rechnung <%= invoice.invoice_number %></p>
      </div>
      <button type="button" onclick="document.getElementById('dunningModal').classList.add('hidden')"
        class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 hover:text-gray-700 hover:bg-gray-100 dark:hover:bg-slate-700 text-xl">&times;</button>
    </div>
    <form action="/documents/invoices/<%= invoice.id %>/create-dunning" method="POST" class="p-5 space-y-4">
      <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
        Es wird eine <strong>Mahnung</strong> zur bestehenden Rechnung erzeugt.
        Die Mahnstufe wird gespeichert und das PDF erscheint als Mahnung (nicht als normale Rechnung).
      </p>
      <% if ((invoice.dunning_level || 0) > 0) { %>
      <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-lg px-3 py-2 text-xs text-amber-800 dark:text-amber-300">
        Aktuelle Mahnstufe: <strong><%= invoice.dunning_level %></strong>
        (<%= invoice.dunning_level === 1 ? '1. Zahlungserinnerung' : invoice.dunning_level === 2 ? '2. Mahnung' : '3. Letzte Mahnung' %>)
      </div>
      <% } %>
      <div>
        <label class="block text-xs font-semibold text-gray-600 dark:text-gray-300 mb-2">Mahnstufe wählen</label>
        <div class="space-y-2">
          <label class="flex items-start gap-3 p-3 rounded-xl border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer has-[:checked]:border-red-400 has-[:checked]:bg-red-50 dark:has-[:checked]:bg-red-900/20">
            <input type="radio" name="dunning_level" value="1" class="mt-0.5"
              <%= (invoice.dunning_level || 0) < 1 ? 'checked' : '' %>>
            <div>
              <span class="text-sm font-semibold text-gray-800 dark:text-gray-100">1. Zahlungserinnerung</span>
              <p class="text-xs text-gray-500 dark:text-gray-400">Freundliche Erinnerung an die offene Rechnung</p>
            </div>
          </label>
          <label class="flex items-start gap-3 p-3 rounded-xl border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer has-[:checked]:border-red-400 has-[:checked]:bg-red-50 dark:has-[:checked]:bg-red-900/20">
            <input type="radio" name="dunning_level" value="2" class="mt-0.5"
              <%= (invoice.dunning_level || 0) === 1 ? 'checked' : '' %>>
            <div>
              <span class="text-sm font-semibold text-gray-800 dark:text-gray-100">2. Mahnung</span>
              <p class="text-xs text-gray-500 dark:text-gray-400">Formelle Mahnung mit Zahlungsaufforderung</p>
            </div>
          </label>
          <label class="flex items-start gap-3 p-3 rounded-xl border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer has-[:checked]:border-red-400 has-[:checked]:bg-red-50 dark:has-[:checked]:bg-red-900/20">
            <input type="radio" name="dunning_level" value="3" class="mt-0.5"
              <%= (invoice.dunning_level || 0) >= 2 ? 'checked' : '' %>>
            <div>
              <span class="text-sm font-semibold text-gray-800 dark:text-gray-100">3. Letzte Mahnung</span>
              <p class="text-xs text-gray-500 dark:text-gray-400">Letzte Aufforderung vor weiteren Schritten</p>
            </div>
          </label>
        </div>
      </div>
      <%
        const f = typeof firma !== 'undefined' ? firma : {};
        const fee1 = parseFloat(f.dunning_fee_1 != null ? f.dunning_fee_1 : 0) || 0;
        const fee2 = parseFloat(f.dunning_fee_2 != null ? f.dunning_fee_2 : 5) || 0;
        const fee3 = parseFloat(f.dunning_fee_3 != null ? f.dunning_fee_3 : 10) || 0;
      %>
      <div class="bg-slate-50 dark:bg-slate-700/40 rounded-xl border border-gray-200 dark:border-slate-600 p-3 space-y-2">
        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
          <input type="checkbox" name="apply_fee" value="1" checked id="applyFeeChk" class="rounded border-gray-300 text-red-600 focus:ring-red-500" onchange="document.getElementById('feeOverrideWrap').classList.toggle('opacity-40', !this.checked)">
          Mahngebühr als Position hinzufügen
        </label>
        <div id="feeOverrideWrap" class="flex items-center gap-2 text-sm">
          <label class="text-xs text-gray-500 whitespace-nowrap">Betrag (€ netto)</label>
          <input type="number" name="dunning_fee_override" id="dunningFeeInput" step="0.01" min="0"
            value="<%= fee1 %>"
            data-fee1="<%= fee1 %>" data-fee2="<%= fee2 %>" data-fee3="<%= fee3 %>"
            class="w-28 border dark:border-slate-600 dark:bg-slate-800 rounded-lg px-2 py-1.5 text-sm">
          <span class="text-[10px] text-gray-400">Standard je Stufe im Admin unter PDF</span>
        </div>
      </div>
      <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
        <input type="checkbox" name="download_pdf" value="1" checked class="rounded border-gray-300 text-red-600 focus:ring-red-500">
        PDF der Mahnung direkt herunterladen
      </label>
      <script>
        document.querySelectorAll('input[name="dunning_level"]').forEach(function(r) {
          r.addEventListener('change', function() {
            var inp = document.getElementById('dunningFeeInput');
            if (!inp) return;
            var v = this.value;
            inp.value = v === '2' ? inp.dataset.fee2 : v === '3' ? inp.dataset.fee3 : inp.dataset.fee1;
          });
        });
      </script>
      <div class="flex justify-end gap-2 pt-2 border-t border-gray-100 dark:border-slate-700">
        <button type="button" onclick="document.getElementById('dunningModal').classList.add('hidden')"
          class="px-4 py-2.5 border border-gray-300 dark:border-slate-600 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Abbrechen</button>
        <button type="submit"
          class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-semibold shadow-sm flex items-center gap-1.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4m0 4h.01M10.3 3.9L2.5 17a1.5 1.5 0 001.3 2.3h16.4a1.5 1.5 0 001.3-2.3L13.7 3.9a1.5 1.5 0 00-2.6 0z"/></svg>
          Mahnung erstellen
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ================================================ -->
<!-- KI-ZAHLUNGSERINNERUNG MODAL                       -->
<!-- ================================================ -->
<div id="paymentReminderModal" class="hidden fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl max-w-2xl w-full p-5 md:p-7 max-h-[90vh] flex flex-col gap-4">
    <div class="flex justify-between items-center border-b dark:border-slate-700 pb-3">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 flex items-center gap-2"><svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>KI-Zahlungserinnerung</h3>
      <button onclick="document.getElementById('paymentReminderModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold leading-none">&times;</button>
    </div>
    <p class="text-xs text-gray-500 dark:text-gray-400">Die KI schreibt einen professionellen Mahnungstext für diese Rechnung. Du kannst ihn vor dem Versand anpassen und kopieren.</p>
    <div id="reminderLoading" class="hidden flex items-center gap-3 text-sm text-orange-600 font-medium py-4">
      <svg class="animate-spin h-5 w-5 text-orange-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
      </svg>
      KI formuliert Mahnungstext…
    </div>
    <div id="reminderError" class="hidden bg-red-50 border border-red-200 text-red-700 text-xs rounded px-3 py-2"></div>
    <textarea id="reminderText" rows="10"
      class="w-full text-sm border border-gray-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-3 bg-white focus:outline-none focus:ring-2 focus:ring-orange-500 resize-y"
      placeholder="Hier erscheint der Mahnungstext…"></textarea>
    <div class="flex justify-between items-center gap-3 pt-2 border-t dark:border-slate-700">
      <button id="reminderGenerateBtn" onclick="generatePaymentReminder()"
        class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg text-sm font-medium transition">
        <svg class="w-4 h-4 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>Jetzt generieren
      </button>
      <div class="flex gap-2">
        <button onclick="copyReminderText()"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-lg text-sm font-medium transition">
          <svg class="w-4 h-4 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>Kopieren
        </button>
        <% if (invoice.email) { %>
        <a href="mailto:<%= invoice.email %>?subject=Zahlungserinnerung%20Rechnung%20<%= invoice.invoice_number %>"
          id="reminderMailtoBtn"
          class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition">
          <svg class="w-4 h-4 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>Per E-Mail senden
        </a>
        <% } %>
        <button onclick="document.getElementById('paymentReminderModal').classList.add('hidden')"
          class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition">
          Schließen
        </button>
      </div>
    </div>
  </div>
</div>

<script>
function openPaymentReminderModal() {
  document.getElementById('paymentReminderModal').classList.remove('hidden');
  document.getElementById('reminderError').classList.add('hidden');
  document.getElementById('reminderLoading').classList.add('hidden');
}

async function generatePaymentReminder() {
  const btn     = document.getElementById('reminderGenerateBtn');
  const loading = document.getElementById('reminderLoading');
  const errorBox= document.getElementById('reminderError');
  const textarea= document.getElementById('reminderText');

  btn.disabled = true; btn.textContent = '⏳ Generiert…';
  loading.classList.remove('hidden');
  errorBox.classList.add('hidden');
  textarea.value = '';

  try {
    const res = await fetch('/api/ai/payment-reminder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        invoice_number: '<%= invoice.invoice_number %>',
        customer_name:  '<%= (invoice.company_name || invoice.contact_person || '').replace(/'/g, "\\'") %>',
        total_amount:   '<%= invoice.total_amount %>',
        due_date:       '<%= invoice.due_date || '' %>',
        dunning_level:  <%= invoice.dunning_level || 1 %>
      })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'Unbekannter Fehler');
    textarea.value = data.reminder;
  } catch (err) {
    errorBox.textContent = '❌ ' + err.message;
    errorBox.classList.remove('hidden');
  } finally {
    loading.classList.add('hidden');
    btn.disabled = false; btn.textContent = '✉️ Neu generieren';
  }
}

function copyReminderText() {
  const text = document.getElementById('reminderText').value;
  if (!text) return;
  navigator.clipboard.writeText(text).then(() => alert('Text in Zwischenablage kopiert.'));
}
</script>

<script>
const invNumInput  = document.getElementById('inv-num-input');
const invNumSave   = document.getElementById('inv-num-save');
const invNumCancel = document.getElementById('inv-num-cancel');
let invNumOriginal = invNumInput ? invNumInput.value : '';

if (invNumInput) {
  invNumInput.addEventListener('focus', () => {
    invNumSave.classList.remove('hidden');
    invNumCancel.classList.remove('hidden');
  });
  invNumInput.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cancelEditNum();
  });
}

function cancelEditNum() {
  invNumInput.value = invNumOriginal;
  invNumSave.classList.add('hidden');
  invNumCancel.classList.add('hidden');
  invNumInput.blur();
}
</script>

<script>
function addEditRow(title, qty, unit, price) {
  title = title || ''; qty = qty != null ? qty : 1; unit = unit || 'Stk'; price = price != null ? price : '';
  var c = document.getElementById('editItemsContainer');
  if (!c) return;
  var units = ['Stk','m','Std','kg','m²','Psch'].map(function(u) {
    return '<option value="'+u+'"'+(u===unit?' selected':'')+'>'+u+'</option>';
  }).join('');
  c.insertAdjacentHTML('beforeend',
    '<div data-edit-row class="grid grid-cols-1 sm:grid-cols-[1fr_72px_64px_88px_88px_36px] gap-1.5 items-center px-2 py-2">' +
    '<input type="text" name="title" value="'+String(title).replace(/"/g,'&quot;')+'" required placeholder="Beschreibung" class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-2 py-1.5 text-sm dark:bg-slate-800 dark:text-gray-100">' +
    '<input type="number" step="0.01" name="quantity" value="'+qty+'" required class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-2 py-1.5 text-sm text-right dark:bg-slate-800" oninput="recalcEditTotals()">' +
    '<select name="unit" class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-1 py-1.5 text-sm dark:bg-slate-800">'+units+'</select>' +
    '<input type="number" step="0.01" name="price" value="'+price+'" required class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-2 py-1.5 text-sm text-right dark:bg-slate-800" oninput="recalcEditTotals()">' +
    '<div data-line class="text-right text-sm font-semibold text-gray-800 dark:text-gray-200 hidden sm:block">0,00 €</div>' +
    '<button type="button" onclick="this.closest(\'[data-edit-row]\').remove();recalcEditTotals()" class="w-8 h-8 flex items-center justify-center text-gray-400 hover:text-red-600 rounded-lg">✕</button>' +
    '</div>');
  recalcEditTotals();
}
function recalcEditTotals() {
  var net = 0;
  document.querySelectorAll('#editItemsContainer [data-edit-row]').forEach(function(row) {
    var q = parseFloat(row.querySelector('[name="quantity"]')?.value) || 0;
    var p = parseFloat(row.querySelector('[name="price"]')?.value) || 0;
    var line = q * p;
    net += line;
    var el = row.querySelector('[data-line]');
    if (el) el.textContent = line.toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' €';
  });
  var rate = parseFloat(document.querySelector('#invoiceEditForm [name="tax_rate"]')?.value) || 19;
  var vat = net * (rate / 100);
  var gross = net + vat;
  var fmt = function(v) { return v.toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' €'; };
  var n = document.getElementById('editNet'); if (n) n.textContent = fmt(net);
  var v = document.getElementById('editVat'); if (v) v.textContent = fmt(vat);
  var g = document.getElementById('editGross'); if (g) g.textContent = fmt(gross);
}
</script>

</body>
</html>