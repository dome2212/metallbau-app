<%- include('partials/header') %>

<div class="flex h-screen bg-gray-100 dark:bg-gray-900 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-gray-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">
    <div class="p-4 md:p-6 max-w-4xl mx-auto w-full space-y-6">
      
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-6 space-y-6">
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b dark:border-slate-700 pb-4">
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">Rechnung:</h2>
              <!-- Rechnungsnummer inline bearbeiten -->
              <form action="/documents/invoices/update-number" method="POST" class="flex items-center gap-1" id="inv-num-form">
                <input type="hidden" name="invoice_id" value="<%= invoice.id %>">
                <input type="text" name="invoice_number" value="<%= invoice.invoice_number %>"
                  id="inv-num-input"
                  class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100 bg-transparent border-b-2 border-transparent hover:border-blue-400 focus:border-blue-500 focus:outline-none w-44 transition-colors"
                  title="Rechnungsnummer anklicken zum Bearbeiten">
                <button type="submit"
                  class="hidden text-xs bg-blue-600 hover:bg-blue-700 text-white px-2 py-1 rounded transition"
                  id="inv-num-save">✓ Speichern</button>
                <button type="button" onclick="cancelEditNum()"
                  class="hidden text-xs bg-slate-200 hover:bg-slate-300 dark:bg-slate-600 dark:hover:bg-slate-500 text-slate-700 dark:text-slate-200 px-2 py-1 rounded transition"
                  id="inv-num-cancel">✕</button>
              </form>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Erstellt am: <%= new Date(invoice.created_at).toLocaleDateString('de-DE') %></p>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-3 py-1 rounded text-xs font-semibold bg-blue-100 text-blue-800"><%= invoice.status %></span>
            <button onclick="openPaymentReminderModal()"
              class="px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white rounded-lg text-xs font-semibold">
              ✉️ KI-Mahnung
            </button>
            <a href="/documents/invoices/<%= invoice.id %>/pdf" target="_blank"
              class="px-3 py-1.5 bg-gray-50 dark:bg-slate-700 hover:bg-gray-100 dark:hover:bg-slate-600 border dark:border-slate-600 rounded-lg text-xs text-gray-600 dark:text-gray-300">
              🖨️ Drucken
            </a>
            <a href="/documents/invoices/<%= invoice.id %>/pdf-download"
              class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold">
              ⬇️ PDF herunterladen
            </a>
            <a href="/documents/invoices" class="px-3 py-1.5 border dark:border-slate-600 rounded-lg text-xs text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Zurück</a>
          </div>
        </div>

        <!-- Kunden-Details -->
        <div class="bg-gray-50 dark:bg-slate-700 rounded-lg p-4 border dark:border-slate-600 space-y-1 text-sm">
          <div class="text-xs font-bold text-gray-500 dark:text-slate-400 uppercase mb-1">Empfänger / Kunde</div>
          <p class="font-semibold text-gray-800 dark:text-gray-100"><%= invoice.company_name || invoice.contact_person %></p>
          <p class="text-gray-600 dark:text-gray-300"><%= invoice.street %></p>
          <p class="text-gray-600 dark:text-gray-300"><%= invoice.zip %> <%= invoice.city %></p>
          <p class="text-xs text-gray-400 dark:text-slate-500 pt-1"><%= invoice.email || '' %> <%= invoice.phone ? '| ' + invoice.phone : '' %></p>
        </div>

        <!-- Positionen (Material & Arbeitsstunden) -->
        <div>
          <h4 class="text-sm font-bold text-gray-800 dark:text-gray-100 mb-3">Verbautes Material & Leistungen</h4>
          <div class="overflow-x-auto border dark:border-slate-700 rounded-lg">
            <table class="w-full text-left text-sm border-collapse min-w-[600px]">
              <thead class="bg-gray-50 dark:bg-slate-700 text-gray-700 dark:text-slate-300 uppercase text-xs border-b dark:border-slate-600">
                <tr>
                  <th class="p-3">Beschreibung (Material / Arbeitszeit)</th>
                  <th class="p-3 text-center w-24">Menge</th>
                  <th class="p-3 text-center w-24">Einheit</th>
                  <th class="p-3 text-end w-28">Einzelpreis</th>
                  <th class="p-3 text-end w-28">Gesamt</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
                <% if (items.length === 0) { %>
                  <tr>
                    <td colspan="5" class="text-center text-gray-400 dark:text-slate-500 py-6 text-xs">Keine Positionen hinterlegt.</td>
                  </tr>
                <% } else { %>
                  <% items.forEach(item => { %>
                    <tr class="hover:bg-gray-50 dark:hover:bg-slate-700">
                      <td class="p-3 text-gray-800 dark:text-gray-100"><%= item.description %></td>
                      <td class="p-3 text-center text-gray-600 dark:text-gray-300"><%= item.quantity %></td>
                      <td class="p-3 text-center text-gray-600 dark:text-gray-300"><%= item.unit %></td>
                      <td class="p-3 text-end text-gray-600 dark:text-gray-300"><%= (item.price || 0).toFixed(2) %> €</td>
                      <td class="p-3 text-end font-semibold text-gray-800 dark:text-gray-100"><%= ((item.quantity || 1) * (item.price || 0)).toFixed(2) %> €</td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
              <tfoot class="bg-gray-50 dark:bg-slate-700 border-t dark:border-slate-600">
                <tr>
                  <td colspan="4" class="p-3 text-end font-bold text-gray-800 dark:text-gray-100 text-sm">Gesamtbetrag (Brutto):</td>
                  <td class="p-3 text-end font-bold text-emerald-600 text-base"><%= (invoice.total_amount || 0).toFixed(2) %> €</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <% if (invoice.status_note) { %>
          <div class="bg-blue-50 border border-blue-200 text-blue-800 p-3 rounded-lg text-xs space-y-1">
            <strong>Hinweis/Statusgrund:</strong> <%= invoice.status_note %>
          </div>
        <% } %>

      </div>

    </div>
  </main>
</div>

<!-- ================================================ -->
<!-- KI-ZAHLUNGSERINNERUNG MODAL                       -->
<!-- ================================================ -->
<div id="paymentReminderModal" class="hidden fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl max-w-2xl w-full p-5 md:p-7 max-h-[90vh] flex flex-col gap-4">
    <div class="flex justify-between items-center border-b dark:border-slate-700 pb-3">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">✉️ KI-Zahlungserinnerung</h3>
      <button onclick="document.getElementById('paymentReminderModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold leading-none">&times;</button>
    </div>
    <p class="text-xs text-gray-500 dark:text-gray-400">Die KI schreibt einen professionellen Mahnungstext für diese Rechnung. Du kannst ihn vor dem Versand anpassen und kopieren.</p>
    <div id="reminderLoading" class="hidden flex items-center gap-3 text-sm text-orange-600 font-medium py-4">
      <svg class="animate-spin h-5 w-5 text-orange-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
      </svg>
      KI formuliert Mahnungstext…
    </div>
    <div id="reminderError" class="hidden bg-red-50 border border-red-200 text-red-700 text-xs rounded px-3 py-2"></div>
    <textarea id="reminderText" rows="10"
      class="w-full text-sm border border-gray-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-3 bg-white focus:outline-none focus:ring-2 focus:ring-orange-500 resize-y"
      placeholder="Hier erscheint der Mahnungstext…"></textarea>
    <div class="flex justify-between items-center gap-3 pt-2 border-t dark:border-slate-700">
      <button id="reminderGenerateBtn" onclick="generatePaymentReminder()"
        class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg text-sm font-medium transition">
        ✉️ Jetzt generieren
      </button>
      <div class="flex gap-2">
        <button onclick="copyReminderText()"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-lg text-sm font-medium transition">
          📋 Kopieren
        </button>
        <% if (invoice.email) { %>
        <a href="mailto:<%= invoice.email %>?subject=Zahlungserinnerung%20Rechnung%20<%= invoice.invoice_number %>"
          id="reminderMailtoBtn"
          class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition">
          📧 Per E-Mail senden
        </a>
        <% } %>
        <button onclick="document.getElementById('paymentReminderModal').classList.add('hidden')"
          class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition">
          Schließen
        </button>
      </div>
    </div>
  </div>
</div>

<script>
function openPaymentReminderModal() {
  document.getElementById('paymentReminderModal').classList.remove('hidden');
  document.getElementById('reminderError').classList.add('hidden');
  document.getElementById('reminderLoading').classList.add('hidden');
}

async function generatePaymentReminder() {
  const btn     = document.getElementById('reminderGenerateBtn');
  const loading = document.getElementById('reminderLoading');
  const errorBox= document.getElementById('reminderError');
  const textarea= document.getElementById('reminderText');

  btn.disabled = true; btn.textContent = '⏳ Generiert…';
  loading.classList.remove('hidden');
  errorBox.classList.add('hidden');
  textarea.value = '';

  try {
    const res = await fetch('/api/ai/payment-reminder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        invoice_number: '<%= invoice.invoice_number %>',
        customer_name:  '<%= (invoice.company_name || invoice.contact_person || '').replace(/'/g, "\\'") %>',
        total_amount:   '<%= invoice.total_amount %>',
        due_date:       '<%= invoice.due_date || '' %>',
        dunning_level:  <%= invoice.dunning_level || 1 %>
      })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'Unbekannter Fehler');
    textarea.value = data.reminder;
  } catch (err) {
    errorBox.textContent = '❌ ' + err.message;
    errorBox.classList.remove('hidden');
  } finally {
    loading.classList.add('hidden');
    btn.disabled = false; btn.textContent = '✉️ Neu generieren';
  }
}

function copyReminderText() {
  const text = document.getElementById('reminderText').value;
  if (!text) return;
  navigator.clipboard.writeText(text).then(() => alert('Text in Zwischenablage kopiert.'));
}
</script>

<script>
const invNumInput  = document.getElementById('inv-num-input');
const invNumSave   = document.getElementById('inv-num-save');
const invNumCancel = document.getElementById('inv-num-cancel');
let invNumOriginal = invNumInput ? invNumInput.value : '';

if (invNumInput) {
  invNumInput.addEventListener('focus', () => {
    invNumSave.classList.remove('hidden');
    invNumCancel.classList.remove('hidden');
  });
  invNumInput.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cancelEditNum();
  });
}

function cancelEditNum() {
  invNumInput.value = invNumOriginal;
  invNumSave.classList.add('hidden');
  invNumCancel.classList.add('hidden');
  invNumInput.blur();
}
</script>
</body>
</html>
