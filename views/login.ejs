<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Metallbau Gehrmann Management</title>
  <script>
    // Anti-flicker: apply dark class before render
    if (localStorage.getItem('darkMode') === 'true') {
      document.documentElement.classList.add('dark');
    }
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'class' };
  </script>
</head>
<body class="bg-slate-900 dark:bg-gray-950 flex items-center justify-center h-screen">

  <div class="bg-white dark:bg-slate-800 p-8 rounded-xl shadow-2xl w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-extrabold text-slate-800 dark:text-gray-100">🔩 Metallbau Gehrmann OS</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Bitte melden Sie sich an</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-700 text-red-700 dark:text-red-400 px-4 py-3 rounded mb-4 text-sm">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST" class="space-y-5">
      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Benutzername</label>
        <input type="text" name="username" required placeholder="z. B. admin"
          class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Passwort</label>
        <input type="password" name="password" required placeholder="••••••••"
          class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg shadow transition">
        Anmelden
      </button>
    </form>
  </div>

</body>
</html>
