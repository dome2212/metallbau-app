<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="max-w-7xl mx-auto px-4 pb-24 pt-4">
  <div class="mb-4">
    <a href="/auftragszentrale/<%= project.id %>" class="text-sm text-blue-600 font-semibold">← Auftragszentrale</a>
    <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100 mt-1">Montage / Baustelle</h1>
    <p class="text-xs text-slate-500"><%= project.title || ('Auftrag #' + project.id) %></p>
  </div>

  <% if (saved) { %>
  <div class="mb-4 rounded-lg bg-green-50 text-green-700 text-sm px-4 py-2">Gespeichert.</div>
  <% } %>

  <!-- Checkliste -->
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 mb-4">
    <h2 class="text-sm font-semibold mb-3">Montage-Checkliste</h2>
    <form method="POST" action="/auftragszentrale/<%= project.id %>/montage" data-offline="true" data-offline-label="Checkliste">
      <input type="hidden" name="revision" value="<%= current.revision %>">
      <div class="space-y-2 mb-3">
        <% (checklist || []).forEach(function(c, i) { %>
        <label class="flex items-start gap-2 text-sm">
          <input type="checkbox" name="check_<%= i %>" <%= c.done ? 'checked' : '' %> class="mt-1">
          <span><%= c.text %></span>
        </label>
        <% }) %>
      </div>
      <label class="block text-xs font-medium text-slate-500 mb-1">Montagenotiz</label>
      <textarea name="note" rows="3" class="w-full border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm mb-3"><%= (current.data && current.data.installationNote) || '' %></textarea>
      <button type="submit" class="bg-blue-600 text-white font-semibold px-4 py-2 rounded-lg text-sm">Checkliste speichern</button>
    </form>
  </div>

  <!-- Offline: Foto -->
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 mb-4" id="fotos">
    <h2 class="text-sm font-semibold mb-1">Foto (auch offline)</h2>
    <p class="text-xs text-slate-400 mb-3">Wird bei schlechtem Netz lokal gepuffert und später hochgeladen.</p>
    <form method="POST" action="/projects/<%= project.id %>/offline/photo"
          data-offline="true" data-offline-json="true" data-offline-label="Baustellen-Foto"
          enctype="multipart/form-data" class="space-y-2">
      <input type="file" name="photo" accept="image/*" capture="environment" required
             class="block w-full text-sm">
      <input type="text" name="caption" placeholder="Beschriftung (optional)"
             class="w-full border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
      <button type="submit" class="bg-slate-800 dark:bg-slate-600 text-white font-semibold px-4 py-2 rounded-lg text-sm">Foto speichern</button>
    </form>
    <% if ((photos || []).length) { %>
    <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-2">
      <% photos.slice(0, 12).forEach(function(ph) { %>
      <a href="<%= ph.file_url %>" target="_blank" rel="noopener" class="block rounded-lg overflow-hidden border dark:border-slate-600">
        <img src="<%= ph.file_url %>" alt="<%= ph.caption || ph.original_name || 'Foto' %>" class="w-full h-24 object-cover">
        <% if (ph.caption) { %><p class="text-[10px] p-1 truncate text-slate-500"><%= ph.caption %></p><% } %>
      </a>
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- Offline: Aufmaß -->
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 mb-4">
    <h2 class="text-sm font-semibold mb-3">Aufmaß (auch offline)</h2>
    <form method="POST" action="/projects/<%= project.id %>/offline/measurement"
          data-offline="true" data-offline-json="true" data-offline-label="Aufmaß"
          class="grid grid-cols-2 gap-2">
      <input name="component_name" required placeholder="Bauteil *"
             class="col-span-2 border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
      <input name="width" placeholder="Breite" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
      <input name="height" placeholder="Höhe" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
      <input name="angle" placeholder="Winkel" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
      <input name="quantity" value="1" placeholder="Menge" class="border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
      <input name="note" placeholder="Notiz" class="col-span-2 border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm">
      <button type="submit" class="col-span-2 bg-slate-800 dark:bg-slate-600 text-white font-semibold px-4 py-2 rounded-lg text-sm">Aufmaß speichern</button>
    </form>
    <% if ((measurements || []).length) { %>
    <ul class="mt-3 space-y-1 text-sm">
      <% measurements.slice(0, 20).forEach(function(m) { %>
      <li class="border-b dark:border-slate-700 py-1.5">
        <strong><%= m.component_name %></strong>
        <span class="text-slate-500 text-xs">
          <%= [m.width, m.height, m.angle].filter(Boolean).join(' · ') %>
          <%= m.quantity ? ' · ×' + m.quantity : '' %>
        </span>
        <% if (m.note) { %><div class="text-xs text-slate-400"><%= m.note %></div><% } %>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>

  <!-- Offline: Notiz -->
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 mb-4">
    <h2 class="text-sm font-semibold mb-3">Baustellen-Notiz (auch offline)</h2>
    <form method="POST" action="/projects/<%= project.id %>/offline/note"
          data-offline="true" data-offline-json="true" data-offline-label="Notiz"
          class="space-y-2">
      <textarea name="text" rows="3" required placeholder="Notiz …"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 rounded-lg p-2.5 text-sm"></textarea>
      <button type="submit" class="bg-slate-800 dark:bg-slate-600 text-white font-semibold px-4 py-2 rounded-lg text-sm">Notiz speichern</button>
    </form>
    <% if ((notes || []).length) { %>
    <ul class="mt-3 space-y-2 text-sm">
      <% notes.slice(0, 15).forEach(function(n) { %>
      <li class="border-b dark:border-slate-700 pb-2 text-slate-700 dark:text-slate-200">
        <%= n.note_text || n.note || n.content || n.text || '' %>
        <div class="text-[10px] text-slate-400 mt-0.5"><%= n.created_at %></div>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>
</div>
