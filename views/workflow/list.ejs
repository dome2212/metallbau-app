<%- include('../partials/header') %><%- include('../partials/sidebar') %>
<link rel="stylesheet" href="/css/billing.css"><link rel="stylesheet" href="/css/workflow.css">
<main class="flex-1 page-bg min-h-screen pt-16 bill-main"><div class="bill-shell">
<header class="bill-heading"><div><span class="bill-eyebrow">WERKSTATT · ORGANISATION</span><h1>Auftragszentrale</h1><p>Ein Überblick vom Angebot bis zur Zahlung.</p></div><div class="bill-actions"><a class="bill-btn" href="/projects">Auftragsakten</a><% if(p.documents){ %><a class="bill-btn bill-primary" href="/documents/neu/angebot">+ Angebot</a><% } %></div></header>
<section class="bill-stats"><div class="bill-card"><span>Aktive Aufträge</span><strong><%= rows.filter(r=>r.project.status!=='Abgeschlossen').length %></strong></div><div class="bill-card"><span>In Fertigung</span><strong><%= rows.filter(r=>['In Produktion','Oberfläche'].includes(r.project.status)).length %></strong></div><div class="bill-card"><span>Montage</span><strong><%= rows.filter(r=>['Montagebereit','Montage läuft'].includes(r.project.status)).length %></strong></div><div class="bill-card"><span>Material klären</span><strong><%= rows.filter(r=>r.missing).length %></strong></div></section>
<section class="bill-card"><div class="bill-filters"><label class="bill-search">Auftrag suchen<input id="workflow-search" type="search" placeholder="Auftrag, Kunde oder Status …"></label><label>Status<select id="workflow-status"><option value="">Alle Arbeitsschritte</option><% stages.forEach(s=>{ %><option><%= s %></option><% }); %></select></label></div>
<div class="bill-table-scroll"><table class="bill-table"><thead><tr><th>Auftrag / Kunde</th><th>Arbeitsschritt</th><th>Als Nächstes</th><th></th></tr></thead><tbody><% rows.forEach(({project:pr,next,missing})=>{ %><tr data-workflow-row data-state="<%= pr.status %>" data-search="<%= [pr.title,pr.company_name,pr.contact_person,pr.status].join(' ').toLowerCase() %>"><td><a class="bill-doc-link" href="/auftragszentrale/<%= pr.id %>"><%= pr.title %></a><small><%= pr.company_name||pr.contact_person||'Kein Kunde zugeordnet' %></small></td><td><span class="bill-badge"><%= pr.status %></span></td><td><%= next.label %><% if(missing){ %><small><%= missing %> Materialpositionen offen</small><% } %></td><td><a class="bill-btn bill-small" href="/auftragszentrale/<%= pr.id %>">Öffnen →</a></td></tr><% }); %></tbody></table></div><p id="workflow-empty" class="bill-muted" <%= rows.length?'hidden':'' %>>Keine passenden Aufträge. Neue Aufträge lassen sich in der Auftragsakte oder aus einem Angebot anlegen.</p>
</section></div></main><script src="/js/workflow.js" defer></script></body></html>
