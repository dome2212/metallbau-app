<%- include('../partials/header') %><%- include('../partials/sidebar') %>
<link rel="stylesheet" href="/css/billing.css"><link rel="stylesheet" href="/css/workflow.css">
<main class="flex-1 page-bg min-h-screen pt-16 bill-main"><div class="bill-shell"><a class="bill-back" href="/auftragszentrale">← Auftragszentrale</a>
<header class="bill-heading"><div><span class="bill-eyebrow">AUFTRAG #<%= project.id %></span><h1><%= project.title %></h1><p><%= project.company_name||project.contact_person||'Kein Kunde zugeordnet' %></p></div><div class="bill-actions"><a class="bill-btn" href="/projects/<%= project.id %>">Vollständige Akte</a><a class="bill-btn bill-primary" href="/auftragszentrale/<%= project.id %>/montage">Montage öffnen</a></div></header>
<% if(saved){ %><p class="bill-alert bill-success-note" role="status">Gespeichert.</p><% } %>
<nav class="bill-tabs"><a href="#ablauf">Ablauf</a><% if(p.stock&&p.cad){ %><a href="#material">Material</a><% } %><% if(cost){ %><a href="#kalkulation">Kalkulation</a><% } %><% if(p.documents){ %><a href="#belege">Belege</a><% } %></nav>
<section class="bill-card" id="ablauf"><div class="bill-section-head"><h2>Arbeitsschritte</h2><span class="bill-badge"><%= project.status %></span></div><ol class="flow-stages"><li class="<%= offer?'is-done':'' %>">Angebot</li><li class="is-done">Auftrag</li><li class="<%= drawings.length?'is-done':'' %>">Zeichnung</li><li class="<%= materials.length&&materials.every(r=>!r.missingCount)?'is-done':'' %>">Material</li><li class="<%= ['Oberfläche','Montagebereit','Montage läuft','Abgeschlossen'].includes(project.status)?'is-done':'' %>">Fertigung</li><li class="<%= project.acceptance_at?'is-done':'' %>">Montage</li><li class="<%= invoices.length?'is-done':'' %>">Rechnung</li></ol>
<p class="bill-hint">Nächster Schritt: <a href="<%= next.href||('#'+next.anchor) %>"><strong><%= next.label %></strong></a></p>
<% if(p.admin){ %><form method="POST" action="/auftragszentrale/<%= project.id %>/status" class="flow-inline"><input type="hidden" name="revision" value="<%= current.revision %>"><label class="bill-field">Arbeitsstand<select name="status"><% stages.forEach(s=>{ %><option <%= s===project.status?'selected':'' %>><%= s %></option><% }); %></select></label><button class="bill-btn">Arbeitsstand speichern</button></form><% } %>
</section>
<section class="bill-card"><div class="bill-section-head"><h2>Zeichnungen</h2><% if(p.cad){ %><a class="bill-btn bill-small" href="/cad">CAD öffnen</a><% } %></div><% if(!drawings.length){ %><p class="bill-muted">Keine für dich freigegebenen Zeichnungen zugeordnet. Im CAD unter „Server &amp; Team“ speichern und diesen Auftrag wählen.</p><% } %><div class="flow-links"><% drawings.forEach(d=>{ %><a class="bill-btn" target="_blank" rel="noopener" href="/auftragszentrale/<%= project.id %>/zeichnungen/<%= d.id %>.pdf"><%= d.name %> · Rev. <%= d.revision %> ↗</a><% }); %></div></section>
<% if(p.stock&&p.cad){ %><section class="bill-card" id="material"><div class="bill-section-head"><h2>Material aus CAD</h2><a class="bill-btn bill-small" href="/lager">Lager öffnen</a></div><p class="bill-hint">Bedarf aus den zugeordneten, zugänglichen Zeichnungen. Lager und Reststücke bewusst zuweisen: Werkstoff, Profil und Oberfläche müssen passen. Der Abgleich reserviert und bucht keinen Bestand. Reststücke werden mit 3 mm Sägeschnitt geplant; Meterbestand ist eine Mengenprüfung ohne Stangenoptimierung.</p>
<% if(materials.length){ %><form method="POST" data-workflow-json action="/auftragszentrale/<%= project.id %>/material"><input type="hidden" name="revision" value="<%= current.revision %>"><div class="bill-table-scroll"><table class="bill-table flow-material"><thead><tr><th>Bedarf</th><th>Bestand zuweisen</th><th>Deckung / Einkauf</th></tr></thead><tbody>
<% materials.forEach(r=>{ %><tr><td><strong><%= r.name %></strong><small><%= r.material %> · <%= r.dimensions %> mm · <%= r.finish %><br><%= num(r.quantity) %> Teile · <%= num(r.needed) %> <%= r.unit %><br><%= r.drawingName %> · Rev. <%= r.revision %></small></td><td><label class="bill-field">Lagerposition<select name="stock_<%= r.key %>"><option value="">Noch nicht zugeordnet</option><% stock.filter(s=>r.unit==='m'?String(s.einheit).toLowerCase()==='m':['stk','stück','stueck'].includes(String(s.einheit).toLowerCase())).forEach(s=>{ %><option value="<%= s.id %>" <%= String(r.link.stockId)===String(s.id)?'selected':'' %>><%= s.bezeichnung %> <%= s.profil||'' %> · <%= s.material_type %> · <%= num(s.menge) %> <%= s.einheit %></option><% }); %></select></label><% if(r.length){ %><label class="bill-field">Reststück (Länge in mm)<select name="rest_<%= r.key %>"><option value="">Kein Reststück</option><% offcuts.forEach(s=>{ %><option value="<%= s.id %>" <%= String(r.link.offcutId)===String(s.id)?'selected':'' %>><%= s.bezeichnung %> <%= s.profil||'' %> · <%= s.material_type %> · <%= s.laenge %> mm × <%= num(s.menge) %></option><% }); %></select></label><% } %></td><td><small><%= r.restCount %> aus Reststücken<br><%= r.stockCount %> aus Lager</small><strong class="<%= r.missingCount?'flow-warn':'flow-good' %>"><%= r.missingCount?num(r.missing)+' '+r.unit+' fehlen':'Bedarf gedeckt' %></strong><small><%= r.missingCount %> Teile zu beschaffen</small></td></tr><% }); %>
</tbody></table></div><div class="bill-actions"><button class="bill-btn bill-primary">Zuordnung speichern &amp; abgleichen</button><a class="bill-btn" href="/auftragszentrale/<%= project.id %>/einkauf.csv">Einkaufsliste herunterladen</a><a class="bill-btn" href="/schnittliste">Zuschnitt optimieren</a></div><p class="bill-hint" data-form-status role="status">Die Einkaufsliste verwendet den zuletzt gespeicherten Stand und den aktuellen Lagerbestand.</p></form><% }else{ %><p class="bill-muted">Noch keine CAD-Bauteile vorhanden.</p><% } %></section><% } %>
<% if(cost){ %><section class="bill-card" id="kalkulation"><h2>Soll / Ist · Nachkalkulation</h2><p class="bill-hint">Interner Stundensatz für die Kostenrechnung. Ist-Material aus den gebuchten Lagerentnahmen; offene Arbeitszeiten werden erst nach dem Ausstempeln gezählt. Ergebnis vor weiteren Gemeinkosten.</p><div class="bill-table-scroll"><table class="bill-table"><thead><tr><th></th><th>Soll</th><th>Ist</th><th>Abweichung</th></tr></thead><tbody><tr><th>Arbeitsstunden</th><td><%= num(cost.plannedHours) %> h</td><td><%= num(cost.hours) %> h</td><td><%= num(cost.hoursDelta) %> h</td></tr><tr><th>Material netto</th><td><%= money(cost.plannedMaterial) %></td><td><%= money(cost.material) %></td><td><%= money(cost.materialDelta) %></td></tr><tr><th>Gesamtkosten</th><td><%= money(cost.planned) %></td><td><%= money(cost.actual) %></td><td><%= cost.planned==null?'—':money(cost.actual-cost.planned) %></td></tr><tr><th>Ergebnis bei <%= money(cost.revenue) %> Angebotsnetto</th><td><%= money(cost.plannedProfit) %></td><td><%= money(cost.profit) %></td><td></td></tr></tbody></table></div>
<% if(p.admin&&p.documents){ %><details class="bill-disclosure" <%= !offer?'open':'' %>><summary>Planwerte &amp; Angebot bearbeiten</summary><form method="POST" action="/auftragszentrale/<%= project.id %>/plan" class="bill-action-form"><input type="hidden" name="revision" value="<%= current.revision %>"><div class="bill-grid"><label class="bill-field bill-wide">Verknüpftes Angebot<select name="offer_id"><option value="">Kein Angebot zugeordnet</option><% offers.forEach(o=>{ %><option value="<%= o.id %>" <%= Number(o.id)===Number(project.offer_id)?'selected':'' %>><%= o.doc_number %> · <%= o.status %></option><% }); %></select></label><label class="bill-field">Sollstunden<input name="hours" type="number" min="0" max="100000" step="0.01" value="<%= cost.plannedHours??'' %>"></label><label class="bill-field">Soll-Material netto €<input name="material" type="number" min="0" step="0.01" value="<%= cost.plannedMaterial??'' %>"></label><label class="bill-field">Interner Stundensatz €<input name="hourlyRate" type="number" min="0" max="100000" step="0.01" value="<%= cost.rate %>"></label></div><button class="bill-btn bill-primary">Planwerte speichern</button></form></details><% } %></section><% } %>
<% if(p.documents){ %><section class="bill-card" id="belege"><div class="bill-section-head"><h2>Belege dieses Auftrags</h2><% if(p.amounts){ %><a class="bill-btn bill-primary" href="/documents/neu/rechnung?project_id=<%= project.id %>">Rechnung vorbereiten</a><% } %></div><div class="flow-links"><% if(offer){ %><a class="bill-btn" href="/documents/offers/<%= offer.id %>/detail">Angebot <%= offer.doc_number %></a><% } %><% invoices.forEach(d=>{ %><a class="bill-btn" href="/documents/invoices/<%= d.id %>"><%= d.doc_number %> · <%= d.status %></a><% }); %></div></section><% } %>
</div></main><script src="/js/workflow.js" defer></script></body></html>
