<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex flex-col overflow-y-auto page-bg min-h-screen pt-16">

  <div class="px-4 md:px-6 pt-3 pb-2 flex items-center justify-between gap-2">
    <div>
      <h1 class="text-lg font-bold text-slate-800 dark:text-slate-100">Mein Tag</h1>
      <p class="text-xs text-slate-500"><%= stats.monthLabel %> · <%= typeof roleLabel !== 'undefined' ? roleLabel : 'Mitarbeiter' %></p>
    </div>
    <div class="flex items-center gap-2">
      <span id="dash-worked-today-badge" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/30 px-2.5 py-1 rounded-full">–</span>
      <button id="emp-layout-btn" onclick="empToggleDragMode()" class="text-xs px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-600 text-slate-500">Layout</button>
    </div>
  </div>

  <div class="px-4 md:px-6 max-w-5xl mx-auto w-full space-y-3 pb-24">

    <!-- Shortcuts mobil -->
    <div class="grid grid-cols-4 gap-2 md:hidden">
      <a href="/timetracking" class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-2.5 text-center no-underline">
        <p class="text-xs font-bold text-slate-800 dark:text-slate-100">Zeit</p>
      </a>
      <a href="/projects" class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-2.5 text-center no-underline">
        <p class="text-xs font-bold text-slate-800 dark:text-slate-100">Aufträge</p>
      </a>
      <a href="/lager" class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-2.5 text-center no-underline">
        <p class="text-xs font-bold text-slate-800 dark:text-slate-100">Lager</p>
      </a>
      <a href="/map" class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-2.5 text-center no-underline">
        <p class="text-xs font-bold text-slate-800 dark:text-slate-100">Karte</p>
      </a>
    </div>

    <!-- Stempel -->
    <div class="emp-dash-section rounded-2xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4" data-section="stempel-widget">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-[10px] uppercase font-semibold text-slate-400 tracking-wide">Status</p>
          <p class="text-base font-bold <%= stats.isStampedIn ? 'text-emerald-600' : 'text-slate-600 dark:text-slate-300' %>">
            <% if (stats.isStampedIn) { %><span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-1 align-middle"></span><% } %>
            <%= stats.isStampedIn ? 'Eingestempelt' : 'Nicht eingestempelt' %>
          </p>
          <p class="text-xs text-slate-400 mt-0.5">Heute: <strong id="dash-worked-today" class="text-slate-600 dark:text-slate-300">–</strong></p>
        </div>
        <div class="shrink-0">
          <% if (!stats.isStampedIn) { %>
            <form action="/timetracking/stamp" method="POST" id="dash-stamp-in-form">
              <input type="hidden" name="type" value="IN">
              <input type="hidden" name="latitude" id="dash-lat">
              <input type="hidden" name="longitude" id="dash-lng">
              <button type="button" onclick="dashStampIn()" id="dash-stamp-in-btn"
                class="px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm">
                Einstempeln
              </button>
            </form>
            <p id="dash-gps-status" class="text-[10px] text-slate-400 mt-1 text-right hidden"></p>
          <% } else { %>
            <form action="/timetracking/stamp" method="POST">
              <input type="hidden" name="type" value="OUT">
              <button type="submit" class="px-5 py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-sm">
                Ausstempeln
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Fortschritt Monat -->
    <div class="emp-dash-section rounded-2xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4 <%= stats.trafficBg || '' %>" data-section="ampel">
      <div class="flex items-center justify-between gap-2 mb-2">
        <p class="text-sm font-bold <%= stats.trafficColor || 'text-slate-700' %>"><%= stats.trafficText %></p>
        <p class="text-xs text-slate-400 tabular-nums"><%= stats.monthTotalHours %> / <%= stats.targetHours %> h</p>
      </div>
      <div class="w-full bg-slate-200 dark:bg-slate-600 rounded-full h-2">
        <div class="h-2 rounded-full transition-all" style="width:<%= Math.min(100, stats.progressPct || 0) %>%;background:<%= stats.progressColor || '#3b82f6' %>"></div>
      </div>
    </div>

    <!-- KPIs -->
    <div class="emp-dash-section grid grid-cols-3 gap-2" data-section="statistik">
      <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-3 text-center">
        <p class="text-[10px] uppercase font-semibold text-slate-400">Woche</p>
        <p class="text-lg font-bold text-slate-800 dark:text-slate-100 tabular-nums"><%= stats.weekTotalHours %></p>
        <p class="text-[10px] text-slate-400">Std.</p>
      </div>
      <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-3 text-center">
        <p class="text-[10px] uppercase font-semibold text-slate-400">Monat</p>
        <p class="text-lg font-bold text-slate-800 dark:text-slate-100 tabular-nums"><%= stats.monthTotalHours %></p>
        <p class="text-[10px] text-slate-400">Soll <%= stats.targetHours %></p>
      </div>
      <div class="rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-3 text-center">
        <p class="text-[10px] uppercase font-semibold text-slate-400">Saldo</p>
        <p class="text-lg font-bold tabular-nums <%= parseFloat(stats.overtimeHours) >= 0 ? 'text-emerald-600' : 'text-red-600' %>">
          <%= parseFloat(stats.overtimeHours) >= 0 ? '+' : '' %><%= stats.overtimeHours %>
        </p>
        <p class="text-[10px] text-slate-400">Std.</p>
      </div>
    </div>

    <!-- Aufgaben -->
    <div class="emp-dash-section rounded-2xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4" data-section="meine-aufgaben">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">Meine Aufgaben</h2>
        <a href="/tasks" class="text-xs font-semibold text-blue-600">Alle →</a>
      </div>
      <% if (typeof myTasks !== 'undefined' && myTasks.length > 0) { %>
        <ul class="space-y-2">
          <% myTasks.forEach(t => {
              const catIcon = { 'Werkstatt': '🏭', 'Auto': '🚐', 'Baustelle': '🏗️', 'Sonstiges': '📌' }[t.category] || '📌';
              const isOverdue = t.due_date && t.due_date !== '' && new Date(t.due_date) < new Date(new Date().toDateString());
          %>
            <li class="flex items-center gap-2 rounded-xl bg-slate-50 dark:bg-slate-700/50 px-3 py-2.5">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate"><%= catIcon %> <%= t.title %></p>
                <p class="text-[11px] text-slate-400">
                  <%= t.assigned_by_name || '–' %>
                  <% if (t.due_date) { %> · <span class="<%= isOverdue ? 'text-red-500 font-semibold' : '' %>"><%= t.due_date %></span><% } %>
                </p>
              </div>
              <form action="/tasks/status" method="POST" class="shrink-0">
                <input type="hidden" name="id" value="<%= t.id %>">
                <input type="hidden" name="status" value="Erledigt">
                <button type="submit" class="w-9 h-9 rounded-lg bg-emerald-600 text-white flex items-center justify-center text-sm font-bold">✓</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-sm text-slate-400 text-center py-4">Keine offenen Aufgaben.</p>
      <% } %>
    </div>

    <!-- Schwarzes Brett -->
    <div class="emp-dash-section rounded-2xl border border-amber-200 dark:border-amber-800 bg-amber-50/60 dark:bg-amber-900/20 p-4" data-section="schwarzes-brett">
      <h2 class="text-sm font-bold text-amber-800 dark:text-amber-200 mb-2">Schwarzes Brett</h2>
      <% if (tickers && tickers.length > 0) { %>
        <ul class="space-y-2">
          <% tickers.forEach(t => { %>
            <li class="rounded-xl bg-white dark:bg-slate-800 border border-amber-100 dark:border-slate-700 px-3 py-2.5">
              <p class="text-sm text-slate-800 dark:text-slate-200"><%= t.message %></p>
              <p class="text-[10px] text-slate-400 mt-1"><%= t.author %> · <%= new Date(t.created_at).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' }) %></p>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-sm text-amber-700/70 dark:text-amber-400/70 text-center py-3">Keine Nachrichten.</p>
      <% } %>
    </div>

    <!-- Letzte Stempel -->
    <div class="emp-dash-section rounded-2xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-4" data-section="stempel-eintraege">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">Letzte Stempel</h2>
        <a href="/timetracking" class="text-xs font-semibold text-blue-600">Details →</a>
      </div>
      <% if (typeof recentLogs !== 'undefined' && recentLogs.length > 0) { %>
        <ul class="divide-y divide-slate-100 dark:divide-slate-700">
          <% recentLogs.forEach(log => { %>
            <li class="py-2.5 flex items-center justify-between gap-2 text-sm">
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full <%= log.type === 'IN' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                <%= log.type === 'IN' ? 'IN' : 'OUT' %>
              </span>
              <span class="text-xs text-slate-600 dark:text-slate-300 flex-1"><%= new Date(log.timestamp).toLocaleString('de-DE') %></span>
              <span class="text-[11px] text-slate-400 truncate max-w-[30%]"><%= log.note || '' %></span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-sm text-slate-400 text-center py-4">Keine Einträge diesen Monat.</p>
      <% } %>
    </div>

  </div>
</main>

<style>
  .emp-dash-section { transition: outline .15s, opacity .15s; }
  .emp-drag-mode .emp-dash-section {
    outline: 2px dashed #94a3b8;
    outline-offset: 3px;
    cursor: grab;
    border-radius: .75rem;
  }
  .emp-drag-mode .emp-dash-section:active { cursor: grabbing; }
  .emp-drag-mode .emp-dash-section.drag-over {
    outline: 2.5px solid #3b82f6;
    background: rgba(59,130,246,.06);
  }
  #emp-drag-banner {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: #1e293b; color: #e2e8f0;
    text-align: center; padding: .6rem 1rem;
    font-size: .8rem; font-weight: 600; z-index: 200;
    border-top: 2px solid #3b82f6;
    display: none;
  }
  @media (min-width: 768px) {
    #emp-drag-banner { left: 18rem; }
  }
</style>

<div id="emp-drag-banner">Layout-Modus – Blöcke verschieben, dann erneut „Layout“ tippen</div>

<script>
const EMP_LS_KEY = 'emp_dash_order';
let empDragMode  = false;
let empDragSrc   = null;

function empApplyOrder() {
  const saved = localStorage.getItem(EMP_LS_KEY);
  if (!saved) return;
  try {
    const order = JSON.parse(saved);
    const container = document.querySelector('.space-y-3');
    if (!container) return;
    order.forEach(key => {
      const el = container.querySelector(`[data-section="${key}"]`);
      if (el) container.appendChild(el);
    });
  } catch (_) {}
}

function empSaveOrder() {
  const container = document.querySelector('.space-y-3');
  if (!container) return;
  const order = [...container.querySelectorAll('.emp-dash-section')].map(el => el.dataset.section);
  localStorage.setItem(EMP_LS_KEY, JSON.stringify(order));
}

function empToggleDragMode() {
  empDragMode = !empDragMode;
  const container = document.querySelector('.space-y-3');
  const btn     = document.getElementById('emp-layout-btn');
  const banner  = document.getElementById('emp-drag-banner');
  if (empDragMode) {
    container.classList.add('emp-drag-mode');
    btn.style.background = '#3b82f6';
    btn.style.color = '#fff';
    banner.style.display = 'block';
    document.querySelectorAll('.emp-dash-section').forEach(el => {
      el.setAttribute('draggable', 'true');
    });
  } else {
    container.classList.remove('emp-drag-mode');
    btn.style.background = '';
    btn.style.color = '';
    banner.style.display = 'none';
    document.querySelectorAll('.emp-dash-section').forEach(el => {
      el.setAttribute('draggable', 'false');
      el.classList.remove('drag-over');
    });
    empSaveOrder();
    if (typeof showToast === 'function') showToast('Layout gespeichert ✓', 'success', 2000);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  empApplyOrder();

  fetch('/api/today-hours')
    .then(r => r.json())
    .then(d => {
      const el1 = document.getElementById('dash-worked-today');
      const el2 = document.getElementById('dash-worked-today-badge');
      if (el1) el1.textContent = d.label || '–';
      if (el2) el2.textContent = d.label || '–';
    }).catch(() => {});

  document.querySelectorAll('.emp-dash-section').forEach(el => {
    el.addEventListener('dragstart', e => {
      if (!empDragMode) { e.preventDefault(); return; }
      empDragSrc = el;
      setTimeout(() => el.style.opacity = '.45', 0);
    });
    el.addEventListener('dragend', () => {
      el.style.opacity = '';
      document.querySelectorAll('.emp-dash-section').forEach(s => s.classList.remove('drag-over'));
    });
    el.addEventListener('dragover', e => {
      if (!empDragMode || el === empDragSrc) return;
      e.preventDefault();
      document.querySelectorAll('.emp-dash-section').forEach(s => s.classList.remove('drag-over'));
      el.classList.add('drag-over');
    });
    el.addEventListener('drop', e => {
      if (!empDragMode || el === empDragSrc) return;
      e.preventDefault();
      const container = document.querySelector('.space-y-3');
      const els = [...container.querySelectorAll('.emp-dash-section')];
      const srcIdx = els.indexOf(empDragSrc);
      const tgtIdx = els.indexOf(el);
      if (srcIdx < tgtIdx) container.insertBefore(empDragSrc, el.nextSibling);
      else container.insertBefore(empDragSrc, el);
      el.classList.remove('drag-over');
    });

    let touchStartY = 0;
    el.addEventListener('touchstart', e => {
      if (!empDragMode) return;
      empDragSrc = el;
      touchStartY = e.touches[0].clientY;
      el.style.opacity = '.55';
    }, { passive: true });
    el.addEventListener('touchend', e => {
      if (!empDragMode) return;
      el.style.opacity = '';
      const touch = e.changedTouches[0];
      const target = document.elementFromPoint(touch.clientX, touch.clientY)?.closest('.emp-dash-section');
      if (target && target !== empDragSrc) {
        const container = document.querySelector('.space-y-3');
        const els = [...container.querySelectorAll('.emp-dash-section')];
        const srcIdx = els.indexOf(empDragSrc);
        const tgtIdx = els.indexOf(target);
        if (srcIdx < tgtIdx) container.insertBefore(empDragSrc, target.nextSibling);
        else container.insertBefore(empDragSrc, target);
      }
      document.querySelectorAll('.emp-dash-section').forEach(s => s.classList.remove('drag-over'));
    });
  });
});

function dashStampIn() {
  const btn    = document.getElementById('dash-stamp-in-btn');
  const status = document.getElementById('dash-gps-status');

  if (!navigator.geolocation) {
    document.getElementById('dash-stamp-in-form').submit();
    return;
  }

  btn.disabled = true;
  btn.textContent = 'GPS…';
  if (status) {
    status.textContent = 'Standort wird ermittelt…';
    status.classList.remove('hidden');
  }

  navigator.geolocation.getCurrentPosition(
    (pos) => {
      document.getElementById('dash-lat').value = pos.coords.latitude;
      document.getElementById('dash-lng').value = pos.coords.longitude;
      if (status) status.textContent = 'Standort ok – stemple…';
      document.getElementById('dash-stamp-in-form').submit();
    },
    () => {
      if (status) {
        status.textContent = 'GPS nicht verfügbar – wird versucht…';
        status.classList.remove('hidden');
      }
      btn.disabled = false;
      btn.textContent = 'Einstempeln';
      document.getElementById('dash-stamp-in-form').submit();
    },
    { timeout: 10000, enableHighAccuracy: true }
  );
}
</script>

</body>
</html>
