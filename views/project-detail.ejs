<script>
// ================================================
// GEO-FENCING: ADRESSSUCHE & STANDORT-HELFER
// ================================================

// Freitextsuche über OpenStreetMap Nominatim (kein API-Key nötig)
async function geocodeAddress() {
  const input = document.getElementById('geo-address-input');
  const status = document.getElementById('geo-status');
  const address = input ? input.value.trim() : '';

  if (!address) {
    showGeoStatus('⚠️ Bitte zuerst eine Adresse eingeben.', 'text-amber-600');
    return;
  }

  showGeoStatus('⏳ Suche läuft…', 'text-slate-400');

  try {
    const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(address)}&format=json&limit=1&addressdetails=1`;
    const res = await fetch(url, { headers: { 'Accept-Language': 'de' } });
    const data = await res.json();

    if (!data || data.length === 0) {
      showGeoStatus('❌ Adresse nicht gefunden. Bitte genauer eingeben.', 'text-red-600');
      return;
    }

    const result = data[0];
    const lat = parseFloat(result.lat).toFixed(7);
    const lng = parseFloat(result.lon).toFixed(7);
    const displayName = result.display_name;

    document.getElementById('geo-lat').value = lat;
    document.getElementById('geo-lng').value = lng;

    showGeoStatus(`✅ Gefunden: ${displayName}`, 'text-green-700');
  } catch (e) {
    showGeoStatus('❌ Netzwerkfehler beim Suchen. Bitte Internetverbindung prüfen.', 'text-red-600');
  }
}

// Kundenadresse in Suchfeld eintragen und sofort geocodieren
function useCustomerAddress(address) {
  const input = document.getElementById('geo-address-input');
  if (input) {
    input.value = address;
    geocodeAddress();
  }
}

// Hilfsfunktion: Status-Text anzeigen
function showGeoStatus(msg, colorClass) {
  const el = document.getElementById('geo-status');
  if (!el) return;
  el.textContent = msg;
  el.className = `text-[10px] mt-1 ${colorClass}`;
  el.classList.remove('hidden');
}

// GPS-Standort des Geräts nutzen
function useMyLocationForProject() {
  if (!navigator.geolocation) {
    alert('Geolocation wird von diesem Browser nicht unterstützt.');
    return;
  }
  navigator.geolocation.getCurrentPosition(
    (pos) => {
      const lat = pos.coords.latitude.toFixed(7);
      const lng = pos.coords.longitude.toFixed(7);
      document.getElementById('geo-lat').value = lat;
      document.getElementById('geo-lng').value = lng;
      showGeoStatus(`📍 GPS-Standort übernommen: ${lat}, ${lng}`, 'text-green-700');
    },
    () => { showGeoStatus('⚠️ GPS-Standort konnte nicht ermittelt werden.', 'text-amber-600'); },
    { timeout: 10000, enableHighAccuracy: true }
  );
}

// Enter-Taste im Adressfeld auslösen
document.addEventListener('DOMContentLoaded', () => {
  const inp = document.getElementById('geo-address-input');
  if (inp) inp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); geocodeAddress(); } });
});

</script>


<% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') { %>
<script>
// ================================================
// KI-CHECKLISTE
// ================================================
let _kiChecklistTasks = [];

function openKiChecklistModal() {
  document.getElementById('kiChecklistModal').classList.remove('hidden');
  document.getElementById('kiChecklistError').classList.add('hidden');
  document.getElementById('kiChecklistLoading').classList.add('hidden');
  document.getElementById('kiChecklistResults').classList.add('hidden');
  document.getElementById('kiChecklistAcceptBtn').classList.add('hidden');
}

async function generateKiChecklist() {
  const btn     = document.getElementById('kiChecklistGenerateBtn');
  const loading = document.getElementById('kiChecklistLoading');
  const errorBox= document.getElementById('kiChecklistError');
  const results = document.getElementById('kiChecklistResults');
  const acceptBtn= document.getElementById('kiChecklistAcceptBtn');

  btn.disabled = true; btn.textContent = '⏳ Lädt…';
  loading.classList.remove('hidden');
  errorBox.classList.add('hidden');
  results.classList.add('hidden');
  acceptBtn.classList.add('hidden');

  try {
    const res  = await fetch('/projects/<%= project.id %>/ai-checklist', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin'
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'Unbekannter Fehler');

    _kiChecklistTasks = data.tasks || [];
    const catColors = { 'Restarbeit': 'bg-blue-100 text-blue-800', 'Mangel': 'bg-red-100 text-red-800', 'Bestellung': 'bg-purple-100 text-purple-800' };

    results.innerHTML = _kiChecklistTasks.map((t, i) => `
      <label class="flex items-center gap-3 bg-slate-50 dark:bg-slate-700 border dark:border-slate-600 rounded-lg px-3 py-2 cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-600 transition">
        <input type="checkbox" class="ki-task-cb w-4 h-4 accent-violet-600" data-idx="${i}" checked>
        <span class="flex-1 text-sm text-slate-800 dark:text-gray-100">${t.title || ''}</span>
        <span class="text-[10px] font-semibold px-2 py-0.5 rounded ${catColors[t.category] || 'bg-slate-100 text-slate-600'}">${t.category || 'Restarbeit'}</span>
      </label>`).join('');

    results.classList.remove('hidden');
    acceptBtn.classList.remove('hidden');
  } catch (err) {
    errorBox.textContent = '❌ ' + err.message;
    errorBox.classList.remove('hidden');
  } finally {
    loading.classList.add('hidden');
    btn.disabled = false; btn.textContent = '✨ Neu laden';
  }
}

async function acceptKiChecklist() {
  const checked = Array.from(document.querySelectorAll('.ki-task-cb:checked'))
    .map(cb => _kiChecklistTasks[parseInt(cb.dataset.idx)])
    .filter(Boolean);

  if (!checked.length) { alert('Keine Aufgaben ausgewählt.'); return; }

  const acceptBtn = document.getElementById('kiChecklistAcceptBtn');
  acceptBtn.disabled = true; acceptBtn.textContent = '⏳ Speichert…';

  try {
    for (const task of checked) {
      const body = new URLSearchParams();
      body.append('title', task.title || '');
      body.append('category', task.category || 'Restarbeit');
      body.append('description', '');
      await fetch('/projects/<%= project.id %>/tasks/add', {
        method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        credentials: 'same-origin', body: body.toString()
      });
    }
    document.getElementById('kiChecklistModal').classList.add('hidden');
    window.location.reload();
  } catch (err) {
    alert('Fehler beim Speichern: ' + err.message);
    acceptBtn.disabled = false; acceptBtn.textContent = '✅ Ausgewählte übernehmen';
  }
}

// ── KI-Mängelanalyse ────────────────────────────────────────────────────────
let _kiDefectResult = null;

function onTaskPhotoSelected(input) {
  const btn = document.getElementById('kiDefectBtn');
  btn.classList.toggle('hidden', !input.files || input.files.length === 0);
  // Vorheriges Ergebnis ausblenden wenn neues Foto gewählt
  document.getElementById('kiDefectSuggestion').classList.add('hidden');
  _kiDefectResult = null;
}

async function runDefectAnalysis() {
  const input = document.getElementById('taskPhotoInput');
  if (!input.files || input.files.length === 0) return;

  const suggEl   = document.getElementById('kiDefectSuggestion');
  const statusEl = document.getElementById('kiDefectStatus');
  const bodyEl   = document.getElementById('kiDefectBody');
  const btn      = document.getElementById('kiDefectBtn');

  suggEl.classList.remove('hidden');
  bodyEl.classList.add('hidden');
  statusEl.textContent = '⏳ KI analysiert Foto…';
  btn.disabled = true;

  const formData = new FormData();
  formData.append('image', input.files[0]);
  // Hinweis aus dem Titel-Feld mitgeben falls ausgefüllt
  const titleInput = document.querySelector('input[name="title"]');
  if (titleInput && titleInput.value.trim()) formData.append('hint', titleInput.value.trim());

  try {
    const res  = await fetch('/api/ai/defect-analyze', { method: 'POST', credentials: 'same-origin', body: formData });
    const data = await res.json();
    if (!res.ok || data.error) {
      statusEl.textContent = '❌ ' + (data.error || 'Fehler bei der Analyse');
      return;
    }
    _kiDefectResult = data.result;
    statusEl.textContent = '✅ Analyse abgeschlossen';
    document.getElementById('kiDefectTitle').textContent = data.result.title || '';
    document.getElementById('kiDefectDesc').textContent  = data.result.description || '';
    document.getElementById('kiDefectCat').textContent   = data.result.category || '';
    const sevMap = { 'gering': 'Schweregrad: gering', 'mittel': 'Schweregrad: mittel', 'hoch': '⚠️ Schweregrad: hoch' };
    document.getElementById('kiDefectSev').textContent   = sevMap[data.result.severity] || data.result.severity || '';
    bodyEl.classList.remove('hidden');
  } catch (e) {
    statusEl.textContent = '❌ Netzwerkfehler';
  } finally {
    btn.disabled = false;
  }
}

function acceptDefectSuggestion() {
  if (!_kiDefectResult) return;
  const titleInput = document.querySelector('input[name="title"]');
  const descInput  = document.querySelector('textarea[name="description"]');
  const catSelect  = document.querySelector('select[name="category"]');
  if (titleInput && _kiDefectResult.title)       titleInput.value = _kiDefectResult.title;
  if (descInput  && _kiDefectResult.description) descInput.value  = _kiDefectResult.description;
  if (catSelect  && _kiDefectResult.category) {
    const opt = Array.from(catSelect.options).find(o => o.value === _kiDefectResult.category);
    if (opt) catSelect.value = _kiDefectResult.category;
  }
  document.getElementById('kiDefectSuggestion').classList.add('hidden');
}
</script>
<% } %>

