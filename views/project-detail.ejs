<%- include('partials/header') %>
<%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">
    <header class="bg-white dark:bg-slate-800 shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
      <div>
        <a href="/projects" class="text-xs text-blue-600 hover:underline">← Zurück zur Übersicht</a>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100"><%= project.title %></h1>
      </div>
      <div class="flex items-center gap-2">
        <%
          const headerStatusColors = {
            'In Planung':         'bg-slate-100 text-slate-700',
            'Avor / Vorbereitung':'bg-blue-100 text-blue-800',
            'In Produktion':      'bg-amber-100 text-amber-800',
            'Oberfläche':         'bg-purple-100 text-purple-800',
            'Montagebereit':      'bg-emerald-100 text-emerald-800',
            'Montage läuft':      'bg-orange-100 text-orange-800',
            'Abgeschlossen':      'bg-green-100 text-green-800'
          };
          const hsc = headerStatusColors[project.status] || 'bg-blue-100 text-blue-800';
        %>
        <span class="px-3 py-1 rounded text-sm font-semibold <%= hsc %>"><%= project.status %></span>
        <% if (currentUser.role === 'ADMIN') { %>
          <a href="/projects/<%= project.id %>/pdf" target="_blank"
            class="px-3 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 rounded text-xs font-semibold transition flex items-center gap-1">
            📄 Lieferschein PDF
          </a>
          <a href="/projects/<%= project.id %>/create-invoice"
            class="px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white border border-blue-700 rounded text-xs font-semibold transition flex items-center gap-1">
            🧾 Rechnung erstellen
          </a>
          <button onclick="document.getElementById('editProjectModal').classList.remove('hidden')"
            class="px-3 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded text-xs font-semibold transition">
            ✏️ Bearbeiten
          </button>

          <!-- KI-Angebot Button -->
          <button id="aiGenerateBtn" onclick="generateAIQuote()"
            class="px-3 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 rounded text-xs font-semibold transition flex items-center gap-1">
            🤖 KI-Angebot erstellen
          </button>
        <% } %>
      </div>
    </header>

    <div class="p-4 md:p-6 max-w-7xl mx-auto w-full space-y-6">

      <!-- KI-Angebot Panel (initial versteckt) -->
      <div id="aiQuoteContainer" class="hidden bg-white dark:bg-slate-800 rounded-lg shadow p-4 md:p-6 space-y-4">
        <h3 class="text-lg font-semibold text-slate-800 dark:text-gray-100">🤖 Generiertes KI-Angebot (bearbeitbar)</h3>
        <textarea id="aiQuoteTextarea" class="w-full h-56 p-3 border rounded resize-y text-sm" placeholder="Hier erscheint das generierte Angebot..."></textarea>
        <div class="flex gap-3">
          <button onclick="saveAIQuote()" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-sm font-semibold">💾 Als Notiz speichern</button>
          <button id="aiCancelBtn" onclick="document.getElementById('aiQuoteContainer').classList.add('hidden')"
            class="px-3 py-1 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded text-sm">Abbrechen</button>
          <span id="aiStatus" class="text-sm text-gray-500 self-center"></span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Kundendaten & Details -->
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 md:p-6 space-y-4">
          <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📋 Projektdetails</h2>
          <div>
            <span class="text-xs text-slate-400 dark:text-slate-500 block">Kunde / Baustelle</span>
            <strong class="text-slate-700 dark:text-gray-200"><%= project.company_name || project.contact_person %></strong>
            <p class="text-sm text-slate-600 dark:text-slate-300"><%= project.street %>, <%= project.zip %> <%= project.city %></p>
          </div>

<!-- rest of original view unchanged -->
