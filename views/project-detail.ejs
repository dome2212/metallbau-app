<%- include('partials/header') %>
<%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 min-h-screen pt-16 md:pt-6">
    <header class="bg-white shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
      <div>
        <a href="/projects" class="text-xs text-blue-600 hover:underline">← Zurück zur Übersicht</a>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800"><%= project.title %></h1>
      </div>
      <div class="flex items-center gap-2">
        <%
          const headerStatusColors = {
            'In Planung':         'bg-slate-100 text-slate-700',
            'Avor / Vorbereitung':'bg-blue-100 text-blue-800',
            'In Produktion':      'bg-amber-100 text-amber-800',
            'Oberfläche':         'bg-purple-100 text-purple-800',
            'Montagebereit':      'bg-emerald-100 text-emerald-800',
            'Montage läuft':      'bg-orange-100 text-orange-800',
            'Abgeschlossen':      'bg-green-100 text-green-800'
          };
          const hsc = headerStatusColors[project.status] || 'bg-blue-100 text-blue-800';
        %>
        <span class="px-3 py-1 rounded text-sm font-semibold <%= hsc %>"><%= project.status %></span>
        <% if (currentUser.role === 'ADMIN') { %>
          <button onclick="document.getElementById('editProjectModal').classList.remove('hidden')"
            class="px-3 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded text-xs font-semibold transition">
            ✏️ Bearbeiten
          </button>
        <% } %>
      </div>
    </header>

    <div class="p-4 md:p-6 max-w-7xl mx-auto w-full space-y-6">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Kundendaten & Details -->
        <div class="bg-white rounded-lg shadow p-4 md:p-6 space-y-4">
          <h2 class="text-lg font-semibold text-slate-800 border-b pb-2">📋 Projektdetails</h2>
          <div>
            <span class="text-xs text-slate-400 block">Kunde / Baustelle</span>
            <strong class="text-slate-700"><%= project.company_name || project.contact_person %></strong>
            <p class="text-sm text-slate-600"><%= project.street %>, <%= project.zip %> <%= project.city %></p>
          </div>
          
          <!-- Auftragssumme nur für den Chef (ADMIN) sichtbar -->
          <% if (currentUser.role === 'ADMIN') { %>
            <div>
              <span class="text-xs text-slate-400 block">Auftragssumme</span>
              <span class="text-xl font-bold text-slate-800"><%= (Number(project.total_price) || 0).toLocaleString('de-DE', {minimumFractionDigits: 2}) %> €</span>
            </div>
          <% } %>

          <div>
            <span class="text-xs text-slate-400 block">Beschreibung</span>
            <p class="text-sm text-slate-600"><%= project.description || 'Keine Beschreibung hinterlegt.' %></p>
          </div>

          <!-- Baustellenkoordinaten (Geo-Fencing) — nur Admin -->
          <% if (currentUser.role === 'ADMIN') { %>
            <div class="border-t pt-4 space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">📍 Geo-Fencing Standort</span>
                <% if (project.site_lat && project.site_lng) { %>
                  <span class="text-xs bg-green-100 text-green-700 font-semibold px-2 py-0.5 rounded-full">Aktiv</span>
                <% } else { %>
                  <span class="text-xs bg-slate-100 text-slate-500 font-semibold px-2 py-0.5 rounded-full">Nicht gesetzt</span>
                <% } %>
              </div>
              <% if (project.site_lat && project.site_lng) { %>
                <p class="text-xs text-slate-500">
                  Lat: <strong><%= project.site_lat %></strong> · Lng: <strong><%= project.site_lng %></strong> · Radius: <strong><%= project.site_radius || 200 %> m</strong>
                </p>
              <% } %>
              <form action="/projects/<%= project.id %>/set-location" method="POST" class="space-y-2" id="geo-form">

                <!-- Adresssuche via OpenStreetMap Nominatim -->
                <div>
                  <label class="block text-[10px] text-slate-500 uppercase mb-0.5">Adresse suchen</label>
                  <div class="flex gap-1">
                    <input type="text" id="geo-address-input"
                      placeholder="z.B. Musterstraße 5, 45678 Musterstadt"
                      class="flex-1 text-xs border border-slate-300 rounded px-2 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-indigo-400">
                    <button type="button" onclick="geocodeAddress()"
                      class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium px-2.5 py-1.5 rounded transition whitespace-nowrap">
                      🔍 Suchen
                    </button>
                  </div>
                  <!-- Kundenadresse als Schnellauswahl -->
                  <% if (project.street && project.city) { %>
                    <button type="button"
                      onclick="useCustomerAddress('<%= (project.street + ', ' + (project.zip || '') + ' ' + project.city).trim().replace(/'/g, "\\'") %>')"
                      class="mt-1 w-full text-left text-[10px] text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 px-2 py-1 rounded border border-indigo-200 transition truncate">
                      🏢 Kundenadresse übernehmen: <%= project.street %>, <%= project.zip %> <%= project.city %>
                    </button>
                  <% } %>
                  <!-- Suchergebnis-Feedback -->
                  <p id="geo-status" class="text-[10px] mt-1 hidden"></p>
                </div>

                <!-- Koordinaten (werden automatisch gefüllt oder können manuell eingegeben werden) -->
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block text-[10px] text-slate-500 uppercase mb-0.5">Breitengrad (Lat)</label>
                    <input type="number" step="0.0000001" name="site_lat" id="geo-lat" value="<%= project.site_lat || '' %>" placeholder="z.B. 51.3069" class="w-full text-xs border border-slate-300 rounded px-2 py-1.5 bg-white">
                  </div>
                  <div>
                    <label class="block text-[10px] text-slate-500 uppercase mb-0.5">Längengrad (Lng)</label>
                    <input type="number" step="0.0000001" name="site_lng" id="geo-lng" value="<%= project.site_lng || '' %>" placeholder="z.B. 6.9483" class="w-full text-xs border border-slate-300 rounded px-2 py-1.5 bg-white">
                  </div>
                </div>
                <div>
                  <label class="block text-[10px] text-slate-500 uppercase mb-0.5">Erkennungsradius (Meter)</label>
                  <input type="number" name="site_radius" value="<%= project.site_radius || 200 %>" min="50" max="2000" class="w-full text-xs border border-slate-300 rounded px-2 py-1.5 bg-white">
                </div>
                <div class="flex gap-2">
                  <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium py-1.5 rounded transition">Koordinaten speichern</button>
                  <button type="button" onclick="useMyLocationForProject()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium py-1.5 rounded transition">📍 Meinen Standort</button>
                </div>
              </form>
            </div>
          <% } %>
        </div>

        <!-- Technische Zeichnungen & Dateien -->
        <div class="bg-white rounded-lg shadow p-4 md:p-6 space-y-4">
          <h2 class="text-lg font-semibold text-slate-800 border-b pb-2">📐 Technische Zeichnungen & Pläne</h2>
          
          <!-- Upload-Formular -->
          <form action="/projects/<%= project.id %>/upload" method="POST" enctype="multipart/form-data" class="space-y-3 bg-slate-50 p-4 rounded border">
            <label class="block text-xs font-medium text-slate-700">Zeichnung / Skizze / Foto hochladen (PDF, Bild)</label>
            <input type="file" name="file" required class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded transition">Datei hochladen</button>
          </form>

          <!-- Liste der hochgeladenen Dateien -->
          <div class="space-y-2">
            <% if (files && files.length > 0) { %>
              <% files.forEach(file => { %>
                <div class="flex justify-between items-center bg-slate-50 p-2.5 rounded border text-sm">
                  <span class="truncate max-w-xs text-slate-700">📄 <%= file.original_name %></span>
                  <div class="flex items-center gap-3 shrink-0">
                    <a href="<%= file.file_url %>" target="_blank" class="text-blue-600 hover:underline text-xs font-medium">Ansehen / Download</a>
                    
                    <!-- Lösch-Button für Dateien -->
                    <form action="/projects/files/delete" method="POST" onsubmit="return confirm('Datei wirklich löschen?');" class="inline">
                      <input type="hidden" name="file_id" value="<%= file.id %>">
                      <input type="hidden" name="project_id" value="<%= project.id %>">
                      <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 px-2 py-1 rounded text-xs font-medium transition">Löschen</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-xs text-slate-400 italic">Noch keine Zeichnungen oder Dokumente hochgeladen.</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- DIGITALES AUFMASS -->
      <!-- ========================================== -->
      <div class="bg-white rounded-lg shadow p-4 md:p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 border-b pb-2">📐 Digitales Aufmaß (Baustelle)</h2>
        
        <!-- Eingabeformular -->
        <form action="/projects/<%= project.id %>/measurements/add" method="POST" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-3 items-end bg-slate-50 p-4 rounded border">
          <div class="md:col-span-3">
            <label class="block text-xs font-medium text-slate-700 mb-1">Bauteil / Element *</label>
            <input type="text" name="component_name" class="w-full text-sm border border-slate-300 rounded px-3 py-2 bg-white" placeholder="z.B. Pfosten links" required>
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 mb-1">Breite (mm)</label>
            <input type="text" name="width" class="w-full text-sm border border-slate-300 rounded px-3 py-2 bg-white" placeholder="z.B. 1200">
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 mb-1">Höhe / Länge (mm)</label>
            <input type="text" name="height" class="w-full text-sm border border-slate-300 rounded px-3 py-2 bg-white" placeholder="z.B. 900">
          </div>
          <div class="md:col-span-1">
            <label class="block text-xs font-medium text-slate-700 mb-1">Winkel (°)</label>
            <input type="text" name="angle" class="w-full text-sm border border-slate-300 rounded px-3 py-2 bg-white" placeholder="z.B. 45">
          </div>
          <div class="md:col-span-1">
            <label class="block text-xs font-medium text-slate-700 mb-1">Anzahl</label>
            <input type="number" name="quantity" class="w-full text-sm border border-slate-300 rounded px-3 py-2 bg-white" value="1" min="1">
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 mb-1">Bemerkung</label>
            <input type="text" name="note" class="w-full text-sm border border-slate-300 rounded px-3 py-2 bg-white" placeholder="z.B. Dachschräge">
          </div>
          <div class="md:col-span-1">
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 rounded transition text-lg">+</button>
          </div>
        </form>

        <!-- Tabelle der bisherigen Aufmaße -->
        <h3 class="text-sm font-semibold text-slate-700 pt-2">Erfasste Maße:</h3>
        <% if (measurements && measurements.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm min-w-[600px]">
              <thead>
                <tr class="bg-slate-100 text-slate-600 border-b">
                  <th class="p-2.5">Bauteil</th>
                  <th class="p-2.5">Breite</th>
                  <th class="p-2.5">Höhe / Länge</th>
                  <th class="p-2.5">Winkel</th>
                  <th class="p-2.5">Anzahl</th>
                  <th class="p-2.5">Notiz</th>
                  <th class="p-2.5 text-right">Aktion</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                <% measurements.forEach(m => { %>
                  <tr class="hover:bg-slate-50">
                    <td class="p-2.5 font-semibold text-slate-800"><%= m.component_name %></td>
                    <td class="p-2.5 text-slate-600"><%= m.width ? m.width + ' mm' : '-' %></td>
                    <td class="p-2.5 text-slate-600"><%= m.height ? m.height + ' mm' : '-' %></td>
                    <td class="p-2.5 text-slate-600"><%= m.angle ? m.angle + '°' : '-' %></td>
                    <td class="p-2.5 text-slate-600"><%= m.quantity %></td>
                    <td class="p-2.5 text-slate-600"><%= m.note || '-' %></td>
                    <td class="p-2.5 text-right">
                      <form action="/projects/measurements/delete" method="POST" onsubmit="return confirm('Eintrag wirklich löschen?');" class="inline">
                        <input type="hidden" name="measurement_id" value="<%= m.id %>">
                        <input type="hidden" name="project_id" value="<%= project.id %>">
                        <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 px-2 py-1 rounded text-xs font-medium transition">Löschen</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-400 italic">Noch keine Maße für dieses Projekt erfasst.</p>
        <% } %>
      </div>

      <!-- ========================================== -->
      <!-- HANDSKIZZEN & CANVAS                       -->
      <!-- ========================================== -->
      <div class="bg-white rounded-lg shadow p-4 md:p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 border-b pb-2">✏️ Handskizzen & Zeichnungsnotizen</h2>

        <!-- Canvas-Werkzeuge -->
        <div class="bg-slate-50 rounded-lg border p-3 space-y-3">
          <div class="flex flex-wrap items-center gap-2 text-xs">

            <!-- Werkzeug-Auswahl -->
            <div class="flex items-center gap-1 bg-white border rounded-lg p-1">
              <button type="button" id="tool-pen"
                onclick="setTool('pen')"
                class="sketch-tool-btn active px-2.5 py-1.5 rounded text-xs font-semibold transition"
                title="Stift">✏️ Stift</button>
              <button type="button" id="tool-line"
                onclick="setTool('line')"
                class="sketch-tool-btn px-2.5 py-1.5 rounded text-xs font-semibold transition"
                title="Linie">/ Linie</button>
              <button type="button" id="tool-rect"
                onclick="setTool('rect')"
                class="sketch-tool-btn px-2.5 py-1.5 rounded text-xs font-semibold transition"
                title="Rechteck">▭ Rechteck</button>
              <button type="button" id="tool-eraser"
                onclick="setTool('eraser')"
                class="sketch-tool-btn px-2.5 py-1.5 rounded text-xs font-semibold transition"
                title="Radierer">⬜ Radierer</button>
            </div>

            <!-- Farbe -->
            <div class="flex items-center gap-1">
              <span class="text-slate-500 font-medium">Farbe:</span>
              <% ['#1e293b','#dc2626','#2563eb','#16a34a','#d97706','#7c3aed'].forEach(c => { %>
                <button type="button"
                  onclick="setColor('<%= c %>')"
                  class="sketch-color-btn w-6 h-6 rounded-full border-2 border-transparent transition hover:scale-110"
                  style="background-color:<%= c %>"
                  data-color="<%= c %>"></button>
              <% }) %>
              <input type="color" id="custom-color" value="#1e293b"
                onchange="setColor(this.value)"
                class="w-6 h-6 rounded cursor-pointer border border-slate-300"
                title="Eigene Farbe">
            </div>

            <!-- Strichstärke -->
            <div class="flex items-center gap-1.5">
              <span class="text-slate-500 font-medium">Stärke:</span>
              <input type="range" id="brush-size" min="1" max="30" value="3"
                oninput="setBrushSize(this.value)"
                class="w-20 accent-slate-700">
              <span id="brush-size-label" class="text-slate-600 font-semibold w-5 text-center">3</span>
            </div>

            <!-- Aktionen -->
            <div class="flex items-center gap-1 ml-auto">
              <button type="button" onclick="undoSketch()"
                class="px-2.5 py-1.5 bg-white border border-slate-300 hover:bg-slate-50 rounded text-xs font-semibold transition"
                title="Rückgängig">↩ Undo</button>
              <button type="button" onclick="clearSketch()"
                class="px-2.5 py-1.5 bg-white border border-red-200 text-red-600 hover:bg-red-50 rounded text-xs font-semibold transition"
                title="Alles löschen">🗑 Leeren</button>
            </div>
          </div>

          <!-- Canvas -->
          <div class="relative rounded border border-slate-300 overflow-hidden bg-white" style="touch-action: none;">
            <canvas id="sketch-canvas"
              class="block w-full"
              style="cursor: crosshair; display: block;">
            </canvas>
            <!-- Hintergrundraster -->
            <canvas id="sketch-grid" class="absolute inset-0 pointer-events-none w-full h-full"></canvas>
          </div>

          <!-- Speichern -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2 pt-1">
            <input type="text" id="sketch-title" placeholder="Titel der Skizze (z.B. Geländer Nordseite)" maxlength="80"
              class="flex-1 border border-slate-300 rounded px-3 py-1.5 text-sm bg-white w-full sm:w-auto">
            <button type="button" onclick="saveSketch(<%= project.id %>)"
              id="sketch-save-btn"
              class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-5 py-1.5 rounded transition whitespace-nowrap">
              💾 Skizze speichern
            </button>
          </div>
          <p id="sketch-status" class="text-xs text-slate-400 hidden"></p>
        </div>

        <!-- Gespeicherte Skizzen -->
        <% if (sketches && sketches.length > 0) { %>
          <div class="space-y-2">
            <h3 class="text-sm font-semibold text-slate-700">Gespeicherte Skizzen (<%= sketches.length %>):</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              <% sketches.forEach(sk => { %>
                <div class="bg-slate-50 rounded-lg border border-slate-200 overflow-hidden group">
                  <!-- Vorschau klickbar zum Vollbild -->
                  <a href="<%= sk.image_data %>" target="_blank" class="block">
                    <img src="<%= sk.image_data %>" alt="Skizze"
                      class="w-full h-36 object-contain bg-white hover:opacity-90 transition border-b border-slate-200">
                  </a>
                  <div class="p-2.5 flex justify-between items-center gap-2">
                    <div class="min-w-0">
                      <p class="text-xs font-semibold text-slate-800 truncate"><%= sk.title || 'Ohne Titel' %></p>
                      <p class="text-[10px] text-slate-400">von <strong><%= sk.created_by %></strong> · <%= new Date(sk.created_at).toLocaleDateString('de-DE') %></p>
                    </div>
                    <form action="/projects/sketches/delete" method="POST" onsubmit="return confirm('Skizze wirklich löschen?');" class="shrink-0">
                      <input type="hidden" name="sketch_id" value="<%= sk.id %>">
                      <input type="hidden" name="project_id" value="<%= project.id %>">
                      <button type="submit"
                        class="bg-red-50 hover:bg-red-100 text-red-600 px-2 py-1 rounded text-xs font-medium transition">
                        🗑️
                      </button>
                    </form>
                  </div>
                  <!-- Skizze in Canvas laden -->
                  <button type="button"
                    onclick="loadSketchToCanvas('<%= sk.image_data.replace(/'/g, "\\'") %>')"
                    class="w-full text-center text-[10px] text-indigo-600 hover:bg-indigo-50 py-1.5 border-t border-slate-200 transition font-medium">
                    ↗ In Canvas laden & bearbeiten
                  </button>
                </div>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-400 italic">Noch keine Skizzen für dieses Projekt gespeichert.</p>
        <% } %>
      </div>

      <!-- ========================================== -->
      <!-- NEU: BAUSTELLEN-AUFGABEN & MÄNGEL TICKER -->
      <!-- ========================================== -->
      <div class="bg-white rounded-lg shadow p-4 md:p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 border-b pb-2">🛠️ Baustellen-Aufgaben & Mängel</h2>
        
        <!-- Formular zum Hinzufügen einer neuen Aufgabe/Mängels -->
        <form action="/projects/<%= project.id %>/tasks/add" method="POST" enctype="multipart/form-data" class="space-y-3 bg-slate-50 p-4 rounded border">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Neue Aufgabe oder Mangel erfassen</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">Titel / Stichpunkt *</label>
              <input type="text" name="title" required class="w-full text-sm border border-slate-300 rounded px-3 py-2 bg-white" placeholder="z.B. Kratzer im Profil nachbessern">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">Kategorie</label>
              <select name="category" class="w-full text-sm border border-slate-300 rounded px-3 py-2 bg-white">
                <option value="Restarbeit">Restarbeit</option>
                <option value="Mangel">Mangel / Reklamation</option>
                <option value="Bestellung">Nachbestellung</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Beschreibung / Details</label>
            <textarea name="description" rows="2" class="w-full text-sm border border-slate-300 rounded p-2.5 bg-white" placeholder="Genaue Beschreibung oder Standort auf der Baustelle..."></textarea>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Foto-Nachweis (optional)</label>
            <input type="file" name="photo" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100">
          </div>
          <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium px-4 py-2 rounded transition">Aufgabe hinzufügen</button>
        </form>

        <!-- Liste der Aufgaben & Mängel -->
        <div class="space-y-3 pt-2">
          <h3 class="text-sm font-semibold text-slate-700">Offene & Erledigte Punkte:</h3>
          <% if (typeof tasks !== 'undefined' && tasks && tasks.length > 0) { %>
            <div class="space-y-3">
              <% tasks.forEach(task => { %>
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-slate-50 p-3 rounded border gap-3 text-sm">
