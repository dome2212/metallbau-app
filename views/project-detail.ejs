<style>
.sketch-tool-btn { color: #475569; background: transparent; }
.sketch-tool-btn.active { background: #1e40af; color: #fff; }
</style>

<script>
// ================================================
// CANVAS / HANDSKIZZEN
// ================================================
(function() {
  const canvas = document.getElementById('sketch-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');

  function resizeCanvas() {
    const container = canvas.parentElement;
    const w = container.clientWidth;
    const h = Math.round(w * 0.55);
    if (canvas.width === w && canvas.height === h) return;
    const snap = canvas.width > 0 ? ctx.getImageData(0, 0, canvas.width, canvas.height) : null;
    canvas.width  = w;
    canvas.height = h;
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, w, h);
    if (snap) ctx.putImageData(snap, 0, 0);
    drawGrid();
  }

  function drawGrid() {
    const grid = document.getElementById('sketch-grid');
    if (!grid) return;
    grid.width  = canvas.width;
    grid.height = canvas.height;
    const gc = grid.getContext('2d');
    gc.clearRect(0, 0, grid.width, grid.height);
    gc.strokeStyle = 'rgba(148,163,184,0.2)';
    gc.lineWidth = 0.5;
    const step = 20;
    for (let x = step; x < grid.width; x += step) {
      gc.beginPath(); gc.moveTo(x, 0); gc.lineTo(x, grid.height); gc.stroke();
    }
    for (let y = step; y < grid.height; y += step) {
      gc.beginPath(); gc.moveTo(0, y); gc.lineTo(grid.width, y); gc.stroke();
    }
  }

  let tool = 'pen', color = '#1e293b', brushSize = 3;
  let drawing = false, startX = 0, startY = 0, snapshot = null;
  const history = [];

  function saveHistory() {
    history.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
    if (history.length > 30) history.shift();
  }

  function getPos(e) {
    const r = canvas.getBoundingClientRect();
    const sx = canvas.width  / r.width;
    const sy = canvas.height / r.height;
    const src = e.touches ? e.touches[0] : e;
    return { x: (src.clientX - r.left) * sx, y: (src.clientY - r.top) * sy };
  }

  function startDraw(e) {
    e.preventDefault();
    drawing = true;
    const p = getPos(e);
    startX = p.x; startY = p.y;
    saveHistory();
    snapshot = ctx.getImageData(0, 0, canvas.width, canvas.height);
    if (tool === 'pen' || tool === 'eraser') {
      ctx.beginPath(); ctx.moveTo(p.x, p.y);
    }
  }

  function doDraw(e) {
    if (!drawing) return;
    e.preventDefault();
    const p = getPos(e);
    ctx.lineWidth   = tool === 'eraser' ? brushSize * 4 : brushSize;
    ctx.lineCap     = 'round';
    ctx.lineJoin    = 'round';
    ctx.strokeStyle = tool === 'eraser' ? '#ffffff' : color;

    if (tool === 'pen' || tool === 'eraser') {
      ctx.lineTo(p.x, p.y); ctx.stroke();
    } else {
      ctx.putImageData(snapshot, 0, 0);
      ctx.beginPath();
      ctx.strokeStyle = color;
      ctx.lineWidth   = brushSize;
      if (tool === 'line') {
        ctx.moveTo(startX, startY); ctx.lineTo(p.x, p.y); ctx.stroke();
      } else {
        ctx.strokeRect(startX, startY, p.x - startX, p.y - startY);
      }
    }
  }

  function endDraw(e) {
    if (!drawing) return;
    drawing = false;
    ctx.closePath();
  }

  canvas.addEventListener('mousedown',  startDraw);
  canvas.addEventListener('mousemove',  doDraw);
  canvas.addEventListener('mouseup',    endDraw);
  canvas.addEventListener('mouseleave', endDraw);
  canvas.addEventListener('touchstart', startDraw, { passive: false });
  canvas.addEventListener('touchmove',  doDraw,    { passive: false });
  canvas.addEventListener('touchend',   endDraw,   { passive: false });

  window.setTool = function(t) {
    tool = t;
    canvas.style.cursor = t === 'eraser' ? 'cell' : 'crosshair';
    document.querySelectorAll('.sketch-tool-btn').forEach(b =>
      b.classList.toggle('active', b.id === 'tool-' + t));
  };

  window.setColor = function(c) {
    color = c;
    document.getElementById('custom-color').value = c;
    document.querySelectorAll('.sketch-color-btn').forEach(b =>
      b.style.borderColor = b.dataset.color === c ? '#3b82f6' : 'transparent');
    if (tool === 'eraser') setTool('pen');
  };

  window.setBrushSize = function(v) {
    brushSize = parseInt(v, 10);
    document.getElementById('brush-size-label').textContent = v;
  };

  window.undoSketch = function() {
    if (history.length) ctx.putImageData(history.pop(), 0, 0);
  };

  window.clearSketch = function() {
    if (!confirm('Canvas wirklich leeren?')) return;
    saveHistory();
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  };

  window.loadSketchToCanvas = function(dataUrl) {
    const img = new Image();
    img.onload = () => {
      saveHistory();
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
    };
    img.src = dataUrl;
  };

  window.saveSketch = async function(projectId) {
    const btn    = document.getElementById('sketch-save-btn');
    const status = document.getElementById('sketch-status');
    const title  = (document.getElementById('sketch-title').value || '').trim();
    const imageData = canvas.toDataURL('image/png');

    // Leere Canvas-Prüfung (nur weiße Pixel)
    const d = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
    let hasDrawing = false;
    for (let i = 0; i < d.length; i += 4) {
      if (d[i] < 250 || d[i+1] < 250 || d[i+2] < 250) { hasDrawing = true; break; }
    }
    if (!hasDrawing) {
      status.textContent = '⚠️ Canvas ist leer – bitte zuerst etwas zeichnen.';
      status.className = 'text-xs text-amber-600';
      status.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Speichert...';
    status.classList.add('hidden');

    try {
      const res = await fetch('/projects/' + projectId + '/sketches/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ image_data: imageData, title })
      });
      const data = await res.json();
      if (data.ok) {
        status.textContent = '✅ Skizze gespeichert! Seite wird neu geladen...';
        status.className = 'text-xs text-green-600';
        status.classList.remove('hidden');
        setTimeout(() => location.reload(), 1200);
      } else {
        throw new Error(data.error || 'Fehler');
      }
    } catch (err) {
      status.textContent = '❌ Fehler: ' + err.message;
      status.className = 'text-xs text-red-600';
      status.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = '💾 Skizze speichern';
    }
  };

  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
})();

// ================================================
// GEO-FENCING: ADRESSSUCHE & STANDORT-HELFER
// ================================================

// Freitextsuche über OpenStreetMap Nominatim (kein API-Key nötig)
async function geocodeAddress() {
  const input = document.getElementById('geo-address-input');
  const status = document.getElementById('geo-status');
  const address = input ? input.value.trim() : '';

  if (!address) {
    showGeoStatus('⚠️ Bitte zuerst eine Adresse eingeben.', 'text-amber-600');
    return;
  }

  showGeoStatus('⏳ Suche läuft…', 'text-slate-400');

  try {
    const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(address)}&format=json&limit=1&addressdetails=1`;
    const res = await fetch(url, { headers: { 'Accept-Language': 'de' } });
    const data = await res.json();

    if (!data || data.length === 0) {
      showGeoStatus('❌ Adresse nicht gefunden. Bitte genauer eingeben.', 'text-red-600');
      return;
    }

    const result = data[0];
    const lat = parseFloat(result.lat).toFixed(7);
    const lng = parseFloat(result.lon).toFixed(7);
    const displayName = result.display_name;

    document.getElementById('geo-lat').value = lat;
    document.getElementById('geo-lng').value = lng;

    showGeoStatus(`✅ Gefunden: ${displayName}`, 'text-green-700');
  } catch (e) {
    showGeoStatus('❌ Netzwerkfehler beim Suchen. Bitte Internetverbindung prüfen.', 'text-red-600');
  }
}

// Kundenadresse in Suchfeld eintragen und sofort geocodieren
function useCustomerAddress(address) {
  const input = document.getElementById('geo-address-input');
  if (input) {
    input.value = address;
    geocodeAddress();
  }
}

// Hilfsfunktion: Status-Text anzeigen
function showGeoStatus(msg, colorClass) {
  const el = document.getElementById('geo-status');
  if (!el) return;
  el.textContent = msg;
  el.className = `text-[10px] mt-1 ${colorClass}`;
  el.classList.remove('hidden');
}

// GPS-Standort des Geräts nutzen
function useMyLocationForProject() {
  if (!navigator.geolocation) {
    alert('Geolocation wird von diesem Browser nicht unterstützt.');
    return;
  }
  navigator.geolocation.getCurrentPosition(
    (pos) => {
      const lat = pos.coords.latitude.toFixed(7);
      const lng = pos.coords.longitude.toFixed(7);
      document.getElementById('geo-lat').value = lat;
      document.getElementById('geo-lng').value = lng;
      showGeoStatus(`📍 GPS-Standort übernommen: ${lat}, ${lng}`, 'text-green-700');
    },
    () => { showGeoStatus('⚠️ GPS-Standort konnte nicht ermittelt werden.', 'text-amber-600'); },
    { timeout: 10000, enableHighAccuracy: true }
  );
}

// Enter-Taste im Adressfeld auslösen
document.addEventListener('DOMContentLoaded', () => {
  const inp = document.getElementById('geo-address-input');
