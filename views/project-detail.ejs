<script>
// ================================================
// GEO-FENCING: ADRESSSUCHE & STANDORT-HELFER
// ================================================

// Freitextsuche über OpenStreetMap Nominatim (kein API-Key nötig)
async function geocodeAddress() {
  const input = document.getElementById('geo-address-input');
  const status = document.getElementById('geo-status');
  const address = input ? input.value.trim() : '';

  if (!address) {
    showGeoStatus('⚠️ Bitte zuerst eine Adresse eingeben.', 'text-amber-600');
    return;
  }

  showGeoStatus('⏳ Suche läuft…', 'text-slate-400');

  try {
    const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(address)}&format=json&limit=1&addressdetails=1`;
    const res = await fetch(url, { headers: { 'Accept-Language': 'de' } });
    const data = await res.json();

    if (!data || data.length === 0) {
      showGeoStatus('❌ Adresse nicht gefunden. Bitte genauer eingeben.', 'text-red-600');
      return;
    }

    const result = data[0];
    const lat = parseFloat(result.lat).toFixed(7);
    const lng = parseFloat(result.lon).toFixed(7);
    const displayName = result.display_name;

    document.getElementById('geo-lat').value = lat;
    document.getElementById('geo-lng').value = lng;

    showGeoStatus(`✅ Gefunden: ${displayName}`, 'text-green-700');
  } catch (e) {
    showGeoStatus('❌ Netzwerkfehler beim Suchen. Bitte Internetverbindung prüfen.', 'text-red-600');
  }
}

// Kundenadresse in Suchfeld eintragen und sofort geocodieren
function useCustomerAddress(address) {
  const input = document.getElementById('geo-address-input');
  if (input) {
    input.value = address;
    geocodeAddress();
  }
}

// Hilfsfunktion: Status-Text anzeigen
function showGeoStatus(msg, colorClass) {
  const el = document.getElementById('geo-status');
  if (!el) return;
  el.textContent = msg;
  el.className = `text-[10px] mt-1 ${colorClass}`;
  el.classList.remove('hidden');
}

// GPS-Standort des Geräts nutzen
function useMyLocationForProject() {
  if (!navigator.geolocation) {
    alert('Geolocation wird von diesem Browser nicht unterstützt.');
    return;
  }
  navigator.geolocation.getCurrentPosition(
    (pos) => {
      const lat = pos.coords.latitude.toFixed(7);
      const lng = pos.coords.longitude.toFixed(7);
      document.getElementById('geo-lat').value = lat;
      document.getElementById('geo-lng').value = lng;
      showGeoStatus(`📍 GPS-Standort übernommen: ${lat}, ${lng}`, 'text-green-700');
    },
    () => { showGeoStatus('⚠️ GPS-Standort konnte nicht ermittelt werden.', 'text-amber-600'); },
    { timeout: 10000, enableHighAccuracy: true }
  );
}

// Enter-Taste im Adressfeld auslösen
document.addEventListener('DOMContentLoaded', () => {
  const inp = document.getElementById('geo-address-input');
  if (inp) inp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); geocodeAddress(); } });
});

</script>

<% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') { %>
<script>
// ================================================
// KI-ANGEBOT: GEMINI VISION INTEGRATION
// ================================================

function openKiQuoteModal() {
  document.getElementById('kiQuoteModal').classList.remove('hidden');
  document.getElementById('kiQuoteError').classList.add('hidden');
  document.getElementById('kiQuoteLoading').classList.add('hidden');
}

function previewKiImages(input) {
  const previewBox = document.getElementById('kiImagePreviews');
  previewBox.innerHTML = '';
  const files = Array.from(input.files).slice(0, 3);
  // Überschuss abschneiden
  if (input.files.length > 3) {
    const dt = new DataTransfer();
    files.forEach(f => dt.items.add(f));
    input.files = dt.files;
  }
  files.forEach(file => {
    const reader = new FileReader();
    reader.onload = e => {
      const img = document.createElement('img');
      img.src = e.target.result;
      img.className = 'h-16 w-16 object-cover rounded border border-slate-200 dark:border-slate-600';
      img.title = file.name;
      previewBox.appendChild(img);
    };
    reader.readAsDataURL(file);
  });
}

async function generateKiQuote() {
  const btn      = document.getElementById('kiQuoteGenerateBtn');
  const loading  = document.getElementById('kiQuoteLoading');
  const errorBox = document.getElementById('kiQuoteError');
  const textarea = document.getElementById('kiQuoteText');
  const fileInput = document.getElementById('kiQuoteImages');

  btn.disabled = true;
  btn.textContent = '⏳ Generiert …';
  loading.classList.remove('hidden');
  errorBox.classList.add('hidden');
  textarea.value = '';

  try {
    // FormData verwenden damit Bilder mitsgesendet werden können
    const formData = new FormData();
    if (fileInput && fileInput.files.length > 0) {
      Array.from(fileInput.files).slice(0, 3).forEach(f => formData.append('images', f));
    }

    const res = await fetch('/projects/<%= project.id %>/generate-quote-with-images', {
      method: 'POST',
      credentials: 'same-origin',
      body: formData
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'Unbekannter Fehler');
    textarea.value = data.quote;
  } catch (err) {
    errorBox.textContent = '❌ Fehler: ' + err.message;
    errorBox.classList.remove('hidden');
  } finally {
    loading.classList.add('hidden');
    btn.disabled = false;
    btn.innerHTML = '🤖 Neu generieren';
  }
}

function copyKiQuote() {
  const text = document.getElementById('kiQuoteText').value;
  if (!text) return;
  navigator.clipboard.writeText(text).then(() => {
    alert('Angebotstext wurde in die Zwischenablage kopiert.');
  });
}

async function saveKiQuoteAsNote() {
  const text = document.getElementById('kiQuoteText').value.trim();
  if (!text) {
    alert('Bitte zuerst einen Angebotstext generieren.');
    return;
  }

  const noteText = '📄 KI-Angebot (automatisch generiert):\n\n' + text;

  const formData = new URLSearchParams();
  formData.append('note_text', noteText);

  try {
    const res = await fetch('/projects/<%= project.id %>/notes/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      credentials: 'same-origin',
      body: formData.toString()
    });
    if (res.ok || res.redirected) {
      document.getElementById('kiQuoteModal').classList.add('hidden');
      window.location.reload();
    } else {
      alert('Fehler beim Speichern der Notiz.');
    }
  } catch (err) {
    alert('Netzwerkfehler: ' + err.message);
  }
}
</script>
<% } %>

