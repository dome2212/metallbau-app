<%- include('partials/header') %>
<%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto page-bg dark:bg-slate-900 min-h-screen pt-16">
    <header class="card border-0 rounded-none md:rounded-none shadow-sm px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
      <div>
        <a href="/projects" class="text-xs text-blue-600 hover:underline">← Zurück zur Übersicht</a>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100"><%= project.title %></h1>
      </div>
      <div class="flex items-center gap-2">
        <%
          const headerStatusColors = {
            'In Planung':         'bg-slate-100 text-slate-700',
            'Avor / Vorbereitung':'bg-blue-100 text-blue-800',
            'In Produktion':      'bg-amber-100 text-amber-800',
            'Oberfläche':         'bg-purple-100 text-purple-800',
            'Montagebereit':      'bg-emerald-100 text-emerald-800',
            'Montage läuft':      'bg-orange-100 text-orange-800',
            'Abgeschlossen':      'bg-green-100 text-green-800'
          };
          const hsc = headerStatusColors[project.status] || 'bg-blue-100 text-blue-800';
        %>
        <span class="px-3 py-1 rounded text-sm font-semibold <%= hsc %>"><%= project.status %></span>
        <button id="qrOpenBtn" onclick="document.getElementById('qrModal').classList.remove('hidden')"
          class="btn btn-ghost text-xs">
          📱 QR-Code
        </button>
        <% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') { %>
          <button onclick="document.getElementById('editProjectModal').classList.remove('hidden')"
            class="btn btn-ghost text-xs" style="color:#b45309;border-color:#fde68a;background:#fffbeb">
            ✏️ Bearbeiten
          </button>
        <% } %>
      </div>
    </header>


    <div class="p-4 md:p-6 max-w-7xl mx-auto w-full space-y-8">

      <!-- ========== SCHNELL-NAVIGATION (Tabs) ========== -->
      <nav class="sticky top-16 md:top-2 z-20 -mx-1 px-1">
        <div class="bg-white/95 dark:bg-slate-800/95 backdrop-blur border dark:border-slate-700 shadow-sm rounded-xl p-2 overflow-x-auto">
          <div class="flex gap-1.5 min-w-max">
            <button type="button" class="nav-chip" data-target="sec-uebersicht"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>Übersicht</button>
            <button type="button" class="nav-chip" data-target="sec-aufmass"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17L17 3M12 3h5v5M7 21H3v-4"/></svg>Aufmaß</button>
            <button type="button" class="nav-chip" data-target="sec-aufgaben"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>Aufgaben</button>
            <button type="button" class="nav-chip" data-target="sec-notizen"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>Notizen</button>
            <button type="button" class="nav-chip" data-target="sec-fotos"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="15" rx="2"/><circle cx="12" cy="12.5" r="3.5"/><path d="M8 5l1.5-2h5L16 5"/></svg>Fotos</button>
            <button type="button" class="nav-chip" data-target="sec-termine"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 3v3M16 3v3"/></svg>Termine</button>
            <button type="button" class="nav-chip" data-target="sec-material"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8M12 13v8"/></svg>Material</button>
            <button type="button" class="nav-chip" data-target="sec-stunden"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Stunden</button>
            <button type="button" class="nav-chip" data-target="sec-abnahme"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>Abnahme</button>
            <button type="button" class="nav-chip" data-target="sec-status"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>Status</button>
            <button type="button" class="nav-chip" data-target="sec-chat"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>Chat</button>
          </div>
        </div>
      </nav>
      <style>
        .nav-chip{padding:0.375rem 0.75rem;border-radius:0.5rem;font-size:0.75rem;font-weight:600;background:#f1f5f9;color:#334155;transition:background .15s,color .15s;display:inline-block;text-decoration:none;border:1px solid transparent;cursor:pointer}
        .nav-chip:hover{background:#dbeafe;color:#1d4ed8}
        .nav-chip.active{background:#2563eb;color:#fff}
        .dark .nav-chip{background:#334155;color:#e2e8f0}
        .dark .nav-chip:hover{background:#475569;color:#fff}
        .dark .nav-chip.active{background:#2563eb;color:#fff}
        .sec-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:0.15rem 0.5rem;border-radius:0.35rem;white-space:nowrap}
        .card-clean{background:#fff;border-radius:0.75rem;box-shadow:0 1px 2px rgb(0 0 0/0.05);border:1px solid #f1f5f9;padding:1rem}
        @media(min-width:768px){.card-clean{padding:1.5rem}}
        .dark .card-clean{background:#1e293b;border-color:#334155}
        .sec-toggle{cursor:pointer;user-select:none;display:flex;align-items:center;gap:0.5rem;width:100%}
        .sec-toggle .chev{transition:transform .2s;font-size:12px;color:#64748b}
        .sec-collapsed .sec-toggle .chev{transform:rotate(-90deg)}
        .sec-collapsed .sec-body{display:none}
        .sec-collapsed .card-clean{padding-top:0.75rem;padding-bottom:0.75rem}
        /* Tab-Modus: nicht-aktive Abschnitte per JS ausgeblendet (Klasse sec-tab-hidden) */
        .sec-tab-hidden{display:none !important}
      </style>

      <!-- ========== 1 ÜBERSICHT ========== -->
      <section id="sec-uebersicht" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-uebersicht" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30">1 · Übersicht</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Kundendaten & Details -->
        <div class="card-clean space-y-4">
          <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📋 Projektdetails</h2>
          <div>
            <span class="text-xs text-slate-400 dark:text-slate-500 block">Kunde / Baustelle</span>
            <strong class="text-slate-700 dark:text-gray-200"><%= project.company_name || project.contact_person %></strong>
            <p class="text-sm text-slate-600 dark:text-slate-300"><%= project.street %>, <%= project.zip %> <%= project.city %></p>

            <!-- ── Navigations-Widget ── -->
            <% if (project.street && project.city) {
              const encAddr = encodeURIComponent((project.street + ', ' + (project.zip || '') + ' ' + project.city).trim());
              const googleUrl = 'https://www.google.com/maps/dir/?api=1&destination=' + encAddr;
              const appleUrl  = 'maps://?daddr=' + encAddr;
              const wazeUrl   = 'https://waze.com/ul?q=' + encAddr + '&navigate=yes';
            %>
            <div class="mt-2 flex flex-wrap gap-2">
              <a href="<%= googleUrl %>" target="_blank"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold transition shadow-sm">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                Google Maps
              </a>
              <a href="<%= appleUrl %>" target="_blank"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-800 text-white text-xs font-semibold transition shadow-sm">
                🍎 Apple Maps
              </a>
              <a href="<%= wazeUrl %>" target="_blank"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-sky-500 hover:bg-sky-600 text-white text-xs font-semibold transition shadow-sm">
                🗺 Waze
              </a>
            </div>
            <% } %>

            <!-- ── Anfahrtshinweis (für alle sichtbar, wenn gesetzt) ── -->
            <% if (project.site_note) { %>
            <div class="mt-3 flex gap-2 bg-amber-50 dark:bg-amber-900/20 border border-amber-300 dark:border-amber-700 rounded-lg px-3 py-2.5">
              <span class="text-amber-500 text-base mt-0.5 shrink-0">⚠️</span>
              <div>
                <p class="text-xs font-semibold text-amber-800 dark:text-amber-300 mb-0.5">Anfahrtshinweis</p>
                <p class="text-xs text-amber-700 dark:text-amber-400 leading-snug"><%= project.site_note %></p>
              </div>
            </div>
            <% } %>
          </div>
          
          <!-- Auftragssumme nur für den Chef (ADMIN) sichtbar -->
          <% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') { %>
            <div>
              <span class="text-xs text-slate-400 dark:text-slate-500 block">Auftragssumme</span>
              <span class="text-xl font-bold text-slate-800 dark:text-gray-100"><%= (Number(project.total_price) || 0).toLocaleString('de-DE', {minimumFractionDigits: 2}) %> €</span>
            </div>
          <% } %>

          <div>
            <span class="text-xs text-slate-400 dark:text-slate-500 block">Beschreibung</span>
            <p class="text-sm text-slate-600 dark:text-slate-300"><%= project.description || 'Keine Beschreibung hinterlegt.' %></p>
          </div>

          <!-- Baustellenkoordinaten (Geo-Fencing) — nur Admin -->
          <% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') { %>
            <div class="border-t dark:border-slate-700 pt-4 space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">📍 Geo-Fencing Standort</span>
                <% if (project.site_lat && project.site_lng) { %>
                  <span class="text-xs bg-green-100 text-green-700 font-semibold px-2 py-0.5 rounded-full">Aktiv</span>
                <% } else { %>
                  <span class="text-xs bg-slate-100 text-slate-500 font-semibold px-2 py-0.5 rounded-full">Nicht gesetzt</span>
                <% } %>
              </div>
              <% if (project.site_lat && project.site_lng) { %>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  Lat: <strong><%= project.site_lat %></strong> · Lng: <strong><%= project.site_lng %></strong> · Radius: <strong><%= project.site_radius || 200 %> m</strong>
                </p>
              <% } %>
              <form action="/projects/<%= project.id %>/set-location" method="POST" class="space-y-2" id="geo-form">

                <!-- Adresssuche via OpenStreetMap Nominatim -->
                <div>
                  <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Adresse suchen</label>
                  <div class="flex gap-1">
                    <input type="text" id="geo-address-input"
                      placeholder="z.B. Musterstraße 5, 45678 Musterstadt"
                      class="flex-1 text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-indigo-400">
                    <button type="button" onclick="geocodeAddress()"
                      class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium px-2.5 py-1.5 rounded transition whitespace-nowrap">
                      🔍 Suchen
                    </button>
                  </div>
                  <!-- Kundenadresse als Schnellauswahl -->
                  <% if (project.street && project.city) { %>
                    <button type="button"
                      onclick="useCustomerAddress('<%= (project.street + ', ' + (project.zip || '') + ' ' + project.city).trim().replace(/'/g, "\\'") %>')"
                      class="mt-1 w-full text-left text-[10px] text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 px-2 py-1 rounded border border-indigo-200 transition truncate">
                      🏢 Kundenadresse übernehmen: <%= project.street %>, <%= project.zip %> <%= project.city %>
                    </button>
                  <% } %>
                  <!-- Suchergebnis-Feedback -->
                  <p id="geo-status" class="text-[10px] mt-1 hidden"></p>
                </div>

                <!-- Koordinaten (werden automatisch gefüllt oder können manuell eingegeben werden) -->
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Breitengrad (Lat)</label>
                      <input type="number" step="0.0000001" name="site_lat" id="geo-lat" value="<%= project.site_lat || '' %>" placeholder="z.B. 51.3069" class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1.5 bg-white">
                    </div>
                    <div>
                      <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Längengrad (Lng)</label>
                      <input type="number" step="0.0000001" name="site_lng" id="geo-lng" value="<%= project.site_lng || '' %>" placeholder="z.B. 6.9483" class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1.5 bg-white">
                    </div>
                  </div>
                  <div>
                    <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Erkennungsradius (Meter)</label>
                    <input type="number" name="site_radius" value="<%= project.site_radius || 200 %>" min="50" max="2000" class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1.5 bg-white">
                  </div>
                  <!-- Anfahrtshinweis bearbeiten -->
                  <div>
                    <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">⚠️ Anfahrtshinweis für Monteure</label>
                    <textarea name="site_note" rows="2"
                      placeholder="z.B. Zufahrt nur über Hintereingang · Schrankenschlüssel im Büro abholen"
                      class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1.5 bg-white resize-none focus:outline-none focus:ring-1 focus:ring-amber-400"><%= project.site_note || '' %></textarea>
                  </div>
                  <div class="flex gap-2">
                    <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium py-1.5 rounded transition">Speichern</button>
                    <button type="button" onclick="useMyLocationForProject()" class="flex-1 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-medium py-1.5 rounded transition">📍 Meinen Standort</button>
                </div>
              </form>
            </div>
          <% } %>
        </div>

        <!-- Technische Zeichnungen & Dateien -->
        <div class="card-clean space-y-4">
          <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📐 Technische Zeichnungen & Pläne</h2>
          
          <!-- Upload-Formular -->
          <form action="/projects/<%= project.id %>/upload" method="POST" enctype="multipart/form-data" class="space-y-3 bg-slate-50 dark:bg-slate-700 p-4 rounded border dark:border-slate-600">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Zeichnung / Skizze / Foto hochladen (PDF, Bild)</label>
            <input type="file" name="file" required class="w-full text-xs text-slate-500 dark:text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded transition">Datei hochladen</button>
          </form>

          <!-- Liste der hochgeladenen Dateien -->
          <div class="space-y-2">
            <% if (files && files.length > 0) { %>
              <% files.forEach(file => { %>
                <div class="flex justify-between items-center bg-slate-50 dark:bg-slate-700 p-2.5 rounded border dark:border-slate-600 text-sm">
                    <span class="truncate max-w-xs text-slate-700 dark:text-gray-300">📄 <%= file.original_name %></span>
                  <div class="flex items-center gap-3 shrink-0">
                    <a href="<%= file.file_url %>" target="_blank" class="text-blue-600 hover:underline text-xs font-medium">Ansehen / Download</a>
                    
                    <!-- Lösch-Button für Dateien -->
                    <form action="/projects/files/delete" method="POST" onsubmit="return confirm('Datei wirklich löschen?');" class="inline">
                      <input type="hidden" name="file_id" value="<%= file.id %>">
                      <input type="hidden" name="project_id" value="<%= project.id %>">
                      <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 px-2 py-1 rounded text-xs font-medium transition">Löschen</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-xs text-slate-400 dark:text-slate-500 italic">Noch keine Zeichnungen oder Dokumente hochgeladen.</p>
            <% } %>
          </div>
        </div>
      </div>
            </div><!-- /sec-body -->
</section>

      <!-- ========== 2 AUFMASS ========== -->
      <section id="sec-aufmass" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-aufmass" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30">2 · Aufmaß &amp; Skizzen</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="card-clean space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📐 Digitales Aufmaß (Baustelle)</h2>
        
        <!-- Eingabeformular -->
        <form action="/projects/<%= project.id %>/measurements/add" method="POST" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-3 items-end bg-slate-50 dark:bg-slate-700 p-4 rounded border dark:border-slate-600">
          <div class="md:col-span-3">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Bauteil / Element *</label>
            <input type="text" name="component_name" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. Pfosten links" required>
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Breite (mm)</label>
            <input type="text" name="width" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. 1200">
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Höhe / Länge (mm)</label>
            <input type="text" name="height" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. 900">
          </div>
          <div class="md:col-span-1">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Winkel (°)</label>
            <input type="text" name="angle" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. 45">
          </div>
          <div class="md:col-span-1">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Anzahl</label>
            <input type="number" name="quantity" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" value="1" min="1">
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Bemerkung</label>
            <input type="text" name="note" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. Dachschräge">
          </div>
          <div class="md:col-span-1">
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 rounded transition text-lg">+</button>
          </div>
        </form>

        <!-- Tabelle der bisherigen Aufmaße -->
        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 pt-2">Erfasste Maße:</h3>
        <% if (measurements && measurements.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm min-w-[600px]">
              <thead>
                <tr class="bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 border-b dark:border-slate-600">
                  <th class="p-2.5">Bauteil</th>
                  <th class="p-2.5">Breite</th>
                  <th class="p-2.5">Höhe / Länge</th>
                  <th class="p-2.5">Winkel</th>
                  <th class="p-2.5">Anzahl</th>
                  <th class="p-2.5">Notiz</th>
                  <th class="p-2.5 text-right">Aktion</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                <% measurements.forEach(m => { %>
                  <tr class="hover:bg-slate-50 dark:hover:bg-slate-700">
                    <td class="p-2.5 font-semibold text-slate-800 dark:text-gray-100"><%= m.component_name %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.width ? m.width + ' mm' : '-' %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.height ? m.height + ' mm' : '-' %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.angle ? m.angle + '°' : '-' %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.quantity %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.note || '-' %></td>
                    <td class="p-2.5 text-right">
                      <form action="/projects/measurements/delete" method="POST" onsubmit="return confirm('Eintrag wirklich löschen?');" class="inline">
                        <input type="hidden" name="measurement_id" value="<%= m.id %>">
                        <input type="hidden" name="project_id" value="<%= project.id %>">
                        <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 px-2 py-1 rounded text-xs font-medium transition">Löschen</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-400 dark:text-slate-500 italic">Noch keine Maße für dieses Projekt erfasst.</p>
        <% } %>

        <!-- ===== FREIHAND-SKIZZE / ZEICHNEN IM AUFMASS ===== -->
        <div class="mt-6 pt-4 border-t dark:border-slate-700 space-y-3">
          <h3 class="text-sm font-semibold text-slate-800 dark:text-gray-100">✏️ Skizze zeichnen &amp; Text einfügen</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Freihand zeichnen, Maße als Text platzieren und die Skizze speichern. Optional über ein Baustellenfoto zeichnen. Ideal für Baustellen-Aufmaß per Tablet/Handy.</p>

          <div class="flex flex-wrap items-center gap-2 bg-slate-50 dark:bg-slate-700 p-3 rounded border dark:border-slate-600">
            <button type="button" id="sketch-tool-pen" class="sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-blue-600 text-white" data-tool="pen" title="Stift">✏️ Stift</button>
            <button type="button" id="sketch-tool-line" class="sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200" data-tool="line" title="Linie">／ Linie</button>
            <button type="button" id="sketch-tool-rect" class="sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200" data-tool="rect" title="Rechteck">▭ Rechteck</button>
            <button type="button" id="sketch-tool-text" class="sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200" data-tool="text" title="Text">🔤 Text</button>
            <button type="button" id="sketch-tool-eraser" class="sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200" data-tool="eraser" title="Radierer">🧽 Radierer</button>
            <span class="w-px h-6 bg-slate-300 dark:bg-slate-500 mx-1"></span>
            <label class="text-xs text-slate-600 dark:text-slate-300 flex items-center gap-1">Farbe
              <input type="color" id="sketch-color" value="#1e293b" class="w-8 h-7 rounded border cursor-pointer">
            </label>
            <label class="text-xs text-slate-600 dark:text-slate-300 flex items-center gap-1">Stärke
              <input type="range" id="sketch-size" min="1" max="20" value="3" class="w-20">
              <span id="sketch-size-label" class="w-5 text-center">3</span>
            </label>
            <label class="text-xs text-slate-600 dark:text-slate-300 flex items-center gap-1">Schrift
              <select id="sketch-font-size" class="text-xs border dark:border-slate-600 dark:bg-slate-800 rounded px-1 py-1">
                <option value="14">14</option>
                <option value="18" selected>18</option>
                <option value="24">24</option>
                <option value="32">32</option>
              </select>
            </label>
            <span class="w-px h-6 bg-slate-300 dark:bg-slate-500 mx-1"></span>
            <button type="button" id="sketch-undo" class="px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200">↩ Rückgängig</button>
            <button type="button" id="sketch-clear" class="px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-red-600">🗑 Leeren</button>
            <label class="px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-blue-600 dark:text-blue-400 cursor-pointer hover:bg-blue-50 dark:hover:bg-slate-600">
              📷 Foto als Hintergrund
              <input type="file" id="sketch-bg-input" accept="image/*" class="hidden">
            </label>
          </div>

          <div class="relative border-2 border-dashed border-slate-300 dark:border-slate-600 rounded-lg overflow-hidden bg-white" id="sketch-wrap" style="touch-action: none;">
            <canvas id="sketchCanvas" width="900" height="520" class="w-full block cursor-crosshair" style="touch-action:none; max-height: 70vh;"></canvas>
            <div id="sketch-text-box" class="hidden absolute z-10 bg-white dark:bg-slate-800 border-2 border-blue-500 rounded shadow-lg p-2">
              <input type="text" id="sketch-text-input" class="text-sm px-2 py-1.5 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded w-44" placeholder="Text eingeben (z.B. 1250 mm)...">
              <div class="flex gap-1 mt-1.5">
                <button type="button" id="sketch-text-ok" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium px-2 py-1.5 rounded">Einfügen</button>
                <button type="button" id="sketch-text-cancel" class="bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-gray-200 text-xs px-2 py-1.5 rounded">Abbr.</button>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap items-end gap-3">
            <div class="flex-1 min-w-[160px]">
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Titel der Skizze</label>
              <input type="text" id="sketch-title" maxlength="120" placeholder="z.B. Geländer Detail Ostseite" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white">
            </div>
            <button type="button" id="sketch-save-btn" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded shadow transition disabled:opacity-50 disabled:cursor-not-allowed">
              💾 Skizze speichern
            </button>
            <span id="sketch-status" class="text-xs text-slate-500 dark:text-slate-400"></span>
          </div>

          <div class="mt-4">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Gespeicherte Skizzen</h4>
            <% if (typeof sketches !== 'undefined' && sketches && sketches.length > 0) { %>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                <% sketches.forEach(function(s) { %>
                  <div class="border dark:border-slate-600 rounded-lg overflow-hidden bg-slate-50 dark:bg-slate-700">
                    <img src="<%= s.image_data %>" alt="<%= s.title || 'Skizze' %>" class="w-full h-36 object-contain bg-white cursor-pointer sketch-thumb">
                    <div class="p-2 flex items-start justify-between gap-2">
                      <div class="min-w-0">
                        <p class="text-sm font-medium text-slate-800 dark:text-gray-100 truncate"><%= s.title || 'Skizze' %></p>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400"><%= s.created_by || '' %> · <%= s.created_at ? String(s.created_at).slice(0,16).replace('T',' ') : '' %></p>
                      </div>
                      <div class="flex flex-col gap-1 shrink-0">
                        <% if (s.drawing_json) { %>
                          <button type="button" class="sketch-edit-btn text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/30 px-2 py-1 rounded text-xs" data-json="<%- s.drawing_json.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') %>">Bearbeiten</button>
                        <% } %>
                        <form action="/projects/sketches/delete" method="POST" onsubmit="return confirm('Skizze wirklich löschen?');">
                          <input type="hidden" name="sketch_id" value="<%= s.id %>">
                          <input type="hidden" name="project_id" value="<%= project.id %>">
                          <button type="submit" class="w-full text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30 px-2 py-1 rounded text-xs">Löschen</button>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-xs text-slate-400 dark:text-slate-500 italic">Noch keine Skizzen gespeichert.</p>
            <% } %>
          </div>
        </div>
      </div>

            </div><!-- /sec-body -->
</section>

      <!-- ========== 3 AUFGABEN ========== -->
      <section id="sec-aufgaben" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-aufgaben" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/30">3 · Aufgaben &amp; Mängel</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="card-clean space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">🛠️ Baustellen-Aufgaben & Mängel</h2>
        
        <!-- Formular zum Hinzufügen einer neuen Aufgabe/Mängels -->
        <form action="/projects/<%= project.id %>/tasks/add" method="POST" enctype="multipart/form-data" class="space-y-3 bg-slate-50 dark:bg-slate-700 p-4 rounded border dark:border-slate-600">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Neue Aufgabe oder Mangel erfassen</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Titel / Stichpunkt *</label>
              <input type="text" name="title" required class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. Kratzer im Profil nachbessern">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Kategorie</label>
              <select name="category" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white">
                <option value="Restarbeit">Restarbeit</option>
                <option value="Mangel">Mangel / Reklamation</option>
                <option value="Bestellung">Nachbestellung</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Fälligkeit (optional)</label>
              <input type="date" name="due_date" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Zugewiesen an</label>
              <select name="assigned_to" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white">
                <option value="">— Niemand —</option>
                <% if (typeof users !== 'undefined') { users.forEach(u => { %>
                  <option value="<%= u.id %>"><%= u.username %></option>
                <% }) } %>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Beschreibung / Details</label>
            <textarea name="description" rows="2" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded p-2.5 bg-white" placeholder="Genaue Beschreibung oder Standort auf der Baustelle..."></textarea>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Foto-Nachweis (optional)</label>
            <div class="flex items-center gap-2 flex-wrap">
              <input id="taskPhotoInput" type="file" name="photo" accept="image/*"
                class="flex-1 min-w-0 text-xs text-slate-500 dark:text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100"
                onchange="onTaskPhotoSelected(this)">
              <button type="button" id="kiDefectBtn"
                onclick="runDefectAnalysis()"
                class="hidden shrink-0 text-xs bg-violet-600 hover:bg-violet-700 text-white px-3 py-1.5 rounded font-semibold transition">
                🔍 KI-Analyse
              </button>
            </div>
            <!-- KI-Vorschlag-Banner -->
            <div id="kiDefectSuggestion" class="hidden mt-2 bg-violet-50 dark:bg-violet-900/20 border border-violet-200 dark:border-violet-700 rounded-lg px-3 py-2 text-xs space-y-1">
              <div class="flex items-center justify-between gap-2">
                <span class="font-semibold text-violet-700 dark:text-violet-300" id="kiDefectStatus">⏳ Analysiere…</span>
                <button type="button" onclick="document.getElementById('kiDefectSuggestion').classList.add('hidden')"
                  class="text-violet-400 hover:text-violet-600 leading-none text-sm">✕</button>
              </div>
              <div id="kiDefectBody" class="hidden space-y-1">
                <p class="text-slate-600 dark:text-slate-300"><strong id="kiDefectTitle"></strong></p>
                <p class="text-slate-500 dark:text-slate-400" id="kiDefectDesc"></p>
                <div class="flex gap-2 pt-1">
                  <span id="kiDefectCat" class="px-2 py-0.5 rounded-full font-semibold bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300"></span>
                  <span id="kiDefectSev" class="px-2 py-0.5 rounded-full font-semibold bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300"></span>
                </div>
                <button type="button" onclick="acceptDefectSuggestion()"
                  class="w-full mt-1 py-1.5 rounded bg-violet-600 hover:bg-violet-700 text-white text-xs font-semibold transition">
                  ✓ Vorschlag übernehmen
                </button>
              </div>
            </div>
          </div>
          <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium px-4 py-2 rounded transition">Aufgabe hinzufügen</button>
          <button type="button" onclick="openKiChecklistModal()" class="bg-violet-600 hover:bg-violet-700 text-white text-xs font-medium px-4 py-2 rounded transition">✨ KI-Checkliste vorschlagen</button>
        </form>

        <!-- Liste der Aufgaben & Mängel -->
        <div class="space-y-3 pt-2">
          <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300">Offene & Erledigte Punkte:</h3>
          <% if (typeof tasks !== 'undefined' && tasks && tasks.length > 0) { %>
            <div class="space-y-3">
              <% tasks.forEach(task => { %>
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-slate-50 dark:bg-slate-700 p-3 rounded border dark:border-slate-600 gap-3 text-sm">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2">
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold 
                        <%= task.category === 'Mangel' ? 'bg-red-100 text-red-800' : (task.category === 'Bestellung' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800') %>">
                        <%= task.category %>
                      </span>
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold 
                        <%= task.status === 'Erledigt' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' %>">
                        <%= task.status %>
                      </span>
                      <strong class="text-slate-800 dark:text-gray-100"><%= task.title %></strong>
                    </div>
                    <% if (task.description) { %>
                      <p class="text-xs text-slate-600 dark:text-slate-300"><%= task.description %></p>
                    <% } %>
                    <div class="flex flex-wrap gap-3 mt-1 text-xs text-slate-500 dark:text-slate-400">
                      <% if (task.due_date) { %>
                        <span class="<%= new Date(task.due_date) < new Date() && task.status !== 'Erledigt' ? 'text-red-600 font-semibold' : '' %>">
                          📅 Fällig: <%= new Date(task.due_date).toLocaleDateString('de-DE') %>
                        </span>
                      <% } %>
                      <% if (task.assigned_username) { %>
                        <span>👤 <%= task.assigned_username %></span>
                      <% } %>
                    </div>
                    <% if (task.photo_url) { %>
                      <div class="pt-1">
                        <a href="<%= task.photo_url %>" target="_blank" class="text-blue-600 hover:underline text-xs font-medium inline-flex items-center gap-1">
                          📷 Foto-Nachweis ansehen
                        </a>
                      </div>
                    <% } %>
                  </div>

                  <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
                    <!-- Status umschalten -->
                    <form action="/projects/tasks/status" method="POST" class="inline">
                      <input type="hidden" name="task_id" value="<%= task.id %>">
                      <input type="hidden" name="project_id" value="<%= project.id %>">
                      <% if (task.status === 'Erledigt') { %>
                        <input type="hidden" name="status" value="Offen">
                        <button type="submit" class="bg-amber-50 text-amber-700 hover:bg-amber-100 px-2.5 py-1 rounded text-xs font-medium transition">Als offen markieren</button>
                      <% } else { %>
                        <input type="hidden" name="status" value="Erledigt">
                        <button type="submit" class="bg-green-600 text-white hover:bg-green-700 px-2.5 py-1 rounded text-xs font-medium transition">Erledigen</button>
                      <% } %>
                    </form>

                    <!-- Löschen -->
                    <form action="/projects/tasks/delete" method="POST" onsubmit="return confirm('Aufgabe wirklich löschen?');" class="inline">
                      <input type="hidden" name="task_id" value="<%= task.id %>">
                      <input type="hidden" name="project_id" value="<%= project.id %>">
                      <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 px-2.5 py-1 rounded text-xs font-medium transition">Löschen</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-xs text-slate-400 dark:text-slate-500 italic">Keine offenen Aufgaben oder Mängel für dieses Projekt erfasst.</p>
          <% } %>
        </div>
      </div>

            </div><!-- /sec-body -->
</section>

      <!-- ========== 4 NOTIZEN ========== -->
      <section id="sec-notizen" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-notizen" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-violet-600 dark:text-violet-400 bg-violet-50 dark:bg-violet-900/30">4 · Notizen</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="card-clean space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📝 Baustellen-Notizbuch</h2>

        <!-- ── Text-Notiz ──────────────────────────────── -->
        <form action="/projects/<%= project.id %>/notes/add" method="POST" class="space-y-3 bg-slate-50 dark:bg-slate-700/50 p-4 rounded border dark:border-slate-600">
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Neue Notiz / Absprache / Baustellen-Info hinzufügen</label>
          <textarea name="note_text" rows="2" required
            class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded p-2.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="z.B. Kunde wünscht nachträglich eine Änderung der RAL-Farbe..."></textarea>
          <button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white text-xs font-medium px-4 py-2 rounded transition">Notiz speichern</button>
        </form>

        <!-- ── Notizliste ──────────────────────────────── -->
        <div class="space-y-3 pt-2">
          <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300">Vorherige Notizen:</h3>
          <% if (notes && notes.length > 0) { %>
            <div class="space-y-2">
              <% notes.forEach(note => { %>
                <div class="flex justify-between items-start bg-slate-50 dark:bg-slate-700 p-3 rounded border dark:border-slate-600 text-sm">
                  <div class="space-y-1.5 pr-4 flex-1 min-w-0">
                    <p class="text-slate-800 dark:text-gray-200 whitespace-pre-wrap"><%= note.note_text %></p>
                    <span class="text-[10px] text-slate-400 dark:text-slate-500 block">
                      <%= new Date(note.created_at).toLocaleString('de-DE') %>
                    </span>
                  </div>
                  <form action="/projects/notes/delete" method="POST" onsubmit="return confirm('Notiz wirklich löschen?');" class="shrink-0">
                    <input type="hidden" name="note_id" value="<%= note.id %>">
                    <input type="hidden" name="project_id" value="<%= project.id %>">
                    <button type="submit" class="bg-red-50 dark:bg-red-900/30 text-red-600 hover:bg-red-100 px-2 py-1 rounded text-xs font-medium transition">Löschen</button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-xs text-slate-400 dark:text-slate-500 italic">Noch keine Notizen für dieses Projekt hinterlegt.</p>
          <% } %>
        </div>
      </div>

            </div><!-- /sec-body -->
</section>

      <!-- ========== 5 FOTOS ========== -->
      <section id="sec-fotos" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-fotos" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-pink-600 dark:text-pink-400 bg-pink-50 dark:bg-pink-900/30">5 · Fotos</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="card-clean space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📸 Baustellen-Abschlussfotos</h2>

        <!-- Upload-Formular für Fotos -->
        <form id="photoUploadForm" action="/projects/<%= project.id %>/photos/upload" method="POST" enctype="multipart/form-data" class="space-y-3 bg-slate-50 dark:bg-slate-700 p-4 rounded border dark:border-slate-600">
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Fertiges Baustellenfoto hochladen (JPG, PNG)</label>

          <div class="flex gap-2">
            <label class="flex-1 text-center text-xs font-semibold bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-lg py-2 cursor-pointer hover:bg-blue-100 dark:hover:bg-blue-900/50 transition">
              📷 Kamera
              <input type="file" accept="image/*" capture="environment" class="hidden" onchange="handleProjectPhotoPick(this)">
            </label>
            <label class="flex-1 text-center text-xs font-semibold bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-lg py-2 cursor-pointer hover:bg-green-100 dark:hover:bg-green-900/50 transition">
              🖼️ Galerie
              <input type="file" accept="image/*" class="hidden" onchange="handleProjectPhotoPick(this)">
            </label>
          </div>

          <!-- Verstecktes Feld, das tatsächlich mit dem Formular abgeschickt wird -->
          <input type="file" name="photo" id="photoFormInput" accept="image/*" class="hidden">
          <p id="photoFileName" class="text-xs text-slate-500 dark:text-slate-400 italic"></p>

          <input type="text" name="caption" placeholder="Beschriftung / Kommentar (optional)"
            class="w-full text-xs border border-slate-300 dark:border-slate-500 dark:bg-slate-600 dark:text-gray-100 rounded px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-green-500">
          <button type="submit" class="bg-green-600 hover:bg-green-700 text-white text-xs font-medium px-3 py-1.5 rounded transition">Foto hochladen</button>
        </form>

        <script>
          function handleProjectPhotoPick(input) {
            const formInput = document.getElementById('photoFormInput');
            const nameLabel = document.getElementById('photoFileName');
            if (input.files && input.files[0]) {
              const dt = new DataTransfer();
              dt.items.add(input.files[0]);
              formInput.files = dt.files;
              nameLabel.textContent = '✅ ' + input.files[0].name;
            }
          }
          (function () {
            const form = document.getElementById('photoUploadForm');
            if (!form) return;
            form.addEventListener('submit', function (e) {
              const formInput = document.getElementById('photoFormInput');
              if (!formInput.files || formInput.files.length === 0) {
                e.preventDefault();
                alert('Bitte zuerst ein Foto über „Kamera“ oder „Galerie“ auswählen.');
              }
            });
          })();
        </script>

        <!-- Galerie der hochgeladenen Fotos mit X-Löschbutton -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          <% if (photos && photos.length > 0) { %>
            <% photos.forEach(photo => { %>
              <div class="relative bg-slate-50 dark:bg-slate-700 rounded border dark:border-slate-600 p-2 flex flex-col items-center group">

                <!-- Löschen-Button -->
                <form action="/projects/photos/delete" method="POST" onsubmit="return confirm('Foto wirklich löschen?');" class="absolute top-3 right-3 z-10">
                  <input type="hidden" name="photo_id" value="<%= photo.id %>">
                  <input type="hidden" name="project_id" value="<%= project.id %>">
                  <button type="submit" class="bg-red-600 hover:bg-red-700 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold shadow transition opacity-80 group-hover:opacity-100" title="Foto löschen">&times;</button>
                </form>

                <a href="<%= photo.file_url %>" target="_blank" class="w-full">
                  <img src="<%= photo.file_url %>" alt="Baustellenfoto" class="w-full h-32 object-cover rounded hover:opacity-90 transition">
                </a>

                <!-- Beschriftung anzeigen / bearbeiten -->
                <% if (photo.caption) { %>
                  <p class="text-xs text-slate-600 dark:text-slate-300 mt-1.5 text-center w-full px-1 leading-snug"><%= photo.caption %></p>
                <% } %>
                <form action="/projects/photos/caption" method="POST" class="w-full mt-1">
                  <input type="hidden" name="photo_id" value="<%= photo.id %>">
                  <input type="hidden" name="project_id" value="<%= project.id %>">
                  <input type="text" name="caption" value="<%= photo.caption || '' %>"
                    placeholder="Beschriftung…"
                    class="w-full text-[10px] border border-slate-200 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:ring-1 focus:ring-green-500 truncate">
                  <button type="submit" class="mt-1 w-full text-[10px] bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 rounded py-0.5 transition">💾 Speichern</button>
                </form>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-xs text-slate-400 dark:text-slate-500 italic col-span-full">Noch keine Abschlussfotos für dieses Projekt hochgeladen.</p>
          <% } %>
        </div>
      </div>

            </div><!-- /sec-body -->
</section>

      <!-- ========== 6 TERMINE ========== -->
      <section id="sec-termine" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-termine" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-sky-600 dark:text-sky-400 bg-sky-50 dark:bg-sky-900/30">6 · Termine</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="card-clean">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2 mb-4">📅 Verknüpfte Termine – Wetter-Frühwarnung</h2>
        <% if (appointments && appointments.length > 0) { %>
          <ul class="divide-y divide-slate-200 dark:divide-slate-700">
            <% appointments.forEach(app => { %>
              <%
                const w = app.weather;
                let wBg = '', wBorder = '', wIcon = '', wLabel = '', wText = '';
                if (w && w.warningLevel === 'danger') {
                  wBg = 'bg-red-50'; wBorder = 'border-l-4 border-red-500';
                  wIcon = '🔴'; wLabel = 'GEFAHR – Montage prüfen!';
                  wText = `text-red-700`;
                } else if (w && w.warningLevel === 'warn') {
                  wBg = 'bg-yellow-50'; wBorder = 'border-l-4 border-yellow-400';
                  wIcon = '🟡'; wLabel = 'Wetterwarnung';
                  wText = `text-yellow-700`;
                } else if (w) {
                  wBg = 'bg-emerald-50'; wBorder = 'border-l-4 border-emerald-400';
                  wIcon = '🟢'; wLabel = 'Kein Wetterrisiko';
                  wText = `text-emerald-700`;
                } else {
                  wBg = 'bg-slate-50'; wBorder = 'border-l-4 border-slate-200';
                  wIcon = '–'; wLabel = 'Keine Vorhersage verfügbar';
                  wText = 'text-slate-400';
                }
              %>
              <li class="py-3 pl-3 <%= wBg %> <%= wBorder %> rounded mb-2 text-sm">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
                  <div class="flex-1">
                    <strong class="text-slate-800 dark:text-gray-100"><%= app.title %></strong>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5"><%= new Date(app.start_date).toLocaleString('de-DE') %></p>
                    <% if (app.description) { %><p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5"><%= app.description %></p><% } %>
                  </div>
                  <!-- Wetter-Box -->
                  <div class="text-xs rounded-lg px-3 py-2 min-w-[170px] <%= w ? (w.warningLevel === 'danger' ? 'bg-red-100' : w.warningLevel === 'warn' ? 'bg-yellow-100' : 'bg-emerald-100') : 'bg-slate-100' %>">
                    <p class="font-bold <%= wText %>"><%= wIcon %> <%= wLabel %></p>
                    <% if (w) { %>
                      <p class="text-slate-600 dark:text-slate-300 mt-1"><%= w.weatherText %></p>
                      <p class="text-slate-500 dark:text-slate-400">💨 Wind: <strong><%= w.windspeed %> km/h</strong></p>
                      <p class="text-slate-500 dark:text-slate-400">🌬 Böen: <strong><%= w.windgusts %> km/h</strong></p>
                      <p class="text-slate-500 dark:text-slate-400">🌧 Regen: <strong><%= w.precipitation %> mm</strong></p>
                    <% } else { %>
                      <p class="text-slate-400 dark:text-slate-500 mt-1">Termin liegt außerhalb des 16-Tage-Fensters.</p>
                    <% } %>
                  </div>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-sm text-slate-400 dark:text-slate-500">Keine spezifischen Termine für diesen Kunden im Kalender gefunden.</p>
        <% } %>
      </div>
</div>

            </div><!-- /sec-body -->
</section>

      <!-- ========== 7 STATUS ========== -->
      <section id="sec-status" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-status" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700">7 · Statusverlauf</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="card-clean">
    <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2 mb-4">📋 Statusverlauf</h2>
    <% if (statusLog && statusLog.length > 0) { %>
      <ol class="relative border-l border-slate-200 dark:border-slate-700 ml-2 space-y-4">
        <% statusLog.forEach((entry, idx) => { %>
          <li class="ml-4">
            <div class="absolute -left-1.5 w-3 h-3 rounded-full border-2 border-white dark:border-slate-800 <%= idx === statusLog.length - 1 ? 'bg-blue-500' : 'bg-slate-300 dark:bg-slate-600' %>"></div>
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <% if (entry.old_status) { %>
                <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium"><%= entry.old_status %></span>
                <span class="text-slate-400">→</span>
              <% } %>
              <span class="px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-semibold"><%= entry.new_status %></span>
              <span class="text-xs text-slate-400 dark:text-slate-500">
                von <strong class="text-slate-600 dark:text-slate-300"><%= entry.changed_by %></strong>
                · <%= new Date(entry.created_at).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' }) %>
              </span>
            </div>
          </li>
        <% }) %>
      </ol>
    <% } else { %>
      <p class="text-sm text-slate-400 dark:text-slate-500 italic">Noch keine Statusänderungen aufgezeichnet.</p>
    <% } %>
  </div>
</div>

            </div><!-- /sec-body -->
</section>

      <!-- ========== 8 MATERIAL ========== -->
      <section id="sec-material" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-material" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-orange-600 dark:text-orange-400 bg-orange-50 dark:bg-orange-900/30">8 · Material</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="card-clean space-y-4">
    <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">🏗️ Materialentnahme</h2>

    <!-- Entnahme-Formular -->
    <% if (lagerItems && lagerItems.length > 0) { %>
      <form action="/projects/<%= project.id %>/material/add" method="POST"
        class="grid grid-cols-1 sm:grid-cols-4 gap-3 bg-slate-50 dark:bg-slate-700 p-4 rounded border dark:border-slate-600">
        <div class="sm:col-span-2">
          <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Material</label>
          <select name="lager_item_id" required class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">— Material wählen —</option>
            <% lagerItems.forEach(item => { %>
              <option value="<%= item.id %>">
                <%= item.bezeichnung %><%= item.profil ? ' · ' + item.profil : '' %>
                (Bestand: <%= parseFloat(item.menge).toLocaleString('de-DE') %> <%= item.einheit %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Menge</label>
          <input type="number" name="menge" step="0.001" min="0.001" required placeholder="z.B. 2.5"
            class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Notiz (optional)</label>
          <input type="text" name="notiz" placeholder="z.B. Pfosten Tor"
            class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div class="sm:col-span-4 flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded transition">Material entnehmen</button>
        </div>
      </form>
    <% } else { %>
      <p class="text-sm text-slate-400 dark:text-slate-500 italic">Kein Lagerbestand vorhanden. Zuerst Artikel im <a href="/lager" class="text-blue-600 hover:underline">Lager</a> anlegen.</p>
    <% } %>

    <!-- Entnahme-Protokoll -->
    <% if (entnahmen && entnahmen.length > 0) { %>
      <%
        let matGesamtkosten = 0;
        entnahmen.forEach(e => { matGesamtkosten += Number(e.gesamtpreis || 0); });
      %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[400px]">
          <thead class="bg-slate-50 dark:bg-slate-700/50 text-xs text-slate-500 dark:text-slate-400 uppercase">
            <tr>
              <th class="px-3 py-2 text-left">Material</th>
              <th class="px-3 py-2 text-right">Menge</th>
              <th class="px-3 py-2 text-right hidden sm:table-cell">Preis/Einh.</th>
              <th class="px-3 py-2 text-right hidden sm:table-cell">Gesamt</th>
              <th class="px-3 py-2 text-left hidden md:table-cell">Notiz</th>
              <th class="px-3 py-2 text-right hidden md:table-cell">Datum</th>
              <th class="px-3 py-2 text-right">Aktion</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            <% entnahmen.forEach(e => { %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30">
                <td class="px-3 py-2 font-medium text-slate-700 dark:text-slate-200">
                  <%= e.bezeichnung %><% if (e.profil) { %> <span class="text-slate-400 font-normal">· <%= e.profil %></span><% } %>
                </td>
                <td class="px-3 py-2 text-right text-slate-800 dark:text-gray-100 font-semibold">
                  <%= parseFloat(e.menge).toLocaleString('de-DE') %> <%= e.einheit %>
                </td>
                <td class="px-3 py-2 text-right text-slate-500 dark:text-slate-400 hidden sm:table-cell text-xs">
                  <% if (Number(e.einheitspreis) > 0) { %>
                    <%= Number(e.einheitspreis).toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) %> €
                  <% } else { %>–<% } %>
                </td>
                <td class="px-3 py-2 text-right text-slate-700 dark:text-slate-200 hidden sm:table-cell font-semibold text-xs">
                  <% if (Number(e.gesamtpreis) > 0) { %>
                    <%= Number(e.gesamtpreis).toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) %> €
                  <% } else { %>–<% } %>
                </td>
                <td class="px-3 py-2 text-slate-500 dark:text-slate-400 hidden md:table-cell"><%= e.notiz || '–' %></td>
                <td class="px-3 py-2 text-right text-slate-400 dark:text-slate-500 hidden md:table-cell text-xs">
                  <%= new Date(e.created_at).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' }) %>
                </td>
                <td class="px-3 py-2 text-right">
                  <form action="/projects/material/delete" method="POST" class="inline"
                    onsubmit="return confirm('Entnahme stornieren? Die Menge wird wieder ins Lager zurückgebucht.');">
                    <input type="hidden" name="entnahme_id" value="<%= e.id %>">
                    <input type="hidden" name="project_id" value="<%= project.id %>">
                    <button type="submit" class="bg-red-50 dark:bg-red-900/30 text-red-600 hover:bg-red-100 px-2 py-1 rounded text-xs font-medium transition">Löschen</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
          <% if (matGesamtkosten > 0) { %>
          <tfoot class="border-t-2 border-slate-200 dark:border-slate-600 font-semibold text-slate-700 dark:text-slate-200">
            <tr>
              <td class="px-3 py-2.5" colspan="3">Materialkosten gesamt</td>
              <td class="px-3 py-2.5 text-right text-emerald-700 dark:text-emerald-400 font-bold">
                <%= matGesamtkosten.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) %> €
              </td>
              <td colspan="2" class="hidden md:table-cell"></td>
            </tr>
          </tfoot>
          <% } %>
        </table>
      </div>
    <% } else { %>
      <p class="text-xs text-slate-400 dark:text-slate-500 italic">Noch kein Material für dieses Projekt entnommen.</p>
    <% } %>
  </div>
</div>

            </div><!-- /sec-body -->
</section>

      <!-- ========== 9 STUNDEN ========== -->
<%
  const _matKosten = typeof entnahmen !== 'undefined'
    ? entnahmen.reduce((s, e) => s + Number(e.gesamtpreis || 0), 0)
    : 0;
%>
      <section id="sec-stunden" class="scroll-mt-28 space-y-3">
        <div class="flex items-center gap-2 sec-toggle" data-sec="sec-stunden" role="button" tabindex="0" aria-expanded="true">
          <span class="sec-label text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/30">9 · Stunden &amp; Kalkulation</span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
          <span class="chev" aria-hidden="true">▼</span>
        </div>
      <div class="sec-body">
      <div class="card-clean">
    <div class="flex items-center justify-between gap-3 border-b dark:border-slate-700 pb-3 mb-4">
      <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100">⏱️ Stunden &amp; Nachkalkulation</h2>
      <% if (typeof projectTotalHours !== 'undefined' && parseFloat(projectTotalHours) > 0) { %>
        <span class="text-sm font-bold text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 rounded-full">
          Gesamt: <%= projectTotalHours %> Std.
        </span>
      <% } %>
    </div>

    <% if (typeof projectHours !== 'undefined' && projectHours.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[380px]">
          <thead class="bg-slate-50 dark:bg-slate-700/50 text-slate-600 dark:text-slate-300 uppercase text-xs">
            <tr>
              <th class="px-4 py-2">Mitarbeiter</th>
              <th class="px-4 py-2 text-right">Stunden</th>
              <th class="px-4 py-2 text-right hidden md:table-cell">Anteil</th>
              <th class="px-4 py-2 hidden md:table-cell">Fortschritt</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            <% projectHours.forEach(row => {
                 const pct = projectTotalHours > 0 ? Math.round((parseFloat(row.hours) / parseFloat(projectTotalHours)) * 100) : 0;
            %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30">
