  <img id="sketchLightboxImg" src="" alt="Skizze" class="max-w-full max-h-full rounded shadow-2xl bg-white">
</div>

<script src="https://cdn.jsdelivr.net/npm/qrious@4.0.2/dist/qrious.min.js"></script>
<script>
  (function() {
    const projectUrl = window.location.origin + '/projects/<%= project.id %>';
    document.getElementById('qrUrl').textContent = projectUrl;

    let qrGenerated = false;
    document.getElementById('qrOpenBtn').addEventListener('click', function() {
      if (!qrGenerated) {
        const qr = new QRious({
          element: document.getElementById('qrCanvas'),
          value: projectUrl,
          size: 200,
          foreground: '#1e293b',
          background: '#ffffff',
          level: 'H'
        });
        qrGenerated = true;
      }
    });
  })();

  function downloadQR() {
    const canvas = document.getElementById('qrCanvas');
    const link = document.createElement('a');
    link.download = 'QR-Auftrag-<%= project.id %>.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  }
</script>


<script>
(function() {
  const canvas = document.getElementById('sketchCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const wrap = document.getElementById('sketch-wrap');
  const projectId = <%= project.id %>;
  const statusEl = document.getElementById('sketch-status');

  // ── Zustand: Vektor-Elemente statt Raster-Snapshots ──────────────
  // (schneller, speicherschonender, korrektes Undo, sauberer Resize/Redraw,
  //  und erlaubt späteres Weiterbearbeiten über drawing_json)
  let elements   = [];   // { type:'path'|'erase'|'line'|'rect'|'text', ... }
  let bgImage    = null; // optionales Hintergrundfoto (Baustellenfoto)
  let previewEl  = null; // Vorschau für Linie/Rechteck während des Ziehens
  let currentEl  = null; // aktueller Freihand-/Radier-Strich
  let drawing    = false;
  let startPos   = null;
  let pendingTextPos = null;
  let tool = 'pen';

  const colorEl     = document.getElementById('sketch-color');
  const sizeEl       = document.getElementById('sketch-size');
  const sizeLabel     = document.getElementById('sketch-size-label');
  const fontSizeEl   = document.getElementById('sketch-font-size');
  sizeEl.addEventListener('input', () => { sizeLabel.textContent = sizeEl.value; });

  const getColor = () => colorEl.value;
  const getWidth = () => parseInt(sizeEl.value, 10) || 3;
  const getFontSize = () => parseInt(fontSizeEl.value, 10) || 18;

  // ── Werkzeugauswahl ──────────────────────────────────────────────
  function setActiveTool(name) {
    tool = name;
    document.querySelectorAll('.sketch-tool').forEach(btn => {
      if (btn.dataset.tool === name) {
        btn.className = 'sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-blue-600 text-white';
      } else {
        btn.className = 'sketch-tool px-3 py-1.5 rounded text-xs font-medium bg-white dark:bg-slate-800 border dark:border-slate-600 text-slate-700 dark:text-slate-200';
      }
    });
    canvas.style.cursor = (name === 'text') ? 'text' : 'crosshair';
  }
  document.querySelectorAll('.sketch-tool').forEach(btn => {
    btn.addEventListener('click', () => setActiveTool(btn.dataset.tool));
  });

  // ── Canvas-Größe: hochauflösend (bis DPR 2) und responsiv ────────
  // Interne Pixelgröße wird an die tatsächliche Anzeigebreite angepasst,
  // die Vektor-Elemente werden bei jedem Resize einfach neu gezeichnet
  // (kein Qualitätsverlust, kein "kaputtes" Bild bei Drehung des Tablets).
  let cssW = 900, cssH = 520;
  function resizeCanvas() {
    const parentW = wrap.clientWidth || 900;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cssW = parentW;
    cssH = Math.min(600, Math.max(320, Math.round(cssW * 0.58)));
    canvas.style.width = cssW + 'px';
    canvas.style.height = cssH + 'px';
    canvas.width  = Math.round(cssW * dpr);
    canvas.height = Math.round(cssH * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    redraw();
  }

  // ── Zeichnen ──────────────────────────────────────────────────────
  function redraw() {
    ctx.clearRect(0, 0, cssW, cssH);
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, cssW, cssH);
    if (bgImage) ctx.drawImage(bgImage, 0, 0, cssW, cssH);
    elements.forEach(drawElement);
    if (previewEl) drawElement(previewEl);
  }

  function strokePath(points) {
    // sanft geglättete Linie durch quadratische Kurven statt eckiger Segmente
    ctx.beginPath();
    ctx.moveTo(points[0].x, points[0].y);
    for (let i = 1; i < points.length - 1; i++) {
      const mx = (points[i].x + points[i + 1].x) / 2;
      const my = (points[i].y + points[i + 1].y) / 2;
      ctx.quadraticCurveTo(points[i].x, points[i].y, mx, my);
    }
    if (points.length > 1) {
      const last = points[points.length - 1];
      ctx.lineTo(last.x, last.y);
    }
    ctx.stroke();
  }

  function drawElement(el) {
    if (el.type === 'path' || el.type === 'erase') {
      if (!el.points || el.points.length === 0) return;
      ctx.save();
      ctx.globalCompositeOperation = el.type === 'erase' ? 'destination-out' : 'source-over';
      ctx.strokeStyle = el.color;
      ctx.lineWidth = el.width;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      if (el.points.length === 1) {
        ctx.fillStyle = el.color;
        ctx.beginPath();
        ctx.arc(el.points[0].x, el.points[0].y, el.width / 2, 0, Math.PI * 2);
        ctx.fill();
      } else {
        strokePath(el.points);
      }
      ctx.restore();
    } else if (el.type === 'line') {
      ctx.save();
      ctx.strokeStyle = el.color;
      ctx.lineWidth = el.width;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(el.x1, el.y1);
      ctx.lineTo(el.x2, el.y2);
      ctx.stroke();
      ctx.restore();
    } else if (el.type === 'rect') {
      ctx.save();
      ctx.strokeStyle = el.color;
      ctx.lineWidth = el.width;
      ctx.strokeRect(el.x, el.y, el.w, el.h);
      ctx.restore();
    } else if (el.type === 'text') {
      ctx.save();
      ctx.font = `bold ${el.fontSize}px system-ui, sans-serif`;
      ctx.textBaseline = 'top';
      const metrics = ctx.measureText(el.text);
      const pad = 3;
      ctx.fillStyle = 'rgba(255,255,255,0.75)';
      ctx.fillRect(el.x - pad, el.y - pad, metrics.width + pad * 2, el.fontSize + pad * 2);
      ctx.fillStyle = el.color;
      ctx.fillText(el.text, el.x, el.y);
      ctx.restore();
    }
  }

  function getPos(evt) {
    const rect = canvas.getBoundingClientRect();
    const scaleX = cssW / rect.width;
    const scaleY = cssH / rect.height;
    return { x: (evt.clientX - rect.left) * scaleX, y: (evt.clientY - rect.top) * scaleY };
  }

  // ── Text-Eingabebox (statt blockierendem prompt()) ───────────────
  const textBox   = document.getElementById('sketch-text-box');
  const textInput = document.getElementById('sketch-text-input');

  function showTextBox(clientX, clientY) {
    const wrapRect = wrap.getBoundingClientRect();
    let left = clientX - wrapRect.left;
    let top  = clientY - wrapRect.top;
    left = Math.max(4, Math.min(left, wrapRect.width - 190));
    top  = Math.max(4, Math.min(top, wrapRect.height - 84));
    textBox.style.left = left + 'px';
    textBox.style.top  = top + 'px';
    textBox.classList.remove('hidden');
    textInput.value = '';
    textInput.focus();
  }
  function hideTextBox() { textBox.classList.add('hidden'); pendingTextPos = null; }

  document.getElementById('sketch-text-ok').addEventListener('click', () => {
    const val = textInput.value.trim();
    if (val && pendingTextPos) {
      elements.push({ type: 'text', x: pendingTextPos.x, y: pendingTextPos.y, text: val, color: getColor(), fontSize: getFontSize() });
      redraw();
    }
    hideTextBox();
  });
  document.getElementById('sketch-text-cancel').addEventListener('click', hideTextBox);
  textInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); document.getElementById('sketch-text-ok').click(); }
    if (e.key === 'Escape') hideTextBox();
  });

  // ── Pointer-Events (vereinheitlicht Maus, Touch & Stift) ─────────
  canvas.addEventListener('pointerdown', (e) => {
    if (tool === 'text') {
      pendingTextPos = getPos(e);
      showTextBox(e.clientX, e.clientY);
      return;
    }
    canvas.setPointerCapture(e.pointerId);
    const p = getPos(e);
    startPos = p;
    drawing = true;
    if (tool === 'line') {
      previewEl = { type: 'line', x1: p.x, y1: p.y, x2: p.x, y2: p.y, color: getColor(), width: getWidth() };
    } else if (tool === 'rect') {
      previewEl = { type: 'rect', x: p.x, y: p.y, w: 0, h: 0, color: getColor(), width: getWidth() };
    } else {
      currentEl = {
        type: tool === 'eraser' ? 'erase' : 'path',
        points: [p],
        color: getColor(),
        width: tool === 'eraser' ? Math.max(10, getWidth() * 4) : getWidth()
      };
      elements.push(currentEl);
    }
    redraw();
  });

  canvas.addEventListener('pointermove', (e) => {
    if (!drawing) return;
    const p = getPos(e);
    if (tool === 'line' && previewEl) {
      previewEl.x2 = p.x; previewEl.y2 = p.y;
    } else if (tool === 'rect' && previewEl) {
      previewEl.w = p.x - startPos.x;
      previewEl.h = p.y - startPos.y;
    } else if (currentEl) {
      currentEl.points.push(p);
    }
    redraw();
  });

  function endStroke() {
    if (!drawing) return;
    drawing = false;
    if ((tool === 'line' || tool === 'rect') && previewEl) {
      elements.push(previewEl);
      previewEl = null;
    }
    currentEl = null;
    redraw();
  }
  canvas.addEventListener('pointerup', endStroke);
  canvas.addEventListener('pointercancel', endStroke);

  // ── Rückgängig / Leeren ──────────────────────────────────────────
  document.getElementById('sketch-undo').addEventListener('click', () => {
    elements.pop();
    redraw();
  });
  document.getElementById('sketch-clear').addEventListener('click', () => {
    if (elements.length === 0 && !bgImage) return;
    if (!confirm('Skizze wirklich komplett leeren?')) return;
    elements = [];
    bgImage = null;
    redraw();
  });

  // ── Hintergrundfoto laden (z.B. Baustellenfoto, darüber skizzieren) ──
  document.getElementById('sketch-bg-input').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const img = new Image();
      img.onload = () => { bgImage = img; redraw(); };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
    e.target.value = '';
  });

  // ── Bestehende Skizze zum Weiterbearbeiten laden ─────────────────
  document.querySelectorAll('.sketch-edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      try {
        const parsed = JSON.parse(btn.dataset.json);
        elements = Array.isArray(parsed) ? parsed : [];
        bgImage = null;
        redraw();
        wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
        statusEl.textContent = 'Skizze zum Bearbeiten geladen – nach Änderungen erneut speichern.';
        statusEl.className = 'text-xs text-blue-600 dark:text-blue-400';
      } catch (err) {
        statusEl.textContent = 'Skizze konnte nicht zum Bearbeiten geladen werden.';
        statusEl.className = 'text-xs text-red-600';
      }
    });
  });

  // ── Vollbildansicht gespeicherter Skizzen ────────────────────────
  document.querySelectorAll('.sketch-thumb').forEach(img => {
    img.addEventListener('click', () => {
      document.getElementById('sketchLightboxImg').src = img.src;
      document.getElementById('sketchLightbox').classList.remove('hidden');
    });
  });

  // ── Speichern ─────────────────────────────────────────────────────
  document.getElementById('sketch-save-btn').addEventListener('click', async () => {
    if (elements.length === 0 && !bgImage) {
      statusEl.textContent = 'Bitte zuerst etwas zeichnen.';
      statusEl.className = 'text-xs text-amber-600';
      return;
    }
    const btn = document.getElementById('sketch-save-btn');
    const title = (document.getElementById('sketch-title').value || 'Skizze').trim();
    btn.disabled = true;
    statusEl.textContent = 'Speichere…';
    statusEl.className = 'text-xs text-slate-500 dark:text-slate-400';
    try {
      const image_data = canvas.toDataURL('image/png');
      const res = await fetch('/projects/' + projectId + '/sketches/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ title, image_data, drawing_json: JSON.stringify(elements) })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(data.error || 'Speichern fehlgeschlagen');
      statusEl.textContent = 'Gespeichert – Seite wird neu geladen…';
      statusEl.className = 'text-xs text-emerald-600';
      setTimeout(() => location.reload(), 500);
    } catch (err) {
      statusEl.textContent = 'Fehler: ' + (err.message || err);
      statusEl.className = 'text-xs text-red-600';
      btn.disabled = false;
    }
  });

  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();
  setActiveTool('pen');
})();
</script>

