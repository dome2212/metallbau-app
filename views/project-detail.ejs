  const textarea= document.getElementById('kiSummaryText');

  btn.disabled = true; btn.textContent = '⏳ Generiert…';
  loading.classList.remove('hidden');
  errorBox.classList.add('hidden');
  textarea.value = '';

  try {
    const res  = await fetch('/projects/<%= project.id %>/ai-summary', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin'
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'Unbekannter Fehler');
    textarea.value = data.summary;
  } catch (err) {
    errorBox.textContent = '❌ ' + err.message;
    errorBox.classList.remove('hidden');
  } finally {
    loading.classList.add('hidden');
    btn.disabled = false; btn.textContent = '📋 Neu generieren';
  }
}

async function saveKiSummaryAsNote() {
  const text = document.getElementById('kiSummaryText').value.trim();
  if (!text) { alert('Bitte zuerst einen Statusbericht generieren.'); return; }
  const body = new URLSearchParams();
  body.append('note_text', '📋 KI-Statusbericht:\n\n' + text);
  try {
    const res = await fetch('/projects/<%= project.id %>/notes/add', {
      method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      credentials: 'same-origin', body: body.toString()
    });
    if (res.ok || res.redirected) {
      document.getElementById('kiSummaryModal').classList.add('hidden');
      window.location.reload();
    } else { alert('Fehler beim Speichern.'); }
  } catch (err) { alert('Netzwerkfehler: ' + err.message); }
