// ================================================
// KI-CHECKLISTE
// ================================================
let _kiChecklistTasks = [];

function openKiChecklistModal() {
  document.getElementById('kiChecklistModal').classList.remove('hidden');
  document.getElementById('kiChecklistError').classList.add('hidden');
  document.getElementById('kiChecklistLoading').classList.add('hidden');
  document.getElementById('kiChecklistResults').classList.add('hidden');
  document.getElementById('kiChecklistAcceptBtn').classList.add('hidden');
}

async function generateKiChecklist() {
  const btn     = document.getElementById('kiChecklistGenerateBtn');
  const loading = document.getElementById('kiChecklistLoading');
  const errorBox= document.getElementById('kiChecklistError');
  const results = document.getElementById('kiChecklistResults');
  const acceptBtn= document.getElementById('kiChecklistAcceptBtn');

  btn.disabled = true; btn.textContent = '⏳ Lädt…';
  loading.classList.remove('hidden');
  errorBox.classList.add('hidden');
  results.classList.add('hidden');
  acceptBtn.classList.add('hidden');

  try {
    const res  = await fetch('/projects/<%= project.id %>/ai-checklist', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin'
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'Unbekannter Fehler');

    _kiChecklistTasks = data.tasks || [];
    const catColors = { 'Restarbeit': 'bg-blue-100 text-blue-800', 'Mangel': 'bg-red-100 text-red-800', 'Bestellung': 'bg-purple-100 text-purple-800' };

    results.innerHTML = _kiChecklistTasks.map((t, i) => `
      <label class="flex items-center gap-3 bg-slate-50 dark:bg-slate-700 border dark:border-slate-600 rounded-lg px-3 py-2 cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-600 transition">
        <input type="checkbox" class="ki-task-cb w-4 h-4 accent-violet-600" data-idx="${i}" checked>
        <span class="flex-1 text-sm text-slate-800 dark:text-gray-100">${t.title || ''}</span>
        <span class="text-[10px] font-semibold px-2 py-0.5 rounded ${catColors[t.category] || 'bg-slate-100 text-slate-600'}">${t.category || 'Restarbeit'}</span>
      </label>`).join('');

    results.classList.remove('hidden');
    acceptBtn.classList.remove('hidden');
  } catch (err) {
    errorBox.textContent = '❌ ' + err.message;
    errorBox.classList.remove('hidden');
  } finally {
    loading.classList.add('hidden');
    btn.disabled = false; btn.textContent = '✨ Neu laden';
  }
}

async function acceptKiChecklist() {
  const checked = Array.from(document.querySelectorAll('.ki-task-cb:checked'))
    .map(cb => _kiChecklistTasks[parseInt(cb.dataset.idx)])
    .filter(Boolean);

  if (!checked.length) { alert('Keine Aufgaben ausgewählt.'); return; }

  const acceptBtn = document.getElementById('kiChecklistAcceptBtn');
  acceptBtn.disabled = true; acceptBtn.textContent = '⏳ Speichert…';

  try {
    for (const task of checked) {
      const body = new URLSearchParams();
      body.append('title', task.title || '');
      body.append('category', task.category || 'Restarbeit');
      body.append('description', '');
      await fetch('/projects/<%= project.id %>/tasks/add', {
        method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        credentials: 'same-origin', body: body.toString()
      });
    }
    document.getElementById('kiChecklistModal').classList.add('hidden');
    window.location.reload();
  } catch (err) {
    alert('Fehler beim Speichern: ' + err.message);
    acceptBtn.disabled = false; acceptBtn.textContent = '✅ Ausgewählte übernehmen';
  }
}
</script>
<% } %>

<!-- QR-CODE MODAL -->
<div id="qrModal" class="hidden fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl max-w-sm w-full p-6 flex flex-col items-center gap-4">
    <div class="flex justify-between items-center w-full border-b dark:border-slate-700 pb-3">
      <h3 class="text-base font-bold text-slate-800 dark:text-gray-100">📱 QR-Code – Auftrag</h3>
      <button onclick="document.getElementById('qrModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400 text-center">Scanne den Code um direkt zu diesem Auftrag zu gelangen.</p>
    <div id="qrCodeContainer" class="bg-white p-3 rounded-lg border border-slate-200">
      <canvas id="qrCanvas"></canvas>
    </div>
    <p class="text-xs text-slate-400 font-mono break-all text-center" id="qrUrl"></p>
    <button onclick="downloadQR()" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
      💾 QR-Code herunterladen
    </button>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/qrious@4.0.2/dist/qrious.min.js"></script>
<script>
  (function() {
    const projectUrl = window.location.origin + '/projects/<%= project.id %>';
    document.getElementById('qrUrl').textContent = projectUrl;

    let qrGenerated = false;
    document.getElementById('qrOpenBtn').addEventListener('click', function() {
      if (!qrGenerated) {
        const qr = new QRious({
          element: document.getElementById('qrCanvas'),
          value: projectUrl,
          size: 200,
          foreground: '#1e293b',
          background: '#ffffff',
          level: 'H'
        });
        qrGenerated = true;
      }
    });
  })();

  function downloadQR() {
    const canvas = document.getElementById('qrCanvas');
    const link = document.createElement('a');
    link.download = 'QR-Auftrag-<%= project.id %>.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  }
</script>

</body>
</html>
