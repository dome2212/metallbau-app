<% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') { %>
<div id="kiChecklistModal" class="hidden fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl max-w-lg w-full p-5 md:p-7 max-h-[90vh] flex flex-col gap-4">
    <div class="flex justify-between items-center border-b dark:border-slate-700 pb-3">
      <h3 class="text-lg font-bold text-slate-800 dark:text-gray-100">✨ KI-Checkliste vorschlagen</h3>
      <button onclick="document.getElementById('kiChecklistModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold leading-none">&times;</button>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400">Die KI schlägt typische Aufgaben für diesen Metallbau-Auftrag vor. Wähle aus welche du übernehmen möchtest.</p>
    <div id="kiChecklistLoading" class="hidden flex items-center gap-3 text-sm text-violet-600 font-medium py-4">
      <svg class="animate-spin h-5 w-5 text-violet-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
      </svg>
      KI erstellt Checkliste…
    </div>
    <div id="kiChecklistError" class="hidden bg-red-50 border border-red-200 text-red-700 text-xs rounded px-3 py-2"></div>
    <div id="kiChecklistResults" class="hidden space-y-2 max-h-64 overflow-y-auto"></div>
    <div id="kiChecklistEmpty" class="hidden text-xs text-slate-400 italic text-center py-4">Noch keine Vorschläge geladen.</div>
    <div class="flex justify-between items-center gap-3 pt-2 border-t dark:border-slate-700">
      <button id="kiChecklistGenerateBtn" onclick="generateKiChecklist()"
