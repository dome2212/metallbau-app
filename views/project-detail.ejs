<%- include('partials/header') %>
<%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">
    <header class="bg-white dark:bg-slate-800 shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
      <div>
        <a href="/projects" class="text-xs text-blue-600 hover:underline">← Zurück zur Übersicht</a>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100"><%= project.title %></h1>
      </div>
      <div class="flex items-center gap-2">
        <%
          const headerStatusColors = {
            'In Planung':         'bg-slate-100 text-slate-700',
            'Avor / Vorbereitung':'bg-blue-100 text-blue-800',
            'In Produktion':      'bg-amber-100 text-amber-800',
            'Oberfläche':         'bg-purple-100 text-purple-800',
            'Montagebereit':      'bg-emerald-100 text-emerald-800',
            'Montage läuft':      'bg-orange-100 text-orange-800',
            'Abgeschlossen':      'bg-green-100 text-green-800'
          };
          const hsc = headerStatusColors[project.status] || 'bg-blue-100 text-blue-800';
        %>
        <span class="px-3 py-1 rounded text-sm font-semibold <%= hsc %>"><%= project.status %></span>
        <% if (currentUser.role === 'ADMIN') { %>
          <a href="/projects/<%= project.id %>/pdf" target="_blank"
            class="px-3 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 rounded text-xs font-semibold transition flex items-center gap-1">
            📄 Lieferschein PDF
          </a>
          <button onclick="document.getElementById('editProjectModal').classList.remove('hidden')"
            class="px-3 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded text-xs font-semibold transition">
            ✏️ Bearbeiten
          </button>
        <% } %>
      </div>
    </header>

    <div class="p-4 md:p-6 max-w-7xl mx-auto w-full space-y-6">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Kundendaten & Details -->
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 md:p-6 space-y-4">
          <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📋 Projektdetails</h2>
          <div>
            <span class="text-xs text-slate-400 dark:text-slate-500 block">Kunde / Baustelle</span>
            <strong class="text-slate-700 dark:text-gray-200"><%= project.company_name || project.contact_person %></strong>
            <p class="text-sm text-slate-600 dark:text-slate-300"><%= project.street %>, <%= project.zip %> <%= project.city %></p>
          </div>
          
          <!-- Auftragssumme nur für den Chef (ADMIN) sichtbar -->
          <% if (currentUser.role === 'ADMIN') { %>
            <div>
              <span class="text-xs text-slate-400 dark:text-slate-500 block">Auftragssumme</span>
              <span class="text-xl font-bold text-slate-800 dark:text-gray-100"><%= (Number(project.total_price) || 0).toLocaleString('de-DE', {minimumFractionDigits: 2}) %> €</span>
            </div>
          <% } %>

          <div>
            <span class="text-xs text-slate-400 dark:text-slate-500 block">Beschreibung</span>
            <p class="text-sm text-slate-600 dark:text-slate-300"><%= project.description || 'Keine Beschreibung hinterlegt.' %></p>
          </div>

          <!-- Baustellenkoordinaten (Geo-Fencing) — nur Admin -->
          <% if (currentUser.role === 'ADMIN') { %>
            <div class="border-t dark:border-slate-700 pt-4 space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">📍 Geo-Fencing Standort</span>
                <% if (project.site_lat && project.site_lng) { %>
                  <span class="text-xs bg-green-100 text-green-700 font-semibold px-2 py-0.5 rounded-full">Aktiv</span>
                <% } else { %>
                  <span class="text-xs bg-slate-100 text-slate-500 font-semibold px-2 py-0.5 rounded-full">Nicht gesetzt</span>
                <% } %>
              </div>
              <% if (project.site_lat && project.site_lng) { %>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  Lat: <strong><%= project.site_lat %></strong> · Lng: <strong><%= project.site_lng %></strong> · Radius: <strong><%= project.site_radius || 200 %> m</strong>
                </p>
              <% } %>
              <form action="/projects/<%= project.id %>/set-location" method="POST" class="space-y-2" id="geo-form">

                <!-- Adresssuche via OpenStreetMap Nominatim -->
                <div>
                  <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Adresse suchen</label>
                  <div class="flex gap-1">
                    <input type="text" id="geo-address-input"
                      placeholder="z.B. Musterstraße 5, 45678 Musterstadt"
                      class="flex-1 text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-indigo-400">
                    <button type="button" onclick="geocodeAddress()"
                      class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium px-2.5 py-1.5 rounded transition whitespace-nowrap">
                      🔍 Suchen
                    </button>
                  </div>
                  <!-- Kundenadresse als Schnellauswahl -->
                  <% if (project.street && project.city) { %>
                    <button type="button"
                      onclick="useCustomerAddress('<%= (project.street + ', ' + (project.zip || '') + ' ' + project.city).trim().replace(/'/g, "\\'") %>')"
                      class="mt-1 w-full text-left text-[10px] text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 px-2 py-1 rounded border border-indigo-200 transition truncate">
                      🏢 Kundenadresse übernehmen: <%= project.street %>, <%= project.zip %> <%= project.city %>
                    </button>
                  <% } %>
                  <!-- Suchergebnis-Feedback -->
                  <p id="geo-status" class="text-[10px] mt-1 hidden"></p>
                </div>

                <!-- Koordinaten (werden automatisch gefüllt oder können manuell eingegeben werden) -->
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Breitengrad (Lat)</label>
                      <input type="number" step="0.0000001" name="site_lat" id="geo-lat" value="<%= project.site_lat || '' %>" placeholder="z.B. 51.3069" class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1.5 bg-white">
                    </div>
                    <div>
                      <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Längengrad (Lng)</label>
                      <input type="number" step="0.0000001" name="site_lng" id="geo-lng" value="<%= project.site_lng || '' %>" placeholder="z.B. 6.9483" class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1.5 bg-white">
                    </div>
                  </div>
                  <div>
                    <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Erkennungsradius (Meter)</label>
                    <input type="number" name="site_radius" value="<%= project.site_radius || 200 %>" min="50" max="2000" class="w-full text-xs border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1.5 bg-white">
                  </div>
                  <div class="flex gap-2">
                    <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium py-1.5 rounded transition">Koordinaten speichern</button>
                    <button type="button" onclick="useMyLocationForProject()" class="flex-1 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-medium py-1.5 rounded transition">📍 Meinen Standort</button>
                </div>
              </form>
            </div>
          <% } %>
        </div>

        <!-- Technische Zeichnungen & Dateien -->
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 md:p-6 space-y-4">
          <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📐 Technische Zeichnungen & Pläne</h2>
          
          <!-- Upload-Formular -->
          <form action="/projects/<%= project.id %>/upload" method="POST" enctype="multipart/form-data" class="space-y-3 bg-slate-50 dark:bg-slate-700 p-4 rounded border dark:border-slate-600">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Zeichnung / Skizze / Foto hochladen (PDF, Bild)</label>
            <input type="file" name="file" required class="w-full text-xs text-slate-500 dark:text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded transition">Datei hochladen</button>
          </form>

          <!-- Liste der hochgeladenen Dateien -->
          <div class="space-y-2">
            <% if (files && files.length > 0) { %>
              <% files.forEach(file => { %>
                <div class="flex justify-between items-center bg-slate-50 dark:bg-slate-700 p-2.5 rounded border dark:border-slate-600 text-sm">
                    <span class="truncate max-w-xs text-slate-700 dark:text-gray-300">📄 <%= file.original_name %></span>
                  <div class="flex items-center gap-3 shrink-0">
                    <a href="<%= file.file_url %>" target="_blank" class="text-blue-600 hover:underline text-xs font-medium">Ansehen / Download</a>
                    
                    <!-- Lösch-Button für Dateien -->
                    <form action="/projects/files/delete" method="POST" onsubmit="return confirm('Datei wirklich löschen?');" class="inline">
                      <input type="hidden" name="file_id" value="<%= file.id %>">
                      <input type="hidden" name="project_id" value="<%= project.id %>">
                      <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 px-2 py-1 rounded text-xs font-medium transition">Löschen</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-xs text-slate-400 dark:text-slate-500 italic">Noch keine Zeichnungen oder Dokumente hochgeladen.</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- DIGITALES AUFMASS -->
      <!-- ========================================== -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 md:p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📐 Digitales Aufmaß (Baustelle)</h2>
        
        <!-- Eingabeformular -->
        <form action="/projects/<%= project.id %>/measurements/add" method="POST" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-3 items-end bg-slate-50 dark:bg-slate-700 p-4 rounded border dark:border-slate-600">
          <div class="md:col-span-3">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Bauteil / Element *</label>
            <input type="text" name="component_name" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. Pfosten links" required>
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Breite (mm)</label>
            <input type="text" name="width" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. 1200">
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Höhe / Länge (mm)</label>
            <input type="text" name="height" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. 900">
          </div>
          <div class="md:col-span-1">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Winkel (°)</label>
            <input type="text" name="angle" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. 45">
          </div>
          <div class="md:col-span-1">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Anzahl</label>
            <input type="number" name="quantity" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" value="1" min="1">
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Bemerkung</label>
            <input type="text" name="note" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. Dachschräge">
          </div>
          <div class="md:col-span-1">
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 rounded transition text-lg">+</button>
          </div>
        </form>

        <!-- Tabelle der bisherigen Aufmaße -->
        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 pt-2">Erfasste Maße:</h3>
        <% if (measurements && measurements.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm min-w-[600px]">
              <thead>
                <tr class="bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 border-b dark:border-slate-600">
                  <th class="p-2.5">Bauteil</th>
                  <th class="p-2.5">Breite</th>
                  <th class="p-2.5">Höhe / Länge</th>
                  <th class="p-2.5">Winkel</th>
                  <th class="p-2.5">Anzahl</th>
                  <th class="p-2.5">Notiz</th>
                  <th class="p-2.5 text-right">Aktion</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                <% measurements.forEach(m => { %>
                  <tr class="hover:bg-slate-50 dark:hover:bg-slate-700">
                    <td class="p-2.5 font-semibold text-slate-800 dark:text-gray-100"><%= m.component_name %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.width ? m.width + ' mm' : '-' %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.height ? m.height + ' mm' : '-' %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.angle ? m.angle + '°' : '-' %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.quantity %></td>
                    <td class="p-2.5 text-slate-600 dark:text-slate-300"><%= m.note || '-' %></td>
                    <td class="p-2.5 text-right">
                      <form action="/projects/measurements/delete" method="POST" onsubmit="return confirm('Eintrag wirklich löschen?');" class="inline">
                        <input type="hidden" name="measurement_id" value="<%= m.id %>">
                        <input type="hidden" name="project_id" value="<%= project.id %>">
                        <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 px-2 py-1 rounded text-xs font-medium transition">Löschen</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-400 dark:text-slate-500 italic">Noch keine Maße für dieses Projekt erfasst.</p>
        <% } %>
      </div>

      <!-- ========================================== -->
      <!-- NEU: BAUSTELLEN-AUFGABEN & MÄNGEL TICKER -->
      <!-- ========================================== -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 md:p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">🛠️ Baustellen-Aufgaben & Mängel</h2>
        
        <!-- Formular zum Hinzufügen einer neuen Aufgabe/Mängels -->
        <form action="/projects/<%= project.id %>/tasks/add" method="POST" enctype="multipart/form-data" class="space-y-3 bg-slate-50 dark:bg-slate-700 p-4 rounded border dark:border-slate-600">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Neue Aufgabe oder Mangel erfassen</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Titel / Stichpunkt *</label>
              <input type="text" name="title" required class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white" placeholder="z.B. Kratzer im Profil nachbessern">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Kategorie</label>
              <select name="category" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded px-3 py-2 bg-white">
                <option value="Restarbeit">Restarbeit</option>
                <option value="Mangel">Mangel / Reklamation</option>
                <option value="Bestellung">Nachbestellung</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Beschreibung / Details</label>
            <textarea name="description" rows="2" class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded p-2.5 bg-white" placeholder="Genaue Beschreibung oder Standort auf der Baustelle..."></textarea>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Foto-Nachweis (optional)</label>
            <input type="file" name="photo" accept="image/*" class="w-full text-xs text-slate-500 dark:text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100">
          </div>
          <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium px-4 py-2 rounded transition">Aufgabe hinzufügen</button>
        </form>

        <!-- Liste der Aufgaben & Mängel -->
        <div class="space-y-3 pt-2">
          <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300">Offene & Erledigte Punkte:</h3>
          <% if (typeof tasks !== 'undefined' && tasks && tasks.length > 0) { %>
            <div class="space-y-3">
              <% tasks.forEach(task => { %>
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-slate-50 dark:bg-slate-700 p-3 rounded border dark:border-slate-600 gap-3 text-sm">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2">
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold 
                        <%= task.category === 'Mangel' ? 'bg-red-100 text-red-800' : (task.category === 'Bestellung' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800') %>">
                        <%= task.category %>
                      </span>
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold 
                        <%= task.status === 'Erledigt' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' %>">
                        <%= task.status %>
                      </span>
                      <strong class="text-slate-800 dark:text-gray-100"><%= task.title %></strong>
                    </div>
                    <% if (task.description) { %>
                      <p class="text-xs text-slate-600 dark:text-slate-300"><%= task.description %></p>
                    <% } %>
                    <% if (task.photo_url) { %>
                      <div class="pt-1">
                        <a href="<%= task.photo_url %>" target="_blank" class="text-blue-600 hover:underline text-xs font-medium inline-flex items-center gap-1">
                          📷 Foto-Nachweis ansehen
                        </a>
                      </div>
                    <% } %>
                  </div>

                  <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
                    <!-- Status umschalten -->
                    <form action="/projects/tasks/status" method="POST" class="inline">
                      <input type="hidden" name="task_id" value="<%= task.id %>">
                      <input type="hidden" name="project_id" value="<%= project.id %>">
                      <% if (task.status === 'Erledigt') { %>
                        <input type="hidden" name="status" value="Offen">
                        <button type="submit" class="bg-amber-50 text-amber-700 hover:bg-amber-100 px-2.5 py-1 rounded text-xs font-medium transition">Als offen markieren</button>
                      <% } else { %>
                        <input type="hidden" name="status" value="Erledigt">
                        <button type="submit" class="bg-green-600 text-white hover:bg-green-700 px-2.5 py-1 rounded text-xs font-medium transition">Erledigen</button>
                      <% } %>
                    </form>

                    <!-- Löschen -->
                    <form action="/projects/tasks/delete" method="POST" onsubmit="return confirm('Aufgabe wirklich löschen?');" class="inline">
                      <input type="hidden" name="task_id" value="<%= task.id %>">
                      <input type="hidden" name="project_id" value="<%= project.id %>">
                      <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 px-2.5 py-1 rounded text-xs font-medium transition">Löschen</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-xs text-slate-400 dark:text-slate-500 italic">Keine offenen Aufgaben oder Mängel für dieses Projekt erfasst.</p>
          <% } %>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- BAUSTELLEN-NOTIZBUCH                       -->
      <!-- ========================================== -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 md:p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📝 Baustellen-Notizbuch</h2>

        <!-- ── Text-Notiz ──────────────────────────────── -->
        <form action="/projects/<%= project.id %>/notes/add" method="POST" class="space-y-3 bg-slate-50 dark:bg-slate-700/50 p-4 rounded border dark:border-slate-600">
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Neue Notiz / Absprache / Baustellen-Info hinzufügen</label>
          <textarea name="note_text" rows="2" required
            class="w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded p-2.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
            placeholder="z.B. Kunde wünscht nachträglich eine Änderung der RAL-Farbe..."></textarea>
          <button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white text-xs font-medium px-4 py-2 rounded transition">Notiz speichern</button>
        </form>

        <!-- ── Notizliste ──────────────────────────────── -->
        <div class="space-y-3 pt-2">
          <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300">Vorherige Notizen:</h3>
          <% if (notes && notes.length > 0) { %>
            <div class="space-y-2">
              <% notes.forEach(note => { %>
                <div class="flex justify-between items-start bg-slate-50 dark:bg-slate-700 p-3 rounded border dark:border-slate-600 text-sm">
                  <div class="space-y-1.5 pr-4 flex-1 min-w-0">
                    <p class="text-slate-800 dark:text-gray-200 whitespace-pre-wrap"><%= note.note_text %></p>
                    <span class="text-[10px] text-slate-400 dark:text-slate-500 block">
                      <%= new Date(note.created_at).toLocaleString('de-DE') %>
                    </span>
                  </div>
                  <form action="/projects/notes/delete" method="POST" onsubmit="return confirm('Notiz wirklich löschen?');" class="shrink-0">
                    <input type="hidden" name="note_id" value="<%= note.id %>">
                    <input type="hidden" name="project_id" value="<%= project.id %>">
                    <button type="submit" class="bg-red-50 dark:bg-red-900/30 text-red-600 hover:bg-red-100 px-2 py-1 rounded text-xs font-medium transition">Löschen</button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-xs text-slate-400 dark:text-slate-500 italic">Noch keine Notizen für dieses Projekt hinterlegt.</p>
          <% } %>
        </div>
      </div>

      <!-- Baustellen-Abschlussfotos Sektion -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 md:p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 border-b dark:border-slate-700 pb-2">📸 Baustellen-Abschlussfotos</h2>
        
        <!-- Upload-Formular für Fotos -->
        <form action="/projects/<%= project.id %>/photos/upload" method="POST" enctype="multipart/form-data" class="space-y-3 bg-slate-50 dark:bg-slate-700 p-4 rounded border dark:border-slate-600">
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Fertiges Baustellenfoto hochladen (JPG, PNG)</label>
          <input type="file" name="photo" accept="image/*" required class="w-full text-xs text-slate-500 dark:text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100">
          <button type="submit" class="bg-green-600 hover:bg-green-700 text-white text-xs font-medium px-3 py-1.5 rounded transition">Foto hochladen</button>
        </form>

        <!-- Galerie der hochgeladenen Fotos mit X-Löschbutton -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          <% if (photos && photos.length > 0) { %>
            <% photos.forEach(photo => { %>
              <div class="relative bg-slate-50 dark:bg-slate-700 rounded border dark:border-slate-600 p-2 flex flex-col items-center group">
                
                <!-- Löschen-Button mit X -->
                <form action="/projects/photos/delete" method="POST" onsubmit="return confirm('Foto wirklich löschen?');" class="absolute top-3 right-3 z-10">
                  <input type="hidden" name="photo_id" value="<%= photo.id %>">
                  <input type="hidden" name="project_id" value="<%= project.id %>">
                  <button type="submit" class="bg-red-600 hover:bg-red-700 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold shadow transition opacity-80 group-hover:opacity-100" title="Foto löschen">
                    &times;
                  </button>
                </form>

                <a href="<%= photo.file_url %>" target="_blank" class="w-full">
                  <img src="<%= photo.file_url %>" alt="Baustellenfoto" class="w-full h-32 object-cover rounded hover:opacity-90 transition">
                </a>
                <span class="text-xs text-slate-500 dark:text-slate-400 mt-2 truncate w-full text-center"><%= photo.original_name %></span>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-xs text-slate-400 dark:text-slate-500 italic col-span-full">Noch keine Abschlussfotos für dieses Projekt hochgeladen.</p>
          <% } %>
        </div>
      </div>

      <!-- Verknüpfte Termine mit Wetter-Frühwarnung -->
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 md:p-6">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100 mb-4">📅 Verknüpfte Termine – Wetter-Frühwarnung</h2>
        <% if (appointments && appointments.length > 0) { %>
          <ul class="divide-y divide-slate-200 dark:divide-slate-700">
            <% appointments.forEach(app => { %>
              <%
                const w = app.weather;
                let wBg = '', wBorder = '', wIcon = '', wLabel = '', wText = '';
                if (w && w.warningLevel === 'danger') {
                  wBg = 'bg-red-50'; wBorder = 'border-l-4 border-red-500';
                  wIcon = '🔴'; wLabel = 'GEFAHR – Montage prüfen!';
                  wText = `text-red-700`;
                } else if (w && w.warningLevel === 'warn') {
                  wBg = 'bg-yellow-50'; wBorder = 'border-l-4 border-yellow-400';
                  wIcon = '🟡'; wLabel = 'Wetterwarnung';
                  wText = `text-yellow-700`;
                } else if (w) {
                  wBg = 'bg-emerald-50'; wBorder = 'border-l-4 border-emerald-400';
                  wIcon = '🟢'; wLabel = 'Kein Wetterrisiko';
                  wText = `text-emerald-700`;
                } else {
                  wBg = 'bg-slate-50'; wBorder = 'border-l-4 border-slate-200';
                  wIcon = '–'; wLabel = 'Keine Vorhersage verfügbar';
                  wText = 'text-slate-400';
                }
              %>
              <li class="py-3 pl-3 <%= wBg %> <%= wBorder %> rounded mb-2 text-sm">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
                  <div class="flex-1">
                    <strong class="text-slate-800 dark:text-gray-100"><%= app.title %></strong>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5"><%= new Date(app.start_date).toLocaleString('de-DE') %></p>
                    <% if (app.description) { %><p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5"><%= app.description %></p><% } %>
                  </div>
                  <!-- Wetter-Box -->
                  <div class="text-xs rounded-lg px-3 py-2 min-w-[170px] <%= w ? (w.warningLevel === 'danger' ? 'bg-red-100' : w.warningLevel === 'warn' ? 'bg-yellow-100' : 'bg-emerald-100') : 'bg-slate-100' %>">
                    <p class="font-bold <%= wText %>"><%= wIcon %> <%= wLabel %></p>
                    <% if (w) { %>
                      <p class="text-slate-600 dark:text-slate-300 mt-1"><%= w.weatherText %></p>
                      <p class="text-slate-500 dark:text-slate-400">💨 Wind: <strong><%= w.windspeed %> km/h</strong></p>
                      <p class="text-slate-500 dark:text-slate-400">🌬 Böen: <strong><%= w.windgusts %> km/h</strong></p>
                      <p class="text-slate-500 dark:text-slate-400">🌧 Regen: <strong><%= w.precipitation %> mm</strong></p>
                    <% } else { %>
                      <p class="text-slate-400 dark:text-slate-500 mt-1">Termin liegt außerhalb des 16-Tage-Fensters.</p>
                    <% } %>
                  </div>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-sm text-slate-400 dark:text-slate-500">Keine spezifischen Termine für diesen Kunden im Kalender gefunden.</p>
        <% } %>
      </div>
</div>

</main>

<!-- ================================================ -->
<!-- PROJEKT BEARBEITEN MODAL (nur Admin)              -->
<!-- ================================================ -->
<% if (currentUser.role === 'ADMIN') { %>
<div id="editProjectModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-lg w-full p-4 md:p-6 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 border-b dark:border-slate-700 pb-2">
      <h3 class="text-lg font-bold text-slate-800 dark:text-gray-100">✏️ Auftrag bearbeiten</h3>
      <button onclick="document.getElementById('editProjectModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl font-bold">&times;</button>
    </div>
    <form action="/projects/<%= project.id %>/edit" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Bezeichnung / Baustelle *</label>
        <input type="text" name="title" required value="<%= project.title %>" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Beschreibung / Details</label>
        <textarea name="description" rows="2" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500"><%= project.description || '' %></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Auftragssumme (€)</label>
          <input type="text" name="total_price" value="<%= (Number(project.total_price) || 0).toFixed(2) %>" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Status</label>
          <select name="status" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white">
            <% ['In Planung','Avor / Vorbereitung','In Produktion','Oberfläche','Montagebereit','Montage läuft','Abgeschlossen'].forEach(s => { %>
              <option value="<%= s %>" <%= project.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t dark:border-slate-700">
        <button type="button" onclick="document.getElementById('editProjectModal').classList.add('hidden')" class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Änderungen speichern</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<script>
// ================================================
// GEO-FENCING: ADRESSSUCHE & STANDORT-HELFER
// ================================================

// Freitextsuche über OpenStreetMap Nominatim (kein API-Key nötig)
async function geocodeAddress() {
  const input = document.getElementById('geo-address-input');
  const status = document.getElementById('geo-status');
  const address = input ? input.value.trim() : '';

  if (!address) {
    showGeoStatus('⚠️ Bitte zuerst eine Adresse eingeben.', 'text-amber-600');
    return;
  }

  showGeoStatus('⏳ Suche läuft…', 'text-slate-400');

  try {
    const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(address)}&format=json&limit=1&addressdetails=1`;
    const res = await fetch(url, { headers: { 'Accept-Language': 'de' } });
    const data = await res.json();

    if (!data || data.length === 0) {
      showGeoStatus('❌ Adresse nicht gefunden. Bitte genauer eingeben.', 'text-red-600');
      return;
    }

    const result = data[0];
    const lat = parseFloat(result.lat).toFixed(7);
    const lng = parseFloat(result.lon).toFixed(7);
    const displayName = result.display_name;

    document.getElementById('geo-lat').value = lat;
    document.getElementById('geo-lng').value = lng;

    showGeoStatus(`✅ Gefunden: ${displayName}`, 'text-green-700');
  } catch (e) {
    showGeoStatus('❌ Netzwerkfehler beim Suchen. Bitte Internetverbindung prüfen.', 'text-red-600');
  }
}

// Kundenadresse in Suchfeld eintragen und sofort geocodieren
function useCustomerAddress(address) {
  const input = document.getElementById('geo-address-input');
  if (input) {
    input.value = address;
    geocodeAddress();
  }
}

// Hilfsfunktion: Status-Text anzeigen
function showGeoStatus(msg, colorClass) {
  const el = document.getElementById('geo-status');
  if (!el) return;
  el.textContent = msg;
  el.className = `text-[10px] mt-1 ${colorClass}`;
  el.classList.remove('hidden');
}

// GPS-Standort des Geräts nutzen
function useMyLocationForProject() {
  if (!navigator.geolocation) {
    alert('Geolocation wird von diesem Browser nicht unterstützt.');
    return;
  }
  navigator.geolocation.getCurrentPosition(
    (pos) => {
      const lat = pos.coords.latitude.toFixed(7);
      const lng = pos.coords.longitude.toFixed(7);
      document.getElementById('geo-lat').value = lat;
      document.getElementById('geo-lng').value = lng;
      showGeoStatus(`📍 GPS-Standort übernommen: ${lat}, ${lng}`, 'text-green-700');
    },
    () => { showGeoStatus('⚠️ GPS-Standort konnte nicht ermittelt werden.', 'text-amber-600'); },
    { timeout: 10000, enableHighAccuracy: true }
  );
}

// Enter-Taste im Adressfeld auslösen
document.addEventListener('DOMContentLoaded', () => {
  const inp = document.getElementById('geo-address-input');
  if (inp) inp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); geocodeAddress(); } });
});

</script>

</body>
</html>
