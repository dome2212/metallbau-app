<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Auftrag: <%= project.title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 flex h-screen overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto">
    <header class="bg-white shadow px-6 py-4 flex justify-between items-center">
      <div>
        <a href="/projects" class="text-xs text-blue-600 hover:underline">← Zurück zur Übersicht</a>
        <h1 class="text-2xl font-bold text-slate-800"><%= project.title %></h1>
      </div>
      <span class="px-3 py-1 rounded text-sm font-semibold bg-blue-100 text-blue-800"><%= project.status %></span>
    </header>

    <div class="p-6 max-w-7xl mx-auto w-full space-y-6">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Kundendaten & Details -->
        <div class="bg-white rounded-lg shadow p-6 space-y-4">
          <h2 class="text-lg font-semibold text-slate-800 border-b pb-2">📋 Projektdetails</h2>
          <div>
            <span class="text-xs text-slate-400 block">Kunde / Baustelle</span>
            <strong class="text-slate-700"><%= project.company_name || project.contact_person %></strong>
            <p class="text-sm text-slate-600"><%= project.street %>, <%= project.zip %> <%= project.city %></p>
          </div>
          
          <!-- Auftragssumme nur für den Chef (ADMIN) sichtbar -->
          <% if (currentUser.role === 'ADMIN') { %>
            <div>
              <span class="text-xs text-slate-400 block">Auftragssumme</span>
              <span class="text-xl font-bold text-slate-800"><%= project.total_price.toLocaleString('de-DE', {minimumFractionDigits: 2}) %> €</span>
            </div>
          <% } %>

          <div>
            <span class="text-xs text-slate-400 block">Beschreibung</span>
            <p class="text-sm text-slate-600"><%= project.description || 'Keine Beschreibung hinterlegt.' %></p>
          </div>
        </div>

        <!-- Technische Zeichnungen & Dateien -->
        <div class="bg-white rounded-lg shadow p-6 space-y-4">
          <h2 class="text-lg font-semibold text-slate-800 border-b pb-2">📐 Technische Zeichnungen & Pläne</h2>
          
          <!-- Upload-Formular -->
          <form action="/projects/<%= project.id %>/upload" method="POST" enctype="multipart/form-data" class="space-y-3 bg-slate-50 p-4 rounded border">
            <label class="block text-xs font-medium text-slate-700">Zeichnung / Skizze / Foto hochladen (PDF, Bild)</label>
            <input type="file" name="file" required class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded transition">Datei hochladen</button>
          </form>

          <!-- Liste der hochgeladenen Dateien -->
          <div class="space-y-2">
            <% if (files && files.length > 0) { %>
              <% files.forEach(file => { %>
                <div class="flex justify-between items-center bg-slate-50 p-2.5 rounded border text-sm">
                  <span class="truncate max-w-xs text-slate-700">📄 <%= file.original_name %></span>
                  <a href="<%= file.file_url %>" target="_blank" class="text-blue-600 hover:underline text-xs font-medium">Ansehen / Download</a>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-xs text-slate-400 italic">Noch keine Zeichnungen oder Dokumente hochgeladen.</p>
            <% } %>
          </div>
        </div>
      </div>

<!-- ========================================== -->
<!-- DIGITALES AUFMASS -->
<!-- ========================================== -->
<div class="card mt-4">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0">📐 Digitales Aufmaß (Baustelle)</h5>
  </div>
  <div class="card-body">
    <!-- Eingabeformular -->
    <form action="/projects/<%= project.id %>/measurements/add" method="POST" class="row g-3 mb-4">
      <div class="col-md-3">
        <label class="form-label">Bauteil / Element *</label>
        <input type="text" name="component_name" class="form-control" placeholder="z.B. Pfosten links" required>
      </div>
      <div class="col-md-2">
        <label class="form-label">Breite (mm)</label>
        <input type="text" name="width" class="form-control" placeholder="z.B. 1200">
      </div>
      <div class="col-md-2">
        <label class="form-label">Höhe / Länge (mm)</label>
        <input type="text" name="height" class="form-control" placeholder="z.B. 900">
      </div>
      <div class="col-md-1">
        <label class="form-label">Anzahl</label>
        <input type="number" name="quantity" class="form-control" value="1" min="1">
      </div>
      <div class="col-md-3">
        <label class="form-label">Bemerkung / Notiz</label>
        <input type="text" name="note" class="form-control" placeholder="z.B. Schräges Dach">
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-success w-100">+</button>
      </div>
    </form>

    <hr>

    <!-- Tabelle der bisherigen Aufmaße -->
    <h6 class="text-muted mb-3">Erfasste Maße:</h6>
    <% if (measurements && measurements.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
          <thead>
            <tr>
              <th>Bauteil</th>
              <th>Breite</th>
              <th>Höhe / Länge</th>
              <th>Anzahl</th>
              <th>Notiz</th>
              <th style="width: 80px;">Aktion</th>
            </tr>
          </thead>
          <tbody>
            <% measurements.forEach(m => { %>
              <tr>
                <td><strong><%= m.component_name %></strong></td>
                <td><%= m.width ? m.width + ' mm' : '-' %></td>
                <td><%= m.height ? m.height + ' mm' : '-' %></td>
                <td><%= m.quantity %></td>
                <td><%= m.note || '-' %></td>
                <td>
                  <form action="/projects/measurements/delete" method="POST" onsubmit="return confirm('Eintrag wirklich löschen?');" style="margin:0;">
                    <input type="hidden" name="measurement_id" value="<%= m.id %>">
                    <input type="hidden" name="project_id" value="<%= project.id %>">
                    <button type="submit" class="btn btn-danger btn-sm">Löschen</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-muted mb-0">Noch keine Maße für dieses Projekt erfasst.</p>
    <% } %>
  </div>
</div>

      <!-- NEU: Baustellen-Abschlussfotos Sektion -->
      <div class="bg-white rounded-lg shadow p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-800 border-b pb-2">📸 Baustellen-Abschlussfotos</h2>
        
        <!-- Upload-Formular für Fotos -->
        <form action="/projects/<%= project.id %>/photos/upload" method="POST" enctype="multipart/form-data" class="space-y-3 bg-slate-50 p-4 rounded border">
          <label class="block text-xs font-medium text-slate-700">Fertiges Baustellenfoto hochladen (JPG, PNG)</label>
          <input type="file" name="photo" accept="image/*" required class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100">
          <button type="submit" class="bg-green-600 hover:bg-green-700 text-white text-xs font-medium px-3 py-1.5 rounded transition">Foto hochladen</button>
        </form>

        <!-- Galerie der hochgeladenen Fotos -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          <% if (photos && photos.length > 0) { %>
            <% photos.forEach(photo => { %>
              <div class="relative bg-slate-50 rounded border p-2 flex flex-col items-center">
                <a href="<%= photo.file_url %>" target="_blank" class="w-full">
                  <img src="<%= photo.file_url %>" alt="Baustellenfoto" class="w-full h-32 object-cover rounded hover:opacity-90 transition">
                </a>
                <span class="text-xs text-slate-500 mt-2 truncate w-full text-center"><%= photo.original_name %></span>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-xs text-slate-400 italic col-span-full">Noch keine Abschlussfotos für dieses Projekt hochgeladen.</p>
          <% } %>
        </div>
      </div>

      <!-- Verknüpfte Termine -->
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">📅 Verknüpfte Termine (Aufmaß, Montage etc.)</h2>
        <% if (appointments && appointments.length > 0) { %>
          <ul class="divide-y divide-slate-200">
            <% appointments.forEach(app => { %>
              <li class="py-3 flex justify-between items-center text-sm">
                <div>
                  <strong class="text-slate-800"><%= app.title %></strong>
                  <p class="text-xs text-slate-500"><%= new Date(app.start_date).toLocaleString('de-DE') %></p>
                </div>
                <span class="text-xs text-slate-600"><%= app.description || '' %></span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-sm text-slate-400">Keine spezifischen Termine für diesen Kunden im Kalender gefunden.</p>
        <% } %>
      </div>

    </div>
  </main>
</body>
</html>
