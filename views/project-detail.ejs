<%- include('partials/header') %>
<%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto page-bg dark:bg-slate-900 min-h-screen pt-16">
    <header class="card border-0 rounded-none md:rounded-none shadow-sm px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
      <div>
        <a href="/projects" class="text-xs text-blue-600 hover:underline">← Zurück zur Übersicht</a>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100"><%= project.title %></h1>
      </div>
      <div class="flex items-center gap-2">
        <%
          const headerStatusColors = {
            'In Planung':         'bg-slate-100 text-slate-700',
            'Avor / Vorbereitung':'bg-blue-100 text-blue-800',
            'In Produktion':      'bg-amber-100 text-amber-800',
            'Oberfläche':         'bg-purple-100 text-purple-800',
            'Montagebereit':      'bg-emerald-100 text-emerald-800',
            'Montage läuft':      'bg-orange-100 text-orange-800',
            'Abgeschlossen':      'bg-green-100 text-green-800'
          };
          const hsc = headerStatusColors[project.status] || 'bg-blue-100 text-blue-800';
        %>
        <span class="px-3 py-1 rounded text-sm font-semibold <%= hsc %>"><%= project.status %></span>
        <button id="qrOpenBtn" onclick="document.getElementById('qrModal').classList.remove('hidden')"
          class="btn btn-ghost text-xs">
          📱 QR-Code
        </button>
        <% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF') { %>
          <button onclick="document.getElementById('editProjectModal').classList.remove('hidden')"
            class="btn btn-ghost text-xs" style="color:#b45309;border-color:#fde68a;background:#fffbeb">
            ✏️ Bearbeiten
          </button>
        <% } %>
      </div>
    </header>



    <div class="p-4 md:p-6 max-w-7xl mx-auto w-full space-y-8">

      <!-- ========== SCHNELL-NAVIGATION (Tabs) ========== -->
      <nav class="sticky top-16 md:top-2 z-20 -mx-1 px-1">
        <div class="bg-white/95 dark:bg-slate-800/95 backdrop-blur border dark:border-slate-700 shadow-sm rounded-xl p-2 overflow-x-auto">
          <div class="flex gap-1.5 min-w-max">
            <button type="button" class="nav-chip" data-target="sec-uebersicht"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>Übersicht</button>
            <button type="button" class="nav-chip" data-target="sec-aufmass"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17L17 3M12 3h5v5M7 21H3v-4"/></svg>Aufmaß</button>
            <button type="button" class="nav-chip" data-target="sec-aufgaben"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>Aufgaben</button>
            <button type="button" class="nav-chip" data-target="sec-notizen"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>Notizen</button>
            <button type="button" class="nav-chip" data-target="sec-fotos"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="15" rx="2"/><circle cx="12" cy="12.5" r="3.5"/><path d="M8 5l1.5-2h5L16 5"/></svg>Fotos</button>
            <button type="button" class="nav-chip" data-target="sec-termine"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 3v3M16 3v3"/></svg>Termine</button>
            <button type="button" class="nav-chip" data-target="sec-material"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8M12 13v8"/></svg>Material</button>
            <button type="button" class="nav-chip" data-target="sec-stunden"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Stunden</button>
            <button type="button" class="nav-chip" data-target="sec-abnahme"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>Abnahme</button>
            <button type="button" class="nav-chip" data-target="sec-status"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>Status</button>
            <button type="button" class="nav-chip" data-target="sec-chat"><svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>Chat</button>
          </div>
        </div>
      </nav>
      <style>
        .nav-chip{padding:0.375rem 0.75rem;border-radius:0.5rem;font-size:0.75rem;font-weight:600;background:#f1f5f9;color:#334155;transition:background .15s,color .15s;display:inline-block;text-decoration:none;border:1px solid transparent;cursor:pointer}
        .nav-chip:hover{background:#dbeafe;color:#1d4ed8}
        .nav-chip.active{background:#2563eb;color:#fff}
        .dark .nav-chip{background:#334155;color:#e2e8f0}
        .dark .nav-chip:hover{background:#475569;color:#fff}
        .dark .nav-chip.active{background:#2563eb;color:#fff}
        .sec-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:0.15rem 0.5rem;border-radius:0.35rem;white-space:nowrap}
        .card-clean{background:#fff;border-radius:0.75rem;box-shadow:0 1px 2px rgb(0 0 0/0.05);border:1px solid #f1f5f9;padding:1rem}
        @media(min-width:768px){.card-clean{padding:1.5rem}}
        .dark .card-clean{background:#1e293b;border-color:#334155}
        .sec-toggle{cursor:pointer;user-select:none;display:flex;align-items:center;gap:0.5rem;width:100%}
        .sec-toggle .chev{transition:transform .2s;font-size:12px;color:#64748b}
        .sec-collapsed .sec-toggle .chev{transform:rotate(-90deg)}
        .sec-collapsed .sec-body{display:none}
        .sec-collapsed .card-clean{padding-top:0.75rem;padding-bottom:0.75rem}
        /* Tab-Modus: nicht-aktive Abschnitte per JS ausgeblendet (Klasse sec-tab-hidden) */
        .sec-tab-hidden{display:none !important}
      </style>

      <!-- ========== 1 ÜBERSICHT ========== -->
      <%- include('partials/project/sec-uebersicht') %>
      <%- include('partials/project/sec-aufmass') %>
      <%- include('partials/project/sec-aufgaben') %>
      <%- include('partials/project/sec-notizen') %>
      <%- include('partials/project/sec-fotos') %>
      <%- include('partials/project/sec-termine') %>
      <%- include('partials/project/sec-status') %>
      <%- include('partials/project/sec-material') %>
      <%- include('partials/project/sec-stunden') %>
      <%- include('partials/project/sec-chat') %>
      <%- include('partials/project/sec-abnahme') %>
</main>

