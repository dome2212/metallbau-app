<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Werkstatt Kanban-Board - Metallbau-Gehrmann</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2563eb">
</head>
<body class="bg-gray-100 text-gray-950 flex flex-col md:flex-row min-h-screen">

  <!-- Sidebar einbinden -->
  <%- include('partials/sidebar') %>

  <!-- Hauptinhalt -->
  <main class="flex-1 p-3 md:p-8 max-w-full overflow-x-hidden">
    
    <!-- Kopfbereich -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 md:mb-6 gap-3 border-b border-gray-200 pb-3">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-gray-800">Werkstatt Kanban-Board</h1>
        <p class="text-xs md:text-sm text-gray-500">Übersicht der Fertigungsphasen und Baustellen</p>
      </div>
      <div>
        <a href="/projects" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-3 py-1.5 md:px-4 md:py-2 rounded text-xs md:text-sm font-medium transition inline-block">
          📄 Tabellenansicht
        </a>
      </div>
    </div>

    <!-- Kanban Spalten Container: Als 3er-Raster (Grid) untereinander -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-6 items-start">
      <% 
        const statuses = [
          { key: 'In Planung', label: 'In Planung', color: 'border-slate-400 bg-slate-50' },
          { key: 'Avor / Vorbereitung', label: 'Avor / Vorbereitung', color: 'border-blue-400 bg-blue-50/30' },
          { key: 'In Produktion', label: 'In Produktion (Schlosserei)', color: 'border-amber-400 bg-amber-50/30' },
          { key: 'Oberfläche', label: 'Oberfläche (Verzinken/Lack)', color: 'border-purple-400 bg-purple-50/30' },
          { key: 'Montagebereit', label: 'Montagebereit', color: 'border-emerald-400 bg-emerald-50/30' },
          { key: 'Abgeschlossen', label: 'Abgeschlossen', color: 'border-gray-400 bg-gray-50' }
        ];
      %>

      <% statuses.forEach(col => { %>
        <div class="bg-gray-200/80 rounded-xl w-full p-3 flex flex-col shadow-sm border-t-4 <%= col.color %>">
          
          <!-- Spalten-Überschrift -->
          <div class="flex justify-between items-center mb-3 px-1">
            <h3 class="font-bold text-gray-700 text-sm"><%= col.label %></h3>
            <span class="bg-gray-300 text-gray-700 text-xs px-2 py-0.5 rounded-full font-semibold">
              <%= columns[col.key] ? columns[col.key].length : 0 %>
            </span>
          </div>

          <!-- Karten-Container -->
          <div class="space-y-3 flex-1 pr-1">
            <% if (columns[col.key] && columns[col.key].length > 0) { %>
              <% columns[col.key].forEach(project => { %>
                <div class="bg-white rounded-lg p-3 md:p-4 shadow-sm border border-gray-200 hover:shadow-md transition">
                  
                  <h4 class="font-bold text-blue-600 text-sm mb-1">
                    <a href="/projects/<%= project.id %>" class="hover:underline"><%= project.title %></a>
                  </h4>
                  
                  <p class="text-xs text-gray-600 mb-1">
                    <strong class="text-gray-700">Kunde:</strong> <%= project.company_name || project.contact_person || 'Unbekannt' %>
                  </p>
                  
                  <p class="text-xs text-gray-600 mb-3">
                    <strong class="text-gray-700">Wert:</strong> <%= Number(project.total_price || 0).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' }) %>
                  </p>
                  
                  <!-- Status-Wechsel direkt auf der Karte -->
                  <div class="border-t border-gray-100 pt-2 mt-2">
                    <form action="/projects/update-status" method="POST">
                      <input type="hidden" name="id" value="<%= project.id %>">
                      <select name="status" onchange="this.form.submit()" class="w-full text-xs bg-gray-50 border border-gray-300 rounded p-2 text-gray-700 focus:outline-none focus:border-blue-500 font-medium">
                        <% statuses.forEach(s => { %>
                          <option value="<%= s.key %>" <%= project.status === s.key ? 'selected' : '' %>><%= s.label %></option>
                        <% }) %>
                      </select>
                    </form>
                  </div>

                </div>
              <% }) %>
            <% } else { %>
              <div class="text-center py-6 text-gray-400 text-xs italic bg-white/50 rounded-lg border border-dashed border-gray-300">
                Keine Aufträge
              </div>
            <% } %>
          </div>

        </div>
      <% }) %>
    </div>

  </main>

</body>
</html>
