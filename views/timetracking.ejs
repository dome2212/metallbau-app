<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<!-- Geo-Fencing Projekt-Daten als JSON für clientseitiges JS -->
<script>
const GEO_PROJECTS = <%- JSON.stringify(typeof geoProjects !== 'undefined' ? geoProjects : []) %>;
const IS_STAMPED_IN = <%= isStampedIn ? 'true' : 'false' %>;
const ACTIVE_PROJECT_ID = <%- JSON.stringify(typeof activeProjectId !== 'undefined' ? activeProjectId : null) %>;
</script>

<main class="flex-1 flex flex-col overflow-y-auto md:ml-72 page-bg min-h-screen pt-16 md:pt-6">

  <div class="px-4 md:px-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-2">
    <div class="flex items-center gap-3">
      <button onclick="history.back()" class="btn btn-ghost p-2 rounded-full" title="Zurück">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100">Zeiterfassung &amp; Stempeluhr</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400" id="live-clock">Aktuelle Uhrzeit: --:--:--</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xs text-slate-400">Heute erfasst</span>
      <span class="text-xl font-bold text-slate-700 dark:text-slate-200"><%= todayTotalHours %> Std.</span>
    </div>
  </div>

  <div class="px-4 md:px-6 max-w-5xl mx-auto w-full space-y-4 pb-8">

    <% const _ss = typeof stampSettings !== 'undefined' ? stampSettings : { allowProject:true, allowNote:true, allowSwitch:true, geofence:true }; %>

    <!-- GEO-FENCING BANNER -->
    <div id="geofence-banner" class="hidden card border-2 border-indigo-400 bg-indigo-50 dark:bg-indigo-900/30 p-4">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <div class="space-y-1">
          <p class="text-sm font-bold text-indigo-800 dark:text-indigo-300">📍 Du befindest dich auf einer Baustelle!</p>
          <p class="text-xs text-indigo-700 dark:text-indigo-400" id="geofence-project-name">Projekt wird erkannt…</p>
          <p class="text-xs text-indigo-500 dark:text-indigo-500" id="geofence-distance"></p>
        </div>
        <% if (!isStampedIn) { %>
        <button id="geofence-stamp-btn" onclick="stampInFromGeofence()"
          class="btn btn-primary shrink-0 flex items-center gap-2">
          🟢 Für dieses Projekt einstempeln
        </button>
        <% } else { %>
        <span class="shrink-0 badge" style="background:var(--success-bg,#dcfce7);color:#166534;">✅ Bereits eingestempelt</span>
        <% } %>
      </div>
    </div>

    <!-- STEMPEL-KARTE -->
    <div class="card border-t-4 <%= isStampedIn ? 'border-green-500' : 'border-slate-300 dark:border-slate-600' %> p-4 md:p-6">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-5">
        <div>
          <h2 class="text-lg font-semibold text-slate-800 dark:text-gray-100">Stempel-Terminal</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Status:
            <% if (isStampedIn) { %>
            <span class="badge" style="background:#dcfce7;color:#166534;">
              ✅ Eingestempelt seit <%= lastStampTime %> Uhr<% if (typeof activeProjectTitle !== 'undefined' && activeProjectTitle) { %> · 🏗️ <%= activeProjectTitle %><% } %>
            </span>
            <% } else { %>
            <span class="badge">Ausgestempelt</span>
            <% } %>
          </p>
        </div>
      </div>

      <form action="/timetracking/stamp" method="POST" id="stamp-form" class="space-y-4">
        <input type="hidden" name="latitude" id="latitude">
        <input type="hidden" name="longitude" id="longitude">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% if (_ss.allowProject) { %>
          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Baustelle / Projekt</label>
            <select name="project_id" id="project-select" class="input">
              <option value="">🏭 Allgemein / Werkstatt</option>
              <% if (typeof projects !== 'undefined') { %>
              <% projects.forEach(proj => { %>
              <option value="<%= proj.id %>" data-customer-id="<%= proj.customer_id || '' %>"
                <%= (typeof activeProjectId !== 'undefined' && activeProjectId && String(activeProjectId) === String(proj.id)) ? 'selected' : '' %>>
                <%= proj.site_lat ? '📍 ' : '🔧 ' %><%= proj.title %><%= proj.company_name || proj.contact_person ? ' – ' + (proj.company_name || proj.contact_person) : '' %>
              </option>
              <% }) %>
              <% } %>
            </select>
          </div>
          <% } else { %>
          <input type="hidden" name="project_id" value="">
          <% } %>
          <% if (_ss.allowNote) { %>
          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Tätigkeit / Notiz (optional)</label>
            <input type="text" name="note" id="note-input" placeholder="z.B. Stahlgeländer Montage" class="input">
          </div>
          <% } %>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <% if (!isStampedIn) { %>
          <button type="submit" name="type" value="IN"
            class="btn flex-1 text-center font-semibold px-6 py-3"
            style="background:#16a34a;color:#fff;">
            🟢 Einstempeln (Arbeit beginnen)
          </button>
          <% } else { %>
          <button type="submit" name="type" value="OUT"
            class="btn flex-1 text-center font-semibold px-6 py-3"
            style="background:#dc2626;color:#fff;">
            🔴 Ausstempeln (Feierabend / Pause)
          </button>
          <% if (_ss.allowSwitch && _ss.allowProject) { %>
          <button type="button" onclick="showSwitchPanel()"
            class="btn flex-1 text-center font-semibold px-6 py-3"
            style="background:#f59e0b;color:#fff;">
            🔄 Baustelle wechseln
          </button>
          <% } %>
          <% } %>
        </div>
        <% if (!isStampedIn) { %>
        <p id="gps-status" class="text-xs text-slate-400 italic">📡 GPS-Standort wird ermittelt… (nur für Einstempeln erforderlich)</p>
        <% } else { %>
        <p id="gps-status" class="text-xs text-slate-400 italic hidden"></p>
        <% } %>
      </form>

      <!-- Baustellen-Wechsel-Panel -->
      <div id="switch-panel" class="hidden mt-5 border-t border-slate-200 dark:border-slate-600 pt-5 space-y-4">
        <p class="text-sm font-semibold text-amber-700 dark:text-amber-400">🔄 Baustelle wechseln – wähle die neue Baustelle und bestätige:</p>
        <form action="/timetracking/stamp" method="POST" id="switch-form" class="space-y-3">
          <input type="hidden" name="latitude" id="switch-latitude">
          <input type="hidden" name="longitude" id="switch-longitude">
          <input type="hidden" name="switch_out_first" value="1">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Neue Baustelle / Projekt</label>
              <select name="project_id" id="switch-project-select" class="input">
                <option value="">🏭 Allgemein / Werkstatt</option>
                <% if (typeof projects !== 'undefined') { %>
                <% projects.forEach(proj => { %>
                <option value="<%= proj.id %>">
                  <%= proj.site_lat ? '📍 ' : '🔧 ' %><%= proj.title %><%= proj.company_name || proj.contact_person ? ' – ' + (proj.company_name || proj.contact_person) : '' %>
                </option>
                <% }) %>
                <% } %>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Notiz (optional)</label>
              <input type="text" name="note" placeholder="z.B. Schweißarbeiten" class="input">
            </div>
          </div>
          <div class="flex gap-3">
            <button type="submit" name="type" value="SWITCH"
              class="btn flex-1 font-semibold"
              style="background:#f59e0b;color:#fff;">
              ✅ Wechsel bestätigen
            </button>
            <button type="button" onclick="hideSwitchPanel()" class="btn btn-ghost font-semibold">
              Abbrechen
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- HEUTIGE HISTORIE -->
    <div class="card p-4 md:p-6">
      <h3 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4">Heutige Stempel-Einträge</h3>
      <% if (todayLogs && todayLogs.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600 dark:text-slate-300 min-w-[500px]">
          <thead class="bg-slate-50 dark:bg-slate-700/50 text-slate-700 dark:text-slate-300 uppercase text-xs">
            <tr>
              <th class="p-3">Typ</th>
              <th class="p-3">Uhrzeit</th>
              <th class="p-3">Projekt / Kunde</th>
              <th class="p-3">Notiz</th>
              <th class="p-3">GPS</th>
              <% if (typeof currentUser !== 'undefined' && (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF')) { %>
              <th class="p-3">Aktion</th>
              <% } %>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            <% todayLogs.forEach(log => { %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30">
              <td class="p-3 font-semibold">
                <% if (log.type === 'IN') { %>
                <span class="text-green-600">IN</span>
                <% } else { %>
                <span class="text-red-500">OUT</span>
                <% } %>
              </td>
              <td class="p-3">
                <%
                  const rawTs = log.display_time || String(log.local_timestamp || log.timestamp || '');
                  const tParts = rawTs.split(':');
                  const dispTime = tParts.length >= 2 ? tParts[0].slice(-2) + ':' + tParts[1] : rawTs;
                %>
                <%= dispTime %> Uhr
              </td>
              <td class="p-3">
                <% if (log.project_title) { %>
                  <span class="font-medium"><%= log.project_title %></span>
                  <% if (log.company_name || log.contact_person) { %>
                    <span class="text-xs text-slate-400 block"><%= log.company_name || log.contact_person %></span>
                  <% } %>
                <% } else { %>
                  <%= log.company_name || log.contact_person || 'Allgemein / Werkstatt' %>
                <% } %>
              </td>
              <td class="p-3 text-slate-500"><%= log.note || '–' %></td>
              <td class="p-3 text-xs text-slate-400">
                <% if (log.latitude && log.longitude) { %>
                <%= log.latitude.toFixed(4) %>, <%= log.longitude.toFixed(4) %>
                <% } else { %>–<% } %>
              </td>
              <% if (typeof currentUser !== 'undefined' && (currentUser.role === 'ADMIN' || currentUser.role === 'CHEF')) { %>
              <td class="p-3">
                <form action="/admin/timetracking/delete" method="POST" onsubmit="return confirm('Diesen Eintrag wirklich löschen?');">
                  <input type="hidden" name="log_id" value="<%= log.id %>">
                  <button type="submit" class="btn text-xs px-2 py-1" style="background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;">
                    🗑️ Löschen
                  </button>
                </form>
              </td>
              <% } %>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p class="text-sm text-slate-400 py-4 text-center">Heute wurden noch keine Stempelzeiten erfasst.</p>
      <% } %>
    </div>

  </div>
</main>

<script>
// LIVE-UHR
setInterval(() => {
  document.getElementById('live-clock').innerText =
    'Aktuelle Uhrzeit: ' + new Date().toLocaleTimeString('de-DE');
}, 1000);

// HAVERSINE-DISTANZ
function distanceMeters(lat1, lon1, lat2, lon2) {
  const R = 6371e3;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}

// GEO-FENCING
let detectedProject = null;

function checkGeofence(lat, lng) {
  let nearest = null, nearestDist = Infinity;
  for (const proj of GEO_PROJECTS) {
    if (!proj.site_lat || !proj.site_lng) continue;
    const d = distanceMeters(lat, lng, parseFloat(proj.site_lat), parseFloat(proj.site_lng));
    if (d <= (proj.site_radius || 200) && d < nearestDist) { nearestDist = d; nearest = proj; }
  }
  const banner = document.getElementById('geofence-banner');
  if (nearest) {
    detectedProject = nearest;
    const name = nearest.company_name || nearest.contact_person || nearest.title;
    document.getElementById('geofence-project-name').textContent =
      '🏗️ ' + nearest.title + (name !== nearest.title ? ' (' + name + ')' : '');
    document.getElementById('geofence-distance').textContent =
      'Entfernung: ca. ' + Math.round(nearestDist) + ' m · Radius: ' + (nearest.site_radius || 200) + ' m';
    if (!IS_STAMPED_IN) {
      const sel = document.getElementById('project-select');
      if (sel) sel.value = String(nearest.id);
    }
    banner.classList.remove('hidden');
  } else {
    detectedProject = null;
    banner.classList.add('hidden');
  }
}

// GPS
let watchId = null;
const needsGps = !IS_STAMPED_IN;
if (navigator.geolocation && needsGps) {
  navigator.geolocation.getCurrentPosition(
    (pos) => {
      document.getElementById('latitude').value = pos.coords.latitude;
      document.getElementById('longitude').value = pos.coords.longitude;
      syncSwitchGps(pos.coords.latitude, pos.coords.longitude);
      const s = document.getElementById('gps-status');
      if (s) { s.textContent = '📍 GPS-Standort erfolgreich erfasst.'; s.className = 'text-xs text-green-600 italic'; }
      checkGeofence(pos.coords.latitude, pos.coords.longitude);
    },
    () => {
      const s = document.getElementById('gps-status');
      if (s) { s.textContent = '⚠️ GPS konnte nicht ermittelt werden.'; s.className = 'text-xs text-orange-500 italic'; }
    },
    { timeout: 10000, enableHighAccuracy: true }
  );
  if (GEO_PROJECTS.length > 0) {
    watchId = navigator.geolocation.watchPosition(
      (pos) => {
        document.getElementById('latitude').value = pos.coords.latitude;
        document.getElementById('longitude').value = pos.coords.longitude;
        syncSwitchGps(pos.coords.latitude, pos.coords.longitude);
        checkGeofence(pos.coords.latitude, pos.coords.longitude);
      },
      () => {},
      { enableHighAccuracy: true, maximumAge: 5000, timeout: 15000 }
    );
  }
} else if (!navigator.geolocation && needsGps) {
  const s = document.getElementById('gps-status');
  if (s) s.textContent = 'Geolocation wird von diesem Browser nicht unterstützt.';
}

function stampInFromGeofence() {
  if (!detectedProject) return;
  const form = document.getElementById('stamp-form');
  if (!form) return;
  const sel = document.getElementById('project-select');
  if (sel) sel.value = String(detectedProject.id);
  const ni = document.getElementById('note-input');
  if (ni && !ni.value) ni.value = 'Baustelle: ' + detectedProject.title;
  const inp = document.createElement('input');
  inp.type = 'hidden'; inp.name = 'type'; inp.value = 'IN';
  form.appendChild(inp);
  form.submit();
}

function showSwitchPanel() {
  const p = document.getElementById('switch-panel');
  if (!p) return;
  p.classList.remove('hidden');
  const lat = document.getElementById('latitude').value;
  const lng = document.getElementById('longitude').value;
  if (lat) document.getElementById('switch-latitude').value = lat;
  if (lng) document.getElementById('switch-longitude').value = lng;
  p.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function hideSwitchPanel() {
  const p = document.getElementById('switch-panel');
  if (p) p.classList.add('hidden');
}

function syncSwitchGps(lat, lng) {
  const sLat = document.getElementById('switch-latitude');
  const sLng = document.getElementById('switch-longitude');
  if (sLat) sLat.value = lat;
  if (sLng) sLng.value = lng;
}

window.addEventListener('beforeunload', () => {
  if (watchId !== null) navigator.geolocation.clearWatch(watchId);
});
</script>
</body>
</html>
