<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<%
  const tabs = [
    { id: 'design',        label: 'Design',        group: 'Darstellung' },
    { id: 'sidebar',       label: 'Menü',          group: 'Darstellung' },
    { id: 'dashboard',     label: 'Dashboard',     group: 'Darstellung' },
    { id: 'pdf',           label: 'Belege & PDF',  group: 'Finanzen' },
    { id: 'datev',         label: 'DATEV',         group: 'Finanzen' },
    { id: 'textbausteine', label: 'Textbausteine', group: 'Finanzen' },
    { id: 'worktime',      label: 'Arbeitszeit',   group: 'Personal' },
    { id: 'stampclock',    label: 'Stempeluhr',    group: 'Personal' },
    { id: 'projects',      label: 'Aufträge',      group: 'Betrieb' },
    { id: 'lager',         label: 'Lager',         group: 'Betrieb' },
    { id: 'access',        label: 'Rechte',        group: 'Sicherheit' },
    { id: 'security',      label: 'Sicherheit',    group: 'Sicherheit' },
    { id: 'info',          label: 'System',        group: 'System' },
  ];
  const tabGroups = ['Darstellung', 'Finanzen', 'Personal', 'Betrieb', 'Sicherheit', 'System'];
  const activeTab = tabs.find(t => t.id === tab) || tabs[0];
%>

<style>
  .ap { max-width: 72rem; margin: 0 auto; padding: 0 1rem 6rem; }
  .ap-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: .75rem; padding: 1rem 0 .75rem;
  }
  .ap-head h1 { font-size: 1.25rem; font-weight: 700; color: #0f172a; margin: 0; }
  .dark .ap-head h1 { color: #f1f5f9; }
  .ap-head p { font-size: .75rem; color: #64748b; margin: .15rem 0 0; }
  .ap-back { font-size: .75rem; font-weight: 600; color: #2563eb; text-decoration: none; }
  .ap-layout { display: flex; gap: 1rem; align-items: flex-start; }
  .ap-nav {
    display: none; width: 14rem; flex-shrink: 0;
    position: sticky; top: 4.5rem;
    background: #fff; border: 1px solid #e2e8f0; border-radius: 1rem;
    padding: .6rem; max-height: calc(100vh - 6rem); overflow-y: auto;
  }
  .dark .ap-nav { background: #1e293b; border-color: #334155; }
  @media (min-width: 768px) { .ap-nav { display: block; } }
  .ap-nav-group { margin-bottom: .65rem; }
  .ap-nav-group:last-child { margin-bottom: 0; }
  .ap-nav-label {
    font-size: .65rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: #94a3b8; padding: .25rem .65rem .35rem;
  }
  .ap-nav a {
    display: block; padding: .55rem .7rem; border-radius: .65rem;
    font-size: .8125rem; font-weight: 500; color: #475569;
    text-decoration: none; margin-bottom: 1px;
  }
  .dark .ap-nav a { color: #cbd5e1; }
  .ap-nav a:hover { background: #f8fafc; }
  .dark .ap-nav a:hover { background: #334155; }
  .ap-nav a.active {
    background: #eff6ff; color: #1d4ed8; font-weight: 600;
  }
  .dark .ap-nav a.active { background: #1e3a5f; color: #93c5fd; }
  .ap-main { flex: 1; min-width: 0; }
  .ap-mobile {
    display: block; margin-bottom: .75rem;
  }
  @media (min-width: 768px) { .ap-mobile { display: none; } }
  .ap-mobile select {
    width: 100%; padding: .7rem .9rem; border-radius: .75rem;
    border: 1px solid #e2e8f0; background: #fff; font-size: .875rem;
    color: #0f172a;
  }
  .dark .ap-mobile select {
    background: #1e293b; border-color: #334155; color: #f1f5f9;
  }
  .ap-search { position: relative; margin-bottom: .85rem; }
  .ap-search input {
    width: 100%; padding: .7rem .9rem .7rem 2.4rem; border-radius: .75rem;
    border: 1px solid #e2e8f0; background: #fff; font-size: .875rem;
  }
  .dark .ap-search input {
    background: #1e293b; border-color: #334155; color: #f1f5f9;
  }
  .ap-search svg {
    position: absolute; left: .75rem; top: 50%; transform: translateY(-50%);
    width: 1rem; height: 1rem; color: #94a3b8; pointer-events: none;
  }
  .ap-search-results {
    display: none; position: absolute; z-index: 40; left: 0; right: 0;
    margin-top: .35rem; background: #fff; border: 1px solid #e2e8f0;
    border-radius: .75rem; box-shadow: 0 10px 25px rgba(0,0,0,.08);
    max-height: 16rem; overflow-y: auto;
  }
  .dark .ap-search-results {
    background: #1e293b; border-color: #334155;
  }
  .ap-search-results.open { display: block; }
  .ap-search-results a {
    display: block; padding: .6rem .9rem; font-size: .8125rem;
    color: #334155; text-decoration: none; border-bottom: 1px solid #f1f5f9;
  }
  .dark .ap-search-results a { color: #e2e8f0; border-color: #334155; }
  .ap-search-results a:hover { background: #f8fafc; }
  .dark .ap-search-results a:hover { background: #334155; }
  .ap-search-results .empty {
    padding: .75rem .9rem; font-size: .8125rem; color: #94a3b8;
  }
  .ap-title {
    display: flex; align-items: center; gap: .5rem;
    margin-bottom: .85rem; padding-bottom: .5rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .dark .ap-title { border-color: #334155; }
  .ap-title h2 {
    font-size: 1rem; font-weight: 700; color: #0f172a; margin: 0;
  }
  .dark .ap-title h2 { color: #f1f5f9; }
  .ap-title span {
    font-size: .65rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .04em; color: #94a3b8;
    background: #f1f5f9; padding: .2rem .5rem; border-radius: 999px;
  }
  .dark .ap-title span { background: #334155; color: #94a3b8; }
  .ap-banner {
    display: flex; align-items: center; gap: .5rem;
    background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46;
    border-radius: .75rem; padding: .7rem 1rem; font-size: .875rem;
    font-weight: 500; margin-bottom: .75rem;
  }
  .dark .ap-banner {
    background: rgba(6,78,59,.25); border-color: #065f46; color: #6ee7b7;
  }
</style>

<main class="flex-1 flex flex-col overflow-y-auto page-bg min-h-screen pt-16">
  <div class="ap">

    <div class="ap-head">
      <div>
        <h1>Einstellungen</h1>
        <p><%= activeTab.group %> · <%= activeTab.label %></p>
      </div>
      <a href="/" class="ap-back">← Dashboard</a>
    </div>

    <% if (success) { %>
      <div class="ap-banner" id="successBanner">Einstellungen gespeichert</div>
      <script>setTimeout(function(){ var b=document.getElementById('successBanner'); if(b) b.style.display='none'; }, 3500);</script>
    <% } %>

    <div class="ap-layout">

      <nav class="ap-nav" aria-label="Einstellungsbereiche">
        <% tabGroups.forEach(function(g) {
             var items = tabs.filter(function(t){ return t.group === g; });
        %>
          <div class="ap-nav-group">
            <div class="ap-nav-label"><%= g %></div>
            <% items.forEach(function(t) { %>
              <a href="/admin/panel?tab=<%= t.id %>" data-tab-id="<%= t.id %>"
                 class="<%= tab === t.id ? 'active' : '' %>"><%= t.label %></a>
            <% }); %>
          </div>
        <% }); %>
      </nav>

      <div class="ap-main">

        <div class="ap-mobile">
          <select id="ap-mobile-select" aria-label="Bereich wählen">
            <% tabGroups.forEach(function(g) { %>
              <optgroup label="<%= g %>">
                <% tabs.filter(function(t){ return t.group === g; }).forEach(function(t) { %>
                  <option value="<%= t.id %>" <%= tab === t.id ? 'selected' : '' %>><%= t.label %></option>
                <% }); %>
              </optgroup>
            <% }); %>
          </select>
        </div>

        <div class="ap-search" id="admin-search-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" id="admin-search-input" placeholder="Einstellung suchen…" autocomplete="off">
          <div class="ap-search-results" id="admin-search-results"></div>
        </div>

        <div class="ap-title">
          <h2><%= activeTab.label %></h2>
          <span><%= activeTab.group %></span>
        </div>

        <%- include('partials/admin/tab-design') %>
        <%- include('partials/admin/tab-sidebar') %>
        <%- include('partials/admin/tab-pdf') %>
        <%- include('partials/admin/tab-datev') %>
        <%- include('partials/admin/tab-worktime') %>
        <%- include('partials/admin/tab-stampclock') %>
        <%- include('partials/admin/tab-projects') %>
        <%- include('partials/admin/tab-security') %>
        <%- include('partials/admin/tab-dashboard') %>
        <%- include('partials/admin/tab-access') %>
        <%- include('partials/admin/tab-info') %>
        <%- include('partials/admin/tab-lager') %>
        <%- include('partials/admin/tab-textbausteine') %>

      </div>
    </div>
  </div>
</main>

<script>
(function () {
  // Mobile select
  var sel = document.getElementById('ap-mobile-select');
  if (sel) {
    sel.addEventListener('change', function () {
      if (this.value) location.href = '/admin/panel?tab=' + this.value;
    });
  }

  // Search index
  var INDEX = [
    { tab: 'design', label: 'Farbpalette der App' },
    { tab: 'design', label: 'Schnell-Vorlagen' },
    { tab: 'sidebar', label: 'Sidebar / Menü anpassen' },
    { tab: 'pdf', label: 'Nummern-Schema' },
    { tab: 'pdf', label: 'Standard-Werte' },
    { tab: 'pdf', label: 'PDF-Erscheinungsbild' },
    { tab: 'pdf', label: 'Einleitungstexte' },
    { tab: 'pdf', label: 'Fußzeile & AGB' },
    { tab: 'pdf', label: 'Nachkalkulation / Stundensatz' },
    { tab: 'datev', label: 'Berater & Mandant' },
    { tab: 'datev', label: 'Kontenrahmen' },
    { tab: 'datev', label: 'Erlös- & Debitorenkonten' },
    { tab: 'worktime', label: 'Soll-Stunden & Urlaub' },
    { tab: 'worktime', label: 'Automatischer Pausenabzug' },
    { tab: 'worktime', label: 'Feiertags-Region' },
    { tab: 'stampclock', label: 'Stempeluhr GPS / Projekt / Notiz' },
    { tab: 'stampclock', label: 'Erinnerung Ausstempeln' },
    { tab: 'stampclock', label: 'Firmen-Standort Geo-Fencing' },
    { tab: 'projects', label: 'Auftrags-Einstellungen' },
    { tab: 'security', label: 'Sicherheits-Einstellungen' },
    { tab: 'security', label: 'Datenaufbewahrung Zeiterfassung' },
    { tab: 'security', label: 'Automatisches Mahnwesen' },
    { tab: 'dashboard', label: 'Dashboard KPI-Schwellenwerte' },
    { tab: 'access', label: 'Berechtigungs-Matrix' },
    { tab: 'info', label: 'System-Information' },
    { tab: 'info', label: 'Datenbank-Backup' },
    { tab: 'lager', label: 'Lagerkategorien' },
    { tab: 'textbausteine', label: 'Textbausteine' }
  ];

  var input = document.getElementById('admin-search-input');
  var results = document.getElementById('admin-search-results');
  if (input && results) {
    function render(q) {
      q = (q || '').trim().toLowerCase();
      if (!q) { results.classList.remove('open'); results.innerHTML = ''; return; }
      var hits = INDEX.filter(function (i) { return i.label.toLowerCase().indexOf(q) !== -1; }).slice(0, 12);
      if (!hits.length) {
        results.innerHTML = '<div class="empty">Keine Treffer</div>';
      } else {
        results.innerHTML = hits.map(function (h) {
          return '<a href="/admin/panel?tab=' + h.tab + '">' + h.label + ' <span style="color:#94a3b8;font-size:.7rem">→ ' + h.tab + '</span></a>';
        }).join('');
      }
      results.classList.add('open');
    }
    input.addEventListener('input', function () { render(this.value); });
    input.addEventListener('focus', function () { if (this.value.trim()) render(this.value); });
    document.addEventListener('click', function (e) {
      var wrap = document.getElementById('admin-search-wrap');
      if (wrap && !wrap.contains(e.target)) results.classList.remove('open');
    });
  }

  // KPI preview (if elements exist on dashboard tab)
  window.updateKpiPreview = function () {
    var ov = parseFloat((document.getElementById('kpi_overdue') || {}).value || 0);
    var owW = parseFloat((document.getElementById('kpi_overdue_warn') || {}).value || 0);
    var owD = parseFloat((document.getElementById('kpi_overdue_danger') || {}).value || 0);
    var ta = parseFloat((document.getElementById('kpi_tasks') || {}).value || 0);
    var twW = parseFloat((document.getElementById('kpi_tasks_warn') || {}).value || 0);
    var twD = parseFloat((document.getElementById('kpi_tasks_danger') || {}).value || 0);
    function colorClass(val, warn, dang) {
      return val >= dang ? 'border-red-500 bg-red-50'
        : val >= warn ? 'border-yellow-400 bg-yellow-50'
        : 'border-gray-300 bg-gray-50';
    }
    var ovEl = document.getElementById('prevOverdue');
    var taEl = document.getElementById('prevTasks');
    if (ovEl) ovEl.className = 'p-4 rounded-xl border-l-4 transition ' + colorClass(ov, owW, owD);
    if (taEl) taEl.className = 'p-4 rounded-xl border-l-4 transition ' + colorClass(ta, twW, twD);
  };

  // Session timeout
  (function () {
    var mins = parseInt('<%= typeof firma !== "undefined" && firma.session_timeout_minutes ? firma.session_timeout_minutes : 0 %>', 10);
    if (!mins || mins <= 0) return;
    var timer = setTimeout(function () {
      alert('Sitzung abgelaufen – du wirst abgemeldet.');
      window.location.href = '/logout';
    }, mins * 60 * 1000);
    ['click', 'keydown', 'scroll', 'mousemove'].forEach(function (ev) {
      document.addEventListener(ev, function () {
        clearTimeout(timer);
        timer = setTimeout(function () {
          alert('Sitzung abgelaufen – du wirst abgemeldet.');
          window.location.href = '/logout';
        }, mins * 60 * 1000);
      }, { passive: true });
    });
  })();

  // Unsaved changes warning
  (function () {
    var dirty = false;
    document.querySelectorAll('main form').forEach(function (form) {
      form.addEventListener('input', function () { dirty = true; });
      form.addEventListener('change', function () { dirty = true; });
      form.addEventListener('submit', function () { dirty = false; });
    });
    window.addEventListener('beforeunload', function (e) {
      if (!dirty) return;
      e.preventDefault();
      e.returnValue = '';
    });
    document.querySelectorAll('a[data-tab-id], .ap-back').forEach(function (link) {
      link.addEventListener('click', function (e) {
        if (!dirty) return;
        if (!confirm('Ungespeicherte Änderungen gehen verloren. Trotzdem weiter?')) e.preventDefault();
      });
    });
    if (sel) {
      sel.addEventListener('change', function (e) {
        if (!dirty) return;
        if (!confirm('Ungespeicherte Änderungen gehen verloren. Trotzdem weiter?')) {
          e.preventDefault();
          // reset select
          var cur = '<%= tab %>';
          for (var i = 0; i < sel.options.length; i++) {
            if (sel.options[i].value === cur) sel.selectedIndex = i;
          }
        }
      }, true);
    }
  })();
})();
</script>
