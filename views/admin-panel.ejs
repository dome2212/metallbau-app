<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex flex-col overflow-y-auto page-bg min-h-screen pt-16">

    <!-- Seitenüberschrift -->
    <header class="bg-white dark:bg-slate-800 shadow px-4 md:px-6 py-4 flex justify-between items-center mb-6">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100">⚙️ Admin-Panel</h1>
        <p class="text-xs text-slate-400 mt-0.5">App-Design, Sidebar, Features und Berechtigungen verwalten</p>
      </div>
      <a href="/" class="text-sm text-slate-500 hover:text-slate-700 dark:hover:text-slate-200 transition">← Dashboard</a>
    </header>

    <div class="px-4 md:px-6 max-w-5xl mx-auto w-full pb-12">

      <!-- Erfolgsmeldung -->
      <% if (success) { %>
        <div id="successBanner" class="bg-green-50 dark:bg-green-900/30 border border-green-300 dark:border-green-700 text-green-800 dark:text-green-300 rounded-xl px-5 py-3 text-sm font-medium flex items-center gap-2 mb-5">
          ✅ Einstellungen erfolgreich gespeichert!
        </div>
        <script>setTimeout(() => { const b = document.getElementById('successBanner'); if(b) b.style.display='none'; }, 4000);</script>
      <% } %>

      <!-- Tab-Navigation -->
      <div class="flex gap-1 bg-white dark:bg-slate-800 rounded-xl shadow p-1.5 mb-3 overflow-x-auto">
        <% const svgIcon = (path) => `<svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`; %>
        <% const tabs = [
            { id: 'design',   label: 'Design', icon: svgIcon('<path d="M12 3a9 9 0 100 18c1 0 1.5-.5 1.5-1.3 0-.4-.2-.7-.4-1-.2-.3-.4-.6-.4-1 0-.8.6-1.4 1.4-1.4H16a4 4 0 004-4c0-5-4-9.3-8-9.3z"/><circle cx="7.5" cy="11.5" r="1"/><circle cx="10.5" cy="7.5" r="1"/><circle cx="15" cy="8" r="1"/><circle cx="17" cy="12" r="1"/>') },
            { id: 'sidebar',  label: 'Sidebar', icon: svgIcon('<rect x="3" y="3" width="7" height="18" rx="1"/><rect x="12" y="3" width="9" height="18" rx="1"/>') },
            { id: 'pdf',      label: 'PDF & Dokumente', icon: svgIcon('<path d="M14 3v5a1 1 0 001 1h5"/><path d="M6 21h12a1 1 0 001-1V7l-5-5H7a1 1 0 00-1 1v3"/><path d="M9 15h6M9 12h6"/>') },
            { id: 'datev',    label: 'DATEV-Export', icon: svgIcon('<path d="M6 2h9l3 3v17l-2-1-2 1-2-1-2 1-2-1-2 1V2z"/><path d="M9 7h6M9 11h6M9 15h4"/>') },
            { id: 'worktime',   label: 'Arbeitszeit', icon: svgIcon('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>') },
            { id: 'stampclock', label: 'Stempeluhr', icon: svgIcon('<circle cx="12" cy="13" r="7"/><path d="M12 10v3l2 1.5M9 3h6M11 1.5v1.5M13 1.5v1.5"/>') },
            { id: 'projects',   label: 'Aufträge', icon: svgIcon('<rect x="4" y="3" width="10" height="18" rx="1"/><path d="M14 21v-6h4v6M8 7h.01M11 7h.01M8 11h.01M11 11h.01"/>') },
            { id: 'lager',    label: 'Lager-Tabs', icon: svgIcon('<path d="M3 9.5L12 4l9 5.5V19a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1V9.5z"/>') },
            { id: 'textbausteine', label: 'Textbausteine', icon: svgIcon('<path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>') },
            { id: 'security', label: 'Sicherheit', icon: svgIcon('<path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z"/>') },
            { id: 'dashboard',label: 'Dashboard KPIs', icon: svgIcon('<path d="M3 3v18h18"/><path d="M7 15l3-4 3 2 5-6"/>') },
            { id: 'access',   label: 'Zugriff', icon: svgIcon('<rect x="4" y="11" width="16" height="9" rx="1.5"/><path d="M8 11V7a4 4 0 018 0v4"/>') },
            { id: 'info',     label: 'System', icon: svgIcon('<circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/>') },
          ]; %>
        <% for (const t of tabs) { %>
          <a href="/admin/panel?tab=<%= t.id %>" data-tab-id="<%= t.id %>"
            class="flex-shrink-0 px-4 py-2 rounded-lg text-sm font-medium transition
              <%= tab === t.id
                ? 'bg-blue-600 text-white shadow'
                : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700' %>">
            <%- t.icon %><%= t.label %>
          </a>
        <% } %>
      </div>

      <!-- Schnellsuche über alle Einstellungen -->
      <div class="relative mb-6" id="admin-search-wrap">
        <input type="text" id="admin-search-input" autocomplete="off"
          placeholder="🔍 Einstellung suchen (z.B. „GPS“, „Backup“, „Pausenabzug“)…"
          class="w-full border dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
        <div id="admin-search-results"
          class="hidden absolute z-30 left-0 right-0 mt-1 bg-white dark:bg-slate-800 border dark:border-slate-600 rounded-lg shadow-lg max-h-72 overflow-y-auto"></div>
      </div>
      <script>
        // Statische Liste aller Einstellungs-Abschnitte je Tab, damit man nicht
        // erst wissen muss, unter welchem Tab eine Einstellung versteckt ist.
        const ADMIN_SEARCH_INDEX = [
          { tab: 'design',        label: '🎨 Farbpalette der App' },
          { tab: 'design',        label: '⚡ Schnell-Vorlagen' },
          { tab: 'sidebar',       label: '📌 Sidebar anpassen' },
          { tab: 'pdf',           label: '🔢 Nummern-Schema' },
          { tab: 'pdf',           label: '💰 Standard-Werte' },
          { tab: 'pdf',           label: '🎨 PDF-Erscheinungsbild' },
          { tab: 'pdf',           label: '✉️ Einleitungstexte' },
          { tab: 'pdf',           label: '📃 Fußzeile & AGB' },
          { tab: 'datev',         label: '🔑 Berater & Mandant' },
          { tab: 'datev',         label: '📚 Kontenrahmen' },
          { tab: 'datev',         label: '💶 Erlös- & Debitorenkonten' },
          { tab: 'worktime',      label: '⏱️ Soll-Stunden & Urlaub' },
          { tab: 'worktime',      label: '☕ Automatischer Pausenabzug' },
          { tab: 'worktime',      label: '🗓️ Feiertags-Region' },
          { tab: 'stampclock',    label: '🕐 Stempeluhr-Verhalten (GPS-Pflicht, Projekt, Notiz, Wechsel)' },
          { tab: 'stampclock',    label: '⏰ Erinnerung bei vergessenem Ausstempeln' },
          { tab: 'stampclock',    label: '📍 Firmen-Standort (Geo-Fencing)' },
          { tab: 'projects',      label: '🏗️ Auftrags-Einstellungen' },
          { tab: 'security',      label: '🔒 Sicherheits-Einstellungen' },
          { tab: 'security',      label: '🗑️ Datenaufbewahrung Zeiterfassung (Löschfrist)' },
          { tab: 'security',      label: '✉️ Automatisches Mahnwesen bei überfälligen Rechnungen' },
          { tab: 'dashboard',     label: '📊 Dashboard KPI-Schwellenwerte' },
          { tab: 'dashboard',     label: '👁️ Live-Vorschau' },
          { tab: 'access',        label: '🔐 Schnell-Links' },
          { tab: 'access',        label: '📋 Berechtigungs-Matrix' },
          { tab: 'info',          label: 'ℹ️ System-Information' },
          { tab: 'info',          label: '🗄️ Datenbank-Backup' },
          { tab: 'info',          label: '🔗 Schnell-Links' },
          { tab: 'lager',         label: '🏭 Eigene Lagerkategorien' },
          { tab: 'lager',         label: '📦 Proaktive Lagerbestand-Warnung (WhatsApp)' },
          { tab: 'textbausteine', label: '📎 Textbausteine für Angebot & Auftrag' },
        ];
        const TAB_LABELS = <%- JSON.stringify(tabs.reduce((acc, t) => { acc[t.id] = t.label; return acc; }, {})) %>;

        (function () {
          const input = document.getElementById('admin-search-input');
          const results = document.getElementById('admin-search-results');

          function render(query) {
            const q = query.trim().toLowerCase();
            if (!q) { results.classList.add('hidden'); results.innerHTML = ''; return; }
            const matches = ADMIN_SEARCH_INDEX.filter(item =>
              item.label.toLowerCase().includes(q) || (TAB_LABELS[item.tab] || '').toLowerCase().includes(q)
            );
            if (matches.length === 0) {
              results.innerHTML = '<div class="px-4 py-3 text-sm text-slate-400">Keine Treffer.</div>';
            } else {
              results.innerHTML = matches.map(item => `
                <a href="/admin/panel?tab=${item.tab}" class="block px-4 py-2.5 text-sm hover:bg-blue-50 dark:hover:bg-slate-700 border-b dark:border-slate-700 last:border-0">
                  <span class="text-slate-800 dark:text-gray-100">${item.label}</span>
                  <span class="block text-xs text-slate-400">in ${TAB_LABELS[item.tab] || item.tab}</span>
                </a>
              `).join('');
            }
            results.classList.remove('hidden');
          }

          input.addEventListener('input', () => render(input.value));
          input.addEventListener('focus', () => { if (input.value.trim()) render(input.value); });
          document.addEventListener('click', (e) => {
            if (!document.getElementById('admin-search-wrap').contains(e.target)) results.classList.add('hidden');
          });
        })();
      </script>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: FARBEN & DESIGN                                               -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <%- include('partials/admin/tab-design') %>
      <%- include('partials/admin/tab-sidebar') %>
      <%- include('partials/admin/tab-pdf') %>
      <%- include('partials/admin/tab-datev') %>
      <%- include('partials/admin/tab-worktime') %>
      <%- include('partials/admin/tab-stampclock') %>
      <%- include('partials/admin/tab-projects') %>
      <%- include('partials/admin/tab-security') %>
      <%- include('partials/admin/tab-dashboard') %>
      <%- include('partials/admin/tab-access') %>
      <%- include('partials/admin/tab-info') %>
      <%- include('partials/admin/tab-lager') %>
      <%- include('partials/admin/tab-textbausteine') %>
</main>

<script>
  // Farb-Vorschau Live-Update
  function updatePreview(id, value) {
    const el = document.getElementById(id);
    if (el) el.style.background = value;
  }

  // Schnell-Vorlage anwenden
  function applyPreset(primary, sidebarBg, sidebarText, sidebarHover, pageBg, topbarBg) {
    setColorInput('color_primary',      primary);
    setColorInput('color_sidebar_bg',   sidebarBg);
    setColorInput('color_sidebar_text', sidebarText);
    setColorInput('color_sidebar_hover',sidebarHover);
    setColorInput('color_page_bg',      pageBg);
    setColorInput('color_topbar_bg',    topbarBg);
  }
  function setColorInput(name, value) {
    const inp = document.querySelector(`input[name="${name}"]`);
    if (!inp) return;
    inp.value = value;
    inp.dispatchEvent(new Event('input'));
  }

  // Sidebar-Modus: Logo-Höhe ein-/ausblenden
  document.querySelectorAll('input[name="sidebar_modus"]').forEach(r => {
    r.addEventListener('change', function() {
      const wrap = document.getElementById('heightWrap');
      if (wrap) wrap.classList.toggle('hidden', this.value !== 'logo');
    });
  });

  // KPI-Vorschau: Farblogik Live-Demo
  function updateKpiPreview() {
    const ov   = parseInt(document.getElementById('previewOverdueVal')?.value || 0);
    const ta   = parseInt(document.getElementById('previewTasksVal')?.value   || 0);
    const owW  = parseInt(document.querySelector('input[name="kpi_overdue_warn"]')?.value   || 3);
    const owD  = parseInt(document.querySelector('input[name="kpi_overdue_danger"]')?.value || 6);
    const twW  = parseInt(document.querySelector('input[name="kpi_tasks_warn"]')?.value     || 5);
    const twD  = parseInt(document.querySelector('input[name="kpi_tasks_danger"]')?.value   || 10);

    const colorClass = (val, warn, danger) =>
      val >= danger ? 'border-red-500 bg-red-50'
      : val >= warn ? 'border-yellow-400 bg-yellow-50'
      : 'border-gray-300 bg-gray-50';

    const ovEl = document.getElementById('prevOverdue');
    const taEl = document.getElementById('prevTasks');
    if (ovEl) ovEl.className = 'p-4 rounded-xl border-l-4 transition ' + colorClass(ov, owW, owD);
    if (taEl) taEl.className = 'p-4 rounded-xl border-l-4 transition ' + colorClass(ta, twW, twD);
  }

  // Session-Timeout clientseitig (aus Admin-Panel Einstellung)
  (function() {
    const mins = parseInt('<%= typeof firma !== "undefined" && firma.session_timeout_minutes ? firma.session_timeout_minutes : 0 %>');
    if (!mins || mins <= 0) return;
    let timer = setTimeout(() => {
      alert('Deine Sitzung ist abgelaufen. Du wirst jetzt abgemeldet.');
      window.location.href = '/logout';
    }, mins * 60 * 1000);
    ['click','keydown','scroll','mousemove'].forEach(ev =>
      document.addEventListener(ev, () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          alert('Deine Sitzung ist abgelaufen. Du wirst jetzt abgemeldet.');
          window.location.href = '/logout';
        }, mins * 60 * 1000);
      }, { passive: true })
    );
  })();

  // ── Warnung bei ungespeicherten Änderungen ──────────────────────────────
  // Da jeder Tab ein eigenes <form> ist, gehen Änderungen sonst kommentarlos
  // verloren, wenn man auf einen anderen Tab klickt oder die Seite verlässt,
  // bevor man auf "Speichern" gedrückt hat.
  (function () {
    let dirty = false;
    const forms = document.querySelectorAll('main form');
    forms.forEach(form => {
      form.addEventListener('input', () => { dirty = true; });
      form.addEventListener('change', () => { dirty = true; });
      // Beim eigentlichen Absenden (Speichern) zählt es nicht mehr als "offen"
      form.addEventListener('submit', () => { dirty = false; });
    });

    window.addEventListener('beforeunload', function (e) {
      if (!dirty) return;
      e.preventDefault();
      e.returnValue = '';
    });

    // Klick auf einen anderen Tab oder "← Dashboard": vorher warnen
    document.querySelectorAll('a[data-tab-id], header a[href="/"]').forEach(link => {
      link.addEventListener('click', function (e) {
        if (!dirty) return;
        const ok = confirm('Du hast ungespeicherte Änderungen. Diese gehen verloren, wenn du jetzt weiter klickst. Trotzdem fortfahren?');
        if (!ok) e.preventDefault();
      });
    });
  })();
</script>
