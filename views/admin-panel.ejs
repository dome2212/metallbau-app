<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex flex-col overflow-y-auto md:ml-72 page-bg min-h-screen pt-16 md:pt-6">

    <!-- Seitenüberschrift -->
    <header class="bg-white dark:bg-slate-800 shadow px-4 md:px-6 py-4 flex justify-between items-center mb-6">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100">⚙️ Admin-Panel</h1>
        <p class="text-xs text-slate-400 mt-0.5">App-Design, Sidebar, Features und Berechtigungen verwalten</p>
      </div>
      <a href="/" class="text-sm text-slate-500 hover:text-slate-700 dark:hover:text-slate-200 transition">← Dashboard</a>
    </header>

    <div class="px-4 md:px-6 max-w-5xl mx-auto w-full pb-12">

      <!-- Erfolgsmeldung -->
      <% if (success) { %>
        <div id="successBanner" class="bg-green-50 dark:bg-green-900/30 border border-green-300 dark:border-green-700 text-green-800 dark:text-green-300 rounded-xl px-5 py-3 text-sm font-medium flex items-center gap-2 mb-5">
          ✅ Einstellungen erfolgreich gespeichert!
        </div>
        <script>setTimeout(() => { const b = document.getElementById('successBanner'); if(b) b.style.display='none'; }, 4000);</script>
      <% } %>

      <!-- Tab-Navigation -->
      <div class="flex gap-1 bg-white dark:bg-slate-800 rounded-xl shadow p-1.5 mb-6 overflow-x-auto">
        <% const tabs = [
            { id: 'design',   label: '🎨 Design' },
            { id: 'sidebar',  label: '📌 Sidebar' },
            { id: 'pdf',      label: '📄 PDF & Dokumente' },
            { id: 'worktime',   label: '⏱️ Arbeitszeit' },
            { id: 'stampclock', label: '🕐 Stempeluhr' },
            { id: 'projects',   label: '🏗️ Aufträge' },
            { id: 'security', label: '🔒 Sicherheit' },
            { id: 'dashboard',label: '📊 Dashboard KPIs' },
            { id: 'access',   label: '🔐 Zugriff' },
            { id: 'info',     label: 'ℹ️ System' },
          ]; %>
        <% for (const t of tabs) { %>
          <a href="/admin/panel?tab=<%= t.id %>"
            class="flex-shrink-0 px-4 py-2 rounded-lg text-sm font-medium transition
              <%= tab === t.id
                ? 'bg-blue-600 text-white shadow'
                : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700' %>">
            <%= t.label %>
          </a>
        <% } %>
      </div>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: FARBEN & DESIGN                                               -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <% if (tab === 'design') { %>
      <form action="/admin/panel/design" method="POST" class="space-y-6">

        <!-- Farbpalette -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-1 border-b dark:border-slate-700 pb-2">🎨 Farbpalette der App</h2>
          <p class="text-xs text-slate-400 mb-5">Diese Farben wirken sich sofort auf die gesamte App aus (nach dem Speichern).</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

            <!-- Primärfarbe -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_primary" value="<%= firma.color_primary || '#2563eb' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_primary', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Primärfarbe</p>
                <p class="text-xs text-slate-400">Buttons, Links, Akzente</p>
                <div id="prev_primary" class="mt-1 h-4 w-20 rounded" style="background:<%= firma.color_primary || '#2563eb' %>;"></div>
              </div>
            </div>

            <!-- Sidebar Hintergrund -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_sidebar_bg" value="<%= firma.color_sidebar_bg || '#1e293b' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_sidebar_bg', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Sidebar Hintergrund</p>
                <p class="text-xs text-slate-400">Hintergrundfarbe der Seitenleiste</p>
                <div id="prev_sidebar_bg" class="mt-1 h-4 w-20 rounded border border-slate-300" style="background:<%= firma.color_sidebar_bg || '#1e293b' %>;"></div>
              </div>
            </div>

            <!-- Sidebar Schrift -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_sidebar_text" value="<%= firma.color_sidebar_text || '#e2e8f0' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_sidebar_text', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Sidebar Schrift</p>
                <p class="text-xs text-slate-400">Textfarbe in der Sidebar</p>
                <div id="prev_sidebar_text" class="mt-1 h-4 w-20 rounded border border-slate-300" style="background:<%= firma.color_sidebar_text || '#e2e8f0' %>;"></div>
              </div>
            </div>

            <!-- Sidebar Hover -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_sidebar_hover" value="<%= firma.color_sidebar_hover || '#334155' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_sidebar_hover', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Sidebar Hover</p>
                <p class="text-xs text-slate-400">Farbe beim Darüberfahren</p>
                <div id="prev_sidebar_hover" class="mt-1 h-4 w-20 rounded border border-slate-300" style="background:<%= firma.color_sidebar_hover || '#334155' %>;"></div>
              </div>
            </div>

            <!-- Seitenhintergrund -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_page_bg" value="<%= firma.color_page_bg || '#f1f5f9' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_page_bg', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Seiten-Hintergrund</p>
                <p class="text-xs text-slate-400">Hintergrund des Hauptinhalts</p>
                <div id="prev_page_bg" class="mt-1 h-4 w-20 rounded border border-slate-300" style="background:<%= firma.color_page_bg || '#f1f5f9' %>;"></div>
              </div>
            </div>

            <!-- Header-Hintergrund -->
            <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border dark:border-slate-600">
              <div>
                <input type="color" name="color_topbar_bg" value="<%= firma.color_topbar_bg || '#ffffff' %>"
                  class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent"
                  oninput="updatePreview('prev_topbar_bg', this.value)">
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Header-Hintergrund</p>
                <p class="text-xs text-slate-400">Topbar / Kartenköpfe</p>
                <div id="prev_topbar_bg" class="mt-1 h-4 w-20 rounded border border-slate-300" style="background:<%= firma.color_topbar_bg || '#ffffff' %>;"></div>
              </div>
            </div>

          </div><!-- /grid -->
        </div>

        <!-- Farb-Vorlagen -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-3 border-b dark:border-slate-700 pb-2">⚡ Schnell-Vorlagen</h2>
          <div class="flex flex-wrap gap-3">
            <% const presets = [
              { name: 'Standard Blau',  primary:'#2563eb', sidebarBg:'#1e293b', sidebarText:'#e2e8f0', sidebarHover:'#334155', pageBg:'#f1f5f9', topbarBg:'#ffffff' },
              { name: 'Dunkel',         primary:'#6366f1', sidebarBg:'#0f172a', sidebarText:'#cbd5e1', sidebarHover:'#1e293b', pageBg:'#1e293b', topbarBg:'#0f172a' },
              { name: 'Grün',           primary:'#16a34a', sidebarBg:'#14532d', sidebarText:'#dcfce7', sidebarHover:'#166534', pageBg:'#f0fdf4', topbarBg:'#ffffff' },
              { name: 'Orange',         primary:'#ea580c', sidebarBg:'#431407', sidebarText:'#fed7aa', sidebarHover:'#7c2d12', pageBg:'#fff7ed', topbarBg:'#ffffff' },
              { name: 'Lila',           primary:'#7c3aed', sidebarBg:'#2e1065', sidebarText:'#ede9fe', sidebarHover:'#4c1d95', pageBg:'#faf5ff', topbarBg:'#ffffff' },
              { name: 'Rot',            primary:'#dc2626', sidebarBg:'#450a0a', sidebarText:'#fecaca', sidebarHover:'#7f1d1d', pageBg:'#fef2f2', topbarBg:'#ffffff' },
            ]; %>
            <% for (const p of presets) { %>
              <button type="button"
                onclick="applyPreset('<%= p.primary %>','<%= p.sidebarBg %>','<%= p.sidebarText %>','<%= p.sidebarHover %>','<%= p.pageBg %>','<%= p.topbarBg %>')"
                class="flex items-center gap-2 px-3 py-2 rounded-lg border dark:border-slate-600 bg-slate-50 dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-sm text-slate-700 dark:text-slate-200 transition">
                <span class="w-4 h-4 rounded-full inline-block shrink-0" style="background:<%= p.primary %>;"></span>
                <%= p.name %>
              </button>
            <% } %>
          </div>
        </div>

        <div class="flex justify-end gap-3">
          <button type="reset" class="px-5 py-2.5 rounded-lg border dark:border-slate-600 text-slate-600 dark:text-slate-300 text-sm hover:bg-slate-100 dark:hover:bg-slate-700 transition">
            Zurücksetzen
          </button>
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Design speichern
          </button>
        </div>
      </form>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: SIDEBAR                                                        -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <% if (tab === 'sidebar') { %>
      <form action="/admin/panel/sidebar" method="POST" class="space-y-6">

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">📌 Sidebar anpassen</h2>

          <div class="space-y-5">

            <!-- App-Kurzname -->
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Kurzname <span class="text-slate-400 font-normal">(erscheint oben in der Sidebar)</span>
              </label>
              <input type="text" name="nameKurz" value="<%= firma.nameKurz %>"
                placeholder="z.B. Metallbau-Mustermann"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>

            <!-- App-Icon -->
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-2">
                Sidebar-Icon <span class="text-slate-400 font-normal">(Emoji vor dem Kurznamen)</span>
              </label>
              <div class="flex flex-wrap gap-2 mb-3">
                <% const icons = ['🔩','🏗️','⚙️','🏢','🔧','🛠️','⚒️','🏛️','🔨','🪛','🪚','🏭','⛏️','🪜']; %>
                <% for (const ic of icons) { %>
                  <button type="button"
                    onclick="document.getElementById('appIconInput').value='<%= ic %>'; document.getElementById('iconPreview').textContent='<%= ic %>';"
                    class="w-10 h-10 text-xl rounded-lg border dark:border-slate-600 hover:bg-blue-50 dark:hover:bg-slate-600 transition flex items-center justify-center
                      <%= firma.app_icon === ic ? 'bg-blue-100 dark:bg-blue-900/40 border-blue-400' : 'bg-slate-50 dark:bg-slate-700' %>">
                    <%= ic %>
                  </button>
                <% } %>
              </div>
              <div class="flex items-center gap-3">
                <input type="text" name="app_icon" id="appIconInput" value="<%= firma.app_icon || '🔩' %>"
                  maxlength="5" placeholder="Eigenes Emoji eingeben"
                  oninput="document.getElementById('iconPreview').textContent=this.value"
                  class="w-40 border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
                <span class="text-xs text-slate-400">Vorschau: <span id="iconPreview" class="text-2xl"><%= firma.app_icon || '🔩' %></span></span>
              </div>
            </div>

            <!-- Sidebar-Modus -->
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-2">
                Sidebar-Kopf
              </label>
              <div class="flex gap-3 flex-wrap">
                <label class="flex items-center gap-3 cursor-pointer border-2 rounded-xl px-4 py-3 transition
                  <%= firma.sidebar_modus !== 'logo' ? 'border-blue-500 bg-blue-50 dark:bg-blue-900/20' : 'border-slate-200 dark:border-slate-600' %>">
                  <input type="radio" name="sidebar_modus" value="text"
                    <%= firma.sidebar_modus !== 'logo' ? 'checked' : '' %> class="accent-blue-600">
                  <div>
                    <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Icon + Kurzname als Text</p>
                    <p class="text-xs text-slate-400">z.B. <%= firma.app_icon || '🔩' %> <%= firma.nameKurz %></p>
                  </div>
                </label>
                <label class="flex items-center gap-3 cursor-pointer border-2 rounded-xl px-4 py-3 transition
                  <%= firma.sidebar_modus === 'logo' ? 'border-blue-500 bg-blue-50 dark:bg-blue-900/20' : 'border-slate-200 dark:border-slate-600' %>">
                  <input type="radio" name="sidebar_modus" value="logo"
                    <%= firma.sidebar_modus === 'logo' ? 'checked' : '' %> class="accent-blue-600">
                  <div>
                    <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Logo anzeigen</p>
                    <p class="text-xs text-slate-400">Das hochgeladene Sidebar-Logo</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Logo-Höhe -->
            <div id="heightWrap" class="<%= firma.sidebar_modus === 'logo' ? '' : 'hidden' %> bg-slate-50 dark:bg-slate-700/40 rounded-xl p-4 border dark:border-slate-600">
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-2">
                Logo-Höhe in der Sidebar: <span id="heightVal" class="font-bold text-blue-600"><%= firma.sidebar_logo_height || 80 %>px</span>
              </label>
              <input type="range" name="sidebar_logo_height" id="heightRange"
                min="40" max="200" step="5" value="<%= firma.sidebar_logo_height || 80 %>"
                oninput="document.getElementById('heightVal').textContent=this.value+'px'"
                class="w-full accent-blue-600 cursor-pointer">
              <div class="flex justify-between text-[10px] text-slate-400 mt-1">
                <span>Klein (40px)</span><span>Mittel (120px)</span><span>Groß (200px)</span>
              </div>
            </div>

          </div><!-- /space-y-5 -->
        </div>

        <!-- Hinweis: Logos über Firmendaten hochladen -->
        <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-300 dark:border-amber-700 rounded-xl px-5 py-3 text-sm text-amber-800 dark:text-amber-300 flex items-start gap-3">
          <span class="text-lg shrink-0">💡</span>
          <div>
            Logos (PDF-Logo & Sidebar-Logo) kannst du unter
            <a href="/admin/company-settings" class="underline font-semibold">Firmendaten</a>
            hochladen.
          </div>
        </div>

        <div class="flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Sidebar-Einstellungen speichern
          </button>
        </div>
      </form>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: PDF & DOKUMENTE                                               -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <% if (tab === 'pdf') { %>
      <form action="/admin/panel/pdf" method="POST" class="space-y-6">

        <!-- Nummern-Schema -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-1 border-b dark:border-slate-700 pb-2">🔢 Nummern-Schema</h2>
          <p class="text-xs text-slate-400 mb-5">Prefix für automatisch generierte Dokumentnummern.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Rechnungs-Prefix <span class="text-slate-400 font-normal">(z.B. <code>RECH</code> → RECH-2025-0001)</span>
              </label>
              <input type="text" name="invoice_prefix" value="<%= firma.invoice_prefix || 'RECH' %>" maxlength="10"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Angebots-Prefix <span class="text-slate-400 font-normal">(z.B. <code>ANG</code> → ANG-2025-0001)</span>
              </label>
              <input type="text" name="offer_prefix" value="<%= firma.offer_prefix || 'ANG' %>" maxlength="10"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500">
            </div>
          </div>
        </div>

        <!-- MwSt & Zahlungsart -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">💰 Standard-Werte</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Standard-Mehrwertsteuersatz (%)</label>
              <div class="flex gap-2 flex-wrap mb-2">
                <% for (const rate of [0, 7, 19]) { %>
                  <label class="flex items-center gap-1.5 cursor-pointer px-3 py-2 rounded-lg border dark:border-slate-600 text-sm
                    <%= (firma.default_tax_rate || '19') == rate ? 'bg-blue-50 dark:bg-blue-900/30 border-blue-400 font-semibold' : 'bg-slate-50 dark:bg-slate-700' %>">
                    <input type="radio" name="default_tax_rate" value="<%= rate %>"
                      <%= (firma.default_tax_rate || '19') == rate ? 'checked' : '' %> class="accent-blue-600">
                    <%= rate %> %
                  </label>
                <% } %>
              </div>
              <input type="number" name="default_tax_rate" value="<%= firma.default_tax_rate || 19 %>" min="0" max="100" step="0.1"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500"
                placeholder="Eigener Wert">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Standard-Zahlungsart</label>
              <select name="default_payment_method"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
                <% for (const method of ['Überweisung','Bar','EC-Karte','PayPal','Scheck','Lastschrift']) { %>
                  <option value="<%= method %>" <%= firma.default_payment_method === method ? 'selected' : '' %>><%= method %></option>
                <% } %>
              </select>
            </div>
          </div>
        </div>

        <!-- PDF Briefkopf-Farbe -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">🎨 PDF-Erscheinungsbild</h2>
          <div class="flex items-center gap-4">
            <div>
              <input type="color" name="pdf_color" value="<%= firma.pdf_color || '#1e3a5f' %>"
                class="w-12 h-12 rounded-lg cursor-pointer border-2 border-slate-200 dark:border-slate-600 bg-transparent">
            </div>
            <div>
              <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Briefkopf-Akzentfarbe</p>
              <p class="text-xs text-slate-400">Farbe der Trennlinie und Tabellen-Header im PDF</p>
            </div>
          </div>
        </div>

        <!-- Einleitungstexte -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">✉️ Einleitungstexte</h2>
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Einleitungstext Angebot</label>
              <textarea name="pdf_intro_offer" rows="3"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500"><%= firma.pdf_intro_offer || 'Sehr geehrte Damen und Herren,\nvielen Dank für Ihre Anfrage. Wir unterbreiten Ihnen folgendes Angebot:' %></textarea>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Einleitungstext Rechnung</label>
              <textarea name="pdf_intro_invoice" rows="3"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500"><%= firma.pdf_intro_invoice || 'Sehr geehrte Damen und Herren,\nwir erlauben uns, folgende Leistungen in Rechnung zu stellen:' %></textarea>
            </div>
          </div>
        </div>

        <!-- PDF-Fußzeile & AGB -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">📃 Fußzeile & AGB</h2>
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                PDF-Fußzeile <span class="text-slate-400 font-normal">(erscheint am Ende jedes PDFs, z.B. Hinweis auf Datenschutz)</span>
              </label>
              <textarea name="pdf_footer_text" rows="2" placeholder="z.B. Alle Preise zzgl. gesetzl. MwSt. · Es gelten unsere AGB."
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500"><%= firma.pdf_footer_text || '' %></textarea>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                AGB-Text <span class="text-slate-400 font-normal">(erscheint als separate Sektion am Ende des PDFs)</span>
              </label>
              <textarea name="pdf_agb_text" rows="5" placeholder="Hier Ihre Allgemeinen Geschäftsbedingungen eingeben…"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500"><%= firma.pdf_agb_text || '' %></textarea>
            </div>
          </div>
        </div>

        <div class="flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 PDF-Einstellungen speichern
          </button>
        </div>
      </form>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: ARBEITSZEIT                                                    -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <% if (tab === 'worktime') { %>
      <form action="/admin/panel/worktime" method="POST" class="space-y-6">

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">⏱️ Soll-Stunden & Urlaub</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Arbeitsstunden pro Tag <span class="text-slate-400 font-normal">(Basis für Überstunden-Berechnung)</span>
              </label>
              <input type="number" name="work_hours_per_day" value="<%= firma.work_hours_per_day || 8 %>"
                min="1" max="24" step="0.5"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Urlaubstage pro Jahr <span class="text-slate-400 font-normal">(Standard für neue Mitarbeiter)</span>
              </label>
              <input type="number" name="vacation_days_default" value="<%= firma.vacation_days_default || 30 %>"
                min="1" max="365"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">☕ Automatischer Pausenabzug</h2>
          <p class="text-xs text-slate-400 mb-4">Pause wird automatisch abgezogen wenn der Arbeitstag länger ist als X Stunden. <strong>0 = deaktiviert.</strong></p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Pause abziehen (Minuten)</label>
              <input type="number" name="break_auto_minutes" value="<%= firma.break_auto_minutes || 0 %>"
                min="0" max="120" step="5" placeholder="0 = deaktiviert"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Abziehen wenn Arbeitstag > X Stunden</label>
              <input type="number" name="break_trigger_hours" value="<%= firma.break_trigger_hours || 6 %>"
                min="1" max="12" step="0.5"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">🗓️ Feiertags-Region</h2>
          <div>
            <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-2">Bundesland (für Feiertagsberechnung)</label>
            <select name="holiday_region"
              class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              <% const regions = ['NRW','Bayern','Baden-Württemberg','Berlin','Brandenburg','Bremen','Hamburg','Hessen','Mecklenburg-Vorpommern','Niedersachsen','Rheinland-Pfalz','Saarland','Sachsen','Sachsen-Anhalt','Schleswig-Holstein','Thüringen','Österreich','Schweiz']; %>
              <% for (const r of regions) { %>
                <option value="<%= r %>" <%= firma.holiday_region === r ? 'selected' : '' %>><%= r %></option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Arbeitszeit-Einstellungen speichern
          </button>
        </div>
      </form>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: STEMPELUHR                                                     -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <% if (tab === 'stampclock') { %>
      <form action="/admin/panel/stampclock" method="POST" class="space-y-6">

        <!-- Allgemeine Schalter -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-1 border-b dark:border-slate-700 pb-2">🕐 Stempeluhr-Verhalten</h2>
          <p class="text-xs text-slate-400 mb-5">Steuert, wie und wann Mitarbeiter stempeln dürfen.</p>

          <div class="space-y-3">

            <%
              const stampToggles = [
                { key: 'stamp_require_gps',      label: '📍 GPS-Standort beim Stempeln erforderlich',        desc: 'Mitarbeiter müssen ihren Standort freigeben, bevor sie einstempeln können.' },
                { key: 'stamp_allow_project',    label: '🏗️ Baustellen-Stempeln aktiviert',                  desc: 'Mitarbeiter können beim Stempeln ein Projekt / eine Baustelle auswählen.' },
                { key: 'stamp_geofence_enabled', label: '📡 Geo-Fencing aktiv (Baustellen-Erkennung)',        desc: 'Erkennt automatisch ob sich der Mitarbeiter auf einer Baustelle befindet und schlägt das Projekt vor.' },
                { key: 'stamp_allow_note',       label: '📝 Tätigkeits-Notiz beim Stempeln erlaubt',          desc: 'Mitarbeiter können beim Stempeln eine Notiz / Tätigkeit eingeben.' },
                { key: 'stamp_allow_switch',     label: '🔄 Baustellen-Wechsel-Funktion aktiviert',           desc: 'Erlaubt das direkte Wechseln zwischen Projekten ohne manuelles Aus-/Einstempeln.' },
                { key: 'stamp_admin_no_gps',     label: '🛡️ Admins sind von GPS-Pflicht ausgenommen',         desc: 'Admins und Chefs können ohne GPS-Standort stempeln (aktuelles Verhalten).' },
              ];
            %>
            <% for (const t of stampToggles) { %>
              <label class="flex items-center justify-between gap-4 p-4 rounded-xl border dark:border-slate-600 cursor-pointer
                hover:bg-slate-50 dark:hover:bg-slate-700/50 transition">
                <div>
                  <p class="text-sm font-semibold text-slate-700 dark:text-slate-200"><%= t.label %></p>
                  <p class="text-xs text-slate-400"><%= t.desc %></p>
                </div>
                <div class="relative shrink-0">
                  <input type="hidden" name="<%= t.key %>" value="false">
                  <input type="checkbox" name="<%= t.key %>" value="true"
                    <%= firma[t.key] === 'false' ? '' : 'checked' %>
                    class="sr-only peer" id="stamp_<%= t.key %>">
                  <label for="stamp_<%= t.key %>"
                    class="block w-11 h-6 rounded-full cursor-pointer transition
                      bg-slate-200 dark:bg-slate-600 peer-checked:bg-blue-600 relative
                      after:content-[''] after:absolute after:top-0.5 after:left-0.5
                      after:bg-white after:rounded-full after:h-5 after:w-5 after:transition
                      peer-checked:after:translate-x-5">
                  </label>
                </div>
              </label>
            <% } %>
          </div>
        </div>

        <!-- Firmen-Standort für Geo-Fencing -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-1 border-b dark:border-slate-700 pb-2">📍 Firmen-Standort (Geo-Fencing)</h2>
          <p class="text-xs text-slate-400 mb-5">Mitarbeiter dürfen nur im Umkreis des Firmenstandorts oder einer Baustelle einstempeln. Koordinaten findest du z.B. bei Google Maps (Rechtsklick → Koordinaten kopieren).</p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Breitengrad (Latitude)</label>
              <input type="text" name="firm_lat" value="<%= firma.firm_lat || process.env.FIRM_LAT || '' %>"
                placeholder="z.B. 51.3069467"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Längengrad (Longitude)</label>
              <input type="text" name="firm_lng" value="<%= firma.firm_lng || process.env.FIRM_LNG || '' %>"
                placeholder="z.B. 6.9483845"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Erlaubter Radius (Meter)</label>
              <input type="number" name="firm_radius" value="<%= firma.firm_radius || process.env.FIRM_RADIUS_METERS || 300 %>"
                min="50" max="5000" step="10"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              <p class="text-xs text-slate-400 mt-1">Standard: 300 m</p>
            </div>
          </div>
          <% if (process.env.FIRM_LAT) { %>
            <div class="mt-4 bg-slate-50 dark:bg-slate-700/30 rounded-lg px-4 py-2.5 text-xs text-slate-500 dark:text-slate-400">
              ℹ️ Firmen-Koordinaten sind per <code>FIRM_LAT / FIRM_LNG / FIRM_RADIUS_METERS</code> in der <code>.env</code> gesetzt – diese haben Vorrang gegenüber den hier eingetragenen Werten.
            </div>
          <% } %>
        </div>

        <!-- Hinweis-Box -->
        <div class="bg-slate-50 dark:bg-slate-700/30 rounded-xl border dark:border-slate-600 p-4 text-xs text-slate-500 dark:text-slate-400">
          <strong>Hinweis:</strong> Deaktivierte Optionen werden sofort wirksam. GPS-Pflicht und Geo-Fencing gelten nur für Mitarbeiter (EMPLOYEE) – Admins und Chefs sind standardmäßig ausgenommen (sofern der Schalter oben aktiv ist).
        </div>

        <div class="flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Stempeluhr-Einstellungen speichern
          </button>
        </div>
      </form>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: AUFTRÄGE & PROJEKTE                                            -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <% if (tab === 'projects') { %>
      <form action="/admin/panel/projects" method="POST" class="space-y-6">

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">🏗️ Auftrags-Einstellungen</h2>
          <div class="space-y-5">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Auftragsnummer-Prefix <span class="text-slate-400 font-normal">(wird bei zukünftiger Auto-Nummerierung genutzt)</span>
              </label>
              <input type="text" name="project_number_prefix" value="<%= firma.project_number_prefix || 'BAUS' %>" maxlength="10"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Standard-Projektstatus bei Neuanlage</label>
              <select name="default_project_status"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
                <% for (const s of ['In Planung','Aktiv','Angefragt','Pausiert','Abgeschlossen']) { %>
                  <option value="<%= s %>" <%= firma.default_project_status === s ? 'selected' : '' %>><%= s %></option>
                <% } %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Auto-Archivierung nach X Tagen <span class="text-slate-400 font-normal">(0 = deaktiviert)</span>
              </label>
              <input type="number" name="archive_after_days" value="<%= firma.archive_after_days || 180 %>"
                min="0" max="3650"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              <p class="text-xs text-slate-400 mt-1">Abgeschlossene Aufträge die älter als X Tage sind werden automatisch archiviert. 0 = nie archivieren.</p>
            </div>
          </div>
        </div>

        <div class="flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Auftrags-Einstellungen speichern
          </button>
        </div>
      </form>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: SICHERHEIT                                                     -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <% if (tab === 'security') { %>
      <form action="/admin/panel/security" method="POST" class="space-y-6">

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">🔒 Sicherheits-Einstellungen</h2>
          <div class="space-y-5">

            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Session-Timeout (Minuten) <span class="text-slate-400 font-normal">(0 = niemals automatisch abmelden)</span>
              </label>
              <input type="number" name="session_timeout_minutes" value="<%= firma.session_timeout_minutes || 480 %>"
                min="0" max="10080"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              <p class="text-xs text-slate-400 mt-1">Standard: 480 Min. (8 Stunden). Empfehlung: 60–480 Min.</p>
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Max. Login-Fehlversuche <span class="text-slate-400 font-normal">(Rate-Limit vor temporärer Sperrung)</span>
              </label>
              <input type="number" name="max_login_attempts" value="<%= firma.max_login_attempts || 10 %>"
                min="3" max="50"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">
                Mindest-Passwortlänge <span class="text-slate-400 font-normal">(gilt bei Passwort-Vergabe)</span>
              </label>
              <input type="number" name="min_password_length" value="<%= firma.min_password_length || 6 %>"
                min="4" max="32"
                class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
            </div>

          </div>
        </div>

        <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-300 dark:border-amber-700 rounded-xl px-5 py-3 text-sm text-amber-800 dark:text-amber-300 flex items-start gap-3">
          <span class="text-xl shrink-0">⚠️</span>
          <div>
            Die Session-Timeout-Einstellung wird clientseitig (JavaScript) umgesetzt. Für serverseitige Token-Ablaufzeiten muss <code>JWT_SECRET</code> mit korrekter Ablaufzeit konfiguriert werden.
          </div>
        </div>

        <div class="flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Sicherheits-Einstellungen speichern
          </button>
        </div>
      </form>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: DASHBOARD KPIs                                                 -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <% if (tab === 'dashboard') { %>
      <form action="/admin/panel/dashboard" method="POST" class="space-y-6">

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-1 border-b dark:border-slate-700 pb-2">📊 Dashboard KPI-Schwellenwerte</h2>
          <p class="text-xs text-slate-400 mb-5">Ab diesen Werten wechselt die Farbe der Dashboard-Karten von grau → gelb → rot.</p>

          <div class="space-y-6">

            <!-- Überfällige Rechnungen -->
            <div class="bg-slate-50 dark:bg-slate-700/30 rounded-xl p-4 border dark:border-slate-600">
              <p class="text-sm font-semibold text-slate-700 dark:text-slate-200 mb-3">🧾 Überfällige Rechnungen</p>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium text-slate-500 mb-1">🟡 Ab dieser Anzahl: Warnung (gelb)</label>
                  <input type="number" name="kpi_overdue_warn" value="<%= firma.kpi_overdue_warn || 3 %>" min="1" max="100"
                    class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm focus:ring-2 focus:ring-yellow-400">
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-500 mb-1">🔴 Ab dieser Anzahl: Kritisch (rot)</label>
                  <input type="number" name="kpi_overdue_danger" value="<%= firma.kpi_overdue_danger || 6 %>" min="1" max="100"
                    class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm focus:ring-2 focus:ring-red-400">
                </div>
              </div>
            </div>

            <!-- Offene Aufgaben -->
            <div class="bg-slate-50 dark:bg-slate-700/30 rounded-xl p-4 border dark:border-slate-600">
              <p class="text-sm font-semibold text-slate-700 dark:text-slate-200 mb-3">✅ Offene Aufgaben / Mängel</p>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium text-slate-500 mb-1">🟡 Ab dieser Anzahl: Warnung (gelb)</label>
                  <input type="number" name="kpi_tasks_warn" value="<%= firma.kpi_tasks_warn || 5 %>" min="1" max="100"
                    class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm focus:ring-2 focus:ring-yellow-400">
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-500 mb-1">🔴 Ab dieser Anzahl: Kritisch (rot)</label>
                  <input type="number" name="kpi_tasks_danger" value="<%= firma.kpi_tasks_danger || 10 %>" min="1" max="100"
                    class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm focus:ring-2 focus:ring-red-400">
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Vorschau -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">👁️ Live-Vorschau</h2>
          <div class="grid grid-cols-2 gap-4">
            <div id="prevOverdue" class="p-4 rounded-xl border-l-4 border-gray-300 bg-gray-50 dark:bg-slate-700 transition">
              <p class="text-xs text-gray-400 font-semibold uppercase">Überfällige Rechnungen</p>
              <input type="number" id="previewOverdueVal" value="0" min="0"
                oninput="updateKpiPreview()"
                class="text-2xl font-bold w-20 bg-transparent border-none focus:outline-none text-gray-800 dark:text-gray-100">
            </div>
            <div id="prevTasks" class="p-4 rounded-xl border-l-4 border-gray-300 bg-gray-50 dark:bg-slate-700 transition">
              <p class="text-xs text-gray-400 font-semibold uppercase">Offene Aufgaben</p>
              <input type="number" id="previewTasksVal" value="0" min="0"
                oninput="updateKpiPreview()"
                class="text-2xl font-bold w-20 bg-transparent border-none focus:outline-none text-gray-800 dark:text-gray-100">
            </div>
          </div>
          <p class="text-xs text-slate-400 mt-3">Gib oben Testwerte ein um die Farblogik zu sehen.</p>
        </div>

        <div class="flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 KPI-Schwellen speichern
          </button>
        </div>
      </form>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: ZUGRIFF & ROLLEN                                              -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <% if (tab === 'access') { %>
      <div class="space-y-6">

        <!-- Schnell-Links -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">🔐 Schnell-Links</h2>
          <div class="flex flex-wrap gap-3">
            <a href="/admin/users" class="px-4 py-2 rounded-lg border dark:border-slate-600 bg-slate-50 dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-sm text-slate-700 dark:text-slate-200 transition">👥 Mitarbeiter-Logins</a>
            <a href="/admin/timetracking" class="px-4 py-2 rounded-lg border dark:border-slate-600 bg-slate-50 dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-sm text-slate-700 dark:text-slate-200 transition">📋 Arbeitszeiten</a>
            <a href="/admin/company-settings" class="px-4 py-2 rounded-lg border dark:border-slate-600 bg-slate-50 dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-sm text-slate-700 dark:text-slate-200 transition">🏢 Firmendaten</a>
          </div>
        </div>

        <!-- Berechtigungs-Matrix -->
        <form action="/admin/panel/access" method="POST">
        <%
          // Bereiche: [key, label, chef_fest, admin_default, employee_default]
          // chef_fest = CHEF hat immer Zugriff (nicht änderbar)
          const accessAreas = [
            { key: 'projects',     label: '🏗️ Aufträge & Baustellen',    empDef: true  },
            { key: 'calendar',     label: '📅 Kalender',                  empDef: true  },
            { key: 'timetracking', label: '⏱️ Zeiterfassung',             empDef: true  },
            { key: 'vacations',    label: '🌴 Urlaub & Abwesenheit',      empDef: true  },
            { key: 'customers',    label: '👤 Kunden',                    empDef: false },
            { key: 'documents',    label: '📋 Angebote & Rechnungen',     empDef: false },
            { key: 'articles',     label: '📦 Artikelstamm',              empDef: false },
            { key: 'map',          label: '🗺️ Baustellen-Karte',          empDef: false },
            { key: 'treppe',       label: '🪜 Treppen-Rechner',           empDef: false },
            { key: 'steel_calc',   label: '⚖️ Stahl-Rechner',             empDef: false },
            { key: 'money',        label: '💰 Geldbeträge & Summen',      empDef: false },
          ];
          // Hilfsfunktion: Wert aus DB lesen mit Fallback auf Default
          function permVal(key, role, def) {
            const k = 'perm_' + role + '_' + key;
            return firma[k] !== undefined ? firma[k] !== 'false' : def;
          }
        %>

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden">
          <div class="px-5 py-4 border-b dark:border-slate-700 flex items-center justify-between">
            <div>
              <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100">📋 Berechtigungs-Matrix</h2>
              <p class="text-xs text-slate-400 mt-0.5">Legt fest, welche Bereiche ADMIN und EMPLOYEE sehen und nutzen dürfen. CHEF hat immer vollen Zugriff.</p>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-slate-50 dark:bg-slate-700/50 border-b dark:border-slate-700">
                  <th class="text-left py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wide w-1/2">Bereich</th>
                  <th class="text-center py-3 px-4 text-xs font-semibold text-yellow-600 uppercase tracking-wide w-[16%]">👑 CHEF</th>
                  <th class="text-center py-3 px-4 text-xs font-semibold text-blue-600 uppercase tracking-wide w-[17%]">🛠️ ADMIN</th>
                  <th class="text-center py-3 px-4 text-xs font-semibold text-slate-500 uppercase tracking-wide w-[17%]">👷 EMPLOYEE</th>
                </tr>
              </thead>
              <tbody class="divide-y dark:divide-slate-700">
                <% for (const area of accessAreas) { %>
                <%
                  const adminOn = permVal(area.key, 'admin', true);
                  const empOn   = permVal(area.key, 'employee', area.empDef);
                  const isMoney = area.key === 'money';
                %>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 <%= isMoney ? 'bg-yellow-50/50 dark:bg-yellow-900/10' : '' %>">
                  <td class="py-3 px-4 text-slate-700 dark:text-slate-300 font-medium"><%= area.label %></td>

                  <!-- CHEF: immer ✅, nicht änderbar -->
                  <td class="py-3 px-4 text-center text-lg">✅</td>

                  <!-- ADMIN Toggle -->
                  <td class="py-3 px-4 text-center">
                    <div class="inline-flex items-center justify-center">
                      <input type="hidden" name="perm_admin_<%= area.key %>" value="false">
                      <input type="checkbox" name="perm_admin_<%= area.key %>" value="true"
                        id="adm_<%= area.key %>" <%= adminOn ? 'checked' : '' %>
                        class="sr-only peer">
                      <label for="adm_<%= area.key %>"
                        class="block w-10 h-5 rounded-full cursor-pointer transition
                          bg-slate-200 dark:bg-slate-600 peer-checked:bg-blue-600 relative
                          after:content-[''] after:absolute after:top-0.5 after:left-0.5
                          after:bg-white after:rounded-full after:h-4 after:w-4 after:transition
                          peer-checked:after:translate-x-5">
                      </label>
                    </div>
                  </td>

                  <!-- EMPLOYEE Toggle -->
                  <td class="py-3 px-4 text-center">
                    <% if (isMoney) { %>
                      <!-- Geldbeträge für EMPLOYEE nie freischaltbar -->
                      <span class="text-lg text-slate-300 dark:text-slate-600" title="Nicht konfigurierbar">🔒</span>
                      <input type="hidden" name="perm_employee_<%= area.key %>" value="false">
                    <% } else { %>
                    <div class="inline-flex items-center justify-center">
                      <input type="hidden" name="perm_employee_<%= area.key %>" value="false">
                      <input type="checkbox" name="perm_employee_<%= area.key %>" value="true"
                        id="emp_<%= area.key %>" <%= empOn ? 'checked' : '' %>
                        class="sr-only peer">
                      <label for="emp_<%= area.key %>"
                        class="block w-10 h-5 rounded-full cursor-pointer transition
                          bg-slate-200 dark:bg-slate-600 peer-checked:bg-green-500 relative
                          after:content-[''] after:absolute after:top-0.5 after:left-0.5
                          after:bg-white after:rounded-full after:h-4 after:w-4 after:transition
                          peer-checked:after:translate-x-5">
                      </label>
                    </div>
                    <% } %>
                  </td>
                </tr>
                <% } %>

                <!-- Feste Admin-Bereiche (immer Admin/Chef, nie Employee) -->
                <% const fixedAdminAreas = [
                    { label: '👥 Mitarbeiter-Logins',      note: 'Nur ADMIN & CHEF' },
                    { label: '📊 Arbeitszeiten aller MA',  note: 'Nur ADMIN & CHEF' },
                    { label: '🏢 Firmendaten',              note: 'Nur ADMIN & CHEF' },
                    { label: '⚙️ Admin-Panel',              note: 'Nur ADMIN & CHEF' },
                  ]; %>
                <% for (const f of fixedAdminAreas) { %>
                <tr class="bg-slate-50/50 dark:bg-slate-700/20 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                  <td class="py-3 px-4 text-slate-500 dark:text-slate-400"><%= f.label %></td>
                  <td class="py-3 px-4 text-center text-lg">✅</td>
                  <td class="py-3 px-4 text-center text-lg">✅</td>
                  <td class="py-3 px-4 text-center">
                    <span class="text-lg text-slate-300 dark:text-slate-600" title="<%= f.note %>">🔒</span>
                  </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-700/30 rounded-xl border dark:border-slate-600 p-4 text-xs text-slate-500 dark:text-slate-400">
          <strong>Hinweis:</strong> Änderungen gelten sofort nach dem Speichern. Bereiche die für ADMIN deaktiviert sind, werden auch für EMPLOYEE gesperrt. 🔒 = systemseitig fest gesperrt, nicht änderbar.
        </div>

        <div class="flex justify-end">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
            💾 Berechtigungen speichern
          </button>
        </div>
        </form>

      </div>
      <% } %>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- TAB: SYSTEM-INFO                                                   -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <% if (tab === 'info') { %>
      <div class="space-y-6">

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">ℹ️ System-Information</h2>
          <dl class="space-y-3">
            <% const sysInfo = [
              ['Node.js Version',    process.version],
              ['Umgebung',           process.env.NODE_ENV || 'development'],
              ['Datenbank',          process.env.DATABASE_URL ? 'PostgreSQL (Render)' : 'SQLite (lokal)'],
              ['Cloudinary',         process.env.CLOUDINARY_CLOUD_NAME ? '✅ Konfiguriert (' + process.env.CLOUDINARY_CLOUD_NAME + ')' : '❌ Nicht konfiguriert'],
              ['Backup-E-Mail',      (process.env.BACKUP_EMAIL || firma.smtp_backup_email) ? '✅ ' + (process.env.BACKUP_EMAIL || firma.smtp_backup_email) : '❌ Nicht gesetzt'],
              ['SMTP',               (process.env.SMTP_USER || firma.smtp_user) ? '✅ ' + (process.env.SMTP_USER || firma.smtp_user) : '❌ Nicht konfiguriert'],
              ['KI (OpenAI)',        process.env.OPENAI_API_KEY ? '✅ API-Key gesetzt' : '❌ Kein API-Key'],
            ]; %>
            <% for (const [label, val] of sysInfo) { %>
              <div class="flex items-start gap-4 py-2 border-b dark:border-slate-700 last:border-0">
                <dt class="w-48 shrink-0 text-xs font-medium text-slate-500 uppercase tracking-wide pt-0.5"><%= label %></dt>
                <dd class="text-sm text-slate-700 dark:text-slate-300 font-mono"><%= val %></dd>
              </div>
            <% } %>
          </dl>
        </div>

        <!-- Backup -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-3 border-b dark:border-slate-700 pb-2">🗄️ Datenbank-Backup</h2>
          <%
            const _backupEmail = process.env.BACKUP_EMAIL || firma.smtp_backup_email || '';
            const _smtpUser    = process.env.SMTP_USER    || firma.smtp_user         || '';
          %>
          <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center mb-4">
            <div class="flex-1 text-sm text-slate-500 dark:text-slate-400">
              <% if (!_backupEmail || !_smtpUser) { %>
                <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-300 rounded-lg px-4 py-2.5 text-xs text-amber-800 dark:text-amber-300">
                  ⚠️ <strong>BACKUP_EMAIL</strong> oder <strong>SMTP_USER / SMTP_PASS</strong> nicht gesetzt – Backup deaktiviert.
                </div>
              <% } else { %>
                <div class="bg-green-50 dark:bg-green-900/20 border border-green-300 rounded-lg px-4 py-2.5 text-xs text-green-800 dark:text-green-300">
                  ✅ Backup täglich um Mitternacht → <strong><%= _backupEmail %></strong>
                </div>
              <% } %>
            </div>
            <form action="/admin/backup/run" method="POST"
              onsubmit="return confirm('Jetzt sofort ein Backup erstellen?')">
              <button type="submit"
                class="bg-slate-700 hover:bg-slate-600 text-white text-sm font-medium px-4 py-2.5 rounded-lg transition whitespace-nowrap">
                🗄️ Backup jetzt erstellen
              </button>
            </form>
          </div>

          <!-- SMTP & Backup konfigurieren -->
          <form action="/admin/panel/notifications" method="POST" class="space-y-4 border-t dark:border-slate-700 pt-4">
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide">✉️ E-Mail / SMTP konfigurieren</p>
            <% if (process.env.SMTP_USER) { %>
              <div class="bg-slate-50 dark:bg-slate-700/30 rounded-lg px-4 py-2.5 text-xs text-slate-500 dark:text-slate-400">
                ℹ️ SMTP ist per Umgebungsvariable gesetzt – Änderungen hier haben keine Wirkung, solange <code>SMTP_USER</code> in der <code>.env</code> gesetzt ist.
              </div>
            <% } %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Backup-E-Mail <span class="text-slate-400">(Empfänger)</span></label>
                <input type="email" name="smtp_backup_email" value="<%= firma.smtp_backup_email || '' %>"
                  placeholder="chef@meine-firma.de"
                  class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">SMTP-Host</label>
                <input type="text" name="smtp_host" value="<%= firma.smtp_host || '' %>"
                  placeholder="smtp.gmail.com"
                  class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">SMTP-Port</label>
                <input type="number" name="smtp_port" value="<%= firma.smtp_port || '587' %>"
                  placeholder="587"
                  class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">SMTP-Benutzername <span class="text-slate-400">(Absender)</span></label>
                <input type="email" name="smtp_user" value="<%= firma.smtp_user || '' %>"
                  placeholder="absender@gmail.com"
                  class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
              </div>
              <div class="sm:col-span-2">
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">SMTP-Passwort <span class="text-slate-400">(App-Passwort)</span></label>
                <input type="password" name="smtp_pass" value="<%= firma.smtp_pass || '' %>"
                  placeholder="Leer lassen um nicht zu ändern"
                  autocomplete="new-password"
                  class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500">
                <p class="text-xs text-slate-400 mt-1">Leer lassen, um das gespeicherte Passwort beizubehalten.</p>
              </div>
            </div>
            <div class="flex justify-end">
              <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition">
                💾 E-Mail-Einstellungen speichern
              </button>
            </div>
          </form>
        </div>

        <!-- Quick-Links -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-5 md:p-6">
          <h2 class="text-base font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">🔗 Schnell-Links</h2>
          <div class="flex flex-wrap gap-3">
            <% const links = [
              ['/admin/users',            '👥 Mitarbeiter'],
              ['/admin/timetracking',     '📋 Arbeitszeiten'],
              ['/admin/company-settings', '🏢 Firmendaten'],
              ['/customers',              '👤 Kunden'],
              ['/articles',               '📦 Artikelstamm'],
              ['/documents/invoices',     '🧾 Rechnungen'],
              ['/documents/offers',       '📋 Angebote'],
            ]; %>
            <% for (const [href, label] of links) { %>
              <a href="<%= href %>"
                class="px-4 py-2 rounded-lg border dark:border-slate-600 bg-slate-50 dark:bg-slate-700 hover:bg-slate-100 dark:hover:bg-slate-600 text-sm text-slate-700 dark:text-slate-200 transition">
                <%= label %>
              </a>
            <% } %>
          </div>
        </div>

      </div>
      <% } %>

    </div><!-- /max-w-5xl -->
</main>

<script>
  // Farb-Vorschau Live-Update
  function updatePreview(id, value) {
    const el = document.getElementById(id);
    if (el) el.style.background = value;
  }

  // Schnell-Vorlage anwenden
  function applyPreset(primary, sidebarBg, sidebarText, sidebarHover, pageBg, topbarBg) {
    setColorInput('color_primary',      primary);
    setColorInput('color_sidebar_bg',   sidebarBg);
    setColorInput('color_sidebar_text', sidebarText);
    setColorInput('color_sidebar_hover',sidebarHover);
    setColorInput('color_page_bg',      pageBg);
    setColorInput('color_topbar_bg',    topbarBg);
  }
  function setColorInput(name, value) {
    const inp = document.querySelector(`input[name="${name}"]`);
    if (!inp) return;
    inp.value = value;
    inp.dispatchEvent(new Event('input'));
  }

  // Sidebar-Modus: Logo-Höhe ein-/ausblenden
  document.querySelectorAll('input[name="sidebar_modus"]').forEach(r => {
    r.addEventListener('change', function() {
      const wrap = document.getElementById('heightWrap');
      if (wrap) wrap.classList.toggle('hidden', this.value !== 'logo');
    });
  });

  // KPI-Vorschau: Farblogik Live-Demo
  function updateKpiPreview() {
    const ov   = parseInt(document.getElementById('previewOverdueVal')?.value || 0);
    const ta   = parseInt(document.getElementById('previewTasksVal')?.value   || 0);
    const owW  = parseInt(document.querySelector('input[name="kpi_overdue_warn"]')?.value   || 3);
    const owD  = parseInt(document.querySelector('input[name="kpi_overdue_danger"]')?.value || 6);
    const twW  = parseInt(document.querySelector('input[name="kpi_tasks_warn"]')?.value     || 5);
    const twD  = parseInt(document.querySelector('input[name="kpi_tasks_danger"]')?.value   || 10);

    const colorClass = (val, warn, danger) =>
      val >= danger ? 'border-red-500 bg-red-50'
      : val >= warn ? 'border-yellow-400 bg-yellow-50'
      : 'border-gray-300 bg-gray-50';

    const ovEl = document.getElementById('prevOverdue');
    const taEl = document.getElementById('prevTasks');
    if (ovEl) ovEl.className = 'p-4 rounded-xl border-l-4 transition ' + colorClass(ov, owW, owD);
    if (taEl) taEl.className = 'p-4 rounded-xl border-l-4 transition ' + colorClass(ta, twW, twD);
  }

  // Session-Timeout clientseitig (aus Admin-Panel Einstellung)
  (function() {
    const mins = parseInt('<%= typeof firma !== "undefined" && firma.session_timeout_minutes ? firma.session_timeout_minutes : 0 %>');
    if (!mins || mins <= 0) return;
    let timer = setTimeout(() => {
      alert('Deine Sitzung ist abgelaufen. Du wirst jetzt abgemeldet.');
      window.location.href = '/logout';
    }, mins * 60 * 1000);
    ['click','keydown','scroll','mousemove'].forEach(ev =>
      document.addEventListener(ev, () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          alert('Deine Sitzung ist abgelaufen. Du wirst jetzt abgemeldet.');
          window.location.href = '/logout';
        }, mins * 60 * 1000);
      }, { passive: true })
    );
  })();
</script>
