<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Heute – <%= firma.nameKurz %></title>
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/img/icon-192.png">
  <meta name="theme-color" content="<%= firma.color_primary || '#2563eb' %>">
  <script>
    (function() {
      try {
        var d = localStorage.getItem('darkMode');
        if (d === 'true' || (d === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    })();
  </script>
  <style>
    * { box-sizing: border-box; }
    body { margin:0; font-family: -apple-system, 'Inter', system-ui, sans-serif; background:#f1f5f9; color:#1e293b; min-height:100vh; }
    html.dark body { background:#0f172a; color:#e2e8f0; }
    .topbar { background: var(--primary, <%= firma.color_primary || '#2563eb' %>); color:#fff; padding:1rem 1rem 1.25rem; }
    .topbar h1 { margin:0; font-size:1.15rem; font-weight:800; }
    .topbar p { margin:.15rem 0 0; font-size:.8rem; opacity:.9; }
    .wrap { padding: .9rem; max-width:560px; margin:0 auto; }
    .card { background:#fff; border-radius:14px; padding:1rem; margin-bottom:.75rem; box-shadow:0 1px 4px rgba(0,0,0,.06); }
    html.dark .card { background:#1e293b; }
    .card h2 { margin:0 0 .3rem; font-size:1rem; font-weight:700; }
    .card .meta { font-size:.8rem; color:#64748b; margin:.15rem 0; }
    html.dark .card .meta { color:#94a3b8; }
    .badge { display:inline-block; font-size:.7rem; font-weight:600; padding:.15rem .5rem; border-radius:999px; background:#dbeafe; color:#1e40af; }
    html.dark .badge { background:#1e3a5f; color:#93c5fd; }
    .actions { display:flex; gap:.5rem; margin-top:.7rem; flex-wrap:wrap; }
    .btn { flex:1; min-width:110px; text-align:center; padding:.6rem .5rem; border-radius:10px; font-size:.8rem; font-weight:600; text-decoration:none; border:none; }
    .btn-primary { background: var(--primary, <%= firma.color_primary || '#2563eb' %>); color:#fff; }
    .btn-secondary { background:#f1f5f9; color:#334155; }
    html.dark .btn-secondary { background:#334155; color:#e2e8f0; }
    .empty { text-align:center; padding:3rem 1rem; color:#94a3b8; }
    .empty .i { width:2.5rem; height:2.5rem; margin-bottom:.5rem; color:#cbd5e1; }
    .i { width:1em; height:1em; display:inline; vertical-align:-0.15em; margin-right:.3em; }
    .topbar h1 .i { width:1.1rem; height:1.1rem; }
    .backlink { display:inline-block; color:#fff; opacity:.85; font-size:.8rem; text-decoration:none; margin-top:.5rem; }
  </style>
</head>
<body>
  <div class="topbar">
    <h1><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="10" height="18" rx="1"/><path d="M14 21v-6h4v6M8 7h.01M11 7h.01M8 11h.01M11 11h.01"/></svg>Heutige Baustellen</h1>
    <p><%= new Date(todayStr).toLocaleDateString('de-DE', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' }) %></p>
    <a class="backlink" href="/">← zur App</a>
  </div>

  <div class="wrap">
    <% if (!sites || sites.length === 0) { %>
      <div class="empty">
        <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h13v6a4 4 0 01-4 4H8a4 4 0 01-4-4V9z"/><path d="M17 10h1.5a2.5 2.5 0 010 5H17M8 3c0 1-1 1-1 2M12 3c0 1-1 1-1 2"/></svg>
        <p>Für heute ist keine Baustelle eingeplant.</p>
      </div>
    <% } else { %>
      <% for (const s of sites) { %>
      <div class="card">
        <h2><%= s.project_title || 'Ohne Projekt' %></h2>
        <% if (isAdmin && s.username) { %><p class="meta"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 016-6h4a6 6 0 016 6v1"/></svg><%= s.username %></p><% } %>
        <% if (s.company_name) { %><p class="meta"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="1"/><path d="M9 22v-4h6v4M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1"/></svg><%= s.company_name %></p><% } %>
        <% if (s.street || s.city) { %>
          <p class="meta"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11a7 7 0 0114 0c0 4.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg><%= [s.street, [s.zip, s.city].filter(Boolean).join(' ')].filter(Boolean).join(', ') %></p>
        <% } %>
        <% if (s.site_note) { %><p class="meta"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg><%= s.site_note %></p><% } %>
        <% if (s.note) { %><p class="meta"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg><%= s.note %></p><% } %>
        <% if (s.status) { %><span class="badge"><%= s.status %></span><% } %>

        <div class="actions">
          <% if (s.site_lat && s.site_lng) { %>
            <a class="btn btn-primary" href="https://www.google.com/maps/dir/?api=1&destination=<%= s.site_lat %>,<%= s.site_lng %>" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>Navigation</a>
          <% } else if (s.street || s.city) { %>
            <a class="btn btn-primary" href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent([s.street, s.zip, s.city].filter(Boolean).join(' ')) %>" target="_blank" rel="noopener"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>Navigation</a>
          <% } %>
          <% if (s.phone) { %>
            <a class="btn btn-secondary" href="tel:<%= s.phone.replace(/\s+/g,'') %>"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3.1-8.7A2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .3 2 .6 2.9a2 2 0 01-.4 2.1L8.1 9.9a16 16 0 006 6l1.2-1.2a2 2 0 012.1-.4c.9.3 1.9.5 2.9.6a2 2 0 011.7 2z"/></svg>Anrufen</a>
          <% } %>
          <a class="btn btn-secondary" href="/timetracking"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Stempeln</a>
        </div>
      </div>
      <% } %>
    <% } %>
  </div>

  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
  </script>
</body>
</html>
