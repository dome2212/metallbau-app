<%- include('partials/header') %>

<div class="flex h-screen bg-slate-100 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 min-h-screen pt-16 md:pt-6">
    <header class="bg-white shadow px-4 md:px-6 py-4 flex justify-between items-center mb-6">
      <h1 class="text-xl md:text-2xl font-bold text-slate-800">📋 Arbeitszeiten-Übersicht</h1>
    </header>

    <div class="px-4 md:px-6 max-w-6xl mx-auto w-full space-y-6 pb-6">
      
      <!-- Neuer Bereich: Manueller Zeiteintrag durch Admin -->
      <div class="bg-white rounded-xl shadow p-4 md:p-6 mb-6">
        <h2 class="text-base md:text-lg font-semibold text-slate-800 mb-4">➕ Arbeitszeit manuell erfassen</h2>
        <form method="POST" action="/admin/timetracking/add" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-6 gap-4 items-end">
          
          <!-- Mitarbeiter -->
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 mb-1">Mitarbeiter</label>
            <select name="user_id" required class="w-full border rounded-lg p-2.5 text-sm bg-white">
              <option value="">Bitte wählen...</option>
              <% if (typeof users !== 'undefined' && users.length > 0) { %>
                <% users.forEach(u => { %>
                  <option value="<%= u.id %>"><%= u.username %></option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <!-- Typ (Kommen / Gehen) -->
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 mb-1">Typ</label>
            <select name="type" required class="w-full border rounded-lg p-2.5 text-sm bg-white">
              <option value="IN">Kommen (IN)</option>
              <option value="OUT">Gehen (OUT)</option>
            </select>
          </div>

          <!-- Datum -->
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 mb-1">Datum</label>
            <input type="date" name="date" required value="<%= new Date().toLocaleDateString('sv-SE') %>" class="w-full border rounded-lg p-2.5 text-sm bg-white">
          </div>

          <!-- Uhrzeit -->
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 mb-1">Uhrzeit</label>
            <input type="time" name="time" required value="<%= new Date().toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' }) %>" class="w-full border rounded-lg p-2.5 text-sm bg-white">
          </div>

          <!-- Notiz -->
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 mb-1">Notiz (optional)</label>
            <input type="text" name="note" placeholder="z.B. Kunde / Grund" class="w-full border rounded-lg p-2.5 text-sm bg-white">
          </div>

          <!-- Button -->
          <div>
            <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-medium p-2.5 rounded-lg text-sm transition">
              Eintrag hinzufügen
            </button>
          </div>

        </form>
      </div>

      <!-- Filter-Bereich nach Datum & Mitarbeiter -->
      <div class="bg-white rounded-xl shadow p-4 md:p-6">
        <form method="GET" action="/admin/timetracking" class="flex flex-col sm:flex-row items-end gap-4">
          
          <!-- Mitarbeiter-Filter -->
          <div class="w-full sm:w-auto flex-1">
            <label class="block text-xs md:text-sm font-medium text-slate-700 mb-1">Mitarbeiter auswählen</label>
            <select name="user_id" class="w-full border rounded-lg p-2.5 text-sm bg-white">
              <option value="">Alle Mitarbeiter</option>
              <% if (typeof users !== 'undefined' && users.length > 0) { %>
                <% users.forEach(u => { %>
                  <option value="<%= u.id %>" <%= typeof selectedUserId !== 'undefined' && selectedUserId == u.id ? 'selected' : '' %>>
                    <%= u.username %>
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <!-- Datum-Filter -->
          <div class="w-full sm:w-auto flex-1">
            <label class="block text-xs md:text-sm font-medium text-slate-700 mb-1">Datum auswählen</label>
            <input type="date" name="date" value="<%= typeof selectedDate !== 'undefined' ? selectedDate : '' %>" class="w-full border rounded-lg p-2.5 text-sm bg-white">
          </div>

          <!-- Buttons -->
          <div class="flex flex-wrap gap-2 w-full sm:w-auto">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2.5 rounded-lg text-sm transition flex-1 sm:flex-none">Filtern</button>
            <a href="/admin/timetracking" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-4 py-2.5 rounded-lg text-sm transition text-center flex-1 sm:flex-none">Zurücksetzen</a>
            
            <!-- PDF Download Button -->
            <a href="/admin/timetracking/pdf?user_id=<%= typeof selectedUserId !== 'undefined' ? selectedUserId : '' %>&date=<%= typeof selectedDate !== 'undefined' ? selectedDate : '' %>" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-4 py-2.5 rounded-lg text-sm transition text-center flex-1 sm:flex-none flex items-center justify-center gap-1.5">
              <span>📄 PDF Export</span>
            </a>
          </div>
        </form>
      </div>

      <!-- Tabelle aller Stempel-Einträge -->
      <div class="bg-white rounded-xl shadow overflow-hidden">
        <div class="px-4 md:px-6 py-4 border-b border-slate-200 flex justify-between items-center">
          <h2 class="text-base md:text-lg font-semibold text-slate-800">Erfasste Einträge</h2>
          <span class="text-xs text-slate-500">Datum & Uhrzeit (Lokal)</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-600 min-w-[700px]">
            <thead class="bg-slate-50 text-slate-700 uppercase text-xs">
              <tr>
                <th class="p-4">Datum</th>
                <th class="p-4">Uhrzeit</th>
                <th class="p-4">Mitarbeiter</th>
                <th class="p-4">Aktion</th>
                <th class="p-4">Notiz</th>
                <th class="p-4 text-right">Löschen</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% if (typeof logs !== 'undefined' && logs.length > 0) { %>
                <% logs.forEach(log => { %>
                  <% 
                    let d = new Date(log.timestamp);
                    let formattedDate = d.toLocaleDateString('de-DE');
                    let formattedTime = d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
                  %>
                  <tr class="hover:bg-slate-50">
                    <td class="p-4 font-medium text-slate-800"><%= formattedDate %></td>
                    <td class="p-4 font-semibold text-slate-700"><%= formattedTime %> Uhr</td>
                    <td class="p-4 font-semibold text-slate-800"><%= log.username || 'Unbekannt' %></td>
                    <td class="p-4">
                      <% if (log.type === 'IN') { %>
                        <span class="text-green-600 bg-green-50 px-2.5 py-1 rounded-md text-xs font-semibold">Eingestempelt (IN)</span>
                      <% } else { %>
                        <span class="text-red-600 bg-red-50 px-2.5 py-1 rounded-md text-xs font-semibold">Ausgestempelt (OUT)</span>
                      <% } %>
                    </td>
                    <td class="p-4 text-slate-500 text-xs md:text-sm"><%= log.log_note || log.note || '-' %></td>
                    <td class="p-4 text-right">
                      <form action="/timetracking/admin/delete" method="POST" onsubmit="return confirm('Diesen Stempel-Eintrag wirklich löschen?');" style="display:inline;">
                        <input type="hidden" name="log_id" value="<%= log.id %>">
                        <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-lg text-xs font-semibold transition">
                          🗑️ Löschen
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="p-6 text-center text-slate-400 text-sm">Keine Zeiteinträge für diesen Filter vorhanden.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>

</body>
</html>
