<%- include('partials/header') %>

<div class="flex h-screen bg-gray-100 dark:bg-gray-900 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-gray-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">

    <header class="bg-white dark:bg-slate-800 shadow px-4 md:px-6 py-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3 mb-6">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100">📋 Dokumentenverwaltung</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Rechnungen und Zahlungsstati</p>
      </div>
      <button onclick="document.getElementById('newInvoiceModal').classList.remove('hidden')"
        class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition">
        + Neue Rechnung anlegen
      </button>
    </header>

    <div class="px-4 md:px-6 max-w-7xl mx-auto w-full pb-6 space-y-4">

      <!-- Status-Filter-Tabs -->
      <div class="flex gap-2 border-b dark:border-slate-700 pb-0">
        <span class="px-4 py-2 text-sm font-semibold text-red-600 border-b-2 border-red-500 cursor-pointer">Gesendet</span>
        <span class="px-4 py-2 text-sm font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 cursor-pointer">Bezahlt</span>
        <span class="px-4 py-2 text-sm font-semibold text-red-600 hover:text-red-700 cursor-pointer">Überfällig</span>
      </div>

      <!-- Rechnungs-Tabelle -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse min-w-[500px]">
            <thead class="bg-slate-50 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs uppercase border-b dark:border-slate-600">
              <tr>
                <th class="p-4">Rechnungs-Nr.</th>
                <th class="p-4">Kunde</th>
                <th class="p-4">Datum</th>
                <th class="p-4">Betrag</th>
                <th class="p-4">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
              <% if (invoices && invoices.length > 0) { %>
                <% invoices.forEach(invoice => { %>
                  <tr class="hover:bg-slate-50 dark:hover:bg-slate-700">
                    <td class="p-4 font-semibold text-slate-800 dark:text-gray-100"><%= invoice.invoice_number %></td>
                    <td class="p-4 text-slate-600 dark:text-gray-300"><%= invoice.company_name || invoice.contact_person || 'Unbekannt' %></td>
                    <td class="p-4 text-slate-600 dark:text-gray-300"><%= new Date(invoice.created_at).toLocaleDateString('de-DE') %></td>
                    <td class="p-4 text-slate-600 dark:text-gray-300"><%= parseFloat(invoice.total_amount || 0).toFixed(2) %> €</td>
                    <td class="p-4">
                      <span class="px-2.5 py-1 rounded text-xs font-semibold bg-amber-100 text-amber-800"><%= invoice.status %></span>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="p-6 text-center text-slate-400 dark:text-slate-500 italic text-sm">
                    Noch keine Rechnungen vorhanden.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Modal: Neue Rechnung anlegen -->
<div id="newInvoiceModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-2xl w-full p-4 md:p-6 max-h-[90vh] flex flex-col">

    <div class="flex justify-between items-center mb-4 border-b dark:border-slate-700 pb-3 flex-shrink-0">
      <h3 class="text-lg font-bold text-slate-800 dark:text-gray-100">Neue Rechnung anlegen</h3>
      <button onclick="document.getElementById('newInvoiceModal').classList.add('hidden')"
        class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl font-bold">&times;</button>
    </div>

    <form action="/documents/create-invoice" method="POST" class="space-y-4 overflow-y-auto pr-1">

      <!-- Kunden-Auswahl -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Kunde auswählen *</label>
        <select name="customer_id" required
          class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
          <option value="" disabled selected>Bitte wählen...</option>
          <% if (customers && customers.length > 0) { %>
            <% customers.forEach(customer => { %>
              <option value="<%= customer.id %>">
                <%= customer.company_name ? customer.company_name + ' (' + customer.contact_person + ')' : customer.contact_person %>
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- Artikel-Schnellauswahl -->
      <div class="border-t dark:border-slate-700 pt-3">
        <label class="block text-xs font-bold text-blue-700 dark:text-blue-400 mb-1">📦 Aus Artikelstamm hinzufügen</label>
        <select id="docArticleSelect" onchange="docAddArticle(this)"
          class="w-full border border-blue-200 dark:border-blue-700 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-blue-50/50">
          <option value="">-- Artikel wählen, um ihn als Position anzuhängen --</option>
          <% if (customers && articles && articles.length > 0) { %>
            <% articles.forEach(art => { %>
              <option value="<%= art.id %>"
                data-title="<%= art.title %>"
                data-unit="<%= art.unit %>"
                data-price="<%= art.unit_price %>"
                data-desc="<%= art.description || '' %>">
                <%= art.title %> (<%= parseFloat(art.unit_price || 0).toFixed(2) %> € / <%= art.unit %>)
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- Dynamische Positionsliste -->
      <div class="border-t dark:border-slate-700 pt-3">
        <div class="flex justify-between items-center mb-2">
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">Rechnungspositionen *</label>
          <button type="button" onclick="docAddRow()"
            class="text-xs bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 px-2.5 py-1 rounded font-medium border dark:border-slate-600">
            + Eigene Position
          </button>
        </div>
        <div id="docItemsContainer" class="space-y-3">
          <!-- per JS befüllt -->
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t dark:border-slate-700 flex-shrink-0">
        <button type="button" onclick="document.getElementById('newInvoiceModal').classList.add('hidden')"
          class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">
          Abbrechen
        </button>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold">
          Rechnung Erstellen
        </button>
      </div>
    </form>

  </div>
</div>

<script>
  // Öffnet das Modal und setzt beim ersten Mal eine leere Zeile
  document.getElementById('newInvoiceModal').addEventListener('click', function(e) {
    if (e.target === this) this.classList.add('hidden');
  });
  document.querySelector('[onclick="document.getElementById(\'newInvoiceModal\').classList.remove(\'hidden\')"]')
    .addEventListener('click', function() {
      const c = document.getElementById('docItemsContainer');
      if (c && c.children.length === 0) docAddRow();
    });

  function docAddRow(title = '', qty = 1, unit = 'Stk', price = '') {
    const c = document.getElementById('docItemsContainer');
    const id = 'doc_row_' + Date.now() + Math.random().toString(36).substr(2, 4);
    const isDark = document.documentElement.classList.contains('dark');
    c.insertAdjacentHTML('beforeend', `
      <div id="${id}" class="p-3 bg-slate-50 dark:bg-slate-700 border dark:border-slate-600 rounded-lg space-y-2">
        <div class="flex gap-2 items-center">
          <input type="text" name="title" value="${title}" required
            placeholder="Beschreibung (z.B. Stahlträger HEB 160)"
            class="flex-1 border dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded p-2 text-sm bg-white">
          <button type="button" onclick="document.getElementById('${id}').remove()"
            class="text-red-500 hover:text-red-700 font-bold px-2 py-1 text-sm flex-shrink-0" title="Entfernen">✕</button>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div>
            <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Menge</label>
            <input type="number" step="0.01" name="quantity" value="${qty}" required
              class="w-full border dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded p-1.5 text-sm bg-white">
          </div>
          <div>
            <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Einheit</label>
            <select name="unit" class="w-full border dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded p-1.5 text-sm bg-white">
              <option value="Stk"  ${unit==='Stk' ?'selected':''}>Stk</option>
              <option value="m"    ${unit==='m'   ?'selected':''}>m (Meter)</option>
              <option value="Std"  ${unit==='Std' ?'selected':''}>Std (Stunden)</option>
              <option value="kg"   ${unit==='kg'  ?'selected':''}>kg</option>
              <option value="m²"   ${unit==='m²'  ?'selected':''}>m²</option>
              <option value="Psch" ${unit==='Psch'?'selected':''}>Pauschale</option>
            </select>
          </div>
          <div>
            <label class="block text-[10px] text-slate-500 dark:text-slate-400 uppercase mb-0.5">Einzelpreis (€)</label>
            <input type="number" step="0.01" name="price" value="${price}" required placeholder="0.00"
              class="w-full border dark:border-slate-600 dark:bg-slate-800 dark:text-gray-100 rounded p-1.5 text-sm bg-white">
          </div>
        </div>
      </div>`);
  }

  function docAddArticle(sel) {
    const o = sel.options[sel.selectedIndex];
    if (!o.value) return;
    const desc = o.getAttribute('data-desc');
    docAddRow(
      o.getAttribute('data-title') + (desc ? ' – ' + desc : ''),
      1,
      o.getAttribute('data-unit'),
      o.getAttribute('data-price')
    );
    sel.value = '';
  }
</script>

</body>
</html>
