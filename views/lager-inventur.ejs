<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex flex-col overflow-y-auto md:ml-72 page-bg min-h-screen pt-16 md:pt-6">

  <div class="px-4 md:px-6 mb-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
    <div>
      <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">📋 Inventur-Modus</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400">Bestand zählen und mit dem System abgleichen – funktioniert auch offline im Lager.</p>
    </div>
    <a href="/lager?tab=<%= tab %>" class="text-sm text-blue-600 hover:underline">← zurück zur Lagerliste</a>
  </div>

  <!-- ── Tab-Auswahl ──────────────────────────────────────────────────────── -->
  <div class="px-4 md:px-6 mb-4 flex flex-wrap gap-2">
    <% const stockTabs = [['baustahl','🔩 Baustahl'],['edelstahl','✨ Edelstahl'],['schrauben','🔧 Schrauben'], ...customTabs.map(t => [t.key, t.icon + ' ' + t.label])]; %>
    <% for (const [key, label] of stockTabs) { %>
      <a href="/lager/inventur?tab=<%= key %>"
        class="px-3 py-1.5 rounded-lg text-sm font-medium transition <%= tab === key ? 'bg-blue-600 text-white shadow' : 'bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-600' %>">
        <%= label %>
      </a>
    <% } %>
  </div>

  <% if (done) { %>
  <div class="px-4 md:px-6 mb-4">
    <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-300 dark:border-emerald-700 rounded-xl px-4 py-3 flex items-center gap-3">
      <span class="text-emerald-500 text-xl">✅</span>
      <p class="text-sm font-semibold text-emerald-800 dark:text-emerald-300">Inventur abgeschlossen – Lagerbestand wurde aktualisiert.</p>
    </div>
  </div>
  <% } %>

  <div class="px-4 md:px-6 pb-24">
    <% if (!inventur) { %>
      <!-- ── Keine offene Inventur: Start-Karte ────────────────────────────── -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-6 text-center max-w-md mx-auto">
        <div class="text-4xl mb-3">📋</div>
        <h2 class="text-base font-bold text-gray-800 dark:text-gray-100 mb-1">Keine offene Inventur für diesen Tab</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
          Beim Start wird der aktuelle Systembestand als „Soll" übernommen. Du zählst dann Position für Position den echten Bestand („Ist").
          Am Ende wird der Lagerbestand automatisch auf die gezählten Werte korrigiert.
        </p>
        <form action="/lager/inventur/start" method="POST">
          <input type="hidden" name="tab" value="<%= tab %>">
          <button type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-3 rounded-lg shadow">
            ▶️ Inventur starten
          </button>
        </form>
      </div>
    <% } else { %>
      <!-- ── Fortschritt ──────────────────────────────────────────────────── -->
      <% const total = positionen.length; const gezaehlt = positionen.filter(p => p.gezaehlt).length; const pct = total ? Math.round(gezaehlt/total*100) : 0; %>
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 mb-4">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-semibold text-gray-700 dark:text-gray-200"><%= gezaehlt %> / <%= total %> gezählt</span>
          <span class="text-sm font-bold text-blue-600"><%= pct %>%</span>
        </div>
        <div class="w-full bg-slate-100 dark:bg-slate-700 rounded-full h-2.5">
          <div class="bg-blue-600 h-2.5 rounded-full transition-all" style="width:<%= pct %>%"></div>
        </div>
        <input type="text" id="inventurSearch" placeholder="🔍 Suchen (Bezeichnung, Profil, Lagerort)…"
          class="mt-3 w-full border border-gray-200 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 dark:text-gray-100"
          oninput="filterInventurList(this.value)">
      </div>

      <!-- ── Positionsliste ───────────────────────────────────────────────── -->
      <div id="inventurList" class="space-y-2">
        <% for (const pos of positionen) { %>
        <div class="inventur-row bg-white dark:bg-slate-800 rounded-xl shadow p-3 flex items-center gap-3 <%= pos.gezaehlt ? 'opacity-60' : '' %>"
          data-search="<%= (pos.bezeichnung + ' ' + (pos.profil||'') + ' ' + (pos.lagerort||'')).toLowerCase() %>">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-gray-800 dark:text-gray-100 truncate"><%= pos.bezeichnung %></p>
            <p class="text-xs text-gray-500 dark:text-gray-400 truncate">
              <%= pos.profil || '' %> <%= pos.abmessung ? '· ' + pos.abmessung : '' %>
              <% if (pos.lagerort) { %> · 📍 <%= pos.lagerort %><% } %>
              · Soll: <%= parseFloat(pos.soll_menge).toLocaleString('de-DE') %> <%= pos.einheit %>
            </p>
          </div>
          <form class="inventur-count-form flex items-center gap-1.5 flex-shrink-0" data-offline="true" data-offline-label="Inventur-Zählung"
            action="/lager/inventur/count" method="POST">
            <input type="hidden" name="position_id" value="<%= pos.id %>">
            <button type="button" onclick="stepQty(this, -1)"
              class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold">−</button>
            <input type="number" step="0.01" name="ist_menge" value="<%= pos.gezaehlt ? pos.ist_menge : pos.soll_menge %>"
              class="w-20 text-center border border-gray-200 dark:border-slate-600 rounded-lg px-1 py-1.5 text-sm bg-white dark:bg-slate-700 dark:text-gray-100">
            <button type="button" onclick="stepQty(this, 1)"
              class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold">+</button>
            <button type="submit"
              class="ml-1 px-3 py-1.5 rounded-lg text-xs font-semibold <%= pos.gezaehlt ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300' : 'bg-blue-600 text-white' %>">
              <%= pos.gezaehlt ? '✓ Erfasst' : 'Erfassen' %>
            </button>
          </form>
        </div>
        <% } %>
      </div>

      <!-- ── Abschluss-Leiste ─────────────────────────────────────────────── -->
      <div class="fixed bottom-0 left-0 right-0 md:left-72 bg-white dark:bg-slate-800 border-t border-gray-200 dark:border-slate-700 p-3 flex gap-2 z-40">
        <form action="/lager/inventur/cancel" method="POST" class="flex-1" onsubmit="return confirm('Inventur wirklich verwerfen? Gezählte Werte gehen verloren.');">
          <input type="hidden" name="inventur_id" value="<%= inventur.id %>">
          <input type="hidden" name="tab" value="<%= tab %>">
          <button type="submit" class="w-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-semibold px-4 py-3 rounded-lg text-sm">
            Verwerfen
          </button>
        </form>
        <form action="/lager/inventur/finish" method="POST" class="flex-[2]" onsubmit="return confirm('Inventur abschließen? Der Lagerbestand wird auf die gezählten Werte gesetzt.');">
          <input type="hidden" name="inventur_id" value="<%= inventur.id %>">
          <input type="hidden" name="tab" value="<%= tab %>">
          <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-3 rounded-lg shadow text-sm">
            ✅ Inventur abschließen (<%= gezaehlt %>/<%= total %>)
          </button>
        </form>
      </div>
    <% } %>
  </div>

</main>

<script>
  function stepQty(btn, delta) {
    const input = btn.parentElement.querySelector('input[name="ist_menge"]');
    const val = parseFloat(input.value.replace(',', '.')) || 0;
    input.value = Math.max(0, val + delta);
  }

  function filterInventurList(q) {
    q = q.toLowerCase().trim();
    document.querySelectorAll('.inventur-row').forEach(row => {
      row.style.display = row.dataset.search.includes(q) ? '' : 'none';
    });
  }

  // Nach dem Absenden (Erfassen-Button) via fetch statt Full-Reload,
  // damit die lange Liste beim mobilen Zählen nicht ständig neu lädt.
  document.addEventListener('submit', async function (e) {
    const form = e.target;
    if (!form.classList.contains('inventur-count-form')) return;
    if (!navigator.onLine) return; // Offline: der globale offline-queue.js Handler übernimmt

    e.preventDefault();
    const fd = new FormData(form);
    try {
      const res = await fetch(form.action, { method: 'POST', body: new URLSearchParams(fd) });
      if (res.ok) {
        const row = form.closest('.inventur-row');
        row.classList.add('opacity-60');
        const btn = form.querySelector('button[type="submit"]');
        btn.textContent = '✓ Erfasst';
        btn.className = 'ml-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300';
        if (typeof showToast === 'function') showToast('Gespeichert', 'success', 1200);
      }
    } catch (err) {
      if (typeof showToast === 'function') showToast('Fehler beim Speichern – wird offline zwischengespeichert.', 'error');
    }
  });
</script>

</body>
</html>
