<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 md:ml-72 min-h-screen page-bg dark:bg-slate-900 pt-14 md:pt-0">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6 space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Kundenverwaltung</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Kontakte verwalten und Kundenprojekte einsehen</p>
      </div>
      <button onclick="toggleModal('addCustomerModal')" class="btn btn-primary">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Neuen Kunden anlegen
      </button>
    </div>

    <!-- Kunden-Tabelle -->
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[700px]">
          <thead>
            <tr class="border-b border-slate-100 dark:border-slate-700">
              <th class="px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Firma / Name</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Ansprechpartner</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Kontakt</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Adresse</th>
              <th class="px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wider text-right">Aktionen</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
            <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
              <% customers.forEach(c => { %>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition">
                  <td class="px-4 py-3 font-semibold text-slate-800 dark:text-slate-100">
                    <div class="flex items-center gap-2.5">
                      <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xs font-bold shrink-0">
                        <%= (c.company_name || c.contact_person || '?').charAt(0).toUpperCase() %>
                      </div>
                      <%= c.company_name || '-' %>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-slate-600 dark:text-slate-300"><%= c.contact_person || '-' %></td>
                  <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">
                    <% if (c.phone) { %><div class="flex items-center gap-1"><svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg><%= c.phone %></div><% } %>
                    <% if (c.email) { %><div class="flex items-center gap-1 text-xs text-slate-400 mt-0.5"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg><%= c.email %></div><% } %>
                  </td>
                  <td class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">
                    <%= c.street || '' %><% if (c.street && (c.zip || c.city)) { %><br><% } %><small><%= c.zip || '' %> <%= c.city || '' %></small>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <div class="flex items-center justify-end gap-1.5">
                      <a href="/customers/<%= c.id %>/projects" class="btn btn-ghost py-1.5 px-2.5 text-xs">Projekte</a>
                      <button onclick='openEditModal(<%- JSON.stringify(c) %>)' class="btn py-1.5 px-2.5 text-xs text-amber-600 border border-amber-200 hover:bg-amber-50 dark:border-amber-800 dark:hover:bg-amber-900/20">Bearbeiten</button>
                      <form action="/customers/delete" method="POST" onsubmit="return confirm('Kunde wirklich löschen?');" class="inline">
                        <input type="hidden" name="id" value="<%= c.id %>">
                        <button type="submit" class="btn py-1.5 px-2.5 text-xs text-red-500 border border-red-200 hover:bg-red-50 dark:border-red-800 dark:hover:bg-red-900/20">Löschen</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="py-16 text-center">
                  <div class="flex flex-col items-center gap-3 text-slate-400">
                    <svg class="w-12 h-12 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <p class="text-sm font-medium">Noch keine Kunden angelegt</p>
                    <button onclick="toggleModal('addCustomerModal')" class="btn btn-primary text-xs">Ersten Kunden anlegen</button>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- Modal: Kunde Anlegen -->
<div id="addCustomerModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="card w-full max-w-md p-6 max-h-[90vh] overflow-y-auto border-0">
    <div class="flex justify-between items-center mb-5">
      <h3 class="text-base font-bold text-slate-800 dark:text-slate-100">Neuen Kunden anlegen</h3>
      <button onclick="toggleModal('addCustomerModal')" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition text-lg">×</button>
    </div>
    <form action="/customers/add" method="POST" class="space-y-3">
      <input type="text" name="company_name" placeholder="Firmenname" class="input">
      <input type="text" name="contact_person" placeholder="Ansprechpartner" class="input">
      <input type="text" name="phone" placeholder="Telefonnummer" class="input">
      <input type="email" name="email" placeholder="E-Mail" class="input">
      <input type="text" name="street" placeholder="Straße & Hausnummer" class="input">
      <div class="grid grid-cols-2 gap-3">
        <input type="text" name="zip" placeholder="PLZ" class="input">
        <input type="text" name="city" placeholder="Ort" class="input">
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t border-slate-100 dark:border-slate-700">
        <button type="button" onclick="toggleModal('addCustomerModal')" class="btn btn-ghost">Abbrechen</button>
        <button type="submit" class="btn btn-primary">Speichern</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Kunde Bearbeiten -->
<div id="editCustomerModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="card w-full max-w-md p-6 max-h-[90vh] overflow-y-auto border-0">
    <div class="flex justify-between items-center mb-5">
      <h3 class="text-base font-bold text-slate-800 dark:text-slate-100">Kunden bearbeiten</h3>
      <button onclick="toggleModal('editCustomerModal')" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition text-lg">×</button>
    </div>
    <form action="/customers/edit" method="POST" class="space-y-3">
      <input type="hidden" name="id" id="edit_id">
      <input type="text" name="company_name" id="edit_company_name" placeholder="Firmenname" class="input">
      <input type="text" name="contact_person" id="edit_contact_person" placeholder="Ansprechpartner" class="input">
      <input type="text" name="phone" id="edit_phone" placeholder="Telefonnummer" class="input">
      <input type="email" name="email" id="edit_email" placeholder="E-Mail" class="input">
      <input type="text" name="street" id="edit_street" placeholder="Straße & Hausnummer" class="input">
      <div class="grid grid-cols-2 gap-3">
        <input type="text" name="zip" id="edit_zip" placeholder="PLZ" class="input">
        <input type="text" name="city" id="edit_city" placeholder="Ort" class="input">
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t border-slate-100 dark:border-slate-700">
        <button type="button" onclick="toggleModal('editCustomerModal')" class="btn btn-ghost">Abbrechen</button>
        <button type="submit" class="btn py-2 px-4 text-sm font-semibold text-white" style="background:#d97706">Änderungen speichern</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleModal(id) {
    document.getElementById(id).classList.toggle('hidden');
  }
  function openEditModal(customer) {
    document.getElementById('edit_id').value           = customer.id;
    document.getElementById('edit_company_name').value = customer.company_name  || '';
    document.getElementById('edit_contact_person').value = customer.contact_person || '';
    document.getElementById('edit_phone').value        = customer.phone         || '';
    document.getElementById('edit_email').value        = customer.email         || '';
    document.getElementById('edit_street').value       = customer.street        || '';
    document.getElementById('edit_zip').value          = customer.zip           || '';
    document.getElementById('edit_city').value         = customer.city          || '';
    document.getElementById('editCustomerModal').classList.remove('hidden');
  }
</script>

</body>
</html>
