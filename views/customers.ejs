<%- include('partials/header') %>

<div class="flex h-screen bg-gray-100">
  <%- include('partials/sidebar') %>

  <main class="flex-1 p-6 overflow-y-auto">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Kundenverwaltung</h1>
        <p class="text-sm text-gray-500">Kunden verwalten, Kontaktdaten anpassen und Kundenprojekte einsehen</p>
      </div>
      <button onclick="toggleModal('addCustomerModal')" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow">
        + Neue Kundschaft anlegen
      </button>
    </div>

    <!-- Tabelle -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-500 uppercase">
          <tr>
            <th class="p-4">Firma / Name</th>
            <th class="p-4">Ansprechpartner</th>
            <th class="p-4">Kontakt (Tel / E-Mail)</th>
            <th class="p-4">Adresse</th>
            <th class="p-4 text-right">Aktionen</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
            <% customers.forEach(c => { %>
              <tr class="border-b hover:bg-gray-50">
                <td class="py-3 px-4 font-bold text-gray-800"><%= c.company_name || '-' %></td>
                <td class="py-3 px-4 text-gray-700"><%= c.contact_person || '-' %></td>
                <td class="py-3 px-4 text-sm">
                  <div>📞 <%= c.phone || 'Keine' %></div>
                  <div class="text-xs text-gray-500">✉️ <%= c.email || 'Keine' %></div>
                </td>
                <td class="py-3 px-4 text-sm text-gray-600">
                  <%= c.street || '' %><br>
                  <small><%= c.zip || '' %> <%= c.city || '' %></small>
                </td>
                <td class="py-3 px-4 text-right">
                  <div class="flex justify-end gap-2">
                    <!-- Button: Projekte -->
                    <a href="/customers/<%= c.id %>/projects" class="px-2 py-1 bg-blue-50 text-blue-600 hover:bg-blue-100 rounded text-xs font-semibold">
                      📁 Projekte
                    </a>

                    <!-- Button: Bearbeiten -->
                    <button onclick='openEditModal(<%- JSON.stringify(c) %>)' class="px-2 py-1 bg-amber-50 text-amber-700 hover:bg-amber-100 rounded text-xs font-semibold">
                      ✏️ Bearbeiten
                    </button>

                    <!-- Button: Löschen -->
                    <form action="/customers/delete" method="POST" onsubmit="return confirm('Kunde wirklich löschen?');" class="inline">
                      <input type="hidden" name="id" value="<%= c.id %>">
                      <button type="submit" class="px-2 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded text-xs font-semibold">🗑️</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="5" class="p-4 text-center text-gray-400">Keine Kunden vorhanden.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</div>

<!-- Modal: Kunde Anlegen -->
<div id="addCustomerModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-xl shadow-lg max-w-md w-full p-6">
    <h3 class="text-lg font-bold mb-4">Neuen Kunden anlegen</h3>
    <form action="/customers/add" method="POST" class="space-y-3">
      <input type="text" name="company_name" placeholder="Firmenname" class="w-full border rounded p-2 text-sm">
      <input type="text" name="contact_person" placeholder="Ansprechpartner Name" class="w-full border rounded p-2 text-sm">
      <input type="text" name="phone" placeholder="Telefonnummer" class="w-full border rounded p-2 text-sm">
      <input type="email" name="email" placeholder="E-Mail" class="w-full border rounded p-2 text-sm">
      <input type="text" name="street" placeholder="Straße & Hausnummer" class="w-full border rounded p-2 text-sm">
      <div class="grid grid-cols-2 gap-2">
        <input type="text" name="zip" placeholder="PLZ" class="border rounded p-2 text-sm">
        <input type="text" name="city" placeholder="Ort" class="border rounded p-2 text-sm">
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" onclick="toggleModal('addCustomerModal')" class="px-3 py-1.5 border rounded text-sm">Abbrechen</button>
        <button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded text-sm font-medium">Speichern</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Kunde Bearbeiten -->
<div id="editCustomerModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-xl shadow-lg max-w-md w-full p-6">
    <h3 class="text-lg font-bold mb-4">Kunden bearbeiten</h3>
    <form action="/customers/edit" method="POST" class="space-y-3">
      <input type="hidden" name="id" id="edit_id">
      <input type="text" name="company_name" id="edit_company_name" placeholder="Firmenname" class="w-full border rounded p-2 text-sm">
      <input type="text" name="contact_person" id="edit_contact_person" placeholder="Ansprechpartner Name" class="w-full border rounded p-2 text-sm">
      <input type="text" name="phone" id="edit_phone" placeholder="Telefonnummer" class="w-full border rounded p-2 text-sm">
      <input type="email" name="email" id="edit_email" placeholder="E-Mail" class="w-full border rounded p-2 text-sm">
      <input type="text" name="street" id="edit_street" placeholder="Straße & Hausnummer" class="w-full border rounded p-2 text-sm">
      <div class="grid grid-cols-2 gap-2">
        <input type="text" name="zip" id="edit_zip" placeholder="PLZ" class="border rounded p-2 text-sm">
        <input type="text" name="city" id="edit_city" placeholder="Ort" class="border rounded p-2 text-sm">
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" onclick="toggleModal('editCustomerModal')" class="px-3 py-1.5 border rounded text-sm">Abbrechen</button>
        <button type="submit" class="px-3 py-1.5 bg-amber-600 text-white rounded text-sm font-medium">Änderungen Speichern</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleModal(id) {
    document.getElementById(id).classList.toggle('hidden');
  }

  function openEditModal(customer) {
    document.getElementById('edit_id').value = customer.id;
    document.getElementById('edit_company_name').value = customer.company_name || '';
    document.getElementById('edit_contact_person').value = customer.contact_person || '';
    document.getElementById('edit_phone').value = customer.phone || '';
    document.getElementById('edit_email').value = customer.email || '';
    document.getElementById('edit_street').value = customer.street || '';
    document.getElementById('edit_zip').value = customer.zip || '';
    document.getElementById('edit_city').value = customer.city || '';
    
    document.getElementById('editCustomerModal').classList.remove('hidden');
  }
</script>

</body>
</html>