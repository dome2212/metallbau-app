<%- include('partials/header') %>

<div class="flex h-screen bg-gray-100 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-gray-100 min-h-screen pt-16 md:pt-6">
    <div class="px-4 md:px-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-gray-800">Kundenverwaltung</h1>
        <p class="text-sm text-gray-500">Kunden verwalten, Kontaktdaten anpassen und Kundenprojekte einsehen</p>
      </div>
      <button onclick="toggleModal('addCustomerModal')" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow text-sm w-full md:w-auto justify-center flex items-center">
        + Neue Kundschaft anlegen
      </button>
    </div>

    <!-- Tabelle mit Scroll-Container -->
    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto pb-6">
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[700px]">
            <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-500 uppercase">
              <tr>
                <th class="p-4">Firma / Name</th>
                <th class="p-4">Ansprechpartner</th>
                <th class="p-4">Kontakt (Tel / E-Mail)</th>
                <th class="p-4">Adresse</th>
                <th class="p-4 text-right">Aktionen</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
                <% customers.forEach(c => { %>
                  <tr class="border-b hover:bg-gray-50">
                    <td class="py-3 px-4 font-bold text-gray-800"><%= c.company_name || '-' %></td>
                    <td class="py-3 px-4 text-gray-700"><%= c.contact_person || '-' %></td>
                    <td class="py-3 px-4 text-sm">
                      <div>📞 <%= c.phone || 'Keine' %></div>
                      <div class="text-xs text-gray-500">✉️ <%= c.email || 'Keine' %></div>
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600">
                      <%= c.street || '' %><br>
                      <small><%= c.zip || '' %> <%= c.city || '' %></small>
                    </td>
                    <td class="py-3 px-4 text-right">
                      <div class="flex justify-end gap-2">
                        <!-- Button: Projekte -->
                        <a href="/customers/<%= c.id %>/projects" class="px-2 py-1 bg-blue-50 text-blue-600 hover:bg-blue-100 rounded text-xs font-semibold">
                          📁 Projekte
                        </a>

                        <!-- Button: Bearbeiten -->
                        <button onclick='openEditModal(<%- JSON.stringify(c) %>)' class="px-2 py-1 bg-amber-50 text-amber-700 hover:bg-amber-100 rounded text-xs font-semibold">
                          ✏️ Bearbeiten
                        </button>

                        <!-- Button: Löschen -->
                        <form action="/customers/delete" method="POST" onsubmit="return confirm('Kunde wirklich löschen?');" class="inline">
                          <input type="hidden" name="id" value="<%= c.id %>">
                          <button type="submit" class="px-2 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded text-xs font-semibold">🗑️</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr><td colspan="5" class="p-6 text-center text-gray-400 text-sm">Keine Kunden vorhanden.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Modal: Kunde Anlegen -->
<div id="addCustomerModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-xl shadow-lg max-w-md w-full p-4 md:p-6 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 border-b pb-2">
      <h3 class="text-lg font-bold text-gray-800">Neuen Kunden anlegen</h3>
      <button onclick="toggleModal('addCustomerModal')" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
    </div>
    <form action="/customers/add" method="POST" class="space-y-3">
      <input type="text" name="company_name" placeholder="Firmenname" class="w-full border rounded p-2 text-sm bg-white">
      <input type="text" name="contact_person" placeholder="Ansprechpartner Name" class="w-full border rounded p-2 text-sm bg-white">
      <input type="text" name="phone" placeholder="Telefonnummer" class="w-full border rounded p-2 text-sm bg-white">
      <input type="email" name="email" placeholder="E-Mail" class="w-full border rounded p-2 text-sm bg-white">
      <input type="text" name="street" placeholder="Straße & Hausnummer" class="w-full border rounded p-2 text-sm bg-white">
      <div class="grid grid-cols-2 gap-2">
        <input type="text" name="zip" placeholder="PLZ" class="border rounded p-2 text-sm bg-white">
        <input type="text" name="city" placeholder="Ort" class="border rounded p-2 text-sm bg-white">
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" onclick="toggleModal('addCustomerModal')" class="px-3 py-1.5 border rounded text-sm text-gray-600 hover:bg-gray-50">Abbrechen</button>
        <button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded text-sm font-medium hover:bg-blue-700">Speichern</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Kunde Bearbeiten -->
<div id="editCustomerModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-xl shadow-lg max-w-md w-full p-4 md:p-6 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 border-b pb-2">
      <h3 class="text-lg font-bold text-gray-800">Kunden bearbeiten</h3>
      <button onclick="toggleModal('editCustomerModal')" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
    </div>
    <form action="/customers/edit" method="POST" class="space-y-3">
      <input type="hidden" name="id" id="edit_id">
      <input type="text" name="company_name" id="edit_company_name" placeholder="Firmenname" class="w-full border rounded p-2 text-sm bg-white">
      <input type="text" name="contact_person" id="edit_contact_person" placeholder="Ansprechpartner Name" class="w-full border rounded p-2 text-sm bg-white">
      <input type="text" name="phone" id="edit_phone" placeholder="Telefonnummer" class="w-full border rounded p-2 text-sm bg-white">
      <input type="email" name="email" id="edit_email" placeholder="E-Mail" class="w-full border rounded p-2 text-sm bg-white">
      <input type="text" name="street" id="edit_street" placeholder="Straße & Hausnummer" class="w-full border rounded p-2 text-sm bg-white">
      <div class="grid grid-cols-2 gap-2">
        <input type="text" name="zip" id="edit_zip" placeholder="PLZ" class="border rounded p-2 text-sm bg-white">
        <input type="text" name="city" id="edit_city" placeholder="Ort" class="border rounded p-2 text-sm bg-white">
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" onclick="toggleModal('editCustomerModal')" class="px-3 py-1.5 border rounded text-sm text-gray-600 hover:bg-gray-50">Abbrechen</button>
        <button type="submit" class="px-3 py-1.5 bg-amber-600 text-white rounded text-sm font-medium hover:bg-amber-700">Änderungen Speichern</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleModal(id) {
    document.getElementById(id).classList.toggle('hidden');
  }

  function openEditModal(customer) {
    document.getElementById('edit_id').value = customer.id;
    document.getElementById('edit_company_name').value = customer.company_name || '';
    document.getElementById('edit_contact_person').value = customer.contact_person || '';
    document.getElementById('edit_phone').value = customer.phone || '';
    document.getElementById('edit_email').value = customer.email || '';
    document.getElementById('edit_street').value = customer.street || '';
    document.getElementById('edit_zip').value = customer.zip || '';
    document.getElementById('edit_city').value = customer.city || '';
    
    document.getElementById('editCustomerModal').classList.remove('hidden');
  }
</script>

</body>
</html>
