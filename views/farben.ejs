<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex flex-col overflow-y-auto page-bg min-h-screen pt-16">

  <div class="px-4 md:px-6 mb-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
    <div>
      <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">🎨 Farben-Bibliothek</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400">RAL-Farben mit Foto vom echten Muster – für Angebote &amp; Kundengespräche.</p>
    </div>
    <button onclick="document.getElementById('addColorModal').classList.remove('hidden')"
      class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-3 py-2 rounded-lg shadow text-sm flex items-center gap-1.5">
      + Farbe hinzufügen
    </button>
  </div>

  <div class="px-4 md:px-6 mb-4">
    <form method="GET" action="/farben" class="flex gap-2 max-w-sm">
      <input type="text" name="q" value="<%= q %>" placeholder="🔍 RAL-Code oder Name suchen…"
        class="flex-1 border border-gray-200 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 dark:text-gray-100">
      <button type="submit" class="px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-sm">Suchen</button>
      <% if (q) { %><a href="/farben" class="px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-sm">✕</a><% } %>
    </form>
  </div>

  <div class="px-4 md:px-6 pb-10">
    <% if (items.length === 0) { %>
      <%- include('partials/empty-state', {
        icon: 'M12 3a9 9 0 100 18c1 0 1.5-.5 1.5-1.3 0-.4-.2-.7-.4-1-.2-.3-.4-.6-.4-1 0-.8.6-1.4 1.4-1.4H16a4 4 0 004-4c0-5-4-9.3-8-9.3z',
        title: 'Keine Farben gefunden',
        text: 'Lege die erste RAL-Farbe an oder passe den Filter an.'
      }) %>
    <% } else { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
      <% for (const c of items) { %>
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden">
        <!-- Vorschau: Foto wenn vorhanden, sonst Hex-Farbfläche (Klick = Vollbild) -->
        <div class="relative h-28 w-full cursor-pointer" style="background-color: <%= c.hex %>;"
          onclick="openFullscreen('<%= c.hex %>', '<%= c.foto_url ? c.foto_url : '' %>', '<%= c.ral_code %>', '<%= (c.name||'').replace(/'/g,"\\'") %>')">
          <% if (c.foto_url) { %>
            <img src="<%= c.foto_url %>" alt="<%= c.ral_code %> Muster" class="absolute inset-0 w-full h-full object-cover">
          <% } %>
          <button onclick="event.stopPropagation(); toggleFav(<%= c.id %>)"
            class="absolute top-1.5 right-1.5 w-7 h-7 rounded-full bg-white/80 dark:bg-slate-900/70 flex items-center justify-center text-sm shadow">
            <%= c.favorit ? '⭐' : '☆' %>
          </button>
        </div>
        <div class="p-3">
          <p class="text-sm font-bold text-gray-800 dark:text-gray-100"><%= c.ral_code %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400 truncate"><%= c.name || '—' %></p>
          <p class="text-[10px] font-mono text-gray-400 dark:text-gray-500 mt-0.5"><%= c.hex %></p>
          <% if (c.notiz) { %><p class="text-[11px] text-gray-500 dark:text-gray-400 mt-1 line-clamp-2"><%= c.notiz %></p><% } %>

          <div class="flex gap-1.5 mt-2">
            <label class="flex-1 text-center text-[11px] font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg py-1.5 cursor-pointer">
              📷 Foto
              <input type="file" accept="image/*" capture="environment" class="hidden" onchange="uploadFoto(<%= c.id %>, this)">
            </label>
            <button onclick="editColor(<%= c.id %>, '<%= (c.name||'').replace(/'/g,"\\'") %>', '<%= (c.notiz||'').replace(/'/g,"\\'") %>')"
              class="text-[11px] font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg px-2.5 py-1.5">✎</button>
            <form action="/farben/<%= c.id %>/delete" method="POST" onsubmit="return confirm('Farbe wirklich löschen?');">
              <button type="submit" class="text-[11px] font-semibold bg-red-50 dark:bg-red-900/20 text-red-500 rounded-lg px-2.5 py-1.5">🗑</button>
            </form>
          </div>
          <% if (c.foto_url) { %>
          <form action="/farben/<%= c.id %>/foto-delete" method="POST" class="mt-1">
            <button type="submit" class="w-full text-[10px] text-gray-400 hover:text-red-500">Foto entfernen</button>
          </form>
          <% } %>

          <!-- versteckte Formulare für JS-Aktionen -->
          <form id="uploadForm-<%= c.id %>" action="/farben/<%= c.id %>/foto" method="POST" enctype="multipart/form-data" class="hidden"></form>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>

  <!-- ── MODAL: Farbe hinzufügen ─────────────────────────────────────────── -->
  <div id="addColorModal" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl w-full max-w-sm p-5">
      <h2 class="text-base font-bold text-gray-800 dark:text-gray-100 mb-3">+ Farbe hinzufügen</h2>
      <form action="/farben/add" method="POST" class="space-y-3">
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">RAL-Code *</label>
          <input type="text" name="ral_code" required placeholder="z.B. RAL 9005"
            class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 dark:text-gray-100">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Bezeichnung</label>
          <input type="text" name="name" placeholder="z.B. Tiefschwarz"
            class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 dark:text-gray-100">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Farbton (Hex) *</label>
          <div class="flex gap-2">
            <input type="color" name="hex_picker" value="#0A0A0A" class="w-12 h-10 border border-gray-200 dark:border-slate-600 rounded-lg"
              oninput="document.getElementById('hexInput').value = this.value">
            <input type="text" name="hex" id="hexInput" required value="#0A0A0A"
              class="flex-1 border border-gray-200 dark:border-slate-600 rounded-lg px-3 py-2 text-sm font-mono bg-white dark:bg-slate-700 dark:text-gray-100">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Notiz</label>
          <textarea name="notiz" rows="2" placeholder="z.B. Lieferant, Struktur (glatt/fein), Verwendungszweck…"
            class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 dark:text-gray-100 resize-none"></textarea>
        </div>
        <div class="flex gap-2 pt-2">
          <button type="button" onclick="document.getElementById('addColorModal').classList.add('hidden')"
            class="flex-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-medium py-2 rounded-lg text-sm">Abbrechen</button>
          <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 rounded-lg text-sm">Speichern</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ── MODAL: Farbe bearbeiten ─────────────────────────────────────────── -->
  <div id="editColorModal" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl w-full max-w-sm p-5">
      <h2 class="text-base font-bold text-gray-800 dark:text-gray-100 mb-3">Farbe bearbeiten</h2>
      <form id="editColorForm" method="POST" class="space-y-3">
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Bezeichnung</label>
          <input type="text" name="name" id="editName"
            class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 dark:text-gray-100">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Notiz</label>
          <textarea name="notiz" id="editNotiz" rows="2"
            class="w-full border border-gray-200 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 dark:text-gray-100 resize-none"></textarea>
        </div>
        <div class="flex gap-2 pt-2">
          <button type="button" onclick="document.getElementById('editColorModal').classList.add('hidden')"
            class="flex-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-medium py-2 rounded-lg text-sm">Abbrechen</button>
          <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 rounded-lg text-sm">Speichern</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ── Vollbild-Vorschau: Farbe/Foto über das ganze Display ─────────────── -->
  <div id="fullscreenPreview" class="hidden fixed inset-0 z-[60] flex flex-col" onclick="if (event.target === this) closeFullscreen()">
    <button onclick="closeFullscreen()"
      class="absolute top-4 right-4 z-10 w-11 h-11 rounded-full bg-white/90 dark:bg-slate-900/80 text-slate-800 dark:text-gray-100 flex items-center justify-center text-xl shadow-lg">
      ✕
    </button>
    <div id="fullscreenColorArea" class="flex-1 w-full"></div>
    <div class="bg-white dark:bg-slate-800 px-5 py-4 text-center">
      <p id="fullscreenCode" class="text-lg font-bold text-gray-800 dark:text-gray-100"></p>
      <p id="fullscreenName" class="text-sm text-gray-500 dark:text-gray-400"></p>
    </div>
  </div>

</main>

<script>
  function openFullscreen(hex, fotoUrl, ralCode, name) {
    const overlay = document.getElementById('fullscreenPreview');
    const area = document.getElementById('fullscreenColorArea');
    area.style.backgroundColor = hex;
    area.innerHTML = fotoUrl
      ? `<img src="${fotoUrl}" alt="${ralCode}" class="w-full h-full object-contain">`
      : '';
    document.getElementById('fullscreenCode').textContent = ralCode;
    document.getElementById('fullscreenName').textContent = name || '';
    overlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeFullscreen() {
    document.getElementById('fullscreenPreview').classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeFullscreen();
  });
</script>

<script>
  function uploadFoto(id, input) {
    if (!input.files || !input.files[0]) return;
    const fd = new FormData();
    fd.append('foto', input.files[0]);
    if (typeof showToast === 'function') showToast('📷 Foto wird hochgeladen…', 'info');
    fetch('/farben/' + id + '/foto', { method: 'POST', body: fd })
      .then(res => { if (res.ok || res.redirected) window.location.reload(); else throw new Error('Fehler'); })
      .catch(() => { if (typeof showToast === 'function') showToast('Fehler beim Hochladen', 'error'); });
  }

  function toggleFav(id) {
    fetch('/farben/' + id + '/favorit', { method: 'POST' }).then(() => window.location.reload());
  }

  function editColor(id, name, notiz) {
    document.getElementById('editColorForm').action = '/farben/' + id + '/edit';
    document.getElementById('editName').value = name;
    document.getElementById('editNotiz').value = notiz;
    document.getElementById('editColorModal').classList.remove('hidden');
  }
</script>

</body>
</html>
