<%- include('partials/header') %>
<%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 min-h-screen pt-16 md:pt-6">
    <header class="bg-white shadow px-4 md:px-6 py-4 flex justify-between items-center">
      <h1 class="text-xl md:text-2xl font-bold text-slate-800">👥 Mitarbeiter-Logins verwalten</h1>
    </header>

    <div class="p-4 md:p-6 max-w-5xl mx-auto w-full space-y-6">
      
      <!-- Formular: Neuen Mitarbeiter anlegen -->
      <div class="bg-white rounded-lg shadow p-4 md:p-6">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">Neuen Mitarbeiter-Account erstellen</h2>
        <form action="/admin/users/add" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Benutzername</label>
            <input type="text" name="username" required placeholder="z.B. max.mustermann" class="w-full border rounded p-2 text-sm bg-white">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Passwort</label>
            <input type="password" name="password" required placeholder="Sicheres Passwort" class="w-full border rounded p-2 text-sm bg-white">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Rolle</label>
            <select name="role" class="w-full border rounded p-2 text-sm bg-white">
              <option value="EMPLOYEE">Mitarbeiter (Keine Preise/Rechnungen)</option>
              <option value="ADMIN">Chef / Administrator (Voller Zugriff)</option>
            </select>
          </div>
          <div class="md:col-span-3">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded text-sm transition w-full md:w-auto">Account anlegen</button>
          </div>
        </form>
      </div>

    </div>
  </main>
</body>
</html>
