<%- include('partials/header') %>

<div class="flex h-screen bg-slate-100 dark:bg-gray-900 overflow-hidden">
  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col overflow-y-auto md:ml-72 bg-slate-100 dark:bg-gray-900 min-h-screen pt-16 md:pt-6">
    <header class="bg-white dark:bg-slate-800 shadow px-4 md:px-6 py-4 flex justify-between items-center mb-6">
      <h1 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-gray-100">👥 Mitarbeiter-Logins verwalten</h1>
    </header>

    <div class="px-4 md:px-6 max-w-5xl mx-auto w-full space-y-6 pb-6">
      
      <!-- Formular: Neuen Mitarbeiter anlegen -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-6">
        <h2 class="text-base md:text-lg font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">Neuen Mitarbeiter-Account erstellen</h2>
        <form action="/admin/users/add" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Benutzername</label>
            <input type="text" name="username" required placeholder="z.B. max.mustermann" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white">
          </div>
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Passwort</label>
            <input type="password" name="password" required placeholder="Sicheres Passwort" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white">
          </div>
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Rolle</label>
            <select name="role" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white">
              <option value="EMPLOYEE">Mitarbeiter (Keine Preise/Rechnungen)</option>
              <option value="ADMIN">Chef / Administrator (Voller Zugriff)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">📱 WhatsApp-Nummer (optional)</label>
            <input type="tel" name="whatsapp_phone" placeholder="z.B. 01701234567" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white">
            <p class="text-[10px] text-slate-400 mt-1">Deutsche Nummer ohne Vorwahl-0 oder mit +49. Wird für Statusbenachrichtigungen genutzt.</p>
          </div>
          <div class="md:col-span-2">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg text-sm transition w-full md:w-auto">Account anlegen</button>
          </div>
        </form>
      </div>

      <!-- Passwort ändern -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow p-4 md:p-6">
        <h2 class="text-base md:text-lg font-semibold text-slate-800 dark:text-gray-100 mb-4 border-b dark:border-slate-700 pb-2">🔑 Passwort eines Mitarbeiters ändern</h2>
        <form action="/admin/users/change-password" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Mitarbeiter</label>
            <select name="user_id" required class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white">
              <% if (typeof users !== 'undefined') { %>
                <% users.forEach(u => { %>
                  <option value="<%= u.id %>"><%= u.username %> (<%= u.role %>)</option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div>
            <label class="block text-xs md:text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Neues Passwort</label>
            <input type="password" name="new_password" required placeholder="Mindestens 6 Zeichen" minlength="6" class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2.5 text-sm bg-white">
          </div>
          <div class="flex items-end">
            <button type="submit" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-medium px-4 py-2.5 rounded-lg text-sm transition">Passwort ändern</button>
          </div>
        </form>
      </div>

      <!-- Liste der bestehenden Mitarbeiter -->
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow overflow-hidden">
        <div class="px-4 md:px-6 py-4 border-b border-slate-200 dark:border-slate-700">
          <h2 class="text-base md:text-lg font-semibold text-slate-800 dark:text-gray-100">Bestehende Accounts</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-600 dark:text-slate-300 min-w-[600px]">
            <thead class="bg-slate-50 dark:bg-slate-700 text-slate-700 dark:text-slate-300 uppercase text-xs">
              <tr>
                <th class="p-4">Benutzername</th>
                <th class="p-4">Rolle</th>
                <th class="p-4">📱 WhatsApp-Nummer</th>
                <th class="p-4 text-right">Aktion</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
              <% if (typeof users !== 'undefined' && users.length > 0) { %>
                <% users.forEach(u => { %>
                  <tr class="hover:bg-slate-50 dark:hover:bg-slate-700">
                    <td class="p-4 font-semibold text-slate-800 dark:text-gray-100"><%= u.username %></td>
                    <td class="p-4">
                      <% if (u.role === 'ADMIN') { %>
                        <span class="bg-purple-100 text-purple-800 text-xs px-2.5 py-1 rounded-md font-semibold">Administrator</span>
                      <% } else { %>
                        <span class="bg-blue-100 text-blue-800 text-xs px-2.5 py-1 rounded-md font-semibold">Mitarbeiter</span>
                      <% } %>
                    </td>
                    <td class="p-4">
                      <!-- Nummer + API-Key eingeben & speichern -->
                      <form action="/admin/users/set-whatsapp" method="POST" class="space-y-1.5">
                        <input type="hidden" name="user_id" value="<%= u.id %>">
                        <div class="flex items-center gap-2">
                          <input type="tel" name="whatsapp_phone" value="<%= u.whatsapp_phone || '' %>"
                            placeholder="Nummer z.B. 01701234567"
                            class="w-36 border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1 text-xs bg-white focus:ring-1 focus:ring-green-400 focus:outline-none">
                          <input type="text" name="whatsapp_api_key" value="<%= u.whatsapp_api_key || '' %>"
                            placeholder="CallMeBot API-Key"
                            class="w-28 border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded px-2 py-1 text-xs bg-white focus:ring-1 focus:ring-green-400 focus:outline-none">
                          <button type="submit"
                            class="px-2 py-1 bg-green-600 hover:bg-green-700 text-white rounded text-xs font-semibold transition"
                            title="Speichern">✓</button>
                        </div>
                        <p class="text-[10px] text-slate-400">API-Key: WhatsApp an <strong>+34 644 52 74 21</strong> → <em>I allow callmebot to send me messages</em></p>
                      </form>
                      <!-- Benachrichtigungen an/aus -->
                      <% if (u.whatsapp_phone) { %>
                        <%
                          const notifyOn = u.whatsapp_notify === true || u.whatsapp_notify === 1 || u.whatsapp_notify === 't' || u.whatsapp_notify === 'true';
                        %>
                        <form action="/admin/users/toggle-whatsapp-notify" method="POST" class="flex items-center gap-2 mt-1.5">
                          <input type="hidden" name="user_id" value="<%= u.id %>">
                          <input type="hidden" name="notify" value="<%= notifyOn ? '0' : '1' %>">
                          <button type="submit"
                            class="flex items-center gap-1.5 text-[11px] font-semibold px-2.5 py-1 rounded-full border transition
                              <%= notifyOn
                                ? 'bg-green-50 text-green-700 border-green-300 hover:bg-red-50 hover:text-red-600 hover:border-red-300'
                                : 'bg-slate-100 text-slate-500 border-slate-300 hover:bg-green-50 hover:text-green-700 hover:border-green-300' %>">
                            <span><%= notifyOn ? '🔔' : '🔕' %></span>
                            <span><%= notifyOn ? 'Aktiv – klicken zum Deaktivieren' : 'Stumm – klicken zum Aktivieren' %></span>
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-[10px] text-slate-400 mt-0.5 block">Keine Nummer hinterlegt</span>
                      <% } %>
                    </td>
                    <td class="p-4 text-right">
                      <form action="/admin/users/delete" method="POST" onsubmit="return confirm('Mitarbeiter wirklich löschen?');" class="inline">
                        <input type="hidden" name="id" value="<%= u.id %>">
                        <button type="submit" class="px-2.5 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded text-xs font-semibold transition">🗑️ Löschen</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="p-6 text-center text-slate-400 dark:text-slate-500 text-sm">Keine weiteren Mitarbeiter gefunden.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>

</body>
</html>
