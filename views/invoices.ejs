<%- include('partials/header') %>

<%- include('partials/sidebar') %>

    <% if (typeof currentUser !== 'undefined' && (currentUser.role === 'CHEF' || currentUser.role === 'ADMIN')) { %>
    <div class="card p-4 mb-4 border border-red-200 bg-red-50 dark:bg-red-900/20">
      <p class="text-sm font-semibold text-red-800 dark:text-red-200 mb-1">Belege zurücksetzen</p>
      <p class="text-xs text-red-700 dark:text-red-300 mb-3">Löscht alle Angebote, Rechnungen, Gutschriften und Lieferscheine inkl. Positionen, Zahlungen und Mahnungen. Kunden und Aufträge bleiben.</p>
      <form action="/documents/admin/reset-documents" method="POST" onsubmit="var v=prompt('Zur Bestätigung RESET eingeben:'); if(!v||v.toUpperCase()!=='RESET'){alert('Abgebrochen');return false;} this.confirm.value=v.toUpperCase(); return confirm('Alle Belege wirklich unwiderruflich löschen?');">
        <input type="hidden" name="confirm" value="">
        <button type="submit" class="px-3 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg">Alle Belege löschen</button>
      </form>
    </div>
    <% } %>


<main class="flex-1 flex flex-col overflow-y-auto page-bg min-h-screen pt-16">
    <!-- Header-Bereich -->
    <div class="px-4 md:px-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">Rechnungsverwaltung</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Erstelle und verwalte Rechnungen für deine Kunden</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
        <button onclick="toggleModal('datevExportModal')" class="bg-slate-700 hover:bg-slate-800 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center gap-2 text-sm w-full md:w-auto justify-center">
          <span class="flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l3 3v17l-2-1-2 1-2-1-2 1-2-1-2 1V2z"/><path d="M9 7h6M9 11h6M9 15h4"/></svg>DATEV-Export</span>
        </button>
        <a href="/documents/open-items" class="bg-amber-600 hover:bg-amber-700 text-white font-medium px-4 py-2 rounded-lg shadow text-sm w-full md:w-auto justify-center inline-flex items-center gap-1.5">
          OP-Liste
        </a>
        <button onclick="toggleModal('invoiceModal')" class="btn btn-primary text-sm w-full md:w-auto justify-center">
          Neue Rechnung
        </button>
      </div>
    </div>

    <!-- Modal: DATEV-Export -->
    <div id="datevExportModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
      <div class="card w-full max-w-md p-6 border-0">
        <div class="flex justify-between items-center mb-5">
          <h3 class="text-base font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2"><svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l3 3v17l-2-1-2 1-2-1-2 1-2-1-2 1V2z"/><path d="M9 7h6M9 11h6M9 15h4"/></svg>DATEV-Export (Buchungsstapel)</h3>
          <button onclick="toggleModal('datevExportModal')" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition text-lg">×</button>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
          Erstellt eine CSV-Datei aller Rechnungen im gewählten Zeitraum, die sich
          direkt bei DATEV bzw. beim Steuerberater importieren lässt.
        </p>
        <form action="/documents/invoices/datev-export" method="GET" class="space-y-3">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Von</label>
              <input type="date" name="von" required class="input" value="<%= new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString().split('T')[0] %>">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Bis</label>
              <input type="date" name="bis" required class="input" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
          </div>
          <div class="flex justify-end gap-2 pt-3 border-t border-slate-100 dark:border-slate-700">
            <button type="button" onclick="toggleModal('datevExportModal')" class="btn btn-ghost">Abbrechen</button>
            <button type="submit" class="btn btn-primary">Herunterladen</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Filter -->
    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto mb-3">
      <div class="seg" id="inv-seg">
        <button type="button" class="active" data-filter="open">Offen</button>
        <button type="button" data-filter="all">Alle</button>
        <button type="button" data-filter="paid">Bezahlt</button>
      </div>
    </div>

    <!-- Rechnungs-Tabelle -->
    <div class="px-4 md:px-6 w-full max-w-7xl mx-auto pb-6">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow overflow-hidden desktop-table-wrap">
        <div class="overflow-x-auto">
          <table class="table-modern w-full text-left border-collapse min-w-[700px]">
            <thead class="bg-gray-50 dark:bg-slate-700 border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
              <tr>
                <th class="p-4">Rechnungs-Nr.</th>
                <th class="p-4">Datum</th>
                <th class="p-4">Kunde</th>
                <% if (canSeeMoney) { %><th class="p-4">Betrag (Brutto)</th><% } %>
                <th class="p-4">Fällig am</th>
                <th class="p-4">Status</th>
                <th class="p-4 text-right">Aktionen</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof invoices !== 'undefined' && invoices.length > 0) { %>
                <% invoices.forEach(invoice => { %>
                  <tr class="inv-row border-b dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700 text-sm" data-status="<%= invoice.status %>">
                    <td class="py-3 px-4 font-semibold text-gray-800 dark:text-gray-100"><%= invoice.invoice_number %></td>
                    <td class="py-3 px-4 text-gray-600 dark:text-gray-400"><%= new Date(invoice.created_at).toLocaleDateString('de-DE') %></td>
                    <td class="py-3 px-4 text-gray-800 dark:text-gray-200 font-medium"><%= invoice.company_name || invoice.contact_person || 'Privat' %></td>
                    <% if (canSeeMoney) { %>
                      <td class="py-3 px-4 text-gray-800 dark:text-gray-200 font-semibold"><%= parseFloat(invoice.total_amount || 0).toLocaleString('de-DE', {minimumFractionDigits:2}) %> €</td>
                    <% } %>
                    <td class="py-3 px-4 text-gray-600 dark:text-gray-400 text-xs">
                      <% if (invoice.due_date) { %>
                        <%= new Date(invoice.due_date).toLocaleDateString('de-DE') %>
                      <% } else { %>-<% } %>
                    </td>
                    
                    <!-- STATUS ANZEIGE -->
                    <td class="py-3 px-4">
                      <% if (invoice.status === 'Bezahlt') { %>
                        <span class="badge badge-success"><svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>Bezahlt</span>
                      <% } else if (invoice.status === 'Überfällig') { %>
                        <span class="badge badge-danger"><svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4m0 4h.01M10.3 3.9L2.5 17a1.5 1.5 0 001.3 2.3h16.4a1.5 1.5 0 001.3-2.3L13.7 3.9a1.5 1.5 0 00-2.6 0z"/></svg>Überfällig</span>
                      <% } else { %>
                        <span class="badge badge-warning"><%= invoice.status %></span>
                      <% } %>
                    </td>

                    <!-- AKTIONEN -->
                    <td class="py-3 px-4 text-right">
                      <div class="flex items-center justify-end gap-2">
                        
                        <!-- Button: Detail-Ansicht -->
                        <a href="/documents/invoices/<%= invoice.id %>" class="px-2.5 py-1 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded text-xs font-medium border border-blue-200 flex items-center gap-1">
                          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                          Detail
                        </a>

                        <!-- Button: PDF Vorschau (öffnet im selben Tab, damit "Zurück" wieder funktioniert) -->
                        <a href="/documents/invoices/<%= invoice.id %>/pdf" class="px-2.5 py-1 bg-gray-50 hover:bg-gray-100 text-gray-700 rounded text-xs font-medium border border-gray-200 flex items-center gap-1">
                          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5a1 1 0 001 1h5"/><path d="M6 21h12a1 1 0 001-1V7l-5-5H7a1 1 0 00-1 1v3"/></svg>
                          Vorschau
                        </a>

                        <!-- Button: PDF Download (echter Datei-Download) -->
                        <a href="/documents/invoices/<%= invoice.id %>/pdf-download" download class="px-2.5 py-1 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded text-xs font-medium border border-slate-200 flex items-center gap-1">
                          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l4-4m-4 4l-4-4M4 19h16"/></svg>
                          PDF
                        </a>

                        <!-- Button: Als bezahlt markieren -->
                        <% if (invoice.status !== 'Bezahlt') { %>
                          <form action="/documents/invoices/update-status" method="POST" class="inline">
                            <input type="hidden" name="invoice_id" value="<%= invoice.id %>">
                            <input type="hidden" name="status" value="Bezahlt">
                            <input type="hidden" name="status_note" value="">
                            <button type="submit" class="px-2.5 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded text-xs font-medium border border-emerald-200 flex items-center gap-1">
                              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
                              Bezahlt
                            </button>
                          </form>
                        <% } %>

                        <!-- Button: Löschen -->
                        <form action="/documents/invoices/delete" method="POST" onsubmit="return confirm('Rechnung wirklich löschen?');" class="inline">
                          <input type="hidden" name="invoice_id" value="<%= invoice.id %>">
                          <button type="submit" class="px-2.5 py-1 bg-gray-100 hover:bg-red-100 text-red-600 rounded text-xs font-medium" title="Löschen"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m2 0v13a1 1 0 01-1 1H8a1 1 0 01-1-1V7h10z"/></svg></button>
                        </form>

                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="<%= canSeeMoney ? 7 : 6 %>" class="py-12 text-center">
                    <div class="empty-state">
                      <h3>Keine Rechnungen</h3>
                      <p>Lege die erste Rechnung an, um Zahlungen zu verfolgen.</p>
                      <button onclick="toggleModal('invoiceModal')" class="btn btn-primary text-xs mt-3">Neue Rechnung</button>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="mobile-card-list mt-3" id="inv-mobile">
        <% if (typeof invoices !== 'undefined' && invoices.length > 0) { %>
          <% invoices.forEach(invoice => { %>
            <div class="m-card inv-card" data-status="<%= invoice.status %>">
              <a href="/documents/invoices/<%= invoice.id %>" class="block">
                <div class="m-card-title"><%= invoice.invoice_number %></div>
                <div class="m-card-meta">
                  <span><%= invoice.company_name || invoice.contact_person || 'Privat' %></span>
                  <span><%= new Date(invoice.created_at).toLocaleDateString('de-DE') %></span>
                  <% if (canSeeMoney) { %><span class="num"><%= parseFloat(invoice.total_amount || 0).toLocaleString('de-DE', {minimumFractionDigits:2}) %> €</span><% } %>
                  <% if (invoice.status === 'Bezahlt') { %><span class="badge badge-success">Bezahlt</span>
                  <% } else if (invoice.status === 'Überfällig') { %><span class="badge badge-danger">Überfällig</span>
                  <% } else { %><span class="badge badge-warning"><%= invoice.status %></span><% } %>
                </div>
              </a>
              <div class="m-card-actions flex flex-wrap gap-2">
                <a href="/documents/invoices/<%= invoice.id %>" class="btn btn-primary text-xs">Öffnen</a>
                <a href="/documents/invoices/<%= invoice.id %>/pdf-download" download class="btn btn-ghost text-xs">PDF</a>
                <% if (invoice.status !== 'Bezahlt') { %>
                <form action="/documents/invoices/update-status" method="POST" class="inline">
                  <input type="hidden" name="invoice_id" value="<%= invoice.id %>">
                  <input type="hidden" name="status" value="Bezahlt">
                  <input type="hidden" name="status_note" value="">
                  <button type="submit" class="btn btn-ghost text-xs text-emerald-700 border border-emerald-200">Bezahlt</button>
                </form>
                <% } %>
                <form action="/documents/invoices/delete" method="POST" class="inline"
                  onsubmit="return confirm('Rechnung wirklich löschen?');">
                  <input type="hidden" name="invoice_id" value="<%= invoice.id %>">
                  <button type="submit" class="btn btn-ghost text-xs text-red-600 border border-red-200 hover:bg-red-50">Löschen</button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
</main>

<!-- Modal: Neue Rechnung anlegen (Mehrere Positionen) -->
<div id="invoiceModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg max-w-2xl w-full p-4 md:p-6 max-h-[90vh] flex flex-col">
    <div class="flex justify-between items-center mb-4 border-b dark:border-slate-700 pb-2 flex-shrink-0">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">Neue Rechnung anlegen</h3>
      <button onclick="toggleModal('invoiceModal')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-bold">&times;</button>
    </div>
    
    <form action="/documents/create-invoice" method="POST" class="space-y-4 overflow-y-auto pr-1">
      <div>
        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Kunde auswählen *</label>
        <select name="customer_id" required class="w-full border dark:border-slate-600 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-white">
          <option value="">-- Kunde wählen --</option>
          <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
            <% customers.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.company_name ? c.company_name + ' (' + c.contact_person + ')' : c.contact_person %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- ARTIKELSTAMM & TEXTBAUSTEINE SCHNELL-EINFÜGEN -->
      <div class="border-t pt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-blue-700 mb-1 flex items-center gap-1"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8M12 13v8"/></svg>Aus Artikelstamm hinzufügen</label>
          <select id="articleSelectInvoice" onchange="addArticleToInvoiceList(this)" class="w-full border border-blue-200 dark:border-blue-700 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-blue-50/50">
            <option value="">-- Artikel/Leistung wählen --</option>
            <% if (typeof articles !== 'undefined' && articles.length > 0) { %>
              <% articles.forEach(art => { %>
                <option 
                  value="<%= art.id %>" 
                  data-title="<%= art.title %>" 
                  data-unit="<%= art.unit %>" 
                  data-price="<%= art.unit_price %>"
                  data-desc="<%= art.description || '' %>">
                  <%= art.title %> (<%= parseFloat(art.unit_price || 0).toFixed(2) %> € / <%= art.unit %>)
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-purple-700 mb-1 flex items-center gap-1"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 3.5a2.1 2.1 0 013 3L10 16a4 4 0 01-5.7-5.7L13 1.6"/></svg>Textbaustein einfügen</label>
          <select id="snippetSelectInvoice" onchange="addSnippetToInvoiceList(this)" class="w-full border border-purple-200 dark:border-purple-700 dark:bg-slate-700 dark:text-gray-100 rounded-lg p-2 text-sm bg-purple-50/50">
            <option value="">-- Textbaustein wählen --</option>
          </select>
        </div>
      </div>

      <!-- DYNAMISCHE POSITIONSLISTE -->
      <div class="border-t pt-3">
        <div class="flex justify-between items-center mb-2">
        <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">Rechnungspositionen *</label>
        <button type="button" onclick="addCustomInvoiceRow()" class="text-xs bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-300 px-2.5 py-1 rounded font-medium border dark:border-slate-600">
            + Eigene Position hinzufügen
          </button>
        </div>

        <div id="invoiceItemsContainer" class="space-y-3">
          <!-- Dynamische Zeilen werden per JS angehängt -->
        </div>
      </div>

      <!-- LIVE-SUMME -->
      <div class="bg-slate-50 dark:bg-slate-700/50 rounded-lg px-4 py-3 border dark:border-slate-600">
        <div class="flex justify-between items-center text-sm">
          <span class="text-slate-600 dark:text-slate-300">Netto-Summe:</span>
          <span id="invTotalNet" class="font-semibold text-slate-800 dark:text-gray-100">0,00 €</span>
        </div>
        <div class="flex justify-between items-center text-sm mt-1">
          <span class="text-slate-600 dark:text-slate-300">MwSt. 19%:</span>
          <span id="invTotalVat" class="text-slate-600 dark:text-slate-400">0,00 €</span>
        </div>
        <div class="flex justify-between items-center font-bold text-base mt-2 pt-2 border-t dark:border-slate-600">
          <span class="text-slate-800 dark:text-gray-100">Gesamt (Brutto):</span>
          <span id="invTotalGross" class="text-emerald-700 dark:text-emerald-400">0,00 €</span>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-4 border-t flex-shrink-0">
        <button type="button" onclick="toggleModal('invoiceModal')" class="px-4 py-2 border dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Rechnung Erstellen</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleModal(id) {
    const modal = document.getElementById(id);
    modal.classList.toggle('hidden');
    if (!modal.classList.contains('hidden')) {
      const container = document.getElementById('invoiceItemsContainer');
      if (container && container.children.length === 0) {
        addCustomInvoiceRow();
      }
    }
  }

  function addCustomInvoiceRow(title = '', quantity = 1, unit = 'Stk', price = '') {
    const container = document.getElementById('invoiceItemsContainer');
    const rowId = 'inv_row_' + Date.now() + Math.random().toString(36).substr(2, 4);
    const rowHtml = `
      <div id="${rowId}" class="p-3 bg-gray-50 border rounded-lg space-y-2 relative">
        <div class="flex justify-between items-center">
          <input type="text" name="title" value="${title}" required placeholder="Beschreibung (z.B. Stahlträger HEB 160 / Geländer montieren)" class="w-full border rounded p-2 text-sm bg-white">
          <button type="button" onclick="removeInvoiceRow('${rowId}')" class="ml-2 text-red-500 hover:text-red-700 font-bold px-2 py-1 text-sm" title="Position entfernen">✕</button>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div>
            <label class="block text-[10px] text-gray-500 uppercase">Menge</label>
            <input type="number" step="0.01" name="quantity" value="${quantity}" required class="w-full border rounded p-1.5 text-sm bg-white">
          </div>
          <div>
            <label class="block text-[10px] text-gray-500 uppercase">Einheit</label>
            <select name="unit" class="w-full border rounded p-1.5 text-sm bg-white">
              <option value="Stk" ${unit === 'Stk' ? 'selected' : ''}>Stk</option>
              <option value="m" ${unit === 'm' ? 'selected' : ''}>m (Meter)</option>
              <option value="Std" ${unit === 'Std' ? 'selected' : ''}>Std (Stunden)</option>
              <option value="kg" ${unit === 'kg' ? 'selected' : ''}>kg</option>
              <option value="m²" ${unit === 'm²' ? 'selected' : ''}>m²</option>
              <option value="Psch" ${unit === 'Psch' ? 'selected' : ''}>Pauschale</option>
            </select>
          </div>
          <div>
            <label class="block text-[10px] text-gray-500 uppercase">Einzelpreis (€)</label>
            <input type="number" step="0.01" name="price" value="${price}" required placeholder="0.00" class="w-full border rounded p-1.5 text-sm bg-white">
          </div>
        </div>
      </div>
    `;
    container.insertAdjacentHTML('beforeend', rowHtml);
    updateInvoiceTotals();
  }

  function addArticleToInvoiceList(selectElement) {
    const opt = selectElement.options[selectElement.selectedIndex];
    if (!opt.value) return;
    const fullTitle = opt.getAttribute('data-title') + (opt.getAttribute('data-desc') ? ' - ' + opt.getAttribute('data-desc') : '');
    addCustomInvoiceRow(fullTitle, 1, opt.getAttribute('data-unit'), opt.getAttribute('data-price'));
    selectElement.value = '';
  }

  function addSnippetToInvoiceList(selectElement) {
    const opt = selectElement.options[selectElement.selectedIndex];
    if (!opt.value) return;
    addCustomInvoiceRow(opt.getAttribute('data-text') || opt.textContent, 1, 'Psch', 0);
    selectElement.value = '';
  }

  // Textbaustein-Dropdown beim Laden befüllen
  (function populateInvoiceSnippets() {
    const sel = document.getElementById('snippetSelectInvoice');
    if (!sel || typeof window.TEXT_SNIPPETS === 'undefined') return;
    window.TEXT_SNIPPETS.forEach(sn => {
      const o = document.createElement('option');
      o.value = sn.key || sn.label;
      o.textContent = sn.label;
      o.setAttribute('data-text', sn.text || '');
      sel.appendChild(o);
    });
  })();

  function removeInvoiceRow(rowId) {
    const row = document.getElementById(rowId);
    if (row) row.remove();
    updateInvoiceTotals();
  }

  // Live-Summe neu berechnen (Netto / MwSt. / Brutto)
  function updateInvoiceTotals() {
    let net = 0;
    document.querySelectorAll('#invoiceItemsContainer > div').forEach(row => {
      const qty   = parseFloat(row.querySelector('[name="quantity"]')?.value) || 0;
      const price = parseFloat(row.querySelector('[name="price"]')?.value)    || 0;
      net += qty * price;
    });
    const vat   = net * 0.19;
    const gross = net + vat;
    const fmt = v => v.toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' €';
    const netEl = document.getElementById('invTotalNet');
    if (netEl) netEl.textContent = fmt(net);
    const vatEl = document.getElementById('invTotalVat');
    if (vatEl) vatEl.textContent = fmt(vat);
    const grossEl = document.getElementById('invTotalGross');
    if (grossEl) grossEl.textContent = fmt(gross);
  }

  // Bei jeder Eingabe in Menge/Preis innerhalb der Positionsliste neu berechnen
  document.addEventListener('input', (e) => {
    if (e.target.closest('#invoiceItemsContainer') && (e.target.name === 'quantity' || e.target.name === 'price')) {
      updateInvoiceTotals();
    }
  });

  (function () {
    const seg = document.getElementById('inv-seg');
    if (!seg) return;
    function apply(filter) {
      document.querySelectorAll('.inv-row, .inv-card').forEach(el => {
        const st = (el.dataset.status || '').toLowerCase();
        let show = true;
        if (filter === 'open') show = st !== 'bezahlt';
        if (filter === 'paid') show = st === 'bezahlt';
        el.classList.toggle('hidden', !show);
      });
    }
    seg.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        seg.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        apply(btn.dataset.filter);
      });
    });
    apply('open');
  })();
</script>


<!-- Modal: Neue Positionen speichern -->
<div id="catalogSaveModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-[60]">
  <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl max-w-md w-full overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-200 dark:border-slate-700">
      <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">Neue Positionen speichern?</h3>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Diese Bezeichnungen sind noch nicht im Stamm. Für die nächste Rechnung/Angebot übernehmen?</p>
    </div>
    <div class="p-5 space-y-3">
      <ul id="catalogSaveList" class="text-sm space-y-1.5 max-h-40 overflow-y-auto border border-gray-100 dark:border-slate-700 rounded-lg p-3 bg-slate-50 dark:bg-slate-700/40"></ul>
      <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
        <input type="checkbox" id="catalogAsArticle" checked class="rounded border-gray-300 text-blue-600">
        Als <strong>Artikel</strong> speichern (mit Einheit &amp; Preis)
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
        <input type="checkbox" id="catalogAsSnippet" class="rounded border-gray-300 text-purple-600">
        Als <strong>Textbaustein</strong> speichern
      </label>
    </div>
    <div class="px-5 py-4 border-t border-gray-100 dark:border-slate-700 flex flex-wrap gap-2 justify-end">
      <button type="button" id="catalogSkipBtn" class="px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700">Nein, nur speichern</button>
      <button type="button" id="catalogSaveBtn" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold">Ja, übernehmen</button>
    </div>
  </div>
</div>
<script>
window.__CATALOG_ARTICLES = window.__CATALOG_ARTICLES || [];
window.__CATALOG_SNIPPETS = window.__CATALOG_SNIPPETS || [];

function collectFormPositions(form) {
  const titles = form.querySelectorAll('[name="title"]');
  const units = form.querySelectorAll('[name="unit"]');
  const prices = form.querySelectorAll('[name="price"]');
  const items = [];
  titles.forEach(function(inp, i) {
    const title = (inp.value || '').trim();
    if (!title) return;
    items.push({
      title: title,
      description: title,
      unit: (units[i] && units[i].value) || 'Stk',
      price: (prices[i] && prices[i].value) || 0
    });
  });
  return items;
}

function findUnknownPositions(items) {
  const artTitles = new Set((window.__CATALOG_ARTICLES || []).map(function(a) {
    return String(a.title || '').toLowerCase().trim();
  }));
  const snipLabels = new Set((window.__CATALOG_SNIPPETS || []).map(function(s) {
    return String(s.label || s.text || '').toLowerCase().trim();
  }));
  const unknown = [];
  const seen = new Set();
  items.forEach(function(it) {
    const k = it.title.toLowerCase();
    if (seen.has(k)) return;
    seen.add(k);
    if (!artTitles.has(k) && !snipLabels.has(k)) unknown.push(it);
  });
  return unknown;
}

function promptSaveNewCatalog(form) {
  return new Promise(function(resolve) {
    const items = collectFormPositions(form);
    const unknown = findUnknownPositions(items);
    if (!unknown.length) { resolve(false); return; }

    const modal = document.getElementById('catalogSaveModal');
    const list = document.getElementById('catalogSaveList');
    if (!modal || !list) { resolve(false); return; }

    list.innerHTML = unknown.map(function(u) {
      return '<li class="flex justify-between gap-2"><span class="font-medium text-gray-800 dark:text-gray-100">' +
        u.title.replace(/</g,'&lt;') + '</span><span class="text-xs text-gray-400">' +
        (Number(u.price)||0).toFixed(2) + ' € / ' + (u.unit||'Stk') + '</span></li>';
    }).join('');

    modal.classList.remove('hidden');

    function cleanup() {
      modal.classList.add('hidden');
      document.getElementById('catalogSkipBtn').onclick = null;
      document.getElementById('catalogSaveBtn').onclick = null;
    }

    document.getElementById('catalogSkipBtn').onclick = function() {
      cleanup();
      resolve(false);
    };
    document.getElementById('catalogSaveBtn').onclick = async function() {
      const asArticle = document.getElementById('catalogAsArticle').checked;
      const asSnippet = document.getElementById('catalogAsSnippet').checked;
      const btn = document.getElementById('catalogSaveBtn');
      btn.disabled = true;
      btn.textContent = 'Speichert…';
      try {
        if (asArticle || asSnippet) {
          await fetch('/documents/api/save-catalog-items', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ items: unknown, as_article: asArticle, as_snippet: asSnippet })
          });
        }
      } catch (e) { console.warn(e); }
      btn.disabled = false;
      btn.textContent = 'Ja, übernehmen';
      cleanup();
      resolve(true);
    };
  });
}

function wireCatalogPrompt(form) {
  if (!form || form.dataset.catalogWired) return;
  form.dataset.catalogWired = '1';
  form.addEventListener('submit', function(e) {
    if (form.dataset.catalogDone === '1') return;
    e.preventDefault();
    promptSaveNewCatalog(form).then(function() {
      form.dataset.catalogDone = '1';
      form.submit();
    });
  });
}
</script>

<script>
window.__CATALOG_ARTICLES = <%- JSON.stringify((typeof articles !== 'undefined' ? articles : []).map(a => ({ title: a.title, unit: a.unit, unit_price: a.unit_price }))) %>;
window.__CATALOG_SNIPPETS = <%- JSON.stringify(typeof textSnippets !== 'undefined' ? textSnippets : []) %>;
document.addEventListener('DOMContentLoaded', function() {
  var f = document.querySelector('form[action="/documents/create-invoice"]');
  if (f) wireCatalogPrompt(f);
});
</script>

</body>
</html>
