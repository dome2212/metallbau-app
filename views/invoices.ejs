<%- include('partials/header') %>

<div class="flex h-screen bg-gray-100">
  <%- include('partials/sidebar') %>

  <main class="flex-1 p-6 overflow-y-auto">
    <!-- Header-Bereich -->
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Rechnungsverwaltung</h1>
        <p class="text-sm text-gray-500">Übersicht über alle Rechnungen und Zahlungsstati</p>
      </div>
      <button onclick="toggleModal('invoiceModal')" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow flex items-center gap-2">
        <span>+ Neue Rechnung erstellen</span>
      </button>
    </div>

    <!-- Status-Filter / Tabs -->
    <div class="flex border-b border-gray-200 mb-6 gap-6 text-sm font-medium">
      <% const current = typeof currentStatus !== 'undefined' ? currentStatus : 'Alle'; %>

      <a href="/documents/invoices" 
         class="pb-3 transition-colors <%= current === 'Alle' ? 'border-b-2 border-blue-600 text-blue-600 font-bold' : 'text-gray-500 hover:text-gray-700' %>">
        Alle
      </a>

      <a href="/documents/invoices?status=Entwurf" 
         class="pb-3 transition-colors <%= current === 'Entwurf' ? 'border-b-2 border-blue-600 text-blue-600 font-bold' : 'text-gray-500 hover:text-gray-700' %>">
        Entwurf
      </a>

      <a href="/documents/invoices?status=Gesendet" 
         class="pb-3 transition-colors <%= current === 'Gesendet' ? 'border-b-2 border-blue-600 text-blue-600 font-bold' : 'text-gray-500 hover:text-gray-700' %>">
        Gesendet
      </a>

      <a href="/documents/invoices?status=Bezahlt" 
         class="pb-3 transition-colors <%= current === 'Bezahlt' ? 'border-b-2 border-emerald-600 text-emerald-600 font-bold' : 'text-emerald-600 hover:text-emerald-700' %>">
        Bezahlt
      </a>

      <a href="/documents/invoices?status=Überfällig" 
         class="pb-3 transition-colors <%= current === 'Überfällig' ? 'border-b-2 border-red-600 text-red-600 font-bold' : 'text-red-600 hover:text-red-700' %>">
        Überfällig
      </a>

      <a href="/documents/invoices?status=Verzögert" 
         class="pb-3 transition-colors <%= current === 'Verzögert' ? 'border-b-2 border-amber-600 text-amber-600 font-bold' : 'text-amber-600 hover:text-amber-700' %>">
        Sonstiges / Verzögert
      </a>
    </div>

    <!-- Rechnungs-Tabelle -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-500 uppercase">
          <tr>
            <th class="p-4">Rechnungs-Nr.</th>
            <th class="p-4">Datum</th>
            <th class="p-4">Kunde</th>
            <th class="p-4">Betrag (Brutto)</th>
            <th class="p-4">Status</th>
            <th class="p-4 text-right">Aktionen</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof invoices !== 'undefined' && invoices.length > 0) { %>
            <% invoices.forEach(inv => { %>
              <tr class="border-b hover:bg-gray-50">
                <!-- Rechnungsnummer ist anklickbar zur Detailseite -->
                <td class="py-3 px-4 font-semibold">
                  <a href="/documents/invoices/<%= inv.id %>" class="text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1" title="Details / Positionen anzeigen">
                    📄 <%= inv.invoice_number %>
                  </a>
                </td>
                <td class="py-3 px-4 text-gray-600"><%= new Date(inv.created_at).toLocaleDateString('de-DE') %></td>
                <td class="py-3 px-4 text-gray-800 font-medium"><%= inv.company_name || inv.contact_person || 'Privat' %></td>
                <td class="py-3 px-4 text-gray-800 font-semibold"><%= parseFloat(inv.total_amount || 0).toFixed(2) %> €</td>
                
                <!-- STATUS ANZEIGE -->
                <td class="py-3 px-4">
                  <% if (inv.status === 'Bezahlt') { %>
                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Bezahlt</span>
                  <% } else if (inv.status === 'Überfällig') { %>
                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Überfällig</span>
                  <% } else if (inv.status === 'Verzögert') { %>
                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-amber-100 text-amber-800" title="<%= inv.status_note %>">
                      Verzögert ℹ️
                    </span>
                    <% if (inv.status_note) { %>
                      <div class="text-xs text-gray-500 mt-0.5"><%= inv.status_note %></div>
                    <% } %>
                  <% } else { %>
                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800"><%= inv.status %></span>
                  <% } %>
                </td>

                <!-- AKTIONEN -->
                <td class="py-3 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    
                    <!-- Link: Details öffnen -->
                    <a href="/documents/invoices/<%= inv.id %>" class="px-2 py-1 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded text-xs font-medium" title="Details / Material anzeigen">
                      👁️ Details
                    </a>

                    <!-- Button: Als Bezahlt -->
                    <form action="/documents/invoices/update-status" method="POST" class="inline">
                      <input type="hidden" name="invoice_id" value="<%= inv.id %>">
                      <input type="hidden" name="status" value="Bezahlt">
                      <button type="submit" title="Als Bezahlt markieren" class="px-2 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded text-xs font-medium">✓ Bezahlt</button>
                    </form>

                    <!-- Button: Als Überfällig -->
                    <form action="/documents/invoices/update-status" method="POST" class="inline">
                      <input type="hidden" name="invoice_id" value="<%= inv.id %>">
                      <input type="hidden" name="status" value="Überfällig">
                      <button type="submit" title="Als Überfällig markieren" class="px-2 py-1 bg-red-50 hover:bg-red-100 text-red-700 rounded text-xs font-medium">⚠️ Überfällig</button>
                    </form>

                    <!-- Button: Zahlungsverzögerung / Sonstiges -->
                    <button onclick="openDelayModal('<%= inv.id %>')" class="px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 rounded text-xs font-medium">⏳ Verzögert</button>

                    <!-- Button: Löschen -->
                    <form action="/documents/invoices/delete" method="POST" onsubmit="return confirm('Rechnung wirklich löschen?');" class="inline">
                      <input type="hidden" name="invoice_id" value="<%= inv.id %>">
                      <button type="submit" class="px-2 py-1 bg-gray-100 hover:bg-red-100 text-red-600 rounded text-xs font-medium">🗑️</button>
                    </form>

                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center text-gray-400 py-8">Keine Rechnungen vorhanden.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</div>

<!-- Modal: Neue Rechnung anlegen -->
<div id="invoiceModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-xl shadow-lg max-w-lg w-full p-6">
    <div class="flex justify-between items-center mb-4 border-b pb-2">
      <h3 class="text-lg font-bold text-gray-800">Neue Rechnung anlegen</h3>
      <button onclick="toggleModal('invoiceModal')" class="text-gray-400 hover:text-gray-600">&times;</button>
    </div>
    
    <form action="/documents/create-invoice" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Kunde auswählen *</label>
        <select name="customer_id" required class="w-full border rounded-lg p-2 text-sm bg-white">
          <option value="">-- Kunde wählen --</option>
          <% if (typeof customers !== 'undefined') { %>
            <% customers.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.company_name || c.contact_person %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div class="border-t pt-2">
        <label class="block text-xs font-bold text-gray-700 mb-2">Erste Position (z.B. Schweißarbeit / Edelstahl / Montagezeit)</label>
        <div class="space-y-2">
          <input type="text" name="title" required placeholder="Beschreibung (z.B. Geländer montagefertig / 4 Std. Montage)" class="w-full border rounded-lg p-2 text-sm">
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label class="block text-xs text-gray-500">Menge</label>
              <input type="text" name="quantity" required placeholder="1" class="w-full border rounded-lg p-2 text-sm">
            </div>
            <div>
              <label class="block text-xs text-gray-500">Einheit</label>
              <select name="unit" class="w-full border rounded-lg p-2 text-sm bg-white">
                <option value="Stk">Stk</option>
                <option value="m">m (Meter)</option>
                <option value="Std">Std (Stunden)</option>
                <option value="kg">kg</option>
                <option value="m²">m²</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-gray-500">Einzelpreis (€)</label>
              <input type="text" name="price" required placeholder="150,00" class="w-full border rounded-lg p-2 text-sm">
            </div>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-4 border-t">
        <button type="button" onclick="toggleModal('invoiceModal')" class="px-4 py-2 border rounded-lg text-sm text-gray-600 hover:bg-gray-50">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Rechnung Erstellen</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal für Verzögerung / Sonstiges -->
<div id="delayModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-xl shadow-lg max-w-md w-full p-6">
    <div class="flex justify-between items-center mb-4 border-b pb-2">
      <h3 class="text-lg font-bold text-gray-800">Zahlungsverzögerung angeben</h3>
      <button onclick="closeDelayModal()" class="text-gray-400 hover:text-gray-600">&times;</button>
    </div>

    <form action="/documents/invoices/update-status" method="POST" class="space-y-4">
      <input type="hidden" name="invoice_id" id="delay_invoice_id">
      <input type="hidden" name="status" value="Verzögert">

      <div>
        <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Grund / Notiz vom Kunden</label>
        <textarea name="status_note" rows="3" placeholder="z. B. Kunde hat Bescheid gegeben, dass Überweisung erst nächste Woche erfolgt..." class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500" required></textarea>
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" onclick="closeDelayModal()" class="px-4 py-2 border rounded-lg text-sm text-gray-600 hover:bg-gray-50">Abbrechen</button>
        <button type="submit" class="px-4 py-2 bg-amber-600 text-white rounded-lg text-sm font-medium hover:bg-amber-700">Speichern</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleModal(id) {
    document.getElementById(id).classList.toggle('hidden');
  }

  function openDelayModal(id) {
    document.getElementById('delay_invoice_id').value = id;
    document.getElementById('delayModal').classList.remove('hidden');
  }

  function closeDelayModal() {
    document.getElementById('delayModal').classList.add('hidden');
  }
</script>

</body>
</html>