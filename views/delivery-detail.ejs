<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 min-h-screen page-bg dark:bg-slate-900 pt-14">
  <div class="max-w-3xl mx-auto px-4 md:px-6 py-6 space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <a href="/customers/<%= delivery.customer_id %>" class="text-xs text-blue-600 hover:underline">← Kundenakte</a>
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mt-1">Lieferschein <%= delivery.doc_number %></h1>
        <p class="text-sm text-slate-500"><%= delivery.company_name || delivery.contact_person || '' %></p>
      </div>
      <form action="/documents/delivery/<%= delivery.id %>/status" method="POST" class="flex gap-2 items-center">
        <select name="status" class="input text-sm">
          <% ['OFFEN','UNTERWEGS','GELIEFERT','ABGESCHLOSSEN'].forEach(function(s){ %>
            <option value="<%= s %>" <%= delivery.status === s ? 'selected' : '' %>><%= s %></option>
          <% }); %>
        </select>
        <button type="submit" class="px-3 py-2 bg-slate-800 text-white text-sm rounded-lg">Status</button>
      </form>
    </div>

    <div class="card p-5 text-sm space-y-1">
      <p><strong>Kunde:</strong> <%= delivery.company_name || delivery.contact_person %></p>
      <p><strong>Adresse:</strong> <%= [delivery.street, [delivery.zip, delivery.city].filter(Boolean).join(' ')].filter(Boolean).join(', ') || '—' %></p>
      <% if (delivery.project_id) { %>
        <p><strong>Auftrag:</strong> <a class="text-blue-600 hover:underline" href="/projects/<%= delivery.project_id %>">#<%= delivery.project_id %></a></p>
      <% } %>
    </div>

    <div class="card p-0 overflow-hidden">
      <div class="px-4 py-3 border-b font-semibold text-sm">Positionen</div>
      <table class="w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-800 text-xs text-slate-500">
          <tr><th class="px-4 py-2 text-left">Beschreibung</th><th class="px-4 py-2 text-right">Menge</th><th class="px-4 py-2 text-left">Einheit</th></tr>
        </thead>
        <tbody class="divide-y">
          <% (items||[]).forEach(function(it){ %>
            <tr>
              <td class="px-4 py-2"><%= it.description %></td>
              <td class="px-4 py-2 text-right"><%= it.quantity %></td>
              <td class="px-4 py-2"><%= it.unit || '' %></td>
            </tr>
          <% }); %>
          <% if (!(items||[]).length) { %>
            <tr><td colspan="3" class="px-4 py-6 text-center text-slate-400">Noch keine Positionen</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="card p-5">
      <h2 class="text-sm font-semibold mb-3">Position hinzufügen</h2>
      <form action="/documents/delivery/<%= delivery.id %>/items" method="POST" class="grid grid-cols-1 sm:grid-cols-4 gap-2">
        <input name="description" required placeholder="Bezeichnung" class="input text-sm sm:col-span-2">
        <input name="quantity" type="number" step="0.01" value="1" class="input text-sm">
        <input name="unit" value="Stk" class="input text-sm">
        <button type="submit" class="btn text-white font-semibold py-2 sm:col-span-4" style="background:var(--primary)">Hinzufügen</button>
      </form>
    </div>

    <div class="card p-4 text-sm text-slate-600">
      <strong>Abnahme:</strong> Nach Lieferung die Abnahme im zugehörigen Auftrag dokumentieren (Unterschrift unter „Abnahme“).
      <% if (delivery.project_id) { %>
        <a href="/projects/<%= delivery.project_id %>" class="text-blue-600 hover:underline ml-1">Zum Auftrag →</a>
      <% } %>
    </div>
  </div>
</main>
</body>
</html>
