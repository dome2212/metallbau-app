<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof status !== 'undefined' ? status : 500 %> – Fehler</title>
  <link rel="stylesheet" href="/css/tailwind.min.css">
  <script>
    (function(){try{var s=localStorage.getItem('darkMode');if(s===null||s==='true')document.documentElement.classList.add('dark');}catch(e){}})();
  </script>
  <style>body{font-family:Inter,system-ui,sans-serif}</style>
</head>
<body class="min-h-screen bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 flex items-center justify-center p-6">
  <div class="max-w-md w-full text-center">
    <div class="text-6xl font-extrabold text-slate-300 dark:text-slate-600 mb-2"><%= typeof status !== 'undefined' ? status : 500 %></div>
    <h1 class="text-xl font-bold mb-2"><%= typeof title !== 'undefined' ? title : 'Etwas ist schiefgelaufen' %></h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-6"><%= typeof message !== 'undefined' ? message : 'Bitte versuche es erneut oder gehe zurück zum Dashboard.' %></p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/dashboard" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold">Zum Dashboard</a>
      <a href="javascript:history.back()" class="px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-600 text-sm font-semibold text-slate-600 dark:text-slate-300">Zurück</a>
    </div>
  </div>
</body>
</html>
